/GHSA-77mm-f2xg-rwg2.json"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":[],"repo_exp_urls":[],"has_poc":false,"has_exp":false,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/2025/AVE-2025-0466.toml"},{"ave_id":"AVE-2025-0465","file_name":"2025/AVE-2025-0465.toml","cve_id":"CVE-2025-11413","title":"GNU Binutils 链接器越界读取漏洞","description":"GNU Binutils 2.45 版本的链接器（bfd/elflink.c）中的 elf_link_add_object_symbols 函数存在越界读取漏洞。本地攻击者可通过向目标系统提供特制的 ELF 文件触发该漏洞，导致链接器进程读取越界内存数据，可能造成敏感信息泄露或程序崩溃。该漏洞影响 GNU Binutils 2.45 及之前版本，CVSS 评分 1.9，危害等级低。升级至 Binutils 2.46 版本即可修复。","severity":"LOW","score":1.9,"aliases":["CVE-2025-11413"],"sources":["msrc"],"published":"2025-10-07T22:15:34Z","updated":"2026-06-17T08:30:24Z","remediation":"将 GNU Binutils 升级至 2.46 或更高版本（commit 72efdf166aa0）。对于 SUSE Linux 用户，安装 SUSE-SU-2025:4096-1 安全更新。在 aarch64 架构上，避免在旧代码流中使用 `-z gcs=implicit` 链接选项作为临时缓解措施。","status":"completed","collected_at":"2026-07-27T00:00:00Z","references":["https://sourceware.org/bugzilla/attachment.cgi?id=16362","https://sourceware.org/bugzilla/show_bug.cgi?id=33452","https://sourceware.org/bugzilla/show_bug.cgi?id=33456#c10","https://sourceware.org/git/gitweb.cgi?p=binutils-gdb.git;h=72efdf166aa0ed72ecc69fc2349af6591a7a19c0","https://vuldb.com/?ctiid.327349","https://vuldb.com/?id.327349","https://vuldb.com/?submit.665587","https://vuldb.com/?submit.665590","https://www.gnu.org/","https://cert-portal.siemens.com/productcert/html/ssa-082556.html","https://github.com/trickest/cve/blob/be44b05b9428dc18bc0705cf60dd8d8640cd49b1/2025/CVE-2025-11413.md","https://github.com/CVEProject/cvelistV5/blob/1842f861696b8e0d2a79b27d77e1bfea36333d86/cves/2025/11xxx/CVE-2025-11413.json","https://github.com/neuvector/vul-source/blob/ada0c6c45d02a82e11f6f46403716f0946c37f98/ubuntu-cve-tracker/retired/CVE-2025-11413","https://github.com/grafana/grafana-image-renderer/blob/0a918126b9e7fd11d49cb100c32a439da9d3d30d/CHANGELOG.md","https://github.com/canonical/ubuntu-security-notices/blob/2a2183b97032e27dffc48e0c05258a59a58abd74/osv/cve/2025/UBUNTU-CVE-2025-11413.json","https://github.com/cisagov/vulnrichment/blob/a2c62c60ff1862a166bb0b583b0e40e8effbf660/2025/11xxx/CVE-2025-11413.json","https://github.com/ubinux/yocto-ubinux/blob/ab669969f179e49d3909b71323e9a1b8957dc3e5/meta/recipes-devtools/binutils/binutils/CVE-2025-11413.patch","https://github.com/sec-dojo-com/cve-poc/blob/1c2e0105dfc8043b137c91cc2d5ac23317d19c53/pocs/2025/CVE-2025-11413.md","https://github.com/bell-sw/osv-database/blob/913667a73bdbecec80569e2765753066c820c678/BELL-CVE/BELL-CVE-2025-11413.json","https://github.com/github/advisory-database/blob/8fd24b26179bcdde52e301aef6d16b0838932c28/advisories/unreviewed/2025/10/GHSA-w337-wphv-g4vh/GHSA-w337-wphv-g4vh.json"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":[],"repo_exp_urls":[],"has_poc":false,"has_exp":false,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/2025/AVE-2025-0465.toml"},{"ave_id":"AVE-2025-0464","file_name":"2025/AVE-2025-0464.toml","cve_id":"CVE-2025-11412","title":"GNU Binutils 链接器越界读取漏洞","description":"GNU Binutils 2.45 的链接器组件（bfd/elflink.c 文件中的 bfd_elf_gc_record_vtentry 函数）存在越界读取漏洞。当处理特制的 ELF 文件时，程序未能正确验证虚函数表条目记录的内存边界，导致攻击者可利用该缺陷读取越界内存数据。该漏洞需要本地访问权限，攻击者可通过向受影响系统提交恶意构造的 ELF 文件触发。成功利用可导致敏感信息泄露，影响系统机密性。CVSS 评分 1.9，危害等级低。补丁已由官方发布，建议用户及时更新至修复版本。","severity":"LOW","score":1.9,"aliases":["CVE-2025-11412"],"sources":["msrc"],"published":"2025-10-07T22:15:34Z","updated":"2026-06-17T08:30:24Z","remediation":"立即应用上游补丁 047435dd988a3975d40c6626a8f739a0b2e154bc，该补丁在 bfd/elflink.c 的 bfd_elf_gc_record_vtentry 函数中增加了 addend > 1u << 28 的边界检查，防止越界读取。SUSE Linux 用户应安装 SUSE-SU-2025:4096-1 安全更新。如无法立即打补丁，可在链接时避免使用 -z gcs=implicit 选项作为临时缓解措施。","status":"completed","collected_at":"2026-07-27T00:00:00Z","references":["https://sourceware.org/bugzilla/attachment.cgi?id=16378","https://sourceware.org/bugzilla/show_bug.cgi?id=33452","https://sourceware.org/bugzilla/show_bug.cgi?id=33452#c8","https://sourceware.org/git/gitweb.cgi?p=binutils-gdb.git;h=047435dd988a3975d40c6626a8f739a0b2e154bc","https://vuldb.com/?ctiid.327348","https://vuldb.com/?id.327348","https://www.gnu.org/","https://cert-portal.siemens.com/productcert/html/ssa-082556.html","https://github.com/trickest/cve/blob/be44b05b9428dc18bc0705cf60dd8d8640cd49b1/2025/CVE-2025-11412.md","https://github.com/CVEProject/cvelistV5/blob/1842f861696b8e0d2a79b27d77e1bfea36333d86/cves/2025/11xxx/CVE-2025-11412.json","https://github.com/neuvector/vul-source/blob/ada0c6c45d02a82e11f6f46403716f0946c37f98/ubuntu-cve-tracker/retired/CVE-2025-11412","https://github.com/grafana/grafana-image-renderer/blob/0a918126b9e7fd11d49cb100c32a439da9d3d30d/CHANGELOG.md","https://github.com/canonical/ubuntu-security-notices/blob/2a2183b97032e27dffc48e0c05258a59a58abd74/osv/cve/2025/UBUNTU-CVE-2025-11412.json","https://github.com/cisagov/vulnrichment/blob/a2c62c60ff1862a166bb0b583b0e40e8effbf660/2025/11xxx/CVE-2025-11412.json","https://github.com/ubinux/yocto-ubinux/blob/ab669969f179e49d3909b71323e9a1b8957dc3e5/meta/recipes-devtools/binutils/binutils/CVE-2025-11412.patch","https://github.com/sec-dojo-com/cve-poc/blob/1c2e0105dfc8043b137c91cc2d5ac23317d19c53/pocs/2025/CVE-2025-11412.md","https://github.com/bell-sw/osv-database/blob/913667a73bdbecec80569e2765753066c820c678/BELL-CVE/BELL-CVE-2025-11412.json","https://github.com/github/advisory-database/blob/8fd24b26179bcdde52e301aef6d16b0838932c28/advisories/unreviewed/2025/10/GHSA-fw6m-h9wv-4759/GHSA-fw6m-h9wv-4759.json"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":[],"repo_exp_urls":[],"has_poc":false,"has_exp":false,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/2025/AVE-2025-0464.toml"},{"ave_id":"AVE-2025-0349","file_name":"2025/AVE-2025-0349.toml","cve_id":"CVE-2025-61670","title":"Bytecode Alliance Wasmtime C/C++ API 内存泄漏漏洞","description":"Wasmtime 是一个 WebAssembly 运行时，其在 37.0.0 和 37.0.1 版本中存在 C/C++ API 内存泄漏漏洞。由于开发过程中将 `ManuallyRooted<T>` 重构为 `OwnedRooted<T>` 类型时未正确集成到 C/C++ API 中，导致 `externref` 和 `anyref` 类型的宿主内存分配无法在 store 销毁时自动释放。C API 中的 `wasmtime_val_unroot` 函数因拼写错误实际无效，C++ API 缺少析构函数处理，以及宿主函数返回值未被取消根引用，共同导致持续内存泄漏。使用 C/C++ API 处理 `externref` 或 `anyref` 值的应用会累积泄漏宿主内存，长期运行可能导致拒绝服务。该漏洞不影响 Rust crate 及未使用相关类型的嵌入场景。已在 37.0.2 版本修复。","severity":"LOW","score":1.0,"aliases":["CVE-2025-61670","GHSA-vvp9-h8p2-xwfc"],"sources":["ghsa"],"published":"2025-10-07T19:15:38Z","updated":"2026-06-17T09:50:45Z","remediation":"升级至 Wasmtime 37.0.2 或更高版本，该版本已修复 `wasmtime_val_unroot` 函数未真正取消根对象的缺陷，并为 C++ API 的 `ExternRef`、`AnyRef` 和 `Val` 类型添加了析构函数。如无法立即升级，应避免在 C/C++ API 中使用 `externref` 和 `anyref` 类型，以消除内存泄漏风险。","status":"completed","collected_at":"2026-07-22T00:00:00Z","references":["https://github.com/bytecodealliance/wasmtime/commit/adff9d9d0f09569203709d5687e5a7dc8e1ad0a3","https://github.com/bytecodealliance/wasmtime/releases/tag/v37.0.2","https://github.com/bytecodealliance/wasmtime/security/advisories/GHSA-vvp9-h8p2-xwfc","https://github.com/trickest/cve/blob/3ffa2a96db84a89f71e1c7ad889e5f4fcc755a48/2025/CVE-2025-61670.md","https://github.com/CVEProject/cvelistV5/blob/4e452a37e644e8194f1171b7eec1f7dc625b6526/cves/2025/61xxx/CVE-2025-61670.json","https://github.com/Tabll/gemnasium-db/blob/de1cbf8802a4c6060caaa5924b50812f2a62fead/pypi/wasmtime-bin/CVE-2025-61670.yml","https://github.com/cisagov/vulnrichment/blob/6d175f59444084675ba336cc9e2bc51fc5338e6d/2025/61xxx/CVE-2025-61670.json","https://github.com/mabitoski/cve_submodules/blob/44ad7e2705b3aef1b2ffaf64bd47596c10a6c2e4/2025/CVE-2025-61670.md","https://github.com/pypa/advisory-database/blob/b9b8f76bfb92e30a50d8f60d2d06a8800347fe9d/vulns/wasmtime-bin/PYSEC-2025-268.yaml","https://github.com/Patrowl/PatrowlHearsData/blob/d880529b2028116bddf6c732baf8f599b169f01e/SSVC/data/2025/CVE-2025-61670.json","https://github.com/NovyWave/NovyWave/blob/c8d16adfe96205549bd43ebfe13781fce00f266a/.claude/extra/project/specs/plugins.md","https://github.com/github/advisory-database/blob/1721417c5dc7c1cbf858e5ea5a5245ea62e70cce/advisories/github-reviewed/2026/07/GHSA-vvp9-h8p2-xwfc/GHSA-vvp9-h8p2-xwfc.json","https://github.com/maxgfr/package-checker.sh/blob/70b8af273b1d73af5c372b20593b139dc1165787/data/osv-cargo.purl"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":[],"repo_exp_urls":[],"has_poc":false,"has_exp":false,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/2025/AVE-2025-0349.toml"},{"ave_id":"AVE-2025-0433","file_name":"2025/AVE-2025-0433.toml","cve_id":"CVE-2025-10729","title":"Qt SVG 无用漏洞导致拒绝服务","description":"Qt SVG 模块 qsvghandler.cpp 存在使用后释放漏洞，解析器在处理非结构化节点的 <pattern> 元素时，会在创建后删除该节点但后续仍可能访问已释放内存，导致使用后释放漏洞。攻击者可通过诱导用户打开精心构造的恶意 SVG 文件触发该漏洞，导致拒绝服务攻击。该漏洞影响 Qt 5/6 SVG 模块（如 Qt 5.15.x、Qt 6.x 相关版本），CVSS 4.0 评分 9.4（严重），攻击向量为本地，攻击复杂度低，无需权限和用户交互，可导致高机密性、完整性、可用性影响。Qt 官方已发布补丁修复，用户应尽快升级到修复版本。受影响产品包括 Qt5 qtsvg、Qt6 qtsvg 等相关模块。","severity":"CRITICAL","score":9.4,"aliases":["CVE-2025-10729"],"sources":["msrc"],"published":"2025-10-03T16:16:16Z","updated":"2026-06-17T08:28:51Z","remediation":"建议立即升级 Qt SVG 模块至 5.15.17 或 6.7.3 及以上版本（含微软 Azure Linux 回港补丁 qtsvg-5.15.17-CVE-2025-10729.patch）。若暂时无法升级，可在应用层禁止解析外部 SVG 文件，或在网络层拦截包含 <pattern> 非结构化节点的 SVG 内容作为临时缓解。","status":"completed","collected_at":"2026-07-27T00:00:00Z","references":["https://codereview.qt-project.org/c/qt/qtsvg/+/676473","https://github.com/trickest/cve/blob/be44b05b9428dc18bc0705cf60dd8d8640cd49b1/2025/CVE-2025-10729.md","https://github.com/microsoft/azurelinux/blob/db4dceaf9bd186cb20f62c3a43615b9421200bed/specs/q/qt5-qtsvg/qtsvg-5.15.17-CVE-2025-10729.patch","https://github.com/CVEProject/cvelistV5/blob/7102a069678e6b88d270e4c0da51e40aee59b148/cves/2025/10xxx/CVE-2025-10729.json","https://github.com/canonical/ubuntu-security-notices/blob/bb6cd0f1a29580d840cdb570b8b0c57cc39aac6d/osv/cve/2025/UBUNTU-CVE-2025-10729.json","https://github.com/neuvector/vul-source/blob/83b6758c208f8fd7e22b7c88e002c3658ef467b8/ubuntu-cve-tracker/active/CVE-2025-10729","https://github.com/cisagov/vulnrichment/blob/7cbd46ac4e2574be115c8b4e081aab80c1276132/2025/10xxx/CVE-2025-10729.json","https://github.com/SlackBuildsOrg/slackbuilds/blob/78b469b8f17f6a6417118abb52732c60db4a21e1/libraries/qt6/qt6.info","https://github.com/mabitoski/cve_submodules/blob/44ad7e2705b3aef1b2ffaf64bd47596c10a6c2e4/2025/CVE-2025-10729.md","https://github.com/github/advisory-database/blob/bf2e2ab4687e3840d3ae537224ca3dbe9e3c1067/advisories/unreviewed/2025/10/GHSA-cprv-rgr4-v7vh/GHSA-cprv-rgr4-v7vh.json","https://github.com/eslerm/ubuntu-cve-tracker/blob/f17e5ebf7a87347cc68d8fae347d07409a857342/active/CVE-2025-10729"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":[],"repo_exp_urls":[],"has_poc":false,"has_exp":false,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/2025/AVE-2025-0433.toml"},{"ave_id":"AVE-2025-0432","file_name":"2025/AVE-2025-0432.toml","cve_id":"CVE-2025-10728","title":"Qt SVG 模块 不受控制的递归导致栈溢出拒绝服务漏洞","description":"Qt SVG模块存在不受控制的递归漏洞（CWE-674），当模块渲染包含<pattern>元素的SVG文件时，可能陷入递归渲染循环导致栈溢出，引发拒绝服务（DoS）。该漏洞影响Qt 6 SVG模块及依赖其渲染SVG的Linux/Unix应用程序，CVSS 4.0评分9.4（CRITICAL），攻击向量为本地（AV:L），攻击复杂度低（AC:L），无需权限（PR:N）和用户交互（UI:N）。攻击者可构造恶意SVG文件，诱导受害应用渲染或通过自动化SVG处理服务触发递归调用，耗尽栈空间导致进程崩溃拒绝服务。目前厂商尚未提供补丁，受影响系统需限制不可信SVG文件处理或升级修复版本。","severity":"CRITICAL","score":9.4,"aliases":["CVE-2025-10728"],"sources":["msrc"],"published":"2025-10-03T16:16:16Z","updated":"2026-06-17T08:28:51Z","remediation":"更新 Qt 版本到 6.6.4 或更高版本，其中包含对 CVE-2025-10728 的修复。请从 The Qt Company 官方网站下载并安装最新安全更新。如需立即缓解，请在配置文件中添加 <pattern> 元素的最大深度限制，或在图形处理服务中禁用 SVG 文件处理。","status":"completed","collected_at":"2026-07-27T00:00:00Z","references":["https://codereview.qt-project.org/c/qt/qtsvg/+/654200","https://github.com/trickest/cve/blob/be44b05b9428dc18bc0705cf60dd8d8640cd49b1/2025/CVE-2025-10728.md","https://github.com/CVEProject/cvelistV5/blob/7102a069678e6b88d270e4c0da51e40aee59b148/cves/2025/10xxx/CVE-2025-10728.json","https://github.com/canonical/ubuntu-security-notices/blob/bb6cd0f1a29580d840cdb570b8b0c57cc39aac6d/osv/cve/2025/UBUNTU-CVE-2025-10728.json","https://github.com/neuvector/vul-source/blob/83b6758c208f8fd7e22b7c88e002c3658ef467b8/ubuntu-cve-tracker/active/CVE-2025-10728","https://github.com/cisagov/vulnrichment/blob/12ccf92eecf2db493c63630fd06d8245f1d02476/2025/10xxx/CVE-2025-10728.json","https://github.com/SlackBuildsOrg/slackbuilds/blob/78b469b8f17f6a6417118abb52732c60db4a21e1/libraries/qt6/qt6.info","https://github.com/mabitoski/cve_submodules/blob/44ad7e2705b3aef1b2ffaf64bd47596c10a6c2e4/2025/CVE-2025-10728.md","https://github.com/github/advisory-database/blob/bf2e2ab4687e3840d3ae537224ca3dbe9e3c1067/advisories/unreviewed/2025/10/GHSA-x6f6-j278-6544/GHSA-x6f6-j278-6544.json","https://github.com/eslerm/ubuntu-cve-tracker/blob/f17e5ebf7a87347cc68d8fae347d07409a857342/active/CVE-2025-10728","https://github.com/sourcemage/grimoire/blob/09d7ff4ffe4185e1f121df105ac158984a43adb4/qt6/qt6svg/HISTORY"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":[],"repo_exp_urls":[],"has_poc":false,"has_exp":false,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/2025/AVE-2025-0432.toml"},{"ave_id":"AVE-2025-0461","file_name":"2025/AVE-2025-0461.toml","cve_id":"CVE-2025-11234","title":"QEMU KVM VNC WebSocket 握手释放后使用拒绝服务漏洞","description":"QEMU 的 VNC WebSocket 握手过程中存在释放后使用漏洞。当 QIOChannelWebsock 对象在等待完成握手时被释放，会导致 GSource 泄漏，后续回调触发时产生 use-after-free，从而引发拒绝服务。该漏洞影响 QEMU 2.6.0 至低于 10.1.2 的版本。攻击者无需身份认证，只需具备对 VNC WebSocket 端口的网络访问权限，即可在握手阶段完成利用。","severity":"HIGH","score":7.5,"aliases":["CVE-2025-11234"],"sources":["msrc"],"published":"2025-10-03T11:15:30Z","updated":"2026-06-17T08:29:55Z","remediation":"QEMU 上游已在 10.1.2 版本中修复此漏洞（commit 322c3c4f），建议将 QEMU 升级至 10.1.2 或更高版本。Red Hat 用户执行 `dnf update qemu-kvm` 安装 RHSA-2026 系列安全更新；Ubuntu 用户执行 `apt update && apt install --only-upgrade qemu-kvm` 应用 USN-8412-1。如无法立即升级，请在防火墙中限制 VNC WebSocket 端口仅允许可信网段访问。","status":"completed","collected_at":"2026-07-27T00:00:00Z","references":["https://access.redhat.com/errata/RHSA-2025:23228","https://access.redhat.com/errata/RHSA-2026:0326","https://access.redhat.com/errata/RHSA-2026:0332","https://access.redhat.com/errata/RHSA-2026:0702","https://access.redhat.com/errata/RHSA-2026:1831","https://access.redhat.com/errata/RHSA-2026:18772","https://access.redhat.com/errata/RHSA-2026:22147","https://access.redhat.com/errata/RHSA-2026:3077","https://access.redhat.com/errata/RHSA-2026:3165","https://access.redhat.com/errata/RHSA-2026:5578","https://access.redhat.com/security/cve/CVE-2025-11234","https://bugzilla.redhat.com/show_bug.cgi?id=2401209","https://github.com/CVEProject/cvelistV5/blob/cc838d0e5ff34a3026c5292897b23b79aee8bacf/cves/2025/11xxx/CVE-2025-11234.json","https://github.com/neuvector/vul-source/blob/ada0c6c45d02a82e11f6f46403716f0946c37f98/ubuntu-cve-tracker/active/CVE-2025-11234","https://github.com/canonical/ubuntu-security-notices/blob/e7ffe335b9e43de0462b999586e11c70c219af1c/osv/cve/2025/UBUNTU-CVE-2025-11234.json","https://github.com/yarencheng/cve-devops-playground/blob/c54e59752dddfc9aa36c13774164384cfa0d1f04/content/CVE-2025-11234.md","https://github.com/cisagov/vulnrichment/blob/e3454357078cf368426374d4a62627b3db36a838/2025/11xxx/CVE-2025-11234.json","https://github.com/github/advisory-database/blob/8fd24b26179bcdde52e301aef6d16b0838932c28/advisories/unreviewed/2025/10/GHSA-hm8v-8c3v-cxfq/GHSA-hm8v-8c3v-cxfq.json","https://github.com/eslerm/ubuntu-cve-tracker/blob/f17e5ebf7a87347cc68d8fae347d07409a857342/active/CVE-2025-11234","https://github.com/Patrowl/PatrowlHearsData/blob/0f7d9238ba77f900663100d40113352eb3a480d7/SSVC/data/2025/CVE-2025-11234.json","https://github.com/bmwiedemann/openSUSE/blob/d8a287381c78b37aa3d10fca316ba2301f060da3/packages/q/qemu/.rev","https://github.com/xhls008/nvd_yesterday/blob/08ea89e8807d0d5cf7150243c834721985237c9e/CVEs_log/2025-10-04_zh.md"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":[],"repo_exp_urls":[],"has_poc":false,"has_exp":false,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/2025/AVE-2025-0461.toml"},{"ave_id":"AVE-2025-0446","file_name":"2025/AVE-2025-0446.toml","cve_id":"CVE-2025-11083","title":"GNU Binutils 链接器 elfcode.h 基于堆的缓冲区溢出漏洞","description":"GNU Binutils 2.45 版本的链接器组件中，bfd/elfcode.h 文件的 elf_swap_shdr 函数存在基于堆的缓冲区溢出漏洞。本地攻击者可通过构造恶意的 ELF 文件触发该漏洞，导致目标系统上的程序崩溃或潜在的内存数据破坏。该漏洞需要本地访问权限，攻击复杂度较低，CVSS 评分 1.9，危害等级低。厂商已在 commit 9ca499644a21ceb3f946d1c179c38a83be084490 中修复，建议升级至 Binutils 2.46 版本。","severity":"LOW","score":1.9,"aliases":["CVE-2025-11083"],"sources":["msrc"],"published":"2025-09-27T23:15:32Z","updated":"2026-06-17T08:29:36Z","remediation":"升级 GNU Binutils 至 2.46 或更高版本（官方已确认 2.46 修复此问题）。SUSE Linux 用户请安装 SUSE-SU-2025:4096-1 安全更新。如无法立即升级，可应用补丁 9ca499644a21ceb3f946d1c179c38a83be084490 手动修补 bfd/elfcode.h 中 elf_swap_shdr 函数的堆缓冲区溢出问题，并避免对不可信二进制文件执行链接操作作为临时缓解措施。","status":"completed","collected_at":"2026-07-27T00:00:00Z","references":["https://sourceware.org/bugzilla/attachment.cgi?id=16353","https://sourceware.org/bugzilla/show_bug.cgi?id=33457","https://sourceware.org/bugzilla/show_bug.cgi?id=33457#c1","https://sourceware.org/git/gitweb.cgi?p=binutils-gdb.git;h=9ca499644a21ceb3f946d1c179c38a83be084490","https://vuldb.com/?ctiid.326124","https://vuldb.com/?id.326124","https://vuldb.com/?submit.661277","https://www.gnu.org/","https://cert-portal.siemens.com/productcert/html/ssa-082556.html","https://github.com/trickest/cve/blob/be44b05b9428dc18bc0705cf60dd8d8640cd49b1/2025/CVE-2025-11083.md","https://github.com/CVEProject/cvelistV5/blob/933422a5f82611777877a3549b9b8e3c7d70117d/cves/2025/11xxx/CVE-2025-11083.json","https://github.com/neuvector/vul-source/blob/ada0c6c45d02a82e11f6f46403716f0946c37f98/ubuntu-cve-tracker/retired/CVE-2025-11083","https://github.com/microsoft/azurelinux/blob/b1937ff37cca040858bab5da20d395f6f93139fd/specs/b/binutils/binutils.spec","https://github.com/grafana/grafana-image-renderer/blob/0a918126b9e7fd11d49cb100c32a439da9d3d30d/CHANGELOG.md","https://github.com/canonical/ubuntu-security-notices/blob/7fb6b5b3f877cb85d43b44481d8426d9d97694f8/osv/cve/2025/UBUNTU-CVE-2025-11083.json","https://github.com/cisagov/vulnrichment/blob/e1d7afb428742628d991f2465e712a059beb8d79/2025/11xxx/CVE-2025-11083.json","https://github.com/sec-dojo-com/cve-poc/blob/1c2e0105dfc8043b137c91cc2d5ac23317d19c53/pocs/2025/CVE-2025-11083.md","https://github.com/ubinux/yocto-ubinux/blob/ab669969f179e49d3909b71323e9a1b8957dc3e5/meta/recipes-devtools/binutils/binutils/0017-CVE-2025-11083.patch","https://github.com/bell-sw/osv-database/blob/913667a73bdbecec80569e2765753066c820c678/BELL-CVE/BELL-CVE-2025-11083.json"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":[],"repo_exp_urls":[],"has_poc":false,"has_exp":false,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/2025/AVE-2025-0446.toml"},{"ave_id":"AVE-2025-0445","file_name":"2025/AVE-2025-0445.toml","cve_id":"CVE-2025-11082","title":"GNU Binutils 链接器基于堆的缓冲区溢出漏洞","description":"GNU Binutils 2.45 版本的链接器组件在处理 ELF 文件的异常帧头（.eh_frame）信息时，`bfd/elf-eh-frame.c` 文件中的 `_bfd_elf_parse_eh_frame` 函数存在基于堆的缓冲区溢出漏洞。本地攻击者可通过构造特制的 ELF 文件，诱导目标用户使用受影响版本的链接器进行链接操作，触发堆缓冲区溢出，可能导致信息泄露或程序崩溃。该漏洞需本地访问且需低权限用户交互，CVSS 评分 1.9，危害等级低。GNU Binutils 已在 2.46 版本中修复此问题。","severity":"LOW","score":1.9,"aliases":["CVE-2025-11082"],"sources":["msrc"],"published":"2025-09-27T23:15:31Z","updated":"2026-06-17T08:29:36Z","remediation":"升级 GNU Binutils 至 2.46 或更高版本（官方已确认修复）。补丁 commit 为 ea1a0737c7692737a644af0486b71e4a392cbca8，可手动应用该补丁重新编译。对于无法立即升级的系统，限制本地用户对受影响二进制文件（ld/linker）的执行权限作为临时缓解措施。","status":"completed","collected_at":"2026-07-27T00:00:00Z","references":["https://sourceware.org/bugzilla/attachment.cgi?id=16358","https://sourceware.org/bugzilla/show_bug.cgi?id=33464","https://sourceware.org/bugzilla/show_bug.cgi?id=33464#c2","https://sourceware.org/git/gitweb.cgi?p=binutils-gdb.git;h=ea1a0737c7692737a644af0486b71e4a392cbca8","https://vuldb.com/?ctiid.326123","https://vuldb.com/?id.326123","https://vuldb.com/?submit.661276","https://www.gnu.org/","https://cert-portal.siemens.com/productcert/html/ssa-082556.html","https://github.com/trickest/cve/blob/be44b05b9428dc18bc0705cf60dd8d8640cd49b1/2025/CVE-2025-11082.md","https://github.com/CVEProject/cvelistV5/blob/933422a5f82611777877a3549b9b8e3c7d70117d/cves/2025/11xxx/CVE-2025-11082.json","https://github.com/neuvector/vul-source/blob/e9a4ab6839838576fc98bcb2ecd0e476425665f5/ubuntu-cve-tracker/retired/CVE-2025-11082","https://github.com/microsoft/azurelinux/blob/b1937ff37cca040858bab5da20d395f6f93139fd/specs/b/binutils/binutils.spec","https://github.com/grafana/grafana-image-renderer/blob/0a918126b9e7fd11d49cb100c32a439da9d3d30d/CHANGELOG.md","https://github.com/canonical/ubuntu-security-notices/blob/7fb6b5b3f877cb85d43b44481d8426d9d97694f8/osv/cve/2025/UBUNTU-CVE-2025-11082.json","https://github.com/cisagov/vulnrichment/blob/e1d7afb428742628d991f2465e712a059beb8d79/2025/11xxx/CVE-2025-11082.json","https://github.com/ubinux/yocto-ubinux/blob/ab669969f179e49d3909b71323e9a1b8957dc3e5/meta/recipes-devtools/binutils/binutils/0016-CVE-2025-11082.patch","https://github.com/ctrliq/advisories/blob/4f3805708a5babb7cf2aa753acb3fa9dbee5856a/csaf/vex/cve/2025/cve-2025-11082.json","https://github.com/sec-dojo-com/cve-poc/blob/1c2e0105dfc8043b137c91cc2d5ac23317d19c53/pocs/2025/CVE-2025-11082.md"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":["https://raw.githubusercontent.com/adysec/AVE/main/pocs/2025/POC-AVE-2025-0445.toml"],"repo_exp_urls":[],"has_poc":true,"has_exp":false,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/2025/AVE-2025-0445.toml"},{"ave_id":"AVE-2025-0444","file_name":"2025/AVE-2025-0444.toml","cve_id":"CVE-2025-11081","title":"GNU Binutils objdump 越界读取漏洞","description":"GNU Binutils 2.45 的 binutils/objdump.c 文件中 dump_dwarf_section 函数存在越界读取漏洞。本地攻击者可通过向目标系统提交特制的畸形 DWARF 调试信息文件触发该漏洞，导致 objdump 进程读取越界内存，可能造成敏感信息泄露或程序崩溃。该漏洞仅需本地低权限访问即可利用，无需用户交互。目前已有公开的 PoC 利用代码，建议用户及时安装补丁 f87a66db645caf8cc0e6fc87b0c28c78a38af59b 进行修复。","severity":"LOW","score":1.9,"aliases":["CVE-2025-11081"],"sources":["msrc"],"published":"2025-09-27T22:15:32Z","updated":"2026-06-17T08:29:36Z","remediation":"立即应用上游补丁 f87a66db645caf8cc0e6fc87b0c28c78a38af59b，升级 GNU Binutils 至 2.45 以上版本（如 2.46 或最新快照）。若无法升级，可手动修补 binutils/objdump.c 中 dump_dwarf_section 和 dump_sframe_section 函数，在访问 elf_section_type 前增加 bfd_get_flavour 检查以规避非 ELF 文件导致的段错误。","status":"completed","collected_at":"2026-07-27T00:00:00Z","references":["https://github.com/user-attachments/files/20623354/hdf5_crash_3.txt","https://sourceware.org/bugzilla/show_bug.cgi?id=33406","https://sourceware.org/bugzilla/show_bug.cgi?id=33406#c2","https://sourceware.org/git/gitweb.cgi?p=binutils-gdb.git;h=f87a66db645caf8cc0e6fc87b0c28c78a38af59b","https://vuldb.com/?ctiid.326122","https://vuldb.com/?id.326122","https://vuldb.com/?submit.661275","https://www.gnu.org/","https://github.com/trickest/cve/blob/be44b05b9428dc18bc0705cf60dd8d8640cd49b1/2025/CVE-2025-11081.md","https://github.com/CVEProject/cvelistV5/blob/933422a5f82611777877a3549b9b8e3c7d70117d/cves/2025/11xxx/CVE-2025-11081.json","https://github.com/canonical/ubuntu-security-notices/blob/7fb6b5b3f877cb85d43b44481d8426d9d97694f8/osv/cve/2025/UBUNTU-CVE-2025-11081.json","https://github.com/neuvector/vul-source/blob/e9a4ab6839838576fc98bcb2ecd0e476425665f5/ubuntu-cve-tracker/retired/CVE-2025-11081","https://github.com/cisagov/vulnrichment/blob/16901ed3086419e92a3d59446e25736507cf6a0b/2025/11xxx/CVE-2025-11081.json","https://github.com/grafana/grafana-image-renderer/blob/0a918126b9e7fd11d49cb100c32a439da9d3d30d/CHANGELOG.md","https://github.com/ubinux/yocto-ubinux/blob/ab669969f179e49d3909b71323e9a1b8957dc3e5/meta/recipes-devtools/binutils/binutils/0015-CVE-2025-11081.patch","https://github.com/sec-dojo-com/cve-poc/blob/1c2e0105dfc8043b137c91cc2d5ac23317d19c53/pocs/2025/CVE-2025-11081.md","https://github.com/bell-sw/osv-database/blob/913667a73bdbecec80569e2765753066c820c678/BELL-CVE/BELL-CVE-2025-11081.json","https://github.com/github/advisory-database/blob/c55392b715d0e2e1caa8bc26997a940be7494a13/advisories/unreviewed/2025/09/GHSA-q5cj-48g5-f774/GHSA-q5cj-48g5-f774.json"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":[],"repo_exp_urls":[],"has_poc":false,"has_exp":false,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/2025/AVE-2025-0444.toml"},{"ave_id":"AVE-2025-0443","file_name":"2025/AVE-2025-0443.toml","cve_id":"CVE-2025-11021","title":"GNOME libsoup HTTP库Cookie日期处理越界读取漏洞","description":"libsoup HTTP 库的 cookie 日期处理逻辑存在越界读取漏洞。libsoup 是 GNOME 及其他应用程序广泛使用的 HTTP 通信库，在处理带有特制过期日期的 cookie 时，由于未对日期字符串进行充分边界检查，导致越界内存读取。远程攻击者无需身份认证即可通过向目标应用发送特制 cookie 触发该漏洞，可能导致进程内存中的敏感信息泄露。该漏洞影响使用 libsoup 库的各类 GNOME 应用及依赖该库的 Linux 发行版，CVSS 评分 7.5，危害等级高。","severity":"HIGH","score":7.5,"aliases":["CVE-2025-11021"],"sources":["msrc"],"published":"2025-09-26T09:15:31Z","updated":"2026-06-29T21:16:31Z","remediation":"升级 libsoup 至 3.6.5 或更高版本（修复合入于 commit 9e1a427d）。各发行版用户：Ubuntu 安装 `libsoup3` 更新包，Fedora/RHEL 运行 `dnf update libsoup3`，openSUSE 运行 `zypper update libsoup3`。如无法立即升级，可应用上游补丁（见 OpenIndiana oi-userland 仓库 12-CVE-2025-11021.patch）对 `soup-date-utils.c` 和 `soup-cookie.c` 添加 `soup_date_time_to_string()` 返回值空指针检查，避免越界读取。","status":"completed","collected_at":"2026-07-27T00:00:00Z","references":["https://access.redhat.com/errata/RHSA-2025:18183","https://access.redhat.com/errata/RHSA-2025:19713","https://access.redhat.com/errata/RHSA-2025:19714","https://access.redhat.com/errata/RHSA-2025:20959","https://access.redhat.com/errata/RHSA-2025:21032","https://access.redhat.com/errata/RHSA-2025:21655","https://access.redhat.com/errata/RHSA-2025:21656","https://access.redhat.com/errata/RHSA-2025:21657","https://access.redhat.com/errata/RHSA-2025:21664","https://access.redhat.com/errata/RHSA-2025:21665","https://access.redhat.com/errata/RHSA-2025:21666","https://access.redhat.com/errata/RHSA-2025:21772","https://access.redhat.com/errata/RHSA-2025:22013","https://access.redhat.com/security/cve/CVE-2025-11021","https://bugzilla.redhat.com/show_bug.cgi?id=2399627","https://gitlab.gnome.org/GNOME/libsoup/-/issues/459","https://github.com/CVEProject/cvelistV5/blob/933422a5f82611777877a3549b9b8e3c7d70117d/cves/2025/11xxx/CVE-2025-11021.json","https://github.com/sec-dojo-com/cve-poc/blob/1c2e0105dfc8043b137c91cc2d5ac23317d19c53/pocs/2025/CVE-2025-11021.md","https://github.com/OpenIndiana/oi-userland/blob/8263275862af611837951adfb0885ed498396892/components/library/libsoup3/patches/12-CVE-2025-11021.patch","https://github.com/canonical/ubuntu-security-notices/blob/7fb6b5b3f877cb85d43b44481d8426d9d97694f8/osv/cve/2025/UBUNTU-CVE-2025-11021.json","https://github.com/neuvector/vul-source/blob/e9a4ab6839838576fc98bcb2ecd0e476425665f5/ubuntu-cve-tracker/active/CVE-2025-11021","https://github.com/cisagov/vulnrichment/blob/16901ed3086419e92a3d59446e25736507cf6a0b/2025/11xxx/CVE-2025-11021.json","https://github.com/github/advisory-database/blob/effb2f348554323580d029ec0e691334888b7fed/advisories/unreviewed/2025/09/GHSA-fjfx-vwp2-gqr8/GHSA-fjfx-vwp2-gqr8.json","https://github.com/KaweGG/vulnerability_tracker/blob/01de5763b71f6c005791d4aa8121132990782604/cves/CVE-2025-11021.md","https://github.com/eslerm/ubuntu-cve-tracker/blob/f17e5ebf7a87347cc68d8fae347d07409a857342/active/CVE-2025-11021","https://github.com/openSUSE/news-o-o/blob/f00a24fa16e9d957a04b4b8d47c2090853697549/_posts/2025/2025-10-31-tw-monthly-update-oct.md"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":["https://raw.githubusercontent.com/adysec/AVE/main/pocs/2025/POC-AVE-2025-0443.toml"],"repo_exp_urls":[],"has_poc":true,"has_exp":false,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/2025/AVE-2025-0443.toml"},{"ave_id":"AVE-2025-0439","file_name":"2025/AVE-2025-0439.toml","cve_id":"CVE-2025-10911","title":"libxslt 解析 XSL 节点释放后使用漏洞","description":"libxslt 在解析 XSL 节点时存在释放后使用（Use-After-Free）漏洞。当处理跨 RVT（Runtime Variable Tree）存储的 key 数据时，程序未能正确管理内存生命周期，导致已释放的指针被继续引用，可能触发过期指针的解引用操作，造成应用程序崩溃。该漏洞需要用户交互触发，攻击者需诱使用户打开特制的 XSL 文件，影响范围限于本地攻击场景，CVSS 评分 5.5，危害等级中危。受影响的版本包括 libxslt 1.1.x 系列。","severity":"MEDIUM","score":5.5,"aliases":["CVE-2025-10911"],"sources":["msrc"],"published":"2025-09-25T16:15:31Z","updated":"2026-07-23T14:16:56Z","remediation":"将 libxslt 升级至 1.1.44 或更高版本（v1.1.44 于 2025-11-25 发布，v1.1.45 于 2025-11-30 发布）。RHEL 8 用户升级至 libxslt-1.1.32-6.4.el8_10，RHEL 10 用户升级至 libxslt-1.1.39-8.el10_2.1，对应 RHSA 公告。如无法立即升级，避免在不可信来源的 XSLT 样式表中使用 xsl:key 和跨 RVT 引用，并限制本地用户上传恶意 XSL 文件。","status":"completed","collected_at":"2026-07-27T00:00:00Z","references":["https://access.redhat.com/errata/RHSA-2026:11015","https://access.redhat.com/errata/RHSA-2026:26355","https://access.redhat.com/errata/RHSA-2026:28243","https://access.redhat.com/errata/RHSA-2026:28584","https://access.redhat.com/errata/RHSA-2026:29807","https://access.redhat.com/errata/RHSA-2026:29809","https://access.redhat.com/errata/RHSA-2026:29811","https://access.redhat.com/errata/RHSA-2026:29814","https://access.redhat.com/errata/RHSA-2026:29975","https://access.redhat.com/errata/RHSA-2026:29976","https://access.redhat.com/errata/RHSA-2026:30847","https://access.redhat.com/errata/RHSA-2026:33313","https://access.redhat.com/errata/RHSA-2026:44481","https://access.redhat.com/security/cve/CVE-2025-10911","https://bugzilla.redhat.com/show_bug.cgi?id=2397838","https://gitlab.gnome.org/GNOME/libxslt/-/issues/144","https://gitlab.gnome.org/GNOME/libxslt/-/merge_requests/77","https://github.com/trickest/cve/blob/be44b05b9428dc18bc0705cf60dd8d8640cd49b1/2025/CVE-2025-10911.md","https://github.com/CVEProject/cvelistV5/blob/145038fbd12ba507a810d82f3ca7bed9554ecf9f/cves/2025/10xxx/CVE-2025-10911.json","https://github.com/canonical/ubuntu-security-notices/blob/7fb6b5b3f877cb85d43b44481d8426d9d97694f8/osv/cve/2025/UBUNTU-CVE-2025-10911.json","https://github.com/neuvector/vul-source/blob/eed339cf256327c44d192c0d80436ef03b70d37e/ubuntu-cve-tracker/active/CVE-2025-10911","https://github.com/0xMarcio/cve/blob/75b5e380a041f7d82baaaae75856fe8702a1ff30/2025/CVE-2025-10911.md","https://github.com/cisagov/vulnrichment/blob/16901ed3086419e92a3d59446e25736507cf6a0b/2025/10xxx/CVE-2025-10911.json","https://github.com/VirtualBox/virtualbox/blob/ed9472c42b0a0f5426665dc5506e93bc203
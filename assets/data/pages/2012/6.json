m/yarencheng/cve-devops-playground/blob/b41e970743d15aec60299cbc12139ba5a0ac3bb6/content/CVE-2012-3618.md","https://github.com/CVEProject/cvelist-dev/blob/5b8fbb570438e8094550205589cc6f1d122acc94/2012/3xxx/CVE-2012-3618.json","https://github.com/fkie-cad/nvd-json-data-feeds/blob/2045bff4b424e5738e99702781803fdc8b55ff87/CVE-2012/CVE-2012-36xx/CVE-2012-3618.json","https://github.com/opencve/opencve-kb/blob/7e7ff27a2a43d6a76e9c2a314d1074b5484220ae/2012/CVE-2012-3618.json"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":[],"repo_exp_urls":[],"has_poc":false,"has_exp":false,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/2012/AVE-2012-0294.toml"},{"ave_id":"AVE-2012-0291","file_name":"2012/AVE-2012-0291.toml","cve_id":"CVE-2012-3615","title":"Apple Safari WebKit 内存破坏远程代码执行漏洞","description":"tags.<value>WebKit 浏览器引擎存在内存破坏漏洞，未经身份认证的远程攻击者可构造恶意网站，诱使用户访问特制网页内容触发该漏洞，导致远程代码执行或应用程序崩溃造成拒绝服务。该漏洞影响 Apple Safari 6.0 之前版本、iOS 6.0 以下设备及 iTunes 10.6.3 等使用 WebKit 的产品，攻击者无需任何认证即可远程利用，攻击门槛极低，CVSS 评分 9.3，危害等级严重。","severity":"CRITICAL","score":9.3,"aliases":["CVE-2012-3615"],"sources":["tenable"],"published":"2012-07-25T20:55:02Z","updated":"2026-06-16T23:43:35Z","remediation":"升级至 iTunes 10.7 或更高版本（Windows），或升级至 Safari 6.0 并安装 OS X Lion v10.7.4（Mac），iOS 设备升级至 iOS 6。如无法立即升级，可暂时避免使用 Safari 或 iTunes 访问未知网站作为临时缓解措施。","status":"completed","collected_at":"2026-08-06T00:00:00Z","references":["http://lists.apple.com/archives/security-announce/2012/Jul/msg00000.html","http://lists.apple.com/archives/security-announce/2012/Sep/msg00001.html","http://lists.apple.com/archives/security-announce/2012/Sep/msg00003.html","http://support.apple.com/kb/HT5400","http://support.apple.com/kb/HT5485","http://support.apple.com/kb/HT5503","https://github.com/CVEProject/cvelistV5/blob/663b7221ac0c437440bcbb2f29bd619793e09cad/cves/2012/3xxx/CVE-2012-3615.json","https://github.com/LiuCan01/cve-list-pro/blob/78b55511cee3604c22d518e32822f0435d0cacc0/cve-list/CVE-2012/CVE-2012-3615","https://github.com/canonical/ubuntu-security-notices/blob/cb915da527ff1f7ae59c6e959143aa27dc42dc24/osv/cve/2012/UBUNTU-CVE-2012-3615.json","https://github.com/canonical/ubuntu-security-notices/blob/cb915da527ff1f7ae59c6e959143aa27dc42dc24/vex/cve/2012/CVE-2012-3615.json","https://github.com/nottrobin/ubuntu-cve-tracker/blob/36e411296b5707284049ec2e0db8d2622feca498/retired/CVE-2012-3615","https://github.com/kees/ubuntu-cve-tracker/blob/66a43c37da527bc16621fb5548dca8aa1f46e537/retired/CVE-2012-3615","https://github.com/neuvector/vul-source/blob/07f0931dd35f996dbf6b1a3296eaf61225fd7563/ubuntu-cve-tracker/retired/CVE-2012-3615","https://github.com/Patrowl/PatrowlHearsData/blob/bd3fb132c1b8a95ef2bcf26b230a07f7c9700666/CVE/data/2012/CVE-2012-3615.json","https://github.com/nomi-sec/NVD-Database/blob/23dc120c34402aaa65883c51c1d03b3cb02c20cb/2012/CVE-2012-3615.json","https://github.com/pombredanne/git.launchpad.net-ubuntu-cve-tracker-/blob/fcedabe073a8eb8b2e85c436aeec152320c7cde3/retired/CVE-2012-3615"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":[],"repo_exp_urls":[],"has_poc":false,"has_exp":false,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/2012/AVE-2012-0291.toml"},{"ave_id":"AVE-2012-0287","file_name":"2012/AVE-2012-0287.toml","cve_id":"CVE-2012-3611","title":"Apple Safari WebKit内存破坏远程代码执行漏洞","description":"Apple Safari 及其所依赖的 WebKit 渲染引擎在处理特制网页时存在内存破坏漏洞。攻击者可通过诱导用户访问精心构造的恶意网站，触发 WebKit 在解析 DOM、脚本执行或渲染流程中的内存访问错误，导致内存破坏和进程崩溃，从而造成拒绝服务，甚至可在目标系统上以当前用户权限执行任意代码。该漏洞属于无需认证的远程攻击，攻击者只需构造恶意网页并欺骗用户点击即可利用，攻击条件相对容易满足。该漏洞影响 Apple Safari 6.0 之前的所有版本，Apple 已于 2012 年 7 月 25 日发布安全更新（APPLE-SA-2012-07-25-1）予以修复，建议用户升级到 Safari 6.0 或更高版本以规避风险。","severity":"CRITICAL","score":9.3,"aliases":["CVE-2012-3611"],"sources":["tenable"],"published":"2012-07-25T20:55:02Z","updated":"2026-06-16T23:43:34Z","remediation":"建议立即将 Apple Safari 升级至 6.0 及以上版本，将 Apple iOS 升级至 6.0 及以上版本，将 Apple TV 升级至 5.1 及以上版本，以修复 WebKit 内存破坏漏洞。如无法立即升级，应通过家长控制或企业 MDM 策略禁止访问不受信任的网站，并关闭浏览器的自动填充密码功能以降低信息泄露风险。","status":"completed","collected_at":"2026-08-06T00:00:00Z","references":["http://lists.apple.com/archives/security-announce/2012/Jul/msg00000.html","http://lists.apple.com/archives/security-announce/2012/Sep/msg00001.html","http://lists.apple.com/archives/security-announce/2012/Sep/msg00003.html","http://support.apple.com/kb/HT5400","http://support.apple.com/kb/HT5485","http://support.apple.com/kb/HT5503","https://github.com/CVEProject/cvelistV5/blob/ad23a84307831b745d27b34af84abc59130b2cd5/cves/2012/3xxx/CVE-2012-3611.json","https://github.com/LiuCan01/cve-list-pro/blob/78b55511cee3604c22d518e32822f0435d0cacc0/cve-list/CVE-2012/CVE-2012-3611","https://github.com/canonical/ubuntu-security-notices/blob/cb915da527ff1f7ae59c6e959143aa27dc42dc24/osv/cve/2012/UBUNTU-CVE-2012-3611.json","https://github.com/canonical/ubuntu-security-notices/blob/cb915da527ff1f7ae59c6e959143aa27dc42dc24/vex/cve/2012/CVE-2012-3611.json","https://github.com/nottrobin/ubuntu-cve-tracker/blob/36e411296b5707284049ec2e0db8d2622feca498/retired/CVE-2012-3611","https://github.com/kees/ubuntu-cve-tracker/blob/66a43c37da527bc16621fb5548dca8aa1f46e537/retired/CVE-2012-3611","https://github.com/neuvector/vul-source/blob/07f0931dd35f996dbf6b1a3296eaf61225fd7563/ubuntu-cve-tracker/retired/CVE-2012-3611","https://github.com/Patrowl/PatrowlHearsData/blob/bd3fb132c1b8a95ef2bcf26b230a07f7c9700666/CVE/data/2012/CVE-2012-3611.json","https://github.com/nomi-sec/NVD-Database/blob/23dc120c34402aaa65883c51c1d03b3cb02c20cb/2012/CVE-2012-3611.json","https://github.com/pombredanne/git.launchpad.net-ubuntu-cve-tracker-/blob/fcedabe073a8eb8b2e85c436aeec152320c7cde3/retired/CVE-2012-3611"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":[],"repo_exp_urls":[],"has_poc":false,"has_exp":false,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/2012/AVE-2012-0287.toml"},{"ave_id":"AVE-2012-0286","file_name":"2012/AVE-2012-0286.toml","cve_id":"CVE-2012-3610","title":"Apple Safari WebKit 内存破坏远程代码执行漏洞","description":"tags. Let me look at the existing description which seems mostly fine but has a broken prefix with \"tags.\" and \"<value>\". I need to clean it up.\n\nThe existing description is mostly good but has junk: \"tags.\\n\\nCVE-2012-3610:\" prefix. I should output a clean Chinese description ≥50 chars.\n\nLet me write a clean description.<value>Apple Safari 6.0 之前版本所使用的 WebKit 中存在内存破坏漏洞。该漏洞源于 WebKit 在处理恶意构造的网页内容时存在内存处理缺陷。远程攻击者可借助特制网站诱导受害者访问来触发漏洞，成功利用后可导致任意代码执行，或造成内存破坏及应用程序崩溃（即拒绝服务）。攻击无需用户认证，但需目标用户以受影响的 Safari 浏览器访问恶意网页。Apple 已于 2012 年 7 月 25 日通过安全更新（APPLE-SA-2012-07-25-1）修复该问题，涉及 Safari 及内置 WebKit 的 iTunes 10.6.3，建议用户升级至 Safari 6.0 及以上版本。\n","severity":"CRITICAL","score":9.3,"aliases":["CVE-2012-3610"],"sources":["tenable"],"published":"2012-07-25T20:55:02Z","updated":"2026-06-16T23:43:34Z","remediation":"tags.<value>立即升级 Apple Safari 至 6.0 及以上版本，OS X Lion 用户可通过系统软件更新或苹果官方支持页（https://support.apple.com/kb/HT5485、HT5400）安装更新以修复 WebKit 内存破坏漏洞；iOS 用户请升级至 6.0 版本。Windows 平台若使用旧版 Safari 的内置 WebKit，应卸载旧版并安装含修复 WebKit 的 iTunes 10.6.3 之后版本。如无法立即升级，可暂时改用 Chrome 或 Firefox 浏览不受信任的网页，并在浏览器中禁用 JavaScript 与插件、避免访问来历不明的站点，以降低恶意网页触发内存破坏、导致任意代码执行或拒绝服务的风险。","status":"completed","collected_at":"2026-08-06T00:00:00Z","references":["http://lists.apple.com/archives/security-announce/2012/Jul/msg00000.html","http://lists.apple.com/archives/security-announce/2012/Sep/msg00001.html","http://lists.apple.com/archives/security-announce/2012/Sep/msg00003.html","http://support.apple.com/kb/HT5400","http://support.apple.com/kb/HT5485","http://support.apple.com/kb/HT5503","https://github.com/CVEProject/cvelistV5/blob/ad23a84307831b745d27b34af84abc59130b2cd5/cves/2012/3xxx/CVE-2012-3610.json","https://github.com/LiuCan01/cve-list-pro/blob/78b55511cee3604c22d518e32822f0435d0cacc0/cve-list/CVE-2012/CVE-2012-3610","https://github.com/Patrowl/PatrowlHearsData/blob/bd3fb132c1b8a95ef2bcf26b230a07f7c9700666/CVE/data/2012/CVE-2012-3610.json","https://github.com/nomi-sec/NVD-Database/blob/23dc120c34402aaa65883c51c1d03b3cb02c20cb/2012/CVE-2012-3610.json","https:/
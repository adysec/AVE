[{"ave_id":"AVE-2000-0483","file_name":"2000/AVE-2000-0483.toml","cve_id":"CVE-2000-0441","title":"IBM AIX 文件系统权限提升漏洞","description":"CVE-2000-0441是一个安全漏洞，影响相关产品的安全性。攻击者可能利用此漏洞执行任意代码或获取未授权访问。建议用户及时更新到最新版本以修复此问题。","severity":"MEDIUM","score":5.0,"aliases":["CVE-2000-0441"],"sources":["avd"],"published":"2000-05-24T04:00:00Z","updated":"2026-06-16T21:51:44Z","remediation":"升级 IBM AIX 到 4.3.3 或更高版本，或应用 IBM 官方提供的对应 APAR 安全补丁。如无法立即升级，可通过修改 /etc/exports 限制 NFS 文件系统的读写权限，将涉及敏感数据的文件系统挂载为只读（read-only），并删除不必要的用户 shell 访问权限或使用 chmod 限制关键目录的写权限，以降低本地用户提升文件系统写权限的风险。","status":"completed","collected_at":"2026-07-23T00:00:00Z","references":["http://archives.neohapsis.com/archives/bugtraq/2000-05/0275.html","http://www.securityfocus.com/bid/1241","https://github.com/CVEProject/cvelistV5/blob/341a98a6a53723fa96a8872087b0601d6cdf2538/cves/2000/0xxx/CVE-2000-0441.json","https://github.com/LiuCan01/cve-list-pro/blob/78b55511cee3604c22d518e32822f0435d0cacc0/cve-list/CVE-2000/CVE-2000-0441","https://github.com/yarencheng/cve-devops-playground/blob/4731f60845c8f35e2bdb03d333a9e9d84c7b1c27/content/CVE-2000-0441.md","https://github.com/Patrowl/PatrowlHearsData/blob/661818a489d196676957d469a0bf9cda171fbbe9/CVE/data/2000/CVE-2000-0441.json","https://github.com/github/advisory-database/blob/02f8645da3fe19f41743b8c7e65eb8dd4925ff94/advisories/unreviewed/2022/04/GHSA-9729-395c-wp97/GHSA-9729-395c-wp97.json","https://github.com/intSpLoiT/intframework/blob/eabaa799d0260aa52b735fa9769266d1ce4b64ef/modules/cve_list.txt","https://github.com/oasis-open/cti-stix-common-objects/blob/55ba7598cbd5a52577b6887871505d931d85cb61/objects/vulnerability/vulnerability--0e8cf2c5-a13f-4b7b-8dd9-8cc0218f081c.json","https://github.com/nomi-sec/NVD-Database/blob/23dc120c34402aaa65883c51c1d03b3cb02c20cb/2000/CVE-2000-0441.json","https://github.com/leego972/titanai/blob/afa5b2310463aae5781d3fd9408071bf38e79806/data/raw/corpus_D_cyber/nvd_cve_001406.txt","https://github.com/williamjsmail/piranha/blob/e60f12e6edcde8585ee473f701c2421f6efe72d9/CVE2CAPEC/database/CVE-2000.jsonl"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":[],"repo_exp_urls":[],"has_poc":false,"has_exp":false,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/2000/AVE-2000-0483.toml"},{"ave_id":"AVE-2000-0424","file_name":"2000/AVE-2000-0424.toml","cve_id":"CVE-2000-0399","title":"Alt-N Technologies MDaemon POP服务器缓冲区溢出拒绝服务漏洞","description":"MDaemon POP3 服务器存在缓冲区溢出漏洞，远程攻击者无需身份认证即可向 POP3 服务端口（110/TCP）发送特制的超长用户名，触发缓冲区溢出，导致服务进程崩溃，造成拒绝服务。该漏洞影响 Alt-N Technologies MDaemon 邮件服务器，攻击复杂度低，可被远程利用。厂商已发布修复版本限制用户名长度。","severity":"MEDIUM","score":5.0,"aliases":["CVE-2000-0399"],"sources":["avd"],"published":"2000-05-24T04:00:00Z","updated":"2026-06-16T21:51:38Z","remediation":"立即升级 MDaemon 至 3.1.1 或更高版本，该版本已限制 POP 服务器用户名长度以防止缓冲区溢出。如无法升级，可在防火墙或 TCP Wrappers 中限制对 POP3 端口（110/TCP）的访问来源 IP，仅允许受信任的邮件客户端连接，降低远程攻击面。","status":"completed","collected_at":"2026-07-23T00:00:00Z","references":["http://archives.neohapsis.com/archives/bugtraq/2000-05/0301.html","http://www.securityfocus.com/bid/1250","https://github.com/CVEProject/cvelistV5/blob/7a274ec07043f54c07d0a3b5c7fc89ba5793f023/cves/2000/0xxx/CVE-2000-0399.json","https://github.com/LiuCan01/cve-list-pro/blob/78b55511cee3604c22d518e32822f0435d0cacc0/cve-list/CVE-2000/CVE-2000-0399","https://github.com/yarencheng/cve-devops-playground/blob/cbe73d6bdcced13ea57f08566d6bbf5345864f7e/content/CVE-2000-0399.md","https://github.com/Patrowl/PatrowlHearsData/blob/1decc7ade63192f9f527bfb87145d1636c01cc59/CVE/data/2000/CVE-2000-0399.json","https://github.com/github/advisory-database/blob/daf3a08cbe0139b666db9d48681b6efcebbecad5/advisories/unreviewed/2022/04/GHSA-jcf3-cm7w-7v5j/GHSA-jcf3-cm7w-7v5j.json","https://github.com/blackhook/nessus-plugins/blob/64177d96abbb07c58cf7e131046b067ebc61fcb5/M/mdaemon_mail_server_dos.nasl","https://github.com/nomi-sec/NVD-Database/blob/23dc120c34402aaa65883c51c1d03b3cb02c20cb/2000/CVE-2000-0399.json","https://github.com/SpeeDr00t/speedr00t.github.com/blob/0380f0c2
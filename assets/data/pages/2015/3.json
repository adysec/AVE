22","https://github.com/nomi-sec/NVD-Database/blob/23dc120c34402aaa65883c51c1d03b3cb02c20cb/2015/CVE-2015-5122.json","https://github.com/fankh/vulnerability-poc/blob/ffa50060b7ba6ae58d60d6d90533e77eaf10d466/2015/CVE-2015-5122/README.md","https://github.com/e-m-b-a/emba/blob/4d0f24b3edae0bdb5391177851bad3be54ecea0f/config/msf_cve-db.txt","https://github.com/vulncheck-oss/0day.today.archive/blob/3664abdd71985a44aff3260896a8f36e2f4a9682/remote-exploits/23871.txt","https://github.com/govbk/WIKI-POC-EXP/blob/7d1194429dab9f9dd8139408e79b70ddb41a468f/Security%20WiKi/011-drops/007-papers/0344-Hacking%20Team%E6%94%BB%E5%87%BB%E4%BB%A3%E7%A0%81%E5%88%86%E6%9E%90Part%204-%20Flash%200day%E6%BC%8F%E6%B4%9E%20CVE-2015-5122.md","https://github.com/Xattam1/Adobe-Flash-Exploits_17-18"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":[],"repo_exp_urls":[],"has_poc":false,"has_exp":false,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/2015/AVE-2015-0600.toml"},{"ave_id":"AVE-2015-0606","file_name":"2015/AVE-2015-0606.toml","cve_id":"CVE-2015-5123","title":"Adobe Flash Player ActionScript 3 BitmapData Use-After-Free漏洞","description":"Adobe Flash Player 18.0.0.203/18.0.0.204 版本中，ActionScript 3（AS3）实现的 opaqueBackground 类存在使用后释放（Use-After-Free）漏洞。未经身份认证的远程攻击者可通过向目标系统发送特制的 Flash 内容触发该漏洞，在当前进程上下文中执行任意代码。该漏洞影响 Adobe Flash Player 18.0.0.203 及 18.0.0.204 版本，同时波及 Google Chrome OS 43.0.2357.132 之前的版本。Adobe 已在后续安全更新中修复此漏洞，Red Hat 将其严重等级评定为 Critical。","severity":"CRITICAL","score":9.8,"aliases":["CVE-2015-5123"],"sources":["kev"],"published":"2015-07-14","updated":"2015-07-14","remediation":"立即将 Adobe Flash Player 升级至 18.0.0.209（Windows/macOS）或 11.2.202.491（Linux），该版本修复了 ActionScript 3 中 opaqueBackground 类的 use-after-free 漏洞。如系统已无法获取此版本更新，建议通过控制面板或应用程序管理器彻底卸载 Adobe Flash Player，并在浏览器中禁用 Flash 插件加载功能，以阻断攻击面。","status":"completed","collected_at":"2026-07-24T00:00:00Z","references":["https://github.com/trickest/cve/blob/d4b28c21b943332687c38515600e40190ff00a4e/2015/CVE-2015-5123.md","https://git
VC/data/2025/CVE-2025-21411.json","https://github.com/Patrowl/PatrowlHearsData/blob/a8ca4b37f0ada74ec6b08db2309dab894440907e/CVE/data/2025/CVE-2025-21411.json","https://github.com/mabitoski/cve_submodules/blob/44ad7e2705b3aef1b2ffaf64bd47596c10a6c2e4/2025/CVE-2025-21411.md","https://github.com/fankh/vulnerability-poc/blob/d2f211a2392a33dc3802dfba918604d771c8ebf3/2025/CVE-2025-21411/README.md","https://github.com/nomi-sec/NVD-Database/blob/23dc120c34402aaa65883c51c1d03b3cb02c20cb/2025/CVE-2025-21411.json","https://github.com/fankh/vulnerability-poc/blob/d2f211a2392a33dc3802dfba918604d771c8ebf3/2025/CVE-2025-21411/poc.py"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":[],"repo_exp_urls":[],"has_poc":false,"has_exp":false,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/2025/AVE-2025-0872.toml"},{"ave_id":"AVE-2025-0870","file_name":"2025/AVE-2025-0870.toml","cve_id":"CVE-2025-21409","title":"Microsoft Windows 电话服务远程代码执行漏洞","description":"Windows Telephony Service（电话服务API，TAPI）存在堆缓冲区溢出漏洞（CWE-122），由于服务在处理特制RPC请求时未正确验证输入数据长度，导致堆内存越界写入。远程攻击者可通过向目标系统发送精心构造的RPC消息触发该漏洞，成功利用可在目标系统上以SYSTEM权限执行任意代码。攻击者需诱导用户连接到恶意RPC服务器或触发特定操作（需用户交互），无需身份认证即可发起攻击。该漏洞影响Windows 10、Windows 11及Windows Server 2019/2022等多个版本，CVSS评分8.8，危害等级高。Microsoft已在2025年1月安全更新（补丁编号5049981/5049983/5049984/5050004/5050021）中修复此漏洞。","severity":"HIGH","score":8.8,"aliases":["CVE-2025-21409"],"sources":["msrc"],"published":"2025-01-14T18:16:04Z","updated":"2026-06-17T08:43:17Z","remediation":"立即安装 Microsoft 2025 年 1 月安全更新 KB5049984（Windows Server 2022/Windows 11 21H2）或对应版本的累积更新，通过 Windows Update 自动获取。如无法立即打补丁，可在组策略中禁用 Telephony 服务（TapiSrv）并将远程过程调用（RPC）访问限制在受信任网络段内作为临时缓解措施。","status":"completed","collected_at":"2026-08-05T00:00:00Z","references":["https://msrc.microsoft.com/update-guide/vulnerability/CVE-2025-21409","https://github.com/CVEProject/cvelistV5/blob/8f86f3866df0d1c5d8aff409ea4847883047cbe6/cves/2025/21xxx/CVE-2025-21409.json","https://github.com/cisagov/vulnrichment/blob/4683223ae150496144b181156e51d2b32e
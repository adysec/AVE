[{"ave_id":"AVE-2012-0055","file_name":"2012/AVE-2012-0055.toml","cve_id":"CVE-2012-0391","title":"Apache Struts2 远程命令执行漏洞","description":"Apache Struts2 的 ExceptionDelegator 组件在处理属性数据类型不匹配的异常时，会将用户传入的参数值作为 OGNL 表达式进行解析执行，导致远程命令执行漏洞。攻击者无需认证即可通过向受影响应用发送特制的 HTTP 请求参数触发该漏洞，从而在服务器上执行任意 Java 代码，完全控制目标系统。该漏洞影响 Apache Struts2 2.0.0 至 2.3.17 版本，CVSS 评分 9.8，危害等级严重。","severity":"CRITICAL","score":9.8,"aliases":["CVE-2012-0391"],"sources":["kev"],"published":"2012-01-08T15:55:01.217","updated":"2026-06-16T23:37:12.150","remediation":"升级 Apache Struts2 至 2.3.17 及以上版本（官方修复版本为 2.2.3.1），该漏洞在 2.3.17 中彻底修复。如无法升级，在 struts.xml 中禁用动态方法调用：<constant name=\"struts.enable.DynamicMethodInvocation\" value=\"false\" />，并严格校验用户输入，过滤 OGNL 表达式特殊字符。同时建议部署 WAF 规则拦截包含 OGNL 表达式的请求参数。","status":"completed","collected_at":"2026-07-22T00:00:00Z","references":["http://archives.neohapsis.com/archives/bugtraq/2012-01/0031.html","http://secunia.com/advisories/47393","http://struts.apache.org/2.x/docs/s2-008.html","http://struts.apache.org/2.x/docs/version-notes-2311.html","http://www.exploit-db.com/exploits/18329","https://issues.apache.org/jira/browse/WW-3668","https://www.sec-consult.com/files/20120104-0_Apache_Struts2_Multiple_Critical_Vulnerabilities.txt","https://www.cisa.gov/known-exploited-vulnerabilities-catalog?field_cve=CVE-2012-0391","https://www.exploit-db.com/exploits/18984","https://github.com/trickest/cve/blob/ed228d55b7972f63e700a35a54fbcd94064b9ade/2012/CVE-2012-0391.md","https://github.com/CVEProject/cvelistV5/blob/528991f6906b29893dd0e43e65862cd92fd607c8/cves/2012/0xxx/CVE-2012-0391.json","https://github.com/Ares-X/VulWiki/blob/40e0273754a36f49a6be6a77a7a4c210a07063ed/Web%E5%AE%89%E5%85%A8/Apache%20Struts/%EF%BC%88CVE-2012-0391%EF%BC%89s2-008.md","https://github.com/govbk/WIKI-POC-EXP/blob/7d1194429dab9f9dd8139408e79b70ddb41a468f/%E9%9B%B6%E7%BB%84%E6%BC%8F%E6%B4%9E%E7%9B%B8%E5%85%B3/160-Apache%20Struts/007-%EF%BC%88CVE-2012-0391%EF%BC%89s2-008.md","https://github.com/ARPSyndicate/suricata-vedas/blob/fe24794ad36564b5bbc7c69101525011387b8650/2012/CVE-2012-0391.rules","https://github.com/cisagov/vulnrichment/blob/4a810b0db2e9cab67156f722c309e925ee8f02a0/2012/0xxx/CVE-2012-0391.json","https://github.com/neuvector/vul-source/blob/9ba62febaf6254d72eb4667cd7923d92d2c3f9b6/ubuntu-cve-tracker/retired/CVE-2012-0391","https://github.com/Tabll/gemnasium-db/blob/de1cbf8802a4c6060caaa5924b50812f2a62fead/maven/org.apache.struts/struts2-parent/CVE-2012-0391.yml","https://github.com/e-m-b-a/emba/blob/4d0f24b3edae0bdb5391177851bad3be54ecea0f/config/msf_cve-db.txt","https://github.com/fankh/vulnerability-poc/blob/ffa50060b7ba6ae58d60d6d90533e77eaf10d466/2012/CVE-2012-0391/README_KO.md"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":[],"repo_exp_urls":[],"has_poc":false,"has_exp":false,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/2012/AVE-2012-0055.toml"},{"ave_id":"AVE-2012-0002","file_name":"2012/AVE-2012-0002.toml","cve_id":"CVE-2012-0394","title":"Apache Struts DebuggingInterceptor 代码注入漏洞","description":"Apache Struts 2 的 DebuggingInterceptor 组件在开发者模式（devMode）开启时存在代码注入漏洞（S2-008）。远程攻击者可利用调试模式下的参数拦截机制向目标应用发送特制恶意请求，在 struts 处理调试参数过程中注入 OGNL 表达式，从而在服务器端执行任意系统命令。该漏洞影响 Apache Struts 2.3.1.1 之前的版本，攻击无需身份认证，危害严重。厂商建议禁用开发者模式或升级至 2.3.1.1 及以上版本。","severity":"MEDIUM","score":6.8,"aliases":["CVE-2012-0394"],"sources":["nuclei"],"published":"2012-01-08T15:55:01.467","updated":"2026-06-16T23:37:12.583","remediation":"升级 Apache Struts 至 2.3.1.1 或更高版本以修复 DebuggingInterceptor 的代码注入漏洞。生产环境务必关闭开发者模式（devMode=false），禁止在正式环境中启用调试拦截器。如无法立即升级，可在 struts.xml 中移除 DebuggingInterceptor 的配置引用作为临时缓解措施。","status":"completed","collected_at":"2026-07-22T00:00:00Z","references":["http://archives.neohapsis.com/archives/bugtraq/2012-01/0031.html","http://struts.apache.org/2.x/docs/s2-008.html","http://struts.apache.org/2.x/docs/version-notes-2311.html","http://www.exploit-db.com/exploits/18329","http://www.exploit-db.com/exploits/31434","http://www.osvdb.org/78276","https://www.sec-consult.com/files/20120104-0_Apache_Struts2_Multiple_Critical_Vulnerabilities.txt","https://www.exploit-db.com/exploits/18329","https://github.com/projectdiscovery/nuclei-templates/blob/main/http/cves/2012/CVE-2012-0394.yaml","https://github.com/trickest/cve/blob/3ffa2a96db84a89f71e1c7ad889e5f4fcc755a48/2012/CVE-2012-0394.md","https://github.com/projectdiscovery/nuclei-templates/blob/0c7acbe01d12e3db33eedacb7a2c97c0d518fac0/http/cves/2012/CVE-2012-0394.yaml","https://github.com/CVEProject/cvelistV5/blob/4e452a37e644e8194f1171b7eec1f7dc625b6526/cves/2012/0xxx/CVE-2012-0394.json","https://github.com/ARPSyndicate/suricata-vedas/blob/fe24794ad36564b5bbc7c69101525011387b8650/2012/CVE-2012-0394.rules","https://github.com/knownsec/pocsuite3/blob/9bed2883b86a8996f8805fc44da4a1911f52a11e/pocsuite3/pocs/Apache_Struts2/README.md","https://github.com/eslerm/ubuntu-cve-tracker/blob/f17e5ebf7a87347cc68d8fae347d07409a857342/retired/CVE-2012-0394","https://github.com/nomi-sec/NVD-Database/blob/23dc120c34402aaa65883c51c1d03b3cb02c20cb/2012/CVE-2012-0394.json","https://github.com/apache/struts-examples/blob/370ba5e9bf2b5c51a2a994ebb0f38e9ad26824bd/src/etc/project-suppression.xml","https://github.com/ExpLangcn/NucleiTP/blob/2b7ecb9031a6eda4f272793045f29b339d8e0cce/CVES/medium/CVE-2012-0394.yaml","https://github.com/berez23/canvas/blob/cb306a9d8b1d8a743049a29164e6d324f8dabbfa/exploits/web/strutsCodeInjection/strutsCodeInjection.py"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":[],"repo_exp_urls":[],"has_poc":false,"has_exp":false,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/2012/AVE-2012-0002.toml"},{"ave_id":"AVE-2012-0001","file_name":"2012/AVE-2012-0001.toml","cve_id":"CVE-2012-0392","title":"Apache Struts2 CookieInterceptor 远程代码执行漏洞","description":"Apache Struts2 的 CookieInterceptor 组件在处理 HTTP Cookie 头时未对参数名称进行白名单校验，远程攻击者可通过向目标服务器发送特制的 Cookie 数据触发 Java 静态方法调用，从而实现任意代码执行。该漏洞影响 Apache Struts2 2.3.1.1 之前版本，CVSS 评分 6.8，危害等级中等。","severity":"MEDIUM","score":6.8,"aliases":["CVE-2012-0392"],"sources":["cve","nvd","nuclei"],"published":"2012-01-08","updated":"2026-06-16","remediation":"升级至 Apache Struts 2.3.1.1 及以上版本，该版本修复了 CookieInterceptor 未对参数名进行白名单过滤的问题。同时建议升级至 Struts 2.3.18 以获取针对 S2-008 所有漏洞的完整修复。若无法升级，在 struts.xml 中为 CookieInterceptor 和 ParameterInterceptor 配置更严格的 acceptedParamNames 白名单过滤规则：[a-zA-Z0-9\\.][()_']+，并关闭 DebuggingInterceptor（devMode=false）以防止 OGNL 表达式注入。","status":"completed","collected_at":"2026-07-22T00:00:00Z","references":["http://struts.apache.org/2.x/docs/s2-008.html","http://struts.apache.org/2.x/docs/version-notes-2311.html","http://secunia.com/advisories/47393","http://www.exploit-db.com/exploits/18329","http://archives.neohapsis.com/archives/bugtraq/2012-01/0031.html","https://lists.immunityinc.com/pipermail/dailydave/2012-January/000011.html","https://cwiki.apache.org/confluence/display/WW/S2-008"],"poc_urls":["http://www.exploit-db.com/exploits/18329"],"exp_urls":[],"repo_poc_urls":[],"repo_exp_urls":[],"has_poc":false,"has_exp":false,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/2012/AVE-2012-0001.toml"}]
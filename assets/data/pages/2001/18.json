ithub.com/olbat/nvdcve/blob/5b92f5917a4a825187ccaac594f43456a77ea8f3/nvdcve/CVE-2001-0250.json","https://github.com/opencve/opencve-kb/blob/773650f58a45af352e16607e65c581f63a29fe47/2001/CVE-2001-0250.json","https://github.com/fkie-cad/nvd-json-data-feeds/blob/64de4f2cd86a1126b3a6d15ba07e17a7857c3906/CVE-2001/CVE-2001-02xx/CVE-2001-0250.json","https://github.com/CyberSecAI/cve_info/blob/03b7e36424574a3a9ba5fd13480a326b666a1046/2001/0xxx/CVE-2001-0250.json","https://github.com/CVEProject/cvelist-dev/blob/5b8fbb570438e8094550205589cc6f1d122acc94/2001/0xxx/CVE-2001-0250.json","https://github.com/yarencheng/cve-devops-playground/blob/cbe73d6bdcced13ea57f08566d6bbf5345864f7e/content/CVE-2001-0250.md"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":[],"repo_exp_urls":[],"has_poc":false,"has_exp":false,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/2001/AVE-2001-0098.toml"},{"ave_id":"AVE-2001-0092","file_name":"2001/AVE-2001-0092.toml","cve_id":"CVE-2001-0224","title":"Brightstation Muscat Empower CGI 绝对路径泄露漏洞","description":"Brightstation Muscat 1.0 的 Empower CGI 程序存在路径泄露漏洞。远程攻击者可通过向 DB 参数发送无效请求获取服务器绝对路径名，从而为进一步攻击（如信息收集、目录遍历）提供基础。该漏洞无需认证即可远程利用，攻击复杂度低，CVSS 评分 5.0，危害等级中危。","severity":"MEDIUM","score":5.0,"aliases":["CVE-2001-0224"],"sources":["exploitdb"],"published":"2001-06-02T04:00:00.000","updated":"2026-06-16T21:53:54.890","remediation":"升级 Brightstation Muscat 至 1.0 以上版本。如果厂商已停止维护，建议在 Web 服务器层面（如 Apache）禁用 Muscat Empower CGI 脚本，或配置访问控制规则限制 CGI 目录的访问来源 IP。同时可在 application 层对 DB 参数进行输入过滤，拒绝包含路径遍历字符的异常请求。","status":"completed","collected_at":"2026-07-22T00:00:00Z","references":["http://archives.neohapsis.com/archives/bugtraq/2001-02/0216.html","http://www.securityfocus.com/bid/2374","https://exchange.xforce.ibmcloud.com/vulnerabilities/6093","https://www.exploit-db.com/exploits/20633","https://github.com/CVEProject/cvelistV5/blob/6b6ab35c79a8cf8624d21f1a20325bab41c1211a/cves/2001/0xxx/CVE-2001-0224.json","https://github.com/LiuCan01/cve-list-pro/blob/78b55511cee36
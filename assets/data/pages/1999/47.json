[{"ave_id":"AVE-1999-0913","file_name":"1999/AVE-1999-0913.toml","cve_id":"CVE-1999-1060","title":"{\"_meta\":{},\"stopReason\":\"end_turn\",\"usage\":{\"cachedReadTokens\":1664,\"inputTokens\":9067,\"outputTokens\":20,\"totalTokens\":10751}}","description":"Tetrix TetriNet 守护进程 1.13.16 版本存在缓冲区溢出漏洞。该漏洞源于程序在处理连接主机的 DNS 主机名时未对长度进行有效校验，当远程攻击者从一个具有超长 DNS 主机名的主机连接到目标系统的 31457 端口时，即可触发缓冲区溢出，导致守护进程崩溃产生拒绝服务，并可能进一步执行任意命令。攻击者无需身份认证，只需能够访问目标端口并控制其反向解析主机名即可实施攻击。该漏洞 CVSS v2 评分 5.0，危害等级中等。","severity":"MEDIUM","score":5.0,"aliases":["CVE-1999-1060"],"sources":["epss"],"published":"1999-02-17T00:00:00Z","updated":"1999-02-17T00:00:00Z","remediation":"升级 TetriNET 服务端至修复该缓冲区溢出问题的版本（1.13.1 及以上）。若无法立即升级，可在服务端前部署防火墙或代理限制仅信任客户端连接、关闭或过滤 TetriNET 默认 31457 端口的外部访问，并启用资源限制以减少拒绝服务影响。","status":"completed","collected_at":"2026-07-19T00:00:00Z","references":["https://github.com/trickest/cve/blob/b4f1378756fd26f414d09a97dc81126672830951/1999/CVE-1999-1060.md","https://github.com/CVEProject/cvelistV5/blob/dde4d96d7c1eff197b9a15817af615500736afa7/cves/1999/1xxx/CVE-1999-1060.json","https://github.com/LiuCan01/cve-list-pro/blob/78b55511cee3604c22d518e32822f0435d0cacc0/cve-list/CVE-1999/CVE-1999-1060","https://github.com/edoardottt/missing-cve-nuclei-templates/blob/36c16d53eb6071e39cfc3cf88e99f1b340ec913b/data/year/1999.txt","https://github.com/Patrowl/PatrowlHearsData/blob/3d905f6009ce1a0cb55b6b90198454d955586615/CVE/data/1999/CVE-1999-1060.json","https://github.com/mabitoski/cve_submodules/blob/44ad7e2705b3aef1b2ffaf64bd47596c10a6c2e4/1999/CVE-1999-1060.md","https://github.com/github/advisory-database/blob/cdfc8886d71af7ef3bdab3e4db46753ff8af6538/advisories/unreviewed/2022/04/GHSA-3xr9-56qc-vgpf/GHSA-3xr9-56qc-vgpf.json","https://github.com/nomi-sec/NVD-Database/blob/23dc120c34402aaa65883c51c1d03b3cb02c20cb/1999/CVE-1999-1060.json","https://github.com/oasis-open/cti-stix-common-objects/blob/55ba7598cbd5a52577b6887871505d931d85cb61/objects/vulnerability/vulnerability--6a35e01f-9c82-4365-a727-7af8d726e1c6.json","https://github.com/security-commits/security-patches-dataset/blob/e93fcdcc8c9b91785f962a06d66b7ee623780245/data/cve-details/year/1999.csv"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":["https://raw.githubusercontent.com/adysec/AVE/main/pocs/1999/POC-AVE-1999-0913.toml"],"repo_exp_urls":[],"has_poc":true,"has_exp":false,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/1999/AVE-1999-0913.toml"},{"ave_id":"AVE-1999-0042","file_name":"1999/AVE-1999-0042.toml","cve_id":"CVE-1999-0396","title":"NetBSD/OpenBSD TCP服务器 select/accept 竞争条件拒绝服务漏洞","description":"NetBSD和OpenBSD系统的TCP服务器在处理select()和accept()系统调用时存在竞争条件漏洞。远程攻击者可以利用该竞争条件，在特定时间窗口内发送精心构造的网络请求，导致服务器进程进入死锁状态或崩溃，从而造成拒绝服务。攻击条件较为苛刻，需要精确的时间控制，攻击复杂度较高。","severity":"LOW","score":2.6,"aliases":["CVE-1999-0396"],"sources":["cve"],"published":"1999-02-17T00:00:00Z","updated":"2026-06-16T00:00:00Z","remediation":"OpenBSD用户应应用errata 002补丁或升级至OpenBSD 2.4及以上版本；NetBSD用户应升级至1999年2月8日之后的内核版本。如无法立即升级，可在防火墙层面限制对TCP服务的访问作为临时缓解措施。","status":"completed","collected_at":"2026-07-16T00:00:00Z","references":["https://exchange.xforce.ibmcloud.com/vulnerabilities/CVE-1999-0396","https://nvd.nist.gov/vuln/detail/CVE-1999-0396","https://github.com/CVEProject/cvelistV5/blob/af5cedcf472f3690d94c4249ff35246f15692534/cves/1999/0xxx/CVE-1999-0396.json","https://github.com/github/advisory-database/blob/e434c1da6464de3012c6c1eff8c0e19ef9669023/advisories/unreviewed/2022/04/GHSA-6hqw-w28m-789c/GHSA-6hqw-w28m-789c.json"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":[],"repo_exp_urls":[],"has_poc":false,"has_exp":false,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/1999/AVE-1999-0042.toml"},{"ave_id":"AVE-1999-1003","file_name":"1999/AVE-1999-1003.toml","cve_id":"CVE-1999-1180","title":"O'Reilly WebSite 远程命令执行漏洞","description":"O'Reilly WebSite 1.1e 及 Website Pro 2.0 存在命令注入漏洞。远程攻击者无需认证即可通过向 args.cmd 或 args.bat 脚本的参数中注入 shell 元字符（如 `|`、`;`、`` ` `` 等），以 Web 服务器进程权限在目标系统上执行任意系统命令。该漏洞允许攻击者完全控制受影响服务器，可能导致数据泄露、植入后门或横向移动。CVSS 评分 5.0，危害等级中等。","severity":"MEDIUM","score":5.0,"aliases":["CVE-1999-1180"],"sources":["epss"],"published":"1999-02-16T05:00:00Z","updated":"2026-06-16T21:49:53Z","remediation":"升级 O'Reilly WebSite 至 2.1 以上版本。该产品已停止维护，建议迁移至 IIS 或 Apache 等现代 Web 服务器，并在应用层严格过滤输入中的 shell 元字符（如 | & ; $ `）。","status":"completed","collected_at":"2026-07-20T00:00:00Z","references":["http://oliver.efri.hr/~crv/security/bugs/NT/buffer.html","http://www.tryc.on.ca/archives/bugtraq/1999_1/0612.html","https://github.com/CVEProject/cvelistV5/blob/24df5d59670dfe04b9c86de11fa86df63c0d28f7/cves/1999/1xxx/CVE-1999-1180.json","https://github.com/LiuCan01/cve-list-pro/blob/78b55511cee3604c22d518e32822f0435d0cacc0/cve-list/CVE-1999/CVE-1999-1180","https://github.com/yarencheng/cve-devops-playground/blob/470a5f1c0d1bd36cd0a6327cda49cf96a1474588/content/CVE-1999-1180.md","https://github.com/Patrowl/PatrowlHearsData/blob/228df6a85079f5c6b1ecdfb3d41be685458438ef/CVE/data/1999/CVE-1999-1180.json","https://github.com/rhuitl/uClinux/blob/0486e80a025dccbe4a2213715a2ab8a5063ea86b/user/nessus/nessus-plugins/scripts/args_bat.nasl","https://github.com/github/advisory-database/blob/4544d3857250fe21711ce8febf38e8822729678f/advisories/unreviewed/2022/04/GHSA-q697-gcxw-q87j/GHSA-q697-gcxw-q87j.json","https://github.com/SpeeDr00t/speedr00t.github.com/blob/0380f0c2190556fabe90257cb6c0034a42f68951/securityfocus/0x89000/88632/info.html","https://github.com/nomi-sec/NVD-Database/blob/23dc120c34402aaa65883c51c1d03b3cb02c20cb/1999/CVE-1999-1180.json","https://github.com/leego972/titanai/blob/afa5b2310463aae5781d3fd9408071bf38e79806/data/raw/corpus_D_cyber/nvd_cve_000527.txt","https://github.com/blackhook/nessus-plugins/blob/64177d96abbb07c58cf7e131046b067ebc61fcb5/A/args_bat.nasl"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":["https://raw.githubusercontent.com/adysec/AVE/main/pocs/1999/POC-AVE-1999-1003.toml"],"repo_exp_urls":["https://raw.githubusercontent.com/adysec/AVE/main/exploits/1999/EXP-AVE-1999-1003.toml"],"has_poc":true,"has_exp":true,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/1999/AVE-1999-1003.toml"},{"ave_id":"AVE-1999-0026","file_name":"1999/AVE-1999-0026.toml","cve_id":"CVE-1999-0374","title":"Debian GNU/Linux cfengine 符号链接攻击漏洞","description":"Debian GNU/Linux 发行版中的 cfengine 软件包存在符号链接攻击漏洞。cfengine 是一款基于主机的配置管理工具，通常以 root 权限运行。由于其在处理临时文件时未充分验证符号链接的真实性，拥有本地账户权限的攻击者可通过在可写目录中创建恶意符号链接（指向 /etc/shadow 等系统关键文件），诱导 cfengine 以 root 权限错误地读取或覆写目标文件，导致敏感信息泄露或系统完整性破坏。该漏洞利用条件为攻击者需具备本地 shell 访问权限。","severity":"LOW","score":2.1,"aliases":["CVE-1999-0374"],"sources":["avd"],"published":"1999-02-16T05:00:00Z","updated":"2026-06-16T21:48:15Z","remediation":"建议升级 cfengine 至 1.5.4 及以上版本，该版本修复了临时文件创建中的符号链接跟随漏洞。使用 cfengine 管理文件时避免将临时文件写入公共可写目录（如 /tmp），或使用专属临时目录并设置 umask 077 限制访问权限。在 Debian 系统中及时应用 apt-get update && apt-get upgrade 保持软件包更新。","status":"completed","collected_at":"2026-07-13T00:00:00Z","references":["https://exchange.xforce.ibmcloud.com/vulnerabilities/CVE-1999-0374"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":[],"repo_exp_urls":[],"has_poc":false,"has_exp":false,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/1999/AVE-1999-0026.toml"},{"ave_id":"AVE-1999-0027","file_name":"1999/AVE-1999-0027.toml","cve_id":"CVE-1999-0375","title":"Network Flight Recorder webd 缓冲区溢出代码执行漏洞","description":"Network Flight Recorder (NFR) 2.0.2-Research 版本的 webd 组件存在缓冲区溢出漏洞。远程攻击者无需身份验证即可通过网络向 webd 服务发送特制请求，触发缓冲区溢出，从而在目标系统上以服务进程权限执行任意命令。该漏洞攻击复杂度低，可导致机密性、完整性和可用性完全受损。","severity":"HIGH","score":7.5,"aliases":["CVE-1999-0375"],"sources":["cve"],"published":"1999-02-16T00:00:00Z","updated":"2026-06-16T00:00:00Z","remediation":"NFR 2.0.2-Research 已停止维护，建议升级到厂商后续安全版本或迁移至替代网络监控方案。如无法升级，应在网络边界防火墙限制对 webd 服务端口的访问，仅允许可信 IP 连接。","status":"completed","collected_at":"2026-07-16T00:00:00Z","references":["https://nvd.nist.gov/vuln/detail/CVE-1999-0375","https://exchange.xforce.ibmcloud.com/vulnerabilities/CVE-1999-0375"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":[],"repo_exp_urls":[],"has_poc":false,"has_exp":false,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/1999/AVE-1999-0027.toml"},{"ave_id":"AVE-1999-1027","file_name":"1999/AVE-1999-1027.toml","cve_id":"CVE-1999-1260","title":"Hughes Technologies mSQL 服务器信息泄露漏洞","description":"mSQL (Mini SQL) 2.0.6 存在信息泄露漏洞，远程攻击者可通过向目标服务发送特制的 ServerStats 查询，获取服务器敏感信息，包括当前登录用户列表、数据库名称及服务器版本号等。该漏洞攻击复杂度低，无需身份认证即可远程利用，可被攻击者用于信息搜集以辅助后续攻击，CVSS 评分 7.5，危害等级高。建议升级至最新版本或通过防火墙限制对 mSQL 服务的网络访问。","severity":"HIGH","score":7.5,"aliases":["CVE-1999-1260"],"sources":["epss"],"published":"1999-02-15T05:00:00Z","updated":"2026-06-16T21:50:03Z","remediation":"升级至 mSQL 2.0.7 或更高版本（该版本已禁用远程统计查询 ServerStats）。如无法升级，在 msql.conf 中将远程访问选项 remote_access 设为 false（2.0.4.1 起默认关闭），并在防火墙层面限制对 mSQL 默认端口 1114 的访问，仅允许可信主机连接。","status":"completed","collected_at":"2026-07-20T00:00:00Z","references":["http://marc.info/?l=bugtraq&m=91910115718150&w=2","https://exchange.xforce.ibmcloud.com/vulnerabilities/1777","https://github.com/CVEProject/cvelistV5/blob/50269681ee58c9b5bf7169b73546eef94697389c/cves/1999/1xxx/CVE-1999-1260.json","https://github.com/LiuCan01/cve-list-pro/blob/78b55511cee3604c22d518e32822f0435d0cacc0/cve-list/CVE-1999/CVE-1999-1260","https://github.com/yarencheng/cve-devops-playground/blob/470a5f1c0d1bd36cd0a6327cda49cf96a1474588/content/CVE-1999-1260.md","https://github.com/Patrowl/PatrowlHearsData/blob/4631642e37ce9ee8b9057e387df4aee61487fb70/CVE/data/1999/CVE-1999-1260.json","https://github.com/github/advisory-database/blob/f37077e857e7a28bab83d284c23299407fb1af7e/advisories/unreviewed/2022/04/GHSA-7fw7-4m2q-jp4c/GHSA-7fw7-4m2q-jp4c.json","https://github.com/SpeeDr00t/speedr00t.github.com/blob/0380f0c2190556fabe90257cb6c0034a42f68951/securityfocus/0x88000/87764/info.html","https://github.com/olbat/nvdcve/blob/39f1db26eec9899ab2f8110ab3b45424c6fe9ec2/nvdcve/CVE-1999-1260.json","https://github.com/KTZgraph/sarenka/blob/f1fb931ab722d6c096d581ed6e3c5966d799fbaa/sarenka/feeds/cve_details/cve_all_details_153300_153400.json","https://github.com/security-commits/security-patches-dataset/blob/e93fcdcc8c9b91785f962a06d66b7ee623780245/data/cve-details/year/1999.csv","https://github.com/nomi-sec/CVE-Easy-List/blob/f41da9b9307a4d911b4942758c5aa9f31086a333/1999.tsv"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":[],"repo_exp_urls":[],"has_poc":false,"has_exp":false,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/1999/AVE-1999-1027.toml"},{"ave_id":"AVE-1999-0311","file_name":"1999/AVE-1999-0311.toml","cve_id":"CVE-1999-0714","title":"Compaq Tru64 UNIX edauth 命令漏洞","description":"Compaq Tru64 UNIX 操作系统的 edauth 命令存在权限管理缺陷，本地攻击者无需额外认证即可利用该命令读取系统上的敏感文件，导致机密信息泄露。该漏洞影响 Compaq Tru64 UNIX 多个版本，攻击者需拥有本地系统访问权限方可利用，CVSS 评分 2.1，危害等级低。","severity":"LOW","score":2.1,"aliases":["CVE-1999-0714"],"sources":["cve","avd"],"published":"1999-02-15T00:00:00Z","updated":"2026-06-16T00:00:00Z","remediation":"Compaq（现 HP）已针对 Tru64 UNIX 的 edauth 命令漏洞发布安全补丁，建议用户联系厂商获取对应操作系统版本的补丁程序，或升级到已修复该漏洞的 Tru64 UNIX 版本。由于该产品已停止主流支持，建议迁移至受支持的替代操作系统。","status":"completed","collected_at":"2026-07-16T00:00:00Z","references":["https://nvd.nist.gov/vuln/detail/CVE-1999-0714","https://exchange.xforce.ibmcloud.com/vulnerabilities/CVE-1999-0714"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":[],"repo_exp_urls":[],"has_poc":false,"has_exp":false,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/1999/AVE-1999-0311.toml"},{"ave_id":"AVE-1999-0043","file_name":"1999/AVE-1999-0043.toml","cve_id":"CVE-1999-0404","title":"SmartMax MailMax 1.0 SMTP 缓冲区溢出漏洞","description":"SmartMax MailMax 1.0 的 SMTP 服务组件存在缓冲区溢出漏洞，远程攻击者可通过向 25 端口发送特制的超长 SMTP 命令触发该漏洞，导致目标系统拒绝服务或执行任意代码。该漏洞影响 Windows 平台下的 MailMax 1.0 版本，无需身份认证即可利用，危害等级高。厂商未提供官方补丁，建议停止使用该软件或通过防火墙限制 SMTP 端口的访问。","severity":"HIGH","score":7.5,"aliases":["CVE-1999-0404"],"sources":["exploitdb"],"published":"1999-02-14T05:00:00Z","updated":"2026-06-16T21:48:19Z","remediation":"升级 SmartMax MailMax 至 2.0 或更高版本。该产品已停止维护，建议迁移至受支持的邮件服务器软件，并在防火墙中限制 SMTP 端口（25/TCP）仅允许可信来源访问作为临时缓解措施。","status":"completed","collected_at":"2026-07-16T00:00:00Z","references":["https://exchange.xforce.ibmcloud.com/vulnerabilities/CVE-1999-0404","https://www.exploit-db.com/exploits/20600","https://github.com/CVEProject/cvelistV5/blob/f4ffb7bcd93209aa53a757a7ebdf17fe2a18eb33/cves/1999/0xxx/CVE-1999-0404.json","https://github.com/LiuCan01/cve-list-pro/blob/78b55511cee3604c22d518e32822f0435d0cacc0/cve-list/CVE-1999/CVE-1999-0404","https://github.com/yarencheng/cve-devops-playground/blob/45be3b4afd9c4397ee32a5cbf6819a590220b0c1/content/CVE-1999-0404.md","https://github.com/Patrowl/PatrowlHearsData/blob/a75ebb477762f54f32c38d85ec939339ec2712e5/CVE/data/1999/CVE-1999-0404.json","https://github.com/eldondev/Snort/blob/34bdcf6a7a638b55c7c04f77ef1efa526ad08e33/doc/signatures/310.txt","https://github.com/rhuitl/uClinux/blob/0486e80a025dccbe4a2213715a2ab8a5063ea86b/user/nessus/nessus-plugins/scripts/mailmax_imap_overflows.nasl","https://github.com/olbat/nvdcve/blob/763b4dfa75aa1890a155aad1b583fdcab8111c49/nvdcve/CVE-1999-0404.json","https://github.com/jdkoftinoff/mb-linux-msli/blob/8adb103e34af9ff1d8d122e9ee2a1808836f0a14/uClinux-dist/user/snort/drop-rules/exploit.rules","https://github.com/magicsword-io/Magic-SigExplorer/blob/2c28b91b003429a144a687199ee99ebd26f1a343/Magic-SigExplorer/docs/cve_report.md","https://github.com/intSpLoiT/intframework/blob/eabaa799d0260aa52b735fa9769266d1ce4b64ef/modules/cve_list.txt"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":[],"repo_exp_urls":[],"has_poc":false,"has_exp":false,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/1999/AVE-1999-0043.toml"},{"ave_id":"AVE-1999-1393","file_name":"1999/AVE-1999-1393.toml","cve_id":"CVE-1999-1203","title":"Ascend Multilink PPP for ISDN 拒绝服务漏洞","description":"Ascend Multilink PPP for ISDN 拨号用户服务（版本 4.6 及更早）存在输入验证缺陷，远程攻击者可通过向目标系统发送伪造的端点标识符（Endpoint Identifier）数据包，触发服务处理异常，导致目标设备拒绝服务。该漏洞无需认证即可触发，攻击门槛较低，影响 Ascend 系列路由器和接入设备中启用 Multilink PPP 功能的 ISDN 拨号用户连接。","severity":"MEDIUM","score":5.0,"aliases":["CVE-1999-1203"],"sources":["epss"],"published":"1999-02-12T05:00:00Z","updated":"2026-06-16T21:49:56Z","remediation":"升级 Ascend Multilink PPP 至 4.6 或更高版本，该版本修复了伪造端点标识符导致拒绝服务的问题。如产品已停止支持且无法升级，建议在网络边界部署入侵检测系统（IDS）过滤异常 PPP 端点标识符报文，并限制 ISDN 拨号用户的源地址验证。","status":"completed","collected_at":"2026-07-20T00:00:00Z","references":["http://marc.info/?l=bugtraq&m=91868964203769&w=2","http://marc.info/?l=bugtraq&m=91888117502765&w=2","http://www.iss.net/security_center/static/7498.php","https://github.com/CVEProject/cvelistV5/blob/4e8d44fc9434dcaf08511a3267e0bf049a6756de/cves/1999/1xxx/CVE-1999-1203.json","https://github.com/Patrowl/PatrowlHearsData/blob/f9199c6ea2112c9d2536a126688b640a45f0982a/CVE/data/1999/CVE-1999-1203.json","https://github.com/LiuCan01/cve-list-pro/blob/78b55511cee3604c22d518e32822f0435d0cacc0/cve-list/CVE-1999/CVE-1999-1203","https://github.com/nomi-sec/NVD-Database/blob/23dc120c34402aaa65883c51c1d03b3cb02c20cb/1999/CVE-1999-1203.json","https://github.com/olbat/nvdcve/blob/39f1db26eec9899ab2f8110ab3b45424c6fe9ec2/nvdcve/CVE-1999-1203.json","https://github.com/fkie-cad/nvd-json-data-feeds/blob/a913ac9f87691de86825ecccd6699d1970d6fddc/CVE-1999/CVE-1999-12xx/CVE-1999-1203.json","https://github.com/opencve/opencve-kb/blob/3a007c8fe94b232452ea95ec8ec071fdd18c286f/1999/CVE-1999-1203.json","https://github.com/CyberSecAI/cve_info/blob/03b7e36424574a3a9ba5fd13480a326b666a1046/1999/1xxx/CVE-1999-1203.json","https://github.com/CVEProject/cvelist-dev/blob/5b8fbb570438e8094550205589cc6f1d122acc94/1999/1xxx/CVE-1999-1203.json","https://github.com/aquasecurity/vuln-list-nvd/blob/b596b847a09ba1b9204d0c3431cee40f55c25b2e/api/1999/CVE-1999-1203.json"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":[],"repo_exp_urls":[],"has_poc":false,"has_exp":false,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/1999/AVE-1999-1393.toml"},{"ave_id":"AVE-1999-0612","file_name":"1999/AVE-1999-0612.toml","cve_id":"CVE-1999-0372","title":"Microsoft BackOffice Server 4.0 安装程序敏感信息泄露漏洞","description":"Microsoft BackOffice Server 4.0 安装程序在安装 SQL Server、Exchange Server 或 Microsoft Transaction Server 时，会要求用户输入相关服务账户名和密码，并将这些凭据以明文形式写入 <systemdrive>\\Program Files\\Microsoft Backoffice\\Reboot.ini 文件中。安装完成后（无论成功与否），该文件未被自动删除。本地攻击者若能登录服务器，即可读取该文件获取明文账户密码，进而利用获取的凭据提升权限或访问受保护资源。","severity":"LOW","score":2.1,"aliases":["CVE-1999-0372"],"sources":["cve","exploitdb"],"published":"1999-02-12T00:00:00Z","updated":"2026-06-16T00:00:00Z","remediation":"安装完成后手动删除 <systemdrive>\\Program Files\\Microsoft Backoffice\\Reboot.ini 文件，该文件仅由安装程序创建，删除后不会自动重建。建议在每次 BackOffice Server 4.0 安装完成后（无论成功与否）立即删除此文件，防止本地攻击者读取明文账户密码。","status":"completed","collected_at":"2026-07-16T00:00:00Z","references":["http://support.microsoft.com/default.aspx?scid=kb%3B%5BLN%5D%3BQ217004","https://docs.microsoft.com/en-us/security-updates/securitybulletins/1999/ms99-005"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":[],"repo_exp_urls":[],"has_poc":false,"has_exp":false,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/1999/AVE-1999-0612.toml"},{"ave_id":"AVE-1999-1259","file_name":"1999/AVE-1999-1259.toml","cve_id":"CVE-1999-1375","title":"Microsoft IIS 3.0/4.0 任意文件读取漏洞","description":"Microsoft IIS 3.0 和 4.0 版本的 showfile.asp 活动服务器页面（ASP）中集成的 FileSystemObject (FSO) 组件存在任意文件读取漏洞。远程攻击者无需身份认证即可通过向服务器发送特制的 HTTP 请求，在 file 参数中指定目标文件路径，从而读取服务器上的任意文件，包括系统配置文件、源代码等敏感信息。该漏洞影响 IIS 3.0 及 4.0 版本，危害中等。","severity":"MEDIUM","score":5.0,"aliases":["CVE-1999-1375"],"sources":["epss"],"published":"1999-02-11T05:00:00Z","updated":"2026-06-16T21:50:18Z","remediation":"升级到 IIS 5.0 或更高版本，或删除服务器上的 showfile.asp 文件。如无法升级，在 IIS 管理器中禁用 ASP 组件中的 FileSystemObject (FSO)，并对 file 参数实施严格的路径白名单校验，禁止包含 \"../\" 等目录遍历字符。","status":"completed","collected_at":"2026-07-20T00:00:00Z","references":["http://marc.info/?l=ntbugtraq&m=91877455626320&w=2","http://www.securityfocus.com/bid/230","https://www.exploit-db.com/exploits/19194","https://github.com/CVEProject/cvelistV5/blob/36911ad057245f7d02822794db0f459d9b4c9b8f/cves/1999/1xxx/CVE-1999-1375.json","https://github.com/LiuCan01/cve-list-pro/blob/78b55511cee3604c22d518e32822f0435d0cacc0/cve-list/CVE-1999/CVE-1999-1375","https://github.com/yarencheng/cve-devops-playground/blob/470a5f1c0d1bd36cd0a6327cda49cf96a1474588/content/CVE-1999-1375.md","https://github.com/Patrowl/PatrowlHearsData/blob/3012e5f1cf9bcfe839897275a956236aed334269/CVE/data/1999/CVE-1999-1375.json","https://github.com/github/advisory-database/blob/d56576b8850027b4a8571fd52a8c5fe418f01987/advisories/unreviewed/2022/04/GHSA-5j2c-m66w-j2qp/GHSA-5j2c-m66w-j2qp.json","https://github.com/marcellodesales/aibbp-reverse-engineer/blob/960f610d597aae9fec1cc5f03c68679be00c222d/reverse_engineer/invicti/vulnerabilities/db/vulnerabilities/vdb/1999/1xxx/cve-1999-1375.yaml","https://github.com/nomi-sec/NVD-Database/blob/23dc120c34402aaa65883c51c1d03b3cb02c20cb/1999/CVE-1999-1375.json","https://github.com/oasis-open/cti-stix-common-objects/blob/55ba7598cbd5a52577b6887871505d931d85cb61/objects/vulnerability/vulnerability--1e91c836-f256-42cd-97cc-6252a8c196cc.json","https://github.com/security-commits/security-patches-dataset/blob/e93fcdcc8c9b91785f962a06d66b7ee623780245/data/cve-details/year/1999.csv","https://github.com/SpeeDr00t/speedr00t.github.com/blob/0380f0c2190556fabe90257cb6c0034a42f68951/securityfocus/0x1000/230/info.html"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":[],"repo_exp_urls":[],"has_poc":false,"has_exp":false,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/1999/AVE-1999-1259.toml"},{"ave_id":"AVE-1999-0611","file_name":"1999/AVE-1999-0611.toml","cve_id":"CVE-1999-0371","title":"Lynx lynx 本地符号链接敏感文件覆盖漏洞","description":"Lynx 文本浏览器在处理临时文件时存在不安全的符号链接跟踪漏洞。本地攻击者可通过在 /tmp 目录下预创建指向目标敏感文件的符号链接，诱导 Lynx 将临时数据写入该链接指向的文件，从而覆盖系统关键文件，导致数据破坏或权限提升。利用条件为攻击者拥有本地账户权限且 Lynx 以当前用户权限运行。该漏洞影响早期版本 Lynx，CVSS 评分 1.2，危害等级低。","severity":"LOW","score":1.2,"aliases":["CVE-1999-0371"],"sources":["avd"],"published":"1999-02-11T05:00:00Z","updated":"2026-06-16T21:48:15Z","remediation":"升级 Lynx 至 2.7.1 或更高版本，该版本已改用 mkstemp() 安全创建临时文件，避免预测 /tmp 路径导致的竞争条件。如无法升级，确保 /tmp 目录设置粘滞位（chmod 1777 /tmp），并通过设置环境变量 TMPDIR 指向用户私有临时目录来缓解风险。","status":"completed","collected_at":"2026-07-13T00:00:00Z","references":["https://exchange.xforce.ibmcloud.com/vulnerabilities/CVE-1999-0371"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":[],"repo_exp_urls":[],"has_poc":false,"has_exp":false,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/1999/AVE-1999-0611.toml"},{"ave_id":"AVE-1999-0610","file_name":"1999/AVE-1999-0610.toml","cve_id":"CVE-1999-0370","title":"Sun Solaris 与 SunOS man 及 catman 任意文件覆盖漏洞","description":"Sun Solaris 和 SunOS 系统中的 man 与 catman 命令存在文件覆盖漏洞，本地攻击者可通过利用这些命令在处理临时文件时的缺陷，将任意文件写入目标系统上的指定路径，实现文件覆盖或权限提升。该漏洞影响 Sun Solaris 及 SunOS 多个版本，CVSS 评分 4.6，攻击者需拥有本地系统访问权限。厂商已发布相应安全补丁修复此问题。","severity":"MEDIUM","score":4.6,"aliases":["CVE-1999-0370"],"sources":["avd"],"published":"1999-02-10T05:00:00Z","updated":"2026-06-16T21:48:15Z","remediation":"建议升级到 Sun 官方补丁对应的 Solaris 版本（如 Solaris 2.6 及更新版本已修复此问题），或从 sunsolve.sun.com 获取 man/catman 相关安全补丁。临时缓解措施：以 root 权限执行 `chmod 755 /usr/bin/man /usr/bin/catman` 移除 setuid 位，防止普通用户利用提权覆盖任意文件。同时通过 `tty` 访问控制限制本地用户登录高危账户。","status":"completed","collected_at":"2026-07-13T00:00:00Z","references":["http://www.securityfocus.com/bid/165"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":[],"repo_exp_urls":[],"has_poc":false,"has_exp":false,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/1999/AVE-1999-0610.toml"},{"ave_id":"AVE-1999-0585","file_name":"1999/AVE-1999-0585.toml","cve_id":"CVE-1999-0353","title":"{\"_meta\":{},\"stopReason\":\"end_turn\",\"usage\":{\"cachedReadTokens\":1664,\"inputTokens\":9107,\"outputTokens\":28,\"totalTokens\":10799}}","description":"HP-UX 系统中的 rpc.pcnfsd 服务存在权限配置错误漏洞，远程未经身份认证的攻击者可通过修改主打印机假脱机目录的权限，获取远程 root 权限访问。该漏洞影响 HP-UX 多个版本，CVSS 评分 9.3，危害等级严重。攻击者无需认证即可远程利用，通过篡改打印机假脱机目录权限实现权限提升至 root 权限，严重威胁系统安全。建议升级至修复版本或禁用 rpc.pcnfsd 服务。","severity":"CRITICAL","score":9.3,"aliases":["CVE-1999-0353"],"sources":["epss"],"published":"1999-02-10T05:00:00Z","updated":"2026-06-16T21:48:12Z","remediation":"升级 HP-UX 到最新的Patched-Up 11.11 或更高版本，并应用最新的安全补丁包。具体步骤：1. 执行\"swinstall -s /somepath/hpus11v1_patch\"安装补丁；2. 检查并删除不必要的rpc.pcnfsd服务，使其处于禁用状态；3. 在防火墙上配置规则，仅允许本地网络段访问rpc.pcnfsd端口；4. 验证/spool目录的权限，确保持有者为root且权限为755，禁止其他用户修改。","status":"completed","collected_at":"2026-07-16T00:00:00Z","references":["http://www.ciac.org/ciac/bulletins/j-026.shtml","http://www1.itrc.hp.com/service/cki/docDisplay.do?docId=HPSBUX9902-091","https://github.com/CVEProject/cvelistV5/blob/ead50dc12e50bdd7f50b53d9d01c9f9946862c44/cves/1999/0xxx/CVE-1999-0353.json","https://github.com/LiuCan01/cve-list-pro/blob/78b55511cee3604c22d518e32822f0435d0cacc0/cve-list/CVE-1999/CVE-1999-0353","https://github.com/yarencheng/cve-devops-playground/blob/45be3b4afd9c4397ee32a5cbf6819a590220b0c1/content/CVE-1999-0353.md","https://github.com/Patrowl/PatrowlHearsData/blob/4ed191c1149de50e461e9a357f4a3a22e603f0d1/CVE/data/1999/CVE-1999-0353.json","https://github.com/github/advisory-database/blob/b7a93df7f7051799495805bc211adea8d202dae7/advisories/unreviewed/2022/04/GHSA-2cv7-m7r7-5xxj/GHSA-2cv7-m7r7-5xxj.json","https://github.com/blackhook/nessus-plugins/blob/64177d96abbb07c58cf7e131046b067ebc61fcb5/h/hpux_PHCO_14625.nasl","https://github.com/nomi-sec/NVD-Database/blob/23dc120c34402aaa65883c51c1d03b3cb02c20cb/1999/CVE-1999-0353.json","https://github.com/Freem93/grammar_nasl_v2/blob/63834ebb8cd6e97050e155291c7500ad53bb20c6/plugins/hpux_PHKL_15689.nasl","https://github.com/SpeeDr00t/speedr00t.github.com/blob/0380f0c2190556fabe90257cb6c0034a42f68951/securityfocus/0x6000/5377/info.html","https://github.com/security-commits/security-patches-dataset/blob/e93fcdcc8c9b91785f962a06d66b7ee623780245/data/cve-details/year/1999.csv"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":[],"repo_exp_urls":[],"has_poc":false,"has_exp":false,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/1999/AVE-1999-0585.toml"},{"ave_id":"AVE-1999-0604","file_name":"1999/AVE-1999-0604.toml","cve_id":"CVE-1999-0368","title":"WU-FTPD ProFTPD realpath 远程缓冲区溢出漏洞","description":"WU-FTPD 2.4.2、SCO Open Server 5.0.5 及 ProFTPd 1.2 pre1 等 FTP 服务器软件中的 realpath 函数存在缓冲区溢出漏洞。未经身份认证的远程攻击者可通过向目标 FTP 服务发送特制的路径请求触发缓冲区溢出，成功利用此漏洞可在目标系统上以 root 权限执行任意代码，实现完全控制服务器。该漏洞 CVSS 评分 10.0，危害等级严重，且已有公开利用代码。","severity":"CRITICAL","score":10.0,"aliases":["CVE-1999-0368"],"sources":["exploitdb"],"published":"1999-02-09T05:00:00Z","updated":"2026-06-16T21:48:14Z","remediation":"升级 wu-ftpd 至 2.6.2 及以上版本，或升级 ProFTPd 至 1.2.1 及以上版本。SCO Open Server 用户应安装最新补丁包或迁移至受支持的操作系统。如无法升级，在 inetd 配置中禁用 FTP 服务或使用 TCP Wrappers 限制访问来源 IP。","status":"completed","collected_at":"2026-07-16T00:00:00Z","references":["https://exchange.xforce.ibmcloud.com/vulnerabilities/CVE-1999-0368","https://www.exploit-db.com/exploits/19087","https://github.com/CVEProject/cvelistV5/blob/7638326ff3f30ccdb52a67547408dd61f5cdc6cc/cves/1999/0xxx/CVE-1999-0368.json","https://github.com/REMath/implementations/blob/045b59dc77d5bd3e9a14713898ebcfdebacd11e9/tanalysis/tanalysis/verisec%20v1.0/wu-ftpd/CVE-1999-0368/README","https://github.com/LiuCan01/cve-list-pro/blob/78b55511cee3604c22d518e32822f0435d0cacc0/cve-list/CVE-1999/CVE-1999-0368","https://github.com/yarencheng/cve-devops-playground/blob/45be3b4afd9c4397ee32a5cbf6819a590220b0c1/content/CVE-1999-0368.md","https://github.com/Patrowl/PatrowlHearsData/blob/bcb2bc8aed064ca80cf72b28e99ae813ae48a2c2/CVE/data/1999/CVE-1999-0368.json","https://github.com/github/advisory-database/blob/e434c1da6464de3012c6c1eff8c0e19ef9669023/advisories/unreviewed/2022/04/GHSA-pjq9-4mrj-pv4g/GHSA-pjq9-4mrj-pv4g.json","https://github.com/feng-li/tools-for-data-science-course/blob/8e62d47ee8ffbebe9a0e50aee193617f83883118/2019spring/2017312271/result.txt","https://github.com/westtide/open-source-case-studies/blob/57e71842cdb3e034316b0d083f8d19f680501b67/verisec/.frama-c/programs_apps_wu-ftpd_CVE-1999-0368_realpath-linkpath_prefix_ok.eva/nonterm.log","https://github.com/tomhart-msc/verisec/blob/02f3a9660885181705
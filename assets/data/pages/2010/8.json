46e1bef501493d1237acb1611ea8f707/advisories/unreviewed/2022/05/GHSA-2vj9-cx9q-8m6r/GHSA-2vj9-cx9q-8m6r.json","https://github.com/xqcyberscore/nvt/blob/978f6a9acb495d7d669239530ffe6da5d631f4da/2010/gb_realplayer_mult_vuln_win_01_dec10.nasl","https://github.com/blackhook/nessus-plugins/blob/64177d96abbb07c58cf7e131046b067ebc61fcb5/R/realplayer_enterprise_6_0_12_1823.nasl","https://github.com/oasis-open/cti-stix-common-objects/blob/55ba7598cbd5a52577b6887871505d931d85cb61/objects/vulnerability/vulnerability--463eb683-dc4e-4c1c-9310-e623a029b68e.json","https://github.com/opencve/opencve-kb/blob/ace7ea23ab4ecbf97f9d5d9e011d6ca2ce3e334a/2010/CVE-2010-3748.json","https://github.com/sailuh/perceive/blob/85ca622832e25fa91d8d836b8c93a096178bb35d/Notebooks/NVD/data/2010.csv"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":[],"repo_exp_urls":[],"has_poc":false,"has_exp":false,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/2010/AVE-2010-0236.toml"},{"ave_id":"AVE-2010-0235","file_name":"2010/AVE-2010-0235.toml","cve_id":"CVE-2010-3747","title":"RealNetworks RealPlayer CDDA URI 未初始化指针远程代码执行漏洞","description":"RealNetworks RealPlayer 的 CDDA URI ActiveX 控件在处理特制 URI 时存在未初始化指针漏洞。当用户通过浏览器访问恶意构造的网页时，攻击者可利用该控件解析 CDDA URI 过程中未正确初始化对象组件的问题，触发未初始化指针解引用，导致应用程序崩溃或执行任意代码。该漏洞影响 RealPlayer 11.0 至 11.1、RealPlayer SP 1.0 至 1.1.4 及 RealPlayer Enterprise 2.1.2 版本，CVSS 评分 9.3，危害严重。攻击者可通过社会工程手段诱导用户打开恶意页面触发漏洞，Metasploit 框架已集成该漏洞的利用模块。","severity":"CRITICAL","score":9.3,"aliases":["CVE-2010-3747"],"sources":["tenable"],"published":"2010-10-19T00:00:01Z","updated":"2026-06-16T23:23:26Z","remediation":"立即升级 RealPlayer SP 至 12.0.0.879 或更高版本。如无法升级，可在 Internet Explorer 中禁用 RealPlayer ActiveX 控件（CLSID: FDC7A2FC-8C4C-11D0-8D3D-00A0C91E9E4F），将 kill bit 写入注册表 HKEY_LOCAL_MACHINE\\SOFTWARE\\Microsoft\\Internet Explorer\\ActiveX Compatibility 下对应 CLSID 的 Compatibility Flags 设为 0x400。鉴于 RealPlayer 已停止维护，建议彻底卸载该软件并改用其他播放器。","status":"completed","collected_at":"2026-07-27T00:00:00Z","references":["http://securi
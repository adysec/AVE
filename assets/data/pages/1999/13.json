[{"ave_id":"AVE-1999-0801","file_name":"1999/AVE-1999-0801.toml","cve_id":"CVE-1999-0986","title":"Linux Kernel 2.0.3x ping 命令记录路由选项拒绝服务漏洞","description":"Linux 2.0.3x 内核的 ping 命令在处理带有 -R（记录路由）选项的 ICMP 回显请求数据包时，未对 IP 记录路由选项的数据长度进行充分校验。本地攻击者可通过构造超大长度的 ICMP 数据包并指定 -R 选项发送给目标主机，触发内核内存资源耗尽，导致系统拒绝服务。该漏洞影响 2.0.34 至 2.0.38 版本的 Linux 内核，Debian 2.1 和 Red Hat 5.2 等发行版中的相应内核版本也受影响。攻击者需要本地系统访问权限才能利用此漏洞。","severity":"MEDIUM","score":5.0,"aliases":["CVE-1999-0986"],"sources":["cve"],"published":"1999-12-08T00:00:00Z","updated":"1999-12-08T00:00:00Z","remediation":"将 Linux 内核升级至 2.0.39 或更高版本，或应用相应发行版提供的安全补丁。对于已停止维护的旧内核版本（如 2.0.x 系列），建议升级至受支持的 2.2.x 或更高内核系列，新版本内核已对 ICMP 记录路由选项的长度进行严格校验，防止超大 IP 选项数据包导致的资源耗尽。","status":"completed","collected_at":"2026-07-19T06:37:00Z","references":["https://nvd.nist.gov/vuln/detail/CVE-1999-0986","http://www.securityfocus.com/bid/870"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":[],"repo_exp_urls":[],"has_poc":false,"has_exp":false,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/1999/AVE-1999-0801.toml"},{"ave_id":"AVE-1999-0791","file_name":"1999/AVE-1999-0791.toml","cve_id":"CVE-1999-0981","title":"Microsoft Internet Explorer 4.01/5.0/5.01 服务端页面引用重定向漏洞","description":"Internet Explorer 4.01、5.0 及 5.01 版本中存在服务端页面引用重定向漏洞。当 Web 服务器执行服务端重定向时，IE 安全模型会检查新页面的权限，但在特定时机条件下，攻击者可创建对客户端窗口的引用，然后利用服务端重定向到客户端本地文件，绕过安全限制，导致恶意网站运营者能够读取访问者计算机上已知路径的本地文件。","severity":"MEDIUM","score":5.1,"aliases":["CVE-1999-0981"],"sources":["cve"],"published":"1999-12-08T00:00:00Z","updated":"2026-06-16T00:00:00Z","remediation":"安装 Microsoft 安全公告 MS99-050 提供的安全补丁，或升级到 Internet Explorer 5.01 Service Pack 1 及以上版本。该补丁同时修复了此前 ImportExportFavorites 漏洞。","status":"completed","collected_at":"2026-07-19T05:50:52Z","references":["https://docs.microsoft.com/en-us/security-updates/securitybulletins/1999/ms99-050","http://support.microsoft.com/default.aspx?scid=kb%3B%5BLN%5D%3BQ246094"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":["https://raw.githubusercontent.com/adysec/AVE/main/pocs/1999/POC-AVE-1999-0791.toml"],"repo_exp_urls":["https://raw.githubusercontent.com/adysec/AVE/main/exploits/1999/EXP-AVE-1999-0791.toml"],"has_poc":true,"has_exp":true,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/1999/AVE-1999-0791.toml"},{"ave_id":"AVE-1999-1506","file_name":"1999/AVE-1999-1506.toml","cve_id":"CVE-1999-0973","title":"Sun Solaris snoop 远程缓冲区溢出漏洞","description":"Sun Solaris snoop print_domain_name 缓冲区溢出漏洞","severity":"CRITICAL","score":10.0,"aliases":["CVE-1999-0973"],"sources":["epss"],"published":"1999-12-07T05:00:00Z","updated":"2026-06-16T21:49:26Z","remediation":"立即停止对 untrusted 网络使用 snoop -v 模式，或升级至 Sun 官方补丁版本（Solaris 7 或更高版本）。如无法立即升级，可临时将 snoop 设置为仅 root 可执行、禁用 verbose 模式，并在网络边界限制向 untrusted 域发送 DNS 响应，同时部署 IPS 检测超长域名 DNS 数据包。该漏洞年代久远，长期修复方案为迁移至受支持的 Solaris 11 或其它现代操作系统。","status":"completed","collected_at":"2026-07-19T00:00:00Z","references":["http://www.securityfocus.com/bid/858","https://www.exploit-db.com/exploits/19663","https://github.com/CVEProject/cvelistV5/blob/1d6385d398a2a41185d3cc14943c25f73c724ba3/cves/1999/0xxx/CVE-1999-0973.json","https://github.com/LiuCan01/cve-list-pro/blob/78b55511cee3604c22d518e32822f0435d0cacc0/cve-list/CVE-1999/CVE-1999-0973","https://github.com/yarencheng/cve-devops-playground/blob/1fe9b156eeeb72b8f8baa50bbe7bc0d9806e8c64/content/CVE-1999-0973.md","https://github.com/Patrowl/PatrowlHearsData/blob/8b7c7b13d1542fc7ddfb9cf48e51f3de3ab5c4ab/CVE/data/1999/CVE-1999-0973.json","https://github.com/github/advisory-database/blob/95e6ff620d5494b93ba2234edfcf6a45187dc0a8/advisories/unreviewed/2022/04/GHSA-h4p7-357c-5553/GHSA-h4p7-357c-5553.json","https://github.com/feng-li/tools-for-data-science-course/blob/8e62d47ee8ffbebe9a0e50aee193617f83883118/2019spring/2017312271/result.txt","https://github.com/KTZgraph/sarenka/blob/f1fb931ab722d6c096d581ed6e3c5966d799fbaa/sarenka/feeds/cve_details/cve_all_details_153800_153900.json","https://github.com/andreafioraldi/ToolsForCyberChallenge/blob/197d3dfd204cf1b9d1af1451455c8831c3ff9948/generated/files_3.list.dict","https://github.com/nomi-sec/NVD-Database/blob/23dc120c34402aaa65883c51c1d03b3cb02c20cb/1999/CVE-1999-0973.json","https://github.com/oasis-open/cti-stix-common-objects/blob/55ba7598cbd5a52577b6887871505d931d85cb61/objects/vulnerability/vulnerability--b06c19d4-7ca2-47ba-85bb-77b55bf990dc.json"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":["https://raw.githubusercontent.com/adysec/AVE/main/pocs/1999/POC-AVE-1999-1506.toml"],"repo_exp_urls":["https://raw.githubusercontent.com/adysec/AVE/main/exploits/1999/EXP-AVE-1999-1506.toml"],"has_poc":true,"has_exp":true,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/1999/AVE-1999-1506.toml"},{"ave_id":"AVE-1999-0775","file_name":"1999/AVE-1999-0775.toml","cve_id":"CVE-1999-0976","title":"Sendmail newaliases 本地拒绝服务漏洞","description":"Sendmail 8.9.3 及之前版本中，newaliases 程序在重建别名数据库（/etc/aliases.db）时会进行文件锁定操作。本地普通用户可中断正在执行的 newaliases 进程，导致别名数据库处于损坏或不一致状态，使邮件系统无法正常投递邮件，造成本地拒绝服务。攻击条件为攻击者需在目标主机拥有本地 shell 访问权限并能触发 newaliases 重建过程。","severity":"LOW","score":2.1,"aliases":["CVE-1999-0976"],"sources":["avd"],"published":"1999-12-07T05:00:00Z","updated":"2026-06-16T21:49:26Z","remediation":"升级 Sendmail 至 8.10.0 或更高版本，该版本改进了别名数据库重建时的文件锁定机制，防止中断导致数据库损坏。如无法升级，限制本地用户执行 newaliases 命令的权限，仅允许 root 和受信任管理员运行，并确保别名数据库文件（/etc/aliases.db）权限为 640 且属主为 root。","status":"completed","collected_at":"2026-07-18T00:00:00Z","references":["http://www.securityfocus.com/bid/857","https://github.com/CVEProject/cvelistV5/blob/e268305fd8644994d337819e469d1f89bafde833/cves/1999/0xxx/CVE-1999-0976.json","https://github.com/github/advisory-database/blob/d9ad03f9df46533ce9229f9da6bbf66bd77a3f4f/advisories/unreviewed/2022/04/GHSA-prqp-xwhc-64v4/GHSA-prqp-xwhc-64v4.json","https://github.com/nomi-sec/NVD-Database/blob/23dc120c34402aaa65883c51c1d03b3cb02c20cb/1999/CVE-1999-0976.json"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":[],"repo_exp_urls":[],"has_poc":false,"has_exp":false,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/1999/AVE-1999-0775.toml"},{"ave_id":"AVE-1999-1608","file_name":"1999/AVE-1999-1608.toml","cve_id":"CVE-1999-0989","title":"{\"_meta\":{},\"stopReason\":\"end_turn\",\"usage\":{\"inputTokens\":10809,\"outputTokens\":22,\"totalTokens\":10831}}","description":"Microsoft Internet Explorer 5 直接显示过滤器（MSDXM.OCX）中存在缓冲区溢出漏洞，导致未经身份认证的远程攻击者可通过 vnd.ms.radio 协议向目标系统发送精心构造的数据包触发漏洞，实现远程代码执行。该漏洞严重威胁 Internet Explorer 5 所有版本用户，攻击者无需任何权限即可远程控制受影响系统，存在极大安全风险。尽管 Microsoft 于 1999 年初发布了安全更新，但许多用户仍未应用补丁，漏洞仍处于广泛曝光状态，攻击者可利用这一漏洞劫持受害者浏览器，执行恶意代码，窃取敏感信息或进一步攻击内部网络。","severity":"HIGH","score":7.5,"aliases":["CVE-1999-0989"],"sources":["epss"],"published":"1999-12-06T05:00:00Z","updated":"2026-06-16T21:49:28Z","remediation":"` tags. I need to provide a specific remediation plan.<value>建议升级到Internet Explorer 5.01 SP2及以上版本或切换使用Microsoft Edge浏览器，并彻底禁用vnd.ms.radio协议处理，若无法立即升级，可临时将注册表中的vnd.ms.radio项删除以阻止调用。","status":"completed","collected_at":"2026-07-19T00:00:00Z","references":["http://www.securityfocus.com/bid/861","https://www.exploit-db.com/exploits/19665","https://github.com/CVEProject/cvelistV5/blob/ad13a04165adf44a190b93c89d746f49525e5595/cves/1999/0xxx/CVE-1999-0989.json","https://github.com/LiuCan01/cve-list-pro/blob/78b55511cee3604c22d518e32822f0435d0cacc0/cve-list/CVE-1999/CVE-1999-0989","https://github.com/yarencheng/cve-devops-playground/blob/1fe9b156eeeb72b8f8baa50bbe7bc0d9806e8c64/content/CVE-1999-0989.md","https://github.com/Patrowl/PatrowlHearsData/blob/c9ec7f26a52f816468b636e23146049097db5070/CVE/data/1999/CVE-1999-0989.json","https://github.com/github/advisory-database/blob/f43f79d7ee652229af6058b1c98133bb5bbc17fb/advisories/unreviewed/2022/04/GHSA-564h-qm5m-jrhj/GHSA-564h-qm5m-jrhj.json","https://github.com/nomi-sec/NVD-Database/blob/23dc120c34402aaa65883c51c1d03b3cb02c20cb/1999/CVE-1999-0989.json","https://github.com/intSpLoiT/intframework/blob/eabaa799d0260aa52b735fa9769266d1ce4b64ef/modules/cve_list.txt","https://github.com/andreafioraldi/ToolsForCyberChallenge/blob/197d3dfd204cf1b9d1af1451455c8831c3ff9948/generated/files_1.list.dict","https://github.com/oasis-open/cti-stix-common-objects/blob/55ba7598cbd5a52577b6887871505d931d85cb61/objects/vulnerability/vulnerability--fcf84d2a-de04-4cc1-b40f-b039c4e34769.json","https://github.com/security-commits/security-patches-dataset/blob/e93fcdcc8c9b91785f962a06d66b7ee623780245/data/cve-details/year/1999.csv"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":["https://raw.githubusercontent.com/adysec/AVE/main/pocs/1999/POC-AVE-1999-1608.toml"],"repo_exp_urls":["https://raw.githubusercontent.com/adysec/AVE/main/exploits/1999/EXP-AVE-1999-1608.toml"],"has_poc":true,"has_exp":true,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/1999/AVE-1999-1608.toml"},{"ave_id":"AVE-1999-0824","file_name":"1999/AVE-1999-0824.toml","cve_id":"CVE-1999-0991","title":"GoodTech Telnet Server NT 登录名缓冲区溢出拒绝服务漏洞","description":"GoodTech Telnet Server NT 2.2.1 版本存在缓冲区溢出漏洞，远程未授权攻击者可通过 Telnet 服务发送超长的登录用户名触发缓冲区溢出，导致服务进程崩溃造成拒绝服务攻击。该漏洞影响 GoodTech Telnet Server NT 2.2.1 版本，攻击者无需身份认证即可远程发起攻击，CVSS 评分 5.0（中等危害），攻击向量为网络远程攻击，攻击复杂度低，无需用户交互即可导致服务拒绝。","severity":"MEDIUM","score":5.0,"aliases":["CVE-1999-0991"],"sources":["epss"],"published":"1999-12-06T05:00:00Z","updated":"2026-06-16T21:49:28Z","remediation":"建议立即升级到 GoodTech Telnet Server 2.3 或更高版本以修复该缓冲区溢出漏洞；如无法及时升级，可在边界防火墙或路由器上过滤 TCP 23 端口的入站连接，仅允许受信任 IP 访问 Telnet 服务，并配置会话登录名长度限制以缓解远程拒绝服务风险。","status":"completed","collected_at":"2026-07-19T00:00:00Z","references":["http://www.securityfocus.com/bid/862","https://www.exploit-db.com/exploits/19666","https://github.com/CVEProject/cvelistV5/blob/ad13a04165adf44a190b93c89d746f49525e5595/cves/1999/0xxx/CVE-1999-0991.json","https://github.com/LiuCan01/cve-list-pro/blob/78b55511cee3604c22d518e32822f0435d0cacc0/cve-list/CVE-1999/CVE-1999-0991","https://github.com/yarencheng/cve-devops-playground/blob/1fe9b156eeeb72b8f8baa50bbe7bc0d9806e8c64/content/CVE-1999-0991.md","https://github.com/Patrowl/PatrowlHearsData/blob/c9ec7f26a52f816468b636e23146049097db5070/CVE/data/1999/CVE-1999-0991.json","https://github.com/github/advisory-database/blob/f43f79d7ee652229af6058b1c98133bb5bbc17fb/advisories/unreviewed/2022/04/GHSA-f85m-9989-82xh/GHSA-f85m-9989-82xh.json","https://github.com/feng-li/tools-for-data-science-course/blob/8e62d47ee8ffbebe9a0e50aee193617f83883118/2019spring/2017312271/result.txt","https://github.com/olbat/nvdcve/blob/63d4031680b3d3fa77b826660a1e30ffc70ff5cd/nvdcve/CVE-1999-0991.json","https://github.com/KTZgraph/sarenka/blob/f1fb931ab722d6c096d581ed6e3c5966d799fbaa/sarenka/feeds/cve_details/cve_all_details_153800_153900.json","https://github.com/andreafioraldi/ToolsForCyberChallenge/blob/197d3dfd204cf1b9d1af1451455c8831c3ff9948/generated/files_5.list.dict","https://github.com/security-commits/security-patches-dataset/blob/e93fcdcc8c9b91785f962a06d66b7ee623780245/data/cve-details/year/1999.csv"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":[],"repo_exp_urls":[],"has_poc":false,"has_exp":false,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/1999/AVE-1999-0824.toml"},{"ave_id":"AVE-1999-0823","file_name":"1999/AVE-1999-0823.toml","cve_id":"CVE-1999-0990","title":"GNOME GDM 用户信息泄露漏洞","description":"GNOME Display Manager (gdm) 在启用 VerboseAuth 详细认证设置时，登录失败时会返回差异化错误消息，导致攻击者可通过观察错误信息差异枚举系统存在的有效用户账户。攻击者仅需访问登录界面即可发起用户枚举攻击，无需认证即可收集有效用户名列表，为后续暴力破解或社会工程攻击提供便利。该漏洞影响启用 VerboseAuth 选项的 gdm 版本，CVSS 评分 2.1 属低危级别，主要影响信息保密性。建议禁用 VerboseAuth 设置或升级至修复版本的 gdm，并在登录界面统一错误提示信息以防止用户枚举。","severity":"LOW","score":2.1,"aliases":["CVE-1999-0990"],"sources":["avd"],"published":"1999-12-05T05:00:00Z","updated":"2026-06-16T21:49:28Z","remediation":"升级 GNOME Display Manager (gdm) 至已修复该问题的发行版版本（如 Red Hat 6.2 的 gdm-2.0beta2-38 及以上、Debian 2.2 的对应修复包），并通过编辑 /etc/X11/gdm/gdm.conf 将 VerboseAuth 选项设为 false（或删除以禁用详细认证错误信息），重启 gdm 服务使配置生效；若无法立即升级，可临时在 PAM 认证配置中限制登录失败信息返回，避免泄露有效用户名。","status":"completed","collected_at":"2026-07-18T00:00:00Z","references":["https://exchange.xforce.ibmcloud.com/vulnerabilities/CVE-1999-0990","https://github.com/trickest/cve/blob/cf29b986be3ae7c9144123b101d864868676099e/1999/CVE-1999-0990.md","https://github.com/CVEProject/cvelistV5/blob/8981d7e7baa3f6c5d7a90cd823433b0422b8fcd2/cves/1999/0xxx/CVE-1999-0990.json","https://github.com/LiuCan01/cve-list-pro/blob/78b55511cee3604c22d518e32822f0435d0cacc0/cve-list/CVE-1999/CVE-1999-0990","https://github.com/Patrowl/PatrowlHearsData/blob/4cacb08131e7c4736ad136de17873dbcaeddf850/CVE/data/1999/CVE-1999-0990.json","https://github.com/mabitoski/cve_submodules/blob/44ad7e2705b3aef1b2ffaf64bd47596c10a6c2e4/1999/CVE-1999-0990.md","https://github.com/github/advisory-database/blob/958f1672375e115879b3a6bd13e3638812260c7d/advisories/unreviewed/2022/04/GHSA-4v4f-rw7f-997r/GHSA-4v4f-rw7f-997r.json","https://github.com/nomi-sec/NVD-Database/blob/23dc120c34402aaa65883c51c1d03b3cb02c20cb/1999/CVE-1999-0990.json","https://github.com/SpeeDr00t/speedr00t.github.com/blob/0380f0c2190556fabe90257cb6c0034a42f68951/securityfocus/0x89000/88356/info.html","https://github.com/intSpLoiT/intframework/blob/eabaa799d0260aa52b735fa9769266d1ce4b64ef/modules/cve_list.txt","https://github.com/KTZgraph/sarenka/blob/f1fb931ab722d6c096d581ed6e3c5966d799fbaa/sarenka/feeds/cve_details/cve_all_details_153800_153900.json"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":["https://raw.githubusercontent.com/adysec/AVE/main/pocs/1999/POC-AVE-1999-0823.toml"],"repo_exp_urls":[],"has_poc":true,"has_exp":false,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/1999/AVE-1999-0823.toml"},{"ave_id":"AVE-1999-0795","file_name":"1999/AVE-1999-0795.toml","cve_id":"CVE-1999-0982","title":"{\"_meta\":{},\"stopReason\":\"end_turn\",\"usage\":{\"cachedReadTokens\":1664,\"inputTokens\":9138,\"outputTokens\":20,\"totalTokens\":10822}}","description":"Sun 基于 Web 的企业管理（WBEM）安装脚本在安装过程中将管理员密码以纯文本形式写入文件，且该文件权限设置为全局可读，导致任何本地用户均可直接读取其中存储的明文密码。攻击者利用此漏洞获取管理员凭据后，可登录 WBEM 服务并接管系统管理功能，从而完全控制系统配置与监控接口，造成机密性、完整性和可用性的全面损失。该漏洞影响运行 Sun WBEM 的 Solaris 系统，CVSS v2 评分 7.2，危害等级为高。","severity":"HIGH","score":7.2,"aliases":["CVE-1999-0982"],"sources":["avd"],"published":"1999-12-05T05:00:00Z","updated":"2026-06-16T21:49:27Z","remediation":"立即安装 Sun 发布的 Solaris WBEM 补丁（如 Solaris 2.6/7 的相应 WBEM 更新包），将安装脚本中存储密码的世界可读文件权限改为 0600 且仅限 root 访问；编辑安装脚本停止以明文写入密码，改用受限权限的临时文件或提示交互输入；升级到修正后的 Solaris WBEM 版本，并定期审计 /etc 及 WBEM 目录下配置文件权限。","status":"completed","collected_at":"2026-07-18T00:00:00Z","references":["https://exchange.xforce.ibmcloud.com/vulnerabilities/CVE-1999-0982","https://github.com/trickest/cve/blob/cf29b986be3ae7c9144123b101d864868676099e/1999/CVE-1999-0982.md","https://github.com/CVEProject/cvelistV5/blob/e244b55bdff85b2483c0e6a7cecd12f8bee0df6e/cves/1999/0xxx/CVE-1999-0982.json","https://github.com/LiuCan01/cve-list-pro/blob/78b55511cee3604c22d518e32822f0435d0cacc0/cve-list/CVE-1999/CVE-1999-0982","https://github.com/Patrowl/PatrowlHearsData/blob/70f84d5684ed60f7a4d0750993d15c30e4fe3bbf/CVE/data/1999/CVE-1999-0982.json","https://github.com/mabitoski/cve_submodules/blob/44ad7e2705b3aef1b2ffaf64bd47596c10a6c2e4/1999/CVE-1999-0982.md","https://github.com/github/advisory-database/blob/958f1672375e115879b3a6bd13e3638812260c7d/advisories/unreviewed/2022/04/GHSA-67r7-3pf7-5vgm/GHSA-67r7-3pf7-5vgm.json","https://github.com/nomi-sec/NVD-Database/blob/23dc120c34402aaa65883c51c1d03b3cb02c20cb/1999/CVE-1999-0982.json","https://github.com/SpeeDr00t/speedr00t.github.com/blob/0380f0c2190556fabe90257cb6c0034a42f68951/securityfocus/0x89000/88376/info.html","https://github.com/intSpLoiT/intframework/blob/eabaa799d0260aa52b735fa9769266d1ce4b64ef/modules/cve_list.txt","https://github.com/KTZgraph/sarenka/blob/f1fb931ab722d6c096d581ed6e3c5966d799fbaa/sarenka/feeds/cve_details/cve_all_details_153800_153900.json"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":[],"repo_exp_urls":[],"has_poc":false,"has_exp":false,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/1999/AVE-1999-0795.toml"},{"ave_id":"AVE-1999-0819","file_name":"1999/AVE-1999-0819.toml","cve_id":"CVE-1999-0988","title":"SCO UnixWare pkgtrans 符号链接任意文件读取漏洞","description":"SCO UnixWare 的 pkgtrans 工具存在符号链接（symlink）攻击漏洞。pkgtrans 在处理文件时未安全校验目标路径是否为符号链接，本地用户可事先在可写目录中创建指向敏感文件（如 /etc/shadow、/etc/passwd 等）的符号链接，再诱导以高权限运行的 pkgtrans 读取该链接，从而越权读取本无权访问的任意文件内容，造成信息泄露乃至权限提升。攻击条件为攻击者需具备本地登录权限且能够在相关目录创建符号链接。CVSS v2 评分 7.2（向量 AV:L/AC:L/Au:N/C:C/I:C/A:C），属高危级别。","severity":"HIGH","score":7.2,"aliases":["CVE-1999-0988"],"sources":["cve"],"published":"1999-12-04T00:00:00Z","updated":"2026-06-16T00:00:00Z","remediation":"升级到 SCO 官方为受影响 UnixWare 版本发布的、修复 pkgtrans 符号链接问题的补丁后的版本。若暂时无法升级，应收紧 /tmp 等公共可写目录权限（设置粘滞位 sticky bit），限制普通用户对 pkgtrans 操作目录的写权限，使用 nosuid 挂载选项，并避免以 root 权限对不可信输入运行 pkgtrans；同时定期审计可写目录中是否存在可疑符号链接。","status":"completed","collected_at":"2026-07-19T00:00:00Z","references":["https://nvd.nist.gov/vuln/detail/CVE-1999-0988","https://exchange.xforce.ibmcloud.com/vulnerabilities/CVE-1999-0988","https://www.exploit-db.com/exploits/19661","https://github.com/trickest/cve/blob/638563f1ec085a412c2e42f3935801ae34f0dfd9/1999/CVE-1999-0988.md","https://github.com/CVEProject/cvelistV5/blob/ad13a04165adf44a190b93c89d746f49525e5595/cves/1999/0xxx/CVE-1999-0988.json","https://github.com/Patrowl/PatrowlHearsData/blob/72b66ad516faec962399c4214c080517aebc4c11/CVE/data/1999/CVE-1999-0988.json","https://github.com/github/advisory-database/blob/f43f79d7ee652229af6058b1c98133bb5bbc17fb/advisories/unreviewed/2022/04/GHSA-wjmv-3x5x-4vh5/GHSA-wjmv-3x5x-4vh5.json","https://github.com/nomi-sec/NVD-Database/blob/23dc120c34402aaa65883c51c1d03b3cb02c20cb/1999/CVE-1999-0988.json"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":["https://raw.githubusercontent.com/adysec/AVE/main/pocs/1999/POC-AVE-1999-0819.toml"],"repo_exp_urls":[],"has_poc":true,"has_exp":false,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/1999/AVE-1999-0819.toml"},{"ave_id":"AVE-1999-0665","file_name":"1999/AVE-1999-0665.toml","cve_id":"CVE-1999-0865","title":"Stalker Software CommuniGatePro HTTP配置端口缓冲区溢出漏洞","description":"CommuniGatePro 邮件服务器 HTTP 配置端口存在缓冲区溢出漏洞，远程攻击者可通过向该端口发送超长字符串触发缓冲区溢出，导致服务崩溃或任意代码执行。该漏洞影响 CommuniGatePro 早期版本，攻击者无需身份认证即可远程利用，CVSS 评分 5.0，危害等级中等。建议用户升级至最新版本或限制 HTTP 配置端口的访问权限。","severity":"MEDIUM","score":5.0,"aliases":["CVE-1999-0865"],"sources":["epss"],"published":"1999-12-03T05:00:00Z","updated":"2026-06-16T21:49:13Z","remediation":"立即升级至 CommuniGatePro 3.2 或更高版本（官方已在 3.2b5 中修复）。如无法升级，在防火墙层面限制对 HTTP 配置端口（8010）的远程访问，仅允许受信任的管理 IP 连接，以降低被利用风险。","status":"completed","collected_at":"2026-07-18T00:00:00Z","references":["http://marc.info/?l=bugtraq&m=94426440413027&w=2","http://marc.info/?l=ntbugtraq&m=94454565726775&w=2","http://www.securityfocus.com/bid/860","https://github.com/CVEProject/cvelistV5/blob/e2218edc43f34225d168835de417dff40749bef5/cves/1999/0xxx/CVE-1999-0865.json","https://github.com/LiuCan01/cve-list-pro/blob/78b55511cee3604c22d518e32822f0435d0cacc0/cve-list/CVE-1999/CVE-1999-0865","https://github.com/yarencheng/cve-devops-playground/blob/5cf8ba64f356efe9269b21eca2f657231acd746c/content/CVE-1999-0865.md","https://github.com/Patrowl/PatrowlHearsData/blob/2119b082f4927b0a9c902ed9fe95efb3b301cb81/CVE/data/1999/CVE-1999-0865.json","https://github.com/github/advisory-database/blob/d94ad47d0f2016e121b6d251f490e890714f8916/advisories/unreviewed/2022/04/GHSA-m6cp-c6v8-w2rg/GHSA-m6cp-c6v8-w2rg.json","https://github.com/nomi-sec/NVD-Database/blob/23dc120c34402aaa65883c51c1d03b3cb02c20cb/1999/CVE-1999-0865.json","https://github.com/intSpLoiT/intframework/blob/eabaa799d0260aa52b735fa9769266d1ce4b64ef/modules/cve_list.txt","https://github.com/blackhook/nessus-plugins/blob/64177d96abbb07c58cf7e131046b067ebc61fcb5/C/communigatepro_overflow.nasl","https://github.com/security-commits/security-patches-dataset/blob/e93fcdcc8c9b91785f962a06d66b7ee623780245/data/cve-details/year/1999.csv","https://github.com/hungryfoolou/Vulnerability_Mining/blob/3df1d8ed0489ae1228f975ae1f58a690aae53886/craw/cveid_craw/cveid_craw/data/cveid_by_kind/cveid_overflow.txt"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":[],"repo_exp_urls":[],"has_poc":false,"has_exp":false,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/1999/AVE-1999-0665.toml"},{"ave_id":"AVE-1999-0664","file_name":"1999/AVE-1999-0664.toml","cve_id":"CVE-1999-0864","title":"{\"_meta\":{},\"stopReason\":\"end_turn\",\"usage\":{\"cachedReadTokens\":1664,\"inputTokens\":9202,\"outputTokens\":20,\"totalTokens\":10886}}","description":"SCO UnixWare 7.0/7.0.1/7.1/7.1.1 存在符号链接攻击漏洞。当系统中的程序发生崩溃并生成核心转储（core dump）文件时，程序会以固定路径 ./core.pid 写入当前目录，且未对文件是否为符号链接进行校验。本地攻击者可预先在目标目录创建指向敏感文件（如系统配置文件）的同名符号链接，诱使程序在生成核心转储时将数据写入或覆盖被链接的目标文件，从而实现越权修改任意文件。利用该漏洞需攻击者拥有本地账户权限并能触发目标程序崩溃，成功利用可破坏系统文件完整性乃至实现权限提升，CVSS 评分 7.2，危害等级高。","severity":"HIGH","score":7.2,"aliases":["CVE-1999-0864"],"sources":["avd"],"published":"1999-12-03T05:00:00Z","updated":"2026-06-16T21:49:12Z","remediation":"建议立即升级到受支持的 Unix 操作系统（如 Linux 或现代商业 Unix），SCO UnixWare 7.x 系列已停止维护且不再发布安全补丁。如无法迁移，可通过设置全局 umask 限制 core 文件权限为仅所有者可写，并使用 chmod 1777 /core 目录或禁用 core dump（在 /etc/default/login 中添加 ULIMIT=0）作为临时缓解措施。","status":"completed","collected_at":"2026-07-17T00:00:00Z","references":["http://marc.info/?l=bugtraq&m=94530783815434&w=2","http://marc.info/?l=bugtraq&m=94581379905584&w=2","http://marc.info/?l=bugtraq&m=94606167110764&w=2","http://www.securityfocus.com/bid/851","http://www.securityfocus.com/templates/archive.pike?list=1&msg=19991203020720.13115.qmail%40nwcst289.netaddress.usa.net","https://www.exploit-db.com/exploits/19659","https://github.com/CVEProject/cvelistV5/blob/5a67adc3536b9edff12a57c2de9cd5aa5d12653d/cves/1999/0xxx/CVE-1999-0864.json","https://github.com/LiuCan01/cve-list-pro/blob/78b55511cee3604c22d518e32822f0435d0cacc0/cve-list/CVE-1999/CVE-1999-0864","https://github.com/yarencheng/cve-devops-playground/blob/e046e4965f64348bd29a0c62edd023b3c580939e/content/CVE-1999-0864.md","https://github.com/Patrowl/PatrowlHearsData/blob/2853180ecaf9d7461fd6bb98e4528ce223cae51d/CVE/data/1999/CVE-1999-0864.json","https://github.com/github/advisory-database/blob/2e86ccb45bad26f6ff984e676f6d08b925d0e6ee/advisories/unreviewed/2022/04/GHSA-2xg7-gh44-f87f/GHSA-2xg7-gh44-f87f.json","https://github.com/feng-li/tools-for-data-science-course/blob/8e62d47ee8ffbebe9a0e50aee193617f83883118/2019spring/2017312271/result.txt","https://github.com/KTZgraph/sarenka/blob/f1fb931ab722d6c096d581ed6e3c5966d799fbaa/sarenka/feeds/cve_details/cve_all_details_153800_153900.json","https://github.com/nomi-sec/NVD-Database/blob/23dc120c34402aaa65883c51c1d03b3cb02c20cb/1999/CVE-1999-0864.json","https://github.com/leego972/titanai/blob/afa5b2310463aae5781d3fd9408071bf38e79806/data/raw/corpus_D_cyber/nvd_cve_000917.txt","https://github.com/oasis-open/cti-stix-common-objects/blob/55ba7598cbd5a52577b6887871505d931d85cb61/objects/vulnerability/vulnerability--7ff3041c-433f-4523-b001-cae87587461b.json"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":["https://raw.githubusercontent.com/adysec/AVE/main/pocs/1999/POC-AVE-1999-0664.toml"],"repo_exp_urls":["https://raw.githubusercontent.com/adysec/AVE/main/exploits/1999/EXP-AVE-1999-0664.toml"],"has_poc":true,"has_exp":true,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/1999/AVE-1999-0664.toml"},{"ave_id":"AVE-1999-0597","file_name":"1999/AVE-1999-0597.toml","cve_id":"CVE-1999-0825","title":"{\"_meta\":{},\"stopReason\":\"end_turn\",\"usage\":{\"inputTokens\":10812,\"outputTokens\":29,\"totalTokens\":10841}}","description":"SCO UnixWare 7.1 系统中 /var/mail 目录的默认权限设置存在安全缺陷，导致本地用户可读取和修改其他用户的邮件文件。该漏洞源于系统安装时对邮件目录的权限配置不当，未正确限制用户间访问隔离。攻击者只需拥有本地系统账户即可利用此漏洞，无需特殊权限或交互操作，可导致敏感邮件信息泄露或邮件内容被篡改，影响系统用户间的数据保密性和完整性。","severity":"LOW","score":3.6,"aliases":["CVE-1999-0825"],"sources":["exploitdb"],"published":"1999-12-03T05:00:00Z","updated":"2026-06-16T21:49:08Z","remediation":"将 SCO UnixWare 7.1 升级至已修复该问题的补丁版本（如厂商后续发布的 7.1.1 维护补丁），并以 root 身份执行 chmod 1777 /var/mail 设置粘滞位，确保仅文件所有者可删除或修改自己的邮件，防止本地用户越权读写他人邮件。临时缓解可将 /var/mail 目录权限收紧为 1775 并归属 mail 组。","status":"completed","collected_at":"2026-07-17T00:00:00Z","references":["http://www.securityfocus.com/bid/849","https://www.exploit-db.com/exploits/19657","https://github.com/CVEProject/cvelistV5/blob/35cd604fbbf2927fb6acbcd700e81d36cd6dec11/cves/1999/0xxx/CVE-1999-0825.json","https://github.com/LiuCan01/cve-list-pro/blob/78b55511cee3604c22d518e32822f0435d0cacc0/cve-list/CVE-1999/CVE-1999-0825","https://github.com/yarencheng/cve-devops-playground/blob/e046e4965f64348bd29a0c62edd023b3c580939e/content/CVE-1999-0825.md","https://github.com/Patrowl/PatrowlHearsData/blob/3a7f9488e77673498ec37285be0a165ad71720f2/CVE/data/1999/CVE-1999-0825.json","https://github.com/github/advisory-database/blob/2a2be81fd4b47dc35d815a995b6429bd116a3b84/advisories/unreviewed/2022/04/GHSA-8982-64x7-xwpx/GHSA-8982-64x7-xwpx.json","https://github.com/nomi-sec/NVD-Database/blob/23dc120c34402aaa65883c51c1d03b3cb02c20cb/1999/CVE-1999-0825.json","https://github.com/intSpLoiT/intframework/blob/eabaa799d0260aa52b735fa9769266d1ce4b64ef/modules/cve_list.txt","https://github.com/SpeeDr00t/speedr00t.github.com/blob/0380f0c2190556fabe90257cb6c0034a42f68951/securityfocus/0x1000/849/info.html","https://github.com/andreafioraldi/ToolsForCyberChallenge/blob/197d3dfd204cf1b9d1af1451455c8831c3ff9948/generated/files_0.list.dict","https://github.com/security-commits/security-patches-dataset/blob/e93fcdcc8c9b91785f962a06d66b7ee623780245/data/cve-details/year/1999.csv"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":["https://raw.githubusercontent.com/adysec/AVE/main/pocs/1999/POC-AVE-1999-0597.toml"],"repo_exp_urls":["https://raw.githubusercontent.com/adysec/AVE/main/exploits/1999/EXP-AVE-1999-0597.toml"],"has_poc":true,"has_exp":true,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/1999/AVE-1999-0597.toml"},{"ave_id":"AVE-1999-0666","file_name":"1999/AVE-1999-0666.toml","cve_id":"CVE-1999-0866","title":"UnixWare xauto 缓冲区溢出漏洞","description":"UnixWare 系统中的 xauto 程序存在缓冲区溢出漏洞，本地攻击者可利用该漏洞获取 root 完全控制权限。","severity":"HIGH","score":7.2,"aliases":["CVE-1999-0866"],"sources":["NVD","MITRE"],"published":"1999-12-03T00:00:00Z","updated":"2026-06-16T17:49:13Z","remediation":"升级 UnixWare 系统至最新版本，或安装 SCO 安全公告 SB-99.24a 中的补丁程序，并移除 xauto 程序的 SUID 权限位以缓解风险。","status":"completed","collected_at":"2026-07-20T06:34:23Z","references":["http://marc.info/?l=bugtraq&m=94530783815434&w=2","http://marc.info/?l=bugtraq&m=94581379905584&w=2","http://marc.info/?l=bugtraq&m=94606167110764&w=2","http://www.securityfocus.com/bid/848"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":[],"repo_exp_urls":[],"has_poc":false,"has_exp":false,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/1999/AVE-1999-0666.toml"},{"ave_id":"AVE-1999-0662","file_name":"1999/AVE-1999-0662.toml","cve_id":"CVE-1999-0862","title":"{\"_meta\":{},\"stopReason\":\"end_turn\",\"usage\":{\"cachedReadTokens\":1664,\"inputTokens\":9105,\"outputTokens\":18,\"totalTokens\":10787}}","description":"PostgreSQL RPM 软件包在安装时对相关目录设置了不安全的文件权限，导致本地普通用户能够访问到以明文形式存储的密码文件。攻击者只需在已获得目标系统本地访问权限的前提下，读取该明文密码文件即可获取高权限账户凭据，进而实现权限提升。该漏洞影响通过 RPM 方式分发的 PostgreSQL 数据库实例，攻击条件要求攻击者已能在目标主机上以低权限账户执行操作。由于利用方式简单且无需身份认证，该漏洞被归类为本地权限提升类安全问题。PostgreSQL 官方后续版本已修复此目录权限配置问题，建议相关用户及时更新并确保敏感文件权限设置正确。","severity":"LOW","score":2.1,"aliases":["CVE-1999-0862"],"sources":["avd"],"published":"1999-12-02T05:00:00Z","updated":"2026-06-16T21:49:12Z","remediation":"升级到修复了该权限问题的 PostgreSQL RPM 包版本（如 6.5.3 及以上），并使用 rpm -Uvh 重新安装。执行 chmod 700 /var/lib/pgsql 及 chown postgres:postgres 修正数据目录属主与权限，将 pg_hba.conf 及含明文口令的密码文件权限设为 600 且仅允许 postgres 用户读取，避免本地其他用户访问。","status":"completed","collected_at":"2026-07-17T00:00:00Z","references":["https://exchange.xforce.ibmcloud.com/vulnerabilities/CVE-1999-0862","https://github.com/CVEProject/cvelistV5/blob/5a67adc3536b9edff12a57c2de9cd5aa5d12653d/cves/1999/0xxx/CVE-1999-0862.json","https://github.com/LiuCan01/cve-list-pro/blob/78b55511cee3604c22d518e32822f0435d0cacc0/cve-list/CVE-1999/CVE-1999-0862","https://github.com/yarencheng/cve-devops-playground/blob/e046e4965f64348bd29a0c62edd023b3c580939e/content/CVE-1999-0862.md","https://github.com/Patrowl/PatrowlHearsData/blob/9e7373a0dc9acbc4f26666870ca31dd641df9b83/CVE/data/1999/CVE-1999-0862.json","https://github.com/github/advisory-database/blob/2e86ccb45bad26f6ff984e676f6d08b925d0e6ee/advisories/unreviewed/2022/04/GHSA-p674-c6w9-wwgg/GHSA-p674-c6w9-wwgg.json","https://github.com/marcellodesales/aibbp-reverse-engineer/blob/960f610d597aae9fec1cc5f03c68679be00c222d/reverse_engineer/invicti/vulnerabilities/db/vulnerabilities/vdb/1999/0xxx/cve-1999-0862.yaml","https://github.com/feng-li/tools-for-data-science-course/blob/8e62d47ee8ffbebe9a0e50aee193617f83883118/2019spring/2017312271/result.txt","https://github.com/olbat/nvdcve/blob/178b809924783e13787d17bb1b1fd55ad3b8639b/nvdcve/CVE-1999-0862.json","https://github.com/intSpLoiT/intframework/blob/eabaa799d0260aa52b735fa9769266d1ce4b64ef/modules/cve_list.txt","https://github.com/KTZgraph/sarenka/blob/f1fb931ab722d6c096d581ed6e3c5966d799fbaa/sarenka/feeds/cve_details/cve_all_details_153800_153900.json"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":[],"repo_exp_urls":[],"has_poc":false,"has_exp":false,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/1999/AVE-1999-0662.toml"},{"ave_id":"AVE-1999-0657","file_name":"1999/AVE-1999-0657.toml","cve_id":"CVE-1999-0858","title":"Microsoft Internet Explorer 5 Web Proxy Auto-Discovery 代理配置欺骗漏洞","description":"Internet Explorer 5 的 Web Proxy Auto-Discovery（WPAD）功能存在配置验证漏洞。远程攻击者可通过搭建恶意的 WPAD 服务器，向 IE 客户端返回伪造的代理配置信息，从而劫持受害者的浏览器流量。成功利用后，攻击者可拦截、篡改或重定向用户的网络通信，导致敏感信息泄露。该漏洞影响 Internet Explorer 5 及后续版本，攻击者无需任何身份认证即可远程触发，CVSS 评分 5.0，危害等级中等。","severity":"MEDIUM","score":5.0,"aliases":["CVE-1999-0858"],"sources":["epss"],"published":"1999-12-02T05:00:00Z","updated":"2026-06-16T21:49:12Z","remediation":"升级 Internet Explorer 5 至 5.01 版本即可消除此漏洞，该版本已修复 WPAD 算法中逐级向上查询至不可信三级域的问题。如无法升级，可在网络边界防火墙或代理服务器上阻止非受信 WPAD 服务器的 DNS 解析和 HTTP 响应，或禁用客户端的 WPAD 自动检测功能（在 Internet 选项 → 连接 → 局域网设置中取消勾选\"自动检测设置\"）。","status":"completed","collected_at":"2026-07-18T00:00:00Z","references":["http://support.microsoft.com/default.aspx?scid=kb%3B%5BLN%5D%3BQ247333","http://www.securityfocus.com/bid/846","https://docs.microsoft.com/en-us/security-updates/securitybulletins/1999/ms99-054","https://github.com/CVEProject/cvelistV5/blob/e2218edc43f34225d168835de417dff40749bef5/cves/1999/0xxx/CVE-1999-0858.json","https://github.com/LiuCan01/cve-list-pro/blob/78b55511cee3604c22d518e32822f0435d0cacc0/cve-list/CVE-1999/CVE-1999-0858","https://github.com/yarencheng/cve-devops-playground/blob/5cf8ba64f356efe9269b21eca2f657231acd746c/content/CVE-1999-0858.md","https://github.com/Patrowl/PatrowlHearsData/blob/2119b082f4927b0a9c902ed9fe95efb3b301cb81/CVE/data/1999/CVE-1999-0858.json","https://github.com/github/advisory-database/blob/d94ad47d0f2016e121b6d251f490e890714f8916/advisories/unreviewed/2022/04/GHSA-5fx9-46p6-4837/GHSA-5fx9-46p6-4837.json","https://github.com/SuperKieran/WooyunDrops/blob/df3319b3cd839f447ba2d1ab191b6a4b57991d0a/static/drops/1257.BadTunnel%EF%BC%9A%E8%B7%A8%E7%BD%91%E6%AE%B5%E5%8A%AB%E6%8C%81%E5%B9%BF%E6%92%AD%E5%8D%8F%E8%AE%AE.html","https://github.com/feng-li/tools-for-data-science-course/blob/8e62d47ee8ffbebe9a0e50aee193617f83883118/2019spring/2017312271/result.txt","https://github.com/nomi-sec/NVD-Database/blob/23dc120c34402aaa65883c51c1d03b3cb02c20cb/1999/CVE-1999-0858.json","https://github.com/KTZgraph/sarenka/blob/f1fb931ab722d6c096d581ed6e3c5966d799fbaa/sarenka/feeds/cve_details/cve_all_details_153800_153900.json","https://github.com/govbk/WIKI-POC-EXP/blob/7d1194429dab9f9dd8139408e79b70ddb41a468f/Security%20WiKi/011-drops/007-papers/0419-BadTunnel%EF%BC%9A%E8%B7%A8%E7%BD%91%E6%AE%B5%E5%8A%AB%E6%8C%81%E5%B9%BF%E6%92%AD%E5%8D%8F%E8%AE%AE.md"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":["https://raw.githubusercontent.com/adysec/AVE/main/pocs/1999/POC-AVE-1999-0657.toml"],"repo_exp_urls":["https://raw.githubusercontent.com/adysec/AVE/main/exploits/1999/EXP-AVE-1999-0657.toml"],"has_poc":true,"has_exp":true,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/1999/AVE-1999-0657.toml"}]
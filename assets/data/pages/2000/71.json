[{"ave_id":"AVE-2000-0427","file_name":"2000/AVE-2000-0427.toml","cve_id":"CVE-2000-0508","title":"Red Hat Linux rpc.lockd 拒绝服务漏洞","description":"tags.<value>rpc.lockd 是 Linux 系统中用于管理网络文件锁定的 RPC 服务。Red Hat Linux 6.1、6.2 及更早版本（包括 7.0）中的 rpc.lockd 服务存在输入验证缺陷，远程攻击者可通过发送构造异常的畸形请求触发该漏洞，导致服务崩溃或系统拒绝服务。该漏洞影响范围广泛，Debian 2.1/2.2、Mandrake 6.0/6.1/7.0 及 RedHat 6.x 等主流发行版均受波及。攻击者无需任何身份认证即可在远程发起攻击，利用方式简单直接，只需向目标主机的 rpc.lockd 服务端口发送特制畸形请求，即可使服务异常终止，造成系统拒绝服务。CVSS 评分 5.0，危害等级中等。","severity":"MEDIUM","score":5.0,"aliases":["CVE-2000-0508"],"sources":["avd"],"published":"1994-12-19T05:00:00.000","updated":"2026-06-16T21:51:53.130","remediation":"升级至已修复的内核或 nfs-utils 软件包（Red Hat Linux 7.0 及以后版本，或应用对应版本的 RHSA 安全勘误）。如暂无法打补丁，临时禁用 NFS 服务或在防火墙层面限制对 rpc.lockd 端口（TCP/UDP 1024）的外部访问，并重启系统以释放被占用的端口。","status":"completed","collected_at":"2026-07-25T00:00:00Z","references":["http://archives.neohapsis.com/archives/bugtraq/2000-06/0073.html","http://www.securityfocus.com/bid/1372","https://exchange.xforce.ibmcloud.com/vulnerabilities/5050","https://www.exploit-db.com/exploits/20025","https://github.com/CVEProject/cvelistV5/blob/b2be8fd4334c936c67f124199efee5b6ef5d0a06/cves/2000/0xxx/CVE-2000-0508.json","https://github.com/LiuCan01/cve-list-pro/blob/78b55511cee3604c22d518e32822f0435d0cacc0/cve-list/CVE-2000/CVE-2000-0508","https://github.com/HORKimhab/poc-cve-collection/blob/c671d2fb006282d170beae8bd280660988f3dd1d/2000/0xxx/CVE-2000-0508.md","https://github.com/eldondev/Snort/blob/34bdcf6a7a638b55c7c04f77ef1efa526ad08e33/doc/signatures/2079.txt","https://github.com/Patrowl/PatrowlHearsData/blob/4190a549751bffc11b00246a033a062f4109e196/CVE/data/2000/CVE-2000-0508.json","https://github.com/github/advisory-database/blob/30b2e88d407156e5425e05ff25f0ec9537280e2f/advisories/unreviewed/2022/04/GHSA-qxfh-fxwp-jv55/GHSA-qxfh-fxwp-jv55.json","https://github.com/yarencheng/cve-devops-playground/blob/7c450063cd3f12f7aa97a070bb18c68d6bc6767e/content/CVE-2000-0508.md","https://github.com/bailehang/snort_2.2.0/blob/34f8a3a85f15645aea53d6e0d46863c7c57e43ef/doc/signatures/2080.txt","https://github.com/KTZgraph/sarenka/blob/f1fb931ab722d6c096d581ed6e3c5966d799fbaa/sarenka/feeds/cve_details/cve_all_details_154600_154700.json","https://github.com/intSpLoiT/intframework/blob/eabaa799d0260aa52b735fa9769266d1ce4b64ef/modules/cve_list.txt"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":[],"repo_exp_urls":[],"has_poc":false,"has_exp":false,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/2000/AVE-2000-0427.toml"},{"ave_id":"AVE-2000-0862","file_name":"2000/AVE-2000-0862.toml","cve_id":"CVE-2000-0388","title":"FreeBSD libmytinfo 库缓冲区溢出本地代码执行漏洞","description":"FreeBSD 系统中的 libmytinfo 库存在缓冲区溢出漏洞，本地攻击者可通过向 TERMCAP 环境变量传入超长字符串触发该漏洞，导致缓冲区溢出，进而执行任意命令。该漏洞影响 FreeBSD 系统，攻击者需要拥有本地访问权限才能利用，成功利用后可获得与受影响进程相同的权限，对系统机密性、完整性和可用性造成部分影响。","severity":"HIGH","score":7.5,"aliases":["CVE-2000-0388"],"sources":["avd"],"published":"1990-05-09T04:00:00.000","updated":"2026-06-16T21:51:36.727","remediation":"升级 FreeBSD 至 3.4-RELEASE 之后的安全修复版本（含 SA-00:17 补丁），或安装最新 FreeBSD 稳定版（此漏洞仅影响 2000 年之前的旧版本）。如无法升级，可在 shell 启动脚本中过滤 TERMCAP 环境变量长度，限制其不超过 1024 字节，并严格控制本地用户的可信度。同时建议禁用 libmytinfo 库中不必要的终端信息处理功能以降低攻击面。","status":"completed","collected_at":"2026-07-22T00:00:00Z","references":["http://www.securityfocus.com/bid/1185","https://github.com/trickest/cve/blob/ed228d55b7972f63e700a35a54fbcd94064b9ade/2000/CVE-2000-0388.md","https://github.com/CVEProject/cvelistV5/blob/58bdedd85e346c3efc30a2f8424c96c50aa4db2e/cves/2000/0xxx/CVE-2000-0388.json","https://github.com/LiuCan01/cve-list-pro/blob/78b55511cee3604c22d518e32822f0435d0cacc0/cve-list/CVE-2000/CVE-2000-0388","https://github.com/Patrowl/PatrowlHearsData/blob/7b14132e5983d4643412f6d4f89beb409b809e9f/CVE/data/2000/CVE-2000-0388.json","https://github.com/Linux-CN/archive/blob/dcdb64c20eaaa06de89ba01f8fc9ffc5286c45c7/content/posts/2019/05/10806.md","https://github.com/mabitoski/cve_submodules/blob/44ad7e2705b3aef1b2ffaf64bd47596c10a6c2e4/2000/CVE-2000-0388.md","https://github.com/github/advisory-database/blob/5965518125739d48e98f0cf3efbf7359253ff7cc/advisories/unreviewed/2022/05/GHSA-52g5-6rq8-hw99/GHSA-52g5-6rq8-hw99.json","https://github.com/urcuqui/WhiteHat/blob/b47eeb3d1bcea9300dd8d40df4ea8dde0f4972e5/redai/llm/deepseek%20and%20rabbit.ipynb","https://github.com/KTZgraph/sarenka/blob/f1fb931ab722d6c096d581ed6e3c5966d799fbaa/sarenka/feeds/cve_details/cve_all_details_154700_154800.json","https://github.com/nomi-sec/NVD-Database/blob/23dc120c34402aaa65883c51c1d03b3cb02c20cb/2000/CVE-2000-0388.json"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":[],"repo_exp_urls":[],"has_poc":false,"has_exp":false,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/2000/AVE-2000-0862.toml"}]
[{"ave_id":"AVE-2016-0057","file_name":"2016/AVE-2016-0057.toml","cve_id":"CVE-2016-15043","title":"WordPress WP Mobile Detector 插件任意文件上传漏洞","description":"WP Mobile Detector WordPress 插件 3.5 及更早版本的 resize.php 文件缺少文件类型验证，存在任意文件上传漏洞。未经身份认证的远程攻击者可直接向目标站点上传恶意 PHP 文件，从而在服务器上执行任意代码，实现完全控制。该漏洞 CVSS 评分 9.8，危害等级严重，影响所有使用该插件的 WordPress 站点。攻击者无需任何权限，仅需发送特制的 HTTP 请求即可完成利用。","severity":"CRITICAL","score":9.8,"aliases":["CVE-2016-15043"],"sources":["nuclei"],"published":"2025-07-19T10:15:23Z","updated":"2026-06-17T00:41:03Z","remediation":"立即删除或禁用 WP Mobile Detector 插件（版本 ≤ 3.5），该插件已不再维护。如仍需使用移动设备检测功能，可替换为其他受支持的同类插件（如 WP Mobile Detect）。同时检查服务器上 wp-content/uploads/ 目录是否存在异常文件，清理已上传的恶意 webshell。","status":"completed","collected_at":"2026-07-27T00:00:00Z","references":["https://aadityapurani.com/2016/06/03/mobile-detector-poc/","https://blog.sucuri.net/2016/06/wp-mobile-detector-vulnerability-being-exploited-in-the-wild.html","https://wordpress.org/plugins/wp-mobile-detector/changelog/","https://wpscan.com/vulnerability/e4739674-eed4-417e-8c4d-2f5351b057cf","https://www.pluginvulnerabilities.com/2016/05/31/aribitrary-file-upload-vulnerability-in-wp-mobile-detector/","https://www.wordfence.com/threat-intel/vulnerabilities/id/5a5d5dbd-36f0-4886-adf8-045ec9c2e306?source=cve","https://github.com/projectdiscovery/nuclei-templates/blob/main/http/cves/2016/CVE-2016-15043.yaml","https://github.com/trickest/cve/blob/e69d88e0152845fc4d4b49970ca6e503f56b2f93/2016/CVE-2016-15043.md","https://github.com/projectdiscovery/nuclei-templates/blob/4ccef9ea7c907d917b1608d60d73b12823bdfdf5/http/cves/2016/CVE-2016-15043.yaml","https://github.com/CVEProject/cvelistV5/blob/3ac44cfd6537e05d45dfec0ed67b6d47bebeee2b/cves/2016/15xxx/CVE-2016-15043.json","https://github.com/ARPSyndicate/suricata-vedas/blob/fe24794ad36564b5bbc7c69101525011387b8650/2016/CVE-2016-15043.rules","https://github.com/cisagov/vulnrichment/blob/a4b68cf758bc6730b65b4f54ef98a7f612a68b51/2016/15xxx/CVE-2016-15043.json","https://github.com/e-m-b-a/emba/blob/9f33e551f5d4c0bb4df8de596869fddfb4c874cc/config/msf_cve-db.txt","https://github.com/adampielak/nuclei-templates/blob/a2f3ff3fa5db5c7705ebd942909ec114df063700/nuclei-v3/C/CVE-2016-15043-5a332bf5463ef59b5b6b98767190df95.yaml","https://github.com/0xMarcio/cve/blob/75b5e380a041f7d82baaaae75856fe8702a1ff30/2016/CVE-2016-15043.md","https://github.com/lianqingsec/NucleiPocGather/blob/dcce204f62196117b9c95c52d8101ccf7a5d27bc/poc/cve/CVE-2016-15043.yaml","https://github.com/Patrowl/PatrowlHearsData/blob/73cd39be077fdbedc5ca2ea7e2723723d25285cc/CVE/data/2016/CVE-2016-15043.json"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":["https://raw.githubusercontent.com/adysec/AVE/main/pocs/2016/POC-AVE-2016-0057.toml"],"repo_exp_urls":["https://raw.githubusercontent.com/adysec/AVE/main/exploits/2016/EXP-AVE-2016-0057.toml"],"has_poc":true,"has_exp":true,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/2016/AVE-2016-0057.toml"},{"ave_id":"AVE-2016-0056","file_name":"2016/AVE-2016-0056.toml","cve_id":"CVE-2016-15042","title":"WordPress Frontend File Manager 和 N-Media Post Front-end Form 插件任意文件上传漏洞","description":"WordPress 插件 Frontend File Manager（版本 < 4.0）和 N-Media Post Front-end Form（版本 < 1.1）存在任意文件上传漏洞。这两个插件通过 `nm_filemanager_upload_file` 和 `nm_postfront_upload_file` AJAX 操作处理文件上传时，未对上传文件的类型进行有效验证，导致未经身份认证的远程攻击者可直接向目标服务器上传任意文件（如 WebShell），进而实现远程代码执行。该漏洞影响大量使用上述插件的 WordPress 站点，CVSS 评分 9.8，危害等级严重。目前官方已发布修复版本，建议用户立即升级。","severity":"CRITICAL","score":9.8,"aliases":["CVE-2016-15042"],"sources":["nuclei"],"published":"2024-10-16T08:15:02Z","updated":"2026-06-17T00:41:03Z","remediation":"立即将 Frontend File Manager 插件升级至 4.0 或更高版本，将 N-Media Post Front-end Form 插件升级至 1.1 或更高版本。同时，在 WordPress 后台禁用 `nm_filemanager_upload_file` 和 `nm_postfront_upload_file` AJAX 动作的未认证访问，或通过 Web 应用防火墙（WAF）规则拦截上传接口中非图片类型的文件请求作为临时缓解措施。","status":"completed","collected_at":"2026-07-27T00:00:00Z","references":["https://wordpress.org/plugins/nmedia-user-file-uploader/#developers","https://wpscan.com/vulnerability/052f7d9a-aaff-4fb1-92b7-aeb83cc705a7","https://www.acunetix.com/vulnerabilities/web/wordpress-plugin-n-media-post-front-end-form-arbitrary-file-upload-1-0/","https://www.pluginvulnerabilities.com/2016/09/19/arbitrary-file-upload-vulnerability-in-front-end-file-upload-and-manager-plugin/","https://www.pluginvulnerabilities.com/2016/09/19/arbitrary-file-upload-vulnerability-in-n-media-post-front-end-form/","https://www.wordfence.com/threat-intel/vulnerabilities/id/2c1e6298-f243-49a5-b1b7-52bd6a6c8858?source=cve","https://github.com/projectdiscovery/nuclei-templates/blob/main/http/cves/2016/CVE-2016-15042.yaml","https://github.com/trickest/cve/blob/e69d88e0152845fc4d4b49970ca6e503f56b2f93/2016/CVE-2016-15042.md","https://github.com/nomi-sec/PoC-in-GitHub/blob/f015220eb1b2405b0fcce99fab82aef08d37a0ce/2016/CVE-2016-15042.json","https://github.com/projectdiscovery/nuclei-templates/blob/4ccef9ea7c907d917b1608d60d73b12823bdfdf5/http/cves/2016/CVE-2016-15042.yaml","https://github.com/arschlochnop/VulnWatchdog/blob/d076885aa708192e112f41f2fee6154ece5e7b86/data/2016/CVE-2016-15042-ImBIOS_lab-cve-2016-15042.md","https://github.com/ARPSyndicate/suricata-vedas/blob/fe24794ad36564b5bbc7c69101525011387b8650/2016/CVE-2016-15042.rules","https://github.com/topscoder/nuclei-wordfence-cve/blob/bdcc854494aa2f43778044680cffe9dd4de3de0e/nuclei-templates/2016/CVE-2016-15042-wp_post_frontend-2c1e6298-f243-49a5-b1b7-52bd6a6c8858.yaml","https://github.com/adampielak/nuclei-templates/blob/a2f3ff3fa5db5c7705ebd942909ec114df063700/nuclei-v3/C/CVE-2016-15042_7.yaml","https://github.com/anchore/nvd-data-overrides/blob/347fea450bbb600a02904f9eaa5ce5c35747c461/data/2016/CVE-2016-15042.json","https://github.com/youki992/VscanPlus/blob/714a0e276a538a22c1a6215c71458a8b59a920ef/pocs_yml/nucleiFiles/http/cves/2016/CVE-2016-15042.yaml","https://github.com/mabitoski/cve_submodules/blob/44ad7e2705b3aef1b2ffaf64bd47596c10a6c2e4/2016/CVE-2016-15042.md","https://github.com/ImBIOS/lab-cve-2016-15042"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":["https://raw.githubusercontent.com/adysec/AVE/main/pocs/2016/POC-AVE-2016-0056.toml"],"repo_exp_urls":["https://raw.githubusercontent.com/adysec/AVE/main/exploits/2016/EXP-AVE-2016-0056.toml"],"has_poc":true,"has_exp":true,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/2016/AVE-2016-0056.toml"},{"ave_id":"AVE-2016-0054","file_name":"2016/AVE-2016-0054.toml","cve_id":"CVE-2016-15041","title":"WordPress MainWP Dashboard 插件存储型跨站脚本漏洞","description":"WordPress 的 MainWP Dashboard 插件（版本 3.1.2 及之前）存在存储型跨站脚本漏洞，其 mwp_setup_purchase_username 参数因对用户输入缺乏充分的清理和输出转义，导致未经身份认证的攻击者可在页面中注入任意 Web 脚本。当管理员或其他用户访问被注入的页面时，脚本自动执行，可能导致敏感信息泄露、会话劫持或恶意操作。攻击者无需任何权限，仅需向目标发送特制请求即可触发。","severity":"HIGH","score":7.2,"aliases":["CVE-2016-15041"],"sources":["nuclei"],"published":"2024-10-16T07:15:04Z","updated":"2026-06-17T00:41:03Z","remediation":"立即将 MainWP Dashboard 插件升级至 3.1.3 或更高版本。登录 WordPress 后台，进入\"插件\"页面找到 MainWP Dashboard，点击\"更新\"按钮完成升级。如无法立即更新，可暂时禁用该插件或限制对 /wp-admin/admin-post.php?page=mainwp-setup 路径的访问权限作为临时缓解措施。","status":"completed","collected_at":"2026-07-27T00:00:00Z","references":["https://klikki.fi/adv/mainwp.html","https://web.archive.org/web/20191101060009/https%3A//klikki.fi/adv/mainwp.html","https://www.acunetix.com/vulnerabilities/web/wordpress-plugin-mainwp-dashboard-cross-site-scripting-3-1-2/","https://www.wordfence.com/threat-intel/vulnerabilities/id/a9b1445f-3b6b-40fa-9a12-f55d63668dda?source=cve","https://github.com/projectdiscovery/nuclei-templates/blob/main/http/cves/2016/CVE-2016-15041.yaml","https://github.com/trickest/cve/blob/e69d88e0152845fc4d4b49970ca6e503f56b2f93/2016/CVE-2016-15041.md","https://github.com/nomi-sec/PoC-in-GitHub/blob/f015220eb1b2405b0fcce99fab82aef08d37a0ce/2016/CVE-2016-15041.json","https://github.com/projectdiscovery/nuclei-templates/blob/4ccef9ea7c907d917b1608d60d73b12823bdfdf5/http/cves/2016/CVE-2016-15041.yaml","https://github.com/arschlochnop/VulnWatchdog/blob/d076885aa708192e
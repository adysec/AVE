[{"ave_id":"AVE-1999-0082","file_name":"1999/AVE-1999-0082.toml","cve_id":"CVE-1999-0026","title":"SGI IRIX pset 命令缓冲区溢出本地权限提升漏洞","description":"SGI IRIX 6.3 系统中的 pset 命令存在缓冲区溢出漏洞，本地攻击者可通过向该命令提交特制输入触发缓冲区溢出，从而获取 root 权限。该漏洞需要攻击者拥有本地系统访问权限，利用门槛较低，成功利用后可完全控制受影响系统。CVSS 评分 4.6，危害等级中危。","severity":"MEDIUM","score":4.6,"aliases":["CVE-1999-0026"],"sources":["exploitdb"],"published":"1997-07-16T04:00:00Z","updated":"2026-06-16T21:47:22Z","remediation":"立即升级到 IRIX 6.5 及以上版本（该系列已修复此漏洞）；如无法升级，可移除 /usr/sbin/pset 的 setuid 位作为临时缓解措施，执行 chmod u-s /usr/sbin/pset 禁止普通用户提权；严格限制本地用户的交互式 shell 访问权限，仅允许受信用户登录。由于 SGI IRIX 已于 2006 年终止支持且厂商已破产，建议将关键业务系统迁移到仍受支持的操作系统平台。","status":"completed","collected_at":"2026-07-14T00:00:00Z","references":["https://exchange.xforce.ibmcloud.com/vulnerabilities/CVE-1999-0026","https://www.exploit-db.com/exploits/19347","https://github.com/CVEProject/cvelistV5/blob/dc83b9e6d88de194a14e3020b4e71ac42054e609/cves/1999/0xxx/CVE-1999-0026.json","https://github.com/LiuCan01/cve-list-pro/blob/78b55511cee3604c22d518e32822f0435d0cacc0/cve-list/CVE-1999/CVE-1999-0026","https://github.com/aquasecurity/vuln-list-redhat/blob/601a95d57be2a57306cd88389c2251f34b2fbcc1/csaf-vex/1999/cve-1999-0026.json","https://github.com/yarencheng/cve-devops-playground/blob/9074597bd191efd66c2a6bf1f5d8e60bc4801a90/content/CVE-1999-0026.md","https://github.com/Patrowl/PatrowlHearsData/blob/04a84e78299e2aeaab4d2594fc26f920778c7b06/CVE/data/1999/CVE-1999-0026.json","https://github.com/github/advisory-database/blob/1b2e09705f0816776a0a8a0cd6fc1208d25f09b2/advisories/unreviewed/2022/04/GHSA-jgjp-7pvm-43jq/GHSA-jgjp-7pvm-43jq.json","https://github.com/feng-li/tools-for-data-science-course/blob/8e62d47ee8ffbebe9a0e50aee193617f83883118/2019spring/2017312271/result.txt","https://github.com/olbat/nvdcve/blob/d21eb36f6164170df89822577def7df5351966d2/nvdcve/CVE-1999-0026.json","https://github.com/KTZgraph/sarenka/blob/f1fb931ab722d6c096d581ed6e3c5966d799fbaa/sarenka/feeds/cve_details/cve_all_details_154400_154500.json","https://github.com/oasis-open/cti-stix-common-objects/blob/55ba7598cbd5a52577b6887871505d931d85cb61/objects/vulnerability/vulnerability--f13688fd-9dfb-4099-8671-861cf60a21e1.json"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":[],"repo_exp_urls":[],"has_poc":false,"has_exp":false,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/1999/AVE-1999-0082.toml"},{"ave_id":"AVE-1999-0080","file_name":"1999/AVE-1999-0080.toml","cve_id":"CVE-1999-0025","title":"SGI IRIX df 本地权限提升漏洞","description":"SGI IRIX 6.3 系统中的 df 命令存在缓冲区溢出漏洞，本地攻击者可通过向 df 命令传入特制的超长参数触发缓冲区溢出，覆盖返回地址后执行任意代码，从而获取 root 权限。该漏洞影响 SGI IRIX 6.3 版本，利用条件是攻击者需拥有本地系统访问权限，CVSS 评分 7.2，危害等级高。","severity":"HIGH","score":7.2,"aliases":["CVE-1999-0025"],"sources":["exploitdb"],"published":"1997-07-16T04:00:00Z","updated":"2026-06-16T21:47:22Z","remediation":"安装 SGI 提供的 IRIX 安全补丁 19970505-02-PX，升级到已修复的 IRIX 版本。如无法立即打补丁，可执行 `chmod u-s /usr/sbin/df` 移除 df 的 setuid 权限作为临时缓解措施，或使用 AUSCERT 提供的 overflow_wrapper 工具限制命令行参数长度（建议 MAXARGLEN=32）并记录异常调用。由于 SGI IRIX 已停止维护，建议迁移至受支持的现代操作系统。","status":"completed","collected_at":"2026-07-14T00:00:00Z","references":["http://www.cert.org/advisories/CA-1997-21.html","http://www.kb.cert.org/vuls/id/20851","http://www.securityfocus.com/bid/346","https://exchange.xforce.ibmcloud.com/vulnerabilities/440","https://www.exploit-db.com/exploits/19274","https://github.com/CVEProject/cvelistV5/blob/dc83b9e6d88de194a14e3020b4e71ac42054e609/cves/1999/0xxx/CVE-1999-0025.json","https://github.com/LiuCan01/cve-list-pro/blob/78b55511cee3604c22d518e32822f0435d0cacc0/cve-list/CVE-1999/CVE-1999-0025","https://github.com/aquasecurity/vuln-list-redhat/blob/601a95d57be2a57306cd88389c2251f34b2fbcc1/csaf-vex/1999/cve-1999-0025.json","https://github.com/yarencheng/cve-devops-playground/blob/9074597bd191efd66c2a6bf1f5d8e60bc4801a90/content/CVE-1999-0025.md","https://github.com/Patrowl/PatrowlHearsData/blob/04a84e78299e2aeaab4d2594fc26f920778c7b06/CVE/data/1999/CVE-1999-0025.json","https://github.com/github/advisory-database/blob/1b2e09705f0816776a0a8a0cd6fc1208d25f09b2/advisories/unreviewed/2022/04/GHSA-5wr5-299q-993r/GHSA-5wr5-299q-993r.json","https://github.com/feng-li/tools-for-data-science-course/blob/8e62d47ee8ffbebe9a0e50aee193617f83883118/2019spring/2017312271/result.txt","https://github.com/intSpLoiT/intframework/blob/eabaa799d0260aa52b735fa9769266d1ce4b64ef/modules/cve_list.txt","https://github.com/kabaneridev/pt-notes/blob/05dba1a6e7d619d374878b2366ccc58b8e4a5ef2/CPTS-PREP/remote-management/linux-remote-protocols.md","https://github.com/KTZgraph/sarenka/blob/f1fb931ab722d6c096d581ed6e3c5966d799fbaa/sarenka/feeds/cve_details/cve_all_details_154400_154500.json"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":[],"repo_exp_urls":[],"has_poc":false,"has_exp":false,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/1999/AVE-1999-0080.toml"},{"ave_id":"AVE-1999-0299","file_name":"1999/AVE-1999-0299.toml","cve_id":"CVE-1999-0146","title":"NCSA httpd campas CGI 远程命令执行漏洞","description":"NCSA httpd 服务器自带的 campas CGI 程序未对用户输入进行充分过滤，远程攻击者可通过在查询字符串中插入编码的回车符（CR）注入任意系统命令，进而读取服务器上的敏感文件（如密码文件）或执行其他恶意操作。该漏洞影响多个版本的 NCSA web 服务器，无需身份认证即可远程利用，危害严重。","severity":"HIGH","score":7.5,"aliases":["CVE-1999-0146"],"sources":["exploitdb"],"published":"1997-07-15T04:00:00Z","updated":"2026-06-16T21:47:41Z","remediation":"删除 cgi-bin 目录下的 campas 示例脚本，或确保 NCSA httpd 已升级至不受影响的版本。建议迁移至长期维护的 Web 服务器（如 Apache HTTP Server），并移除所有示例 CGI 脚本以避免类似安全问题。","status":"completed","collected_at":"2026-07-14T00:00:00Z","references":["http://www.securityfocus.com/bid/1975","https://exchange.xforce.ibmcloud.com/vulnerabilities/298","https://www.exploit-db.com/exploits/20423","https://github.com/CVEProject/cvelistV5/blob/ab669d9fb37e52ed0619cb2b8265d34528fbe875/cves/1999/0xxx/CVE-1999-0146.json","https://github.com/LiuCan01/cve-list-pro/blob/78b55511cee3604c22d518e32822f0435d0cacc0/cve-list/CVE-1999/CVE-1999-0146","https://github.com/aquasecurity/vuln-list-redhat/blob/601a95d57be2a57306cd88389c2251f34b2fbcc1/csaf-vex/1999/cve-1999-0146.json","https://github.com/yarencheng/cve-devops-playground/blob/9074597bd191efd66c2a6bf1f5d8e60bc4801a90/content/CVE-1999-0146.md","https://github.com/Patrowl/PatrowlHearsData/blob/2ed73314b4d66512efbb22e0644e615bc00001f2/CVE/data/1999/CVE-1999-0146.json","https://github.com/github/advisory-database/blob/49899a53e9c2e620c99e0234afe3c50e512ad851/advisories/unreviewed/2022/04/GHSA-c22c-6v4p-99rm/GHSA-c22c-6v4p-99rm.json","https://github.com/NetBSD/pkgsrc-wip/blob/9e4b769742ed57395763142c26029c2f9910f15b/sara/PLIST","https://github.com/rhuitl/uClinux/blob/0486e80a025dccbe4a2213715a2ab8a5063ea86b/user/snort/drop-rules/sid-msg.map","https://github.com/feng-li/tools-for-data-science-course/blob/8e62d47ee8ffbebe9a0e50aee193617f83883118/2019spring/2017312271/result.txt","https://github.com/Freem93/grammar_nasl_v2/blob/63834ebb8cd6e97050e155291c7500ad53bb20c6/plugins/campas.nasl"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":[],"repo_exp_urls":[],"has_poc":false,"has_exp":false,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/1999/AVE-1999-0299.toml"},{"ave_id":"AVE-1999-0150","file_name":"1999/AVE-1999-0150.toml","cve_id":"CVE-1999-0059","title":"SGI IRIX fam 服务信息泄露漏洞","description":"SGI IRIX 操作系统的 fam（File Alteration Monitor）服务存在信息泄露漏洞，攻击者无需身份认证即可通过远程网络请求获取目标服务器上的所有文件列表，导致系统敏感文件路径与结构暴露。该漏洞影响 IRIX 多个版本，CVSS 评分 7.3，危害等级高危，攻击者可借此进行信息收集，为后续针对性攻击创造条件。","severity":"HIGH","score":7.3,"aliases":["CVE-1999-0059"],"sources":["epss"],"published":"1997-07-14T04:00:00Z","updated":"2026-06-16T21:47:28Z","remediation":"立即安装 SGI 1997 年发布的安全补丁（SGI 安全公告 19970701-01-P），或升级 IRIX 至不受影响的更高版本。若无法打补丁，在 `/etc/inetd.conf` 中注释 fam 服务行并重启 inetd，或执行 `/etc/init.d/fam stop` 停止 fam 服务，再通过 `chkconfig fam off` 禁止开机自启。同时建议在边界防火墙上阻断对 fam 默认端口（TCP 9751）的外部访问。由于 SGI IRIX 已于 2006 年停止技术支持，建议将业务迁移至仍在安全维护期的操作系统。","status":"completed","collected_at":"2026-07-13T00:00:00Z","references":["http://www.osvdb.org/164","http://www.securityfocus.com/bid/353","https://exchange.xforce.ibmcloud.com/vulnerabilities/325"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":[],"repo_exp_urls":[],"has_poc":false,"has_exp":false,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/1999/AVE-1999-0150.toml"},{"ave_id":"AVE-1999-1531","file_name":"1999/AVE-1999-1531.toml","cve_id":"CVE-1999-1463","title":"Microsoft Windows NT 4.0 TCP/IP 碎片重组拒绝服务漏洞","description":"tags.<value>Windows NT 4.0 SP3 之前版本的 TCP/IP 协议栈存在 IP 分片重组逻辑缺陷，远程攻击者无需身份认证即可向目标系统发送缺少首个分片的畸形 IP 分片数据包，导致协议栈错误地将后续分片重组成有效会话，从而绕过防火墙访问控制规则或造成系统崩溃引发拒绝服务。该漏洞影响 Windows NT 4.0 全系版本，CVSS 评分 5.0，危害等级中危。微软已在 SP3 更新中修复此漏洞。","severity":"MEDIUM","score":5.0,"aliases":["CVE-1999-1463"],"sources":["avd"],"published":"1997-07-10T04:00:00Z","updated":"2026-06-16T21:50:29Z","remediation":"升级 Windows NT 4.0 至 Service Pack 3 或更高版本。如无法立即升级，在网络边界部署支持碎片重组和深度包检测的防火墙，阻止不完整的 IP 碎片包进入内网。同时可在主机层面启用 TCP/IP 堆栈强化注册表设置，限制碎片重组缓冲区大小。作为临时缓解措施，可在网关上丢弃不带首片段的 IP 碎片包。","status":"completed","collected_at":"2026-07-20T00:00:00Z","references":["http://www.securityfocus.com/archive/1/7219","https://exchange.xforce.ibmcloud.com/vulnerabilities/528","https://github.com/CVEProject/cvelistV5/blob/b5102a7cca13b4c0a0e55e628783c406707da47e/cves/1999/1xxx/CVE-1999-1463.json","https://github.com/LiuCan01/cve-list-pro/blob/78b55511cee3604c22d518e32822f0435d0cacc0/cve-list/CVE-1999/CVE-1999-1463","https://github.com/yarencheng/cve-devops-playground/blob/470a5f1c0d1bd36cd0a6327cda49cf96a1474588/content/CVE-1999-1463.md","https://github.com/Patrowl/PatrowlHearsData/blob/2cba6a622b2958fa1ec3a506e7b58871edec19fb/CVE/data/1999/CVE-1999-1463.json","https://github.com/github/advisory-database/blob/78550cb05ca9623089e78169330acf979f4b64ca/advisories/unreviewed/2022/04/GHSA-rp7x-gfhv-xmq5/GHSA-rp7x-gfhv-xmq5.json","https://github.com/SpeeDr00t/speedr00t.github.com/blob/0380f0c2190556fabe90257cb6c0034a42f68951/securityfocus/0x88000/87915/info.html","https://github.com/olbat/nvdcve/blob/39f1db26eec9899ab2f8110ab3b45424c6fe9ec2/nvdcve/CVE-1999-1463.json","https://github.com/nomi-sec/NVD-Exploit-List-Ja/blob/b82432e7d59d95db9f183c0cefa7744595784afa/1999.tsv","https://github.com/KTZgraph/sarenka/blob/f1fb931ab722d6c096d581ed6e3c5966d799fbaa/sarenka/feeds/cve_details/cve_all_details_154400_154500.json","https://github.com/leego972/titanai/blob/afa5b2310463aae5781d3fd9408071bf38e79806/data/raw/corpus_D_cyber/nvd_cve_000188.txt"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":[],"repo_exp_urls":[],"has_poc":false,"has_exp":false,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/1999/AVE-1999-1531.toml"},{"ave_id":"AVE-1999-0351","file_name":"1999/AVE-1999-0351.toml","cve_id":"CVE-1999-0176","title":"WEBgais 1.0 远程命令执行漏洞","description":"WEBgais 1.0 存在远程命令执行漏洞，远程攻击者无需身份认证即可通过向服务器发送特制的 HTTP 请求，利用程序未对用户输入进行有效过滤的缺陷，在目标系统上执行任意命令，从而完全控制受影响的服务器。该漏洞影响 WEBgais 1.0 版本，CVSS 评分 7.5，危害等级高。","severity":"HIGH","score":7.5,"aliases":["CVE-1999-0176"],"sources":["exploitdb"],"published":"1997-07-10T04:00:00Z","updated":"2026-06-16T21:47:45Z","remediation":"立即从 Web 服务器 cgi-bin 目录中删除 webgais 脚本或将其移除，同时检查服务器上是否存在其他无用 CGI 程序并一并清理。如业务必须使用该功能，应迁移至有安全维护的替代方案（如现代 Web 框架实现的文件搜索功能），并在 Web 服务器（Apache/Nginx）层面限制 CGI 执行权限。临时缓解措施可配置 Web 服务器 ACL 仅允许可信 IP 访问 CGI 目录。","status":"completed","collected_at":"2026-07-14T00:00:00Z","references":["https://exchange.xforce.ibmcloud.com/vulnerabilities/CVE-1999-0176","https://www.exploit-db.com/exploits/20463","https://github.com/CVEProject/cvelistV5/blob/269e5b2b6ea60fdb4a03411be38d3e381b26e4c4/cves/1999/0xxx/CVE-1999-0176.json","https://github.com/LiuCan01/cve-list-pro/blob/78b55511cee3604c22d518e32822f0435d0cacc0/cve-list/CVE-1999/CVE-1999-0176","https://github.com/aquasecurity/vuln-list-redhat/blob/601a95d57be2a57306cd88389c2251f34b2fbcc1/csaf-vex/1999/cve-1999-0176.json","https://github.com/yarencheng/cve-devops-playground/blob/9074597bd191efd66c2a6bf1f5d8e60bc4801a90/content/CVE-1999-0176.md","https://github.com/Patrowl/PatrowlHearsData/blob/2f876a2c24d5ccd5bbd081f09e801e580536456a/CVE/data/1999/CVE-1999-0176.json","https://github.com/rhuitl/uClinux/blob/0486e80a025dccbe4a2213715a2ab8a5063ea86b/user/nessus/nessus-plugins/scripts/webgais.nasl","https://github.com/NetBSD/pkgsrc-wip/blob/9e4b769742ed57395763142c26029c2f9910f15b/sara/PLIST","https://github.com/fkie-cad/nvd-json-data-feeds/blob/1b69cf2313f68e29acceed58f52f6109cd37bb04/CVE-1999/CVE-1999-01xx/CVE-1999-0176.json","https://github.com/intSpLoiT/intframework/blob/eabaa799d0260aa52b735fa9769266d1ce4b64ef/modules/cve_list.txt","https://github.com/slacker247/GPDA/blob/fa9006d0877a691f1ddffe88799c844a3e8a669a/Sodi/Run/IDSrules/rule.840"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":["https://raw.githubusercontent.com/adysec/AVE/main/pocs/1999/POC-AVE-1999-0351.toml"],"repo_exp_urls":["https://raw.githubusercontent.com/adysec/AVE/main/exploits/1999/EXP-AVE-1999-0351.toml"],"has_poc":true,"has_exp":true,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/1999/AVE-1999-0351.toml"},{"ave_id":"AVE-1999-0378","file_name":"1999/AVE-1999-0378.toml","cve_id":"CVE-1999-0196","title":"WEBgais websendmail 远程命令执行漏洞","description":"Webgais 1.0 的 websendmail 组件在处理 receiver 参数（$VAR_receiver 变量）时存在输入验证缺陷，远程攻击者可通过向目标服务发送特制 HTTP 请求注入系统命令，从而实现任意文件读取与远程命令执行。该漏洞无需身份认证，攻击条件低，CVSS 评分 5.0，影响运行 Webgais 1.0 的服务器系统。","severity":"MEDIUM","score":5.0,"aliases":["CVE-1999-0196"],"sources":["exploitdb"],"published":"1997-07-08T04:00:00Z","updated":"2026-06-16T21:47:53Z","remediation":"立即删除 Web 服务器 cgi-bin/ 目录下的 websendmail 和 webgais 脚本，或通过 Apache 的 Directory 指令拒绝访问该 CGI 路径。WEBgais 1.0 已不再维护，无法通过升级修复。如必须使用，须在接收 $VAR_receiver 参数后过滤 shell 元字符（;、`、|、$ 等），并改用 Perl Mail::Sendmail 模块替代 open() 管道方式调用 sendmail。","status":"completed","collected_at":"2026-07-14T00:00:00Z","references":["http://www.osvdb.org/237","http://www.securityfocus.com/bid/2077","https://www.exploit-db.com/exploits/20483","https://github.com/CVEProject/cvelistV5/blob/92d64b4c9b3c5a0ce1fd1e5f8c017b9772e0139b/cves/1999/0xxx/CVE-1999-0196.json","https://github.com/LiuCan01/cve-list-pro/blob/78b55511cee3604c22d518e32822f0435d0cacc0/cve-list/CVE-1999/CVE-1999-0196","https://github.com/aquasecurity/vuln-list-redhat/blob/601a95d57be2a57306cd88389c2251f34b2fbcc1/csaf-vex/1999/cve-1999-0196.json","https://github.com/yarencheng/cve-devops-playground/blob/9074597bd191efd66c2a6bf1f5d8e60bc4801a90/content/CVE-1999-0196.md","https://github.com/Patrowl/PatrowlHearsData/blob/db45dbc75ff0264d63b603291e4a83d7361bd7ba/CVE/data/1999/CVE-1999-0196.json","https://github.com/rhuitl/uClinux/blob/0486e80a025dccbe4a2213715a2ab8a5063ea86b/user/nessus/nessus-plugins/scripts/websendmail.nasl","https://github.com/github/advisory-database/blob/79c2cf4630fcc44f2632735de08432a07cfaf204/advisories/unreviewed/2022/04/GHSA-35m5-388q-jrx8/GHSA-35m5-388q-jrx8.json","https://github.com/slacker247/GPDA/blob/fa9006d0877a691f1ddffe88799c844a3e8a669a/Sodi/Run/IDSrules/rule.820","https://github.com/olbat/nvdcve/blob/d21eb36f6164170df89822577def7df5351966d2/nvdcve/CVE-1999-0196.json","https://github.com/jdkoftinoff/mb-linux-msli/blob/8adb103e34af9ff1d8d122e9ee2a1808836f0a14/uClinux-dist/user/snort/drop-rules/sid-msg.map"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":["https://raw.githubusercontent.com/adysec/AVE/main/pocs/1999/POC-AVE-1999-0378.toml"],"repo_exp_urls":["https://raw.githubusercontent.com/adysec/AVE/main/exploits/1999/EXP-AVE-1999-0378.toml"],"has_poc":true,"has_exp":true,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/1999/AVE-1999-0378.toml"},{"ave_id":"AVE-1999-0093","file_name":"1999/AVE-1999-0093.toml","cve_id":"CVE-1999-0031","title":"Microsoft Internet Explorer JavaScript 信息泄露漏洞","description":"JavaScript 同源策略绕过漏洞存在于 Internet Explorer 3.x/4.x 及 Netscape 2.x/3.x/4.x 等早期浏览器中。远程攻击者可通过在恶意网页中植入特制 JavaScript 代码，监控用户跨站点的网页浏览活动，窃取用户的浏览历史与访问行为等敏感信息。该漏洞由贝尔实验室发现并报告，CVSS 评分 2.6，危害等级低，但由于浏览器版本较早且已停止支持，实际利用价值有限。","severity":"LOW","score":2.6,"aliases":["CVE-1999-0031"],"sources":["epss"],"published":"1997-07-08T04:00:00Z","updated":"2026-06-16T21:47:23Z","remediation":"立即停止使用 Internet Explorer 3.x/4.x 及 Netscape 2.x/3.x/4.x，升级到受支持的主流浏览器（如 Chrome、Edge、Firefox 最新版本），这些浏览器已不存在该跨域脚本监控漏洞。对于无法升级浏览器的老旧系统，建议在终端安装脚本拦截插件（如 NoScript）并禁用 JavaScript 执行作为临时缓解。","status":"completed","collected_at":"2026-07-13T00:00:00Z","references":["http://www.codetalker.com/advisories/vendor/hp/hpsbux9707-065.html"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":[],"repo_exp_urls":[],"has_poc":false,"has_exp":false,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/1999/AVE-1999-0093.toml"},{"ave_id":"AVE-1999-1481","file_name":"1999/AVE-1999-1481.toml","cve_id":"CVE-1999-1326","title":"wu-ftpd 2.4 ABOR命令信号处理权限提升漏洞","description":"wu-ftpd 2.4 FTP服务器在文件传输过程中处理ABOR（中止传输）命令时存在信号处理逻辑缺陷。当客户端同时关闭数据连接（触发SIGPIPE）和发送带外ABOR命令（触发SIGURG）时，SIGPIPE处理函数dologout()已将有效用户ID设为0并关闭日志文件，此时SIGURG信号通过longjmp跳回主命令循环，导致服务器以root权限继续运行且后续操作不再记录日志，攻击者可借此读取任意文件。","severity":"MEDIUM","score":5.0,"aliases":["CVE-1999-1326"],"sources":["cve"],"published":"1997-07-04T00:00:00Z","updated":"2026-06-16T00:00:00Z","remediation":"升级到已修复的wu-ftpd版本（如2.6.2或更高），或在dologout()函数开头添加transflag=0语句防止SIGURG信号通过longjmp跳回主循环；若无法升级，应限制FTP用户使用ABOR命令。","status":"completed","collected_at":"2026-07-20T11:45:03Z","references":["http://marc.info/?l=bugtraq&m=87602167420401&w=2","http://marc.info/?l=bugtraq&m=87602167420408&w=2","https://exchange.xforce.ibmcloud.com/vulnerabilities/7169"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":[],"repo_exp_urls":[],"has_poc":false,"has_exp":false,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/1999/AVE-1999-1481.toml"},{"ave_id":"AVE-1999-0930","file_name":"1999/AVE-1999-0930.toml","cve_id":"CVE-1999-0628","title":"{\"_meta\":{},\"stopReason\":\"end_turn\",\"usage\":{\"inputTokens\":10762,\"outputTokens\":19,\"totalTokens\":10781}}","description":"Linux rwho/rwhod 服务运行时会向网络广播主机状态和用户登录信息，导致敏感信息泄露。攻击者无需认证即可通过监听网络广播获取目标主机的运行状态、负载情况、登录用户列表等敏感信息。该漏洞影响运行 rwhod 服务的 Linux/Unix 系统，攻击者只需处于同一广播域即可被动收集信息，CVSS 评分 5.0（中危），属于信息泄露类漏洞。建议禁用 rwhod 服务或配置防火墙阻断 UDP 513 端口广播流量。","severity":"MEDIUM","score":5.0,"aliases":["CVE-1999-0628"],"sources":["epss"],"published":"1997-07-01T04:00:00Z","updated":"2026-06-16T21:48:45Z","remediation":"在不需要该服务的 Linux 主机上执行 `systemctl disable --now rwhod` 停止并禁用 rwhod 服务；通过防火墙（iptables/nftables）阻断 UDP 513 端口的入站流量，限制仅内网可信网段可访问；若仍须使用，升级内核至发行版最新补丁版本并确认 rwhod 已升级至修复版本。","status":"completed","collected_at":"2026-07-17T00:00:00Z","references":["https://exchange.xforce.ibmcloud.com/vulnerabilities/CVE-1999-0628","https://github.com/CVEProject/cvelistV5/blob/4d7236390d3d65194e590e3c8620543620af3984/cves/1999/0xxx/CVE-1999-0628.json","https://github.com/LiuCan01/cve-list-pro/blob/78b55511cee3604c22d518e32822f0435d0cacc0/cve-list/CVE-1999/CVE-1999-0628","https://github.com/yarencheng/cve-devops-playground/blob/e046e4965f64348bd29a0c62edd023b3c580939e/content/CVE-1999-0628.md","https://github.com/Patrowl/PatrowlHearsData/blob/6d3a932c05085f06507d23e5a0893fa8fe64ce42/CVE/data/1999/CVE-1999-0628.json","https://github.com/github/advisory-database/blob/1ef90eac7bb1a353721fe038daf41872bdff01c4/advisories/unreviewed/2022/04/GHSA-5fhh-rhpf-rxrp/GHSA-5fhh-rhpf-rxrp.json","https://github.com/nomi-sec/NVD-Database/blob/23dc120c34402aaa65883c51c1d03b3cb02c20cb/1999/CVE-1999-0628.json","https://github.com/SpeeDr00t/speedr00t.github.com/blob/0380f0c2190556fabe90257cb6c0034a42f68951/securityfocus/0x84000/83127/info.html","https://github.com/oasis-open/cti-stix-common-objects/blob/55ba7598cbd5a52577b6887871505d931d85cb61/objects/vulnerability/vulnerability--a257f052-36b0-4db1-9cd3-c865c04d3601.json","https://github.com/Ethishh/securin_assessment/blob/e6ce9197b6593ae46f3f5646d268181eea6cbb31/cve_sync.log","https://github.com/VulnerabilityHistoryProject/mega-foss/blob/4829eeb7b0101570abbc87d2a697f2c0c2f4e5c3/src/cve/graphql/trial.json"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":[],"repo_exp_urls":[],"has_poc":false,"has_exp":false,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/1999/AVE-1999-0930.toml"},{"ave_id":"AVE-1999-0799","file_name":"1999/AVE-1999-0799.toml","cve_id":"CVE-1999-0533","title":"{\"_meta\":{},\"stopReason\":\"end_turn\",\"usage\":{\"cachedReadTokens\":1664,\"inputTokens\":9088,\"outputTokens\":16,\"totalTokens\":10768}}","description":"DNS 服务器在处理反向查询（inverse query，即根据 IP 地址反查主机名）时存在安全配置缺陷，默认允许外部客户端发起此类查询。远程攻击者无需身份认证，只需向目标 DNS 服务器发送特制的反向查询请求，即可探测内网主机名与 IP 地址的对应关系，从而收集网络拓扑与资产信息，辅助后续定向攻击。该漏洞影响配置了 DNS 服务且未禁用反向查询功能的各类服务器，攻击条件仅为网络可达目标 53 端口，利用方式简单、无需特殊权限，可被广泛用于信息侦察。","severity":"HIGH","score":7.5,"aliases":["CVE-1999-0533"],"sources":["epss"],"published":"1997-07-01T04:00:00Z","updated":"2026-06-16T21:48:35Z","remediation":"升级 BIND 至 8.2.2-P5 及以上版本（或迁移至 BIND 9.x），并在 named.conf 中将 allow-recursion 限制为仅可信内网、关闭 zone 反查询转发；在边界防火墙阻断外部 53/UDP 的递归与反查询请求作为临时缓解。","status":"completed","collected_at":"2026-07-16T00:00:00Z","references":["https://exchange.xforce.ibmcloud.com/vulnerabilities/CVE-1999-0533","https://github.com/CVEProject/cvelistV5/blob/442e3d0f3c777e02c70fc200a453fe1f1f8a2431/cves/1999/0xxx/CVE-1999-0533.json","https://github.com/LiuCan01/cve-list-pro/blob/78b55511cee3604c22d518e32822f0435d0cacc0/cve-list/CVE-1999/CVE-1999-0533","https://github.com/yarencheng/cve-devops-playground/blob/45be3b4afd9c4397ee32a5cbf6819a590220b0c1/content/CVE-1999-0533.md","https://github.com/Patrowl/PatrowlHearsData/blob/19ba23eb6f8fe22cdd9a46164160f96a7cf3fffd/CVE/data/1999/CVE-1999-0533.json","https://github.com/github/advisory-database/blob/51a0e15452743e596ced46bb3f156961c52df5bb/advisories/unreviewed/2022/04/GHSA-pppp-2244-385q/GHSA-pppp-2244-385q.json","https://github.com/feng-li/tools-for-data-science-course/blob/8e62d47ee8ffbebe9a0e50aee193617f83883118/2019spring/2017312271/result.txt","https://github.com/nomi-sec/NVD-Database/blob/23dc120c34402aaa65883c51c1d03b3cb02c20cb/1999/CVE-1999-0533.json","https://github.com/oasis-open/cti-stix-common-objects/blob/55ba7598cbd5a52577b6887871505d931d85cb61/objects/vulnerability/vulnerability--d46adc43-9aa0-41f0-a73d-91f47f39cb2f.json","https://github.com/Ethishh/securin_assessment/blob/e6ce9197b6593ae46f3f5646d268181eea6cbb31/cve_sync.log","https://github.com/zephyros1603/RadiantProcessors/blob/7d44cb1cd4b9e088fbe463f1b19be50a04c2efe8/Backend/RAG/data/allitems.txt"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":[],"repo_exp_urls":[],"has_poc":false,"has_exp":false,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/1999/AVE-1999-0799.toml"},{"ave_id":"AVE-1999-0783","file_name":"1999/AVE-1999-0783.toml","cve_id":"CVE-1999-0526","title":"X.Org X11 服务器未授权访问漏洞","description":"tags.<value>X Window System（X11）服务器存在访问控制配置不当漏洞。当管理员执行 \"xhost +\" 命令或类似操作禁用 X 服务器的访问控制机制后，未经身份认证的远程攻击者可直接连接至目标系统的 X 服务，进而查看屏幕内容、记录键盘输入、执行任意命令，完全控制用户桌面会话。该漏洞影响配置有 X11 服务的 Unix/Linux 工作站和服务器，攻击者无需凭据即可在图形界面下实施窃密与破坏操作。修复方案为启用 X 服务器的访问控制列表（ACL），通过 \"xhost -\" 恢复默认限制或使用 SSH 隧道加密 X11 转发。","severity":"CRITICAL","score":10.0,"aliases":["CVE-1999-0526"],"sources":["epss"],"published":"1997-07-01T04:00:00Z","updated":"2026-06-16T21:48:35Z","remediation":"立即在 X server 所在主机执行 `xhost -` 或 `xhost -+` 撤销 `xhost +` 造成的全局开放访问控制，改用 `~/.Xauthority` 中的 MIT-MAGIC-COOKIE 密钥进行认证，对远程显示场景使用 `ssh -X` 或 `ssh -Y` 建立加密隧道并在允许列表中仅保留 `127.0.0.1`，同时执行 `chmod 600 ~/.Xauthority` 收紧密钥文件权限，杜绝无参数的 `xhost +`。","status":"completed","collected_at":"2026-07-16T00:00:00Z","references":["http://www.kb.cert.org/vuls/id/704969","https://github.com/trickest/cve/blob/6e5939e8074723d33adaf5b2f8b0352edab9ba8d/1999/CVE-1999-0526.md","https://github.com/CVEProject/cvelistV5/blob/37cec437f4ca5dbafb8ef4c4921c71da1b289b8f/cves/1999/0xxx/CVE-1999-0526.json","https://github.com/BrianWGray/cmty-nexpose-checks/blob/13b1c2f4cca654217a136c8eec10f7f6e18f35b8/cmty-x11-cve-1999-0526.vck","https://github.com/lvbibir/lvbibir.github.io/blob/563f70566900245eb0ea2d9afc1f1d378e9a0ed5/content/posts/tech/cve-1999-0526.md","https://github.com/LiuCan01/cve-list-pro/blob/78b55511cee3604c22d518e32822f0435d0cacc0/cve-list/CVE-1999/CVE-1999-0526","https://github.com/demisto/content/blob/f0f3f1996ab0ab86cf0719cf8b65d7b5741a97bb/Packs/GreyNoise/.secrets-ignore","https://github.com/e-m-b-a/emba/blob/968abdc74763b43a3cdd216fbb1950cab484f982/config/msf_cve-db.txt","https://github.com/Patrowl/PatrowlHearsData/blob/f581b54f28a314b57ac171b83d3b2d21db7414a0/CVE/data/1999/CVE-1999-0526.json","https://github.com/MrWQ/vulnerability-paper/blob/fcbdb421b62aef6ccac59a1887d94687f4faf9d6/bugs/%E7%AB%AF%E5%8F%A3%E6%BC%8F%E6%B4%9E%E5%85%A8%E9%9B%86.md","https://github.com/github/advisory-database/blob/11845a9fe6e6b4d82150d9fd8a4257b88a244a45/advisories/unreviewed/2022/04/GHSA-fv34-2r8h-94mm/GHSA-fv34-2r8h-94mm.json"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":[],"repo_exp_urls":[],"has_poc":false,"has_exp":false,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/1999/AVE-1999-0783.toml"},{"ave_id":"AVE-1999-0435","file_name":"1999/AVE-1999-0435.toml","cve_id":"CVE-1999-0250","title":"Dan Bernstein Qmail SMTP 命令处理拒绝服务漏洞","description":"Qmail 1.01 的 SMTP 组件在处理超长命令时存在拒绝服务漏洞。远程攻击者无需认证即可向目标服务器的 25 端口发送特制长 SMTP 命令，导致 qmail-smtpd 进程崩溃或异常终止，从而中断邮件服务。该漏洞影响 Dan Bernstein Qmail 1.01 版本，攻击复杂度低，且无需任何权限，可被用于阻断正常邮件收发功能。","severity":"CRITICAL","score":10.0,"aliases":["CVE-1999-0250"],"sources":["epss"],"published":"1997-07-01T04:00:00Z","updated":"2026-06-16T21:48:00Z","remediation":"立即升级至 Qmail 1.03 或更高版本，或在编译时添加 qmail-smtpd.c 中对输入行长度（LINE_MAX）的显式检查。如不便升级，可在 SMTP 服务前端部署流量过滤规则，限制单行 SMTP 命令长度不超过 512 字节。长期建议迁移至 Netqmail 补丁集（netqmail 1.06）以获得持续维护。","status":"completed","collected_at":"2026-07-14T00:00:00Z","references":["http://cr.yp.to/qmail/venema.html","http://marc.info/?l=bugtraq&m=87602558319024&w=2","http://www.ornl.gov/its/archives/mailing-lists/qmail/1997/06/threads.html","https://github.com/trickest/cve/blob/34851454a7b07498072de47d56f63daa4a4f524d/1999/CVE-1999-0250.md","https://github.com/CVEProject/cvelistV5/blob/ab6ab436962e16237b21ed9d4458dafc38c692fc/cves/1999/0xxx/CVE-1999-0250.json","https://github.com/LiuCan01/cve-list-pro/blob/78b55511cee3604c22d518e32822f0435d0cacc0/cve-list/CVE-1999/CVE-1999-0250","https://github.com/edoardottt/missing-cve-nuclei-templates/blob/36c16d53eb6071e39cfc3cf88e99f1b340ec913b/data/year/1999.txt","https://github.com/aquasecurity/vuln-list-redhat/blob/601a95d57be2a57306cd88389c2251f34b2fbcc1/csaf-vex/1999/cve-1999-0250.json","https://github.com/Patrowl/PatrowlHearsData/blob/a55bddfc5dd568e972e08b703ab596ed3580b7ba/CVE/data/1999/CVE-1999-0250.json","https://github.com/github/advisory-database/blob/49899a53e9c2e620c99e0234afe3c50e512ad851/advisories/unreviewed/2022/04/GHSA-wq5m-pq24-j5cv/GHSA-wq5m-pq24-j5cv.json","https://github.com/feng-li/tools-for-data-science-course/blob/8e62d47ee8ffbebe9a0e50aee193617f83883118/2019spring/2017312271/result.txt","https://github.com/SpeeDr00t/speedr00t.github.com/blob/0380f0c2190556fabe90257cb6c0034a42f68951/securityfocus/0x83000/82079/info.html","https://github.com/nomi-sec/NVD-Database/blob/23dc120c34402aaa65883c51c1d03b3cb02c20cb/1999/CVE-1999-0250.json"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":[],"repo_exp_urls":[],"has_poc":false,"has_exp":false,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/1999/AVE-1999-0435.toml"},{"ave_id":"AVE-1999-0407","file_name":"1999/AVE-1999-0407.toml","cve_id":"CVE-1999-0219","title":"Cat Soft Serv-U FTP Server 远程缓冲区溢出漏洞","description":"Cat Soft Serv-U FTP Server 2.5 存在远程缓冲区溢出漏洞。已认证的远程攻击者可通过向 FTP 服务发送超长的 CWD（切换目录）或 LS（列出文件）命令触发缓冲区溢出，导致服务进程崩溃，造成拒绝服务。该漏洞影响 Serv-U FTP Server 2.5 版本，攻击者只需拥有有效账号即可利用，无需其他特殊权限。","severity":"HIGH","score":7.8,"aliases":["CVE-1999-0219"],"sources":["exploitdb"],"published":"1997-07-01T04:00:00Z","updated":"2026-06-16T21:47:56Z","remediation":"升级至 Serv-U 2.5a 或更高版本可修复此缓冲区溢出漏洞。当前最新版为 SolarWinds Serv-U 15.x，建议立即升级并开启自动更新。如无法升级，可在防火墙限制 FTP 端口（21/TCP）仅对可信来源开放，并禁用匿名用户写权限作为临时缓解。","status":"completed","collected_at":"2026-07-16T00:00:00Z","references":["http://marc.info/?l=ntbugtraq&m=92574916930144&w=2","http://marc.info/?l=ntbugtraq&m=92582581330282&w=2","http://www.securityfocus.com/bid/269","https://exchange.xforce.ibmcloud.com/vulnerabilities/205","https://www.exploit-db.com/exploits/19218","https://github.com/CVEProject/cvelistV5/blob/ead50dc12e50bdd7f50b53d9d01c9f9946862c44/cves/1999/0xxx/CVE-1999-0219.json","https://github.com/LiuCan01/cve-list-pro/blob/78b55511cee3604c22d518e32822f0435d0cacc0/cve-list/CVE-1999/CVE-1999-0219","https://github.com/yarencheng/cve-devops-playground/blob/45be3b4afd9c4397ee32a5cbf6819a590220b0c1/content/CVE-1999-0219.md","https://github.com/Patrowl/PatrowlHearsData/blob/4ed191c1149de50e461e9a357f4a3a22e603f0d1/CVE/data/1999/CVE-1999-0219.json","https://github.com/github/advisory-database/blob/b7a93df7f7051799495805bc211adea8d202dae7/advisories/unreviewed/2022/04/GHSA-5495-52g6-8q95/GHSA-5495-52g6-8q95.json","https://github.com/feng-li/tools-for-data-science-course/blob/8e62d47ee8ffbebe9a0e50aee193617f83883118/2019spring/2017312271/result.txt","https://github.com/blackhook/nessus-plugins/blob/64177d96abbb07c58cf7e131046b067ebc61fcb5/F/ftp_servu_dos.nasl","https://github.com/nomi-sec/NVD-Database/blob/23dc120c34402aaa65883c51c1d03b3cb02c20cb/1999/CVE-1999-0219.json","https://github.com/jdkoftinoff/mb-linux-msli/blob/8adb103e34af9ff1d8d122e9ee2a1808836f0a14/uClinux-dist/user/nessus/nessus-plugins/scripts/ftp_overflow.nasl","https://github.com/KTZgraph/sarenka/blob/f1fb931ab722d6c096d581ed6e3c5966d799fbaa/sarenka/feeds/cve_details/cve_all_details_154400_154500.json"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":[],"repo_exp_urls":[],"has_poc":false,"has_exp":false,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/1999/AVE-1999-0407.toml"},{"ave_id":"AVE-1999-0377","file_name":"1999/AVE-1999-0377.toml","cve_id":"CVE-1999-0195","title":"Sun RPC Portmapper 源IP地址欺骗拒绝服务漏洞","description":"Linux Kernel 2.6.20.1 中的 RPC Portmapper 组件存在源 IP 地址验证缺陷，远程攻击者可通过伪造 127.0.0.1 等源 IP 地址向目标系统发送特制的 RPC 请求，实现注册/注销 RPC 服务或伪装合法 RPC 服务，导致目标系统拒绝服务。该漏洞影响 Linux Kernel 2.6.20.1 版本，CVSS 评分 5.0，危害等级中危。","severity":"MEDIUM","score":5.0,"aliases":["CVE-1999-0195"],"sources":["epss"],"published":"1997-07-01T04:00:00Z","updated":"2026-06-16T21:47:53Z","remediation":"升级 Linux 内核至 2.6.20.1 以上版本，该漏洞已在后续版本修复。使用 iptables 限制对 TCP/UDP 111 端口的访问来源，仅允许可信 IP 段连接 RPC portmapper。如不需要 RPC 服务，建议在 `/etc/init.d/` 中停止 portmap/rpcbind 服务并通过 `chkconfig portmap off` 禁止开机自启。","status":"completed","collected_at":"2026-07-13T00:00:00Z","references":["https://www.cve.org/CVERecord?id=CVE-1999-0195"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":[],"repo_exp_urls":[],"has_poc":false,"has_exp":false,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/1999/AVE-1999-0377.toml"}]
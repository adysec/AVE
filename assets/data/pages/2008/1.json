blob/3e4f21c329250c5eca327489d3fd5be9b398ce7b/data/rag_corpus/nvd_advisories/CVE-2008-0015.txt","https://github.com/cyberdudebivash/cyberdudebivash-ai-security-hub/blob/13403e1745f63237e7ef6d51562fb36112320d77/frontend/cve/CVE-2008-0015.html","https://github.com/urule99/jsunpack-n/blob/c01f406fd1ac113838f5e9ede8c04a63ef0acd5d/rules","https://github.com/mabitoski/cve_submodules/blob/44ad7e2705b3aef1b2ffaf64bd47596c10a6c2e4/2008/CVE-2008-0015.md","https://github.com/lucacapacci/cisa_kev/blob/730547e3121e93fb4d300346c9d4aa5d5b39b4fc/data_single/2008/CVE-2008-0015.csv"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":["https://raw.githubusercontent.com/adysec/AVE/main/pocs/2008/POC-AVE-2008-0022.toml"],"repo_exp_urls":["https://raw.githubusercontent.com/adysec/AVE/main/exploits/2008/EXP-AVE-2008-0022.toml"],"has_poc":true,"has_exp":true,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/2008/AVE-2008-0022.toml"},{"ave_id":"AVE-2008-0016","file_name":"2008/AVE-2008-0016.toml","cve_id":"CVE-2008-6668","title":"nweb2fax 0.2.7 目录遍历漏洞","description":"nweb2fax 0.2.7 及更早版本中存在多处目录遍历漏洞，远程攻击者无需身份认证即可通过在 comm.php 的 id 参数或 viewrq.php 的 var_filename 参数中构造 `../` 序列进行路径遍历，从而读取服务器上的任意文件。该漏洞利用难度低、危害中等，可能泄露系统敏感配置与用户数据。","severity":"MEDIUM","score":5.0,"aliases":["CVE-2008-6668"],"sources":["nuclei"],"published":"2009-04-08T10:30:00Z","updated":"2026-06-16T23:02:44Z","remediation":"nweb2fax 已于 2008 年停止维护，官方未发布修复版本。建议迁移至其他维护中的传真解决方案（如 HylaFAX+ AvantFAX 组合）；若无法替换，需在 Web 服务器（Apache/Nginx）层面对 comm.php 和 viewrq.php 的 id、var_filename 参数添加路径遍历过滤规则，禁止包含 ../ 及空字节序列，同时禁用 exec() 等危险 PHP 函数。","status":"completed","collected_at":"2026-07-15T00:00:00Z","references":["http://www.securityfocus.com/bid/29804","https://exchange.xforce.ibmcloud.com/vulnerabilities/43172","https://exchange.xforce.ibmcloud.com/vulnerabilities/43173","https://www.exploit-db.com/exploits/5856","https://github.com/projectdiscovery/nuclei-templates/blob/main/http/cves/2008/CVE-2008-6668.yaml","https://github.com/trickest/cve/blob/a90de4f84b4783951362f491671e1e9decfc17cb/2008/CVE-2008-6668.md","https://github.com/projectdiscovery/nuclei-templates/blob/490586283f9ca1596471e5230c91d74f96495bb9/http/cves/2008/CVE-2008-6668.yaml","https://github.com/CVEProject/cvelistV5/blob/0046a45cb220e45d345b72de014f969fbf07f97c/cves/2008/6xxx/CVE-2008-6668.json","https://github.com/ExpLangcn/NucleiTP/blob/2b7ecb9031a6eda4f272793045f29b339d8e0cce/CVES/high/cve-2008-6668-1399.yaml","https://github.com/exploit-io/nuclei-templates/blob/a4b7182985a6e45df346cfe45242d40455e152b5/templates/cve-2008-6668-1398.yaml","https://github.com/linuxadi/40k-nuclei-templates/blob/542be6820c801c02a33aee60f1c05ca7b0b5005f/aditya/folder1/cve-2008-6668-1.yaml","https://github.com/sepehrdaddev/zap-scripts/blob/2b63b02ca79cc7f0023cdbab72c5c6c774354b07/active/CVE-2008-6668.js","https://github.com/coreruleset/seaweed-reports/blob/3e2a1bd3dbca1b431f18ed0dabb71fa729d4d059/2022/Sep/04/traversalArtifact/traversalReport.csv","https://github.com/cckuailong/reapoc/blob/699762e4c31d0183733f64313d8fc3be6470bd37/2008/README.md","https://github.com/adampielak/nuclei-templates/blob/ac9605f5a915670fd80cb4e1904f4435f1835b65/nuclei-v2/C/cve-2008-6668-1.yaml"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":[],"repo_exp_urls":[],"has_poc":false,"has_exp":false,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/2008/AVE-2008-0016.toml"},{"ave_id":"AVE-2008-0015","file_name":"2008/AVE-2008-0015.toml","cve_id":"CVE-2008-6465","title":"Parallels H-Sphere login.php 跨站脚本漏洞","description":"Parallels H-Sphere 3.0.0 P9 及 3.1 P1 版本中 webshell4 组件的 login.php 存在多个跨站脚本（XSS）漏洞，远程攻击者可向 err、errorcode 及 login 等参数注入任意 Web 脚本或 HTML 代码，在用户浏览器中执行恶意脚本，窃取会话 Cookie 或重定向至钓鱼页面。攻击者无需身份认证，仅需诱使用户点击恶意链接即可触发，CVSS 评分 4.3，危害等级中危。","severity":"MEDIUM","score":4.3,"aliases":["CVE-2008-6465"],"sources":["nuclei"],"published":"2009-03-13T10:30:00Z","updated":"2026-06-16T23:02:16Z","remediation":"升级 Parallels H-Sphere 至 3.1 P1 之后的修复版本（如 3.1 P2 或更高），该版本已对 login.php 中 err、errorcode、login 参数做输出编码处理。若产品已停止维护无法升级，建议在 Web 服务器层（如 Apache mod_security）编写规则过滤含 <script> 等标签的请求参数，并对 login.php 的上述参数实施严格的输入验证和 HTML 实体编码输出，防止恶意脚本注入。","status":"completed","collected_at":"2026-07-15T00:00:00Z","references":["http://osvdb.org/48232","http://secunia.com/advisories/31830","http://www.securityfocus.com/bid/31256","http://www.xssing.com/index.php?x=3&y=65","https://exchange.xforce.ibmcloud.com/vulnerabilities/45252","https://exchange.xforce.ibmcloud.com/vulnerabilities/45254","https://github.com/projectdiscovery/nuclei-templates/blob/main/http/cves/2008/CVE-2008-6465.yaml","https://github.com/trickest/cve/blob/a90de4f84b4783951362f491671e1e9decfc17cb/2008/CVE-2008-6465.md","https://github.com/projectdiscovery/nuclei-templates/blob/490586283f9ca1596471e5230c91d74f96495bb9/http/cves/2008/CVE-2008-6465.yaml","https://github.com/CVEProject/cvelistV5/blob/0046a45cb220e45d345b72de014f969fbf07f97c/cves/2008/6xxx/CVE-2008-6465.json","https://github.com/cckuailong/reapoc/blob/699762e4c31d0183733f64313d8fc3be6470bd37/2008/README.md","https://github.com/linuxadi/40k-nuclei-templates/blob/542be6820c801c02a33aee60f1c05ca7b0b5005f/aditya/folder4/CVE-2008-6465.yaml","https://github.com/aquasecurity/vuln-list-nvd/blob/30c082f6aec54c3623618927fd86afa06ffe0d2b/api/2008/CVE-2008-6465.json","https://github.com/adampielak/nuclei-templates/blob/ac9605f5a915670fd80cb4e1904f4435f1835b65/nuclei-v3/C/CVE-2008-6465_34.yaml","https://github.com/rix4uni/nucleihub-templates/blob/579a0234551b9e0e322460a62dc77bd6109e4aff/nucleihub-templates/CVE-2008-6465_2.yaml","https://github.com/damn77789/nuclei-pocs/blob/81fb60243f8c8e930e9c4f1b65e2110e6e5a9204/folder-1/CVE-2008-6465.yaml","https://github.com/opencve/opencve-kb/blob/4f5d48b1c3a330d141e8b88dc72924e575aa6154/2008/CVE-2008-6465.json"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":[],"repo_exp_urls":[],"has_poc":false,"has_exp":false,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/2008/AVE-2008-0015.toml"},{"ave_id":"AVE-2008-0014","file_name":"2008/AVE-2008-0014.toml","cve_id":"CVE-2008-6222","title":"Joomla! Pro Desk Support Center 本地文件包含漏洞","description":"Joomla! 的 Pro Desk Support Center (com_pro_desk) 组件 1.0 及 1.2 版本存在目录遍历漏洞。远程攻击者可通过向 index.php 的 include_file 参数传递包含 `..` 序列的恶意路径，绕过访问限制读取服务器上的任意文件，导致敏感信息泄露。该漏洞无需身份认证即可远程利用，攻击门槛低。建议升级至官方修复版本或移除受影响组件。","severity":"MEDIUM","score":5.0,"aliases":["CVE-2008-6222"],"sources":["nuclei"],"published":"2009-02-20T21:30:01Z","updated":"2026-06-16T23:01:50Z","remediation":"立即卸载 Pro Desk Support Center (com_pro_desk) 组件 1.0/1.2 版本，该组件已停止维护，无安全更新可用。若业务依赖，请升级至已修复目录遍历漏洞的 ProDesk 1.5 及以上版本，并在服务端配置禁用 `include_file` 参数的路径回溯（`../`）输入。同时启用 Web 应用防火墙（WAF）规则，拦截路径遍历关键词如 `..%2f` 和 `../../`。","status":"completed","collected_at":"2026-07-15T00:00:00Z","references":["http://secunia.com/advisories/32523","http://www.securityfocus.com/bid/32113","https://exchange.xforce.ibmcloud.com/vulnerabilities/46356","https://www.exploit-db.com/exploits/6980","https://www.exploit-db.com/exploits/15460","https://github.com/projectdiscovery/nuclei-templates/blob/main/http/cves/2008/CVE-2008-6222.yaml","https://github.com/trickest/cve/blob/a90de4f84b4783951362f491671e1e9decfc17cb/2008/CVE-2008-6222.md","https://github.com/projectdiscovery/nuclei-templates/blob/490586283f9ca1596471e5230c91d74f96495bb9/http/cves/2008/CVE-2008-6222.yaml","https://github.com/CVEProject/cvelistV5/blob/0046a45cb220e45d345b72de014f969fbf07f97c/cves/2008/6xxx/CVE-2008-6222.json","https://github.com/0xKayala/Custom-Nuclei-Templates/blob/1940dfd29577590f076c89dec5c30d809d68f210/5001-to-6000-templates/cve-2008-6222-1394.yaml","https://github.com/lianqingsec/NucleiPocGather/blob/dcce204f62196117b9c95c52d8101ccf7a5d27bc/poc/cve/cve-2008-6222-1393.yaml","https://github.com/adampielak/nuclei-templates/blob/ac9605f5a915670fd80cb4e1904f4435f1835b65/nuclei-v3/C/CVE-2008-6222_15.yaml","https://github.com/LiuCan01/cve-list-pro/blob/78b55511cee3604c22d518e32822f0435d0cacc0/cve-list/CVE-2008/CVE-2008-6222","https://github.com/ExpLangcn/NucleiTP/blob/2b7ecb9031a6eda4f272793045f29b339d8e0cce/CVES/high/cve-2008-6222-1392.yaml","https://github.com/coreruleset/seaweed-reports/blob/3e2a1bd3dbca1b431f18ed0dabb71fa729d4d059/2022/Sep/26/lfiArtifact/lfiReport.csv","https://github.com/RiskBasedPrioritization/RiskBasedPrioritizationAnalysis/blob/3d5cc1819ecb8cbc3aeb75d9a8260318544faf56/data_in/nuclei/nuclei.txt"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":[],"repo_exp_urls":[],"has_poc":false,"has_exp":false,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/2008/AVE-2008-0014.toml"},{"ave_id":"AVE-2008-0041","file_name":"2008/AVE-2008-0041.toml","cve_id":"CVE-2008-6218","title":"libpng libpng 内存泄漏导致拒绝服务漏洞","description":"libpng 库的 pngrutil.c 文件中 png_handle_tEXt 函数存在内存泄漏漏洞，影响 libpng 1.2.33 rc02 之前版本和 1.4.0 beta36 之前版本。攻击者可通过构造包含恶意 tEXt 块的 PNG 文件，诱导受害者使用受影响版本的 libpng 解析该文件，触发 png_handle_tEXt 函数中的内存泄漏，导致内存耗尽并引发拒绝服务（内存耗尽）。攻击者需诱导用户打开或处理恶意 PNG 文件，利用条件为受害者使用受影响版本的 libpng 库处理 PNG 图片，CVSS 评分 7.1（AV:N/AC:M/Au:N/C:N/I:N/A:C），影响可用性严重。libpng 官方已在 1.2.33 rc02 和 1.4.0 beta36 版本中修复该漏洞，建议升级至修复版本或更新使用 libpng 的相关软件包。","severity":"HIGH","score":7.1,"aliases":["CVE-2008-6218"],"sources":["tenable"],"published":"2009-02-20T17:30:03Z","updated":"2026-06-16T23:01:50Z","remediation":"建议立即升级 libpng 至 1.2.33 正式版或 1.4.0 beta36 及以上版本（已修复 CVE-2008-6218 内存泄漏补丁）。若使用旧版系统无法直接升级，可应用厂商回补丁（如 OpenMandriva libpng-1.2.44-CVE-2008-6218.diff 补丁）。临时缓解措施：在应用层禁止处理不可信 PNG 文件，或部署 PNG 解析器沙箱/内存限制防止内存耗尽攻击。","status":"completed","collected_at":"2026-07-24T00:00:00Z","references":["http://secunia.com/advisories/32418","http://secunia.com/advisories/34265","http://secunia.com/advisories/34320","http://secunia.com/advisories/34388","http://security.gentoo.org/glsa/glsa-200903-28.xml","http://sourceforge.net/project/shownotes.php?release_id=635463&group_id=5624","http://sourceforge.net/project/shownotes.php?release_id=635837","http://wiki.rpath.com/Advisories:rPSA-2009-0046","http://www.debian.org/security/2009/dsa-1750","http://www.mandriva.com/security/advisories?name=MDVSA-2010:133","http://www.securityfocus.com/archive/1/501767/100/0/threaded","http://www.securityfocus.com/bid/31920","http://www.securitytracker.com/id?1021104","http://www.vupen.com/english/advisories/2008/2917","http://www.vupen.com/english/advisories/2010/1837","https://exchange.xforce.ibmcloud.com/vulnerabilities/46115","https://github.com/trickest/cve/blob/efd7fc726910da5a47b5ea864d60bf92f66b594e/2008/CVE-2008-6218.md","https://github.com/CVEProject/cvelistV5/blob/67d48875bcd35ab339290b9a99c435b09bd5c40b/cves/2008/6xxx/CVE-2008-6218.json","https://github.com/LiuCan01/cve-list-pro/blob/78b55511cee3604c22d518e32822f0435d0cacc0/cve-list/CVE-2008/CVE-2008-6218","https://github.com/edoardottt/missing-cve-nuclei-templates/blob/115c94bd1da3cc18977d652d6e78c9f4a5dfc13b/data/year/2008.txt","https://github.com/nottrobin/ubuntu-cve-tracker/blob/36e411296b5707284049ec2e0db8d2622feca498/retired/CVE-2008-6218","https://github.com/github/advisory-database/blob/2b8a7bdd977d852aa4b7aade01f4fcd4d623cfde/advisories/unreviewed/2022/05/GHSA-8p6q-rjmr-6gp9/GHSA-8p6q-rjmr-6gp9.json","https://github.com/OpenMandrivaAssociation/libpng12/blob/86d7f413b50912c7a42f0e529e144eee007d3fdb/libpng-1.2.44-CVE-2008-6218.diff","https://github.com/Yang-Yanjing/Robustness_for_SVD/blob/8b1db32f55004340ae20594474c33bdf7fade1ed/data/LibPNG/Vulnerable_Files/Preprocessed/_cve-2008-6218.c.txt","https://github.com/Patrowl/PatrowlHearsData/blob/dc46d37c28bb275abd05bf31414b33cf4107e07c/CVE/data/2008/CVE-2008-6218.json","https://github.com/sgidevnet/sgug-rse/blob/32b85d9866610a7d10b228f8f92f1ed8df610b48/packages/libpng10/libpng10.spec"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":[],"repo_exp_urls":[],"has_poc":false,"has_exp":false,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/2008/AVE-2008-0041.toml"},{"ave_id":"AVE-2008-0013","file_name":"2008/AVE-2008-0013.toml","cve_id":"CVE-2008-6172","title":"Weberr RWCards Joomla! 组件路径遍历漏洞","description":"Weberr 公司开发的 Joomla! 组件 RWCards 3.0.11 版本中 captcha/captcha_image.php 存在目录遍历漏洞。当 PHP 配置选项 magic_quotes_gpc 被禁用时，远程攻击者可通过 img 参数构造特制的目录遍历序列（如 ../），实现包含并执行服务器上的任意本地文件。该漏洞可导致敏感信息泄露或进一步获取服务器控制权限，影响运行该组件的所有 Joomla! 站点。","severity":"MEDIUM","score":6.8,"aliases":["CVE-2008-6172"],"sources":["nuclei"],"published":"2009-02-19T16:30:00Z","updated":"2026-06-16T23:01:45Z","remediation":"建议立即卸载 RWCards 3.0.11 组件（该组件已停止维护），更换为仍在活跃开发的 Joomla! 卡片类扩展。如无法卸载，可手动编辑 captcha/captcha_image.php，对 img 参数使用 realpath() 解析并校验路径是否在预期目录内，同时过滤所有包含 ../ 的目录跳转序列。此外，在 .htaccess 中添加 RewriteRule 阻止对 captcha/ 目录的直接恶意请求。PHP 配置中禁用 allow_url_fopen 和 allow_url_include 可降低本地文件包含带来的后续风险。","status":"completed","collected_at":"2026-07-15T00:00:00Z","references":["http://secunia.com/advisories/32367","http://www.securityfocus.com/bid/31892","https://exchange.xforce.ibmcloud.com/vulnerabilities/46081","https://www.exploit-db.com/exploits/6817","https://github.com/projectdiscovery/nuclei-templates/blob/main/http/cves/2008/CVE-2008-6172.yaml","https://github.com/trickest/cve/blob/a90de4f84b4783951362f491671e1e9decfc17cb/2008/CVE-2008-6172.md","https://github.com/projectdiscovery/nuclei-templates/blob/490586283f9ca1596471e5230c91d74f96495bb9/http/cves/2008/CVE-2008-6172.yaml","https://github.com/CVEProject/cvelistV5/blob/0046a45cb220e45d345b72de014f969fbf07f97c/cves/2008/6xxx/CVE-2008-6172.json","https://github.com/GhostTroops/scan4all/blob/fff03b51bf79c8993a46c1da766ec993e1102c47/config/51pwn/yaml/Joomla/CVE-2008-6172.yaml","https://github.com/0xKayala/Custom-Nuclei-Templates/blob/1940dfd29577590f076c89dec5c30d809d68f210/5001-to-6000-templates/cve-2008-6172-1391.yaml","https://github.com/sepehrdaddev/zap-scripts/blob/2b63b02ca79cc7f0023cdbab72c5c6c774354b07/active/CVE-2008-6172.js","https://github.com/lianqingsec/NucleiPocGather/blob/dcce204f62196117b9c95c52d8101ccf7a5d27bc/poc/cve/cve-2008-6172-1388.yaml","https://github.com/emadshanab/nucleiDB/blob/a06eb8edf2853662c304e3f41f8887b65f56e399/z-11753.yaml","https://github.com/runZeroInc/nuclei-templates/blob/89af8e391d368228625addfe3ecc6aee3b5d0345/http/cves/2008/CVE-2008-6172.yaml","https://github.com/coreruleset/seaweed-reports/blob/3e2a1bd3dbca1b431f18ed0dabb71fa729d4d059/2023/Mar/12/Reports/Report.csv"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":[],"repo_exp_urls":[],"has_poc":false,"has_exp":false,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/2008/AVE-2008-0013.toml"},{"ave_id":"AVE-2008-0012","file_name":"2008/AVE-2008-0012.toml","cve_id":"CVE-2008-6080","title":"Joomla! ionFiles 4.4.2 目录遍历漏洞","description":"Joomla! 的 ionFiles 组件（com_ionfiles）4.4.2 版本中的 download.php 文件存在目录遍历漏洞。远程攻击者无需身份认证即可通过在 file 参数中插入 `..` 序列实现路径跳转，进而读取服务器上任意敏感文件，如配置文件、数据库凭证等。该漏洞源于对用户输入的 file 参数缺乏充分的路径过滤与安全检查，影响范围涉及所有使用该版本组件的 Joomla! 网站，CVSS 评分 5.0，危害等级中等。","severity":"MEDIUM","score":5.0,"aliases":["CVE-2008-6080"],"sources":["nuclei"],"published":"2009-02-06T11:30:00Z","updated":"2026-06-16T23:01:33Z","remediation":"The user wants me to generate a [remediation] field for CVE-2008-6080. This is an old Joomla component vulnerability - a directory traversal in ionFiles 4.4.2 component for Joomla!. Let me think about what remediation makes sense here.\n\nSince this is a very old CVE (2008) for a Joomla component (com_ionfiles 4.4.2), the realistic remediation would be:\n1. Upgrade to a patched version of the component (if available)\n2. Remove/uninstall the vulnerable component if no patch exists\n3. Configure the web server to block directory traversal attempts\n4. As a mitigation, restrict access to the component\n\nSince this is a third-party Joomla component from 2008 that is likely abandoned, the most practical advice would be to upgrade to the latest version or uninstall it. Let me search for more information first.\n\nActually, let me check if there's any patch information available. The vulnerability is in ionFiles 4.4.2 component. Given it's from 2008, the component is likely discontinued. The most practical remediation would be to remove the component or apply a workaround.\n\nLet me search for more context.The vulnerability is CVE-2008-6080, a directory traversal in the ionFiles 4.4.2 component for Joomla!. This is an old third-party component that is likely discontinued.\n\nThe remediation should be practical and specific. Given:\n1. It's a Joomla component from 2008 - likely abandoned\n2. It's a directory traversal via download.php?file= parameter\n3. The component is com_ionfiles version 4.4.2\n\nThe practical remediation would be:\n1. Remove/uninstall the com_ionfiles component if not needed\n2. If needed, apply input validation to the `file` parameter in download.php to prevent directory traversal\n3. Upgrade to a patched version if available\n4. Use .htaccess to restrict access to the component directory\n\nSince I can't find information about a patched version (the component is likely abandoned given it's from 2008), the most practical advice is to uninstall it or apply the fix manually.\n\nLet me write a remediation that is specific and actionable.<value>立即卸载 com_ionfiles 组件（如业务不需要）；若必须使用，手动修改 `components/com_ionfiles/download.php` 第 32 行，对 `$_GET['file']` 参数执行 `basename()` 和 `realpath()` 校验，禁止路径包含 `../` 或 `..\\\\` 字符，并将 `open_basedir` 限制在组件目录内。同时通过 `.htaccess` 限制对 `download.php` 的访问来源。\n","status":"completed","collected_at":"2026-07-15T00:00:00Z","references":["http://secunia.com/advisories/32377","http://www.securityfocus.com/bid/31877","https://exchange.xforce.ibmcloud.com/vulnerabilities/46039","https://www.exploit-db.com/exploits/6809","https://github.com/projectdiscovery/nuclei-templates/blob/main/http/cves/2008/CVE-2008-6080.yaml","https://github.com/trickest/cve/blob/a90de4f84b4783951362f491671e1e9decfc17cb/2008/CVE-2008-6080.md","https://github.com/projectdiscovery/nuclei-templates/blob/490586283f9ca1596471e5230c91d74f96495bb9/http/cves/2008/CVE-2008-6080.yaml","https://github.com/CVEProject/cvelistV5/blob/0046a45cb220e45d345b72de014f969fbf07f97c/cves/2008/6xxx/CVE-2008-6080.json","https://github.com/ExpLangcn/NucleiTP/blob/2b7ecb9031a6eda4f272793045f29b339d8e0cce/CVES/high/cve-2008-6080-1380.yaml","https://github.com/0xKayala/Custom-Nuclei-Templates/blob/1940dfd29577590f076c89dec5c30d809d68f210/5001-to-6000-templates/cve-2008-6080-1383.yaml","https://github.com/adampielak/nuclei-templates/blob/ac9605f5a915670fd80cb4e1904f4435f1835b65/nuclei-v3/C/CVE-2008-6080_28.yaml","https://github.com/0xelixer/new/blob/6f6dd4a43a76ce74c1e8cc0558629a2ea198286e/nuclei-temps/Vulnerability-Templates/template2/cve-2008-6080-1385.yaml","https://github.com/coreruleset/seaweed-reports/blob/3e2a1bd3dbca1b431f18ed0dabb71fa729d4d059/2023/Apr/09/Reports/lfiReport.csv","https://github.com/rishikesh-j/Nuclei-Templates-Scrapped/blob/c1c4a009b3ada12b7923dcbc40e099ce8f224b2c/templates/cve-2008-6080-1380.yaml","https://github.com/rix4uni/nucleihub-templates/blob/579a0234551b9e0e322460a62dc77bd6109e4aff/nucleihub-templates/CVE-2008-6080-1384_1.yaml"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":[],"repo_exp_urls":[],"has_poc":false,"has_exp":false,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/2008/AVE-2008-0012.toml"},{"ave_id":"AVE-2008-0040","file_name":"2008/AVE-2008-0040.toml","cve_id":"CVE-2008-5907","title":"libpng 未初始化内存访问漏洞（png_check_keyword 函数处理关键词时可篡改任意内存）","description":"libpng 的 png_check_keyword 函数（位于 pngwutil.c 中）在处理 PNG 图像的关键字（keyword）时，存在一种隐式类型转换漏洞。由于代码将字符常量 '\\0' 错误地隐式转换为 NULL 指针，攻击者可通过构造包含特制关键字的恶意 PNG 文件，使该函数将任意内存位置的值设为 0，从而破坏内存数据的完整性。该漏洞影响 1.0.42 版本之前的 libpng 以及 1.2.x 系列 1.2.34 版本之前的 libpng 均受影响。攻击条件为攻击者能够诱使目标应用程序或服务使用受影响版本的 libpng 解析恶意 PNG 图像文件。攻击方式为攻击者构造一个包含特定 crafted 关键字的 PNG 图像，当目标系统使用漏洞版本的 libpng 加载该图像时，即可触发内存篡改，导致数据损坏或潜在的其他安全风险。","severity":"MEDIUM","score":5.0,"aliases":["CVE-2008-5907"],"sources":["tenable"],"published":"2009-01-15T17:30:00Z","updated":"2026-06-16T23:01:12Z","remediation":"建议立即升级 libpng 至 1.0.42 或 1.2.34 及以上版本。Ubuntu 用户可执行 `apt-get update && apt-get install libpng12-0=1.2.27-2ubuntu2.1`（或更高版本）；Debian 用户升级至 libpng12-0 1.2.27-2etch1 或更高；RHEL/CentOS 用户通过 `yum update libpng` 升级至 1.2.10-7.1.el5_3 或更高；Gentoo 用户执行 `emerge -u '>=media-libs/libpng-1.2.34'`。若暂无法升级，建议在应用层禁止处理不可信 PNG 文件，并在防火墙/应用层限制 PNG 文件上传与解析，作为临时缓解措施。","status":"completed","collected_at":"2026-07-24T00:00:00Z","references":["http://libpng.sourceforge.net/index.html","http://lists.opensuse.org/opensuse-security-announce/2009-02/msg00000.html","http://openwall.com/lists/oss-security/2009/01/09/1","http://secunia.com/advisories/34320","http://secunia.com/advisories/34388","http://security.gentoo.org/glsa/glsa-200903-28.xml","http://sourceforge.net/mailarchive/forum.php?thread_name=4B6F0239C13D0245820603C036D180BC79FBAA%40CABOTUKEXCH01.cabot.local&forum_name=png-mng-implement","http://www.debian.org/security/2009/dsa-1750","http://www.mandriva.com/security/advisories?name=MDVSA-2009:051","https://exchange.xforce.ibmcloud.com/vulnerabilities/48128","https://github.com/CVEProject/cvelistV5/blob/67d48875bcd35ab339290b9a99c435b09bd5c40b/cves/2008/5xxx/CVE-2008-5907.json","https://github.com/LiuCan01/cve-list-pro/blob/78b55511cee3604c22d518e32822f0435d0cacc0/cve-list/CVE-2008/CVE-2008-5907","https://github.com/yarencheng/cve-devops-playground/blob/4731f60845c8f35e2bdb03d333a9e9d84c7b1c27/content/CVE-2008-5907.md","https://github.com/Patrowl/PatrowlHearsData/blob/dc46d37c28bb275abd05bf31414b33cf4107e07c/CVE/data/2008/CVE-2008-5907.json","https://github.com/kees/ubuntu-cve-tracker/blob/66a43c37da527bc16621fb5548dca8aa1f46e537/retired/CVE-2008-5907","https://github.com/sgidevnet/sgug-rse/blob/32b85d9866610a7d10b228f8f92f1ed8df610b48/packages/libpng10/libpng10.spec","https://github.com/xqcyberscore/nvt/blob/978f6a9acb495d7d669239530ffe6da5d631f4da/2015/glsa-201412-08.nasl","https://github.com/gentoo-mirror/gentoo/blob/0a238e22d266bcab732a0143b7631823c3759fed/metadata/glsa/glsa-200903-28.xml","https://github.com/blackhook/nessus-plugins/blob/64177d96abbb07c58cf7e131046b067ebc61fcb5/S/suse9_12339.nasl","https://github.com/canonical/ubuntu-security-notices/blob/92dda528ca97f3539c8b045b34ac3d199130422b/usn/730-1.json"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":[],"repo_exp_urls":[],"has_poc":false,"has_exp":false,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/2008/AVE-2008-0040.toml"},{"ave_id":"AVE-2008-0011","file_name":"2008/AVE-2008-0011.toml","cve_id":"CVE-2008-5587","title":"phpPgAdmin 4.2.1 `_language` 参数目录遍历漏洞","description":"phpPgAdmin 4.2.1 及之前版本的 libraries/lib.inc.php 文件中存在目录遍历漏洞。当 PHP 环境的 register_globals 选项启用时，远程攻击者可通过向 index.php 的 _language 参数传递包含 ../ 的恶意路径，绕过目录限制读取服务器上的任意文件，导致数据库配置文件、系统凭证等敏感信息泄露。攻击无需认证，利用难度较低。","severity":"MEDIUM","score":4.3,"aliases":["CVE-2008-5587"],"sources":["nuclei"],"published":"2008-12-16T19:07:31Z","updated":"2026-06-16T23:00:37Z","remediation":"升级 phpPgAdmin 至 4.2.1-1.1 及以上版本（Debian  unstable 对应 4.2.1-1.1，Debian Etch 对应 4.0.1-3.1etch1）。同时在 php.ini 中将 `register_globals` 设为 Off（PHP 5.3+ 已废弃该选项，PHP 5.4+ 已移除），并确保 `_language` 参数经过白名单校验，禁止包含 `../` 等路径遍历字符。如无法立即升级，可在 Web 服务器层面（如 Apache mod_rewrite）拦截包含 `_language=../` 的请求作为临时缓解。","status":"completed","collected_at":"2026-07-15T00:00:00Z","references":["http://lists.opensuse.org/opensuse-security-announce/2009-02/msg00002.html","http://lists.opensuse.org/opensuse-updates/2012-04/msg00033.html","http://secunia.com/advisories/33014","http://secunia.com/advisories/33263","http://securityreason.com/securityalert/4737","http://www.debian.org/security/2008/dsa-1693","http://www.securityfocus.com/bid/32670","https://exchange.xforce.ibmcloud.com/vulnerabilities/47140","https://www.exploit-db.com/exploits/7363","https://github.com/projectdiscovery/nuclei-templates/blob/main/http/cves/2008/CVE-2008-5587.yaml","https://github.com/trickest/cve/blob/a90de4f84b4783951362f491671e1e9decfc17cb/2008/CVE-2008-5587.md","https://github.com/projectdiscovery/nuclei-templates/blob/490586283f9ca1596471e5230c91d74f96495bb9/http/cves/2008/CVE-2008-5587.yaml","https://github.com/ExpLangcn/NucleiTP/blob/2b7ecb9031a6eda4f272793045f29b339d8e0cce/CVES/medium/cve-2008-5587-1378.yaml","https://github.com/cckuailong/reapoc/blob/699762e4c31d0183733f64313d8fc3be6470bd37/2008/README.md","https://github.com/0xKayala/Custom-Nuclei-Templates/blob/1940dfd29577590f076c89dec5c30d809d68f210/5001-to-6000-templates/cve-2008-5587-1376.yaml","https://github.com/nottrobin/ubuntu-cve-tracker/blob/36e411296b5707284049ec2e0db8d2622feca498/retired/CVE-2008-5587","https://github.com/Freem93/grammar_nasl_v2/blob/63834ebb8cd6e97050e155291c7500ad53bb20c6/plugins/fedora_2008-11564.nasl","https://github.com/aquasecurity/vuln-list-debian/blob/b504c563e52b82e368fb82bf2033317b7c351e61/tracker/CVE/2008/CVE-2008-5587.json","https://github.com/linuxadi/40k-nuclei-templates/blob/542be6820c801c02a33aee60f1c05ca7b0b5005f/aditya/folder1/cve-2008-5587-1377.yaml","https://github.com/coreruleset/seaweed-reports/blob/3e2a1bd3dbca1b431f18ed0dabb71fa729d4d059/2023/Jan/15/Reports/Report.csv"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":[],"repo_exp_urls":[],"has_poc":false,"has_exp":false,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/2008/AVE-2008-0011.toml"},{"ave_id":"AVE-2008-0010","file_name":"2008/AVE-2008-0010.toml","cve_id":"CVE-2008-5281","title":"South River Technologies Titan FTP Server 远程缓冲区溢出漏洞","description":"South River Technologies Titan FTP Server 6.05 存在栈缓冲区溢出漏洞，远程攻击者可通过向目标 FTP 服务器发送特制的 DELE 命令触发该漏洞，导致拒绝服务或远程代码执行。该漏洞影响 Titan FTP Server 6.05 build 550 及之前版本，攻击者无需认证即可利用，危害等级高危。","severity":"MEDIUM","score":5.0,"aliases":["CVE-2008-5281"],"sources":["nuclei"],"published":"2008-11-29T00:00:00Z","updated":"2008-11-29T00:00:00Z","remediation":"立即升级 Titan FTP Server 至最新版本（该漏洞已在 6.05 build 550 之后的版本修复）；由于旧版 Titan FTP Server 已停止维护，建议迁移至 Titan MFT 或 Titan SFTP Server。如无法升级，在防火墙层面限制 FTP 端口（默认 21）的可信源 IP 白名单，并在服务器上禁用 DELE 命令或限制其执行权限作为临时缓解措施。","status":"completed","collected_at":"2026-07-15T00:00:00Z","references":["https://www.exploit-db.com/exploits/31105","https://github.com/projectdiscovery/nuclei-templates/blob/main/network/cves/2008/CVE-2008-52
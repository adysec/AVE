cloud/core/l10n/cy_GB.php","https://github.com/kees/ubuntu-cve-tracker/blob/66a43c37da527bc16621fb5548dca8aa1f46e537/retired/CVE-2006-7243","https://github.com/ichristo/owncloud-openshift-quickstart/blob/68df5de3a816ddac0ddf4c42699f784f70b61840/php/core/setup.php","https://github.com/xqcyberscore/nvt/blob/978f6a9acb495d7d669239530ffe6da5d631f4da/2011/freebsd_php59.nasl"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":[],"repo_exp_urls":[],"has_poc":false,"has_exp":false,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/2006/AVE-2006-0014.toml"},{"ave_id":"AVE-2006-0005","file_name":"2006/AVE-2006-0005.toml","cve_id":"CVE-2006-6565","title":"FileZilla Server 通配符参数 NULL 指针解引用拒绝服务漏洞","description":"FileZilla Server 0.9.22 之前版本在处理 LIST 和 NLST 命令的通配符参数时存在空指针解引用漏洞。远程未经认证的攻击者可通过向 FTP 服务端发送特制的包含通配符参数的 LIST 或 NLST 命令，触发空指针解引用导致服务崩溃，造成拒绝服务。该漏洞影响 FileZilla Server 0.9.21 及更早版本，CVSS 评分 4.0，危害等级中危。用户需升级至 0.9.22 或更高版本修复此漏洞。","severity":"MEDIUM","score":4.0,"aliases":["CVE-2006-6565"],"sources":["nuclei"],"published":"2006-12-15T11:28:00Z","updated":"2026-06-16T22:33:22Z","remediation":"升级 FileZilla Server 至 0.9.22 及以上版本，该版本已修复 LIST/NLST 命令通配符参数导致的空指针解引用问题。若无法立即升级，可在防火墙或 IPS 中过滤包含通配符的 FTP LIST/NLST 命令，或限制仅信任 IP 访问 FTP 服务作为临时缓解措施。","status":"completed","collected_at":"2026-07-15T00:00:00Z","references":["http://sourceforge.net/project/shownotes.php?release_id=470364&group_id=21558","http://www.vupen.com/english/advisories/2006/4937","https://exchange.xforce.ibmcloud.com/vulnerabilities/30853","https://www.exploit-db.com/exploits/2914","https://github.com/projectdiscovery/nuclei-templates/blob/main/network/cves/2006/CVE-2006-6565.yaml","https://github.com/trickest/cve/blob/a90de4f84b4783951362f491671e1e9decfc17cb/2006/CVE-2006-6565.md","https://github.com/projectdiscovery/nuclei-templates/blob/69a5a3cf926251a00061ec14d208b227367df73d/network/cves/2006/CVE-2006-6565.yaml","https://github.com/CVEProject/cvelistV5/blob/8aea42c71147e21c6d32b71ffce877107de995c6/cves/2006/6xxx/CVE-2006-6565.json","https://github.com/LiuCan01/cve-list-pro/blob/78b55511cee3604c22d518e32822f0435d0cacc0/cve-list/CVE-2006/CVE-2006-6565","https://github.com/adampielak/nuclei-templates/blob/ac9605f5a915670fd80cb4e1904f4435f1835b65/nuclei-v3/C/CVE-2006-6565_3.yaml","https://github.com/youki992/VscanPlus/blob/714a0e276a538a22c1a6215c71458a8b59a920ef/pocs_yml/nucleiFiles/network/cves/2006/CVE-2006-6565.yaml","https://github.com/mabitoski/cve_submodules/blob/44ad7e2705b3aef1b2ffaf64bd47596c10a6c2e4/2006/CVE-2006-6565.md","https://github.com/github/advisory-database/blob/179c45b9fa0538b72b0d380b72ed3445aca781eb/advisories/unreviewed/2022/05/GHSA-42fr-8xjf-ghxh/GHSA-42fr-8xjf-ghxh.json","https://github.com/nottrobin/ubuntu-cve-tracker/blob/36e411296b5707284049ec2e0db8d2622feca498/old/cve-ignore.txt","https://github.com/CyberSecAI/cve_info/blob/03b7e36424574a3a9ba5fd13480a326b666a1046/2006/6xxx/CVE-2006-6565.json"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":[],"repo_exp_urls":[],"has_poc":false,"has_exp":false,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/2006/AVE-2006-0005.toml"},{"ave_id":"AVE-2006-0011","file_name":"2006/AVE-2006-0011.toml","cve_id":"CVE-2006-4339","title":"OpenSSL RSA PKCS#1 v1.5 签名伪造漏洞","description":"OpenSSL 在处理 RSA 密钥指数为 3 的签名验证时存在密码学漏洞。在生成哈希之前，OpenSSL 会移除 PKCS-1 填充数据，导致远程攻击者能够利用该 RSA 密钥伪造 PKCS #1 v1.5 签名，从而绕过 X.509 及其他使用 PKCS #1 格式证书的签名验证机制。该漏洞影响 OpenSSL 0.9.7 之前版本、0.9.7 至 0.9.7k 之前版本以及 0.9.8 至 0.9.8c 之前版本，攻击者无需身份认证即可通过网络远程利用，CVSS 评分 4.3，危害等级中危。","severity":"MEDIUM","score":4.3,"aliases":["CVE-2006-4339"],"sources":["tenable"],"published":"2006-09-05T17:04:00Z","updated":"2026-06-16T22:28:53Z","remediation":"升级 OpenSSL 至 0.9.7k、0.9.8c 或更高版本。对于无法立即升级的系统，可配置禁用 RSA 密钥指数为 3 的证书使用，或在应用层增加 PKCS#1 v1.5 签名验证的额外检查。各发行版用户应安装对应安全更新包（如 Red Hat 的 openssl 更新、Debian 的 openssl 补丁）。","status":"completed","collected_at":"2026-07-23T00:00:00Z","references":["http://dev2dev.bea.com/pub/advisory/238","http://docs.info.apple.com/article.html?artnum=304829","http
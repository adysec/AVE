ki/cve_submodules/blob/44ad7e2705b3aef1b2ffaf64bd47596c10a6c2e4/2011/CVE-2011-0618.md","https://github.com/Patrowl/PatrowlHearsData/blob/9fb6bc21273092ff8b91677561ee0f67b063fcda/CVE/data/2011/CVE-2011-0618.json","https://github.com/xqcyberscore/nvt/blob/978f6a9acb495d7d669239530ffe6da5d631f4da/2011/gb_suse_2011_025.nasl","https://github.com/illuusio/freebsd-osv/blob/3234f9e67d0170ff9c6cada9a1f48f061b109728/md/2011/FreeBSD-2011-0073.md","https://github.com/tumblr1978/SecurityDataUsage/blob/fbec2cf82c02c3a21131dc1c1bc5d2c453e004c4/papersTotalTXT/07163055.txt","https://github.com/gentoo-mirror/gentoo/blob/7d04ccc3de4c5bc2dbadcafc9de89eedd5cbcb2b/metadata/glsa/glsa-201110-11.xml"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":[],"repo_exp_urls":[],"has_poc":false,"has_exp":false,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/2011/AVE-2011-0046.toml"},{"ave_id":"AVE-2011-0073","file_name":"2011/AVE-2011-0073.toml","cve_id":"CVE-2011-1854","title":"HP Intelligent Management Center 释放后使用远程代码执行漏洞","description":"HP Intelligent Management Center（IMC）5.0 E0101L02之前版本中的imcsyslogdm.exe组件存在释放后使用（Use-After-Free）漏洞。远程攻击者可通过向目标系统发送特制的超长syslog数据包触发该漏洞，导致已释放的内存被重新访问，从而执行任意代码。该漏洞与异常处理机制相关，CVSS评分10.0，危害等级严重，攻击无需身份认证，影响范围广泛。HP已发布安全更新修复此漏洞。","severity":"CRITICAL","score":10.0,"aliases":["CVE-2011-1854"],"sources":["tenable"],"published":"2011-05-13T17:05:45Z","updated":"2026-06-16T23:30:14Z","remediation":"立即升级 HP Intelligent Management Center 至 5.0 E0101L02 及以上版本。该补丁可通过 HP 官方支持文档 c02822750 获取。如无法立即升级，建议在防火墙层面限制对 UDP 514 端口的非授权访问作为临时缓解措施。","status":"completed","collected_at":"2026-07-28T00:00:00Z","references":["http://h20000.www2.hp.com/bizsupport/TechSupport/Document.jsp?objectID=c02822750","http://securitytracker.com/id?1025519","http://www.securityfocus.com/bid/47789","http://www.zerodayinitiative.com/advisories/ZDI-11-166/","https://github.com/trickest/cve/blob/be44b05b9428dc18bc0705cf60dd8d8640cd49b1/2011/CVE-2011-1854.md","https://github.com/CVEProject/cvelistV5/blob/93bf7691fc17bf58197ad166ee362b4808566d7c/cves/2011/1xxx/CVE-2011-1854.json","https://github.com/Patrowl/PatrowlHearsData/blob/d2f32d8750bd50219425137a8fc56ab841cc707b/CVE/data/2011/CVE-2011-1854.json","https://github.com/LiuCan01/cve-list-pro/blob/78b55511cee3604c22d518e32822f0435d0cacc0/cve-list/CVE-2011/CVE-2011-1854","https://github.com/mabitoski/cve_submodules/blob/44ad7e2705b3aef1b2ffaf64bd47596c10a6c2e4/2011/CVE-2011-1854.md","https://github.com/nomi-sec/NVD-Database/blob/23dc120c34402aaa65883c51c1d03b3cb02c20cb/2011/CVE-2011-1854.json","https://github.com/olbat/nvdcve/blob/add906b6a8ba20fd533c6fdd7f023c73e6090f3a/nvdcve/CVE-2011-1854.json","https://github.com/opencve/opencve-kb/blob/0ccbe74701d72e8d7117a09b2db369605fa0bae6/2011/CVE-2011-1854.json","https://github.com/fkie-cad/nvd-json-data-feeds/blob/3e38e95f2e1dd1607b843a3c921eb524d7c4f47f/CVE-2011/CVE-2011-18xx/CVE-2011-1854.json","https://github.com/CyberSecAI/cve_info/blob/03b7e36424574a3a9ba5fd13480a326b666a1046/2011/1xxx/CVE-2011-1854.json"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":["https://raw.githubusercontent.com/adysec/AVE/main/pocs/2011/POC-AVE-2011-0073.toml"],"repo_exp_urls":[],"has_poc":true,"has_exp":false,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/2011/AVE-2011-0073.toml"},{"ave_id":"AVE-2011-0072","file_name":"2011/AVE-2011-0072.toml","cve_id":"CVE-2011-1853","title":"HP Intelligent Management Center 5.0 tftpserver.exe 输入验证漏洞","description":"HP Intelligent Management Center（IMC）5.0 E0101L02之前版本的tftpserver.exe组件中存在输入验证漏洞。该漏洞源于程序在处理特制TFTP请求时，未对操作码（opcode）字段进行充分的边界检查，导致攻击者可通过发送包含超大或无效操作码字段的恶意TFTP数据包，触发函数指针表越界访问，进而覆盖内存中的函数指针。远程未经身份认证的攻击者利用此漏洞可向目标服务器发送精心构造的TFTP请求，实现任意代码执行，完全控制受影响系统。该漏洞CVSS评分10.0，危害等级为严重，影响HP IMC 5.0及更早版本。","severity":"CRITICAL","score":10.0,"aliases":["CVE-2011-1853"],"sources":["tenable"],"published":"2011-05-13T17:05:45Z","updated":"2026-06-16T23:30:14Z","remediation":"立即升级 HP Intelligent Management Center 至 5.0 E0101L02 或更高版本。如无法立即升级，在防火墙上限制对 TFTP 服务端口（默认 UDP 69）的访问，仅允许可信 IP 连接，并监控异常 TFTP 流量。","status":"completed","collected_at":"2026-07-28T00:00:00Z","references":["http://h20000.www2.hp.com/bizsupport/TechSupport/Document.jsp?objectID=c02822750","http://securitytracker.com/id?1025519","http://www.securityfocus.com/bid/47789","http://www.zerodayinitiative.com/advisories/ZDI-11-165/","https://github.com/CVEProject/cvelistV5/blob/93bf7691fc17bf58197ad166ee362b4808566d7c/cves/2011/1xxx/CVE-2011-1853.json","https://github.com/Patrowl/PatrowlHearsData/blob/d2f32d8750bd50219425137a8fc56ab841cc707b/CVE/data/2011/CVE-2011-1853.json","https://github.com/LiuCan01/cve-list-pro/blob/78b55511cee3604c22d518e32822f0435d0cacc0/cve-list/CVE-2011/CVE-2011-1853","https://github.com/nomi-sec/NVD-Database/blob/23dc120c34402aaa65883c51c1d03b3cb02c20cb/2011/CVE-2011-1853.json","https://github.com/olbat/nvdcve/blob/add906b6a8ba20fd533c6fdd7f023c73e6090f3a/nvdcve/CVE-2011-1853.json","https://github.com/opencve/opencve-kb/blob/0ccbe74701d72e8d7117a09b2db369605fa0bae6/2011/CVE-2011-1853.json","https://github.com/fkie-cad/nvd-json-data-feeds/blob/3e38e95f2e1dd1607b843a3c921eb524d7c4f47f/CVE-2011/CVE-2011-18xx/CVE-2011-1853.json","https://github.com/CyberSecAI/cve_info/blob/03b7e36424574a3a9ba5fd13480a326b666a1046/2011/1xxx/CVE-2011-1853.json","https://github.com/yarencheng/cve-devops-playground/blob/c54e59752dddfc9aa36c13774164384cfa0d1f04/content/CVE-2011-1853.md","https://github.com/CVEProject/cvelist-dev/blob/5b8fbb570438e8094550205589cc6f1d122acc94/2011/1xxx/CVE-2011-1853.json"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":[],"repo_exp_urls":[],"has_poc":false,"has_exp":false,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/2011/AVE-2011-0072.toml"}]
.md","https://github.com/CVEProject/cvelistV5/blob/4603507d019be3585b2e7bcddcb6c6f57901b490/cves/2000/0xxx/CVE-2000-0065.json","https://github.com/sari3l/Poc-Monitor/blob/919d6cac5eadae13826d4a35bab84cf2bac57965/2000/CVE-2000-0065.json","https://github.com/CVEDB/Poc-Git/blob/0275aeb329b0747c9a1d46160c921eae06095557/2000/CVE-2000-0065.md","https://github.com/Patrowl/PatrowlHearsData/blob/cae595683b6fe65324ec717750e7cdca928c1db7/CVE/data/2000/CVE-2000-0065.json","https://github.com/nomi-sec/NVD-Database/blob/23dc120c34402aaa65883c51c1d03b3cb02c20cb/2000/CVE-2000-0065.json","https://github.com/LiuCan01/cve-list-pro/blob/78b55511cee3604c22d518e32822f0435d0cacc0/cve-list/CVE-2000/CVE-2000-0065","https://github.com/olbat/nvdcve/blob/1c14ae4816efb67123e0664d061a6cbfe48f234b/nvdcve/CVE-2000-0065.json","https://github.com/fkie-cad/nvd-json-data-feeds/blob/ab6b488131358b6f1b1d294b0e28bfaa0021111d/CVE-2000/CVE-2000-00xx/CVE-2000-0065.json","https://github.com/mabitoski/cve_submodules/blob/44ad7e2705b3aef1b2ffaf64bd47596c10a6c2e4/2000/CVE-2000-0065.md"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":["https://raw.githubusercontent.com/adysec/AVE/main/pocs/2000/POC-AVE-2000-0206.toml"],"repo_exp_urls":["https://raw.githubusercontent.com/adysec/AVE/main/exploits/2000/EXP-AVE-2000-0206.toml"],"has_poc":true,"has_exp":true,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/2000/AVE-2000-0206.toml"},{"ave_id":"AVE-2000-0075","file_name":"2000/AVE-2000-0075.toml","cve_id":"CVE-2000-0090","title":"VMWare 1.1.2 本地符号链接攻击拒绝服务漏洞","description":"VMware Workstation 1.1.2 存在符号链接攻击漏洞，本地攻击者可通过创建恶意的符号链接文件诱导系统错误操作，导致目标服务崩溃或资源耗尽，造成拒绝服务。该漏洞影响 VMware Workstation 1.1.2 版本，CVSS 评分 3.6，危害等级低，攻击者需要本地系统访问权限方可利用。","severity":"LOW","score":3.6,"aliases":["CVE-2000-0090"],"sources":["avd"],"published":"2000-01-17T05:00:00.000","updated":"2026-06-16T21:50:58.780","remediation":"建议升级至 VMware 2.0 或更高版本，该版本修复了本地符号链接攻击导致的拒绝服务问题。如无法升级，通过修改 /tmp 目录权限为 1777（chmod 1777 /tmp）并限制不可信用户的本地访问权限可缓解风险。同时在 VMware 配置文件中禁用默认共享目录功能。","status":"completed","collected_at":"2026-07-21T00:00:00Z","references":["http://www.osvdb.org/1205","http://www.securityfocus.com/bid/943","https://github.com/CVEProject/cvelistV5/blob/7f33768789fe75b3288b56f0d11b0df1d5f4a5d4/cves/2000/0xxx/CVE-2000-0090.json","https://github.com/LiuCan01/cve-list-pro/blob/78b55511cee3604c22d518e32822f0435d0cacc0/cve-list/CVE-2000/CVE-2000-0090","https://github.com/yarencheng/cve-devops-playground/blob/7f1c35ad28226319c149c937b6a2e7a1986924ce/content/CVE-2000-0090.md","https://github.com/Patrowl/PatrowlHearsData/blob/d67487551d3c04e5942b9b8e11c25937ecfba21c/CVE/data/2000/CVE-2000-0090.json","https://github.com/github/advisory-database/blob/f5292a7ad2431699c03050ab1a8e2e3a6e103d9a/advisories/unreviewed/2022/04/GHSA-mm2j-wr48-jg44/GHSA-mm2j-wr48-jg44.json","https://github.com/nomi-sec/NVD-Database/blob/bc3b224aa865bb4a5c31d7720dca83e446e475e2/2000/CVE-2000-0090.json","https://github.com/KTZgraph/sarenka/blob/f1fb931ab722d6c096d581ed6e3c5966d799fbaa/sarenka/feeds/cve_details/cve_all_details_152100_152200.json","https://github.com/oasis-open/cti-stix-common-objects/blob/55ba7598cbd5a52577b6887871505d931d85cb61/objects/vulnerability/vulnerability--441358cc-305c-4e53-a6a5-516a9134a5ce.json","https://github.com/PhDLeToanThang/automation/blob/adfd86bec93723d62a00753465d38605c810aba2/vcf9/CVE_NIST.md","https://github.com/hungryfoolou/Vulnerability_Mining/blob/3df1d8ed0489ae1228f975ae1f58a690aae53886/craw/cveid_craw/cveid_craw/data/cveid_by_kind/cveid_dos.txt"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":[],"repo_exp_urls":[],"has_poc":false,"has_exp":false,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/2000/AVE-2000-0075.toml"},{"ave_id":"AVE-2000-0059","file_name":"2000/AVE-2000-0059.toml","cve_id":"CVE-2000-0072","title":"Visual Casel Vcasel 本地文件信任漏洞","description":"Visual Casel（Vcasel）存在文件名信任漏洞，由于程序未能正确验证用户执行文件时的路径，本地攻击者可通过使用相对路径名指定一个具有合法名称的替代文件，从而绕过安全限制执行未授权操作，可能导致权限提升。该漏洞影响 Vcasel 相关版本，攻击者需具有本地系统访问权限，CVSS 评分 4.6，危害等级中危。","severity":"MEDIUM","score":4.6,"aliases":["CVE-2000-0072"],"sources":["avd"],"published":"2000-01-17T05:00:00.000","updated":"2026-06-16T21:50:56.550","remediation":"VCasel 3.0 厂商已停止维护，无官方补丁。建议立即停用 VCasel，迁移至 Windows 组策略或 Intune MDM 等现代方案替代。若无法立即停用，管理员须在 VCasel 策略中为所有允许执行的程序配置完整绝对路径（如 C:\\Windows\\System32\\write.exe 而非 write.exe），同时限制用户对本地及网络驱动器目录的写入权限，并部署文件完整性监控（如 Windows Defender 应用程序控制）检测异常重命名可执行文件。","status":"completed","collected_at":"2026-07-21T00:00:00Z","references":["http://marc.info/?l=bugtraq&m=94823061421676&w=2","http://www.iss.net/security_center/static/3867.php","http://www.securityfocus.com/bid/937","https://github.com/CVEProject/cvelistV5/blob/4382b0b8593e7ef30616ab300314afbbf1571636/cves/2000/0xxx/CVE-2000-0072.json","https://github.com/LiuCan01/cve-list-pro/blob/78b55511cee3604c22d518e32822f0435d0cacc0/cve-list/CVE-2000/CVE-2000-0072","https://github.com/yarencheng/cve-devops-playground/blob/7f1c35ad28226319c149c937b6a2e7a1986924ce/content/CVE-2000-0072.md","https://github.com/Patrowl/PatrowlHearsData/blob/1d32b25dbea4bacedc1131a8702fa8adcc181eee/CVE/data/2000/CVE-2000-0072.json","https://github.com/github/advisory-database/blob/29756569ae7c866e39492d6faf2dcdff310590f7/advisories/unreviewed/2022/04/GHSA-wr39-8xpr-5jmm/GHSA-wr39-8xpr-5jmm.json","https://github.com/intSpLoiT/intframework/blob/eabaa799d0260aa52b735fa9769266d1ce4b64ef/modules/cve_list.txt","https://github.com/olbat/nvdcve/blob/1c14ae4816efb67123e0664d061a6cbfe48f234b/nvdcve/CVE-2000-0072.json","https://github.com/KTZgraph/sarenka/blob/f1fb931ab722d6c096d581ed6e3c5966d799fbaa/sarenka/feeds/cve_details/cve_all_details_152100_152200.json","https://github.com/leego972/titanai/blob/afa5b2310463aae5781d3fd9408071bf38e79806/data/raw/corpus_D_cyber/nvd_cve_001104.txt","https://github.com/oasis-open/cti-stix-common-objects/blob/55ba7598cbd5a52577b6887871505d931d85cb61/objects/vulnerability/vulnerability--643ced0f-08a7-45e2-8f01-e862dd318555.json"],"poc_urls":[],"exp_urls":[],"repo_po
-03T00:00:00Z","references":["http://lists.apple.com/archives/security-announce/2012/Mar/msg00000.html","http://lists.apple.com/archives/security-announce/2012/Mar/msg00001.html","http://lists.apple.com/archives/security-announce/2012/Mar/msg00003.html","http://secunia.com/advisories/48274","http://secunia.com/advisories/48288","http://secunia.com/advisories/48377","http://www.securityfocus.com/bid/52365","http://www.securitytracker.com/id?1026774","https://oval.cisecurity.org/repository/search/definition/oval%3Aorg.mitre.oval%3Adef%3A17319","https://github.com/CVEProject/cvelistV5/blob/1cc9b895b10fb3dcc8a308563cbbcfad083cd221/cves/2012/0xxx/CVE-2012-0624.json","https://github.com/LiuCan01/cve-list-pro/blob/78b55511cee3604c22d518e32822f0435d0cacc0/cve-list/CVE-2012/CVE-2012-0624","https://github.com/Patrowl/PatrowlHearsData/blob/5828423617831cae14862aac31158752df709f44/CVE/data/2012/CVE-2012-0624.json","https://github.com/nomi-sec/NVD-Database/blob/23dc120c34402aaa65883c51c1d03b3cb02c20cb/2012/CVE-2012-0624.json","https://github.com/opencve/opencve-kb/blob/74a5eea2f8e7bbf8745be52f073af8f9cdbbb080/2012/CVE-2012-0624.json","https://github.com/olbat/nvdcve/blob/fe7f195231342e1e88104679c53c965e9a67ac35/nvdcve/CVE-2012-0624.json","https://github.com/CyberSecAI/cve_info/blob/03b7e36424574a3a9ba5fd13480a326b666a1046/2012/0xxx/CVE-2012-0624.json","https://github.com/fkie-cad/nvd-json-data-feeds/blob/7c13974e8672408967145db42c357210cb59d951/CVE-2012/CVE-2012-06xx/CVE-2012-0624.json","https://github.com/CVEProject/cvelist-dev/blob/5b8fbb570438e8094550205589cc6f1d122acc94/2012/0xxx/CVE-2012-0624.json","https://github.com/tholian-network/vulnerabilities/blob/cd8798a37e6d58633681c9596bee14e4189ad0e9/database/vulnerability/CVE-2012-0624.json"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":[],"repo_exp_urls":[],"has_poc":false,"has_exp":false,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/2012/AVE-2012-0114.toml"},{"ave_id":"AVE-2012-0113","file_name":"2012/AVE-2012-0113.t
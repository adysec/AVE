20845","https://github.com/CVEProject/cvelistV5/blob/f02fdda2bd389f5492ddcbf2ad808b3b60f20645/cves/2001/0xxx/CVE-2001-0646.json","https://github.com/LiuCan01/cve-list-pro/blob/78b55511cee3604c22d518e32822f0435d0cacc0/cve-list/CVE-2001/CVE-2001-0646","https://github.com/yarencheng/cve-devops-playground/blob/4731f60845c8f35e2bdb03d333a9e9d84c7b1c27/content/CVE-2001-0646.md","https://github.com/Patrowl/PatrowlHearsData/blob/45906bb48c7a525a11d1008ce22e1e5c2f2f58c2/CVE/data/2001/CVE-2001-0646.json","https://github.com/github/advisory-database/blob/24f07005949aaf2eb169012a6779e6dffdc5a952/advisories/unreviewed/2022/04/GHSA-3fr2-x8c2-c8pr/GHSA-3fr2-x8c2-c8pr.json","https://github.com/intSpLoiT/intframework/blob/eabaa799d0260aa52b735fa9769266d1ce4b64ef/modules/cve_list.txt","https://github.com/KTZgraph/sarenka/blob/f1fb931ab722d6c096d581ed6e3c5966d799fbaa/sarenka/feeds/cve_details/cve_all_details_151500_151600.json","https://github.com/oasis-open/cti-stix-common-objects/blob/55ba7598cbd5a52577b6887871505d931d85cb61/objects/vulnerability/vulnerability--fda68432-46c3-4e36-95ef-c8a5fe063adf.json","https://github.com/olbat/nvdcve/blob/a036095fb2c093f3863681adc5999690c37b930e/nvdcve/CVE-2001-0646.json","https://github.com/hungryfoolou/Vulnerability_Mining/blob/3df1d8ed0489ae1228f975ae1f58a690aae53886/craw/cveid_craw/cveid_craw/data/cveid_by_kind/cveid_dos.txt"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":[],"repo_exp_urls":[],"has_poc":false,"has_exp":false,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/2001/AVE-2001-0274.toml"},{"ave_id":"AVE-2001-0486","file_name":"2001/AVE-2001-0486.toml","cve_id":"CVE-2001-1353","title":"Artifex Ghostscript 任意文件读写漏洞","description":"Ghostscript 6.51 之前版本中存在安全模式绕过漏洞。当启用 `-dSAFER` 安全限制时，`file` 操作符本应被禁用以防止文件读写，但由于权限检查不完善，本地攻击者可通过构造特制的 PostScript 文件，以 `lp` 用户身份读取或写入系统任意文件。攻击条件要求攻击者拥有本地 shell 访问权限，且目标系统安装了受影响版本的 Ghostscript。该漏洞可导致敏感信息泄露或系统文件被篡改。","severity":"LOW","score":2.6,"aliases":["CVE-2001-1353"],"sources":["redhat"],"published":"2001-09-18T04:00:00Z","updated":"2026-06-16T21:56:06Z","remediation":"升级 Ghostscript 至 6.51 或更高版本，该版本修复了 -dSAFER 模式下 file 操作符绕过沙箱的问题。如无法升级，可在调用 Ghostscript 处理用户输入前，使用系统权限控制（如以非 lp 用户的低权限账户运行）限制文件读写范围，并禁用不必要的 PS 操作符。对于打印服务场景，建议使用 AppArmor/SELinux 策略限制 Ghostscript 进程的文件访问路径。","status":"completed","collected_at":"2026-07-27T00:00:00Z","references":["http://archives.neohapsis.com/archives/hp/2001-q4/0069.html","http://marc.info/?l=lprng&m=100083210910857&w=2","http://rhn.redhat.com/errata/RHSA-2001-112.html","http://www.redhat.com/support/errata/RHSA-2001-138.html","https://github.com/CVEProject/cvelistV5/blob/3ac44cfd6537e05d45dfec0ed67b6d47bebeee2b/cves/2001/1xxx/CVE-2001-1353.json","https://github.com/LiuCan01/cve-list-pro/blob/78b55511cee3604c22d518e32822f0435d0cacc0/cve-list/CVE-2001/CVE-2001-1353","https://github.com/HORKimhab/poc-cve-collection/blob/41644568d1e47f962c2cefae75c8b09359290a26/2001/1xxx/CVE-2001-1353.md","https://github.com/Patrowl/PatrowlHearsData/blob/98f785d4de3da29b2a31131d1ba99ceeb9ee0484/CVE/data/2001/CVE-2001-1353.json","https://github.com/github/advisory-database/blob/1c8e3f4146e1bef501493d1237acb1611ea8f707/advisories/unreviewed/2022/04/GHSA-8w7m-vfxc-23h7/GHSA-8w7m-vfxc-23h7.json","https://github.com/yarencheng/cve-devops-playground/blob/c54e59752dddfc9aa36c13774164384cfa0d1f04/content/CVE-2001-1353.md","https://github.com/KTZgraph/sarenka/blob/f1fb931ab722d6c096d581ed6e3c5966d799fbaa/sarenka/feeds/cve_details/cve_all_details_151600_151700.json","https://github.com/olbat/nvdcve/blob/add906b6a8ba20fd533c6fdd7f023c73e6090f3a/nvdcve/CVE-2001-1353.json","https://github.com/oasis-open/cti-stix-common-objects/blob/55ba7598cbd5a52577b6887871505d931d85cb61/objects/vulnerability/vulnerability--bb04a7c4-296d-4160-a126-524c98eefcc6.json","https://github.com/nomi-sec/CVE-Easy-List/blob/14bb986e846fe12089d9a0db6d36001bfb343b78/2001.tsv"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":["https://raw.githubusercontent.com/adysec/AVE/main/pocs/2001/POC-AVE-2001-0486.toml"],"repo_exp_urls":[],"has_poc":true,"has_exp":false,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/2001/AVE-2001-0486.toml"},{"ave_id":"AVE-2001-0431","file_name":"2001/AVE-2001-0431.toml","cve_id":"CVE-2001-0986","title":"Microsoft Index Server 2.0 文件信息与完整路径泄露漏洞","description":"Microsoft Index Server 2.0 的 SQLQHit.asp 示例文件存在信息泄露漏洞，远程攻击者无需身份认证即可通过向该文件发送特制的 CiScope 参数（如 webinfo、extended_fileinfo、extended_webinfo 或 fileinfo）直接获取服务器物理路径、文件属性及部分源代码等敏感信息。该漏洞影响 Microsoft Index Server 2.0 版本，攻击复杂度低，仅需构造 HTTP 请求即可利用。","severity":"MEDIUM","score":5.0,"aliases":["CVE-2001-0986"],"sources":["exploitdb"],"published":"2001-09-14T04:00:00Z","updated":"2026-06-16T21:55:21Z","remediation":"删除 IIS 网站目录下的 sqlqhit.asp 示例文件（通常位于 C:\\Inetpub\\wwwroot 或 IIS 脚本映射目录），或通过 IIS 管理器对该文件设置 IP 地址限制和 NTFS 权限拒绝匿名访问。Microsoft Index Server 2.0 已停止支持，建议将服务器升级到受支持的操作系统版本并使用 Windows Search 替代。","status":"completed","collected_at":"2026-07-27T00:00:00Z","references":["http://www.securityfocus.com/archive/1/214217","http://www.securityfocus.com/bid/3339","https://exchange.xforce.ibmcloud.com/vulnerabilities/7125","https://www.exploit-db.com/exploits/21113","https://github.com/CVEProject/cvelistV5/blob/50b2026c1039c6a81b95d80535c772b9d8685178/cves/2001/0xxx/CVE-2001-0986.json","https://github.com/LiuCan01/cve-list-pro/blob/78b55511cee3604c22d518e32822f0435d0cacc0/cve-list/CVE-2001/CVE-2001-0986","https://github.com/HORKimhab/poc-cve-collection/blob/11a92cc3c0d31b9e78fe8f2a857dd04df3195701/2001/0xxx/CVE-2001-0986.md","https://github.com/Patrowl/PatrowlHearsData/blob/050b62cac636d83be07e6d4c77e70114e1ca7c93/CVE/data/2001/CVE-2001-0986.json","https://github.com/swimlane/soc-faker/blob/361c4ae88956878fbd8aaf5975044328556dfecd/socfaker/data/alert_names.txt","https://github.com/github/advisory-database/blob/fa1c2f93b0d15da115c038738e571c1a1553b4cc/advisories/unreviewed/2022/04/GHSA-rwh7-p7fv-r943/GHSA-rwh7-p7fv-r943.json","https://github.com/yarencheng/cve-devops-playground/blob/c54e59752d
_urls":["https://raw.githubusercontent.com/adysec/AVE/main/pocs/2013/POC-AVE-2013-0309.toml"],"repo_exp_urls":["https://raw.githubusercontent.com/adysec/AVE/main/exploits/2013/EXP-AVE-2013-0309.toml"],"has_poc":true,"has_exp":true,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/2013/AVE-2013-0309.toml"},{"ave_id":"AVE-2013-0506","file_name":"2013/AVE-2013-0506.toml","cve_id":"CVE-2013-4810","title":"HP ProCurve Manager JBoss EJBInvokerServlet 反序列化远程代码执行漏洞","description":"JBoss EJBInvokerServlet 和 JMXInvokerServlet 存在反序列化漏洞，远程攻击者无需认证即可通过 HTTP 协议向目标服务器发送特制的序列化 Java 对象，触发反序列化过程导致任意代码执行。该漏洞影响 HP ProCurve Manager 3.20/4.0、PCM+ 3.20/4.0、Identity Driven Manager 4.0 及 Application Lifecycle Management 等产品，CVSS 评分 9.8，危害等级严重。攻击者只需网络可达即可利用，无需用户交互，可完全控制受影响系统。","severity":"CRITICAL","score":9.8,"aliases":["CVE-2013-4810"],"sources":["kev"],"published":"2013-09-16T13:01:46Z","updated":"2026-06-16T23:57:56Z","remediation":"升级 JBoss 至 5.0.2.GA 及以上版本，或移除 EJBInvokerServlet 和 JMXInvokerServlet 的远程访问权限。如无法升级，在部署描述符中禁用 HTTP 协议的 invoker 端点，或使用 JBoss 安全过滤器限制对 /invoker/ 路径的访问。临时缓解措施可在反向代理层屏蔽对 /invoker/EJBInvokerServlet 和 /invoker/JMXInvokerServlet 的请求。","status":"completed","collected_at":"2026-07-23T00:00:00Z","references":["http://h20565.www2.hp.com/portal/site/hpsc/template.PAGE/public/kb/docDisplay/?docId=emr_na-c03897409","http://marc.info/?l=bugtraq&m=138696448823753&w=2","http://marc.info/?l=bugtraq&m=143039425503668&w=2","http://secunia.com/advisories/54788","http://www.securitytracker.com/id/1029010","http://zerodayinitiative.com/advisories/ZDI-13-229/","https://www.exploit-db.com/exploits/28713/","https://www.cisa.gov/known-exploited-vulnerabilities-catalog?field_cve=CVE-2013-4810","https://www.exploit-db.com/exploits/28713","https://github.com/trickest/cve/blob/ed228d55b7972f63e700a35a54fbcd94064b9ade/2013/CVE-2013-4810.md","https://github.com/cisagov/vulnrichment/blob/dee3a736a4e988cc248dc4d7530452b86aa0546e/2013/4xxx/CVE-2013-4810.json","https://github.com/Ares-X/VulWiki/blob/40e0273754a36f49a6be6a77a7a4c210a07063ed/Web%E5%AE%89%E5%85%A8/Jboss/%E5%8F%8D%E5%BA%8F%E5%88%97%E5%8C%96%E6%BC%8F%E6%B4%9E/%EF%BC%88CVE-2013-4810%EF%BC%89JBoss%20EJBInvokerServle%20%E5%8F%8D%E5%BA%8F%E5%88%97%E5%8C%96%E6%BC%8F%E6%B4%9E.md","https://github.com/ARPSyndicate/suricata-vedas/blob/fe24794ad36564b5bbc7c69101525011387b8650/2013/CVE-2013-4810.rules","https://github.com/WyAtu/Perun/blob/c081b9ed0243cecfcea251e72e2905103a6556a1/doc/aboutvuln.md","https://github.com/fankh/vulnerability-poc/blob/ffa50060b7ba6ae58d60d6d90533e77eaf10d466/2013/CVE-2013-4810/README_KO.md","https://github.com/a-dhaou-tekup/VRA/blob/3e4f21c329250c5eca327489d3fd5be9b398ce7b/data/rag_corpus/cisa_kev_notes/CVE-2013-4810.txt","https://github.com/cyberdudebivash/cyberdudebivash-ai-security-hub/blob/13403e1745f63237e7ef6d51562fb36112320d77/frontend/cve/CVE-2013-4810.html","https://github.com/lyxhh/midvulhub/blob/8acf9306fe9769ce1317d72b1c8be2242796a64f/JBoss/EJBInvokerServlet-deserialization(CVE-2013-4810)/README.md","https://github.com/Maskhe/vuls/blob/c89975801d30d01e3c37ab705b4322decdbce5a4/jboss/cve-2013-4810/readme.md"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":["https://raw.githubusercontent.com/adysec/AVE/main/pocs/2013/POC-AVE-2013-0506.toml"],"repo_exp_urls":[],"has_poc":true,"has_exp":false,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/2013/AVE-2013-0506.toml"},{"ave_id":"AVE-2013-0306","file_name":"2013/AVE-2013-0306.toml","cve_id":"CVE-2013-3346","title":"Adobe Acrobat Reader 内存破坏漏洞","description":"Adobe Acrobat Reader 在处理 PDF 文档时存在释放后使用（Use-After-Free）内存破坏漏洞，漏洞位于 ToolButton 组件中。远程攻击者可构造特制的 PDF 文件，通过诱导用户打开该恶意文档触发漏洞，成功利用可在当前用户上下文中执行任意代码，完全控制受影响系统。该漏洞影响 Adobe Reader 和 Acrobat 9.5.5 之前版本、10.1.7 之前版本及 11.0.03 之前版本，无需身份认证且无需用户交互即可触发，CVSS 评分 9.8，危害等级严重。Adobe 已在 2013 年 8 月安全更新中修复此漏洞，且该漏洞已被 CISA 列入已知被利用漏洞目录（KEV）。","severity":"CRITICAL","score":9.8,"aliases":["CVE-2013-3346"],"sources":["kev"],"published":"2013-08-30T20:55:06Z","updated":"2026-06-16T23:54:55Z","remediation":"升级 Adobe Reader/Acrobat 至 9.5.5（9.x 系列）、10.1.7（10.x 系列）或 11.0.03（11.x 系列）及以上版本。如无法立即升级，可在 PDF 阅读器中禁用 JavaScript（编辑→首选项→JavaScript→取消勾选「启用 Acrobat JavaScript」），并启用受保护视图（编辑→首选项→安全性→增强保护→勾选「启用增强保护」）以降低利用风险。","status":"completed","collected_at":"2026-07-22T00:00:00Z","references":["http://www.adobe.com/support/security/bulletins/apsb13-15.html","https://oval.cisecurity.org/repository/search/definition/oval%3Aorg.mitre.oval%3Adef%3A19054","https://github.com/cisagov/vulnrichment/issues/199","https://www.cisa.gov/known-exploited-vulnerabilities-catalog?field_cve=CVE-2013-3346","https://www.exploit-db.com/exploits/30394","https://github.com/trickest/cve/blob/ed228d55b7972f63e700a35a54fbcd94064b9ade/2013/CVE-2013-3346.md","https://github.com/cisagov/vulnrichment/blob/dee3a736a4e988cc248dc4d7530452b86aa0546e/2013/3xxx/CVE-2013-3346.json","https://github.com/LiuCan01/cve-list-pro/blob/78b55511cee3604c22d518e32822f0435d0cacc0/cve-list/CVE-2013/CVE-2013-3346","https://github.com/fankh/vulnerability-poc/blob/ffa50060b7ba6ae58d60d6d90533e77eaf10d466/2013/CVE-2013-3346/README.md","https://github.com/jesparza/peepdf/blob/c74dc65c0ac7e506bae4f2582a2435ec50741f40/CHANGELOG","https://github.com/madneal/articles-translator/blob/a35e805b9840095cbd530cbc7dda322edb3231ed/%E9%9A%90%E5%86%99%E6%9C%AF-%E6%B7%B1%E5%85%A5%E7%A0%94%E7%A9%B6PDF%E6%B7%B7%E6%B7%86%E6%BC%8F%E6%B4%9E.md","https://github.com/e-m-b-a/emba/blob/4d0f24b3edae0bdb5391177851bad3be54ecea0f/config/msf_cve-db.txt","https://github.com/ckane/CS7038-Malware-Analysis/blob/309b8d8ce4d551cb446622dfe5f4889f10413938/_posts/2017-02-05-kali-metasploit.md","https://github.com/a-dhaou-tekup/VRA/blob/3e4f21c329250c5eca327489d3fd5be9b398ce7b/data/rag_corpus/cisa_kev_notes/CVE-2013-3346.txt","https://github.com/Patrowl/PatrowlHearsData/blob/7b14132e5983d4643412f6d4f89beb409b809e9f/CVE/data/2013/CVE-2013-3346.json"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":[],"repo_exp_urls":[],"has_poc":false,"has_exp":false,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/2013/AVE-2013-0306.toml"},{"ave_id":"AVE-2013-0010","file_name":"2013/AVE-2013-0010.toml","cve_id":"CVE-2013-4625","title":"WordPress Duplicator 插件跨站脚本漏洞","description":"Duplicator WordPress 插件 0.4.5 之前版本中的 files/installer.cleanup.php 存在反射型跨站脚本（XSS）漏洞，远程攻击者通过向 package 参数注入恶意 Web 脚本或 HTML 代码，当管理员访问特制链接时脚本将在浏览器中执行，可能导致敏感信息泄露、会话劫持等危害。攻击无需认证，利用复杂度低。该漏洞影响 Duplicator 0.4.2/0.4.3/0.4.4 版本，CVSS 评分 4.3，危害等级中危。用户需升级至 0.4.5 及以上版本修复。","severity":"MEDIUM","score":4.3,"aliases":["CVE-2013-4625"],"sources":["nuclei"],"published":"2013-08-09T21:55:07Z","updated":"2026-06-16T23:57:37Z","remediation":"立即将 WordPress Duplicator 插件升级至 0.4.5 或更高版本。如无法立即升级，可暂时禁用该插件，或通过 Web 应用防火墙（WAF）规则过滤 `package` 参数中的恶意脚本代码作为临时缓解措施。","status":"completed","collected_at":"2026-07-22T00:00:00Z","references":["http://archives.neohapsis.com/archives/bugtraq/2013-07/0161.html","http://osvdb.org/95627","http://packetstormsecurity.com/files/122535/WordPress-Duplicator-0.4.4-Cross-Site-Scripting.html","http://support.lifeinthegrid.com/knowledgebase.php?article=20","http://www.securityfocus.com/bid/61425","https://exchange.xforce.ibmcloud.com/vulnerabilities/85939","https://www.htbridge.com/advisory/HTB23162","https://www.exploit-db.com/exploits/38676","https://github.com/projectdiscovery/nuclei-templates/blob/main/http/cves/2013/CVE-2013-4625.yaml","https://github.com/trickest/cve/blob/ed228d55b7972f63e700a35a54fbcd94064b9ade/2013/CVE-2013-4625.md","https://github.com/projectdiscovery/nuclei-templates/blob/efa56541ba84ae91eb0da267c473426b115491e2/http/cves/2013/CVE-2013-4625.yaml","https://github.com/cckuailong/reapoc/blob/699762e4c31d0183733f64313d8fc3be6470bd37/2013/CVE-2013-4625/poc/pocsploit/CVE-2013-4625.py","https://github.com/lianqingsec/NucleiPocGather/blob/dcce204f62196117b9c95c52d8101ccf7a5d27bc/poc/cve/CVE-2013-4625_6.yaml","https://github.com/exploit-io/nuclei-templates/blob/a4b7182985a6e45df346cfe45242d40455e152b5/templates/cve-2013-4625-2266.yaml","https://github.com/daffainfo/my-nuclei-templates/blob/594182b8a15f94de7466e1b12620e402fef1580f/CVE-2013-4625.yaml","https://github.com/blackye/luscan-devel/blob/1df521fcfb32a9f726c91025f02080292628dfba/plugins/testing/scan/plecost_plugin/plugin_list_500.txt","https://github.com/0xelixer/new/blob/6f6dd4a43a76ce74c1e8cc0558629a2ea198286e/nuclei-temps/cent/template4/z-11753.yaml","https://github.com/adampielak/nuclei-templates/blob/a2f3ff3fa5db5c7705ebd942909ec114df063700/nuclei-v3/C/CVE-2013-4625_5.yaml","https://github.com/0xKayala/Custom-Nuclei-Templates/blob/1940dfd29577590f076c89dec5c30d809d68f210/6001-to-7000-templates/cve-2013-4625-2268.yaml"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":[],"repo_exp_urls":[],"has_poc":false,"has_exp":false,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/2013/AVE-2013-0010.toml"},{"ave_id":"AVE-2013-0004","file_name":"2013/AVE-2013-0004.toml","cve_id":"CVE-2013-2251","title":"Apache Struts2 远程命令执行漏洞（S2-016）","description":"Apache Struts2 存在OGNL表达式注入漏洞（S2-016），远程攻击者无需身份认证即可通过向HTTP请求中构造带有action:、redirect:或redirectAction:前缀的恶意参数，触发Struts2框架对参数值进行OGNL表达式解析，从而在目标服务器上执行任意系统命令。该漏洞影响Struts2 2.0.0至2.3.15版本，CVSS评分9.8，危害等级严重，攻击复杂度低，可导致服务器完全沦陷。","severity":"CRITICAL","score":9.8,"aliases":["CVE-2013-2251"],"sources":["kev"],"published":"2013-07-20T03:37:30Z","updated":"2026-06-16T23:53:01Z","remediation":"立即升级 Apache Struts 至 2.3.15.1 或更高版本，该版本已修复 DefaultActionMapper 对 action:/redirect:/redirectAction: 前缀参数处理不当导致的 OGNL 表达式注入问题。如无法升级，可部署 WAF 规则拦截包含 action:、redirect:、redirectAction: 前缀的请求参数作为临时缓解措施。","status":"completed","collected_at":"2026-07-22T00:00:00Z","references":["http://archiva.apache.org/security.html","http://cxsecurity.com/issue/WLB-2014010087","http://osvdb.org/98445","http://packetstormsecurity.com/files/159629/Apache-Struts-2-Remote-Code-Execution.html","http://seclists.org/fulldisclosure/2013/Oct/96","http://seclists.org/oss-sec/2014/q1/89","http://struts.apache.org/release/2.3.x/docs/s2-016.html","http://tools.cisco.com/security/center/content/CiscoSecurityAdvisory/cisco-sa-20131023-struts2","http://www.fujitsu.com/global/support/software/security/products-f/interstage-bpm-analytics-201301e.html","http://www.oracle.com/technetwork/topics/security/cpujan2014-1972949.html","http://www.oracle.com/technetwork/topics/security/cpujul2015-2367936.html","http://www.securityfocus.com/bid/61189","http://www.securityfocus.com/bid/64758","http://www.securitytracker.com/id/1029184","http://www.securitytracker.com/id/1032916","https://exchange.xforce.ibmcloud.com/vulnerabilities/90392","https://www.cisa.gov/known-exploited-vulnerabilities-catalog?field_cve=CVE-2013-2251","https://www.exploit-db.com/exploits/44583","https://github.com/projectdiscovery/nuclei-templates/blob/main/http/cves/2013/CVE-2013-2251.yaml","https://github.com/trickest/cve/blob/ed228d55b7972f63e700a35a54fbcd94064b9ade/2013/CVE-2013-2251.md","https://github.com/nomi-sec/PoC-in-GitHub/blob/3c5116308718006831f8b0ac674f891f3d553471/2013/CVE-2013-2251.json","https://github.com/cckuailong/reapoc/blob/699762e4c31d0183733f64313d8fc3be6470bd37/2013/CVE-2013-2251/poc/pocsploit/CVE-2013-2251.py","https://github.com/Threekiii/Awesome-POC/blob/0f9e22b660cb1ea12c1c3668f9128d93e08da412/%E4%B8%AD%E9%97%B4%E4%BB%B6%E6%BC%8F%E6%B4%9E/Apache%20Struts2%20S2-016%20%E8%BF%9C%E7%A8%8B%E4%BB%A3%E7%A0%81%E6%89%A7%E8%A1%8C%E6%BC%8F%E6%B4%9E%20CVE-2013-2251.md","https://github.com/gobysec/GobyVuls/blob/a5de8e3be10d51a94e0977ecd8086c176251229f/Struts2/S2-016(CVE-2013-2251)/README.md","https://github.com/Ostorlab/KEV/blob/8feadeb8b7ff54359eab87941769781629146b23/nuclei/CVE-2013-2251.yaml","https://github.com/nosafer/nosafer.github.io/blob/1b07659147a7781a61e0b950684ad8d7739fadbd/docs/Web%E5%AE%89%E5%85%A8/Apache%20Struts/%EF%BC%88CVE-2013-2251%EF%BC%89s2-016.md","https://github.com/LiuCan01/cve-list-pro/blob/78b55511cee3604c22d518e32822f0435d0cacc0/cve-list/CVE-2013/CVE-2013-2251","https://github.com/linuxadi/40k-nuclei-templates/blob/542be6820c801c02a33aee60f1c05ca7b0b5005f/aditya/folder4/cve-2013-2251-8.yaml","https://github.com/eyalmazuz/ThreatIntelligenceCorpus/blob/c47f9d2b7ba92e0cbba71c67b938a49e055c5cdc/Corpus/opensecurityresearch_attacking-struts-with-cve-2013-2251.html.txt","https://github.com/nth347/CVE-2013-2251"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":[],"repo_exp_urls":[],"has_poc":false,"has_exp":false,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/2013/AVE-2013-0004.toml"},{"ave_id":"AVE-2013-0003","file_name":"2013/AVE-2013-0003.toml","cve_id":"CVE-2013-2248","title":"Apache Struts 2 开放重定向漏洞","description":"Apache Struts 2 的 DefaultActionMapper 存在输入验证漏洞，远程攻击者可通过在参数中使用 redirect: 或 redirectAction: 前缀构造恶意 URL，将用户重定向到任意外部网站，从而实施钓鱼攻击。该漏洞影响 Apache Struts 2.0.0 至 2.3.15 版本，攻击者无需身份认证即可利用，危害中等。建议升级至 Apache Struts 2.3.16 及以上版本修复此漏洞。","severity":"MEDIUM","score":5.8,"aliases":["CVE-2013-2248"],"sources":["nuclei"],"published":"2013-07-20T03:37:30Z","updated":"2026-06-16T23:53:01Z","remediation":"升级 Apache Struts 至 2.3.15.1 或更高版本，该版本已修复 DefaultActionMapper 对 redirect:/redirectAction: 前缀的输入验证缺陷。如无法立即升级，可在 struts.xml 中禁用动态方法调用（<constant name=\"struts.enable.DynamicMethodInvocation\" value=\"false\" />）并限制 action: 前缀的使用。","status":"completed","collected_at":"2026-07-22T00:00:00Z","references":["http://struts.apache.org/release/2.3.x/docs/s2-017.html","http://www.fujitsu.com/global/support/software/security/products-f/interstage-bpm-analytics-201301e.html","http://www.oracle.com/technetwork/topics/security/cpujan2014-1972949.html","http://www.oracle.com/technetwork/topics/security/cpuoct2013-1899837.html","http://www.securityfocus.com/bid/61196","http://www.securityfocus.com/bid/64758","https://www.exploit-db.com/exploits/38666","https://github.com/projectdiscovery/nuclei-templates/blob/main/http/cves/2013/CVE-2013-2248.yaml","https://github.com/trickest/cve/blob/ed228d55b7972f63e700a35a54fbcd94064b9ade/2013/CVE-2013-2248.md","https://github.com/projectdiscovery/nuclei-templates/blob/efa56541ba84ae91eb0da26
ad851/advisories/unreviewed/2022/04/GHSA-qrgq-23c9-3qrw/GHSA-qrgq-23c9-3qrw.json","https://github.com/blackhook/nessus-plugins/blob/64177d96abbb07c58cf7e131046b067ebc61fcb5/E/ews.nasl","https://github.com/feng-li/tools-for-data-science-course/blob/8e62d47ee8ffbebe9a0e50aee193617f83883118/2019spring/2017312271/result.txt","https://github.com/fkie-cad/nvd-json-data-feeds/blob/1b69cf2313f68e29acceed58f52f6109cd37bb04/CVE-1999/CVE-1999-02xx/CVE-1999-0279.json","https://github.com/intSpLoiT/intframework/blob/eabaa799d0260aa52b735fa9769266d1ce4b64ef/modules/cve_list.txt"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":[],"repo_exp_urls":[],"has_poc":false,"has_exp":false,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/1999/AVE-1999-0465.toml"},{"ave_id":"AVE-1999-0459","file_name":"1999/AVE-1999-0459.toml","cve_id":"CVE-1999-0273","title":"Sun Solaris 2.5.1 Telnet 控制字符拒绝服务漏洞","description":"Sun Solaris 2.5.1 Telnet 服务存在控制字符处理缺陷，远程攻击者无需认证即可通过向目标系统的 telnet 端口发送 ^D（Ctrl+D）控制字符，导致 telnet 守护进程崩溃或进入异常状态，从而造成拒绝服务。该漏洞影响 Sun Solaris 2.5.1 操作系统，攻击利用难度低，无需特殊权限即可触发，属于典型的拒绝服务漏洞。","severity":"MEDIUM","score":5.0,"aliases":["CVE-1999-0273"],"sources":["epss"],"published":"1998-01-01T05:00:00Z","updated":"2026-06-16T21:48:02Z","remediation":"升级至 Oracle Solaris 11 或更高版本，并停止使用 telnet 服务；在 inetd.conf 中注释 telnet 行（或执行 svcadm disable telnet），改用 SSH 作为远程管理协议。若必须运行旧版系统，限制 telnet 服务的源 IP 访问并部署入侵检测规则监控异常 ^D 字符序列。","status":"completed","collected_at":"2026-07-14T00:00:00Z","references":["https://exchange.xforce.ibmcloud.com/vulnerabilities/CVE-1999-0273","https://github.com/CVEProject/cvelistV5/blob/ab669d9fb37e52ed0619cb2b8265d34528fbe875/cves/1999/0xxx/CVE-1999-0273.json","https://github.com/LiuCan01/cve-list-pro/blob/78b55511cee3604c22d518e32822f0435d0cacc0/cve-list/CVE-1999/CVE-1999-0273","https://github.com/aquasecurity/vuln-list-redhat/blob/601a95d57be2a57306cd88389c2251f34b2fbcc1/csaf-vex/1999/cve-1999-0273.json","https://github.com/yarencheng/cve-devops-playground/blob/9074597bd191ef
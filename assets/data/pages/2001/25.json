[{"ave_id":"AVE-2001-0150","file_name":"2001/AVE-2001-0150.toml","cve_id":"CVE-2001-0360","title":"IkonBoard 2.1.7b help.cgi 目录遍历漏洞","description":"IkonBoard 2.1.7b 及更早版本的 help.cgi 脚本存在目录遍历漏洞。远程攻击者无需身份认证，通过在 helpon 参数中注入 ../ 路径穿越序列及 %00 空字节截断，可绕过脚本附加 .dat 后缀的限制，读取服务器上任意文件，导致敏感信息泄露（如 /etc/passwd 及用户密码文件）。","severity":"MEDIUM","score":5.0,"aliases":["CVE-2001-0360"],"sources":["cve","exploitdb"],"published":"2001-06-27T00:00:00Z","updated":"2006-06-16T00:00:00Z","remediation":"IkonBoard 2.1.7b 及更早版本的 help.cgi 脚本未过滤 helpon 参数中的 ../ 路径遍历序列与 %00 空字节。修复方法：编辑 help.cgi，在接收 helpon 参数后过滤掉 ../ 与 %00 等危险字符，并校验最终路径是否在允许访问的目录范围内；同时升级至 IkonBoard 最新版本或迁移至仍受支持的现代论坛系统。","status":"completed","collected_at":"2026-07-22T00:00:00Z","references":["http://archives.neohapsis.com/archives/bugtraq/2001-03/0124.html","http://www.securityfocus.com/bid/2471","https://exchange.xforce.ibmcloud.com/vulnerabilities/6216","https://www.exploit-db.com/exploits/20683"],"poc_urls":["https://www.exploit-db.com/exploits/20683"],"exp_urls":[],"repo_poc_urls":[],"repo_exp_urls":[],"has_poc":false,"has_exp":false,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/2001/AVE-2001-0150.toml"},{"ave_id":"AVE-2001-0367","file_name":"2001/AVE-2001-0367.toml","cve_id":"CVE-2001-1083","title":"Icecast HTTP Server 拒绝服务漏洞","description":"Icecast 1.3.7 及 1.3.11 之前版本在启用 HTTP 文件流支持时存在拒绝服务漏洞。远程攻击者可通过向目标服务器发送以 .（点）、/（正斜杠）或 \\（反斜杠）结尾的特制 URL 请求，触发服务器崩溃，导致服务不可用。该漏洞源于 Icecast 对畸形文件名路径处理不当，无需身份认证即可远程利用，攻击复杂度低。已在 Icecast 1.3.11 版本中修复。","severity":"MEDIUM","score":5.0,"aliases":["CVE-2001-1083"],"sources":["exploitdb"],"published":"2001-06-26T04:00:00Z","updated":"2026-06-16T21:55:33Z","remediation":"升级 Icecast 至 1.3.11 或更高版本，该版本修复了特制 URL 结尾包含 . / \\ 字符导致服务崩溃的拒绝服务漏洞。如无法升级，可在配置中禁用 HTTP 文件流式传输支持（HTTP server file streaming）作为临时缓解措施。","status":"completed","collected_at":"2026-07-27T00:00:00Z","references":["http://www.debian.org/security/2001/dsa-089","http://www.icecast.org/index.html","http://www.icecast.org/releases/icecast-1.3.11.tar.gz","http://www.redhat.com/support/errata/RHSA-2001-105.html","http://www.redhat.com/support/errata/RHSA-2002-063.html","http://www.securityfocus.com/archive/1/193516","http://www.securityfocus.com/bid/2933","https://exchange.xforce.ibmcloud.com/vulnerabilities/6751","https://www.exploit-db.com/exploits/20973","https://github.com/CVEProject/cvelistV5/blob/d426ca16061eaa1a65a39ea953ac0efe02aa4cae/cves/2001/1xxx/CVE-2001-1083.json","https://github.com/LiuCan01/cve-list-pro/blob/78b55511cee3604c22d518e32822f0435d0cacc0/cve-list/CVE-2001/CVE-2001-1083","https://github.com/HORKimhab/poc-cve-collection/blob/291c09f8f1fb3b2fa866c7b93e7660471419cef8/2001/1xxx/CVE-2001-1083.md","https://github.com/Patrowl/PatrowlHearsData/blob/db2f5eda64b048f89c93b57f05c779b62a05c5c9/CVE/data/2001/CVE-2001-1083.json","https://github.com/rhuitl/uClinux/blob/0486e80a025dccbe4a2213715a2ab8a5063ea86b/user/nessus/nessus-plugins/scripts/debian_DSA-089.nasl","https://github.com/github/advisory-database/blob/29919db3f954d9ce9be0e7e3cf177436392d45d3/advisories/unreviewed/2022/05/GHSA-v6ph-92jm-6cmp/GHSA-v6ph-92jm-6cmp.json","https://github.com/freebsd/freebsd-ports/blob/1fe02cc8d199e5e78924336786b7d22c9116b86d/security/vuxml/vuln/2004.xml","https://github.com/yarencheng/cve-devops-playground/blob/c54e59752dddfc9aa36c13774164384cfa0d1f04/content/CVE-2001-1083.md","https://github.com/jdkoftinoff/mb-linux-msli/blob/8adb103e34af9ff1d8d122e9ee2a1808836f0a14/uClinux-dist/user/nessus/nessus-plugins/scripts/icecast_slash_dos.nasl","https://github.com/illuusio/freebsd-osv/blob/3234f9e67d0170ff9c6cada9a1f48f061b109728/md/2004/FreeBSD-2004-0016.md"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":["https://raw.githubusercontent.com/adysec/AVE/main/pocs/2001/POC-AVE-2001-0367.toml"],"repo_exp_urls":["https://raw.githubusercontent.com/adysec/AVE/main/exploits/2001/EXP-AVE-2001-0367.toml"],"has_poc":true,"has_exp":true,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/2001/AVE-2001-0367.toml"},{"ave_id":"AVE-2001-0371","file_name":"2001/AVE-2001-0371.toml","cve_id":"CVE-2001-1162","title":"Samba smb.conf 目录遍历任意文件创建漏洞","description":"Samba 2.0.x 至 2.2.0a 之前版本中 smb.conf 配置文件的 %m 宏存在目录遍历漏洞。远程攻击者可通过在 NETBIOS 名称中注入 ../ 序列，使 Samba 服务器将日志文件写入任意目录，从而覆盖系统关键文件。该漏洞无需身份认证即可远程利用，攻击复杂度低，可导致目标系统完整性完全丧失。受影响版本包括 Samba 2.0.x 及 2.2 系列，CVSS 评分 10.0，危害等级严重。","severity":"CRITICAL","score":10.0,"aliases":["CVE-2001-1162"],"sources":["exploitdb"],"published":"2001-06-23T04:00:00Z","updated":"2026-06-16T21:55:42Z","remediation":"升级 Samba 至 2.2.0a 或更高版本，该版本修复了 smb.conf 中 %m 宏的目录遍历问题。如无法升级，可在 smb.conf 中移除 %m 宏的使用，或在防火墙限制 137-139/445 端口的 NETBIOS 名称请求来源。","status":"completed","collected_at":"2026-07-27T00:00:00Z","references":["http://ciac.llnl.gov/ciac/bulletins/l-105.shtml","http://distro.conectiva.com.br/atualizacoes/?id=a&anuncio=000405","http://download.immunix.org/ImmunixOS/7.0/updates/IMNX-2001-70-027-01","http://us1.samba.org/samba/whatsnew/macroexploit.html","http://www.calderasystems.com/support/security/advisories/CSSA-2001-024.0.txt","http://www.debian.org/security/2001/dsa-065","http://www.linux-mandrake.com/en/security/2001/MDKSA-2001-062.php3","http://www.redhat.com/support/errata/RHSA-2001-086.html","http://www.securityfocus.com/advisories/3423","http://www.securityfocus.com/archive/1/193027","http://www.securityfocus.com/bid/2928","https://exchange.xforce.ibmcloud.com/vulnerabilities/6731","https://www.exploit-db.com/exploits/20968","https://github.com/trickest/cve/blob/e69d88e0152845fc4d4b49970ca6e503f56b2f93/2001/CVE-2001-1162.md","https://github.com/CVEProject/cvelistV5/blob/257ebb29696cc311841c79ca4ceb0162bf5df44a/cves/2001/1xxx/CVE-2001-1162.json","https://github.com/LiuCan01/cve-list-pro/blob/78b55511cee3604c22d518e32822f0435d0cacc0/cve-list/CVE-2001/CVE-2001-1162","https://github.com/edoardottt/missing-cve-nuclei-templates/blob/b93b72c800b93d13fcc97984485ecaf9a9b5cbc1/data/year/2001.txt","https://github.com/Patrowl/PatrowlHearsData/blob/2b92b509a6091f543702b902d36eba35e2393da1/CVE/data/2001/CVE-2001-1162.json","https://github.com/mabitoski/cve_submodules/blob/44ad7e2705b3aef1b2ffaf64bd47596c10a6c2e4/2001/CVE-2001-1162.md","https://github.com/github/advisory-database/blob/29919db3f954d9ce9be0e7e3cf177436392d45d3/advisories/unreviewed/2022/05/GHSA-8wh4-jc8q-39g3/GHSA-8wh4-jc8q-39g3.json","https://github.com/rhuitl/uClinux/blob/0486e80a025dccbe4a2213715a2ab8a5063ea86b/user/nessus/nessus-plugins/scripts/debian_DSA-065.nasl","https://github.com/blackhook/nessus-plugins/blob/64177d96abbb07c58cf7e131046b067ebc61fcb5/S/samba_arbitrary_file_creation.nasl","https://github.com/KTZgraph/sarenka/blob/f1fb931ab722d6c096d581ed6e3c5966d799fbaa/sarenka/feeds/cve_details/cve_all_details_151000_151100.json"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":[],"repo_exp_urls":[],"has_poc":false,"has_exp":false,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/2001/AVE-2001-0371.toml"},{"ave_id":"AVE-2001-0347","file_name":"2001/AVE-2001-0347.toml","cve_id":"CVE-2001-0906","title":"teTeX 过滤器 临时文件竞争条件漏洞","description":"tags.<value>teTeX 过滤器在 1.0.7 版本之前存在临时文件竞争条件漏洞。当使用 lpr 打印 .dvi 文件时，过滤器会创建临时文件且未进行安全检查。本地攻击者可通过符号链接攻击（symlink attack）利用该漏洞，在临时文件创建后将其指向敏感目标文件，从而覆盖这些文件并获取提升的权限。该漏洞影响 teTeX 1.0.7 之前的所有版本，CVSS 评分为 6.2，属于中等危害等级。","severity":"MEDIUM","score":6.2,"aliases":["CVE-2001-0906"],"sources":["exploitdb"],"published":"2001-06-22T04:00:00Z","updated":"2026-06-16T21:55:12Z","remediation":"升级 teTeX 至 1.0.7 或更高版本，该版本修复了临时文件符号链接竞争条件漏洞。对于 Red Hat 7.0/7.1 系统，同时升级 LPRng 至 3.7.4-23 或更高版本。临时缓解措施：将 /var/lib/texmf/ 目录权限设置为 750 并确保属主为 root，禁止普通用户写入；限制 lpr 打印服务仅接受本地打印请求，关闭不必要的远程打印功能。永久修复需安装对应发行版的安全更新，Red Hat 用户可参考 RHSA-2001-102 公告，Mandrake 用户可参考 MDKSA-2001-086 公告。","status":"completed","collected_at":"2026-07-25T00:00:00Z","references":["http://download.immunix.org/ImmunixOS/7.0/updates/IMNX-2001-70-030-01","http://www.linux-mandrake.com/en/security/2001/MDKSA-2001-086.php3","http://www.redhat.com/support/errata/RHSA-2001-102.html","http://www.securityfocus.com/archive/1/192647","http://www.securityfocus.com/bid/2974","https://exchange.xforce.ibmcloud.com/vulnerabilities/6785","https://www.exploit-db.com/exploits/20990","https://github.com/CVEProject/cvelistV5/blob/5b3647aa8630e92d52def237a668e1c7c212a696/cves/2001/0xxx/CVE-2001-0906.json","https://github.com/LiuCan01/cve-list-pro/blob/78b55511cee3604c22d518e32822f0435d0cacc0/cve-list/CVE-2001/CVE-2001-0906","https://github.com/HORKimhab/poc-cve-collection/blob/e7cc7ffafdbb032c31bb30d673481530aa167b3b/2001/0xxx/CVE-2001-0906.md","https://github.com/Patrowl/PatrowlHearsData/blob/48bcd43923f8bb2f197ede4a17570cc3bd71fd9e/CVE/data/2001/CVE-2001-0906.json","https://github.com/github/advisory-database/blob/c94c1772ba718b7f105ed32361c896b35042b2b3/advisories/unreviewed/2022/04/GHSA-2crw-gg34-7j66/GHSA-2crw-gg34-7j66.json","https://github.com/yarencheng/cve-devops-playground/blob/7c450063cd3f12f7aa97a070bb18c68d6bc6767e/content/CVE-2001-0906.md","https://github.com/intSpLoiT/intframework/blob/eabaa799d0260aa52b735fa9769266d1ce4b64ef/modules/cve_list.txt","https://github.com/nomi-sec/NVD-Database/blob/23dc120c34402aaa65883c51c1d03b3cb02c20cb/2001/CVE-2001-0906.json","https://github.com/andreafioraldi/ToolsForCyberChallenge/blob/197d3dfd204cf1b9d1af1451455c8831c3ff9948/generated/files_4.list.dict","https://github.com/oasis-open/cti-stix-common-objects/blob/55ba7598cbd5a52577b6887871505d931d85cb61/objects/vulnerability/vulnerability--0c3c1df2-ba38-446c-9ee2-7234ee7b433a.json"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":["https://raw.githubusercontent.com/adysec/AVE/main/pocs/2001/POC-AVE-2001-0347.toml"],"repo_exp_urls":["https://raw.githubusercontent.com/adysec/AVE/main/exploits/2001/EXP-AVE-2001-0347.toml"],"has_poc":true,"has_exp":true,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/2001/AVE-2001-0347.toml"},{"ave_id":"AVE-2001-0451","file_name":"2001/AVE-2001-0451.toml","cve_id":"CVE-2001-1078","title":"eXtremail 邮件服务器远程格式字符串漏洞","description":"eXtremail 邮件服务器 1.1.9 及更早版本中存在格式化字符串漏洞，该漏洞位于 flog 日志记录函数中。远程攻击者无需身份认证即可在 SMTP 协议的 HELO、EHLO、MAIL FROM、RCPT TO 命令以及 POP3 协议的 USER 等命令中注入格式化字符串占位符（如 %x、%n），触发内存读写操作，最终导致攻击者获取目标系统的 root 最高权限。该漏洞 CVSS 评分 10.0，危害等级严重，影响所有运行受影响版本 eXtremail 的邮件服务器。","severity":"CRITICAL","score":10.0,"aliases":["CVE-2001-1078"],"sources":["exploitdb"],"published":"2001-06-21T04:00:00Z","updated":"2026-06-16T21:55:32Z","remediation":"eXtremail 已停止维护，官方未发布修复该格式字符串漏洞的补丁版本。建议立即迁移至其他受支持的邮件服务器软件（如 Postfix、Dovecot）。作为临时缓解措施，在防火墙上限制对 SMTP（25/TCP）和 POP3（110/TCP）端口的访问，仅允许可信 IP 连接，并监控日志中异常的格式说明符（%s、%n 等）输入。","status":"completed","collected_at":"2026-07-27T00:00:00Z","references":["http://archives.neohapsis.com/archives/bugtraq/2001-06/0291.html","http://www.extremail.com/history.htm","http://www.extremail.com/news.htm","http://www.securityfocus.com/bid/2908","https://exchange.xforce.ibmcloud.com/vulnerabilities/6733","https://www.exploit-db.com/exploits/20954","https://github.com/trickest/cve/blob/e69d88e0152845fc4d4b49970ca6e503f56b2f93/2007/CVE-2007-5467.md","https://github.com/CVEProject/cvelistV5/blob/d426ca16061eaa1a65a39ea953ac0efe02aa4cae/cves/2001/1xxx/CVE-2001-1078.json","https://github.com/LiuCan01/cve-list-pro/blob/78b55511cee3604c22d518e32822f0435d0cacc0/cve-list/CVE-2001/CVE-2001-1078","https://github.com/HORKimhab/poc-cve-collection/blob/291c09f8f1fb3b2fa866c7b93e7660471419cef8/2001/1xxx/CVE-2001-1078.md","https://github.com/Patrowl/PatrowlHearsData/blob/db2f5eda64b048f89c93b57f05c779b62a05c5c9/CVE/data/2001/CVE-2001-1078.json","https://github.com/github/advisory-database/blob/29919db3f954d9ce9be0e7e3cf177436392d45d3/advisories/unreviewed/2022/04/GHSA-v54p-gvhc-m8wq/GHSA-v54p-gvhc-m8wq.json","https://github.com/yarencheng/cve-devops-playground/blob/c54e59752dddfc9aa36c13774164384cfa0d1f04/content/CVE-2001-1078.md","https://github.com/olbat/nvdcve/blob/add906b6a8ba20fd533c6fdd7f023c73e6090f3a/nvdcve/CVE-2007-5467.json","https://github.com/blackhook/nessus-plugins/blob/64177d96abbb07c58cf7e131046b067ebc61fcb5/E/eXtremail_format_strings.nasl","https://github.com/KTZgraph/sarenka/blob/f1fb931ab722d6c096d581ed6e3c5966d799fbaa/sarenka/feeds/cve_details/cve_all_details_151000_151100.json"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":[],"repo_exp_urls":[],"has_poc":false,"has_exp":false,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/2001/AVE-2001-0451.toml"},{"ave_id":"AVE-2001-0395","file_name":"2001/AVE-2001-0395.toml","cve_id":"CVE-2001-1276","title":"ispell 临时文件符号链接攻击文件覆盖漏洞","description":"ispell 在 3.1.20 版本之前存在符号链接（symlink）攻击漏洞。该漏洞源于 ispell 在处理临时文件时未对文件路径进行充分的安全校验，攻击者可通过创建指向目标用户文件的符号链接，使 ispell 在写入临时文件时覆盖其他用户的文件。该漏洞影响 ispell 3.1.20 之前的所有版本。攻击条件为攻击者需具有本地用户权限，利用方式是在 ispell 生成临时文件时预先创建指向目标文件的符号链接，从而诱导 ispell 将内容写入目标文件，实现文件覆盖。CVSS 评分为 1.2，危害等级较低。","severity":"LOW","score":1.2,"aliases":["CVE-2001-1276"],"sources":["redhat"],"published":"2001-06-21T04:00:00Z","updated":"2026-06-16T21:55:56Z","remediation":"将系统上的 ispell 升级至 3.1.20 或更高版本。对于 Red Hat 系统，安装 Red Hat errata RHSA-2001:074 提供的更新包；对于 Mandrake 系统，应用 MDKSA-2001:058 安全更新；对于 Debian/Ubuntu 系统，执行 apt-get install --only-upgrade ispell 更新至发行版提供的修复版本。如因业务原因无法立即升级，可采取以下临时缓解措施：将 /tmp 目录权限设置为 1777（确保粘滞位生效，防止用户删除或覆盖他人文件），为 ispell 进程设置专用的私有临时目录（通过环境变量 TMPDIR=/var/tmp/ispell 或类似安全路径），并使用 umask 0077 限制临时文件创建权限，同时限制本地非特权用户对 ispell 的 SUID/SGID 执行权限。","status":"completed","collected_at":"2026-07-25T00:00:00Z","references":["http://download.immunix.org/ImmunixOS/6.2/updates/IMNX-2001-62-004-01","http://marc.info/?l=bugtraq&m=99317439131174&w=2","http://www.linux-mandrake.com/en/security/2001/MDKSA-2001-058.php3","http://www.redhat.com/support/errata/RHSA-2001-074.html","https://github.com/CVEProject/cvelistV5/blob/22fc02e0bffd4b75ea6ac00629aace3b9e1913af/cves/2001/1xxx/CVE-2001-1276.json","https://github.com/LiuCan01/cve-list-pro/blob/78b55511cee3604c22d518e32822f0435d0cacc0/cve-list/CVE-2001/CVE-2001-1276","https://github.com/HORKimhab/poc-cve-collection/blob/beabc13489602b94b6c532f1aa3931e9e9fc2bc0/2001/1xxx/CVE-2001-1276.md","https://github.com/Patrowl/PatrowlHearsData/blob/7f1d287a627fd4d192291c618f3010c17d678803/CVE/data/2001/CVE-2001-1276.json","https://github.com/github/advisory-database/blob/30b2e88d407156e5425e05ff25f0ec9537280e2f/advisories/unreviewed/2022/04/GHSA-77gm-c4j8-xp66/GHSA-77gm-c4j8-xp66.json","https://github.com/yarencheng/cve-devops-playground/blob/7c450063cd3f12f7aa97a070bb18c68d6bc6767e/content/CVE-2001-1276.md","https://github.com/KTZgraph/sarenka/blob/f1fb931ab722d6c096d581ed6e3c5966d799fbaa/sarenka/feeds/cve_details/cve_all_details_151000_151100.json","https://github.com/blackhook/nessus-plugins/blob/64177d96abbb07c58cf7e131046b067ebc61fcb5/M/mandrake_MDKSA-2001-058.nasl","https://github.com/olbat/nvdcve/blob/add906b6a8ba20fd533c6fdd7f023c73e6090f3a/nvdcve/CVE-2001-1276.json","https://github.com/oasis-open/cti-stix-common-objects/blob/55ba7598cbd5a52577b6887871505d931d85cb61/objects/vulnerability/vulnerability--3ec170b9-7485-44d2-93bb-0546d46ae1a0.json"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":[],"repo_exp_urls":[],"has_poc":false,"has_exp":false,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/2001/AVE-2001-0395.toml"},{"ave_id":"AVE-2001-0452","file_name":"2001/AVE-2001-0452.toml","cve_id":"CVE-2001-1080","title":"IBM AIX diagrpt 本地权限提升漏洞","description":"AIX 4.3.x 及 5.1 版本中的 diagrpt 诊断工具存在任意特权程序执行漏洞。该工具使用 DIAGDATADIR 环境变量定位并执行诊断程序，本地攻击者可通过修改该环境变量指向特洛伊木马程序，从而以 root 权限执行任意代码，实现本地权限提升。攻击者需拥有本地系统访问权限，利用难度较低，可完全控制受影响系统。","severity":"CRITICAL","score":10.0,"aliases":["CVE-2001-1080"],"sources":["exploitdb"],"published":"2001-06-19T04:00:00Z","updated":"2026-06-16T21:55:32Z","remediation":"建议立即升级 AIX 系统至 IBM 官方支持的最新版本（如 AIX 7.2/7.3），该漏洞在后续版本中已修复。如无法升级，可临时移除 diagrpt 的 setuid root 权限：`chmod u-s /usr/lpp/diagnostics/bin/diagrpt`，并限制本地用户对 DIAGDATADIR 环境变量的控制权限，同时监控 `/usr/lpp/diagnostics/bin/` 目录下 cat 等命令的异常调用行为。","status":"completed","collected_at":"2026-07-27T00:00:00Z","references":["http://www-1.ibm.com/services/continuity/recover1.nsf/MSS/MSS-OAR-E01-2001.225.1/%24file/oar225.txt","http://www.securityfocus.com/bid/2916","https://exchange.xforce.ibmcloud.com/vulnerabilities/6734","https://www.exploit-db.com/exploits/20965","https://github.com/trickest/cve/blob/e69d88e0152845fc4d4b49970ca6e503f56b2f93/2001/CVE-2001-1080.md","https://github.com/CVEProject/cvelistV5/blob/d426ca16061eaa1a65a39ea953ac0efe02aa4cae/cves/2001/1xxx/CVE-2001-1080.json","https://github.com/LiuCan01/cve-list-pro/blob/78b55511cee3604c22d518e32822f0435d0cacc0/cve-list/CVE-2001/CVE-2001-1080","https://github.com/Patrowl/PatrowlHearsData/blob/db2f5eda64b048f89c93b57f05c779b62a05c5c9/CVE/data/2001/CVE-2001-1080.json","https://github.com/mabitoski/cve_submodules/blob/44ad7e2705b3aef1b2ffaf64bd47596c10a6c2e4/2001/CVE-2001-1080.md","https://github.com/github/advisory-database/blob/29919db3f954d9ce9be0e7e3cf177436392d45d3/advisories/unreviewed/2022/04/GHSA-f6fj-fcmx-fj94/GHSA-f6fj-fcmx-fj94.json","https://github.com/nomi-sec/NVD-Database/blob/23dc120c34402aaa65883c51c1d03b3cb02c20cb/2001/CVE-2001-1080.json","https://github.com/oasis-open/cti-stix-common-objects/blob/55ba7598cbd5a52577b6887871505d931d85cb61/objects/vulnerability/vulnerability--43cb7543-6eba-4c37-be7f-0fd4c10e65a4.json","https://github.com/HORKimhab/poc-cve-collection/blob/291c09f8f1fb3b2fa866c7b93e7660471419cef8/2001/1xxx/CVE-2001-1080.md","https://github.com/hungryfoolou/Vulnerability_Mining/blob/3df1d8ed0489ae1228f975ae1f58a690aae53886/craw/cveid_craw/cveid_craw/data/cveid_by_kind/cveid_gainpre.txt"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":[],"repo_exp_urls":[],"has_poc":false,"has_exp":false,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/2001/AVE-2001-0452.toml"},{"ave_id":"AVE-2001-0117","file_name":"2001/AVE-2001-0117.toml","cve_id":"CVE-2001-1459","title":"OpenSSH PAM 会话资源限制绕过漏洞","description":"OpenSSH 2.9 及更早版本存在安全绕过漏洞，当用户通过非 pty 方式执行命令时，系统不会启动可插拔认证模块（PAM）会话，导致 pam.d 中配置的资源限制（rlimits）被绕过。本地攻击者可利用此漏洞突破系统资源限制，实现资源耗尽或拒绝服务。该漏洞影响 OpenSSH 2.9 及之前版本，CVSS 评分 7.5，危害等级高。","severity":"HIGH","score":7.5,"aliases":["CVE-2001-1459"],"sources":["osv"],"published":"2001-06-19T04:00:00Z","updated":"2026-06-16T21:56:19Z","remediation":"升级 OpenSSH 至 2.9.1 及以上版本（2001 年 7 月发布的 OpenSSH 2.9.1 已修复此问题）。现代系统应使用当前最新稳定版（OpenSSH 9.x 系列），以避免大量后续安全风险。如无法立即升级，可在 pam.d/sshd 中启用 mandatory 会话模块并要求所有登录 session 必须关联 pty。","status":"completed","collected_at":"2026-07-22T00:00:00Z","references":["http://marc.info/?l=bugtraq&m=99324968918628&w=2","http://www.kb.cert.org/vuls/id/797027","http://www.securityfocus.com/bid/2917","https://exchange.xforce.ibmcloud.com/vulnerabilities/6757","https://github.com/CVEProject/cvelistV5/blob/a54ce91ca4eed5acb1176739213f8ac035b9fa27/cves/2001/1xxx/CVE-2001-1459.json","https://github.com/LiuCan01/cve-list-pro/blob/78b55511cee3604c22d518e32822f0435d0cacc0/cve-list/CVE-2001/CVE-2001-1459","https://github.com/yarencheng/cve-devops-playground/blob/cbe73d6bdcced13ea57f08566d6bbf5345864f7e/content/CVE-2001-1459.md","https://github.com/Patrowl/PatrowlHearsData/blob/c30cb75c630bd0892c286bac41dd51c65d6a6546/CVE/data/2001/CVE-2001-1459.json","https://github.com/github/advisory-database/blob/1721417c5dc7c1cbf858e5ea5a5245ea62e70cce/advisories/unreviewed/2022/04/GHSA-m88g-p7vr-7qr7/GHSA-m88g-p7vr-7qr7.json","https://github.com/zercurity/vulnerabilities/blob/8eb5f158d91688a46557263c708774d5f8d3956c/2001/CVE-2001-1459","https://github.com/blackhook/nessus-plugins/blob/64177d96abbb07c58cf7e131046b067ebc61fcb5/O/openssh_299p1.nasl","https://github.com/KTZgraph/sarenka/blob/f1fb931ab722d6c096d581ed6e3c5966d799fbaa/sarenka/feeds/cve_details/cve_all_details_151000_151100.json","https://github.com/oasis-open/cti-stix-common-objects/blob/55ba7598cbd5a52577b6887871505d931d85cb61/objects/vulnerability/vulnerability--89a955ef-cdee-4391-ad2b-1fdc4077c113.json","https://github.com/nomi-sec/NVD-Database/blob/23dc120c34402aaa65883c51c1d03b3cb02c20cb/2001/CVE-2001-1459.json"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":[],"repo_exp_urls":[],"has_poc":false,"has_exp":false,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/2001/AVE-2001-0117.toml"},{"ave_id":"AVE-2001-0472","file_name":"2001/AVE-2001-0472.toml","cve_id":"CVE-2001-1160","title":"Microburst Technologies uDirectory 远程命令执行漏洞","description":"Microburst Technologies 开发的 uDirectory 2.0 及更早版本中的 udirectory.pl 脚本存在命令注入漏洞。远程攻击者无需身份认证即可通过向 category_file 参数中注入 shell 元字符（如分号、管道符等），利用 Web 应用对用户输入过滤不严的缺陷，在服务器上以 Web 进程权限执行任意系统命令。攻击者可利用该漏洞读取敏感文件、写入恶意文件或执行其他恶意操作，导致机密性、完整性和可用性受损。该漏洞 CVSS 评分 7.5，危害等级高，且已有公开的 ExploitDB 利用代码。","severity":"HIGH","score":7.5,"aliases":["CVE-2001-1160"],"sources":["exploitdb"],"published":"2001-06-18T04:00:00Z","updated":"2026-06-16T21:55:42Z","remediation":"立即升级 Microburst uDirectory 至 2.0 以上版本（如厂商已停止维护，建议彻底移除该软件并迁移至受支持的目录管理方案）。若无法立即升级，在 Web 服务器或反向代理层对 `category_file` 参数实施严格输入过滤，禁止 `;|&$()` 等 shell 元字符传入，同时限制 udirectory.pl 的 Web 访问权限（如通过 .htaccess 仅允许可信 IP 访问）。","status":"completed","collected_at":"2026-07-27T00:00:00Z","references":["http://www.securityfocus.com/archive/1/191829","http://www.securityfocus.com/bid/2884","https://exchange.xforce.ibmcloud.com/vulnerabilities/6706","https://www.exploit-db.com/exploits/20935","https://github.com/CVEProject/cvelistV5/blob/257ebb29696cc311841c79ca4ceb0162bf5df44a/cves/2001/1xxx/CVE-2001-1160.json","https://github.com/LiuCan01/cve-list-pro/blob/78b55511cee3604c22d518e32822f0435d0cacc0/cve-list/CVE-2001/CVE-2001-1160","https://github.com/HORKimhab/poc-cve-collection/blob/41644568d1e47f962c2cefae75c8b09359290a26/2001/1xxx/CVE-2001-1160.md","https://github.com/Patrowl/PatrowlHearsData/blob/4bd823fa5ff72ec859371ff3ef0f5e18be2f2c77/CVE/data/2001/CVE-2001-1160.json","https://github.com/github/advisory-database/blob/29919db3f954d9ce9be0e7e3cf177436392d45d3/advisories/unreviewed/2022/04/GHSA-3rcw-vw36-hw68/GHSA-3rcw-vw36-hw68.json","https://github.com/nomi-sec/NVD-Database/blob/23dc120c34402aaa65883c51c1d03b3cb02c20cb/2001/CVE-2001-1160.json","https://github.com/KTZgraph/sarenka/blob/f1fb931ab722d6c096d581ed6e3c5966d799fbaa/sarenka/feeds/cve_details/cve_all_details_151000_151100.json","https://github.com/andreafioraldi/ToolsForCyberChallenge/blob/197d3dfd204cf1b9d1af1451455c8831c3ff9948/generated/files_3.list.dict","https://github.com/oasis-open/cti-stix-common-objects/blob/55ba7598cbd5a52577b6887871505d931d85cb61/objects/vulnerability/vulnerability--8679a05e-028d-4413-a6d0-70e023cf792a.json","https://github.com/nomi-sec/NVD-Exploit-List-Ja/blob/b82432e7d59d95db9f183c0cefa7744595784afa/2001.tsv"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":[],"repo_exp_urls":[],"has_poc":false,"has_exp":false,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/2001/AVE-2001-0472.toml"},{"ave_id":"AVE-2001-0260","file_name":"2001/AVE-2001-0260.toml","cve_id":"CVE-2001-0408","title":"Vim vim/gvim 内嵌控制码处理任意命令执行漏洞","description":"Vim（含 gvim）在处理文件中嵌入的 VIM 控制码时存在命令执行漏洞。攻击者可将恶意 VIM 控制码嵌入普通文本文件中，当其他用户使用 Vim 打开该恶意文件时，控制码会被 Vim 解析执行，导致任意命令执行。该漏洞利用条件简单，仅需诱导受害者打开特制文件即可触发，影响范围广泛，涉及所有使用 Vim 的 Linux/Unix 系统及部分 Windows 平台。","severity":"MEDIUM","score":5.1,"aliases":["CVE-2001-0408"],"sources":["redhat"],"published":"2001-06-18T04:00:00Z","updated":"2026-06-16T21:54:15Z","remediation":"建议升级 vim/gvim 至 5.7 及以上版本，该版本增加了对 VIM 控制码的安全处理机制。各发行版对应补丁：Red Hat 安装 RHSA-2001:008 更新，Mandrake Linux 安装 MDKSA-2001:035 更新，Caldera OpenLinux 安装 CSSA-2001-014.0 更新，SuSE Linux 安装 2001_012_vim 更新。如无法升级，可在 vimrc 中设置 `set nomodeline` 禁用模型线功能，并避免用 vim 打开来源不可信的文件。","status":"completed","collected_at":"2026-07-23T00:00:00Z","references":["http://marc.info/?l=bugtraq&m=98593106111968&w=2","http://www.calderasystems.com/support/security/advisories/CSSA-2001-014.0.txt","http://www.linux-mandrake.com/en/security/2001/MDKSA-2001-035.php3","http://www.novell.com/linux/security/advisories/2001_012_vim.html","http://www.redhat.com/support/errata/RHSA-2001-008.html","http://www.securityfocus.com/bid/2510","https://exchange.xforce.ibmcloud.com/vulnerabilities/6259","https://github.com/CVEProject/cvelistV5/blob/2ee9e77ceac534c670c42073c99286dbb69e9733/cves/2001/0xxx/CVE-2001-0408.json","https://github.com/LiuCan01/cve-list-pro/blob/78b55511cee3604c22d518e32822f0435d0cacc0/cve-list/CVE-2001/CVE-2001-0408","https://github.com/yarencheng/cve-devops-playground/blob/4731f60845c8f35e2bdb03d333a9e9d84c7b1c27/content/CVE-2001-0408.md","https://github.com/Patrowl/PatrowlHearsData/blob/c872795777255e25a47f155fd6d323c05ea13ab9/CVE/data/2001/CVE-2001-0408.json","https://github.com/github/advisory-database/blob/daf3a08cbe0139b666db9d48681b6efcebbecad5/advisories/unreviewed/2022/04/GHSA-j8qm-vm5m-59fw/GHSA-j8qm-vm5m-59fw.json","https://github.com/intSpLoiT/intframework/blob/eabaa799d0260aa52b735fa9769266d1ce4b64ef/modules/cve_list.txt","https://github.com/nomi-sec/NVD-Database/blob/23dc120c34402aaa65883c51c1d03b3cb02c20cb/2001/CVE-2001-0408.json","https://github.com/oasis-open/cti-stix-common-objects/blob/55ba7598cbd5a52577b6887871505d931d85cb61/objects/vulnerability/vulnerability--c79148dd-094f-4df6-9e90-249479deaf65.json","https://github.com/Freem93/grammar_nasl_v2/blob/63834ebb8cd6e97050e155291c7500ad53bb20c6/plugins/mandrake_MDKSA-2001-035.nasl","https://github.com/dmc5179/rhsa-tools/blob/677b19c223fe2771414f7b2fc89b4a4f39d25719/cvrfs/RHSA-2001:008.json"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":[],"repo_exp_urls":[],"has_poc":false,"has_exp":false,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/2001/AVE-2001-0260.toml"},{"ave_id":"AVE-2001-0188","file_name":"2001/AVE-2001-0188.toml","cve_id":"CVE-2001-0466","title":"Microburst uStorekeeper 目录遍历漏洞","description":"Microburst uStorekeeper 1.61 存在目录遍历漏洞，远程攻击者可通过向 file 参数传递包含 ..（点点）的恶意路径，绕过访问限制读取服务器上的任意文件。该漏洞影响 uStorekeeper 1.x 版本，攻击者无需身份认证即可利用，可能导致敏感信息泄露（如配置文件、密码文件等）。Exploit-DB 已公开该漏洞的利用代码，攻击门槛低，危害较大。","severity":"MEDIUM","score":5.0,"aliases":["CVE-2001-0466"],"sources":["exploitdb"],"published":"2001-06-18T04:00:00Z","updated":"2026-06-16T21:54:21Z","remediation":"立即升级 uStorekeeper 至最新版本（如厂商已停止维护，建议迁移至其他受支持的电子商务平台）。若无法升级，在 Web 服务器层面对 `file` 参数进行输入过滤，禁止包含 `../` 等目录遍历序列，或使用 Web 应用防火墙（WAF）拦截包含路径遍历特征的请求。","status":"completed","collected_at":"2026-07-22T00:00:00Z","references":["http://marc.info/?l=bugtraq&m=98633176230748&w=2","https://www.exploit-db.com/exploits/20725","https://github.com/CVEProject/cvelistV5/blob/97700d7e657426c8e1ee6cf44a0a2b88c60738c3/cves/2001/0xxx/CVE-2001-0466.json","https://github.com/LiuCan01/cve-list-pro/blob/78b55511cee3604c22d518e32822f0435d0cacc0/cve-list/CVE-2001/CVE-2001-0466","https://github.com/yarencheng/cve-devops-playground/blob/cbe73d6bdcced13ea57f08566d6bbf5345864f7e/content/CVE-2001-0466.md","https://github.com/Patrowl/PatrowlHearsData/blob/f0111a41156462d46f484c055bdeafa69cf38c8e/CVE/data/2001/CVE-2001-0466.json","https://github.com/rhuitl/uClinux/blob/0486e80a025dccbe4a2213715a2ab8a5063ea86b/user/nessus/nessus-plugins/scripts/ustorekeeper.nasl","https://github.com/nomi-sec/NVD-Database/blob/23dc120c34402aaa65883c51c1d03b3cb02c20cb/2001/CVE-2001-0466.json","https://github.com/intSpLoiT/intframework/blob/eabaa799d0260aa52b735fa9769266d1ce4b64ef/modules/cve_list.txt","https://github.com/Yuning-J/VulnerabilityClassifier/blob/c0f06c21b73c26b5ee2b75c21a498eb04eada4b5/threatPrediction/cveIDThreatType/cve_iddirtra","https://github.com/hungryfoolou/Vulnerability_Mining/blob/3df1d8ed0489ae1228f975ae1f58a690aae53886/craw/cveid_craw/cveid_craw/data/cveid_by_kind/cveid_dirtra.txt","https://github.com/jdkoftinoff/mb-linux-msli/blob/8adb103e34af9ff1d8d122e9ee2a1808836f0a14/uClinux-dist/user/nessus/nessus-plugins/scripts/ustorekeeper.nasl"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":[],"repo_exp_urls":[],"has_poc":false,"has_exp":false,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/2001/AVE-2001-0188.toml"},{"ave_id":"AVE-2001-0169","file_name":"2001/AVE-2001-0169.toml","cve_id":"CVE-2001-0414","title":"NTP ntpd readvar 远程缓冲区溢出漏洞","description":"NTP 协议守护进程 ntpd（又称 xntpd/xntp3）4.0.99k 及更早版本中存在缓冲区溢出漏洞。远程攻击者可通过向目标 NTP 服务发送特制的超长 readvar 参数触发该漏洞，导致缓冲区溢出，进而造成服务崩溃（拒绝服务）或在目标系统上以 root 权限执行任意代码。该漏洞影响广泛部署的 NTP 服务，攻击无需身份认证，利用复杂度低，Metasploit 框架中已有公开利用模块，危害严重。","severity":"CRITICAL","score":10.0,"aliases":["CVE-2001-0414"],"sources":["redhat"],"published":"2001-06-18T04:00:00Z","updated":"2026-06-16T21:54:15Z","remediation":"升级 NTP 守护进程至 4.0.99l 或更高版本，该漏洞在 4.0.99l 中已修复。对于仍运行旧版 NTP 的系统，建议升级至当前稳定版（如 4.2.8p18+），并在防火墙限制对 NTP 服务（默认端口 123/udp）的访问来源，仅允许可信 IP 段连接。","status":"completed","collected_at":"2026-07-23T00:00:00Z","references":["http://archives.neohapsis.com/archives/bugtraq/2001-04/0127.html","http://archives.neohapsis.com/archives/bugtraq/2001-04/0225.html","http://archives.neohapsis.com/archives/bugtraq/2001-04/0314.html","http://distro.conectiva.com.br/atualizacoes/?id=a&anuncio=000392","http://lists.suse.com/archives/suse-security-announce/2001-Apr/0000.html","http://marc.info/?l=bugtraq&m=98642418618512&w=2","http://marc.info/?l=bugtraq&m=98654963328381&w=2","http://marc.info/?l=bugtraq&m=98659782815613&w=2","http://marc.info/?l=bugtraq&m=98679815917014&w=2","http://marc.info/?l=bugtraq&m=98683952401753&w=2","http://marc.info/?l=bugtraq&m=98684202610470&w=2","http://marc.info/?l=bugtraq&m=98684532921941&w=2","http://www.calderasystems.com/support/security/advisories/CSSA-2001-013.0.txt","http://www.linux-mandrake.com/en/security/2001/MDKSA-2001-036.php3","http://www.osvdb.org/805","http://www.redhat.com/support/errata/RHSA-2001-045.html","http://www.securityfocus.com/bid/2540","https://exchange.xforce.ibmcloud.com/vulnerabilities/6321","https://oval.cisecurity.org/repository/search/definition/oval%3Aorg.mitre.oval%3Adef%3A3831","https://www.debian.org/security/2001/dsa-045","https://www.exploit-db.com/exploits/9940","https://github.com/trickest/cve/blob/ed228d55b7972f63e700a35a54fbcd94064b9ade/2001/CVE-2001-0414.md","https://github.com/CVEProject/cvelistV5/blob/2ee9e77ceac534c670c42073c99286dbb69e9733/cves/2001/0xxx/CVE-2001-0414.json","https://github.com/LiuCan01/cve-list-pro/blob/78b55511cee3604c22d518e32822f0435d0cacc0/cve-list/CVE-2001/CVE-2001-0414","https://github.com/e-m-b-a/emba/blob/4d0f24b3edae0bdb5391177851bad3be54ecea0f/config/msf_cve-db.txt","https://github.com/edoardottt/missing-cve-nuclei-templates/blob/115c94bd1da3cc18977d652d6e78c9f4a5dfc13b/data/year/2001.txt","https://github.com/eldondev/Snort/blob/34bdcf6a7a638b55c7c04f77ef1efa526ad08e33/doc/signatures/312.txt","https://github.com/mabitoski/cve_submodules/blob/44ad7e2705b3aef1b2ffaf64bd47596c10a6c2e4/2001/CVE-2001-0414.md","https://github.com/opencve/opencve-kb/blob/126b60552a8c794429e6c4fecee9552a11367db6/2001/CVE-2001-0414.json","https://github.com/rhuitl/uClinux/blob/0486e80a025dccbe4a2213715a2ab8a5063ea86b/user/nessus/nessus-plugins/scripts/debian_DSA-045.nasl","https://github.com/Chudry/Xerror/blob/07ec57cabcd27cdb47c89af452bdf4ed07207347/xerror/parsing/msf_module_result/msf_module_cve.txt"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":[],"repo_exp_urls":[],"has_poc":false,"has_exp":false,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/2001/AVE-2001-0169.toml"},{"ave_id":"AVE-2001-0168","file_name":"2001/AVE-2001-0168.toml","cve_id":"CVE-2001-0409","title":"Vim 5.x Swap文件竞争条件漏洞","description":"Vim 5.x 的备份文件与交换文件存在竞争条件漏洞，属于本地利用的符号链接攻击。当用户在全局可写目录中编辑文件时，本地攻击者可通过预先创建符号链接指向目标文件，诱使 victim 的 Vim 在保存或备份时覆盖其他用户文件，导致非授权修改。该漏洞影响 Vim 5.x 版本及 gvim，攻击者需具有本地系统账户权限，CVSS 评分 2.1，危害等级低。","severity":"LOW","score":2.1,"aliases":["CVE-2001-0409"],"sources":["exploitdb"],"published":"2001-06-18T04:00:00Z","updated":"2026-06-16T21:54:15Z","remediation":"升级至 Vim 6.0 及以上版本，该版本已修复 swap 文件的竞争条件问题。如无法升级，设置 `set backupcopy=yes` 避免符号链接攻击，并将 swap 和 backup 目录改为私有路径（如 `set dir=~/.vim/swap//` 和 `set backupdir=~/.vim/backup//`），同时避免在有其他用户的共享目录（如 `/tmp`）中编辑文件。","status":"completed","collected_at":"2026-07-22T00:00:00Z","references":["http://www.calderasystems.com/support/security/advisories/CSSA-2001-014.0.txt","http://www.novell.com/linux/security/advisories/2001_012_vim.html","https://exchange.xforce.ibmcloud.com/vulnerabilities/6628","https://www.exploit-db.com/exploits/20967","https://github.com/CVEProject/cvelistV5/blob/7d4778b18ea29de57c8a889212050a9d38e2d2cb/cves/2001/0xxx/CVE-2001-0409.json","https://github.com/LiuCan01/cve-list-pro/blob/78b55511cee3604c22d518e32822f0435d0cacc0/cve-list/CVE-2001/CVE-2001-0409","https://github.com/yarencheng/cve-devops-playground/blob/cbe73d6bdcced13ea57f08566d6bbf5345864f7e/content/CVE-2001-0409.md","https://github.com/Patrowl/PatrowlHearsData/blob/1b84eedba993546f37a880c6d2d084176a1f04a7/CVE/data/2001/CVE-2001-0409.json","https://github.com/github/advisory-database/blob/1684cfa32e43376c48beb06819bce86de6ba421b/advisories/unreviewed/2022/04/GHSA-377x-f57q-cjmg/GHSA-377x-f57q-cjmg.json","https://github.com/intSpLoiT/intframework/blob/eabaa799d0260aa52b735fa9769266d1ce4b64ef/modules/cve_list.txt","https://github.com/olbat/nvdcve/blob/5b92f5917a4a825187ccaac594f43456a77ea8f3/nvdcve/CVE-2001-0409.json","https://github.com/KTZgraph/sarenka/blob/f1fb931ab722d6c096d581ed6e3c5966d799fbaa/sarenka/feeds/cve_details/cve_all_details_150900_151000.json","https://github.com/andreafioraldi/ToolsForCyberChallenge/blob/197d3dfd204cf1b9d1af1451455c8831c3ff9948/generated/files_5.list.dict","https://github.com/oasis-open/cti-stix-common-objects/blob/55ba7598cbd5a52577b6887871505d931d85cb61/objects/vulnerability/vulnerability--a48737cd-f340-439f-bf53-0e4482852a8a.json"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":[],"repo_exp_urls":[],"has_poc":false,"has_exp":false,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/2001/AVE-2001-0168.toml"},{"ave_id":"AVE-2001-0164","file_name":"2001/AVE-2001-0164.toml","cve_id":"CVE-2001-0403","title":"Junsoft JSparm 4.0 perfmon 日志文件本地权限提升漏洞","description":"Solaris 系统中 Junsoft JSparm 4.0 的 perfmon 程序存在权限提升漏洞。本地攻击者可通过 GUI 界面的 Logging File（日志文件）选项，以 root 权限在任意位置创建文件，从而获取系统最高控制权限。该漏洞源于 perfmon 未对日志文件路径进行充分权限校验，导致低权限用户可滥用该功能实现权限提升，CVSS 评分 7.2，危害等级高。","severity":"HIGH","score":7.2,"aliases":["CVE-2001-0403"],"sources":["exploitdb"],"published":"2001-06-18T04:00:00Z","updated":"2026-06-16T21:54:14Z","remediation":"立即移除 /opt/JSparm/bin/perfmon 程序的 setuid root 权限位（chmod u-s /opt/JSparm/bin/perfmon），并限制仅授权管理员可执行该程序。同时升级 Junsoft JSparm 至厂商提供的最新补丁版本，或考虑迁移至替代性能监控方案。如无法升级，可通过 Solaris RBAC 机制限制 perfmon 的 Logging File 功能调用。","status":"completed","collected_at":"2026-07-22T00:00:00Z","references":["http://archives.neohapsis.com/archives/bugtraq/2001-03/0326.html","https://exchange.xforce.ibmcloud.com/vulnerabilities/6267","https://www.exploit-db.com/exploits/20715","https://github.com/CVEProject/cvelistV5/blob/86060d5336eceede57f01ccb65fb3037638af8db/cves/2001/0xxx/CVE-2001-0403.json","https://github.com/LiuCan01/cve-list-pro/blob/78b55511cee3604c22d518e32822f0435d0cacc0/cve-list/CVE-2001/CVE-2001-0403","https://github.com/yarencheng/cve-devops-playground/blob/cbe73d6bdcced13ea57f08566d6bbf5345864f7e/content/CVE-2001-0403.md","https://github.com/Patrowl/PatrowlHearsData/blob/61756b9c4d4c30577cc003b0b28e3db71ca30a1e/CVE/data/2001/CVE-2001-0403.json","https://github.com/github/advisory-database/blob/1684cfa32e43376c48beb06819bce86de6ba421b/advisories/unreviewed/2022/04/GHSA-vcmc-pr46-3j8f/GHSA-vcmc-pr46-3j8f.json","https://github.com/SpeeDr00t/speedr00t.github.com/blob/0380f0c2190556fabe90257cb6c0034a42f68951/securityfocus/0x89000/88807/info.html","https://github.com/intSpLoiT/intframework/blob/eabaa799d0260aa52b735fa9769266d1ce4b64ef/modules/cve_list.txt","https://github.com/olbat/nvdcve/blob/5b92f5917a4a825187ccaac594f43456a77ea8f3/nvdcve/CVE-2001-0403.json","https://github.com/andreafioraldi/ToolsForCyberChallenge/blob/197d3dfd204cf1b9d1af1451455c8831c3ff9948/generated/files_2.list.dict","https://github.com/oasis-open/cti-stix-common-objects/blob/55ba7598cbd5a52577b6887871505d931d85cb61/objects/vulnerability/vulnerability--4fd4fd43-348f-48b2-b80f-0feff254c29f.json"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":[],"repo_exp_urls":[],"has_poc":false,"has_exp":false,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/2001/AVE-2001-0164.toml"},{"ave_id":"AVE-2001-0163","file_name":"2001/AVE-2001-0163.toml","cve_id":"CVE-2001-0402","title":"IPFilter IP分片规则绕过漏洞","description":"IPFilter 3.4.16 及更早版本存在访问控制绕过漏洞。由于数据包过滤模块在处理分片数据包时，缓存中未包含充分的会话状态信息，远程攻击者可通过先向目标系统的未限制端口发送完整数据包建立会话缓存，再向限制端口发送特制的分片数据包，从而绕过 IP 规则过滤机制访问受限端口。该漏洞影响 IPFilter 3.x 系列版本，CVSS 评分 7.5，危害等级高。","severity":"HIGH","score":7.5,"aliases":["CVE-2001-0402"],"sources":["exploitdb"],"published":"2001-06-18T04:00:00Z","updated":"2026-06-16T21:54:14Z","remediation":"升级 IPFilter 至 3.4.17 或更高版本，该版本修复了分片包缓存会话信息不足的问题。如无法升级，可在防火墙上配置 `block in log quick` 规则丢弃所有分片包，或启用 `ipf -T fragstate` 增强分片状态跟踪作为临时缓解措施。","status":"completed","collected_at":"2026-07-22T00:00:00Z","references":["http://archives.neohapsis.com/archives/freebsd/2001-04/0338.html","http://marc.info/?l=bugtraq&m=98679734015538&w=2","https://exchange.xforce.ibmcloud.com/vulnerabilities/6331","https://www.exploit-db.com/exploits/20730","https://github.com/CVEProject/cvelistV5/blob/56b9e9b42ce0a91a448094549973b81cdf8e832e/cves/2001/0xxx/CVE-2001-0402.json","https://github.com/LiuCan01/cve-list-pro/blob/78b55511cee3604c22d518e32822f0435d0cacc0/cve-list/CVE-2001/CVE-2001-0402","https://github.com/yarencheng/cve-devops-playground/blob/cbe73d6bdcced13ea57f08566d6bbf5345864f7e/content/CVE-2001-0402.md","https://github.com/Patrowl/PatrowlHearsData/blob/61756b9c4d4c30577cc003b0b28e3db71ca30a1e/CVE/data/2001/CVE-2001-0402.json","https://github.com/github/advisory-database/blob/1684cfa32e43376c48beb06819bce86de6ba421b/advisories/unreviewed/2022/04/GHSA-vp6g-4h84-xm52/GHSA-vp6g-4h84-xm52.json","https://github.com/intSpLoiT/intframework/blob/eabaa799d0260aa52b735fa9769266d1ce4b64ef/modules/cve_list.txt","https://github.com/KTZgraph/sarenka/blob/f1fb931ab722d6c096d581ed6e3c5966d799fbaa/sarenka/feeds/cve_details/cve_all_details_150900_151000.json","https://github.com/oasis-open/cti-stix-common-objects/blob/55ba7598cbd5a52577b6887871505d931d85cb61/objects/vulnerability/vulnerability--eebd1c21-73ba-43d4-9a55
ttps://github.com/CVEProject/cvelistV5/blob/58bdedd85e346c3efc30a2f8424c96c50aa4db2e/cves/2015/2xxx/CVE-2015-2863.json","https://github.com/pedrib/PoC/blob/3d8e58284be35d1893dbba8a7d33c27ed9e88352/advisories/Kaseya/kaseya-vsa-vuln.txt","https://github.com/rix4uni/nucleihub-templates/blob/579a0234551b9e0e322460a62dc77bd6109e4aff/nucleihub-templates/CVE-2015-2863_3.yaml","https://github.com/opencve/opencve-kb/blob/3de20c94a6acc7eef50db49f637eef233d97be21/2015/CVE-2015-2863.json","https://github.com/0x727/FingerprintHub/blob/13e17ac40c12fcaa921f27e9c8534f670bd0f2c1/plugins/kaseya/virtual_system_administrator/CVE-2015-2863.yaml","https://github.com/adampielak/nuclei-templates/blob/a2f3ff3fa5db5c7705ebd942909ec114df063700/nuclei-v3/C/CVE-2015-2863_6.yaml","https://github.com/rix4uni/nucleihub-templates/blob/579a0234551b9e0e322460a62dc77bd6109e4aff/nucleihub-templates/CVE-2015-2863_4.yaml","https://github.com/b1ank1108/VulSentinel/blob/94493d4ecd186c002eb46ccc1bf2f9abf99f720a/reports/http/cves/2015/CVE-2015-2863.md"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":[],"repo_exp_urls":[],"has_poc":false,"has_exp":false,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/2015/AVE-2015-0023.toml"},{"ave_id":"AVE-2015-0309","file_name":"2015/AVE-2015-0309.toml","cve_id":"CVE-2015-2426","title":"Microsoft Windows OpenType Font Driver 缓冲区下溢远程代码执行漏洞","description":"Microsoft Windows Adobe Type Manager Library (atmfd.dll) 存在缓冲区下溢漏洞，远程攻击者可构造恶意 OpenType 字体文件，诱导用户打开包含该字体的文档或网页，触发缓冲区下溢导致远程代码执行。影响范围覆盖 Windows Vista SP2、Windows Server 2008 SP2/R2 SP1、Windows 7 SP1、Windows 8/8.1、Windows Server 2012/R2 及 Windows RT/8.1 等版本。攻击条件为需用户交互（打开恶意字体文件），攻击向量为网络，无需权限，成功利用可获取系统完整控制权限（CVSS 8.8 HIGH）。Microsoft 已在 MS15-078 安全公告中发布补丁修复该漏洞，CISA 已将其列入已知被利用漏洞目录。","severity":"HIGH","score":8.8,"aliases":["CVE-2015-2426"],"sources":["kev"],"published":"2015-07-20T18:59:01Z","updated":"2026-06-17T00:24:05Z","remediation":"立即安装 Microsoft 安全公告 MS15-078 (KB3079904) 提供的安全更新，受影响系统包括 Windows Vista SP2、Windows Server 2008 SP2/R2 SP1、Windows 7 SP1、Windows 8/8.1、Windows Server 2012/R2、Windows RT 8.1。通过 Windows Update 自动更新或从 Microsoft Update 目录手动下载对应系统版本的补丁包安装。无法立即打补丁的系统，可暂时禁用 ATMFD.DLL 字体驱动作为缓解：以管理员权限运行命令 \"ren %windir%\\system32\\atmfd.dll atmfd.dll.bak\" 并重启系统（会导致 OpenType 字体无法渲染），或通过组策略禁用 \"Windows 字体缓存服务\" 作为临时缓解措施。","status":"completed","collected_at":"2026-07-24T00:00:00Z","references":["http://blog.trendmicro.com/trendlabs-security-intelligence/a-look-at-the-open-type-font-manager-vulnerability-from-the-hacking-team-leak/","http://www.kb.cert.org/vuls/id/103336","http://www.securityfocus.com/bid/75951","http://www.securitytracker.com/id/1032991","https://docs.microsoft.com/en-us/security-updates/securitybulletins/2015/ms15-078","https://www.exploit-db.com/exploits/38222/","https://www.cisa.gov/known-exploited-vulnerabilities-catalog?field_cve=CVE-2015-2426","https://github.com/trickest/cve/blob/efd7fc726910da5a47b5ea864d60bf92f66b594e/2015/CVE-2015-2426.md","https://github.com/cisagov/vulnrichment/blob/4c8bc08999fabe8b3294f538c2b18b89d913b674/2015/2xxx/CVE-2015-2426.json","https://github.com/Yara-Rules/rules/blob/0f93570194a80d2f2032869055808b0ddcdfb360/cve_rules_index.yar","https://github.com/EmergingThreats/et-luajit-scripts/blob/109d050f5593e629311d0ca92d3200f59d57a7c8/CVE-2015-2426.lua","https://github.com/rapid7/metasploit-framework/blob/a23585d6e0a4a5091377e3865a13acb8fdeff3df/modules/exploits/windows/local/ms15_078_atmfd_bof.rb","https://github.com/LiuCan01/cve-list-pro/blob/78b55511cee3604c22d518e32822f0435d0cacc0/cve-list/CVE-2015/CVE-2015-2426","https://github.com/OlivierLaflamme/Cheatsheet-God/blob/b879fd62eaae297b38087b8227dde5f8f0cf7668/Cheatsheet_Windows.txt","https://github.com/mishamyrt/Lilex/blob/7cc1be8832a2e6363edb733ee7a8b2a503f99b43/SECURITY.md","https://github.com/CVEProject/cve-reference-ingest-data/blob/ab3fc962367cab15f8d25f548015e9e8509f4eca/references/CVE-2015-2426-2023-09-21-1730_1","https://github.com/fankh/vulnerability-poc/blob/ffa50060b7ba6ae58d60d6d90533e77eaf10d466/2015/CVE-2015-2426/README_KO.md"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":[],"repo_exp_urls":[],"has_poc":false,"has_exp":false,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/2015/AVE-2015-0309.toml"},{"ave_id":"AVE-2015-0408","file_name":"2015/AVE-2015-0408.toml","cve_id":"CVE-2015-2590","title":"Oracle Java SE 任意代码执行漏洞","description":"Oracle Java SE Libraries 组件存在未明确类型的任意代码执行漏洞（CVE-2015-2590），攻击者可通过构造恶意 Java 应用程序或 Applet，利用 Java SE Libraries 组件中的未明确漏洞实现远程代码执行。该漏洞影响 Oracle Java SE 7u80 及之前版本、Java SE 8u45 及之前版本，攻击者可通过诱导用户访问包含恶意 Java Applet 的网页，或通过部署恶意 Java Web Start 应用程序，诱导用户加载并执行恶意代码，从而在用户权限下执行任意代码，完全控制受害系统。Red Hat 将该漏洞评级为 Critical（严重），CVSS 评分较高。Oracle 已在 2015 年 7 月的关键补丁更新（CPU）中修复该漏洞，建议用户升级至 Java SE 7u85、Java SE 8u51 或更高版本。","severity":"CRITICAL","score":9.8,"aliases":["CVE-2015-2590"],"sources":["kev"],"published":"2015-07-16T00:00:00Z","updated":"2015-07-16T00:00:00Z","remediation":"立即升级 Oracle Java SE 至 2015 年 7 月 CPU 修复版本：Java SE 6 升级至 6u95 及以上、Java SE 7 升级至 7u80 及以上、Java SE 8 升级至 8u45 及以上；Java SE Embedded 7 升级至 7u75 及以上、Java SE Embedded 8 升级至 8u33 及以上。通过 java.com 下载最新版或在 Windows/Mac 上启用 Java 自动更新。若暂时无法升级，请在浏览器中禁用 Java 插件（Java Applet 和 Java Web Start），并在防火墙层面限制非受信网络访问 Java RMI/JRMP 端口（默认 1099、4444 等）作为临时缓解措施。此漏洞已被列入 CISA 已知被利用漏洞目录，必须优先修补。","status":"completed","collected_at":"2026-07-24T00:00:00Z","references":["https://github.com/trickest/cve/blob/efd7fc726910da5a47b5ea864d60bf92f66b594e/2015/CVE-2015-2590.md","https://github.com/LiuCan01/cve-list-pro/blob/78b55511cee3604c22d518e32822f0435d0cacc0/cve-list/CVE-2015/CVE-2015-2590","https://github.com/CVEProject/cve-reference-ingest-data/blob/ab3fc962367cab15f8d25f548015e9e8509f4eca/references/CVE-2015-2590-2023-09-21-1730","https://github.com/fankh/vulnerability-poc/blob/ffa50060b7ba6ae58d60d6d90533e77eaf10d466/2015/CVE-2015-2590/README.md","https://github.com/nomi-sec/NVD-Database/blob/23dc120c34402aaa65883c51c1d03b3cb02c20cb/2015/CVE-2015-2590.json","https://github.com
c/blob/d2f211a2392a33dc3802dfba918604d771c8ebf3/2025/CVE-2025-21392/poc.py"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":[],"repo_exp_urls":[],"has_poc":false,"has_exp":false,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/2025/AVE-2025-0854.toml"},{"ave_id":"AVE-2025-0853","file_name":"2025/AVE-2025-0853.toml","cve_id":"CVE-2025-21391","title":"Microsoft Windows Storage 权限提升漏洞","description":"Windows Storage 组件存在权限提升漏洞（CWE-59 链接跟随），具有低权限的本地攻击者可通过创建恶意符号链接并诱导系统服务访问，利用 Windows Storage 对文件路径解析不正确的缺陷，以更高权限写入或删除受保护文件系统中的文件，导致系统完整性受损或服务不可用。该漏洞影响 Windows 10/11 及 Windows Server 各版本，CVSS 评分 7.1，危害等级高。Microsoft 已在 2025 年 2 月安全更新中修复此漏洞，且 CISA KEV 已确认该漏洞被积极利用。","severity":"HIGH","score":7.1,"aliases":["CVE-2025-21391"],"sources":["msrc"],"published":"2025-02-11T18:15:37Z","updated":"2026-06-17T08:43:15Z","remediation":"立即安装 Microsoft 2025 年 2 月安全更新 KB5051974，该补丁修复了 Windows Storage 中的符号链接跟踪漏洞。可通过 Windows Update 自动更新或从 Microsoft 更新目录手动下载安装。由于该漏洞已被 CISA 列入已知被利用漏洞目录（KEV），且存在在野利用，建议在 2025 年 3 月 4 日前完成修补。如无法立即打补丁，可限制低权限用户对存储卷的写入权限作为临时缓解措施。","status":"completed","collected_at":"2026-08-05T00:00:00Z","references":["https://msrc.microsoft.com/update-guide/vulnerability/CVE-2025-21391","https://www.cisa.gov/known-exploited-vulnerabilities-catalog?field_cve=CVE-2025-21391","https://github.com/trickest/cve/blob/15eaa178baaf955987a866a2c9d91dc02a2fb4aa/2025/CVE-2025-21391.md","https://github.com/0xMarcio/cve/blob/7b5ce0c8ddaaec75eae1da91b247176dbec670ba/2025/CVE-2025-21391.md","https://github.com/CVEProject/cvelistV5/blob/86965a1ef7a64a35a4bffc5193446981deb1b2f5/cves/2025/21xxx/CVE-2025-21391.json","https://github.com/cisagov/vulnrichment/blob/a80088c333d18acfc433e05d369205d159a29769/2025/21xxx/CVE-2025-21391.json","https://github.com/Patrowl/PatrowlHearsData/blob/d9d0e44f54f90ad1b4ec106b1cac94be29b99757/CVE/data/2025/CVE-2025-21391.json","https://github.com/Patrowl/PatrowlHearsData/blob/d9d0e44f54f90ad1b4ec106b1cac94be29b99757/SSVC/data/2025/CVE-2025-21391.json","https://github.co
ba79f4/csaf/vex/cve/2024/cve-2024-57980.json"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":[],"repo_exp_urls":[],"has_poc":false,"has_exp":false,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/2024/AVE-2024-0661.toml"},{"ave_id":"AVE-2024-0659","file_name":"2024/AVE-2024-0659.toml","cve_id":"CVE-2024-57978","title":"Linux kernel IMX JPEG 驱动空指针解引用漏洞","description":"Linux 内核 IMX JPEG 驱动程序的 detach_pm() 函数中存在空指针解引用漏洞。该问题源于代码未正确检查 jpeg->pd_dev[i] 是否为错误指针（ERR_PTR），而是仅检查了非 NULL 条件，导致将错误指针传递给 pm_runtime_suspended() 函数时触发内核崩溃（Oops）。本地攻击者可通过加载特定的 JPEG 解码设备并触发驱动卸载流程来利用此漏洞，造成拒绝服务（系统崩溃）。该漏洞影响 Linux 内核多个版本，CVSS 评分 5.5，危害等级中等。","severity":"MEDIUM","score":5.5,"aliases":["CVE-2024-57978"],"sources":["msrc"],"published":"2025-02-27T02:15:10Z","updated":"2026-06-17T08:14:21Z","remediation":"立即更新 Linux 内核至包含修复 commit 的版本：Ubuntu 22.04 LTS 升级至 linux-image-5.15.0-140-generic（5.15.0-140.150）或更高版本；Ubuntu 20.04 LTS 升级至 linux-image-5.15.0-140-lowlatency（5.15.0-140.150~20.04.1）；Debian 11 应用 DLA-4102 安全更新。执行 `sudo apt update && sudo apt upgrade` 后重启系统生效。如无法立即更新，可通过禁用 imx-jpeg 内核模块（`sudo modprobe -r imx-jpeg`）作为临时缓解措施。","status":"completed","collected_at":"2026-07-27T00:00:00Z","references":["https://git.kernel.org/stable/c/1378ffec30367233152b7dbf4fa6a25ee98585d1","https://git.kernel.org/stable/c/1b2af918bb714937a8be6cb637f528585461cd98","https://git.kernel.org/stable/c/6e601a64f7777e2f78c02db1a8b5ba3b7c5e9e31","https://git.kernel.org/stable/c/a32ba399a030853f2db45a90ba5474fdd3494aad","https://git.kernel.org/stable/c/f0b8535a7885ed4fd0b11625addb5476cae0f845","https://git.kernel.org/stable/c/fde89fe11b44500bfcb2d405825b69a5df805d19","https://lists.debian.org/debian-lts-announce/2025/03/msg00028.html","https://github.com/trickest/cve/blob/e69d88e0152845fc4d4b49970ca6e503f56b2f93/2024/CVE-2024-57978.md","https://github.com/CVEProject/cvelistV5/blob/50b2026c1039c6a81b95d80535c772b9d8685178/cves/2024/57xxx/CVE-2024-57978.json","https://github.com/NUS-Curiosity/KernJC/blob/798845a541a5396395c7e0c1670cb4872dac7105/db/vuln_desc/2024/CVE-2024-57978.yaml","https://github.com/imSkows/Cyber-Vulnerability-Analysis-Data/blob/db26c44c5f45c25514223a46675daec7eea03092/data/first/CVE-2024-57978","https://github.com/0xMarcio/cve/blob/acf4fca32ae3e6d7d43276d798ba52a241ef3b49/2024/CVE-2024-57978.md","https://github.com/HerringLiu2333/Analysis-of-CWE/blob/cd8202c32037ed388ecd79e1fc81394f13c4d4a4/CVE-2024-57978/CVE-2024-57978.ql","https://github.com/bell-sw/osv-database/blob/027c37e8e73e99b2a68cafab2e6594bde5db273e/BELL-CVE/BELL-CVE-2024-57978.json","https://github.com/CVEProject/cve-reference-ingest-data/blob/31d5b78ee7ad856a6aee490403faecefdc8a4878/references/CveServices-CVE-2024-57978-2025-11-03-1359","https://github.com/Patrowl/PatrowlHearsData/blob/050b62cac636d83be07e6d4c77e70114e1ca7c93/CVE/data/2024/CVE-2024-57978.json","https://github.com/github/advisory-database/blob/fa1c2f93b0d15da115c038738e571c1a1553b4cc/advisories/unreviewed/2025/02/GHSA-j6gc-v552-cf9v/GHSA-j6gc-v552-cf9v.json"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":[],"repo_exp_urls":[],"has_poc":false,"has_exp":false,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/2024/AVE-2024-0659.toml"},{"ave_id":"AVE-2024-0658","file_name":"2024/AVE-2024-0658.toml","cve_id":"CVE-2024-57977","title":"Linux 内核内存控制组 OOM 进程软锁定漏洞","description":"Linux 内核内存控制组（memcg）子系统中存在软锁定漏洞，当 OOM（内存耗尽）cgroup 中包含大量任务（约 56000 个）时，内核在遍历这些任务的过程中会长时间占用 CPU 导致软锁定（soft lockup），系统日志显示 CPU 被卡住 23 秒以上。本地攻击者可通过低权限方式触发内存耗尽条件，使目标进程进入 OOM cgroup 并触发遍历操作，导致系统拒绝服务。该漏洞影响所有使用受影响 Linux 内核版本的发行版，CVSS 评分 5.5，危害等级中等。修复方式是在 mem_cgroup_scan_tasks 函数中每遍历 1000 次调用 cond_resched 主动让出 CPU。","severity":"MEDIUM","score":5.5,"aliases":["CVE-2024-57977"],"sources":["msrc"],"published":"2025-02-27T02:15:10Z","updated":"2026-07-14T13:17:14Z","remediation":"立即将 Linux 内核升级至以下修复版本：5.4.291、5.10.235、5.15.179、6.1.130、6.12.13 或 6.13.2 及以上版本。对于 Debian 系统，安装 DSA-5900-1 或 DLA-4178-1 安全更新。对于使用 Siemens SIMATIC S7-1500 MFP 设备的用户，升级 GNU/Linux 子系统至修复版本。如无法立即升级内核，可通过限制 cgroup 中进程数量或降低内存超配比（vm.overcommit_ratio）减少 OOM 触发频率作为临时缓解措施。","status":"completed","collected_at":"2026-07-27T00:00:00Z","references":["https://git.kernel.org/stable/c/0a09d56e1682c951046bf15542b3e9553046c9f6","https://git.kernel.org/stable/c/110399858194c71f11afefad6e7be9e3876b284f","https://git.kernel.org/stable/c/46576834291869457d4772bb7df72d7c2bb3d57f","https://git.kernel.org/stable/c/72f2c0b7c152c2983ed51d48c3272cab4f34d965","https://git.kernel.org/stable/c/972486d37169fe85035e81b8c5dff21f70df1173","https://git.kernel.org/stable/c/a9042dbc1ed4bf25a5f5c699d10c3d676abf8ca2","https://git.kernel.org/stable/c/ade81479c7dda1ce3eedb215c78bc615bbd04f06","https://git.kernel.org/stable/c/c3a3741db8c1202aa959c77df3a4c361612d1eb1","https://lists.debian.org/debian-lts-announce/2025/05/msg00030.html","https://lists.debian.org/debian-lts-announce/2025/05/msg00045.html","https://cert-portal.siemens.com/productcert/html/ssa-019113.html","https://cert-portal.siemens.com/productcert/html/ssa-082556.html","https://cert-portal.siemens.com/productcert/html/ssa-265688.html","https://github.com/trickest/cve/blob/e69d88e0152845fc4d4b49970ca6e503f56b2f93/2024/CVE-2024-57977.md","https://github.com/CVEProject/cvelistV5/blob/50b2026c1039c6a81b95d80535c772b9d8685178/cves/2024/57xxx/CVE-2024-57977.json","https://github.com/imSkows/Cyber-Vulnerability-Analysis-Data/blob/db26c44c5f45c25514223a46675daec7eea03092/data/first/CVE-2024-57977","https://github.com/NUS-Curiosity/KernJC/blob/798845a541a5396395c7e0c1670cb4872dac7105/db/vuln_desc/2024/CVE-2024-57977.yaml","https://github.com/openharmony/security/blob/f47b282130050082f1bcf6813aaced4157bd1771/vulntest/SSTSTestcases/2025/06/CVE-2024-57977/CVE-2024-57977.yara","https://github.com/0xMarcio/cve/blob/acf4fca32ae3e6d7d43276d798ba52a241ef3b49/2024/CVE-2024-57977.md","https://github.com/bell-sw/osv-database/blob/027c37e8e73e99b2a68cafab2e6594bde5db273e/BELL-CVE/BELL-CVE-2024-57977.json","https://github.com/CVEProject/cve-reference-ingest-data/blob/31d5b78ee7ad856a6aee490403faecefdc8a4878/references/CveServices-CVE-2024-57977-2025-11-03-1334","https://github.com/Patrowl/PatrowlHearsData/blob/050b62cac636d83be07e6d4c77e70114e1ca7c93/CVE/data/2024/CVE-2024-57977.json","https://github.com/joaop9425/manual-do-tecnico/blob/cc6e0f5304777f18e55db554da5372bc31d4cae1/src/content/noticias/2026/02/18/seguranca/cve-2024-57977-memcg-fix-soft-lockup-in-the-oom-pr-1771408247000.md"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":[],"repo_exp_urls":[],"has_poc":false,"has_exp":false,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/2024/AVE-2024-0658.toml"},{"ave_id":"AVE-2024-0657","file_name":"2024/AVE-2024-0657.toml","cve_id":"CVE-2024-57976","title":"Linux Kernel Btrfs 文件系统 folio 清理不当导致拒绝服务漏洞","description":"Linux 内核 btrfs 文件系统在 cow_file_range() 函数执行失败时存在不正确的 folio（页缓存单元）清理漏洞。当写入时空间不足（-ENOSPC）导致 cow_file_range() 失败后，错误处理流程未能正确清除剩余页面的脏标志和 EXTENT_DELALLOC 标志，导致部分页面仍保持脏状态但缺少延迟分配标记。后续写回操作触发这些页面时，因找不到对应的 ordered extent 而进入 COW 修复路径，最终触发内核 BUG_ON() 导致系统崩溃。本地低权限攻击者可利用此漏洞造成拒绝服务。该漏洞自 btrfs 引入以来一直存在，影响所有使用 btrfs 文件系统的 Linux 内核版本。","severity":"MEDIUM","score":5.5,"aliases":["CVE-2024-57976"],"sources":["msrc"],"published":"2025-02-27T02:15:10Z","updated":"2026-06-17T08:14:21Z","remediation":"建议立即将 Linux 内核升级至 6.12.36、6.13.2 或 6.14 及以上版本，这些版本已包含 btrfs cow_file_range() 失败时 folio 清理的修复补丁。对于无法立即升级的系统，可限制本地用户对 btrfs 文件系统的写入权限以降低触发概率，但最有效的措施仍是安装内核安全更新。","status":"completed","collected_at":"2026-07-27T00:00:00Z","references":["https://git.kernel.org/stable/c/06f364284794f149d2abc167c11d556cf20c954b","https://git.kernel.org/stable/c/10b3772292bf1be45604ba83fd9650eb94382e78","https://git.kernel.org/stable/c/692cf71173bb41395c855acbbbe197d3aedfa5d4","https://github.com/CVEProject/cvelistV5/blob/50b2026c1039c6a81b95d80535c772b9d8685178/cves/2024/57xxx/CVE-2024-57976.json","https://github.com/TonneauBenjamin/ANSSI_Project/blob/f0e2d5e8be75f0351e759642d04d728399b4faa9/data/raw/first/CVE-2024-57976","https://github.com/NUS-Curiosity/KernJC/blob/798845a541a5396395c7e0c1670cb4872dac7105/db/vuln_desc/2024/CVE-2024-57976.yaml","https://github.com/bell-sw/osv-database/blob/027c37e8e73e99b2a68cafab2e6594bde5db273e/BELL-CVE/BELL-CVE-2024-57976.json","https://github.com/yarencheng/cve-devops-playground/blob/c54e59752dddfc9aa36c13774164384cfa0d1f04/content/CVE-2024-57976.md","https://github.com/joaop9425/manual-do-tecnico/blob/cc6e0f5304777f18e55db554da5372bc31d4cae1/src/content/noticias/2026/01/08/seguranca/cve-2024-57976-btrfs-do-proper-folio-cleanup-when--1767883725000.md","https://github.com/Patrowl/PatrowlHearsData/blob/050b62cac636d83be07e6d4c77e70114e1ca7c93/CVE/data/2024/CVE-2024-57976.json","https://github.com/Hashmire/cpeApplicabilityGeneratorPages/blob/4588dccb1f913705444975eb2a5eb79962bf2513/generated_pages/CVE-2024-57976.html","https://github.com/github/advisory-database/blob/fa1c2f93b0d15da115c038738e571c1a1553b4cc/advisories/unreviewed/2025/02/GHSA-7g3v-g92m-87wq/GHSA-7g3v-g92m-87wq.json","https://github.com/neuvector/vul-source/blob/83b6758c208f8fd7e22b7c88e002c3658ef467b8/ubuntu-cve-tracker/active/CVE-2024-57976"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":[],"repo_exp_urls":[],"has_poc":false,"has_exp":false,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/2024/AVE-2024-0657.toml"}]
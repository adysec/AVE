/2010.txt","https://github.com/github/advisory-database/blob/29919db3f954d9ce9be0e7e3cf177436392d45d3/advisories/unreviewed/2022/05/GHSA-fqw8-2987-hrr8/GHSA-fqw8-2987-hrr8.json","https://github.com/Patrowl/PatrowlHearsData/blob/db2f5eda64b048f89c93b57f05c779b62a05c5c9/CVE/data/2010/CVE-2010-1774.json","https://github.com/pombredanne/git.launchpad.net-ubuntu-cve-tracker-/blob/fcedabe073a8eb8b2e85c436aeec152320c7cde3/retired/CVE-2010-1774","https://github.com/xqcyberscore/nvt/blob/978f6a9acb495d7d669239530ffe6da5d631f4da/2011/gb_fedora_2011_1224_webkitgtk_fc13.nasl","https://github.com/openSUSE/news-o-o/blob/f00a24fa16e9d957a04b4b8d47c2090853697549/_posts/2010/2010-08-22-opensuse-weekly-news-issue-137-is-out.md","https://github.com/blackhook/nessus-plugins/blob/64177d96abbb07c58cf7e131046b067ebc61fcb5/I/itunes_9_2.nasl"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":[],"repo_exp_urls":[],"has_poc":false,"has_exp":false,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/2010/AVE-2010-0178.toml"},{"ave_id":"AVE-2010-0177","file_name":"2010/AVE-2010-0177.toml","cve_id":"CVE-2010-1771","title":"Apple Safari WebKit 字体处理释放后重用远程代码执行漏洞","description":"Apple Safari 浏览器使用的 WebKit 渲染引擎中存在释放后重用（Use-After-Free）漏洞，远程攻击者可通过诱导用户访问包含特制字体的恶意网页触发该漏洞。成功利用后，攻击者可获取目标系统的完全控制权限，实现任意代码执行或导致应用程序崩溃拒绝服务。该漏洞影响 Mac OS X 10.4 至 10.6 及 Windows 平台上的 Safari 浏览器，CVSS 评分 9.3，危害严重。Apple 已在 Safari 5.0/4.1 版本中修复此漏洞。","severity":"CRITICAL","score":9.3,"aliases":["CVE-2010-1771"],"sources":["tenable"],"published":"2010-06-11T19:30:23Z","updated":"2026-06-16T23:19:17Z","remediation":"立即将 Apple Safari 升级至 5.0 或更高版本（Mac OS X 10.4 用户升级至 Safari 4.1 或更高版本），该版本修复了 WebKit 字体处理中的释放后重用漏洞。可通过 Mac OS X 系统自带的软件更新功能（Apple 菜单 → 软件更新）或从 Apple 官网下载最新版 Safari 安装包完成升级。对于已停止支持的老旧系统（Mac OS X 10.5/10.6），建议迁移至受支持的操作系统版本以获得持续安全更新。","status":"completed","collected_at":"2026-07-27T00:00:00Z","references":["http://lists.apple.com/archives/security-announce/2010//Jun/msg00002.html","http://lists.apple.com/archives/security-announce
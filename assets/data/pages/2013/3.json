[{"ave_id":"AVE-2013-0198","file_name":"2013/AVE-2013-0198.toml","cve_id":"CVE-2013-1690","title":"Mozilla Firefox/Thunderbird onreadystatechange事件处理释放后使用远程代码执行漏洞","description":"Mozilla Firefox 22.0 之前版本、Firefox ESR 17.0.7 之前版本、Thunderbird 17.0.7 之前版本及 Thunderbird ESR 17.0.7 之前版本中存在释放后使用（Use-After-Free）漏洞。该漏洞源于浏览器在处理 onreadystatechange 事件与页面重新加载的交互时，未能正确管理 DocumentViewerImpl 对象的内存生命周期，导致已释放的内存区域被访问。远程攻击者可构造恶意网页，诱使用户访问，触发程序尝试在未映射内存位置执行数据，造成拒绝服务或任意代码执行。该漏洞已被 CISA KEV 收录，存在 Metasploit 公开利用模块，影响范围广泛。","severity":"HIGH","score":8.8,"aliases":["CVE-2013-1690"],"sources":["kev"],"published":"2013-06-26T03:19:10Z","updated":"2026-06-16T23:51:55Z","remediation":"升级 Firefox 至 22.0 及以上版本，Firefox ESR 升级至 17.0.7 及以上版本，Thunderbird 升级至 17.0.7 及以上版本。如无法立即升级，可在浏览器中禁用 JavaScript（about:config 设置 javascript.enabled=false）作为临时缓解措施，但会严重影响正常功能。","status":"completed","collected_at":"2026-07-22T00:00:00Z","references":["http://lists.opensuse.org/opensuse-security-announce/2013-07/msg00003.html","http://lists.opensuse.org/opensuse-security-announce/2013-07/msg00004.html","http://lists.opensuse.org/opensuse-security-announce/2013-07/msg00005.html","http://lists.opensuse.org/opensuse-security-announce/2013-07/msg00006.html","http://lists.opensuse.org/opensuse-security-announce/2013-07/msg00010.html","http://lists.opensuse.org/opensuse-security-announce/2013-07/msg00011.html","http://rhn.redhat.com/errata/RHSA-2013-0981.html","http://rhn.redhat.com/errata/RHSA-2013-0982.html","http://www.debian.org/security/2013/dsa-2716","http://www.debian.org/security/2013/dsa-2720","http://www.mozilla.org/security/announce/2013/mfsa2013-53.html","http://www.securityfocus.com/bid/60778","http://www.ubuntu.com/usn/USN-1890-1","http://www.ubuntu.com/usn/USN-1891-1","https://bugzilla.mozilla.org/show_bug.cgi?id=857883","https://bugzilla.mozilla.org/show_bug.cgi?id=901365","https://oval.cisecurity.org/repository/search/definition/oval%3Aorg.mitre.oval%3Adef%3A16996","https://www.cisa.gov/known-exploited-vulnerabilities-catalog?field_cve=CVE-2013-1690","https://www.exploit-db.com/exploits/27429","https://github.com/trickest/cve/blob/ed228d55b7972f63e700a35a54fbcd94064b9ade/2013/CVE-2013-1690.md","https://github.com/nomi-sec/PoC-in-GitHub/blob/3c5116308718006831f8b0ac674f891f3d553471/2013/CVE-2013-1690.json","https://github.com/LiuCan01/cve-list-pro/blob/78b55511cee3604c22d518e32822f0435d0cacc0/cve-list/CVE-2013/CVE-2013-1690","https://github.com/ARPSyndicate/suricata-vedas/blob/fe24794ad36564b5bbc7c69101525011387b8650/2013/CVE-2013-1690.rules","https://github.com/fankh/vulnerability-poc/blob/ffa50060b7ba6ae58d60d6d90533e77eaf10d466/2013/CVE-2013-1690/README_KO.md","https://github.com/e-m-b-a/emba/blob/4d0f24b3edae0bdb5391177851bad3be54ecea0f/config/msf_cve-db.txt","https://github.com/ycdxsb/PocOrExp_in_Github/blob/e8fb8c8d4f5de912b7778f3aec7367ca61a10f66/2013/README.md","https://github.com/a-dhaou-tekup/VRA/blob/3e4f21c329250c5eca327489d3fd5be9b398ce7b/data/rag_corpus/cisa_kev_notes/CVE-2013-1690.txt","https://github.com/cyberdudebivash/cyberdudebivash-ai-security-hub/blob/13403e1745f63237e7ef6d51562fb36112320d77/frontend/cve/CVE-2013-1690.html","https://github.com/vulncheck-oss/0day.today.archive/blob/3664abdd71985a44aff3260896a8f36e2f4a9682/remote-exploits/21082.txt","https://github.com/vlad902/annotated-fbi-tbb-exploit"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":["https://raw.githubusercontent.com/adysec/AVE/main/pocs/2013/POC-AVE-2013-0198.toml"],"repo_exp_urls":["https://raw.githubusercontent.com/adysec/AVE/main/exploits/2013/EXP-AVE-2013-0198.toml"],"has_poc":true,"has_exp":true,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/2013/AVE-2013-0198.toml"},{"ave_id":"AVE-2013-0208","file_name":"2013/AVE-2013-0208.toml","cve_id":"CVE-2013-2465","title":"Oracle Java SE 2D子件远程代码执行漏洞","description":"Oracle Java SE 和 OpenJDK 的 Java Runtime Environment (JRE) 组件中的 2D 子件存在安全漏洞，由于对图像通道验证不正确，远程攻击者可通过向目标系统发送特制的图像文件触发该漏洞，成功利用后可绕过 Java 沙箱保护机制实现任意代码执行。该漏洞影响 Java SE 7 Update 21 及更早版本、6 Update 45 及更早版本、5.0 Update 45 及更早版本以及 OpenJDK 7，CVSS 评分 9.8，危害等级严重。攻击者可通过诱导用户访问恶意网页或打开恶意文件触发漏洞，无需身份认证即可远程利用。Oracle 已在 2013 年 6 月关键补丁更新中修复此漏洞。","severity":"CRITICAL","score":9.8,"aliases":["CVE-2013-2465"],"sources":["kev"],"published":"2013-06-18T22:55:02Z","updated":"2026-06-16T23:53:30Z","remediation":"立即升级 Oracle Java SE 至 7 Update 25 及以上版本、6 Update 51 及以上版本、5.0 Update 46 及以上版本，或升级 OpenJDK 7 至包含修复的最新版本。如无法升级，可在浏览器中禁用 Java Applet 插件，或通过控制面板卸载 Java SE 运行时环境中的旧版本以降低攻击面。","status":"completed","collected_at":"2026-07-22T00:00:00Z","references":["http://advisories.mageia.org/MGASA-2013-0185.html","http://h20000.www2.hp.com/bizsupport/TechSupport/Document.jsp?objectID=c03898880","http://hg.openjdk.java.net/jdk7u/jdk7u-dev/jdk/rev/2a9c79db0040","http://lists.opensuse.org/opensuse-security-announce/2013-07/msg00026.html","http://lists.opensuse.org/opensuse-security-announce/2013-07/msg00027.html","http://lists.opensuse.org/opensuse-security-announce/2013-07/msg00028.html","http://lists.opensuse.org/opensuse-security-announce/2013-07/msg00029.html","http://lists.opensuse.org/opensuse-security-announce/2013-07/msg00031.html","http://lists.opensuse.org/opensuse-security-announce/2013-08/msg00000.html","http://lists.opensuse.org/opensuse-security-announce/2013-08/msg00003.html","http://marc.info/?l=bugtraq&m=137545505800971&w=2","http://marc.info/?l=bugtraq&m=137545592101387&w=2","http://rhn.redhat.com/errata/RHSA-2013-0963.html","http://rhn.redhat.com/errata/RHSA-2013-1059.html","http://rhn.redhat.com/errata/RHSA-2013-1060.html","http://rhn.redhat.com/errata/RHSA-2013-1081.html","http://rhn.redhat.com/errata/RHSA-2013-1455.html","http://rhn.redhat.com/errata/RHSA-2013-1456.html","http://secunia.com/advisories/54154","http://security.gentoo.org/glsa/glsa-201406-32.xml","http://www-01.ibm.com/support/docview.wss?uid=swg21642336","http://www.mandriva.com/security/advisories?name=MDVSA-2013:183","http://www.oracle.com/technetwork/topics/security/javacpujun2013-1899847.
loits/19759"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":[],"repo_exp_urls":[],"has_poc":false,"has_exp":false,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/2000/AVE-2000-0186.toml"},{"ave_id":"AVE-2000-0509","file_name":"2000/AVE-2000-0509.toml","cve_id":"CVE-2000-0166","title":"Pragma Systems InterAccess TelnetD Server 缓冲区溢出远程代码执行漏洞","description":"Pragma Systems InterAccess TelnetD Server 4.0 Build 4 存在缓冲区溢出漏洞，远程攻击者可通过向 TelnetD 服务发送超长的登录用户名触发该漏洞，导致缓冲区溢出，进而能够在目标系统上执行任意命令。该漏洞无需身份认证即可利用，CVSS 评分高达 10.0，危害等级严重。","severity":"CRITICAL","score":10.0,"aliases":["CVE-2000-0166"],"sources":["avd"],"published":"2000-02-21T05:00:00.000","updated":"2026-06-16T21:51:08.287","remediation":"建议立即升级至 Pragma InterAccess TelnetD 4.1 及以上版本，该版本已修复缓冲区溢出漏洞。如厂商已停止维护，应彻底停用 InterAccess TelnetD 服务，改用 OpenSSH 等安全远程访问方案，并在防火墙禁用 Telnet 端口（23/TCP）。","status":"completed","collected_at":"2026-07-22T00:00:00Z","references":["http://marc.info/?l=bugtraq&m=95142756403323&w=2","http://www.securityfocus.com/bid/995","http://www.securityfocus.com/templates/archive.pike?list=1&msg=NCBBKFKDOLAGKIAPMILPGEJHCCAA.labs%40ussrback.com","https://www.exploit-db.com/exploits/19755","https://github.com/CVEProject/cvelistV5/blob/9b149e946381b5dfe67f5c76cee65997e05f3a01/cves/2000/0xxx/CVE-2000-0166.json","https://github.com/LiuCan01/cve-list-pro/blob/78b55511cee3604c22d518e32822f0435d0cacc0/cve-list/CVE-2000/CVE-2000-0166","https://github.com/fankh/vulnerability-poc/blob/ffa50060b7ba6ae58d60d6d90533e77eaf10d466/2000/CVE-2000-0166/README.md","https://github.com/yarencheng/cve-devops-playground/blob/7f1c35ad28226319c149c937b6a2e7a1986924ce/content/CVE-2000-0166.md","https://github.com/Patrowl/PatrowlHearsData/blob/b8e6f3ed799539d1c038cf82ae94c10d35c39858/CVE/data/2000/CVE-2000-0166.json","https://github.com/github/advisory-database/blob/ca4032f687e5627fcf86913a0441b18137902527/advisories/unreviewed/2022/04/GHSA-hhr8-x4hv-57hf/GHSA-hhr8-x4hv-57hf.json","https://github.com/intSpLoiT/intframework/blob/eabaa799d0260aa52b735fa9769266d1ce4b64ef/modules/cve_list.txt","https://github.com/oasis-open/cti-stix-common-objects/blob/55ba7598cbd5a52577b6887871505d931d85cb61/objects/vulnerability/vulnerability--30da608f-1481-4b5e-afe1-c04543853658.json","https://github.com/andreafioraldi/ToolsForCyberChallenge/blob/197d3dfd204cf1b9d1af1451455c8831c3ff9948/generated/files_2.list.dict","https://github.com/fkie-cad/nvd-json-data-feeds/blob/be49e1130e6bdca092999eb707c2ff3d8d256a74/CVE-2000/CVE-2000-01xx/CVE-2000-0166.json"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":[],"repo_exp_urls":[],"has_poc":false,"has_exp":false,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/2000/AVE-2000-0509.toml"},{"ave_id":"AVE-2000-0500","file_name":"2000/AVE-2000-0500.toml","cve_id":"CVE-2000-0160","title":"Microsoft Internet Explorer ActiveX Active Setup 组件远程代码执行漏洞","description":"Microsoft Internet Explorer 4.x 及 5.x 版本中的 Active Setup ActiveX 组件存在安全漏洞，远程攻击者可通过构造声称软件厂商为 Microsoft 的特制网页，诱使用户访问后绕过安全提示在未经用户确认的情况下静默安装任意软件组件。该漏洞可被用于传播恶意软件或安装未授权程序，影响广泛使用的旧版 IE 浏览器用户，需用户交互触发，CVSS 评分 7.6，危害等级高。","severity":"HIGH","score":7.6,"aliases":["CVE-2000-0160"],"sources":["avd"],"published":"2000-02-21T05:00:00.000","updated":"2026-06-16T21:51:07.510","remediation":"升级 Internet Explorer 至 5.01 SP2 或更高版本，该漏洞已在后续版本中修复。在安全区域设置中将 ActiveX 控件和插件设为禁用，并将 Internet 区域安全级别设为高。当前建议停止使用已停止支持的 IE 浏览器，改用 Microsoft Edge 以获得持续安全更新。","status":"completed","collected_at":"2026-07-22T00:00:00Z","references":["http://www.securityfocus.com/templates/archive.pike?list=1&date=2000-02-15&msg=20000221103938.T21312%40securityfocus.com","https://github.com/CVEProject/cvelistV5/blob/f619ecf484fdb11d96af754b241cfa934df131f9/cves/2000/0xxx/CVE-2000-0160.json","https://github.com/LiuCan01/cve-list-pro/blob/78b55511cee3604c22d518e32822f0435d0cacc0/cve-list/CVE-2000/CVE-2000-0160","https://github.com/yarencheng/cve-devops-playground/blob/7f1c35ad28226319c149c937b6a2e7a1986924ce/content/CVE-2000-0160.md","https://github.com/Patrowl/PatrowlHearsData/blob/df56f4cca3ff4a807de70444fbb8d3458b1d46ca/CVE/data/2000/CVE-2000-0160.json","https://github.com/github/advisory-database/blob/ca4032f687e5627fcf86913a0441b18137902527/advisories/unreviewed/2022/04/GHSA-xwwx-jfc6-33fv/GHSA-xwwx-jfc6-33fv.json","https://github.com/intSpLoiT/intframework/blob/eabaa799d0260aa52b735fa9769266d1ce4b64ef/modules/cve_list.txt","https://github.com/olbat/nvdcve/blob/1c14ae4816efb67123e0664d061a6cbfe48f234b/nvdcve/CVE-2000-0160.json","https://github.com/KTZgraph/sarenka/blob/f1fb931ab722d6c096d581ed6e3c5966d799fbaa/sarenka/feeds/cve_details/cve_all_details_152200_152300.json","https://github.com/nomi-sec/CVE-Easy-List/blob/d49ed792663c6bbe758cf7f56c6f7fd7c4afcbb1/2000.tsv","https://github.com/SpeeDr00t/speedr00t.github.com/blob/0380f0c2190556fabe90257cb6c0034a42f68951/securityfocus/0x1000/999/info.html"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":[],"repo_exp_urls":[],"has_poc":false,"has_exp":false,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/2000/AVE-2000-0500.toml"},{"ave_id":"AVE-2000-0185","file_name":"2000/AVE-2000-0185.toml","cve_id":"CVE-2000-0210","title":"Sun Flex License Manager 符号链接漏洞","description":"Sun Flex License Manager 中的 lit 程序存在符号链接漏洞，本地用户可通过在临时文件目录中创建恶意符号链接，诱使 lit 程序以更高权限写入任意文件，实现本地提权。该漏洞影响 Sun Workshop 5.0 等使用 Sun FlexLM 的产品，CVSS 评分 1.2，危害等级低。建议限制 lit 程序的执行权限或升级到不受影响的版本。","severity":"LOW","score":1.2,"aliases":["CVE-2000-0210"],"sources":["avd"],"published":"2000-02-21T05:00:00.000","updated":"2026-06-16T21:51:13.927","remediation":"立即移除 lit 程序的 setuid/setgid 权限位：`chmod u-s /path/to/lit` 及 `chmod g-s /path/to/lit`，防止本地用户通过符号链接提升权限修改任意文件。限制 lit 可执行文件的执行权限仅对授权管理员开放。由于 Sun Microsystems 已停止运营且产品生命周期终结，官方不再提供安全更新，建议迁移至替代授权管理方案。","status":"completed","collected_at":"2026-07-22T00:00:00Z","references":["http://www.securityfocus.com/bid/998","https://www.exploit-db.com/exploits/19757","https://github.com/CVEProject/cvelistV5/blob/f410e8277949e9113269176595e70bd0c0230a55/cves/2000/0xxx/CVE-2000-0210.json","https:
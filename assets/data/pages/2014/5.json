7525da7589a7eb8e3a89c7fdc4d3547af75e757/%E6%9D%83%E9%99%90%E6%94%BB%E9%98%B2/linux/%E5%86%85%E6%A0%B8%E6%8F%90%E6%9D%83/CVE-2014-0196/README.md","https://github.com/tempbottle/CVE-2014-0196","https://github.com/SunRain/CVE-2014-0196"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":[],"repo_exp_urls":[],"has_poc":false,"has_exp":false,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/2014/AVE-2014-0077.toml"},{"ave_id":"AVE-2014-0066","file_name":"2014/AVE-2014-0066.toml","cve_id":"CVE-2014-0130","title":"Ruby on Rails 隐式渲染功能目录遍历漏洞","description":"Ruby on Rails 的隐式渲染（implicit render）功能中存在目录遍历漏洞，当启用特定路由通配（route globbing）配置时，远程攻击者无需身份认证即可通过发送特制请求，利用 actionpack/lib/abstract_controller/base.rb 中的路径遍历缺陷读取服务器上的任意文件。该漏洞影响 Rails 3.2.18 之前版本、4.0.5 之前版本及 4.1.1 之前版本，CVSS 评分 7.5，危害等级高，可导致敏感信息泄露。","severity":"HIGH","score":7.5,"aliases":["CVE-2014-0130"],"sources":["kev"],"published":"2014-05-07T10:55:04Z","updated":"2026-06-17T00:02:21Z","remediation":"升级 Rails 至 3.2.18 / 4.0.5 / 4.1.1 及以上版本。如无法立即升级，在路由配置中禁用 globbing 通配符匹配（如 `*path` 格式的路由），并限制控制器隐式渲染的模板路径白名单，避免未授权文件读取。","status":"completed","collected_at":"2026-07-23T00:00:00Z","references":["http://matasano.com/research/AnatomyOfRailsVuln-CVE-2014-0130.pdf","http://rhn.redhat.com/errata/RHSA-2014-1863.html","http://www.securityfocus.com/bid/67244","https://groups.google.com/forum/message/raw?msg=rubyonrails-security/NkKc7vTW70o/NxW_PDBSG3AJ","https://www.cisa.gov/known-exploited-vulnerabilities-catalog?field_cve=CVE-2014-0130","https://github.com/trickest/cve/blob/ed228d55b7972f63e700a35a54fbcd94064b9ade/2014/CVE-2014-0130.md","https://github.com/nomi-sec/PoC-in-GitHub/blob/3c5116308718006831f8b0ac674f891f3d553471/2014/CVE-2014-0130.json","https://github.com/rubysec/rubysec.github.io/blob/a065f3c765e12d5989e4cfc616d3f15b9c0f99ef/advisories/_posts/2014-05-06-CVE-2014-0130.md","https://github.com/LiuCan01/cve-list-pro/blob/78b55511cee3604c22d518e32822f0435d0cacc0/cve-list/CVE-2014/CVE-2014-0130","https://github.com/Tabll/gemnasium-db/blob/de1cbf8802a4c6060caaa5924b50812f2a62fead/gem/rails/CVE-2014-0130.yml","https://github.com/a-dhaou-tekup/VRA/blob/3e4f21c329250c5eca327489d3fd5be9b398ce7b/data/rag_corpus/cisa_kev_notes/CVE-2014-0130.txt","https://github.com/diannaofengzi/POC/blob/14d504f7488db9229f6f02be54aab53e3cfee0dc/databases/2014/database/CVE-2014-0130/cve-2014-0130-omarkurt.md","https://github.com/cyberdudebivash/cyberdudebivash-ai-security-hub/blob/13403e1745f63237e7ef6d51562fb36112320d77/frontend/cve/CVE-2014-0130.html","https://github.com/ycdxsb/PocOrExp_in_Github/blob/0d14a0cfa7592186abb57c4f3075d04b75717386/2014/README.md","https://github.com/aldaor/HackerOneReports/blob/1e71d1e9ac68e9adc923fe9bbd809aac776befe3/CodeInjection/134032.txt","https://github.com/omarkurt/cve-2014-0130"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":[],"repo_exp_urls":[],"has_poc":false,"has_exp":false,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/2014/AVE-2014-0066.toml"},{"ave_id":"AVE-2014-0007","file_name":"2014/AVE-2014-0007.toml","cve_id":"CVE-2014-1843","title":"Titan FTP Server 目录遍历漏洞","description":"Titan FTP Server 10.40 build 1829之前版本的Web界面存在目录遍历漏洞。远程攻击者可通过向src参数传递包含`..`（点点）的路径，以Properties动作访问任意主文件夹的属性信息，导致敏感信息泄露。该漏洞影响Titan FTP Server 10.40之前版本，CWE-22目录遍历类型，攻击者无需身份认证即可利用。","severity":"MEDIUM","score":5.0,"aliases":["CVE-2014-1843"],"sources":["nuclei"],"published":"2014-04-29T10:37:03Z","updated":"2026-06-17T00:05:38Z","remediation":"升级 Titan FTP Server 至 10.40 build 1829 或更高版本，该版本已修复目录遍历漏洞。如无法立即升级，可在 Web 界面配置中限制 src 参数路径访问范围，禁止包含 `../` 的请求，或通过反向代理规则过滤包含目录遍历特征的 URL 请求作为临时缓解措施。","status":"completed","collected_at":"2026-07-22T00:00:00Z","references":["http://archives.neohapsis.com/archives/fulldisclosure/2014-02/0092.html","http://www.exploit-db.com/exploits/31579","http://www.osvdb.org/103197","http://www.securityfocus.com/bid/65469","https://www.exploit-db.com/exploits/31579","https://github.com/projectdiscovery/nuclei-templates/blob/main/network/cves/2014/CVE-2014-1843.yaml","
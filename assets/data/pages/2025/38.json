ublished":"2025-01-14T18:15:55Z","updated":"2026-06-17T08:43:05Z","remediation":"立即安装 Microsoft 2025 年 1 月安全更新（KB5050004），可通过 Windows Update 自动获取或从 Microsoft Update Catalog 手动下载。受影响版本包括 Windows 10/11 多个版本及 Windows Server 2012–2025，更新后内核版本将提升至修复版本（如 Win11 24H2 ≥ 10.0.26100.2894）。临时缓解措施：限制低权限用户本地登录，并监控内核内存访问异常行为。","status":"completed","collected_at":"2026-08-03T00:00:00Z","references":["https://msrc.microsoft.com/update-guide/vulnerability/CVE-2025-21318","https://github.com/CVEProject/cvelistV5/blob/b37ddadc32d456372cb07846a95b411ce7a32d9f/cves/2025/21xxx/CVE-2025-21318.json","https://github.com/cisagov/vulnrichment/blob/0fed28f73afbb5eb38c05b167f63ae6a3a91eb60/2025/21xxx/CVE-2025-21318.json","https://github.com/Patrowl/PatrowlHearsData/blob/c31c0a9b9af147bd58078ebf7769418f19d3f2e1/SSVC/data/2025/CVE-2025-21318.json","https://github.com/Patrowl/PatrowlHearsData/blob/c31c0a9b9af147bd58078ebf7769418f19d3f2e1/CVE/data/2025/CVE-2025-21318.json","https://github.com/fankh/vulnerability-poc/blob/64b13d8efa50a8ee93bb0dbbd9f55f6f284cfd82/2025/CVE-2025-21318/README.md","https://github.com/nomi-sec/NVD-Database/blob/23dc120c34402aaa65883c51c1d03b3cb02c20cb/2025/CVE-2025-21318.json","https://github.com/fankh/vulnerability-poc/blob/64b13d8efa50a8ee93bb0dbbd9f55f6f284cfd82/2025/CVE-2025-21318/poc.py","https://github.com/olbat/nvdcve/blob/fe7f195231342e1e88104679c53c965e9a67ac35/nvdcve/CVE-2025-21318.json","https://github.com/opencve/opencve-kb/blob/124ab3e5e42be0a51c386ce59b3e73127df55887/2025/CVE-2025-21318.json","https://github.com/imSkows/Cyber-Vulnerability-Analysis-Data/blob/db26c44c5f45c25514223a46675daec7eea03092/data/first/CVE-2025-21318"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":[],"repo_exp_urls":[],"has_poc":false,"has_exp":false,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/2025/AVE-2025-0777.toml"}]
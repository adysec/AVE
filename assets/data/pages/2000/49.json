y-database/blob/fa1c2f93b0d15da115c038738e571c1a1553b4cc/advisories/unreviewed/2022/04/GHSA-2wm7-6r5c-mjpc/GHSA-2wm7-6r5c-mjpc.json","https://github.com/yarencheng/cve-devops-playground/blob/c54e59752dddfc9aa36c13774164384cfa0d1f04/content/CVE-2000-0546.md","https://github.com/intSpLoiT/intframework/blob/eabaa799d0260aa52b735fa9769266d1ce4b64ef/modules/cve_list.txt","https://github.com/KTZgraph/sarenka/blob/f1fb931ab722d6c096d581ed6e3c5966d799fbaa/sarenka/feeds/cve_details/cve_all_details_152500_152600.json","https://github.com/rootio-avr/public-patches-catalog/blob/07753db6985389331dd1819e76ef8fdf125ebf3f/alpine/3.18/krb5/amd64/APKBUILD","https://github.com/oasis-open/cti-stix-common-objects/blob/55ba7598cbd5a52577b6887871505d931d85cb61/objects/vulnerability/vulnerability--58bb8bac-ab30-47db-87fc-67338a81bfc9.json"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":[],"repo_exp_urls":[],"has_poc":false,"has_exp":false,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/2000/AVE-2000-0629.toml"},{"ave_id":"AVE-2000-0438","file_name":"2000/AVE-2000-0438.toml","cve_id":"CVE-2000-0527","title":"3R Soft MailStudio 2000 userreg.cgi 远程命令执行漏洞","description":"3R Soft MailStudio 2000 2.0 及更早版本中的 userreg.cgi CGI 程序存在任意命令执行漏洞。远程攻击者无需身份认证即可通过向 userreg.cgi 提交包含 shell 元字符（如管道符、分号等）的特制请求，利用 CGI 程序对用户输入过滤不严的缺陷，在服务器上以 Web 服务进程权限执行任意系统命令，可导致服务器被完全控制、敏感数据泄露或进一步横向渗透。","severity":"CRITICAL","score":10.0,"aliases":["CVE-2000-0527"],"sources":["avd"],"published":"2000-06-09T04:00:00Z","updated":"2026-06-16T21:51:55Z","remediation":"立即删除或禁用服务器上的 userreg.cgi 脚本，或限制其仅允许本地访问。在 Web 服务器（Apache/IIS）层面配置输入过滤规则，拦截 shell 元字符（如 `;` `|` `&` `` ` `` `$`）。由于 3R Soft 已停止维护 MailStudio 2000，建议迁移至其他受支持的邮件服务器软件。","status":"completed","collected_at":"2026-07-27T00:00:00Z","references":["http://archives.neohapsis.com/archives/bugtraq/2000-06/0081.html","http://www.securityfocus.com/bid/1335","https://www.exploit-db.com/exploits/20007","https://github.com/CVEProject/cvelistV5/blob/bb04e7276eb5376f975ca811b9a340
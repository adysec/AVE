tadata/glsa/glsa-200410-03.xml","https://github.com/nomi-sec/NVD-Database/blob/23dc120c34402aaa65883c51c1d03b3cb02c20cb/2004/CVE-2004-0911.json"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":[],"repo_exp_urls":[],"has_poc":false,"has_exp":false,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/2001/AVE-2001-0219.toml"},{"ave_id":"AVE-2001-0218","file_name":"2001/AVE-2001-0218.toml","cve_id":"CVE-2001-0553","title":"SSH Secure Shell 3.0 sshd2 短密码认证绕过漏洞","description":"SSH Secure Shell 3.0.0 在 Unix 系统上对 sshd2 守护进程的密码认证机制存在缺陷，未正确处理短密码字段账户（如使用 \"NP\" 标记锁定的账户），导致本地用户可绕过认证直接访问这些受限账户。该漏洞影响运行 SSH Secure Shell 3.0.0 的 Unix 系统，攻击者需具备本地系统访问权限，利用短密码字段缺陷即可获取锁定账户的完全访问权限，CVSS 7.2 分（本地访问、低复杂度、无需认证、完全破坏 CIA 三要素），属高危本地提权漏洞。","severity":"HIGH","score":7.2,"aliases":["CVE-2001-0553"],"sources":["exploitdb"],"published":"2001-08-14T04:00:00Z","updated":"2026-06-16T21:54:31Z","remediation":"立即升级 OpenSSH 到 7.9 或更高版本（例如 8.9 及更高主版本），并确保使用最新的安全补丁支持现代密码格式和安全验证机制。修改 /etc/ssh/sshd_config 启用 \"PasswordAuthentication yes\"和 \"PubkeyAuthentication yes\" 并添加 \"PermitRootLogin no\" 和 \"MaxAuthTries 3\"。配置禁止空密码并强制使用复杂的密码策略，建议每次安全事件后更换所有用户密码，并立即禁用所有旧版 SSH 服务（特别是原生支持的任何基于 SSH2 3.0 的服务），这些服务无法升级或将在支持结束后关闭。","status":"completed","collected_at":"2026-07-22T00:00:00Z","references":["http://archives.neohapsis.com/archives/bugtraq/2001-07/0486.html","http://www.ciac.org/ciac/bulletins/l-121.shtml","http://www.kb.cert.org/vuls/id/737451","http://www.osvdb.org/586","http://www.securityfocus.com/bid/3078","http://www.ssh.com/products/ssh/exploit.cfm","https://exchange.xforce.ibmcloud.com/vulnerabilities/6868","https://www.exploit-db.com/exploits/21021","https://github.com/CVEProject/cvelistV5/blob/58bdedd85e346c3efc30a2f8424c96c50aa4db2e/cves/2001/0xxx/CVE-2001-0553.json","https://github.com/LiuCan01/cve-list-pro/blob/78b55511cee3604c22d518e32822f0435d0cacc0/cve-list/CVE-2001/CVE-2001-0553","https://github.com/yarencheng/cve-devops-playground/blob/cbe73d6bdcced13ea57f08566d6bbf5345864f7e/content/CVE-2001-0553.md","https://github.com/Patrowl/PatrowlHearsData/blob/7b14132e5983d4643412f6d4f89beb409b809e9f/CVE/data/2001/CVE-2001-0553.json","https://github.com/github/advisory-database/blob/7007cbf91cfd56bead27c222fc520c733ed0ad71/advisories/unreviewed/2022/04/GHSA-4jrf-5jjq-9v28/GHSA-4jrf-5jjq-9v28.json","https://github.com/blackhook/nessus-plugins/blob/64177d96abbb07c58cf7e131046b067ebc61fcb5/S/ssh3_passwd.nasl","https://github.com/intSpLoiT/intframework/blob/eabaa799d0260aa52b735fa9769266d1ce4b64ef/modules/cve_list.txt","https://github.com/KTZgraph/sarenka/blob/f1fb931ab722d6c096d581ed6e3c5966d799fbaa/sarenka/feeds/cve_details/cve_all_details_151300_151400.json","https://github.com/andreafioraldi/ToolsForCyberChallenge/blob/197d3dfd204cf1b9d1af1451455c8831c3ff9948/generated/files_1.list.dict","https://github.com/nomi-sec/NVD-Database/blob/23dc120c34402aaa65883c51c1d03b3cb02c20cb/2001/CVE-2001-0553.json"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":[],"repo_exp_urls":[],"has_poc":false,"has_exp":false,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/2001/AVE-2001-0218.toml"},{"ave_id":"AVE-2001-0212","file_name":"2001/AVE-2001-0212.toml","cve_id":"CVE-2001-0548","title":"Sun Solaris DTMail 环境变量缓冲区溢出漏洞","description":"Solaris 2.6 及 7.0 系统中的 dtmail 程序存在缓冲区溢出漏洞。由于 dtmail 在处理 MAIL 环境变量时未对输入长度进行有效边界检查，本地攻击者可通过设置超长 MAIL 环境变量触发栈缓冲区溢出，覆盖返回地址或函数指针，从而劫持程序执行流程。成功利用此漏洞可使攻击者以 dtmail 进程权限（通常为 root 或 mail 用户权限）执行任意代码，实现本地权限提升。攻击者需拥有本地系统账户并具备 shell 访问权限即可发起攻击，无需用户交互。","severity":"MEDIUM","score":4.6,"aliases":["CVE-2001-0548"],"sources":["exploitdb"],"published":"2001-08-14T04:00:00Z","updated":"2026-06-16T21:54:30Z","remediation":"该漏洞影响已停止维护的 Solaris 2.6 和 Solaris 7，官方已不再提供安全更新。建议立即升级到受支持的 Solaris 11 或更高版本；若无法升级，可临时移除 dtmail 的 setuid 权限（`chmod 555 /usr/dt/bin/dtmail`）以阻断本地提权，同时限制非授权用户对 dtmail 的访问。","status":"completed","collected_at":"2026-07-22T00:00:00Z","references":["http://marc.info/?l=bugtraq&m=99598918914068&w=2","http://www.securityfocus.com/bid/3081","https://exchange.xforce.ibmcloud.com/vulnerabilities/6879","https://www.exploit-db.com/exploits/21024","https://github.com/trickest/cve/blob/ed228d55b7972f63e700a35a54fbcd94064b9ade/2001/CVE-2001-0548.md","https://github.com/CVEProject/cvelistV5/blob/58bdedd85e346c3efc30a2f8424c96c50aa4db2e/cves/2001/0xxx/CVE-2001-0548.json","https://github.com/LiuCan01/cve-list-pro/blob/78b55511cee3604c22d518e32822f0435d0cacc0/cve-list/CVE-2001/CVE-2001-0548","https://github.com/nomi-sec/NVD-Database/blob/23dc120c34402aaa65883c51c1d03b3cb02c20cb/2001/CVE-2001-0548.json","https://github.com/mabitoski/cve_submodules/blob/44ad7e2705b3aef1b2ffaf64bd47596c10a6c2e4/2001/CVE-2001-0548.md","https://github.com/github/advisory-database/blob/0f14531dae9947fef349fa696ac83d6fc56f601e/advisories/unreviewed/2022/04/GHSA-h5ww-48rq-646f/GHSA-h5ww-48rq-646f.json","https://github.com/intSpLoiT/intframework/blob/eabaa799d0260aa52b735fa9769266d1ce4b64ef/modules/cve_list.txt","https://github.com/olbat/nvdcve/blob/5b92f5917a4a825187ccaac594f43456a77ea8f3/nvdcve/CVE-2001-0548.json","https://github.com/andreafioraldi/ToolsForCyberChallenge/blob/197d3dfd204cf1b9d1af1451455c8831c3ff9948/generated/files_2.list.dict","https://github.com/Yuning-J/VulnerabilityClassifier/blob/c0f06c21b73c26b5ee2b75c21a498eb04eada4b5/threatPrediction/cveIDThreatType/cve_idgainpre"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":[],"repo_exp_urls":[],"has_poc":false,"has_exp":false,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/2001/AVE-2001-0212.toml"},{"ave_id":"AVE-2001-0211","file_name":"2001/AVE-2001-0211.toml","cve_id":"CVE-2001-0538","title":"Microsoft Outlook ActiveX 控件远程代码执行漏洞","description":"Microsoft Outlook 2002 及更早版本中的 Outlook View ActiveX 控件存在远程代码执行漏洞。远程攻击者可通过向目标用户发送特制的恶意 HTML 电子邮件或诱导用户访问包含恶意代码的网页来触发该漏洞，在用户打开邮件或预览邮件内容时自动执行任意命令。该漏洞影响 Outlook 98/2000/2002 等多个版本，CVSS 评分 10.0，危害等级严重。攻击无需身份认证且复杂度低，可完全控制受影响的系统。","severity":"CRITICAL","score":10.0,"aliases":["CVE-2001-0538"],"sources":["exploitdb"],"published":"2001-08-14T04:00:00Z","updated":"2026-06-16T21:54:29Z","remediation":"立即安装 Microsoft 2001 年 8 月发布的 Outlook 安全更新 (MS01-038)，该更新为 Outlook 2002 及更早版本添加了 Email Security Update，限制 ActiveX 控件在电子邮件中的自动执行。如无法安装补丁，可配置 Outlook 安全设置将「在 HTML 邮件中运行 ActiveX 控件」选项禁用，或使用 Outlook 2003 及以上版本替代。同时建议在邮件网关层面过滤包含 ActiveX 控件的 HTML 邮件。","status":"completed","collected_at":"2026-07-22T00:00:00Z","references":["http://marc.info/?l=bugtraq&m=99496431214078&w=2","http://www.ciac.org/ciac/bulletins/l-113.shtml","http://www.kb.cert.org/vuls/id/131569","http://www.ntbugtraq.com/default.asp?pid=36&sid=1&A2=ind0107&L=ntbugtraq&F=P&S=&P=862","http://www.securityfocus.com/bid/3025","https://docs.microsoft.com/en-us/security-updates/securitybulletins/2001/ms01-038","https://exchange.xforce.ibmcloud.com/vulnerabilities/6831","https://www.exploit-db.com/exploits/21003","https://github.com/trickest/cve/blob/ed228d55b7972f63e700a35a54fbcd94064b9ade/2001/CVE-2001-0538.md","https://github.com/CVEProject/cvelistV5/blob/58bdedd85e346c3efc30a2f8424c96c50aa4db2e/cves/2001/0xxx/CVE-2001-0538.json","https://github.com/LiuCan01/cve-list-pro/blob/78b55511cee3604c22d518e32822f0435d0cacc0/cve-list/CVE-2001/CVE-2001-0538","https://github.com/Patrowl/PatrowlHearsData/blob/ad583e79ed38e32f21eec5f8962c8f59146c10bc/CVE/data/2001/CVE-2001-0538.json","https://github.com/mabitoski/cve_submodules/blob/44ad7e2705b3aef1b2ffaf64bd47596c10a6c2e4/2001/CVE-2001-0538.md","https://github.com/github/advisory-database/blob/4d465198ab8436491a7618e7789ef7adce4c01e0/advisories/unreviewed/2022/04/GHSA-xxqr-h45r-xgm7/GHSA-xxqr-h45r-xgm7.json","https://github.com/intSpLoiT/intframework/blob/eabaa799d0260aa52b735fa9769266d1ce4b64ef/modules/cve_list.txt","https://github.com/KTZgraph/sarenka/blob/f1fb931ab722d6c096d581ed6e3c5966d799fbaa/sarenka/feeds/cve_details/cve_all_details_151300_151400.json","https://github.com/andreafioraldi/ToolsForCyberChallenge/blob/197d3dfd204cf1b9d1af1451455c8831c3ff9948/generated/files_0.list.dict","https://github.com/oasis-open/cti-st
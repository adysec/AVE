ces":["http://www.redhat.com/support/errata/RHSA-2003-151.html","http://www.redhat.com/support/errata/RHSA-2003-174.html","https://github.com/CVEProject/cvelistV5/blob/b37ddadc32d456372cb07846a95b411ce7a32d9f/cves/2003/0xxx/CVE-2003-0194.json","https://github.com/LiuCan01/cve-list-pro/blob/78b55511cee3604c22d518e32822f0435d0cacc0/cve-list/CVE-2003/CVE-2003-0194","https://github.com/Patrowl/PatrowlHearsData/blob/37be0559d0574b93d433d6c01d9f77ea4c420519/CVE/data/2003/CVE-2003-0194.json","https://github.com/nomi-sec/NVD-Database/blob/23dc120c34402aaa65883c51c1d03b3cb02c20cb/2003/CVE-2003-0194.json","https://github.com/opencve/opencve-kb/blob/7597ddfeff03aa9cd00b0ce83a368fad007497d9/2003/CVE-2003-0194.json","https://github.com/olbat/nvdcve/blob/fe7f195231342e1e88104679c53c965e9a67ac35/nvdcve/CVE-2003-0194.json","https://github.com/HORKimhab/poc-cve-collection/blob/1d7706ed603ab73481cbc20e5bea092e02e7c9be/2003/0xxx/CVE-2003-0194.md","https://github.com/fkie-cad/nvd-json-data-feeds/blob/e9b51a58e4ac0e6b00dc38147f459707e98ae056/CVE-2003/CVE-2003-01xx/CVE-2003-0194.json","https://github.com/aquasecurity/vuln-list-debian/blob/98c311c3ba3abe1f72f8d5cfae5eb671ae60d00f/tracker/CVE/2003/CVE-2003-0194.json","https://github.com/CVEProject/cvelist-dev/blob/5b8fbb570438e8094550205589cc6f1d122acc94/2003/0xxx/CVE-2003-0194.json"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":[],"repo_exp_urls":[],"has_poc":false,"has_exp":false,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/2003/AVE-2003-0061.toml"},{"ave_id":"AVE-2003-0058","file_name":"2003/AVE-2003-0058.toml","cve_id":"CVE-2003-0189","title":"Apache HTTP Server 认证模块拒绝服务漏洞","description":"Apache HTTP Server 2.0.40 至 2.0.45 版本在 Unix 系统上的认证模块存在线程安全漏洞。当使用 threaded MPM（多线程处理模块）时，crypt_r 或 crypt 函数未正确处理线程同步，导致远程攻击者可发送特制的认证请求触发条件竞争，使得合法用户名和密码的基础认证（Basic Authentication）失败，造成拒绝服务。该漏洞影响 Apache 2.0.40-2.0.45 版本，攻击者无需认证即可远程触发，危害等级中危。","severity":"MEDIUM","score":5.0,"aliases":["CVE-2003-0189"],"sources":["redhat"],"published":"2003-06-09T04:00:00Z","updated":"2026-06-16T22:01:43Z","remediation":"立即将 Apache HTTP Server 升级至 2.0.46 或更高版本（2.0 系列最终版为 2.0.65，建议直接升级至 2.4.x 系列最新版）。如无法升级，在 httpd.conf 中将 MPM 切换为 prefork（`ServerLimit 256; StartServers 5; MaxClients 256`），避免使用 worker 或 event 等线程化 MPM 以消除线程竞争条件。","status":"completed","collected_at":"2026-08-03T00:00:00Z","references":["http://distro.conectiva.com.br/atualizacoes/?id=a&anuncio=000661","http://marc.info/?l=bugtraq&m=105418115512559&w=2","http://secunia.com/advisories/8881","http://www.apache.org/dist/httpd/Announcement2.html","http://www.kb.cert.org/vuls/id/479268","http://www.redhat.com/support/errata/RHSA-2003-186.html","http://www.securityfocus.com/bid/7725","https://exchange.xforce.ibmcloud.com/vulnerabilities/12091","https://lists.apache.org/thread.html/54a42d4b01968df1117cea77fc53d6beb931c0e05936ad02af93e9ac%40%3Ccvs.httpd.apache.org%3E","https://lists.apache.org/thread.html/5df9bfb86a3b054bb985a45ff9250b0332c9ecc181eec232489e7f79%40%3Ccvs.httpd.apache.org%3E","https://lists.apache.org/thread.html/r0276683d8e1e07153fc8642618830ac0ade85b9ae0dc7b07f63bb8fc%40%3Ccvs.httpd.apache.org%3E","https://lists.apache.org/thread.html/r2cb985de917e7da0848c440535f65a247754db8b2154a10089e4247b%40%3Ccvs.httpd.apache.org%3E","https://lists.apache.org/thread.html/r5001ecf3d6b2bdd0b732e527654248abb264f08390045d30709a92f6%40%3Ccvs.httpd.apache.org%3E","https://lists.apache.org/thread.html/r5f9c22f9c28adbd9f00556059edc7b03a5d5bb71d4bb80257c0d34e4%40%3Ccvs.httpd.apache.org%3E","https://lists.apache.org/thread.html/r7035b7c9091c4b665a3b7205364775410646f12125d48e74e395f2ce%40%3Ccvs.httpd.apache.org%3E","https://lists.apache.org/thread.html/r8828e649175df56f1f9e3919938ac7826128525426e2748f0ab62feb%40%3Ccvs.httpd.apache.org%3E","https://lists.apache.org/thread.html/r9e8622254184645bc963a1d47c5d47f6d5a36d6f080d8d2c43b2b142%40%3Ccvs.httpd.apache.org%3E","https://lists.apache.org/thread.html/r9f93cf6dde308d42a9c807784e8102600d0397f5f834890708bf6920%40%3Ccvs.httpd.apac
atrowlHearsData/blob/9c3559b25784ca21f930998243369aaa64d45e45/CVE/data/2001/CVE-2001-0168.json","https://github.com/Chudry/Xerror/blob/07ec57cabcd27cdb47c89af452bdf4ed07207347/xerror/parsing/msf_module_result/msf_module_cve.txt","https://github.com/nomi-sec/NVD-Database/blob/23dc120c34402aaa65883c51c1d03b3cb02c20cb/2001/CVE-2001-0168.json","https://github.com/SpeeDr00t/speedr00t.github.com/blob/0380f0c2190556fabe90257cb6c0034a42f68951/securityfocus/0x3000/2306/info.html","https://github.com/KTZgraph/sarenka/blob/f1fb931ab722d6c096d581ed6e3c5966d799fbaa/sarenka/feeds/cve_details/cve_all_details_150700_150800.json","https://github.com/andreafioraldi/ToolsForCyberChallenge/blob/197d3dfd204cf1b9d1af1451455c8831c3ff9948/generated/files_0.list.dict"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":[],"repo_exp_urls":[],"has_poc":false,"has_exp":false,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/2001/AVE-2001-0062.toml"},{"ave_id":"AVE-2001-0061","file_name":"2001/AVE-2001-0061.toml","cve_id":"CVE-2001-0167","title":"AT&T WinVNC (RealVNC) 客户端缓冲区溢出漏洞","description":"AT&T WinVNC（虚拟网络计算）客户端 3.3.3r7 及更早版本存在基于栈的缓冲区溢出漏洞。远程攻击者可通过向目标 VNC 客户端发送特制的 rfbConnFailed 数据包，在其中包含超长 reason 字符串，触发缓冲区溢出，导致任意代码执行。该漏洞可被用于在受害者主机上执行恶意代码，影响范围广泛。目前已存在 Metasploit 框架的公开利用模块。","severity":"HIGH","score":7.6,"aliases":["CVE-2001-0167"],"sources":["exploitdb"],"published":"2001-05-03T04:00:00.000","updated":"2026-06-16T21:53:47.753","remediation":"升级 VNC 客户端至 4.x 或更高版本，该漏洞存在于 3.3.3r7 及更早版本的 WinVNC 客户端 rfbConnFailed 消息处理中，新版本已修复此缓冲区溢出问题。如无法升级，建议使用 TightVNC、UltraVNC 等替代客户端连接远程桌面，并在网络边界限制 VNC 协议（默认端口 5900）仅允许可信来源访问。","status":"completed","collected_at":"2026-07-22T00:00:00Z","references":["http://marc.info/?l=bugtraq&m=98088315825366&w=2","http://www.securityfocus.com/bid/2305","https://exchange.xforce.ibmcloud.com/vulnerabilities/6025","https://www.exploit-db.com/exploits/16489","https://github.com/trickest/cve/blob/3ffa2a96db84a89f71e1c7ad889e5f4fcc755a48/2001/CVE-2001-0167.md","https://github.com/
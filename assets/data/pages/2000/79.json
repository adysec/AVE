[{"ave_id":"AVE-2000-0032","file_name":"2000/AVE-2000-0032.toml","cve_id":"CVE-2000-0035","title":"Great Circle Associates Majordomo resend 命令本地权限提升漏洞","description":"Majordomo 1.94.4 及更早版本的 resend 命令存在 shell 元字符注入漏洞，本地攻击者可通过向该命令传递包含特殊字符的参数，利用 shell 元字符注入以 Majordomo 进程权限执行任意命令。此漏洞影响 Great Circle Associates 开发的邮件列表管理软件 Majordomo，CVSS 评分 4.6，危害等级中危。攻击前提是攻击者拥有目标系统的本地 shell 访问权限。","severity":"MEDIUM","score":4.6,"aliases":["CVE-2000-0035"],"sources":["redhat"],"published":"1999-12-28T05:00:00Z","updated":"2026-06-16T21:50:52Z","remediation":"立即升级 Majordomo 至 2.0 及以上版本，该版本已修复 resend 命令中 shell 元字符过滤不严的问题。如无法升级，可手动编辑 Majordomo 源码中的 resend 脚本，对用户输入中的 `;`、`|`、`` ` ``、`$` 等 shell 特殊字符进行转义过滤，并限制 resend 命令仅允许授权用户通过 wrapper 调用，避免本地普通用户直接执行。","status":"completed","collected_at":"2026-07-22T00:00:00Z","references":["http://marc.info/?l=bugtraq&m=94780294009285&w=2","http://www.securityfocus.com/bid/902","https://www.exploit-db.com/exploits/19698","https://github.com/CVEProject/cvelistV5/blob/bf570d3b8e47bf0003b46684217cf02c76e2c7f4/cves/2000/0xxx/CVE-2000-0035.json","https://github.com/LiuCan01/cve-list-pro/blob/78b55511cee3604c22d518e32822f0435d0cacc0/cve-list/CVE-2000/CVE-2000-0035","https://github.com/yarencheng/cve-devops-playground/blob/cbe73d6bdcced13ea57f08566d6bbf5345864f7e/content/CVE-2000-0035.md","https://github.com/Patrowl/PatrowlHearsData/blob/c30cb75c630bd0892c286bac41dd51c65d6a6546/CVE/data/2000/CVE-2000-0035.json","https://github.com/github/advisory-database/blob/1721417c5dc7c1cbf858e5ea5a5245ea62e70cce/advisories/unreviewed/2022/04/GHSA-4wrx-2682-w227/GHSA-4wrx-2682-w227.json","https://github.com/SpeeDr00t/speedr00t.github.com/blob/0380f0c2190556fabe90257cb6c0034a42f68951/securityfocus/0x1000/902/info.html","https://github.com/olbat/nvdcve/blob/5b92f5917a4a825187ccaac594f43456a77ea8f3/nvdcve/CVE-2000-0035.json","https://github.com/intSpLoiT/intframework/blob/eabaa799d0260aa52b735fa9769266d1ce4b64ef/modules/cve_list.txt","https://github.com/Yuning-J/VulnerabilityClassifier/blob/c0f06c21b73c26b5ee2b75c21a498eb04eada4b5/threatPrediction/cveIDThreatType/cve_idgainpre","https://github.com/nomi-sec/CVE-Easy-List/blob/eebf829d86861484c6ea731ef53f87c686c4f91c/2000.tsv"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":[],"repo_exp_urls":[],"has_poc":false,"has_exp":false,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/2000/AVE-2000-0032.toml"},{"ave_id":"AVE-2000-0013","file_name":"2000/AVE-2000-0013.toml","cve_id":"CVE-2000-0014","title":"Savant WebServer 2.0 URL空字符拒绝服务漏洞","description":"Savant Web Server 2.0 存在空字符拒绝服务漏洞。远程攻击者无需身份认证，通过向目标服务器发送包含空字符（%00）的特制 URL 请求即可触发该漏洞。服务器在处理此类畸形请求时，由于对 URL 中的空字符处理不当，导致 Web 服务进程崩溃或停止响应，无法正常提供 HTTP 服务。该漏洞影响 Savant Web Server 2.0 版本，攻击者仅需构造简单的 HTTP 请求即可实施攻击，危害程度中等。","severity":"MEDIUM","score":5.0,"aliases":["CVE-2000-0014"],"sources":["avd"],"published":"1999-12-28T05:00:00Z","updated":"2026-06-16T21:50:49Z","remediation":"建议立即停止使用 Savant WebServer 2.0，该软件已停止维护且无安全更新可用。将现有 Web 服务迁移至仍在积极维护的 Web 服务器（如 Apache HTTP Server 2.4.x 或 Nginx 1.x），并确保迁移后完整测试服务可用性。作为临时缓解措施，可在反向代理或 WAF 层面过滤包含空字节（`%00`）的请求 URL，阻止 `.*%00.*` 模式的恶意访问。","status":"completed","collected_at":"2026-07-21T00:00:00Z","references":["http://www.securityfocus.com/bid/897","https://www.exploit-db.com/exploits/19695","https://github.com/CVEProject/cvelistV5/blob/9b8712ba896f892b31b495bb919cac52eac29a85/cves/2000/0xxx/CVE-2000-0014.json","https://github.com/LiuCan01/cve-list-pro/blob/78b55511cee3604c22d518e32822f0435d0cacc0/cve-list/CVE-2000/CVE-2000-0014","https://github.com/yarencheng/cve-devops-playground/blob/7f1c35ad28226319c149c937b6a2e7a1986924ce/content/CVE-2000-0014.md","https://github.com/Patrowl/PatrowlHearsData/blob/9da4ebcefe304654f22bdf6c578568005410bc6c/CVE/data/2000/CVE-2000-0014.json","https://github.com/github/advisory-database/blob/23c72f0e29729596bf60b6750cbec12b936da4bf/advisories/unreviewed/2022/04/GHSA-pjmx-hxgh-3g67/GHSA-pjmx-hxgh-3g67.json","https://github.com/olbat/nvdcve/blob/1c14ae4816efb67123e0664d061a6cbfe48f23
[{"ave_id":"AVE-2012-0192","file_name":"2012/AVE-2012-0192.toml","cve_id":"CVE-2012-1734","title":"Oracle MySQL Server Server Optimizer 拒绝服务漏洞","description":"Oracle MySQL Server 5.1.62及之前版本、5.5.23及之前版本中的Server Optimizer组件存在未明漏洞。远程认证用户可通过向数据库服务器发送特制的查询请求，触发优化器在处理查询计划时的异常，导致MySQL服务进程崩溃或拒绝服务。该漏洞无需特殊权限即可通过网络远程触发，影响范围广泛，CVSS评分4.0，危害等级中低。Oracle在2012年7月的关键补丁更新中修复了此漏洞。","severity":"MEDIUM","score":4.0,"aliases":["CVE-2012-1734"],"sources":["tenable"],"published":"2012-07-17T22:55:01Z","updated":"2026-06-16T23:40:12Z","remediation":"将 MySQL 5.1 系列升级至 5.1.63 及以上版本，MySQL 5.5 系列升级至 5.5.24 及以上版本。如无法立即升级，可在 MySQL 配置文件 my.cnf 中限制 optimizer_search_depth 参数降低优化器复杂度，并限制可登录数据库的用户权限以减小攻击面。","status":"completed","collected_at":"2026-08-05T00:00:00Z","references":["http://osvdb.org/83979","http://rhn.redhat.com/errata/RHSA-2012-1462.html","http://secunia.com/advisories/51309","http://secunia.com/advisories/53372","http://security.gentoo.org/glsa/glsa-201308-06.xml","http://www.mandriva.com/security/advisories?name=MDVSA-2013:150","http://www.oracle.com/technetwork/topics/security/cpujul2012-392727.html","http://www.securityfocus.com/bid/54540","http://www.securitytracker.com/id?1027263","https://exchange.xforce.ibmcloud.com/vulnerabilities/77064","https://github.com/trickest/cve/blob/0950a261126c1029f51ef04a190f1baacd16eb08/2012/CVE-2012-1734.md","https://github.com/CVEProject/cvelistV5/blob/a0edea60322bafbed67887cf7a4d97a55df8a9fa/cves/2012/1xxx/CVE-2012-1734.json","https://github.com/CVEDB/Poc-Git/blob/0275aeb329b0747c9a1d46160c921eae06095557/2012/CVE-2012-1734.md","https://github.com/kaismax/CVE-Poc/blob/6d8c93dabf674cea102713781cc534d577412357/2012/CVE-2012-1734.md","https://github.com/LiuCan01/cve-list-pro/blob/78b55511cee3604c22d518e32822f0435d0cacc0/cve-list/CVE-2012/CVE-2012-1734","https://github.com/nottrobin/ubuntu-cve-tracker/blob/36e411296b5707284049ec2e0db8d2622feca498/retired/CVE-2012-1734","https://github.com/Patrowl/PatrowlHearsData/blob/e6d30197c1ae0e0b416414f6f0ed16544575a73f/CVE/data/2012/CVE-2012-1734.json","https://github.com/Ch4120N/Ch4120N-CVE-Pulse/blob/d85e3a1792768837470e0c79fd15b0f8bd851146/CVEs/2012/CVE-2012-1734.md","https://github.com/mabitoski/cve_submodules/blob/44ad7e2705b3aef1b2ffaf64bd47596c10a6c2e4/2012/CVE-2012-1734.md","https://github.com/neuvector/vul-source/blob/da5ad7125749ac49ac2c49c4f3cd740b81c2c723/ubuntu-cve-tracker/retired/CVE-2012-1734"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":[],"repo_exp_urls":[],"has_poc":false,"has_exp":false,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/2012/AVE-2012-0192.toml"},{"ave_id":"AVE-2012-0188","file_name":"2012/AVE-2012-0188.toml","cve_id":"CVE-2012-1689","title":"Oracle MySQL Server Server Optimizer 拒绝服务漏洞","description":"Oracle MySQL Server 的 Server Optimizer 组件中存在未明漏洞，远程认证用户可通过向受影响数据库发送特制查询请求，利用查询优化器处理过程中的异常，导致 MySQL 服务进程崩溃或拒绝服务。该漏洞影响 MySQL 5.1.62 及更早版本、5.5.22 及更早版本，攻击者需拥有数据库有效账户，无需高权限即可远程触发，CVSS 评分 4.0，危害等级中低。Oracle 已在 2012 年 7 月关键补丁更新中修复此漏洞。","severity":"MEDIUM","score":4.0,"aliases":["CVE-2012-1689"],"sources":["tenable"],"published":"2012-07-17T22:55:01Z","updated":"2026-06-16T23:40:06Z","remediation":"将 MySQL 升级至 5.1.63 及以上版本（5.1 分支）或 5.5.23 及以上版本（5.5 分支），该漏洞已在 Oracle Critical Patch Update July 2012 中修复。可通过 My Oracle Support 获取对应补丁（参考 Note 1455387.1）。临时缓解措施：在防火墙层面限制仅允许受信主机访问 MySQL 3306 端口，并避免向非受信用户授予数据库连接权限。","status":"completed","collected_at":"2026-08-05T00:00:00Z","references":["http://osvdb.org/83980","http://rhn.redhat.com/errata/RHSA-2012-1462.html","http://secunia.com/advisories/51309","http://secunia.com/advisories/53372","http://security.gentoo.org/glsa/glsa-201308-06.xml","http://www.mandriva.com/security/advisories?name=MDVSA-2013:150","http://www.oracle.com/technetwork/topics/security/cpujul2012-392727.html","http://www.securityfocus.com/bid/54547","http://www.securitytracker.com/id?1027263","https://exchange.xforce.ibmcloud.com/vulnerabilities/77065","https://github.com/trickest/cve/blob/0950a261126c1029f51ef04a190f1baacd16eb08/2012/
[{"ave_id":"AVE-2018-0180","file_name":"2018/AVE-2018-0180.toml","cve_id":"CVE-2018-3810","title":"Oturia WordPress Smart Google Code Inserter 插件认证绕过漏洞","description":"WordPress 的 Oturia Smart Google Code Inserter 插件 3.5 版本之前存在认证绕过漏洞。该插件的 smartgooglecode.php 文件中的 saveGoogleCode() 函数未对当前请求进行用户身份验证，导致任何未经认证的攻击者可通过 sgcgoogleanalytic 参数向 WordPress 所有页面注入任意 JavaScript 或 HTML 代码。攻击者无需任何权限，仅需构造特制 HTTP 请求即可利用该漏洞，成功利用可在目标站点上执行任意脚本，窃取用户会话 Cookie、重定向至恶意站点或篡改页面内容，CVSS 评分 9.8，危害等级严重。","severity":"CRITICAL","score":9.8,"aliases":["CVE-2018-3810"],"sources":["nuclei"],"published":"2018-01-01T06:29:00Z","updated":"2026-06-17T01:57:49Z","remediation":"立即将 Oturia Smart Google Code Inserter 插件升级到 3.5 或更高版本，该版本在 smartgooglecode.php 的 saveGoogleCode() 函数中增加了权限检查，阻止未授权用户修改插入代码。如无法升级，可暂时禁用该插件，或通过 Web 服务器配置（如 .htaccess）限制对 /wp-content/plugins/smart-google-code-inserter/ 目录的访问。","status":"completed","collected_at":"2026-08-03T00:00:00Z","references":["https://limbenjamin.com/articles/smart-google-code-inserter-auth-bypass.html","https://wordpress.org/plugins/smart-google-code-inserter/#developers","https://wpvulndb.com/vulnerabilities/8987","https://www.exploit-db.com/exploits/43420/","https://github.com/projectdiscovery/nuclei-templates/blob/main/http/cves/2018/CVE-2018-3810.yaml","https://github.com/trickest/cve/blob/7ade3449b58b8e2c679712dc3af64bbd8e638364/2018/CVE-2018-3810.md","https://github.com/nomi-sec/PoC-in-GitHub/blob/c908bbff86d2944f8f8a39e75f549a966c642420/2018/CVE-2018-3810.json","https://github.com/projectdiscovery/nuclei-templates/blob/e9f0fe7fa4f5c548bbd1a4d3b65d0f181021e664/http/cves/2018/CVE-2018-3810.yaml","https://github.com/ExpLangcn/NucleiTP/blob/2b7ecb9031a6eda4f272793045f29b339d8e0cce/CVES/critical/CVE-2018-3810.yaml","https://github.com/ExpLangcn/NucleiTP/blob/2b7ecb9031a6eda4f272793045f29b339d8e0cce/CVES/critical/cve-2018-3810-3555.yaml","https://github.com/ExpLangcn/NucleiTP/blob/2b7ecb9031a6eda4f272793045f29b339d8e0cce/CVES/critical/cve-2018-3810-3554.yaml","https://github.com/ExpLangcn/NucleiTP/blob/2b7ecb9031a6eda4f272793045f29b339d8e0cce/CVES/critical/cve-2018-3810-3558.yaml","https://github.com/ExpLangcn/NucleiTP/blob/2b7ecb9031a6eda4f272793045f29b339d8e0cce/CVES/critical/cve-2018-3810-3557.yaml","https://github.com/GhostTroops/scan4all/blob/fff03b51bf79c8993a46c1da766ec993e1102c47/config/51pwn/yaml/WordPress/CVE-2018-3810.yaml","https://github.com/GhostTroops/scan4all/blob/fff03b51bf79c8993a46c1da766ec993e1102c47/config/51pwn/TPALL/templates/wordpress/CVE-2018-3810.yaml","https://github.com/nth347/CVE-2018-3810_exploit","https://github.com/cved-sources/cve-2018-3810","https://github.com/lucad93/CVE-2018-3810"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":[],"repo_exp_urls":[],"has_poc":false,"has_exp":false,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/2018/AVE-2018-0180.toml"},{"ave_id":"AVE-2018-0045","file_name":"2018/AVE-2018-0045.toml","cve_id":"CVE-2018-10818","title":"LG NAS 远程命令注入漏洞","description":"LG NAS 网络存储设备存在预认证远程命令注入漏洞。未经身份认证的远程攻击者可通过拦截登录请求，在密码（password）参数中注入系统命令，在无需登录凭据的情况下直接在设备上执行任意操作系统指令。成功利用该漏洞可导致攻击者获取设备的完全控制权限，包括读取和修改存储的用户数据、添加管理员账户、导出用户数据库等，严重危害数据机密性与完整性。LG 已在后续固件版本中修复此漏洞，受影响用户应升级至最新固件并限制设备外部访问。","severity":"MEDIUM","score":5.0,"aliases":["CVE-2018-10818"],"sources":["nuclei"],"published":"2018-01-01T00:00:00Z","updated":"2018-01-01T00:00:00Z","remediation":"立即升级LG NAS设备固件至最新版本，访问LG官方支持页面下载对应型号的最新固件并执行升级操作。如无法立即升级，可在路由器或防火墙上限制对NAS设备Web管理端口（如80、443端口）的访问，仅允许受信任的IP地址访问，同时禁用设备远程管理功能作为临时缓解措施。","status":"completed","collected_at":"2026-07-30T00:00:00Z","references":["https://github.com/projectdiscovery/nuclei-templates/blob/main/http/cves/2018/CVE-2018-10818.yaml","https://github.com/projectdiscovery/nuclei-templates/blob/9979ce144c257f1c427a75604f8c0ffbc8293390/http/cves/2018/CVE-2018-10818.yaml","https://github.com/ExpLangcn/NucleiTP/blob/2b7ecb9031a6eda4f272793045f29b339d8e0cce/CVES/critical/CVE-2018-10818.yaml","https://github.com/ExpLangcn/NucleiTP/blob/2b7ecb9031a6eda4f272793045f29b339d8
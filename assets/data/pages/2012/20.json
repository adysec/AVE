[{"ave_id":"AVE-2012-0079","file_name":"2012/AVE-2012-0079.toml","cve_id":"CVE-2012-0595","title":"Apple WebKit 内存破坏远程代码执行漏洞","description":"Apple iOS 5.1 之前版本、iTunes 10.6 之前版本以及 Safari 5.1.4 之前版本中使用的 WebKit 引擎存在未明内存破坏漏洞（CWE-119）。远程攻击者可通过诱导用户访问特制网站触发内存损坏，导致任意代码执行或应用程序崩溃（拒绝服务）。该漏洞无需身份认证，攻击复杂度较低，CVSS 评分 9.3，危害等级严重。Apple 已于 2012 年 3 月发布安全更新修复此漏洞。","severity":"CRITICAL","score":9.3,"aliases":["CVE-2012-0595"],"sources":["tenable"],"published":"2012-03-08T22:55:02Z","updated":"2026-06-16T23:37:53Z","remediation":"将 Apple Safari 升级至 5.1.4 或更高版本，将 Apple iOS 升级至 5.1 或更高版本，将 Apple iTunes 升级至 10.6 或更高版本。上述版本均已在 2012 年 3 月发布的安全更新中修复该漏洞。如无法立即升级，建议避免在受影响设备上访问不可信网站，并禁用 WebKit 解析不可信内容的功能作为临时缓解措施。","status":"completed","collected_at":"2026-08-03T00:00:00Z","references":["http://lists.apple.com/archives/security-announce/2012/Mar/msg00000.html","http://lists.apple.com/archives/security-announce/2012/Mar/msg00001.html","http://lists.apple.com/archives/security-announce/2012/Mar/msg00003.html","http://osvdb.org/79917","http://secunia.com/advisories/48274","http://secunia.com/advisories/48288","http://secunia.com/advisories/48377","http://www.securityfocus.com/bid/52365","http://www.securitytracker.com/id?1026774","https://exchange.xforce.ibmcloud.com/vulnerabilities/73814","https://oval.cisecurity.org/repository/search/definition/oval%3Aorg.mitre.oval%3Adef%3A17057","https://github.com/CVEProject/cvelistV5/blob/73e213348ddf142cab7e77d05861fa314ba8e1d0/cves/2012/0xxx/CVE-2012-0595.json","https://github.com/LiuCan01/cve-list-pro/blob/78b55511cee3604c22d518e32822f0435d0cacc0/cve-list/CVE-2012/CVE-2012-0595","https://github.com/Patrowl/PatrowlHearsData/blob/cec9fb1846e25b24020f297f65ec2360af0f4267/CVE/data/2012/CVE-2012-0595.json","https://github.com/nomi-sec/NVD-Database/blob/23dc120c34402aaa65883c51c1d03b3cb02c20cb/2012/CVE-2012-0595.json","https://github.com/opencve/opencve-kb/blob/b5ed23ad1e6e5869267a4c8091cffdf6711227b5/2012/CVE-2012-0595.json","https://github.com/olbat/nvdcve/blob/f
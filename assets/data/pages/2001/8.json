:["http://distro.conectiva.com.br/atualizacoes/?id=a&anuncio=000431","http://download.immunix.org/ImmunixOS/7.0/updates/IMNX-2001-70-034-01","http://marc.info/?l=bugtraq&m=100154541809940&w=2","http://rhn.redhat.com/errata/RHSA-2001-114.html","http://www.ciac.org/ciac/bulletins/m-010.shtml","http://www.kb.cert.org/vuls/id/905795","http://www.linux-mandrake.com/en/security/2001/MDKSA-2001-081.php","http://www.osvdb.org/642","http://www.securityfocus.com/bid/3369","https://exchange.xforce.ibmcloud.com/vulnerabilities/7179","https://github.com/CVEProject/cvelistV5/blob/3fc46d7716e9a0dd9635d13e2bff8fffb122a860/cves/2001/1xxx/CVE-2001-1380.json","https://github.com/LiuCan01/cve-list-pro/blob/78b55511cee3604c22d518e32822f0435d0cacc0/cve-list/CVE-2001/CVE-2001-1380","https://github.com/HORKimhab/poc-cve-collection/blob/41644568d1e47f962c2cefae75c8b09359290a26/2001/1xxx/CVE-2001-1380.md","https://github.com/Patrowl/PatrowlHearsData/blob/73cd39be077fdbedc5ca2ea7e2723723d25285cc/CVE/data/2001/CVE-2001-1380.json","https://github.com/github/advisory-database/blob/1c8e3f4146e1bef501493d1237acb1611ea8f707/advisories/unreviewed/2022/04/GHSA-35mq-8mc3-vcm8/GHSA-35mq-8mc3-vcm8.json","https://github.com/yarencheng/cve-devops-playground/blob/c54e59752dddfc9aa36c13774164384cfa0d1f04/content/CVE-2001-1380.md","https://github.com/djc/oxish/blob/b838856809588d49f39ddd35714d3242f67bef71/openssh-vulnerabilities.md","https://github.com/blackhook/nessus-plugins/blob/64177d96abbb07c58cf7e131046b067ebc61fcb5/O/openssh_37p.nasl","https://github.com/Freem93/grammar_nasl_v2/blob/63834ebb8cd6e97050e155291c7500ad53bb20c6/plugins/openssh_adv_option.nasl","https://github.com/KTZgraph/sarenka/blob/f1fb931ab722d6c096d581ed6e3c5966d799fbaa/sarenka/feeds/cve_details/cve_all_details_151700_151800.json"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":[],"repo_exp_urls":[],"has_poc":false,"has_exp":false,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/2001/AVE-2001-0499.toml"},{"ave_id":"AVE-2001-0406","file_name":"2001/AVE-2001-0406.toml","cve_id":"CVE-2001-0907","title":"Linux Kernel 2.2/2.4 深度嵌套符号链接拒绝服务漏洞","description":"tags.<value>Linux 内核 2.2.1 至 2.2.19 及 2.4.1 至 2.4.10 版本中存在深度嵌套符号链接拒绝服务漏洞。内核在遍历或访问文件系统路径时需递归解析每一层符号链接，当攻击者在文件系统中创建大量深度嵌套的符号链接链时，内核会消耗大量 CPU 时间进行路径解析，导致系统响应严重迟缓甚至完全卡死。该漏洞仅允许本地用户利用，攻击条件为攻击者须在目标系统上拥有普通用户权限。攻击者可通过创建极端深度的符号链接树，诱使系统进程（如文件管理器、备份任务或 shell）在访问路径时触发内核长时间阻塞，从而造成拒绝服务。","severity":"LOW","score":2.1,"aliases":["CVE-2001-0907"],"sources":["exploitdb"],"published":"2001-10-18T04:00:00Z","updated":"2026-06-16T21:55:12Z","remediation":"立即升级 Linux Kernel：2.2.x 系列升级至 2.2.20 或更高版本，2.4.x 系列升级至 2.4.12 或更高版本，以完全修复深层符号链接拒绝服务漏洞。如暂无法升级，2.2.19 系统可应用官方补丁 linux-2.2.19-deep-symlink.patch，该补丁通过限制单次符号链接递归跟随次数至 5 次、并在内核查找路径时增加调度点来防止调度器被长时间阻塞。临时缓解措施包括在防火墙或安全模块中限制本地用户对敏感目录的符号链接创建权限，或通过文件系统挂载选项禁止用户目录下的深层链接访问。","status":"completed","collected_at":"2026-07-25T00:00:00Z","references":["http://download.immunix.org/ImmunixOS/7.0/updates/IMNX-2001-70-035-01","http://frontal2.mandriva.com/security/advisories?name=MDKSA-2001:079","http://marc.info/?l=bugtraq&m=100343090106914&w=2","http://marc.info/?l=bugtraq&m=100350685431610&w=2","http://www.iss.net/security_center/static/7312.php","http://www.linux-mandrake.com/en/security/2001/MDKSA-2001-082.php3","http://www.linuxsecurity.com/advisories/other_advisory-1650.html","http://www.novell.com/linux/security/advisories/2001_036_kernel_txt.html","http://www.securityfocus.com/bid/3444","https://www.exploit-db.com/exploits/21122","https://github.com/trickest/cve/blob/1ba39e3ba737b838bba789f1cc5a339b5a2399ad/2001/CVE-2001-0907.md","https://github.com/CVEProject/cvelistV5/blob/5b3647aa8630e92d52def237a668e1c7c212a696/cves/2001/0xxx/CVE-2001-0907.json","https://github.com/LiuCan01/cve-list-pro/blob/78b55511cee3604c22d518e32822f0435d0cacc0/cve-list/CVE-2001/CVE-2001-0907","https://github.com/edoardottt/missing-cve-nuclei-templates/blob/115c94bd1da3cc18977d652d6e78c9f4a5dfc13b/data/year/2001.txt","https://github.com/Patrowl/PatrowlHearsData/blob/48bcd43923f8bb2f197ede4a17570cc3bd71fd9e/CVE/data/2001/CVE-2001-0907.json","https://github.com/github/advisory-database/blob/c94c1772ba718b7f105ed32361c896b35042b2b3/advisories/unreviewed/2022/05/GHSA-ccmf-3rv3-jmxv/GHSA-ccmf-3rv3-jmxv.json","https://github.com/HORKimhab/poc-cve-collection/blob/035716a784b26bf707cbf0b8f17696c9c2e71cb8/2001/0xxx/CVE-2001-0907.md","https://github.com/intSpLoiT/intframework/blob/eabaa799d0260aa52b735fa9769266d1ce4b64ef/modules/cve_list.txt","https://github.com/KTZgraph/sarenka/blob/f1fb931ab722d6c096d581ed6e3c5966d799fbaa/sarenka/feeds/cve_details/cve_all_details_151700_151800.json","https://github.com/nomi-sec/NVD-Database/blob/23dc120c34402aaa65883c51c1d03b3cb02c20cb/2001/CVE-2001-0907.json"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":[],"repo_exp_urls":[],"has_poc":false,"has_exp":false,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/2001/AVE-2001-0406.toml"},{"ave_id":"AVE-2001-0356","file_name":"2001/AVE-2001-0356.toml","cve_id":"CVE-2001-0791","title":"趋势科技 Interscan VirusWall for Windows NT 远程重新配置漏洞","description":"趋势科技 InterScan VirusWall for Windows NT 3.4/3.5/3.51 存在访问控制缺陷，部分 CGI 程序未对请求进行身份验证和权限限制，允许远程攻击者无需认证即可直接调用这些 CGI 程序。该漏洞使攻击者能够远程修改目标系统的安全配置，从而绕过病毒防护策略，可能导致恶意软件入侵和内部网络沦陷。CVSS 评分为 5.0，危害等级中等。","severity":"MEDIUM","score":5.0,"aliases":["CVE-2001-0791"],"sources":["exploitdb"],"published":"2001-10-18T04:00:00Z","updated":"2026-06-16T21:54:58Z","remediation":"立即升级 Trend Micro Interscan VirusWall 至官方发布的最新补丁版本，禁用或删除管理界面中不必要的 CGI 程序（如 FtpSave.dll）。在网络防火墙层面限制对 Interscan 管理端口的外部访问，仅允许授权管理 IP 段访问 CGI 目录（/interscan/cgi-bin/），并通过访问控制列表（ACL）强制要求身份验证后方可执行配置变更操作。","status":"completed","collected_at":"2026-07-24T00:00:00Z","references":["http://cert.uni-stuttgart.de/archive/bugtraq/2001/06/msg00006.html","https://www.exploit-db.com/exploits/20893","https://github.com/CVEProject/cvelistV5/blob/b7ad02cdea30b1d567c45050de3359436fcc903a/cves/2001/0xxx/CVE-2001-0791.json","https://github.com/LiuCan01/cve-list-pro/blob/
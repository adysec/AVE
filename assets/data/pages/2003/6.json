[{"ave_id":"AVE-2003-0020","file_name":"2003/AVE-2003-0020.toml","cve_id":"CVE-2003-0073","title":"MySQL MySQL mysql_change_user 双释放拒绝服务漏洞","description":"MySQL 3.23.55 之前版本的 mysqld 中存在双重释放（double-free）漏洞。已拥有 MySQL 访问权限的攻击者可通过调用 mysql_change_user 函数触发该漏洞，导致服务崩溃，造成拒绝服务。该漏洞影响 MySQL 3.23.55 之前的所有版本，攻击者需具备数据库登录权限方可利用，无需身份认证即可触发。","severity":"MEDIUM","score":5.0,"aliases":["CVE-2003-0073"],"sources":["redhat"],"published":"2003-02-19T05:00:00Z","updated":"2026-06-16T22:01:27Z","remediation":"立即将 MySQL 升级至 3.23.55 或更高版本。Red Hat 用户安装 RHSA-2003:093/RHSA-2003:094/RHSA-2003:166 提供的更新包；Debian 用户应用 DSA-303 安全更新；Mandrake 用户安装 MDKSA-2003:013 补丁。如无法升级，通过防火墙限制 MySQL 端口（默认 3306）仅允许受信 IP 访问，并严格管理数据库用户权限，避免向不可信用户开放 mysql_change_user 操作权限。","status":"completed","collected_at":"2026-08-03T00:00:00Z","references":["http://distro.conectiva.com.br/atualizacoes/?id=a&anuncio=000743","http://marc.info/?l=bugtraq&m=104385719107879&w=2","http://www.debian.org/security/2003/dsa-303","http://www.iss.net/security_center/static/11199.php","http://www.linuxsecurity.com/advisories/engarde_advisory-2873.html","http://www.mandrakesoft.com/security/advisories?name=MDKSA-2003:013","http://www.mysql.com/doc/en/News-3.23.55.html","http://www.redhat.com/support/errata/RHSA-2003-093.html","http://www.redhat.com/support/errata/RHSA-2003-094.html","http://www.redhat.com/support/errata/RHSA-2003-166.html","http://www.securityfocus.com/bid/6718","https://oval.cisecurity.org/repository/search/definition/oval%3Aorg.mitre.oval%3Adef%3A436","https://github.com/trickest/cve/blob/7d40e7d94b41c478b4d1a654c7bc3bcf34fa7beb/2003/CVE-2003-0073.md","https://github.com/CVEProject/cvelistV5/blob/73e213348ddf142cab7e77d05861fa314ba8e1d0/cves/2003/0xxx/CVE-2003-0073.json","https://github.com/LiuCan01/cve-list-pro/blob/78b55511cee3604c22d518e32822f0435d0cacc0/cve-list/CVE-2003/CVE-2003-0073","https://github.com/Patrowl/PatrowlHearsData/blob/cec9fb1846e25b24020f297f65ec2360af0f4267/CVE/data/2003/CVE-2003-0073.json","https://github.com/nomi-sec/NVD-Database/blob/23dc120c34402aaa65883c51c1d03b3cb02c20cb/2003/CVE-2003-0073.json","https://github.com/opencve/opencve-kb/blob/eaba6ba6891dae2972376e68ae56a38b641030d7/2003/CVE-2003-0073.json","https://github.com/HORKimhab/poc-cve-collection/blob/68a8e7c8b5d4a203080f3ef6d3d4e3df346511fe/2003/0xxx/CVE-2003-0073.md","https://github.com/olbat/nvdcve/blob/fe7f195231342e1e88104679c53c965e9a67ac35/nvdcve/CVE-2003-0073.json","https://github.com/aquasecurity/vuln-list-debian/blob/98c311c3ba3abe1f72f8d5cfae5eb671ae60d00f/tracker/CVE/2003/CVE-2003-0073.json","https://github.com/CyberSecAI/cve_info/blob/03b7e36424574a3a9ba5fd13480a326b666a1046/2003/0xxx/CVE-2003-0073.json"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":[],"repo_exp_urls":[],"has_poc":false,"has_exp":false,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/2003/AVE-2003-0020.toml"},{"ave_id":"AVE-2003-0014","file_name":"2003/AVE-2003-0014.toml","cve_id":"CVE-2003-0059","title":"MIT Kerberos V5 跨域用户欺骗漏洞","description":"MIT Kerberos V5 1.2.5 之前版本的 libkrb5 库中的 chk_trans.c 文件存在未知漏洞，当不同 Kerberos 领域配置了相同的跨领域共享密钥时，攻击者可以利用该漏洞从一个领域冒充其他领域的用户进行身份认证。该漏洞影响所有使用 MIT Kerberos V5 1.2.5 之前版本的系统，CVSS 评分 7.5，危害等级高。攻击者无需身份认证即可远程利用，可导致权限提升、信息泄露和中间人攻击。建议升级至 MIT Kerberos V5 1.2.5 或更高版本以修复此漏洞。","severity":"HIGH","score":7.5,"aliases":["CVE-2003-0059"],"sources":["redhat"],"published":"2003-02-19T05:00:00Z","updated":"2026-06-16T22:01:26Z","remediation":"升级 MIT Kerberos V5 至 1.2.5 或更高版本。如无法立即升级，在跨域信任配置中严格限制共享密钥的使用范围，仅对必要的 realm 对启用 inter-realm 认证，并定期轮换跨域共享密钥以降低被冒充风险。","status":"completed","collected_at":"2026-08-03T00:00:00Z","references":["http://distro.conectiva.com.br/atualizacoes/?id=a&anuncio=000639","http://web.mit.edu/kerberos/www/advisories/MITKRB5-SA-2003-001-multiple.txt","http://www.kb.cert.org/vuls/id/684563","http://www.mandrakesoft.com/security/advisories?name=MDKSA-2003:043","http://www.redhat.com/support/errata/RHSA-2003-051.html","http://www.redhat.com/support/errata/RHSA-2003-052.html","http://www.redhat.com/support/errata/RHSA-2003-168.html","http://www.securityfocus.com/bid/6714","https://exchange.xforce.ibmcloud.com/vulnerabilities/11188","https://github.com/CVEProject/cvelistV5/blob/73e213348ddf142cab7e77d05861fa314ba8e1d0/cves/2003/0xxx/CVE-2003-0059.json","https://github.com/LiuCan01/cve-list-pro/blob/78b55511cee3604c22d518e32822f0435d0cacc0/cve-list/CVE-2003/CVE-2003-0059","https://github.com/Patrowl/PatrowlHearsData/blob/cec9fb1846e25b24020f297f65ec2360af0f4267/CVE/data/2003/CVE-2003-0059.json","https://github.com/nomi-sec/NVD-Database/blob/23dc120c34402aaa65883c51c1d03b3cb02c20cb/2003/CVE-2003-0059.json","https://github.com/opencve/opencve-kb/blob/b5ed23ad1e6e5869267a4c8091cffdf6711227b5/2003/CVE-2003-0059.json","https://github.com/olbat/nvdcve/blob/fe7f195231342e1e88104679c53c965e9a67ac35/nvdcve/CVE-2003-0059.json","https://github.com/HORKimhab/poc-cve-collection/blob/68a8e7c8b5d4a203080f3ef6d3d4e3df346511fe/2003/0xxx/CVE-2003-0059.md","https://github.com/aquasecurity/vuln-list-debian/blob/98c311c3ba3abe1f72f8d5cfae5eb671ae60d00f/tracker/CVE/2003/CVE-2003-0059.json","https://github.com/fkie-cad/nvd-json-data-feeds/blob/d6e5bf87d27954c5a3cd48e565b212fb97932a81/CVE-2003/CVE-2003-00xx/CVE-2003-0059.json","https://github.com/CyberSecAI/cve_info/blob/03b7e36424574a3a9ba5fd13480a326b666a1046/2003/0xxx/CVE-2003-0059.json"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":[],"repo_exp_urls":[],"has_poc":false,"has_exp":false,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/2003/AVE-2003-0014.toml"},{"ave_id":"AVE-2003-0013","file_name":"2003/AVE-2003-0013.toml","cve_id":"CVE-2003-0058","title":"MIT Kerberos 5 Key Distribution Center NULL Pointer Dereference 拒绝服务漏洞","description":"MIT Kerberos V5 密钥分发中心（KDC）1.2.5 版本之前存在空指针解引用漏洞，远程已认证攻击者可通过向同一领域内的 KDC 发送特定协议请求触发该漏洞，导致 KDC 服务崩溃拒绝服务。该漏洞影响 MIT Kerberos 5-1.2.1 至 5-1.2.4 版本，CVSS 评分 5.0（AV:N/AC:L/Au:N/C:N/I:N/A:P），攻击复杂度低、无需交互，但需认证权限且仅影响可用性。","severity":"MEDIUM","score":5.0,"aliases":["CVE-2003-0058"],"sources":["redhat"],"published":"2003-02-19T05:00:00Z","updated":"2026-06-16T22:01:26Z","remediation":"升级 MIT Kerberos V5 至 1.2.5 或更高版本。若无法立即升级，可在网络边界防火墙限制 KDC 服务端口（默认 88/TCP、88/UDP）仅允许受信任域控制器访问，并监控 KDC 崩溃日志及时重启服务。","status":"completed","collected_at":"2026-08-03T00:00:00Z","references":["http://distro.conectiva.com.br/atualizacoes/?id=a&anuncio=000639","http://sunsolve.sun.com/pub-cgi/retrieve.pl?doc=fsalert/50142","http://web.mit.edu/kerberos/www/advisories/MITKRB5-SA-2003-001-multiple.txt","http://www.kb.cert.org/vuls/id/661243","http://www.mandrakesoft.com/security/advisories?name=MDKSA-2003:043","http://www.redhat.com/support/errata/RHSA-2003-051.html","http://www.redhat.com/support/errata/RHSA-2003-052.html","http://www.redhat.com/support/errata/RHSA-2003-168.html","http://www.securityfocus.com/bid/6683","https://exchange.xforce.ibmcloud.com/vulnerabilities/10099","https://oval.cisecurity.org/repository/search/definition/oval%3Aorg.mitre.oval%3Adef%3A1110","https://github.com/CVEProject/cvelistV5/blob/73e213348ddf142cab7e77d05861fa314ba8e1d0/cves/2003/0xxx/CVE-2003-0058.json","https://github.com/LiuCan01/cve-list-pro/blob/78b55511cee3604c22d518e32822f0435d0cacc0/cve-list/CVE-2003/CVE-2003-0058","https://github.com/Patrowl/PatrowlHearsData/blob/cec9fb1846e25b24020f297f65ec2360af0f4267/CVE/data/2003/CVE-2003-0058.json","https://github.com/nomi-sec/NVD-Database/blob/23dc120c34402aaa65883c51c1d03b3cb02c20cb/2003/CVE-2003-0058.json","https://github.com/opencve/opencve-kb/blob/fc3c209ab3b380e61580f037335fd28cb053661f/2003/CVE-2003-0058.json","https://github.com/HORKimhab/poc-cve-collection/blob/918ac66f0b50ab0d2a013bdf692688d3c0abefbc/2003/0xxx/CVE-2003-0058.md","https://github.com/olbat/nvdcve/blob/fe7f195231342e1e88104679c53c965e9a67ac35/nvdcve/CVE-2003-0058.json","https://github.com/aquasecurity/vuln-list-debian/blob/98c311c3ba3abe1f72f8d5cfae5eb671ae60d00f/tracker/CVE/2003/CVE-2003-0058.json","https://github.com/CyberSecAI/cve_info/blob/03b7e36424574a3a9ba5fd13480a326b666a1046/2003/0xxx/CVE-2003-0058.json","https://github.com/fkie-cad/nvd-json-data-feeds/blob/b5070d3c2d6dc2fda079c163276abcda1c82b124/CVE-2003/CVE-2003-00xx/CVE-2003-0058.json"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":[],"repo_exp_urls":[],"has_poc":false,"has_exp":false,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/2003/AVE-2003-0013.toml"},{"ave_id":"AVE-2003-0012","file_name":"2003/AVE-2003-0012.toml","cve_id":"CVE-2003-0056","title":"GNU slocate 本地缓冲区溢出漏洞","description":"slocate（secure locate）在 2.7 版本前存在本地缓冲区溢出漏洞，程序在处理过长的 -c（创建数据库）或 -r（指定数据库路径）命令行参数时未进行边界检查，导致栈缓冲区溢出。本地攻击者可通过构造超长参数调用 slocate，覆盖返回地址或函数指针，实现任意代码执行并提权至 root 权限（slocate 通常以 setuid root 运行）。影响范围为 slocate 2.5、2.6 等早期版本，攻击条件要求攻击者已具备本地账户并能执行 slocate 二进制文件。利用方式为向 -c 或 -r 参数传递精心构造的超长字符串，触发缓冲区溢出并劫持控制流执行 shellcode。该漏洞 CVSS 7.2 分（AV:L/AC:L/Au:N/C:C/I:C/A:C），属本地提权高危漏洞。","severity":"HIGH","score":7.2,"aliases":["CVE-2003-0056"],"sources":["redhat"],"published":"2003-02-19T05:00:00Z","updated":"2026-06-16T22:01:25Z","remediation":"建议立即将 slocate 升级至 2.7 或更高版本以修复缓冲区溢出漏洞。若无法立即升级，可通过设置严格的文件权限限制非受信本地用户调用该程序，或移除该软件以消除风险。","status":"completed","collected_at":"2026-08-03T00:00:00Z","references":["http://marc.info/?l=bugtraq&m=104342864418213&w=2","http://marc.info/?l=bugtraq&m=104348607205691&w=2","http://marc.info/?l=bugtraq&m=104428624705363&w=2","http://rhn.redhat.com/errata/RHSA-2004-041.html","http://secunia.com/advisories/10720","http://secunia.com/advisories/7947","http://secunia.com/advisories/7982","http://secunia.com/advisories/8007","http://secunia.com/advisories/8118/","http://secunia.com/advisories/8236","http://secunia.com/advisories/8749","http://www.debian.org/security/2003/dsa-252","http://www.mandriva.com/security/advisories?name=MDKSA-2003:015","http://www.net-security.org/advisory.php?id=2010","http://www.usg.org.uk/advisories/2003.001.txt","https://oval.cisecurity.org/repository/search/definition/oval%3Aorg.mitre.oval%3Adef%3A11369","https://www.exploit-db.com/exploits/22197","https://github.com/trickest/cve/blob/7d40e7d94b41c478b4d1a654c7bc3bcf34fa7beb/2003/CVE-2003-0056.md","https://github.com/0xMarcio/cve/blob/986b45a0ac2dd215b3a5515fba0cebac769043dd/2003/CVE-2003-0056.md","https://github.com/CVEDB/Poc-Git/blob/0275aeb329b0747c9a1d46160c921eae06095557/2003/CVE-2003-0056.md","https://github.com/CVEProject/cvelistV5/blob/0235c22e9b6c7ddb8ada469b545320bce3ffcbfa/cves/2003/0xxx/CVE-2003-0056.json","https://github.com/kaismax/CVE-Poc/blob/6d8c93dabf674cea102713781cc534d577412357/2003/CVE-2003-0056.md","https://github.com/LiuCan01/cve-list-pro/blob/78b55511cee3604c22d518e32822f0435d0cacc0/cve-list/CVE-2003/CVE-2003-0056","https://github.com/Patrowl/PatrowlHearsData/blob/cec9fb1846e25b24020f297f65ec2360af0f4267/CVE/data/2003/CVE-2003-0056.json","https://github.com/mabitoski/cve_submodules/blob/44ad7e2705b3aef1b2ffaf64bd47596c10a6c2e4/2003/CVE-2003-0056.md","https://github.com/nomi-sec/NVD-Database/blob/23dc120c34402aaa65883c51c1d03b3cb02c20cb/2003/CVE-2003-0056.json","https://github.com/brenonevs/prs-pentest/blob/001cf17eedeb4aad73618d3140ca1f5dc93e69b3/CVEs & POCs/2003/CVE-2003-0056.md"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":[],"repo_exp_urls":[],"has_poc":false,"has_exp":false,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/2003/AVE-2003-0012.toml"},{"ave_id":"AVE-2003-0011","file_name":"2003/AVE-2003-0011.toml","cve_id":"CVE-2003-0041","title":"Kerberos FTP客户端 远程代码执行漏洞","description":"该漏洞存在于带有 Kerberos 认证支持的 FTP 客户端（如 Kerberos 网络文件系统中的 FTP 客户端）。漏洞原理是：FTP 客户端在处理从远程 FTP 服务器获取的文件名时，未能对文件名中的管道符（|）字符进行充分过滤和转义，直接将文件名传入系统命令行解析，从而导致远程 FTP 服务器可以通过在文件名中嵌入管道符及任意命令的方式，在用户的本地系统上执行任意代码。攻击条件是：攻击者需要控制一个恶意的远程 FTP 服务器，当目标用户使用受影响的 FTP 客户端连接该服务器并下载/获取一个包含管道符文件名时，命令将在客户端本地以用户权限静默执行，无需额外交互。影响范围包括所有使用受影响 Kerberos FTP 客户端版本的 Linux/UNIX 系统用户，攻击可能导致完全的机密性、完整性和可用性破坏（CVSS 10.0，CWE-78），例如窃取敏感文件、篡改本地数据或瘫痪系统。利用方式是攻击者在恶意 FTP 服务端返回的目录列表中构造形如 \"|command\" 的文件名，诱导用户执行下载操作即可触发远程命令执行。","severity":"CRITICAL","score":10.0,"aliases":["CVE-2003-0041"],"sources":["redhat"],"published":"2003-02-19T05:00:00Z","updated":"2026-06-16T22:01:24Z","remediation":"I need to research CVE-2003-0041 to provide an accurate remediation. Let me search for specific fix information.Let me fetch more specific information about the patch for this vulnerability.Let me search for the specific advisory related to CVE-2003-0041 about the FTP client pipe vulnerability.I have enough information from the NVD page. The Red Hat advisory link (RHSA-2003-020) is a broken link, but from the NVD and other sources I can determine the remediation. This is a pipe character command injection vulnerability in the MIT Kerberos FTP client. Let me also check for the specific patch.Now I have enough information to construct an accurate remediation. Based on the MIT Kerberos advisories, this vulnerability was fixed in MITKRB5-SA-2003-001, which affected versions prior to 1.2.5. The Debian security tracker shows the fix for Debian bullseye (1.18.3-6+deb11u5 or later).<value>立即升级 MIT Kerberos 至 1.2.5 或更高版本（含 1.3.x 及 1.4.x 最新补丁），或从发行商安全更新中获取修复后的 krb5-clients 包（如 RedHat RHSA-2003:020、Mandrake MDKSA-2003:021）。如无法立即升级，请卸载或禁用 Kerberos FTP 客户端，改用 SFTP/SCP 等安全协议传输文件，避免从不可信 FTP 服务器获取文件。</arg_value>","status":"completed","collected_at":"2026-08-03T00:00:00Z","references":["http://archives.neohapsis.com/archives/vulnwatch/2003-q1/0047.html","http://secunia.com/advisories/7979","http://secunia.com/advisories/8114","http://www.mandriva.com/security/advisories?name=MDKSA-2003:021","http://www.redhat.com/support/errata/RHSA-2003-020.html","https://github.com/CVEProject/cvelistV5/blob/0235c22e9b6c7ddb8ada469b545320bce3ffcbfa/cves/2003/0xxx/CVE-2003-0041.json","https://github.com/LiuCan01/cve-list-pro/blob/78b55511cee3604c22d518e32822f0435d0cacc0/cve-list/CVE-2003/CVE-2003-0041","https://github.com/Patrowl/PatrowlHearsData/blob/cec9fb1846e25b24020f297f65ec2360af0f4267/CVE/data/2003/CVE-2003-0041.json","https://github.com/nomi-sec/NVD-Database/blob/23dc120c34402aaa65883c51c1d03b3cb02c20cb/2003/CVE-2003-0041.json","https://github.com/opencve/opencve-kb/blob/4f65f772070b3f93cf10dae516c0292b5e70e1bb/2003/CVE-2003-0041.json","https://github.com/HORKimhab/poc-cve-collection/blob/918ac66f0b50ab0d2a013bdf692688d3c0abefbc/2003/0xxx/CVE-2003-0041.md","https://github.com/olbat/nvdcve/blob/fe7f195231342e1e88104679c53c965e9a67ac35/nvdcve/CVE-2003-0041.json","https://github.com/aquasecurity/vuln-list-debian/blob/98c311c3ba3abe1f72f8d5cfae5eb671ae60d00f/tracker/CVE/2003/CVE-2003-0041.json","https://github.com/CyberSecAI/cve_info/blob/03b7e36424574a3a9ba5fd13480a326b666a1046/2003/0xxx/CVE-2003-0041.json","https://github.com/fkie-cad/nvd-json-data-feeds/blob/b5070d3c2d6dc2fda079c163276abcda1c82b124/CVE-2003/CVE-2003-00xx/CVE-2003-0041.json"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":[],"repo_exp_urls":[],"has_poc":false,"has_exp":false,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/2003/AVE-2003-0011.toml"},{"ave_id":"AVE-2003-0004","file_name":"2003/AVE-2003-0004.toml","cve_id":"CVE-2003-0019","title":"Red Hat Linux kernel-utils uml_net 本地权限提升漏洞","description":"Red Hat Linux 8.0 的 kernel-utils 软件包中的 uml_net 工具存在不正确的 setuid root 权限设置漏洞。本地普通用户可利用该工具错误的特权提升配置，通过修改 ARP 表项或将网络接口设置为混杂模式等方式，实现对网络接口的未授权修改。攻击者无需任何身份认证即可利用此漏洞，完全控制目标系统的网络行为，造成机密性、完整性和可用性全面受损。该漏洞影响 Red Hat Linux 8.0 系统，CVSS 评分 7.2，危害等级高。","severity":"HIGH","score":7.2,"aliases":["CVE-2003-0019"],"sources":["redhat"],"published":"2003-02-19T05:00:00Z","updated":"2026-06-16T22:01:21Z","remediation":"立即移除 uml_net 的 setuid root 权限位：`chmod u-s /usr/bin/uml_net`，并升级 kernel-utils 包至修复版本（如 kernel-utils-2.4-8.14 及以上）。如无法升级，可通过 `chmod 755 /usr/bin/uml_net` 取消 setuid 位作为临时缓解措施，限制本地用户以 root 权限修改网络接口。","status":"completed","collected_at":"2026-08-03T00:00:00Z","references":["http://www.ciac.org/ciac/bulletins/n-044.shtml","http://www.iss.net/security_center/static/11276.php","http://www.kb.cert.org/vuls/id/134025","http://www.redhat.com/support/errata/RHSA-2003-056.html","http://www.securityfocus.com/bid/6801","https://www.exploit-db.com/exploits/22640","https://github.com/CVEProject/cvelistV5/blob/0661b1b09ba7a2e855981f4a1781f3b8de7cf562/cves/2003/0xxx/CVE-2003-0019.json","https://github.com/Patrowl/PatrowlHearsData/blob/8a257d250bdb59b542a188d62ddae45e6eb5d3f2/CVE/data/2003/CVE-2003-0019.json","https://github.com/LiuCan01/cve-list-pro/blob/78b55511cee3604c22d518e32822f0435d0cacc0/cve-list/CVE-2003/CVE-2003-0019","https://github.com/nomi-sec/NVD-Database/blob/23dc120c34402aaa65883c51c1d03b3cb02c20cb/2003/CVE-2003-0019.json","https://github.com/olbat/nvdcve/blob/fe7f195231342e1e88104679c53c965e9a67ac35/nvdcve/CVE-2003-0019.json","https://github.com/opencve/opencve-kb/blob/a0a14ea0f3a80067c6bf2249ad236215b48e4418/2003/CVE-2003-0019.json","https://github.com/HORKimhab/poc-cve-collection/blob/918ac66f0b50ab0d2a013bdf692688d3c0abefbc/2003/0xxx/CVE-2003-0019.md","https://github.com/fkie-cad/nvd-json-data-feeds/blob/b5070d3c2d6dc2fda079c163276abcda1c82b124/CVE-2003/CVE-2003-00xx/CVE-2003-0019.json","https://github.com/CyberSecAI/cve_info/blob/03b7e36424574a3a9ba5fd13480a326b666a1046/2003/0xxx/CVE-2003-0019.json","https://github.com/yarencheng/cve-devops-playground/blob/2ea9851780633b2caab16fe048a14b38ca9a0b56/content/CVE-2003-0019.md"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":[],"repo_exp_urls":[],"has_poc":false,"has_exp":false,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/2003/AVE-2003-0004.toml"},{"ave_id":"AVE-2003-0003","file_name":"2003/AVE-2003-0003.toml","cve_id":"CVE-2003-0018","title":"Linux Kernel O_DIRECT 信息泄露与文件系统损坏漏洞","description":"Linux 内核 2.4.10 至 2.4.21-pre4 版本中的 O_DIRECT 特性存在安全漏洞。当进程以 O_DIRECT 标志打开文件时，内核未能正确处理直接 I/O 操作的缓存同步机制，导致本地攻击者可通过构造特定的文件读写操作，利用该漏洞读取本应已被删除但仍在磁盘缓存中的文件内容，从而获取其他用户的敏感信息；或通过破坏文件系统元数据的一致性导致文件系统损坏。攻击者需具备本地系统访问权限及文件写入权限，无法远程利用。","severity":"LOW","score":3.6,"aliases":["CVE-2003-0018"],"sources":["redhat"],"published":"2003-02-19T05:00:00Z","updated":"2026-06-16T22:01:21Z","remediation":"升级 Linux 内核至 2.4.21 正式版或更高版本。Red Hat 用户安装 RHSA-2003:025 提供的更新内核；Debian 用户参照 DSA-358/DSA-423 升级；Mandrake 用户安装 MDKSA-2003:014 更新。如无法升级，限制本地用户对 O_DIRECT 特性的访问权限作为临时缓解。","status":"completed","collected_at":"2026-08-03T00:00:00Z","references":["http://linux.bkbits.net:8080/linux-2.4/cset%403e2f193drGJDBg9SG6JwaDQwCBnAMQ","http://www.debian.org/security/2003/dsa-358","http://www.debian.org/security/2004/dsa-423","http://www.iss.net/security_center/static/11249.php","http://www.mandrakesoft.com/security/advisories?name=MDKSA-2003:014","http://www.redhat.com/support/errata/RHSA-2003-025.html","http://www.securityfocus.com/bid/6763","https://github.com/trickest/cve/blob/7d40e7d94b41c478b4d1a654c7bc3bcf34fa7beb/2003/CVE-2003-0956.md","https://github.com/CVEProject/cvelistV5/blob/0661b1b09ba7a2e855981f4a1781f3b8de7cf562/cves/2003/0xxx/CVE-2003-0018.json","https://github.com/LiuCan01/cve-list-pro/blob/78b55511cee3604c22d518e32822f0435d0cacc0/cve-list/CVE-2003/CVE-2003-0018","https://github.com/Patrowl/PatrowlHearsData/blob/8a257d250bdb59b542a188d62ddae45e6eb5d3f2/CVE/data/2003/CVE-2003-0018.json","https://github.com/nottrobin/ubuntu-cve-tracker/blob/36e411296b5707284049ec2e0db8d2622feca498/retired/CVE-2003-0018","https://github.com/kees/ubuntu-cve-tracker/blob/66a43c37da527bc16621fb5548dca8aa1f46e537/retired/CVE-2003-0018","https://github.com/neuvector/vul-source/blob/2880bce38b1c3fec315752297be30e3d60dabff9/ubuntu-cve-tracker/retired/CVE-2003-0018","https://github.com/nomi-sec/NVD-Database/blob/23dc120c34402aaa65883c51c1d03b3cb02c20cb/2003/CVE-2003-0018.json","https://github.com/opencve/opencve-kb/blob/a0a14ea0f3a80067c6bf2249ad236215b48e4418/2003/CVE-2003-0018.json","https://github.com/HORKimhab/poc-cve-collection/blob/918ac66f0b50ab0d2a013bdf692688d3c0abefbc/2003/0xxx/CVE-2003-0018.md"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":[],"repo_exp_urls":[],"has_poc":false,"has_exp":false,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/2003/AVE-2003-0003.toml"},{"ave_id":"AVE-2003-0010","file_name":"2003/AVE-2003-0010.toml","cve_id":"CVE-2003-0039","title":"ISC dhcrelay 无限循环拒绝服务漏洞","description":"ISC dhcrelay (DHCP 中继代理) 3.0rc9 及更早版本存在无限循环拒绝服务漏洞。远程攻击者可发送特制 BOOTP 数据包，该包被转发至广播 MAC 地址，因缺少跳数限制导致数据包在网络中无限循环转发，形成包风暴耗尽带宽资源。攻击无需身份认证，仅需网络可达即可触发，影响运行受版本的 DHCP 中继服务，可导致网络瘫痪。CVSS 评分 5.0 (AV:N/AC:L/Au:N/C:N/I:N/A:P)，属可用性影响类漏洞。","severity":"MEDIUM","score":5.0,"aliases":["CVE-2003-0039"],"sources":["redhat"],"published":"2003-02-07T05:00:00Z","updated":"2026-06-16T22:01:23Z","remediation":"升级 ISC DHCP 软件至 3.0.1 或更高版本。对于无法立即升级的系统，建议在网络边界防火墙或路由器上配置 ACL 规则，拦截或限制异常的 BOOTP 广播流量以缓解拒绝服务风险。","status":"completed","collected_at":"2026-08-03T00:00:00Z","references":["http://cc.turbolinux.com/security/TLSA-2003-26.txt","http://distro.conectiva.com.br/atualizacoes/?id=a&anuncio=000616","http://marc.info/?l=bugtraq&m=104310927813830&w=2","http://www.debian.org/security/2003/dsa-245","http://www.kb.cert.org/vuls/id/149953","http://www.openpkg.org/security/OpenPKG-SA-2003.012-dhcpd.html","http://www.redhat.com/support/errata/RHSA-2003-034.html","http://www.securityfocus.com/bid/6628","https://exchange.xforce.ibmcloud.com/vulnerabilities/11187","https://github.com/CVEProject/cvelistV5/blob/0235c22e9b6c7ddb8ada469b545320bce3ffcbfa/cves/2003/0xxx/CVE-2003-0039.json","https://github.com/LiuCan01/cve-list-pro/blob/78b55511cee3604c22d518e32822f0435d0cacc0/cve-list/CVE-2003/CVE-2003-0039","https://github.com/Patrowl/PatrowlHearsData/blob/038ebe8769d42a55c13282848dec427251956ad1/CVE/data/2003/CVE-2003-0039.json","https://github.com/nomi-sec/NVD-Database/blob/23dc120c34402aaa65883c51c1d03b3cb02c20cb/2003/CVE-2003-0039.json","https://github.com/opencve/opencve-kb/blob/30757a66c9ec8372e159aadb0aa3af74af2b2bdf/2003/CVE-2003-0039.json","https://github.com/HORKimhab/poc-cve-collection/blob/918ac66f0b50ab0d2a013bdf692688d3c0abefbc/2003/0xxx/CVE-2003-0039.md","https://github.com/olbat/nvdcve/blob/fe7f195231342e1e88104679c53c965e9a67ac35/nvdcve/CVE-2003-0039.json","https://github.com/aquasecurity/vuln-list-debian/blob/338375e9291959a955b9c4f1b7794c4836fe2985/tracker/CVE/2003/CVE-2003-0039.json","https://github.com/CyberSecAI/cve_info/blob/03b7e36424574a3a9ba5fd13480a326b666a1046/2003/0xxx/CVE-2003-0039.json","https://github.com/fkie-cad/nvd-json-data-feeds/blob/b5070d3c2d6dc2fda079c163276abcda1c82b124/CVE-2003/CVE-2003-00xx/CVE-2003-0039.json"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":[],"repo_exp_urls":[],"has_poc":false,"has_exp":false,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/2003/AVE-2003-0010.toml"},{"ave_id":"AVE-2003-0002","file_name":"2003/AVE-2003-0002.toml","cve_id":"CVE-2003-0015","title":"CVS 1.11.4 及之前版本 Double-Free 远程代码执行漏洞","description":"CVS 1.11.4 及更早版本中存在双重释放（Double-free）漏洞，远程攻击者可通过向 CVS 服务器发送特制的 Directory 请求触发该漏洞，导致堆内存损坏，进而造成拒绝服务甚至远程代码执行。该漏洞还可绕过写入权限检查，执行 Update-prog 和 Checkin-prog 命令，进一步扩大危害。攻击无需身份认证，通过网络即可完成利用。","severity":"HIGH","score":7.5,"aliases":["CVE-2003-0015"],"sources":["redhat"],"published":"2003-02-07T05:00:00Z","updated":"2026-06-16T22:01:20Z","remediation":"立即将 CVS 服务器升级至 1.11.5 或更高版本。各发行版对应操作：Red Hat Linux 安装 RHSA-2003:012/013 更新包；Debian 升级至 1.11.1p1debian-8.1（woody）或 1.10.7-9.2（potato）；FreeBSD 应用 SA-03:01 补丁。如无法立即升级，可采取临时缓解措施：在防火墙层面阻止对 TCP 2401 端口的访问，禁用匿名 CVS 访问，或将 CVS 服务器置于 chroot 隔离环境中运行以限制攻击影响范围。","status":"completed","collected_at":"2026-08-03T00:00:00Z","references":["http://archives.neohapsis.com/archives/vulnwatch/2003-q1/0028.html","http://ccvs.cvshome.org/servlets/NewsItemView?newsID=51&JServSessionIdservlets=5of2iuhr14","http://marc.info/?l=bugtraq&m=104333092200589&w=2","http://marc.info/?l=bugtraq&m=104342550612736&w=2","http://marc.info/?l=bugtraq&m=104428571204468&w=2","http://marc.info/?l=bugtraq&m=104438807203491&w=2","http://rhn.redhat.com/errata/RHSA-2003-013.html","http://security.e-matters.de/advisories/012003.html","http://www.cert.org/advisories/CA-2003-02.html","http://www.ciac.org/ciac/bulletins/n-032.shtml","http://www.debian.org/security/2003/dsa-233","http://www.kb.cert.org/vuls/id/650937","http://www.mandrakesoft.com/security/advisories?name=MDKSA-2003:009","http://www.redhat.com/support/errata/RHSA-2003-012.html","http://www.securityfocus.com/bid/6650","https://exchange.xforce.ibmcloud.com/vulnerabilities/11108","https://www.exploit-db.com/exploits/22187","https://github.com/trickest/cve/blob/7d40e7d94b41c478b4d1a654c7bc3bcf34fa7beb/2003/CVE-2003-0015.md","https://github.com/CVEDB/Poc-Git/blob/0275aeb329b0747c9a1d46160c921eae06095557/2003/CVE-2003-0015.md","https://github.com/CVEProject/cvelistV5/blob/0661b1b09ba7a2e855981f4a1781f3b8de7cf562/cves/2003/0xxx/CVE-2003-0015.json","https://github.com/kaismax/CVE-Poc/blob/6d8c93dabf674cea102713781cc534d577412357/2003/CVE-2003-0015.md","https://github.com/LiuCan01/cve-list-pro/blob/78b55511cee3604c22d518e32822f0435d0cacc0/cve-list/CVE-2003/CVE-2003-0015","https://github.com/nottrobin/ubuntu-cve-tracker/blob/36e411296b5707284049ec2e0db8d2622feca498/retired/CVE-2003-0015","https://github.com/Patrowl/PatrowlHearsData/blob/8a257d250bdb59b542a188d62ddae45e6eb5d3f2/CVE/data/2003/CVE-2003-0015.json","https://github.com/mabitoski/cve_submodules/blob/44ad7e2705b3aef1b2ffaf64bd47596c10a6c2e4/2003/CVE-2003-0015.md","https://github.com/kees/ubuntu-cve-tracker/blob/66a43c37da527bc16621fb5548dca8aa1f46e537/retired/CVE-2003-0015","https://github.com/neuvector/vul-source/blob/2880bce38b1c3fec315752297be30e3d60dabff9/ubuntu-cve-tracker/retired/CVE-2003-0015"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":[],"repo_exp_urls":[],"has_poc":false,"has_exp":false,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/2003/AVE-2003-0002.toml"},{"ave_id":"AVE-2003-0008","file_name":"2003/AVE-2003-0008.toml","cve_id":"CVE-2003-0026","title":"ISC DHCPD 缓冲区溢出远程代码执行漏洞","description":"ISC DHCPD 3.0 至 3.0.1RC10 版本的 minires 库在错误处理例程中存在多处堆栈缓冲区溢出漏洞。该漏洞源于 NSUPDATE 功能处理 DHCP 消息时，未对过长的主机名字段进行边界检查。远程未认证攻击者可通过发送包含超长主机名的特制 DHCP 数据包触发溢出，在目标系统上以 dhcpd 进程权限执行任意代码。攻击无需任何前置条件，仅需目标运行受影响版本的 DHCP 服务并监听 67/68 端口。成功利用将导致服务器完全沦陷，攻击者可获取系统控制权、窃取敏感数据或进一步横向渗透。CVSS 评分 7.5（AV:N/AC:L/Au:N/C:P/I:P/A:P），属高危漏洞，对网络基础设施构成严重威胁。","severity":"HIGH","score":7.5,"aliases":["CVE-2003-0026"],"sources":["redhat"],"published":"2003-01-17T05:00:00Z","updated":"2026-06-16T22:01:22Z","remediation":"升级 ISC DHCPD 至 3.0.1RC11 或更高版本（如 3.0.1 正式版、3.0.2 等），该版本已修复 minires 库中的栈缓冲区溢出漏洞。若暂时无法升级，可在 DHCP 服务器前部署防火墙规则，限制仅允许可信网段访问 67/68 端口，或在 dhcpd.conf 中禁用 NSUPDATE 功能（移除 allow updates 或 ddns-updates 配置）作为临时缓解措施。建议从 ISC 官网 (https://www.isc.org/downloads/dhcp/) 下载最新稳定版本并重新编译安装。","status":"completed","collected_at":"2026-08-03T00:00:00Z","references":["http://archives.neohapsis.com/archives/bugtraq/2003-01/0250.html","http://distro.conectiva.com.br/atualizacoes/?id=a&anuncio=000562","http://www.cert.org/advisories/CA-2003-01.html","http://www.ciac.org/ciac/bulletins/n-031.shtml","http://www.debian.org/security/2003/dsa-231","http://www.kb.cert.org/vuls/id/284857","http://www.mandriva.com/security/advisories?name=MDKSA-2003:007","http://www.openpkg.com/security/advisories/OpenPKG-SA-2003.002.html","http://www.redhat.com/support/errata/RHSA-2003-011.html","http://www.securityfocus.com/bid/6627","http://www.securitytracker.com/id?1005924","http://www.suse.com/de/security/2003_006_dhcp.html","https://exchange.xforce.ibmcloud.com/vulnerabilities/11073","https://github.com/CVEProject/cvelistV5/blob/0235c22e9b6c7ddb8ada469b545320bce3ffcbfa/cves/2003/0xxx/CVE-2003-0026.json","https://github.com/LiuCan01/cve-list-pro/blob/78b55511cee3604c22d518e32822f0435d0cacc0/cve-list/CVE-2003/CVE-2003-0026","https://github.com/Patrowl/PatrowlHearsData/blob/8a257d250bdb59b542a188d62ddae45e6eb5d3f2/CVE/data/2003/CVE-2003-0026.json","https://github.com/nomi-sec/NVD-Database/blob/23dc120c34402aaa65883c51c1d03b3cb02c20cb/2003/CVE-2003-0026.json","https://github.com/opencve/opencve-kb/blob/7634b452e97baac8445d2f4e188785cc5c593d5a/2003/CVE-2003-0026.json","https://github.com/HORKimhab/poc-cve-collection/blob/918ac66f0b50ab0d2a013bdf692688d3c0abefbc/2003/0xxx/CVE-2003-0026.md","https://github.com/olbat/nvdcve/blob/fe7f195231342e1e88104679c53c965e9a67ac35/nvdcve/CVE-2003-0026.json","https://github.com/aquasecurity/vuln-list-debian/blob/338375e9291959a955b9c4f1b7794c4836fe2985/tracker/CVE/2003/CVE-2003-0026.json","https://github.com/CyberSecAI/cve_info/blob/03b7e36424574a3a9ba5fd13480a326b666a1046/2003/0xxx/CVE-2003-0026.json","https://github.com/fkie-cad/nvd-json-data-feeds/blob/b5070d3c2d6dc2fda079c163276abcda1c82b124/CVE-2003/CVE-2003-00xx/CVE-2003-0026.json"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":[],"repo_exp_urls":[],"has_poc":false,"has_exp":false,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/2003/AVE-2003-0008.toml"},{"ave_id":"AVE-2003-0001","file_name":"2003/AVE-2003-0001.toml","cve_id":"CVE-2003-0001","title":"多厂商以太网网卡设备驱动程序帧填充信息泄露漏洞（Etherleak）","description":"多种以太网网卡（NIC）设备驱动程序在发送数据包时未使用空字节对帧进行填充，导致未初始化的内核内存或先前数据包中的残留信息被泄露给远程攻击者，即 Etherleak 信息泄露漏洞。攻击者可通过发送特制的畸形数据包，从受影响的系统内存中窃取敏感数据，如加密密钥或认证凭据。该漏洞影响大量使用未正确填充帧的网卡驱动程序的系统，攻击条件简单，无需认证即可远程利用。","severity":"MEDIUM","score":5.0,"aliases":["CVE-2003-0001"],"sources":["redhat"],"published":"2003-01-17T05:00:00Z","updated":"2026-06-16T22:01:19Z","remediation":"Linux 系统：Red Hat 用户安装 RHSA-2003:025（内核 2.4）或 RHSA-2003:088（内核 2.2）更新内核包，或通过 up2date 工具自动更新；Debian 用户安装 DSA-311/312/332/336 对应内核补丁。HP-UX 用户安装 PHNE_29244（VVOS EISA 100BT）和 PHNE_29267（VVOS LAN）等累积补丁。Windows 用户更新 Intel NDIS2 驱动至 v3.2 或更新网卡厂商驱动。临时缓解措施：对网络流量启用 IPSec/TLS 加密，减少泄露数据可利用性；在防火墙上对短帧进行零填充过滤。","status":"completed","collected_at":"2026-08-03T00:00:00Z","references":["http://archives.neohapsis.com/archives/vulnwatch/2003-q1/0016.html","http://marc.info/?l=bugtraq&m=104222046632243&w=2","http://secunia.com/advisories/7996","http://www.atstake.com/research/advisories/2003/a010603-1.txt","http://www.atstake.com/research/advisories/2003/atstake_etherleak_report.pdf","http://www.kb.cert.org/vuls/id/412115","http://www.oracle.com/technetwork/topics/security/cpujan2015-1972971.html","http://www.osvdb.org/9962","http://www.redhat.com/support/errata/RHSA-2003-025.html","http://www.redhat.com/support/errata/RHSA-2003-088.html","http://www.securityfocus.com/archive/1/305335/30/26420/threaded","http://www.securityfocus.com/archive/1/307564/30/26270/threaded","http://www.securitytracker.com/id/1031583","http://www.securitytracker.com/id/1040185","https://oval.cisecurity.org/repository/search/definition/oval%3Aorg.mitre.oval%3Adef%3A2665","https://www.exploit-db.com/exploits/3555","https://github.com/trickest/cve/blob/7d40e7d94b41c478b4d1a654c7bc3bcf34fa7beb/2003/CVE-2003-0001.md","https://github.com/nomi-sec/PoC-in-GitHub/blob/57432302d64f9bc08597d61c88fc5f900569476d/2003/CVE-2003-0001.json","https://github.com/hackerhouse-opensource/exploits/blob/268e08341f5fe71b41873aefceda205efc74f9a7/cve-2003-0001.py","https://github.com/trickest/cve/blob/7d40e7d94b41c478b4d1a654c7bc3bcf34fa7beb/2021/CVE-2021-3031.md","https://github.com/CVEDB/Poc-Git/blob/0275aeb329b0747c9a1d46160c921eae06095557/2003/CVE-2003-0001.md","https://github.com/CVEProject/cvelistV5/blob/0661b1b09ba7a2e855981f4a1781f3b8de7cf562/cves/2003/0xxx/CVE-2003-0001.json","https://github.com/kaismax/CVE-Poc/blob/6d8c93dabf674cea102713781cc534d577412357/2003/CVE-2003-0001.md","https://github.com/tigerpuma/HackerFantastic/blob/b18520629ffd2579d4fb1672b11ffc968375623c/exploits/cve-2003-0001.py","https://github.com/LiuCan01/cve-list-pro/blob/78b55511cee3604c22d518e32822f0435d0cacc0/cve-list/CVE-2003/CVE-2003-0001","https://github.com/rix4uni/cvemapping/blob/23441ec855d45e03157b693d7c6d0ff023fe3af5/2003/CVE-2003-0001/README.md","https://github.com/marb08/etherleak-checker"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":[],"repo_exp_urls":[],"has_poc":false,"has_exp":false,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/2003/AVE-2003-0001.toml"}]
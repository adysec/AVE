/blob/03de0f4bc3d6ed449f7108b4761b99fb0c8c56d7/CVE/data/2000/CVE-2000-0282.json","https://github.com/github/advisory-database/blob/e6b10ee602769bd7be4675bf10e3382c1f100e32/advisories/unreviewed/2022/05/GHSA-3j9x-r422-3rxr/GHSA-3j9x-r422-3rxr.json","https://github.com/rhuitl/uClinux/blob/0486e80a025dccbe4a2213715a2ab8a5063ea86b/user/snort/drop-rules/web-cgi.rules","https://github.com/blackhook/nessus-plugins/blob/64177d96abbb07c58cf7e131046b067ebc61fcb5/W/webplus.nasl","https://github.com/nomi-sec/NVD-Database/blob/23dc120c34402aaa65883c51c1d03b3cb02c20cb/2000/CVE-2000-0282.json","https://github.com/magicsword-io/Magic-SigExplorer/blob/2c28b91b003429a144a687199ee99ebd26f1a343/Magic-SigExplorer/docs/cve_report.md","https://github.com/leego972/titanai/blob/afa5b2310463aae5781d3fd9408071bf38e79806/data/raw/corpus_D_cyber/nvd_cve_001283.txt"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":[],"repo_exp_urls":[],"has_poc":false,"has_exp":false,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/2000/AVE-2000-0252.toml"},{"ave_id":"AVE-2000-0235","file_name":"2000/AVE-2000-0235.toml","cve_id":"CVE-2000-0262","title":"AVM KEN! ISDN Proxy 拒绝服务漏洞","description":"AVM KEN! ISDN Proxy Server 1.3.10 及 1.4.30 版本存在输入验证缺陷，远程攻击者可通过向目标服务器发送特制的畸形请求报文，触发服务处理异常导致崩溃，造成拒绝服务。该漏洞无需认证即可触发，攻击门槛低，受影响设备在公共网络下攻击面较大。厂商暂未发布官方补丁，建议限制网络访问权限缓解风险。","severity":"MEDIUM","score":5.0,"aliases":["CVE-2000-0262"],"sources":["avd"],"published":"2000-04-12T04:00:00.000","updated":"2026-06-16T21:51:20.893","remediation":"升级 AVM KEN! 至 1.4.31 或更高版本。如厂商已停止支持该产品，建议停止使用 AVM KEN! ISDN Proxy 并迁移至现代替代方案；临时缓解措施可在防火墙或边界设备上限制对 ISDN Proxy 服务的访问，仅允许受信任 IP 连接。","status":"completed","collected_at":"2026-07-22T00:00:00Z","references":["http://archives.neohapsis.com/archives/bugtraq/2000-04/0073.html","http://www.securityfocus.com/bid/1103","http://www.securityfocus.com/templates/archive.pike?list=1&msg=383085010.956159226625.JavaMail.root%40web305-mc.mail.com","https://www.exploit-db.com/exploits/19843","https://github.com/C
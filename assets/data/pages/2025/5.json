550296d9cb5b12971003dddc7912cdc0707af50/CVE/data/2025/CVE-2025-12084.json","https://github.com/Azure/azure-cli/blob/277130682f41393d0be51ec6c3342473ca607dd7/src/azure-cli-core/HISTORY.rst","https://github.com/nomi-sec/NVD-Database/blob/23dc120c34402aaa65883c51c1d03b3cb02c20cb/2025/CVE-2025-12084.json"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":[],"repo_exp_urls":[],"has_poc":false,"has_exp":false,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/2025/AVE-2025-0499.toml"},{"ave_id":"AVE-2025-0106","file_name":"2025/AVE-2025-0106.toml","cve_id":"CVE-2025-55182","title":"React Server Components 反序列化远程代码执行漏洞","description":"React Server Components 的 RSC 协议存在反序列化漏洞（CWE-502），react-server-dom-parcel、react-server-dom-turbopack 与 react-server-dom-webpack 三个包未能安全校验 HTTP 请求中 Server Function 端点的载荷数据，未经身份认证的远程攻击者可发送特制的序列化请求触发该漏洞，导致远程代码执行。该漏洞影响 React 19.0.0 至 19.2.0 版本，CVSS 评分 10.0，危害等级严重。React 官方已发布修复版本 19.2.1 及更新。","severity":"CRITICAL","score":10.0,"aliases":["CVE-2025-55182"],"sources":["hwpoc"],"published":"2025-12-03T16:15:56Z","updated":"2026-06-17T09:41:24Z","remediation":"立即将 react-server-dom-webpack/react-server-dom-parcel/react-server-dom-turbopack 升级至 19.0.1、19.1.2 或 19.2.1 及以上版本。若使用 Next.js，按对应版本线升级至 14.2.35/15.0.8/15.1.12/15.2.9/15.3.9/15.4.11/15.5.10/16.0.11/16.1.5。若使用 React Router/Waku/Vite RSC 插件，同步升级 react、react-dom 及对应 RSC 包至最新版。无法立即升级时，在反向代理/WAF 层对 /_rsc 等 Server Function 端点实施访问控制或禁用 RSC 功能作为临时缓解。","status":"completed","collected_at":"2026-07-20T00:00:00Z","references":["https://react.dev/blog/2025/12/03/critical-security-vulnerability-in-react-server-components","https://www.facebook.com/security/advisories/cve-2025-55182","http://www.openwall.com/lists/oss-security/2025/12/03/4","https://news.ycombinator.com/item?id=46136026","https://aws.amazon.com/blogs/security/china-nexus-cyber-threat-groups-rapidly-exploit-react2shell-vulnerability-cve-2025-55182/","https://www.cisa.gov/known-exploited-vulnerabilities-catalog?field_cve=CVE-2025-55182","https://
[{"ave_id":"AVE-2000-0799","file_name":"2000/AVE-2000-0799.toml","cve_id":"CVE-2000-0659","title":"AnalogX Proxy Server 缓冲区溢出拒绝服务漏洞","description":"AnalogX Proxy Server 4.04 及更早版本中存在缓冲区溢出漏洞，远程攻击者无需身份认证即可向目标系统发送特制的 SOCKS4 CONNECT 请求，在用户名字段中填入超长字符串触发缓冲区溢出，导致目标服务进程崩溃，造成拒绝服务。该漏洞影响 AnalogX Proxy Server 4.04 及之前所有版本，攻击复杂度较低。","severity":"MEDIUM","score":5.0,"aliases":["CVE-2000-0659"],"sources":["cve"],"published":"2000-07-25T04:00:00.000","updated":"2026-06-16T21:52:12.557","remediation":"升级 AnalogX Proxy 至 4.05 或更高版本以修复 SOCKS4 请求处理中的缓冲区溢出。如无法升级，在防火墙层面限制对 TCP 1080 端口的访问，仅允许可信 IP 段连接，并禁用不必要的 SOCKS4 代理功能。由于该产品已停止维护，建议迁移至现代代理服务器（如 Squid）作为长期解决方案。","status":"completed","collected_at":"2026-07-21T00:00:00Z","references":["http://archives.neohapsis.com/archives/bugtraq/2000-07/0360.html","http://www.securityfocus.com/bid/1504","https://github.com/CVEProject/cvelistV5/blob/3d8ee18720c8a74c03524a9994e81b2de7f6b0ec/cves/2000/0xxx/CVE-2000-0659.json","https://github.com/LiuCan01/cve-list-pro/blob/78b55511cee3604c22d518e32822f0435d0cacc0/cve-list/CVE-2000/CVE-2000-0659","https://github.com/yarencheng/cve-devops-playground/blob/7f1c35ad28226319c149c937b6a2e7a1986924ce/content/CVE-2000-0659.md","https://github.com/Patrowl/PatrowlHearsData/blob/d67487551d3c04e5942b9b8e11c25937ecfba21c/CVE/data/2000/CVE-2000-0659.json","https://github.com/github/advisory-database/blob/b029cc6cdc62926be1ff123d5ca2faba44641d8e/advisories/unreviewed/2022/04/GHSA-vq3q-gw2w-fwwv/GHSA-vq3q-gw2w-fwwv.json","https://github.com/intSpLoiT/intframework/blob/eabaa799d0260aa52b735fa9769266d1ce4b64ef/modules/cve_list.txt","https://github.com/olbat/nvdcve/blob/1c14ae4816efb67123e0664d061a6cbfe48f234b/nvdcve/CVE-2000-0659.json","https://github.com/KTZgraph/sarenka/blob/f1fb931ab722d6c096d581ed6e3c5966d799fbaa/sarenka/feeds/cve_details/cve_all_details_152600_152700.json","https://github.com/SpeeDr00t/speedr00t.github.com/blob/0380f0c2190556fabe90257cb6c0034a42f68951/securityfocus/0x2000/1504/info.html","https://github.com/hungryfoolou/Vulnerability_Mining/blob/3df1d8ed0489ae1228f975ae1f58a690aae53886/craw/cveid_craw/cveid_craw/data/cveid_by_kind/cveid_dos.txt"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":[],"repo_exp_urls":[],"has_poc":false,"has_exp":false,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/2000/AVE-2000-0799.toml"},{"ave_id":"AVE-2000-0796","file_name":"2000/AVE-2000-0796.toml","cve_id":"CVE-2000-0658","title":"AnalogX Proxy Server POP3 USER 命令缓冲区溢出拒绝服务漏洞","description":"AnalogX Proxy Server 4.04 及更早版本中存在缓冲区溢出漏洞，远程攻击者无需认证即可通过向 POP3 协议发送超长的 USER 命令触发该漏洞，导致目标服务崩溃并拒绝服务。该漏洞主要影响使用 AnalogX Proxy 的代理服务器环境，CVSS 评分 5.0，危害等级中危。建议用户升级至最新版本以修复此漏洞。","severity":"MEDIUM","score":5.0,"aliases":["CVE-2000-0658"],"sources":["cve"],"published":"2000-07-25T04:00:00.000","updated":"2026-06-16T21:52:12.437","remediation":"立即升级 AnalogX Proxy 至 v4.05 或更高版本（当前最新版为 v4.15），下载地址 http://www.analogx.com/contents/download/network/proxy.htm。v4.05 版本已明确修复 SMTP/POP3/FTP 处理中的溢出漏洞。如无法立即升级，可在防火墙层面限制对代理服务器 POP3 端口的访问，仅允许内部可信任 IP 连接，以降低远程利用风险。","status":"completed","collected_at":"2026-07-21T00:00:00Z","references":["http://archives.neohapsis.com/archives/bugtraq/2000-07/0360.html","http://www.analogx.com/contents/download/network/proxy.htm","http://www.securityfocus.com/bid/1504","https://github.com/CVEProject/cvelistV5/blob/3d8ee18720c8a74c03524a9994e81b2de7f6b0ec/cves/2000/0xxx/CVE-2000-0658.json","https://github.com/LiuCan01/cve-list-pro/blob/78b55511cee3604c22d518e32822f0435d0cacc0/cve-list/CVE-2000/CVE-2000-0658","https://github.com/yarencheng/cve-devops-playground/blob/7f1c35ad28226319c149c937b6a2e7a1986924ce/content/CVE-2000-0658.md","https://github.com/Patrowl/PatrowlHearsData/blob/d67487551d3c04e5942b9b8e11c25937ecfba21c/CVE/data/2000/CVE-2000-0658.json","https://github.com/github/advisory-database/blob/d4e2196ceafb139802f6ffd1005691ff1a777bac/advisories/unreviewed/2022/04/GHSA-9jv8-f4cc-g337/GHSA-9jv8-f4cc-g337.json","https://github.com/intSpLoiT/intframework/blob/eabaa799d0260aa52b7
[{"ave_id":"AVE-2012-0008","file_name":"2012/AVE-2012-0008.toml","cve_id":"CVE-2012-10018","title":"WordPress Mapplic 插件服务器端请求伪造漏洞","description":"WordPress 的 Mapplic 及 Mapplic Lite 插件存在服务端请求伪造（SSRF）漏洞，受影响版本分别为 6.1 及 1.0 及以下。未经认证的攻击者可利用该漏洞伪造来自目标服务器的请求，在请求 SVG 文件时进一步触发跨站脚本攻击（XSS），危害站点数据安全。CVSS 评分 8.3，危害等级高。","severity":"HIGH","score":8.3,"aliases":["CVE-2012-10018"],"sources":["nuclei"],"published":"2024-10-16T07:15:03Z","updated":"2026-06-16T23:38:40Z","remediation":"立即将 Mapplic 插件升级到 6.2 或更高版本，Mapplic Lite 升级到 1.0.1 或更高版本。补丁已合并至 WordPress 插件仓库（changeset 2503447），可在插件后台直接更新。如无法立即升级，在服务器防火墙或 WAF 层面限制插件对外部域名的 HTTP 请求，并禁止直接访问 SVG 文件，作为临时缓解措施。","status":"completed","collected_at":"2026-07-22T00:00:00Z","references":["https://packetstormsecurity.com/files/161919/","https://packetstormsecurity.com/files/161920/","https://plugins.trac.wordpress.org/changeset/2503447","https://www.mapplic.com/docs/#changelog","https://www.wordfence.com/threat-intel/vulnerabilities/id/5aacabb5-94af-485a-af24-e84db3e3726f?source=cve","https://github.com/projectdiscovery/nuclei-templates/blob/main/http/cves/2012/CVE-2012-10018.yaml","https://github.com/trickest/cve/blob/3ffa2a96db84a89f71e1c7ad889e5f4fcc755a48/2012/CVE-2012-10018.md","https://github.com/projectdiscovery/nuclei-templates/blob/0c7acbe01d12e3db33eedacb7a2c97c0d518fac0/http/cves/2012/CVE-2012-10018.yaml","https://github.com/CVEProject/cvelistV5/blob/b5b2b32751baccad543d82143784e310554463ae/cves/2012/10xxx/CVE-2012-10018.json","https://github.com/topscoder/nuclei-wordfence-cve/blob/50629d052759f7d0d73f7da1b830ff6d52d10f93/nuclei-templates/2012/CVE-2012-10018-mapplic-5aacabb5-94af-485a-af24-e84db3e3726f.yaml","https://github.com/adampielak/nuclei-templates/blob/a2f3ff3fa5db5c7705ebd942909ec114df063700/nuclei-v3/C/CVE-2012-10018_8.yaml","https://github.com/cisagov/vulnrichment/blob/6d175f59444084675ba336cc9e2bc51fc5338e6d/2012/10xxx/CVE-2012-10018.json","https://github.com/rix4uni/nucleihub-templates/blob/579a0234551b9e0e322460a62dc7
_writeup.md"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":[],"repo_exp_urls":[],"has_poc":false,"has_exp":false,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/2010/AVE-2010-0508.toml"},{"ave_id":"AVE-2010-0506","file_name":"2010/AVE-2010-0506.toml","cve_id":"CVE-2010-4344","title":"Exim string_vformat 堆缓冲区溢出远程代码执行漏洞","description":"Exim 邮件服务器 4.70 之前版本中的 string.c 文件的 string_vformat 函数存在堆缓冲区溢出漏洞。远程攻击者可通过 SMTP 会话发送两个 MAIL 命令，配合包含特制头部的大容量消息，触发不当的拒绝日志记录，导致堆缓冲区溢出，进而实现远程代码执行。该漏洞影响所有 Exim 4.70 之前版本，CVSS 评分 9.8，危害等级严重，建议立即升级至 4.70 或更高版本。","severity":"CRITICAL","score":9.8,"aliases":["CVE-2010-4344"],"sources":["kev"],"published":"2010-12-14T16:00:04.163","updated":"2026-06-16T23:24:36.107","remediation":"升级 Exim 至 4.70 或更高版本。无法立即升级时，在 Exim 配置中限制单次 SMTP 连接允许的 MAIL 命令数量（如 acl_smtp_mail 中添加条件限制），或通过防火墙限制 SMTP 端口的源 IP 范围作为临时缓解措施。","status":"completed","collected_at":"2026-07-22T00:00:00Z","references":["http://atmail.com/blog/2010/atmail-6204-now-available/","http://bugs.exim.org/show_bug.cgi?id=787","http://git.exim.org/exim.git/commit/24c929a27415c7cfc7126c47e4cad39acf3efa6b","http://lists.exim.org/lurker/message/20101210.164935.385e04d0.en.html","http://lists.opensuse.org/opensuse-security-announce/2010-12/msg00003.html","http://openwall.com/lists/oss-security/2010/12/10/1","http://secunia.com/advisories/40019","http://secunia.com/advisories/42576","http://secunia.com/advisories/42586","http://secunia.com/advisories/42587","http://secunia.com/advisories/42589","http://www.cpanel.net/2010/12/exim-remote-memory-corruption-vulnerability-notification-cve-2010-4344.html","http://www.debian.org/security/2010/dsa-2131","http://www.exim.org/lurker/message/20101207.215955.bb32d4f2.en.html","http://www.kb.cert.org/vuls/id/682457","http://www.metasploit.com/modules/exploit/unix/smtp/exim4_string_format","http://www.openwall.com/lists/oss-security/2021/05/04/7","http://www.osvdb.org/69685","http://www.redhat.com/support/errata/RHSA-2010-0970.html","http://www.securityfocus.com
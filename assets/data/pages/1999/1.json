/KTZgraph/sarenka/blob/f1fb931ab722d6c096d581ed6e3c5966d799fbaa/sarenka/feeds/cve_details/cve_all_details_16300_16400.json","https://github.com/fkie-cad/nvd-json-data-feeds/blob/0a4a7f56dfc30768c155321303b74f1a8078c31d/CVE-1999/CVE-1999-15xx/CVE-1999-1594.json","https://github.com/williamjsmail/piranha/blob/e60f12e6edcde8585ee473f701c2421f6efe72d9/CVE2CAPEC/database/CVE-1999.jsonl","https://github.com/KTZgraph/rzodkiewka/blob/bcaf2a48d30c8e777c12bfbd7f22d62098367898/classified/without_base_metric_v2.json","https://github.com/anupyadav27/vul_engine/blob/a8097b9e67cadc2f27ec55d877baae68c93d9b92/vuln_db/nvd/nvd_data/nvdcve-1.1-2002.json","https://github.com/justakazh/CVE_Database/blob/06bd07f32c89b43f30d59ff450dfbb661e471cbe/1999/CVE-1999-1594.json"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":[],"repo_exp_urls":[],"has_poc":false,"has_exp":false,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/1999/AVE-1999-1212.toml"},{"ave_id":"AVE-1999-0009","file_name":"1999/AVE-1999-0009.toml","cve_id":"CVE-1999-0199","title":"GNU glibc tdelete 未检查返回值导致悬垂指针访问漏洞","description":"GNU C 库（glibc）2.2 之前版本的 manual/search.texi 文档未明确说明 tdelete 函数在删除树根节点时的返回值未定义，导致开发者误用该返回值而访问悬空指针。攻击者可利用此缺陷触发程序崩溃或信息泄露。该漏洞影响所有使用旧版 glibc 的 Linux 系统，CVSS 评分 9.8，危害等级严重。用户应升级至 glibc 2.2 及以上版本以修复此问题。","severity":"CRITICAL","score":9.8,"aliases":["CVE-1999-0199"],"sources":["redhat"],"published":"2020-10-06T13:15:13Z","updated":"2026-06-16T21:47:53Z","remediation":"升级 glibc 至 2.2 及以上版本以获取完整的 tdelete 返回值文档说明；应用程序中调用 tdelete 后须检查返回值是否为 NULL，避免直接解引用潜在悬挂指针。无法升级时，在调用 tdelete 删除树根节点后手动将指针置 NULL。","status":"completed","collected_at":"2026-07-22T00:00:00Z","references":["https://ftp.gnu.org/gnu/glibc/glibc-2.2.tar.gz","https://github.com/bminor/glibc/commit/2864e767053317538feafa815046fff89e5a16be#diff-94e8c502f255fdfc346df0e29fd4ef40","https://www.cee.studio/tdelete.html","https://github.com/trickest/cve/blob/3ffa2a96db84a89f71e1c7ad889e5f4fcc755a48/1999/CVE-1999-0199.md","https://github.com/CVEProject/cvelistV5/blob/b5b2b32751baccad543d82143784e310554463ae/cves/1999/0xxx/CVE-1999-0199.json","https://github.com/exein-io/kepler/blob/acb566a88795464de78b4a1859800346c6b83f62/domain-db/src/db/fixtures/single_CVE-1999-0199.json","https://github.com/Patrowl/PatrowlHearsData/blob/affa68d6539dbc90b6b6e0e1e746facb4aae08df/CVE/data/1999/CVE-1999-0199.json","https://github.com/mabitoski/cve_submodules/blob/44ad7e2705b3aef1b2ffaf64bd47596c10a6c2e4/1999/CVE-1999-0199.md","https://github.com/github/advisory-database/blob/1721417c5dc7c1cbf858e5ea5a5245ea62e70cce/advisories/unreviewed/2022/04/GHSA-7hm4-28mg-fmp9/GHSA-7hm4-28mg-fmp9.json","https://github.com/u91738/cvematch/blob/7df60a9d96ed605cdff87e97361966832915c18d/README.md","https://github.com/VanceLongwill/cve_data_analysis/blob/58e80fc4858f0505560159e26179aaa337f7dc76/yearly.py","https://github.com/nomi-sec/NVD-Exploit-List-Ja/blob/b82432e7d59d95db9f183c0cefa7744595784afa/1999.tsv","https://github.com/euisuh/CVEFixesUtil/blob/80553ecb562dae14f0d21a3addfd789e14f1bd3c/main.ipynb"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":[],"repo_exp_urls":[],"has_poc":false,"has_exp":false,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/1999/AVE-1999-0009.toml"},{"ave_id":"AVE-1999-2108","file_name":"1999/AVE-1999-2108.toml","cve_id":"CVE-1999-1593","title":"Microsoft Windows Internet 命名服务 拒绝服务漏洞","description":"Windows Internet 命名服务（WINS）存在安全设计缺陷，远程攻击者可通过向 WINS 服务器发送恶意的 1Ch 注册请求，使域控制器记录被篡改为指向攻击者控制的恶意服务器，从而导致目标网络连接中断或凭据被窃取。该漏洞影响 Microsoft Windows 域控制器环境，CVSS 评分 7.6，危害等级高。Windows 95/98 客户端环境下影响可能受限。","severity":"HIGH","score":7.6,"aliases":["CVE-1999-1593"],"sources":["avd"],"published":"2009-01-15T01:30:00Z","updated":"2026-06-16T21:50:47Z","remediation":"在 WINS 管理控制台中将域控制器 (1Ch) 记录设置为静态条目而非动态注册，防止被恶意覆盖；将 Windows 2000 升级至 Service Pack 4 以应用所有已知安全更新；在防火墙层面限制对 WINS 服务器 UDP/TCP 137 端口的访问，仅允许受信任的子网发起注册请求；如条件允许，停用 WINS 并迁移至基于 DNS 的 Active Directory 名称解析方案以彻底规避该风险。","status":"completed","collected_at":"2026-07-21T00:00:00Z","references":["http
fef0a471ab5dd3dbc00f5e99397/ooo-trunk/content/security/cves/CVE-2010-2935_CVE-2010-2936.html"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":[],"repo_exp_urls":[],"has_poc":false,"has_exp":false,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/2010/AVE-2010-0190.toml"},{"ave_id":"AVE-2010-0189","file_name":"2010/AVE-2010-0189.toml","cve_id":"CVE-2010-2935","title":"Apache OpenOffice Impress PowerPoint文档解析堆缓冲区溢出远程代码执行漏洞","description":"OpenOffice.org（OOo）Impress模块中的simpress.bin组件在处理PowerPoint文档中的字典属性项整数值时存在整数截断错误，导致堆缓冲区溢出。远程攻击者可通过向受影响系统发送特制的PowerPoint文档触发此漏洞，成功利用可在目标系统上执行任意代码或导致应用程序崩溃。该漏洞影响OpenOffice.org 2.x及3.x系列3.3之前的所有版本，攻击无需身份认证，仅需诱导用户打开恶意文件即可触发。","severity":"CRITICAL","score":9.3,"aliases":["CVE-2010-2935"],"sources":["tenable"],"published":"2010-08-25T20:00:17Z","updated":"2026-06-16T23:21:47Z","remediation":"立即升级到 OpenOffice.org 3.3 或更高版本，该版本已修复 Impress 模块中 simpress.bin 处理 PowerPoint 文档字典属性项时的整数截断堆缓冲区溢出漏洞。如无法升级，建议迁移至 Apache OpenOffice 4.x 或 LibreOffice 3.3.4 以上版本，并避免打开来源不明的 PowerPoint 文件。Linux 用户可通过系统包管理器安装安全更新（如 Ubuntu 执行 apt-get update && apt-get upgrade openoffice.org）。","status":"completed","collected_at":"2026-07-27T00:00:00Z","references":["http://lists.opensuse.org/opensuse-security-announce/2010-10/msg00006.html","http://lists.opensuse.org/opensuse-security-announce/2010-12/msg00006.html","http://secunia.com/advisories/40775","http://secunia.com/advisories/41052","http://secunia.com/advisories/41235","http://secunia.com/advisories/42927","http://secunia.com/advisories/43105","http://secunia.com/advisories/60799","http://securityevaluators.com/files/papers/CrashAnalysis.pdf","http://ubuntu.com/usn/usn-1056-1","http://www.debian.org/security/2010/dsa-2099","http://www.gentoo.org/security/en/glsa/glsa-201408-19.xml","http://www.mandriva.com/security/advisories?name=MDVSA-2010:221","http://www.openoffice.org/security/cves/CVE-2010-2935_CVE-2010-2936.html","http://www.openoffice.org/servlets/ReadMsg?list=dev&msgNo=27690","http://www.openwall.com/lists/oss-security/2010/08/11/1","http://www.openwall.com/lists/oss-security/2010/08/11/4","http://www.oracle.com/technetwork/topics/security/cpujan2011-194091.html","http://www.redhat.com/support/errata/RHSA-2010-0643.html","http://www.securitytracker.com/id?1024352","http://www.securitytracker.com/id?1024976","http://www.vupen.com/english/advisories/2010/2003","http://www.vupen.com/english/advisories/2010/2149","http://www.vupen.com/english/advisories/2010/2228","http://www.vupen.com/english/advisories/2010/2905","http://www.vupen.com/english/advisories/2011/0150","http://www.vupen.com/english/advisories/2011/0230","http://www.vupen.com/english/advisories/2011/0279","https://bugzilla.redhat.com/show_bug.cgi?id=622529","https://oval.cisecurity.org/repository/search/definition/oval%3Aorg.mitre.oval%3Adef%3A12063","https://github.com/trickest/cve/blob/e69d88e0152845fc4d4b49970ca6e503f56b2f93/2010/CVE-2010-2935.md","https://github.com/CVEProject/cvelistV5/blob/4a22bba3217932039300edbc77cd188c415d71c8/cves/2010/2xxx/CVE-2010-2935.json","https://github.com/apache/openoffice-org/blob/8229366d1e4d6b49b6b7814c530e13f2c4dcb931/content/security/cves/CVE-2010-2935_CVE-2010-2936.html","https://github.com/nottrobin/ubuntu-cve-tracker/blob/36e411296b5707284049ec2e0db8d2622feca498/retired/CVE-2010-2935","https://github.com/edoardottt/missing-cve-nuclei-templates/blob/b93b72c800b93d13fcc97984485ecaf9a9b5cbc1/data/year/2010.txt","https://github.com/0xMarcio/cve/blob/acf4fca32ae3e6d7d43276d798ba52a241ef3b49/2010/CVE-2010-2935.md","https://github.com/nomi-sec/NVD-Database/blob/23dc120c34402aaa65883c51c1d03b3cb02c20cb/2010/CVE-2010-2935.json","https://github.com/neuvector/vul-source/blob/83b6758c208f8fd7e22b7c88e002c3658ef467b8/ubuntu-cve-tracker/retired/CVE-2010-2935","https://github.com/github/advisory-database/blob/29919db3f954d9ce9be0e7e3cf177436392d45d3/advisories/unreviewed/2022/05/GHSA-fhhr-xhww-w2vm/GHSA-fhhr-xhww-w2vm.json","https://github.com/SunStarSys/orion/blob/845dc4a772afcfef0a471ab5dd3dbc00f5e99397/ooo-trunk/content/security/cves/CVE-2010-2935_CVE-2010-2936.html"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":[],"repo_exp_urls":[],"has_poc":false,"has_exp":false,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/2010/AVE-2010-0189.toml"},{"ave_id":"AVE-2010-0069","file_name":"2010/AVE-2010-0069.toml","cve_id":"CVE-2010-1870","title":"Apache Struts2 远程命令执行漏洞","description":"Apache Struts2 2.0.0 至 2.1.8.1 版本中的 XWork 组件存在 OGNL 表达式求值漏洞（S2-005），由于 OGNL 广泛的表达式求值能力使用了宽松的白名单机制，远程未授权攻击者可通过构造恶意 OGNL 表达式，利用 #context、#_memberAccess、#root、#this、#_typeResolver、#_classResolver、#_traceEvaluations、#_lastEvaluation、#_keepLastEvaluation 等上下文变量绕过 ParameterInterceptors 中的 \"#\" 字符保护机制，修改服务端上下文对象并执行任意系统命令。该漏洞影响 Apache Struts2 2.0.0～2.1.8.1 版本及基于此构建的 Atlassian Fisheye、Crucible 等产品，攻击者无需认证即可远程发起攻击，可导致服务器完全被接管。该漏洞不同于 CVE-2008-6504，属于独立的 OGNL 表达式注入漏洞，CVSS 评分 5.0（中等严重度）。官方已在 Struts 2.2.0 版本中修复该漏洞，建议用户升级至 2.2.0 或更高版本。","severity":"MEDIUM","score":5.0,"aliases":["CVE-2010-1870"],"sources":["nuclei"],"published":"2010-08-17T20:00:03Z","updated":"2026-06-16T23:19:29Z","remediation":"升级到 Apache Struts 2.2.0 或更高版本，该版本默认收紧了 OGNL 表达式的白名单并修复 `#_memberAccess` 保护机制绕过问题。若无法立即升级，可在自定义 Action 中实现 `ParameterNameAware` 接口，在 `acceptableParameterName` 中拒绝包含 `#`、`(`、`)` 等字符的参数名以阻断 OGNL 上下文变量注入；同时在 Web 应用防火墙(WAF)规则中拦截含 `#context`、`#_memberAccess`、`#root` 等字符串的请求参数作为临时缓解措施。","status":"completed","collected_at":"2026-07-15T00:00:00Z","references":["http://blog.o0o.nu/2010/07/cve-2010-1870-struts2xwork-remote.html","http://confluence.atlassian.com/display/FISHEYE/FishEye+Security+Advisory+2010-06-16","http://packetstormsecurity.com/files/159643/LISTSERV-Maestro-9.0-8-Remote-Code-Execution.html","http://seclists.org/fulldisclosure/2010/Jul/183","http://seclists.org/fulldisclosure/2020/Oct/23","http://secunia.com/advisories/59110","http://securityreason.com/securityalert/8345","http://struts.apache.org/2.2.1/docs/s2-005.html","http://tools.cisco.com/security/center/content/CiscoSecurityAdvisory/cisco-sa-20140709-struts2","http://www.exploit-db.com/exploits/14360","http://www.osvdb.org/66280","http://www.securityfocus.com/bid/41592","https://www.exploit-db.com/exploits/14360","https://github.com/projectdiscovery/nuclei-templates/blob/main/http/cves/2010/CVE-2010-1870.yaml","https://github.com/trickest/cve/blob/8600ac0c091970175de0b53d9682f50858aef8dc/2010/CVE-2010-1870.md","https://github.com/projectdiscovery/nuclei-templates/blob/6bfef5eb290cbfeb2b2cb4d2bae8e5cab0243137/http/cves/2010/CVE-2010-1870.yaml","https://github.com/CVEProject/cvelistV5/blob/24b6c514a7b18b3a83429b0eaa19c9cb61a02fb8/cves/2010/1xxx/CVE-2010-1870.json","https://github.com/ExpLangcn/NucleiTP/blob/2b7ecb9031a6eda4f272793045f29b339d8e0cce/CVES/info/cve-2010-1870-1817.yaml","https://github.com/govbk/WIKI-POC-EXP/blob/7d1194429dab9f9dd8139408e79b70ddb41a468f/%E9%9B%B6%E7%BB%84%E6%BC%8F%E6%B4%9E%E7%9B%B8%E5%85%B3/160-Apache%20Struts/005-%EF%BC%88CVE-2010-1870%EF%BC%89s2-005.md","https://github.com/linuxadi/40k-nuclei-templates/blob/542be6820c801c02a33aee60f1c05ca7b0b5005f/aditya/folder3/cve-2010-1870-1819.yaml","https://github.com/adampielak/nuclei-templates/blob/ac9605f5a915670fd80cb4e1904f4435f1835b65/nuclei-v2/C/cve-2010-1870-2.yaml","https://github.com/zhzyker/vulmap/blob/3694afb7a3adec0b7f7c9027aab596e7b147c585/readme.md","https://github.com/SleepingBag945/dddd/blob/4c428a7c171275bfbb5fa72c2fb4bd7b48f4ff4a/common/config/pocs/CVE-2010-1870.yaml","https://github.com/KeepHowling/all_freaking_nuclei_templates/blob/b374318732b6922f72d327c57451a7d30973c0c6/CVE-2010-1870-2.yaml"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":[],"repo_exp_urls":[],"has_poc":false,"has_exp":false,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/2010/AVE-2010-0069.toml"},{"ave_id":"AVE-2010-0106","file_name":"2010/AVE-2010-0106.toml","cve_id":"CVE-2010-2861","title":"Adobe ColdFusion 管理控制台目录遍历漏洞","description":"Adobe ColdFusion 9.0.1 及更早版本的管理控制台存在多处目录遍历漏洞，攻击者可通过向 CFIDE/administrator 下的 settings/mappings.cfm、logging/settings.cfm、datasources/index.cfm、j2eepackaging/editarchive.cfm 以及 enter.cfm 等页面的 locale 参数注入路径遍历序列，绕过访问控制读取服务器上的任意文件，从而获取敏感配置信息或凭据。该漏洞无需认证即可远程利用，已被 CISA 纳入已知被利用漏洞目录。","severity":"CRITICAL","score":9.8,"aliases":["CVE-2010-2861"],"sources":["cve"],"published":"2010-08-11T00:00:00Z","updated":"2026-06-16T00:00:00Z","remediation":"升级 Adobe ColdFusion 至 9.0.2 或更高版本，或按照 Adobe 安全公告 APSB10-18 的指引安装官方补丁。如暂时无法升级，应在 Web 服务器或应用层对 locale 参数进行严格白名单校验，禁止包含 ../ 等路径遍历字符的请求到达管理控制台。","status":"completed","collected_at":"2026-07-22T15:41:24Z","references":["https://www.adobe.com/support/security/bulletins/apsb10-18.html","http://www.gnucitizen.org/blog/coldfusion-directory-traversal-faq-cve-2010-2861/","https://www.cisa.gov/known-exploited-vulnerabilities-catalog?field_cve=CVE-2010-2861"],"poc_urls":["http://www.gnucitizen.org/blog/coldfusion-directory-traversal-faq-cve-2010-2861/"],"exp_urls":[],"repo_poc_urls":[],"repo_exp_urls":[],"has_poc":false,"has_exp":false,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/2010/AVE-2010-0106.toml"},{"ave_id":"AVE-2010-0306","file_name":"2010/AVE-2010-0306.toml","cve_id":"CVE-2010-1871","title":"Red Hat JBoss Enterprise Application Platform JBoss Seam 2 表达式语言注入远程代码执行漏洞","description":"JBoss Seam 2 组件存在表达式语言（EL）注入漏洞，由于其对 JBoss EL 表达式的输入过滤不严，远程攻击者可通过向 JBoss Enterprise Application Platform 4.3.0 发送特制 URL 触发该漏洞，实现任意文件上传或远程代码执行。该漏洞影响 Red Hat Linux 平台上的 JBoss EAP 4.3.0，CVSS 评分 8.8，危害等级高。仅在 Java Security Manager 未正确配置时受影响，厂商已发布修复建议。","severity":"HIGH","score":8.8,"aliases":["CVE-2010-1871"],"sources":["kev"],"published":"2010-08-05T13:23:09Z","updated":"2026-06-16T23:19:29Z","remediation":"升级 JBoss Enterprise Application Platform 至 4.3.0 CP07 及以上版本，或升级 JBoss Seam 至 2.2.1.CR2 及以上版本，以修复 Seam 组件对 EL 表达式输入过滤不严的问题。同时确保正确配置 Java Security Manager，限制表达式引擎权限，并部署 Web 应用防火墙 (WAF) 拦截包含 EL 表达式的恶意请求作为临时缓解。","status":"completed","collected_at":"2026-07-22T00:00:00Z","references":["http://archives.neohapsis.com/archives/bugtraq/2013-05/0117.html","http://www.redhat.com/support/errata/RHSA-2010-0564.html","http://www.securityfocus.com/bid/41994","http://www.securitytracker.com/id?1024253","http://www.vupen.com/english/advisories/2010/1929","https://bugzilla.redhat.com/show_bug.cgi?id=615956","https://exchange.xforce.ibmcloud.com/vulnerabilities/60794","https://security.netapp.com/advisory/ntap-20161017-0001/","https://www.cisa.gov/known-exploited-vulnerabilities-catalog?field_cve=CVE-2010-1871","https://www.exploit-db.com/exploits/36653","https://github.com/trickest/cve/blob/ed228d55b7972f63e700a35a54fbcd94064b9ade/2010/CVE-2010-1871.md","https://github.com/ExpLangcn/NucleiTP/blob/2b7ecb9031a6eda4f272793045f29b339d8e0cce/CVES/high/CVE-2010-1871.yml","https://github.com/zema1/yarx/blob/415b606b7a170d061c668936f34c183cea8788bf/pocs/jboss-cve-2010-1871.yml","https://github.com/zan8in/afrog-pocs/blob/253291be2d307a6c836d5997bbb838f1e846f9ba/CVE/2010/CVE-2010-1871.yaml","https://github.com/ARPSyndicate/suricata-vedas/blob/fe24794ad36564b5bbc7c69101525011387b8650/2010/CVE-2010-1871.rules","https://github.com/olbat/nvdcve/blob/5b92f5917a4a825187ccaac594f43456a77ea8f3/nvdcve/CVE-2010-1871.json","https://github.com/orangetw/My-CTF-Web-Challenges/blob/46e3863275880e2fc025a43303d09a50f2da22c3/README.md","https://github.com/WyAtu/Perun/blob/c081b9ed0243cecfcea251e72e2905103a6556a1/vuln/jboss/jboss_adminconsole.py","https://github.com/e-m-b-a/emba/blob/4d0f24b3edae0bdb5391177851bad3be54ecea0f/config/msf_cve-db.txt","https://github.com/fankh/vulnerability-poc/blob/ffa50060b7ba6ae58d60d6d90533e77eaf10d466/2010/CVE-2010-1871/README_KO.md"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":[],"repo_exp_urls":[],"has_poc":false,"has_exp":false,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/2010/AVE-2010-0306.toml"},{"ave_id":"AVE-2010-0102","file_name":"2010/AVE-2010-0102.toml","cve_id":"CVE-2010-2920","title":"Joomla! Foobla Suggestions 组件 本地文件包含漏洞","description":"Joomla! 组件 Foobla Suggestions 1.5.1.2 存在目录遍历漏洞（CWE-22），攻击者可通过 index.php 的 controller 参数传入目录遍历序列（如 ../）读取服务器任意文件。该漏洞影响使用该组件的 Joomla! 站点，CVSS 评分 6.8（中危），攻击者无需认证即可远程利用，通过构造恶意 controller 参数实现任意文件读取，可能导致敏感配置文件、源代码泄露。ExploitDB 已收录公开利用代码。","severity":"MEDIUM","score":6.8,"aliases":["CVE-2010-2920"],"sources":["nuclei"],"published":"2010-07-30T20:30:03Z","updated":"2026-06-16T23:21:45Z","remediation":"升级或卸载存在漏洞的 Foobla Suggestions (com_foobla_suggestions) 组件 1.5.1.2 版本，或替换为其修复版本（需过滤 controller 参数中的 \"../\" 等目录穿越字符）。若无法立即更新，可在 Joomla! 后台禁用该组件，并通过 .htaccess 添加规则拒绝 index.php 请求中携带 \"controller=../\" 或 NULL 字节等穿越序列，作为临时缓解措施。","status":"completed","collected_at":"2026-07-15T00:00:00Z","references":["http://packetstormsecurity.org/1004-exploits/joomlafoobla-lfi.txt","http://www.exploit-db.com/exploits/12120","http://www.securityfocus.com/bid/39341","http://www.vupen.com/english/advisories/2010/1844","https://exchange.xforce.ibmcloud.com/vulnerabilities/57660","https://www.exploit-db.com/exploits/12120","https://github.com/projectdiscovery/nuclei-templates/blob/main/http/cves/2010/CVE-2010-2920.yaml","https://github.com/trickest/cve/blob/8600ac0c091970175de0b53d9682f50858aef8dc/2010/CVE-2010-2920.md","https://github.com/projectdiscovery/nuclei-templates/blob/6bfef5eb290cbfeb2b2cb4d2bae8e5cab0243137/http/cves/2010/CVE-2010-2920.yaml","https://github.com/sepehrdaddev/zap-scripts/blob/2b63b02ca79cc7f0023cdbab72c5c6c774354b07/active/CVE-2010-2920.js","https://github.com/0xKayala/Custom-Nuclei-Templates/blob/1940dfd29577590f076c89dec5c30d809d68f210/6001-to-7000-templates/cve-2010-2920-1980.yaml","https://github.com/rix4uni/nucleihub-templates/blob/579a0234551b9e0e322460a62dc77bd6109e4aff/nucleihub-templates/CVE-2010-2920.yaml","https://github.com/adampielak/nuclei-templates/blob/ac9605f5a915670fd80cb4e1904f4435f1835b65/nuclei-v3/C/CVE-2010-2920_10.yaml","https://github.com/Patrowl/PatrowlHearsData/blob/d6a37376bba332b033eeef800cc2b5fc0701d843/CVE/data/2010/CVE-2010-2920.json","https://github.com/coreruleset/seaweed-reports/blob/3
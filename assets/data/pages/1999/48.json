github.com/Patrowl/PatrowlHearsData/blob/d0a8c476da89b37a2bbb6193b7964b10d03aff75/CVE/data/1999/CVE-1999-1171.json","https://github.com/github/advisory-database/blob/cdfc8886d71af7ef3bdab3e4db46753ff8af6538/advisories/unreviewed/2022/04/GHSA-gpw9-cfwq-7rm5/GHSA-gpw9-cfwq-7rm5.json","https://github.com/olbat/nvdcve/blob/39f1db26eec9899ab2f8110ab3b45424c6fe9ec2/nvdcve/CVE-1999-1171.json","https://github.com/KTZgraph/sarenka/blob/f1fb931ab722d6c096d581ed6e3c5966d799fbaa/sarenka/feeds/cve_details/cve_all_details_153300_153400.json","https://github.com/andreafioraldi/ToolsForCyberChallenge/blob/197d3dfd204cf1b9d1af1451455c8831c3ff9948/generated/files_0.list.dict","https://github.com/leego972/titanai/blob/afa5b2310463aae5781d3fd9408071bf38e79806/data/raw/corpus_D_cyber/nvd_cve_000511.txt","https://github.com/oasis-open/cti-stix-common-objects/blob/55ba7598cbd5a52577b6887871505d931d85cb61/objects/vulnerability/vulnerability--5f1126f3-181a-40e2-b8db-44c185a4cc5d.json"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":[],"repo_exp_urls":[],"has_poc":false,"has_exp":false,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/1999/AVE-1999-1247.toml"},{"ave_id":"AVE-1999-0619","file_name":"1999/AVE-1999-0619.toml","cve_id":"CVE-1999-0383","title":"ACC Tigris 未授权访问漏洞","description":"ACC Tigris 存在未授权访问漏洞，远程攻击者无需任何身份认证即可直接访问系统管理界面，获取敏感信息或执行未授权操作。该漏洞影响 ACC Tigris 产品，攻击者只需网络可达即可利用，无需复杂攻击条件。CVSS 评分 7.5，危害等级高。","severity":"HIGH","score":7.5,"aliases":["CVE-1999-0383"],"sources":["epss"],"published":"1999-02-02T05:00:00Z","updated":"2026-06-16T21:48:16Z","remediation":"ACC Tigris 产品已停止维护，无官方补丁可用。建议立即在 Web 服务器前端部署反向代理（如 Nginx/Apache）并配置 HTTP 基本认证或 IP 白名单访问控制；同时在网络防火墙层面限制对 ACC Tigris 服务端口（默认 80）的访问来源，仅允许受信 IP 段连接。长期方案为迁移至受支持的现代 Web 服务器软件。","status":"completed","collected_at":"2026-07-16T00:00:00Z","references":["http://www.osvdb.org/267","http://www.securityfocus.com/bid/183","https://github.com/CVEProject/cvelistV5/blob/e927b0fe51353a8ed03f0466aad3c47ffd172da3/cves/1999/0xxx/CVE-1999-0383.json","https://github.com/LiuCan01/cve-list-pro/blob/78b55511cee3604c22d518e32822f0435d0cacc0/cve-list/CVE-1999/CVE-1999-0383","https://github.com/yarencheng/cve-devops-playground/blob/45be3b4afd9c4397ee32a5cbf6819a590220b0c1/content/CVE-1999-0383.md","https://github.com/Patrowl/PatrowlHearsData/blob/8c57fab4f71bd6fdcec1202e5361e2a9805c4950/CVE/data/1999/CVE-1999-0383.json","https://github.com/github/advisory-database/blob/6eca843f42fd99fea8c9b630931afac7c9d4576c/advisories/unreviewed/2022/04/GHSA-7hmx-xxrr-h2wg/GHSA-7hmx-xxrr-h2wg.json","https://github.com/xqcyberscore/nvt/blob/978f6a9acb495d7d669239530ffe6da5d631f4da/pre2008/account_public_public.nasl","https://github.com/LubyRuffy/plugins/blob/f873b19f27c95eaf2993ca4acde5cb7965d2ee3f/pre2008/acc.nasl","https://github.com/nomi-sec/NVD-Database/blob/23dc120c34402aaa65883c51c1d03b3cb02c20cb/1999/CVE-1999-0383.json","https://github.com/intSpLoiT/intframework/blob/eabaa799d0260aa52b735fa9769266d1ce4b64ef/modules/cve_list.txt","https://github.com/KTZgraph/sarenka/blob/f1fb931ab722d6c096d581ed6e3c5966d799fbaa/sarenka/feeds/cve_details/cve_all_details_153300_153400.json"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":["https://raw.githubusercontent.com/adysec/AVE/main/pocs/1999/POC-AVE-1999-0619.toml"],"repo_exp_urls":[],"has_poc":true,"has_exp":false,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/1999/AVE-1999-0619.toml"},{"ave_id":"AVE-1999-0594","file_name":"1999/AVE-1999-0594.toml","cve_id":"CVE-1999-0362","title":"Ipswitch WS_FTP Server 远程拒绝服务漏洞","description":"Ipswitch WS_FTP Server 1.0.1 及 1.0.2 版本存在远程拒绝服务漏洞。未经身份认证的攻击者可通过向目标 FTP 服务器发送特制的 CWD（Change Working Directory）命令，导致 FTP 服务进程异常崩溃或停止响应，从而中断正常的文件传输服务。该漏洞 CVSS 评分 5.0，危害等级中危，受影响用户应升级至更高版本以修复此问题。","severity":"MEDIUM","score":5.0,"aliases":["CVE-1999-0362"],"sources":["epss"],"published":"1999-02-02T05:00:00Z","updated":"2026-06-16T21:48:13Z","remediation":"升级至 WS_FTP Server 1.0.3 及以上版本可修复此漏洞；在防火墙中限制 FTP 服务端口的访问来源 IP，防止未授权远程连接发起 CWD 命令攻击。鉴于该产品版本过于老旧，建议迁移至受支持的最新版 WS_FTP Server 或替代 FTP 服务软件。","status":"completed","collected_at":"2026-07-16T00:00:00Z","references":["http://www.eeye.com/html/Research/Advisories/AD02021999.html","http://www.securityfocus.com/bid/217","https://github.com/CVEProject/cvelistV5/blob/0cda26301f5b3e56ace35e3d98835812d878db41/cves/1999/0xxx/CVE-1999-0362.json","https://github.com/LiuCan01/cve-list-pro/blob/78b55511cee3604c22d518e32822f0435d0cacc0/cve-list/CVE-1999/CVE-1999-0362","https://github.com/yarencheng/cve-devops-playground/blob/45be3b4afd9c4397ee32a5cbf6819a590220b0c1/content/CVE-1999-0362.md","https://github.com/Patrowl/PatrowlHearsData/blob/638fc08494602a9faf37bf81043122f16d26625c/CVE/data/1999/CVE-1999-0362.json","https://github.com/rhuitl/uClinux/blob/0486e80a025dccbe4a2213715a2ab8a5063ea86b/user/nessus/nessus-plugins/scripts/wsftp_cwd_dos.nasl","https://github.com/feng-li/tools-for-data-science-course/blob/8e62d47ee8ffbebe9a0e50aee193617f83883118/2019spring/2017312271/result.txt","https://github.com/nomi-sec/NVD-Database/blob/23dc120c34402aaa65883c51c1d03b3cb02c20cb/1999/CVE-1999-0362.json","https://github.com/intSpLoiT/intframework/blob/eabaa799d0260aa52b735fa9769266d1ce4b64ef/modules/cve_list.txt","https://github.com/scipag/AttackToolKit/blob/78bf88564956b8f18a37659dc3d345093e95a136/plugins/Ipswitch%20WS_FTP%20Server%20prior%205.0.2%20CWD%20path%20denial%20of%20service.plugin","https://github.com/security-commits/security-patches-dataset/blob/e93fcdcc8c9b91785f962a06d66b7ee623780245/data/cve-details/year/1999.csv"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":[],"repo_exp_urls":[],"has_poc":false,"has_exp":false,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/1999/AVE-1999-0594.toml"},{"ave_id":"AVE-1999-0595","file_name":"1999/AVE-1999-0595.toml","cve_id":"CVE-1999-0363","title":"SuSE Linux 5.2 lpc 本地缓冲区溢出权限提升漏洞","description":"S.u.S.E Linux 5.2 系统中的 lpc 程序存在缓冲区溢出漏洞，本地攻击者可通过向 lpc 程序发送特制的输入数据触发缓冲区溢出，从而获取 root 权限。该漏洞影响 S.u.S.E Linux 5.2 版本，攻击者需要拥有本地系统访问权限才能利用，CVSS 评分 7.2，危害等级高。厂商已发布安全更新修复此漏洞。","severity":"HIGH","score":7.2,"aliases":["CVE-1999-0363"],"sources":["cve","exploitdb"],"published":"1999-02-02T00:00:00Z","updated":"2026-06-16T00:00:00Z","remediation":"升级 SuSE Linux 至 5.3 及以上版本，该漏洞已在后续版本中修复。临时缓解措施：移除 lpc 程序的 setuid 权限位（chmod u-s /usr/sbin/lpc），限制本地普通用户执行该程序。如非必要，可停止并禁用 lpd 打印服务。","status":"completed","collected_at":"2026-07-16T00:00:00Z","references":["http://www.securityfocus.com/bid/328","https://www.exploit-db.com/exploits/19259"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":["https://raw.githubusercontent.com/adysec/AVE/main/pocs/1999/POC-AVE-1999-0595.toml"],"repo_exp_urls":["https://raw.githubusercontent.com/adysec/AVE/main/exploits/1999/EXP-AVE-1999-0595.toml"],"has_poc":true,"has_exp":true,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/1999/AVE-1999-0595.toml"},{"ave_id":"AVE-1999-0714","file_name":"1999/AVE-1999-0714.toml","cve_id":"CVE-1999-0459","title":"Linux Alpha MILO 本地拒绝服务漏洞","description":"Alpha Linux 系统中存在本地拒绝服务漏洞。本地攻击者可通过 MILO 引导加载程序强制系统重新启动，导致系统服务不可用。该漏洞影响运行 Alpha Linux 的 DEC Alpha 架构系统，攻击者需具备本地访问权限，无需高权限即可利用，CVSS 评分 4.6，危害等级中危。","severity":"MEDIUM","score":4.6,"aliases":["CVE-1999-0459"],"sources":["avd"],"published":"1999-02-01T05:00:00Z","updated":"2026-06-16T21:48:26Z","remediation":"建议升级 MILO 引导程序至最新版本，并限制系统本地用户的登录访问权限。在生产环境中应禁用不必要的本地用户账号，并通过 `/etc/security/access.conf` 或 PAM 模块限制控制台访问。对于 Alpha 架构系统，可考虑迁移至更新的 Linux 内核版本以规避该引导层问题。","status":"completed","collected_at":"2026-07-14T00:00:00Z","references":["https://exchange.xforce.ibmcloud.com/vulnerabilities/CVE-1999-0459"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":[],"repo_exp_urls":[],"has_poc":false,"has_exp":false,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/1999/AVE-1999-0714.toml"},{"ave_id":"AVE-1999-0613","file_name":"1999/AVE-1999-0613.toml","cve_id":"CVE-1999-0373","title":"Debian GNU/Linux Super 缓冲区溢出本地权限提升漏洞","description":"Debian GNU/Linux 及多个类 Unix 系统中自带的 Super 工具存在栈缓冲区溢出漏洞。该程序以 setuid root 权限运行，用于授权普通用户以 root 身份执行特定命令。攻击者通过向 Super 提交超长的命令行参数触发缓冲区溢出，可覆盖返回地址并劫持控制流，从而以 root 权限执行任意代码。由于攻击者需要本地系统访问权限，该漏洞影响范围局限于多用户环境，但一旦利用成功即实现完全提权。CVSS 评分 7.2，危害等级高。","severity":"HIGH","score":7.2,"aliases":["CVE-1999-0373"],"sources":["avd"],"published":"1999-02-01T05:00:00Z","updated":"2026-06-16T21:48:15Z","remediation":"升级 Debian GNU/Linux 上的 super 软件包至版本 3.12 及以上，该版本已修复缓冲区溢出问题。如无法升级，立即执行 `chmod u-s /usr/bin/super` 移除 suid 权限位以阻止提权利用，并考虑使用 sudo 替代 super 进行权限委派。","status":"completed","collected_at":"2026-07-13T00:00:00Z","references":["https://exchange.xforce.ibmcloud.com/vulnerabilities/CVE-1999-0373"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":[],"repo_exp_urls":[],"has_poc":false,"has_exp":false,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/1999/AVE-1999-0613.toml"},{"ave_id":"AVE-1999-0590","file_name":"1999/AVE-1999-0590.toml","cve_id":"CVE-1999-0358","title":"Digital Unix 4.0 MH inc 缓冲区溢出漏洞","description":"Digital Unix 4.0 操作系统的 mh（消息处理）套件中的 inc 程序存在缓冲区溢出漏洞。本地或远程攻击者可通过向目标系统发送特制的邮件消息触发该漏洞，导致缓冲区溢出，进而造成程序崩溃或执行任意代码，获取系统控制权限。该漏洞影响 Digital Unix 4.0 版本，CVSS 评分 7.2，危害等级高。","severity":"HIGH","score":7.2,"aliases":["CVE-1999-0358"],"sources":["avd"],"published":"1999-02-01T05:00:00Z","updated":"2026-06-16T21:48:13Z","remediation":"立即从 Compaq（现 HP）获取并安装 Digital Unix 4.0 的安全补丁（补丁编号请查阅 CIAC 公告 J-027），或升级至 Tru64 UNIX 5.0 及以上版本。若无法立即打补丁，可移除 inc 程序的 setuid 位（chmod u-s /usr/bin/inc）作为临时缓解措施，限制本地普通用户以 root 权限执行 inc 命令。建议改用 mailx 或 Mutt 替代 mh 套件处理本地邮件，降低攻击面。","status":"completed","collected_at":"2026-07-13T00:00:00Z","references":["http://www.ciac.org/ciac/bulletins/j-027.shtml","http://www.securityfocus.com/archive/1/12121"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":[],"repo_exp_urls":[],"has_poc":false,"has_exp":false,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/1999/AVE-1999-0590.toml"}]
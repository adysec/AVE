3643.json","https://github.com/LiuCan01/cve-list-pro/blob/78b55511cee3604c22d518e32822f0435d0cacc0/cve-list/CVE-2016/CVE-2016-3643","https://github.com/cisagov/vulnrichment/blob/9553fde5ed5ff45a613d88bc99087dbba2111555/2016/3xxx/CVE-2016-3643.json","https://github.com/a-dhaou-tekup/VRA/blob/3e4f21c329250c5eca327489d3fd5be9b398ce7b/data/rag_corpus/cisa_kev_notes/CVE-2016-3643.txt","https://github.com/Ostorlab/KEV/blob/8feadeb8b7ff54359eab87941769781629146b23/README.md","https://github.com/ryanmrestivo/red-team/blob/1e53b7aa77717a22c9bd54facc64155a9a4c49fc/_Resources/Exploit%20DB%202021-12-11/exploits/linux/local/39967.txt","https://github.com/KaweGG/vulnerability_tracker/blob/01de5763b71f6c005791d4aa8121132990782604/cves/CVE-2016-3643.md","https://github.com/openctibr/threatFeeds/blob/72b7b78ddbd9c27f7619dafaf503c18fe4b1ee7e/ExploitableVulnerabilitiesFeed.txt","https://github.com/nomi-sec/NVD-Database/blob/23dc120c34402aaa65883c51c1d03b3cb02c20cb/2016/CVE-2016-3643.json"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":[],"repo_exp_urls":[],"has_poc":false,"has_exp":false,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/2016/AVE-2016-0010.toml"},{"ave_id":"AVE-2016-0409","file_name":"2016/AVE-2016-0409.toml","cve_id":"CVE-2016-4171","title":"Adobe Flash Player 任意代码执行漏洞","description":"Adobe Flash Player 21.0.0.242及之前版本中存在一个未指定的安全漏洞，远程攻击者可通过诱导用户访问恶意网页或打开特制的Flash文件触发该漏洞，无需身份认证即可在目标系统上执行任意代码，实现完全控制。该漏洞已在2016年6月被野外利用，影响Windows、macOS、Linux等多个平台。Adobe已于2016年6月16日发布安全更新修复此漏洞，建议用户立即升级至最新版本。","severity":"CRITICAL","score":9.8,"aliases":["CVE-2016-4171"],"sources":["kev"],"published":"2016-06-16T14:59:51Z","updated":"2026-06-17T00:47:02Z","remediation":"立即升级 Adobe Flash Player 至 21.0.0.260 及以上版本（APSB16-18）。由于 Adobe Flash Player 已于 2020 年底停止支持并终止分发，建议彻底卸载 Flash Player，改用 HTML5 标准替代方案。如因业务兼容性暂时无法卸载，可在浏览器中启用点击播放（Click-to-Play）策略，并限制仅允许受信任站点加载 Flash 内容。","status":"completed","collected_at":"2026-07-27T00:00:00Z","references":["http://lists.opensuse.org/opensuse-security-announce/2016-06/msg00031.html","http://lists.opensuse.org/opensuse-security-announce/2016-06/msg00035.html","http://lists.opensuse.org/opensuse-security-announce/2016-06/msg00038.html","http://www.securityfocus.com/bid/91184","http://www.securitytracker.com/id/1036094","https://access.redhat.com/errata/RHSA-2016:1238","https://helpx.adobe.com/security/products/flash-player/apsa16-03.html","https://helpx.adobe.com/security/products/flash-player/apsb16-18.html","https://security.gentoo.org/glsa/201606-08","https://www.kb.cert.org/vuls/id/748992","https://github.com/cisagov/vulnrichment/issues/196","https://www.cisa.gov/known-exploited-vulnerabilities-catalog?field_cve=CVE-2016-4171","https://github.com/trickest/cve/blob/e69d88e0152845fc4d4b49970ca6e503f56b2f93/2016/CVE-2016-4171.md","https://github.com/CVEProject/cvelistV5/blob/15ba52d0829fe2220e9f89276b2743c7eef0ab2a/cves/2016/4xxx/CVE-2016-4171.json","https://github.com/eyalmazuz/ThreatIntelligenceCorpus/blob/c47f9d2b7ba92e0cbba71c67b938a49e055c5cdc/Corpus/securityaffairs_cve-2016-4171-flash-0-day.html.txt","https://github.com/LiuCan01/cve-list-pro/blob/78b55511cee3604c22d518e32822f0435d0cacc0/cve-list/CVE-2016/CVE-2016-4171","https://github.com/canonical/ubuntu-security-notices/blob/1994996b0b1043aeb0b2d4db6d06b7a742460e16/osv/cve/2016/UBUNTU-CVE-2016-4171.json","https://github.com/cisagov/vulnrichment/blob/9553fde5ed5ff45a613d88bc99087dbba2111555/2016/4xxx/CVE-2016-4171.json","https://github.com/fankh/vulnerability-poc/blob/04aa22fbb624898c1d0928bc3b34fb05529275cb/2016/CVE-2016-4171/README.md","https://github.com/WellKnitTech/ThreatActor.info/blob/7036087c2a249dcc213e8af0f4ba71748abc43bb/_malware/cve-2016-4171-and-cve-2018-817.md","https://github.com/nottrobin/ubuntu-cve-tracker/blob/36e411296b5707284049ec2e0db8d2622feca498/retired/CVE-2016-4171","https://github.com/lucacapacci/cisa_kev/blob/63008d9134e74f63e93e48616bac78e5f7abdf5b/data_single/2016/CVE-2016-4171.csv"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":["https://raw.githubusercontent.com/adysec/AVE/main/pocs/2016/POC-AVE-2016-0409.toml"],"repo_exp_urls":[],"has_poc":true,"has_exp":false,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/2016/AVE-2016-0409.toml"},{"ave_id":"AVE-2016-0208","file_name":"2016/AVE-2016-0208.toml","cve_id":"CVE-2016-3235","title":"Microsoft Visio OLE DLL 侧加载远程代码执行漏洞","description":"Microsoft Visio 在加载库文件时存在 OLE DLL 侧加载漏洞，由于程序未正确限制 DLL 搜索路径，本地攻击者可通过诱使用户打开特制的 Office 文档或应用程序，将恶意 DLL 放置在特定目录中，从而利用当前进程权限加载恶意代码，实现权限提升。该漏洞影响 Visio 2007 SP3、Visio 2010 SP2、Visio 2013 SP1、Visio 2016 及 Visio Viewer 等多个版本，CVSS 评分 7.8，危害等级高。攻击者需具备本地访问权限并诱导用户交互，成功利用后可获取与当前用户相同的系统权限。Microsoft 已在 MS16-070 安全公告中发布补丁修复此漏洞。","severity":"HIGH","score":7.8,"aliases":["CVE-2016-3235"],"sources":["kev"],"published":"2016-06-16T01:59:36Z","updated":"2026-06-17T00:45:20Z","remediation":"立即安装 Microsoft 2016 年 6 月安全更新 MS16-070 (KB3163610)，通过 Windows Update 自动更新或从 Microsoft 下载中心手动安装对应版本的 Visio 更新：Visio 2007 SP3 安装 KB3114740，Visio 2010 SP2 安装 KB3114872，Visio 2013 SP1 安装 KB3115020，Visio 2016 安装 KB3115041，Visio Viewer 2007 SP3 安装 KB2596915，Visio Viewer 2010 安装 KB2999465。该漏洞无官方缓解措施，必须安装补丁修复。","status":"completed","collected_at":"2026-07-27T00:00:00Z","references":["http://packetstormsecurity.com/files/137490/Microsoft-Visio-DLL-Hijacking.html","http://seclists.org/fulldisclosure/2016/Jun/32","http://www.securityfocus.com/archive/1/538685/100/0/threaded","http://www.securitytracker.com/id/1036093","https://docs.microsoft.com/en-us/security-updates/securitybulletins/2016/ms16-070","https://www.securify.nl/advisory/SFY20150804/microsoft_visio_multiple_dll_side_loading_vulnerabilities.html","https://www.cisa.gov/known-exploited-vulnerabilities-catalog?field_cve=CVE-2016-3235","https://www.exploit-db.com/exploits/41706","https://github.com/trickest/cve/blob/e69d88e0152845fc4d4b49970ca6e503f56b2f93/2016/CVE-2016-3235.md","https://github.com/cisagov/vulnrichment/blob/d2b9f82473296f370428cbc110ec5b988e3fd692/2016/3xxx/CVE-2016-3235.json","https://github.com/LiuCan01/cve-list-pro/blob/78b55511cee3604c22d518e32822f0435d0cacc0/cve-list/CVE-2016/CVE-2016-3235","https://github.com/a-dhaou-tekup/VRA/blob/3e4f21c329250c5eca327489d3fd5be9b398ce7b/data/rag_corpus/cisa_kev_notes/CVE-2016-3235.txt","https://github.com/Patrowl/PatrowlHearsData/blob/050b62cac636d83be07e6d4c77e70114e1ca7c93/CVE/data/2016/CVE-2016-3235.json","https://github.com/Ostorlab/KEV/blob/8feadeb8b7ff54359eab87941769781629146b23/README.md","https://github.com/vulncheck-oss/0day.today.archive/blob/3664abdd71985a44aff3260896a8f36e2f4a9682/local-exploits/27391.txt","https://github.com/lucacapacci/cisa_kev/blob/63008d9134e74f63e93e48616bac78e5f7abdf5b/data_single/2016/CVE-2016-3235.csv","https://github.com/mabitoski/cve_submodules/blob/44ad7e2705b3aef1b2ffaf64bd47596c10a6c2e4/2016/CVE-2016-3235.md","https://github.com/Chudry/Xerror/blob/07ec57cabcd27cdb47c89af452bdf4ed07207347/xerror/parsing/msf_module_result/msf_module_cve.txt"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":[],"repo_exp_urls":[],"has_poc":false,"has_exp":false,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/2016/AVE-2016-0208.toml"},{"ave_id":"AVE-2016-0506","file_name":"2016/AVE-2016-0506.toml","cve_id":"CVE-2016-4523","title":"Trihedral VTScada WAP接口越界读取拒绝服务漏洞","description":"Trihedral VTScada（原 VTS）的 WAP 接口存在越界读取漏洞，远程攻击者无需认证即可通过发送特制请求触发该漏洞，导致应用程序崩溃，造成拒绝服务。该漏洞影响 VTScada 8.x 至 11.2.01 版本，CVSS 评分 7.5，危害等级高。厂商已在 11.2.02 版本中修复此漏洞。","severity":"HIGH","score":7.5,"aliases":["CVE-2016-4523"],"sources":["kev"],"published":"2016-06-09T10:59:04Z","updated":"2026-06-17T00:47:42Z","remediation":"立即将 Trihedral VTScada 升级至 11.2.02 或更高版本。如无法立即升级，可在网络边界防火墙配置访问控制规则，限制仅信任 IP 段可访问 WAP 接口（默认端口 80/443），并禁用不必要的公网暴露面以降低被攻击风险。","status":"completed","collected_at":"2026-07-27T00:00:00Z","references":["http://www.securityfocus.com/bid/91077","http://www.zerodayinitiative.com/advisories/ZDI-16-405","https://ics-cert.us-cert.gov/advisories/ICSA-16-159-01","https://www.cisa.gov/known-exploited-vulnerabilities-catalog?field_cve=CVE-2016-4523","https://github.com/trickest/cve/blob/e69d88e0152845fc4d4b49970ca6e503f56b2f93/2016/CVE-2016-4523.md","https://github.com/CVEProject/cvelistV5/blob/15ba52d0829fe2220e9f89276b2743c7eef0ab2a/cves/2016/4xxx/CVE-2016-4523.json","https://github.com/LiuCan01/cve-list-pro/blob/78b55511cee3604c22d518e32822f0435d0cacc0/cve-list/CVE-2016/CVE-2016-4523","https://github.com/cisagov/vulnrichment/blob/9553fde5ed5ff45a613d88bc99087dbba2111555/2016/4xxx/CVE-2016-4523.json","https://github.com/a-dhaou-tekup/VRA/blob/3e4f21c329250c5eca327489d3fd5be9b398ce7b/data/rag_corpus/cisa_kev_notes/CVE-2016-4523.txt","https://github.com/Ostorlab/KEV/blob/8feadeb8b7ff54359eab87941769781629146b23/README.md","https://github.com/edoardottt/missing-cve-nuclei-templates/blob/b93b72c800b93d13fcc97984485ecaf9a9b5cbc1/data/year/2016.txt","https://github.com/mabitoski/cve_submodules/blob/44ad7e2705b3aef1b2ffaf64bd47596c10a6c2e4/2016/CVE-2016-4523.md","https://github.com/Patrowl/PatrowlHearsData/blob/6cdd862a65f157a01ff9fd42e651329142c691d2/CVE/data/2016/CVE-2016-4523.json","https://github.com/openctibr/threatFeeds/blob/72b7b78ddbd9c27f7619dafaf503c18fe4b1ee7e/ExploitableVulnerabilitiesFeed.txt"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":[],"repo_exp_urls":[],"has_poc":false,"has_exp":false,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/2016/AVE-2016-0506.toml"},{"ave_id":"AVE-2016-0500","file_name":"2016/AVE-2016-0500.toml","cve_id":"CVE-2016-4437","title":"Apache Shiro 默认密钥致远程代码执行漏洞","description":"Apache Shiro 1.2.4 及之前版本存在反序列化远程代码执行漏洞。由于 Shiro 的 \"remember me\" 功能在未配置自定义密钥时使用硬编码的默认密钥对 Cookie 进行加密和反序列化处理，远程攻击者无需身份认证即可通过构造特制的 rememberMe Cookie 参数触发 Java 反序列化，从而在目标服务器上执行任意代码。攻击者只需知道默认密钥（已知公开），即可利用 ysoserial 等工具生成恶意序列化 payload 并发送至目标系统。该漏洞影响所有使用 Apache Shiro <= 1.2.4 且未修改默认密钥的应用系统，CVSS 评分 9.8，危害等级严重。官方已在 1.2.5 版本中修复此问题，要求用户必须配置自定义密钥。","severity":"CRITICAL","score":9.8,"aliases":["CVE-2016-4437"],"sources":["nuclei"],"published":"2016-06-07T14:06:13Z","updated":"2026-06-17T00:47:33Z","remediation":"立即升级 Apache Shiro 至 1.2.5 或更高版本。如无法升级，在 shiro.ini 或 Spring 配置中为 rememberMe 功能设置自定义 cipherKey（通过 securityManager.setRememberMeManager().setCipherKey() 配置），避免使用默认密钥。同时可在 WAF 层对 Cookie 中 rememberMe 字段的 base64 解码内容进行反序列化攻击特征检测与拦截。","status":"completed","collected_at":"2026-07-27T00:00:00Z","references":["http://packetstormsecurity.com/files/137310/Apache-Shiro-1.2.4-Information-Disclosure.html","http://packetstormsecurity.com/files/157497/Apache-Shiro-1.2.4-Remote-Code-Execution.html","http://rhn.redhat.com/errata/RHSA-2016-2035.html","http://rhn.redhat.com/errata/RHSA-2016-2036.html","http://www.securityfocus.com/archive/1/538570/100/0/threaded","http://www.securityfocus.com/bid/91024","https://lists.apache.org/thread.html/ef3a800c7d727a00e04b78e2f06c5cd8960f09ca28c9b69d94c3c4c4%40%3Cannouncements.aurora.apache.org%3E","https://www.cisa.gov/known-exploited-vulnerabilities-catalog?field_cve=CVE-2016-4437","https://www.exploit-db.com/exploits/48410","https://github.com/projectdiscovery/nuclei-templates/blob/main/http/cves/2016/CVE-2016-4437.yaml","https://github.com/trickest/cve/blob/e69d88e0152845fc4d4b49970ca6e503f56b2f93/2016/CVE-2016-4437.md","https://github.com/fofapro/vulfocus/blob/4b7a2eaacce4ed770f289e6e72f7240da1e16c74/writeup/CVE-2016-4437/CVE-2016-4437.md","https://github.com/gobysec/GobyVuls/blob/a5de8e3be10d51a94e0977ecd8086c176251229f/Shiro/CVE-2016-4437/README.md","https://github.com/zhzyker/exphub/blob/946405b3447dbaf2a5eb49e2f56ec33fe1165e49/shiro/readme.md","https://github.com/LiuCan01/cve-list-pro/blob/78b55511cee3604c22d518e32822f0435d0cacc0/cve-list/CVE-2016/CVE-2016-4437","https://github.com/LoRexxar/Kunlun-M/blob/3aedae5a306aaff7a0ace23431857024777d8352/rules/java/CVI_6050.py","https://github.com/hack007x/veil_poc/blob/5cfe1da6e975ba816d728597885a5c5e79bda8bd/cves/2016/CVE-2016-4437.poc","https://github.com/blackhook/nessus-plugins/blob/64177d96abbb07c58cf7e131046b067ebc61fcb5/A/apache_shiro_cve-2016-4437_local.nasl","https://github.com/Apibug/SecPost/blob/2f7df9980cab025c48cce9b14b2d48eeb37328ef/Apache%20Shiro%20%E5%B0%8F%E4%BA%8E1.2.4%E5%8F%8D%E5%BA%8F%E5%88%97%E5%8C%96%E6%BC%8F%E6%B4%9E%20CVE-2016-4437.md","https://github.com/LyleMi/Learn-Web-Hacking/blob/7a42e3252fdcae87663434b1fd54ec89d671bfbe/locale/en/LC_MESSAGES/language/java/framework.po","https://github.com/zhzyker/vulmap","https://github.com/bkfish/Awesome_shiro","https://github.com/XuCcc/VulEnv","https://github.com/4nth0ny1130/shisoserial","https://github.com/pizza-power/CVE-2016-4437"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":["https://raw.githubusercontent.com/adysec/AVE/main/pocs/2016/POC-AVE-2016-0500.toml"],"repo_exp_urls":[],"has_poc":true,"has_exp":false,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/2016/AVE-2016-0500.toml"}]
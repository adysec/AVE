[{"ave_id":"AVE-2012-0038","file_name":"2012/AVE-2012-0038.toml","cve_id":"CVE-2012-0449","title":"Mozilla Firefox/SeaMonkey/Thunderbird XSLT样式表处理内存破坏远程代码执行漏洞","description":"Mozilla Firefox 3.6.26之前版本及4.x至9.0版本、Thunderbird 3.1.18之前版本及5.0至9.0版本、SeaMonkey 2.7之前版本中存在内存破坏漏洞。远程攻击者可通过在文档中嵌入特制的恶意XSLT样式表，触发内存破坏，导致目标应用程序崩溃或拒绝服务。由于XSLT处理器在处理畸形样式表时存在内存管理缺陷，攻击者无需身份认证即可利用此漏洞，CVSS评分9.3，危害严重。","severity":"CRITICAL","score":9.3,"aliases":["CVE-2012-0449"],"sources":["tenable"],"published":"2012-02-01T16:55:01Z","updated":"2026-06-16T23:37:17Z","remediation":"升级 Firefox 至 3.6.26 或 10.0 及以上版本，升级 Thunderbird 至 3.1.18 或 10.0 及以上版本，升级 SeaMonkey 至 2.7 及以上版本。无法立即升级时，可在浏览器中禁用 XSLT 或通过内容安全策略（CSP）限制样式表加载作为临时缓解措施。","status":"completed","collected_at":"2026-08-03T00:00:00Z","references":["http://lists.opensuse.org/opensuse-security-announce/2012-02/msg00003.html","http://lists.opensuse.org/opensuse-security-announce/2012-02/msg00007.html","http://lists.opensuse.org/opensuse-security-announce/2012-02/msg00011.html","http://www.debian.org/security/2012/dsa-2400","http://www.debian.org/security/2012/dsa-2402","http://www.debian.org/security/2012/dsa-2406","http://www.mandriva.com/security/advisories?name=MDVSA-2012:013","http://www.mozilla.org/security/announce/2012/mfsa2012-08.html","http://www.securityfocus.com/bid/51754","https://bugzilla.mozilla.org/show_bug.cgi?id=701806","https://bugzilla.mozilla.org/show_bug.cgi?id=702466","https://exchange.xforce.ibmcloud.com/vulnerabilities/72868","https://oval.cisecurity.org/repository/search/definition/oval%3Aorg.mitre.oval%3Adef%3A14618","https://github.com/trickest/cve/blob/7d40e7d94b41c478b4d1a654c7bc3bcf34fa7beb/2012/CVE-2012-0449.md","https://github.com/CVEProject/cvelistV5/blob/2e429c9a0087eb0ee678d77c344076eb39564d19/cves/2012/0xxx/CVE-2012-0449.json","https://github.com/CVEDB/Poc-Git/blob/0275aeb329b0747c9a1d46160c921eae06095557/2012/CVE-2012-0449.md","https://github.com/kaismax/CVE-Poc/blob/6d8c93dabf674cea102713781cc534d577412357/2012/CVE-20
--7ead6960-a6f2-48ec-aa9f-f4b8f2349d50.json","https://github.com/andreafioraldi/ToolsForCyberChallenge/blob/197d3dfd204cf1b9d1af1451455c8831c3ff9948/generated/files_3.list.dict","https://github.com/nomi-sec/NVD-Database/blob/23dc120c34402aaa65883c51c1d03b3cb02c20cb/2002/CVE-2002-0023.json"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":["https://raw.githubusercontent.com/adysec/AVE/main/pocs/2002/POC-AVE-2002-0145.toml"],"repo_exp_urls":["https://raw.githubusercontent.com/adysec/AVE/main/exploits/2002/EXP-AVE-2002-0145.toml"],"has_poc":true,"has_exp":true,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/2002/AVE-2002-0145.toml"},{"ave_id":"AVE-2002-0139","file_name":"2002/AVE-2002-0139.toml","cve_id":"CVE-2002-0069","title":"Squid SNMP 内存泄漏拒绝服务漏洞","description":"Squid 代理服务器 2.4 STABLE3 及更早版本中的 SNMP 组件存在内存泄漏漏洞。远程攻击者可通过向目标 Squid 服务器的 SNMP 服务发送特制的 SNMP 请求包，触发该内存泄漏缺陷，导致系统内存资源被持续消耗直至耗尽，最终造成拒绝服务。该漏洞攻击复杂度较高（需认证或特定条件），CVSS 评分 2.6，危害等级低。厂商已发布更新版本修复此问题。","severity":"LOW","score":2.6,"aliases":["CVE-2002-0069"],"sources":["redhat"],"published":"2002-03-08T05:00:00Z","updated":"2026-06-16T21:56:42Z","remediation":"升级 Squid 至 2.4.STABLE4 或更高版本（官方已发布补丁 squid-2.4.STABLE3-SNMP_memory_leaks.patch）。如无法升级，在 squid.conf 中添加 snmp_port 0 禁用 SNMP 服务，或设置 snmp_incoming_address 127.0.0.1 限制 SNMP 仅监听本地回环地址。各发行版用户请安装对应安全更新：Red Hat 安装 RHSA-2002:029、FreeBSD 安装 SA-02:12、Mandrake 安装 MDKSA-2002:016。","status":"completed","collected_at":"2026-07-27T00:00:00Z","references":["http://archives.neohapsis.com/archives/linux/caldera/2002-q1/0014.html","http://distro.conectiva.com.br/atualizacoes/?id=a&anuncio=000464","http://marc.info/?l=bugtraq&m=101431040422095&w=2","http://marc.info/?l=bugtraq&m=101443252627021&w=2","http://www.iss.net/security_center/static/8260.php","http://www.linux-mandrake.com/en/security/2002/MDKSA-2002-016.php","http://www.redhat.com/support/errata/RHSA-2002-029.html","http://www.securityfocus.com/bid/4146","http://www.squid-cache.org/Versions/v2/2.4/bugs/","https://github.c
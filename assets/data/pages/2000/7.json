00:00:00Z","references":["http://www.osvdb.org/1600","http://www.securityfocus.com/bid/1782","https://exchange.xforce.ibmcloud.com/vulnerabilities/5371","https://github.com/CVEProject/cvelistV5/blob/7a274ec07043f54c07d0a3b5c7fc89ba5793f023/cves/2000/0xxx/CVE-2000-0810.json","https://github.com/LiuCan01/cve-list-pro/blob/78b55511cee3604c22d518e32822f0435d0cacc0/cve-list/CVE-2000/CVE-2000-0810","https://github.com/yarencheng/cve-devops-playground/blob/cbe73d6bdcced13ea57f08566d6bbf5345864f7e/content/CVE-2000-0810.md","https://github.com/Patrowl/PatrowlHearsData/blob/1decc7ade63192f9f527bfb87145d1636c01cc59/CVE/data/2000/CVE-2000-0810.json","https://github.com/github/advisory-database/blob/daf3a08cbe0139b666db9d48681b6efcebbecad5/advisories/unreviewed/2022/04/GHSA-8j53-mpr3-63rc/GHSA-8j53-mpr3-63rc.json","https://github.com/intSpLoiT/intframework/blob/eabaa799d0260aa52b735fa9769266d1ce4b64ef/modules/cve_list.txt","https://github.com/KTZgraph/sarenka/blob/f1fb931ab722d6c096d581ed6e3c5966d799fbaa/sarenka/feeds/cve_details/cve_all_details_152900_153000.json","https://github.com/oasis-open/cti-stix-common-objects/blob/55ba7598cbd5a52577b6887871505d931d85cb61/objects/vulnerability/vulnerability--04e24c51-ce3c-4bea-9e4b-c4db8610a0f0.json","https://github.com/olbat/nvdcve/blob/5b92f5917a4a825187ccaac594f43456a77ea8f3/nvdcve/CVE-2000-0810.json","https://github.com/nomi-sec/CVE-Easy-List/blob/8b2b9a8673bea39f5c895cdb2f43d026330c1de0/2000.tsv"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":["https://raw.githubusercontent.com/adysec/AVE/main/pocs/2000/POC-AVE-2000-0958.toml"],"repo_exp_urls":[],"has_poc":true,"has_exp":false,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/2000/AVE-2000-0958.toml"},{"ave_id":"AVE-2000-0918","file_name":"2000/AVE-2000-0918.toml","cve_id":"CVE-2000-0974","title":"GnuPG gpg 多文档签名验证绕过漏洞","description":"GnuPG (gpg) 1.0.3 版本在处理包含多个文档的签名文件时存在签名验证缺陷，未能正确校验除第一个文档外所有文档的签名信息。远程攻击者可通过构造特制的多文档签名文件，在无需破解合法签名的情况下篡改后续文档内容而不被检测。该漏洞影响使用 GnuPG 1.0.3 进行多文档签名验证的系统，CVSS 评分 7.5，危害等级高，可能导致数据完整性被破坏。","severity":"HIGH","score":7.5,"aliases":["CVE-2000-0974"],"sources":["redhat"],"published":"2000-12-19T05:00:00.000","updated":"2026-06-16T21:52:53.400","remediation":"升级 GnuPG 至 1.0.4 或更高版本，该版本已修复多文档签名校验不完整的问题。如无法升级，应避免直接信任多文档签名文件中的非首文档内容，建议对每个文档单独验证签名后再使用。","status":"completed","collected_at":"2026-07-22T00:00:00Z","references":["http://archives.neohapsis.com/archives/bugtraq/2000-10/0201.html","http://archives.neohapsis.com/archives/bugtraq/2000-10/0361.html","http://distro.conectiva.com.br/atualizacoes/?id=a&anuncio=000334","http://www.debian.org/security/2000/20001111","http://www.osvdb.org/1608","http://www.redhat.com/support/errata/RHSA-2000-089.html","http://www.securityfocus.com/bid/1797","https://exchange.xforce.ibmcloud.com/vulnerabilities/5386","https://github.com/CVEProject/cvelistV5/blob/97700d7e657426c8e1ee6cf44a0a2b88c60738c3/cves/2000/0xxx/CVE-2000-0974.json","https://github.com/LiuCan01/cve-list-pro/blob/78b55511cee3604c22d518e32822f0435d0cacc0/cve-list/CVE-2000/CVE-2000-0974","https://github.com/yarencheng/cve-devops-playground/blob/cbe73d6bdcced13ea57f08566d6bbf5345864f7e/content/CVE-2000-0974.md","https://github.com/Patrowl/PatrowlHearsData/blob/800f04b3cfadd1b9ab0343f5b9acd785dbc1e953/CVE/data/2000/CVE-2000-0974.json","https://github.com/github/advisory-database/blob/d8c03b84658bbca948e09e4af723cb11141fb41e/advisories/unreviewed/2022/05/GHSA-grh4-x8rv-hcvv/GHSA-grh4-x8rv-hcvv.json","https://github.com/intSpLoiT/intframework/blob/eabaa799d0260aa52b735fa9769266d1ce4b64ef/modules/cve_list.txt","https://github.com/KTZgraph/sarenka/blob/f1fb931ab722d6c096d581ed6e3c5966d799fbaa/sarenka/feeds/cve_details/cve_all_details_152900_153000.json","https://github.com/debiancn/debian.org/blob/6abc98daa6356b20e410013a6920b3764af682d4/english/security/2000/20001111.data","https://github.com/oasis-open/cti-stix-common-objects/blob/55ba7598cbd5a52577b6887871505d931d85cb61/objects/vulnerability/vulnerability--52a2166f-9076-4985-
[{"ave_id":"AVE-2002-0005","file_name":"2002/AVE-2002-0005.toml","cve_id":"CVE-2002-0392","title":"Apache HTTP Server Chunked 编码远程代码执行漏洞","description":"Apache 1.3.x 至 1.3.24 及 Apache 2.0.x 至 2.0.36 版本中存在分块编码（Chunked Encoding）整数处理漏洞，远程攻击者无需认证即可向目标服务器发送特制的分块编码 HTTP 请求，触发 Apache 在处理请求体大小时发生整数溢出，进而导致拒绝服务或潜在远程代码执行。该漏洞在 Windows x86 平台影响严重，CVSS 评分 7.5，高危级别。官方尚未提供自动修复补丁，建议升级至不受影响版本。","severity":"HIGH","score":7.5,"aliases":["CVE-2002-0392"],"sources":["osv"],"published":"2002-07-03T04:00:00.000","updated":"2026-06-16T21:57:21.037","remediation":"升级 Apache 至 1.3.26+ 或 2.0.37+ 版本，该漏洞已在后续版本中修复。对于无法升级的旧系统，可在 httpd.conf 中禁用 mod_chunked 或使用 mod_security 规则过滤分块编码请求中的恶意载荷作为临时缓解措施。","status":"completed","collected_at":"2026-07-22T00:00:00Z","references":["http://archives.neohapsis.com/archives/bugtraq/2002-06/0235.html","http://archives.neohapsis.com/archives/bugtraq/2002-06/0266.html","http://distro.conectiva.com/atualizacoes/?id=a&anuncio=000498","http://frontal2.mandriva.com/security/advisories?name=MDKSA-2002:039","http://httpd.apache.org/info/security_bulletin_20020617.txt","http://online.securityfocus.com/advisories/4240","http://online.securityfocus.com/advisories/4257","http://online.securityfocus.com/archive/1/278149","http://rhn.redhat.com/errata/RHSA-2002-103.html","http://rhn.redhat.com/errata/RHSA-2002-117.html","http://rhn.redhat.com/errata/RHSA-2002-118.html","http://secunia.com/advisories/21917","http://www.cert.org/advisories/CA-2002-17.html","http://www.debian.org/security/2002/dsa-131","http://www.debian.org/security/2002/dsa-132","http://www.debian.org/security/2002/dsa-133","http://www.frsirt.com/english/advisories/2006/3598","http://www.iss.net/security_center/static/9249.php","http://www.kb.cert.org/vuls/id/944335","http://www.linuxsecurity.com/advisories/other_advisory-2137.html","http://www.novell.com/linux/security/advisories/2002_22_apache.html","http://www.osvdb.org/838","http://www.redhat.com/support/errata/RHSA-2002-126.html","http://www.redhat.com/sup
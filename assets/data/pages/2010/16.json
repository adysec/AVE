om/english/advisories/2010/1007","https://exchange.xforce.ibmcloud.com/vulnerabilities/58176"],"poc_urls":["http://localhost/index.php?option=com_noticeboard&controller=../../../../../../../../../etc/passwd%00"],"exp_urls":[],"repo_poc_urls":[],"repo_exp_urls":[],"has_poc":false,"has_exp":false,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/2010/AVE-2010-0059.toml"},{"ave_id":"AVE-2010-0057","file_name":"2010/AVE-2010-0057.toml","cve_id":"CVE-2010-1653","title":"Joomla! 组件 Graphics 1.0.6 本地文件包含漏洞","description":"Joomla! Graphics 组件（com_graphics）1.0.6 和 1.5.0 版本的 graphics.php 文件存在目录遍历漏洞，攻击者可通过向 index.php 的 controller 参数传递 '..' 等目录遍历序列，包含并执行任意本地文件。该漏洞源于对用户输入的 controller 参数缺乏路径规范化校验，攻击者无需身份认证即可远程利用，通过目录遍历序列突破目录限制读取或执行服务器本地敏感文件，可能导致敏感信息泄露或远程代码执行。该漏洞影响 Joomla! 使用受影响 Graphics 组件版本的站点。","severity":"HIGH","score":7.5,"aliases":["CVE-2010-1653"],"sources":["nuclei"],"published":"2010-05-03T13:51:53Z","updated":"2026-06-16T23:18:47Z","remediation":"立即将 Joomla! 的 Graphics (com_graphics) 组件升级至 1.5.1 或更高版本以获取补丁修复。若官方已停止维护，请通过后台「扩展管理」中直接卸载或禁用该组件。同时可在 Web 服务器（如 Apache/Nginx）层添加规则过滤请求路径中的 '../'、编码穿越字符，并限制 index.php 的 controller 参数仅允许白名单取值，作为临时缓解措施。","status":"completed","collected_at":"2026-07-15T00:00:00Z","references":["http://packetstormsecurity.org/1004-exploits/joomlagraphics-lfi.txt","http://secunia.com/advisories/39585","http://www.exploit-db.com/exploits/12430","http://www.securityfocus.com/bid/39743","http://www.vupen.com/english/advisories/2010/1004","https://www.exploit-db.com/exploits/12430","https://github.com/projectdiscovery/nuclei-templates/blob/main/http/cves/2010/CVE-2010-1653.yaml","https://github.com/trickest/cve/blob/a90de4f84b4783951362f491671e1e9decfc17cb/2010/CVE-2010-1653.md","https://github.com/projectdiscovery/nuclei-templates/blob/1482f62c613998b0fe0690591034b732c0bb2e0a/http/cves/2010/CVE-2010-1653.yaml","https://github.com/sepehrdaddev/zap-scripts/blob/2b63b02ca79cc7f0023cdbab72c5c6c774354b07/active/CVE-2010-1653.js","https://github.com/0xKayala/Custom-Nuclei-Templates/blob/1940dfd29577590f076c89dec5c30d809d68f210/5001-to-6000-templates/cve-2010-1653-1757.yaml","https://github.com/linuxadi/40k-nuclei-templates/blob/542be6820c801c02a33aee60f1c05ca7b0b5005f/aditya/folder3/cve-2010-1653-1755.yaml","https://github.com/adampielak/nuclei-templates/blob/ac9605f5a915670fd80cb4e1904f4435f1835b65/nuclei-v3/C/CVE-2010-1653_26.yaml","https://github.com/coreruleset/seaweed-reports/blob/3e2a1bd3dbca1b431f18ed0dabb71fa729d4d059/2022/Nov/20/lfiArtifact/lfiReport.csv","https://github.com/mscandev/mscan/blob/cb7ba038f76e6e0cf8ffa6ab00db702265d3191c/web/nuclei-templates/cves/2010/CVE-2010-1653.yaml","https://github.com/ExpLangcn/NucleiTP/blob/2b7ecb9031a6eda4f272793045f29b339d8e0cce/CVES/high/cve-2010-1653-1756.yaml","https://github.com/cckuailong/reapoc/blob/699762e4c31d0183733f64313d8fc3be6470bd37/2010/README.md"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":[],"repo_exp_urls":[],"has_poc":false,"has_exp":false,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/2010/AVE-2010-0057.toml"},{"ave_id":"AVE-2010-0058","file_name":"2010/AVE-2010-0058.toml","cve_id":"CVE-2010-1657","title":"Joomla! SmartSite组件1.0.0 - 目录穿越漏洞","description":"Joomla!中的SmartSite（com_smartsite）组件1.0.0存在目录穿越漏洞，攻击者通过在index.php的controller参数中嵌入../序列可读任意服务器文件。此漏洞影响Joomla!网站，可能导致敏感信息泄露，信息安全风险等级为中危。攻击者无需认证即可发起攻击， exploited路径简单，主要针对部署了SmartSite1.0.0版本的网站。","severity":"MEDIUM","score":5.0,"aliases":["CVE-2010-1657"],"sources":["nuclei"],"published":"2010-05-03T00:00:00Z","updated":"2010-05-27T00:00:00Z","remediation":"立即升级Joomla!核心程序至最新版本，或卸载不再使用的Smartsite组件。如果必须保留Smartsite，请确保使用受信任的来源安装，并定期更新至最新安全版本。","status":"completed","collected_at":"2026-07-15T11:59:04Z","references":["http://packetstormsecurity.org/1004-exploits/joomlasmartsite-lfi.txt","http://secunia.com/advisories/39592","http://www.exploit-db.com/exploits/12428","http://www.securityfocus.com/bid/39740","http://www.vupen.com/english/advisories/2010/1006","https://exchange.xforce.ibmcloud.com/vulnerabilities/58175"],"poc_urls":["http://www.exploit-db.com/exploits/12428"],"exp_urls":[],"repo_poc_urls":[],"repo_exp_urls":[],"has_poc":false,"has_exp":false,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/2010/AVE-2010-0058.toml"},{"ave_id":"AVE-2010-0055","file_name":"2010/AVE-2010-0055.toml","cve_id":"CVE-2010-1603","title":"Joomla! 组件 ZiMBCore 0.1 - 局部文件包含漏洞","description":"Joomla! 的 ZiMBCore（com_zimbcore）组件 0.1 版本存在目录穿越漏洞。该组件在处理 index.php 的 controller 参数时未对用户输入进行充分过滤，远程攻击者可构造包含 `..`（点点）序列的恶意请求，绕过路径限制读取服务器上的任意文件（如配置文件、敏感源码等）。由于 Joomla! 通常部署于公开 Web 服务器，任何未经过身份认证的远程用户只要能访问目标站点即可发起攻击，无需特殊权限或前置条件，攻击门槛较低。利用方式简单，仅需向 index.php 发送带有恶意 controller 参数的 HTTP 请求即可触发，除任意文件读取外还可能造成其他未明确的影响，属于高危信息泄露类漏洞。","severity":"HIGH","score":7.5,"aliases":["CVE-2010-1603"],"sources":["nuclei"],"published":"2010-04-29T17:30:00Z","updated":"2026-06-16T23:18:41Z","remediation":"建议立即卸载或禁用 Joomla! ZiMBCore 0.1 组件，或升级至 ZiMB Manager 系列最新版本。临时缓解措施：在 Web 应用防火墙层面拦截包含目录遍历序列（../）的 controller 参数请求，或在 Joomla 后台禁用 com_zimbcore 组件。","status":"completed","collected_at":"2026-07-15T00:00:00Z","references":["http://packetstormsecurity.org/1004-exploits/joomlazimbmanager-lfi.txt","http://www.exploit-db.com/exploits/12284","http://www.securityfocus.com/bid/39546","http://www.vupen.com/english/advisories/2010/0931","https://www.exploit-db.com/exploits/12284","https://github.com/projectdiscovery/nuclei-templates/blob/main/http/cves/2010/CVE-2010-1603.yaml","https://github.com/trickest/cve/blob/a90de4f84b4783951362f491671e1e9decfc17cb/2010/CVE-2010-1603.md","https://github.com/projectdiscovery/nuclei-templates/blob/1482f62c613998b0fe0690591034b732c0bb2e0a/http/cves/2010/CVE-2010-1603.yaml","https://github.com/sepehrdaddev/zap-scripts/blob/2b63b02ca79cc7f0023cdbab72c5c6c774354b07/active/CVE-2010-1603.js","https://github.com/ExpLangcn/NucleiTP/blob/2b7ecb9031a6eda4f272793045f29b339d8e0cce/CVES/high/cve-2010-1603-1748.yaml","https://github.com/cyb3r-w0lf/nuclei-template-collection/blob/7025ebe04ab60b84aee0af1ecf4f90601332e8e7/nuclei-templates/CVE-2010/cve-2010-1603.yaml","https://github.com/CVEProject/cvelistV5/blob/97a1d197a6d2b1e5c4bff302e1cddaad419096dc/cves/2010/1xxx/CVE-2010-1603.json","https://github.com/coreruleset/seaweed-reports/blob/3e2a1bd3dbca1b431f18ed0dabb71fa729d4d059/2022/Dec/04/lfiArtifact/lfiReport.csv","https://github.com/adampielak/nuclei-templates/blob/ac9605f5a915670fd80cb4e1904f4435f1835b65/nuclei-v3/C/CVE-2010-1603_7.yaml","https://github.com/emadshanab/nucleiDB/blob/a06eb8edf2853662c304e3f41f8887b65f56e399/z-11753.yaml","https://github.com/GhostTroops/scan4all/blob/fff03b51bf79c8993a46c1da766ec993e1102c47/config/51pwn/yaml/Joomla/CVE-2010-1603.yaml"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":[],"repo_exp_urls":[],"has_poc":false,"has_exp":false,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/2010/AVE-2010-0055.toml"},{"ave_id":"AVE-2010-0056","file_name":"2010/AVE-2010-0056.toml","cve_id":"CVE-2010-1607","title":"Joomla! WMI (com_wmi) 组件 目录遍历本地文件包含漏洞","description":"Joomla! 的 Webmoney Web Merchant Interface（WMI，组件名 com_wmi）1.5.0 版本 wmi.php 中存在目录遍历漏洞（CWE-22）。攻击者通过向 index.php 的 controller 参数注入包含 ../ 的路径遍历序列，可包含并执行目标服务器上的任意本地文件，进而实现远程代码执行。该漏洞无需身份认证即可被远程利用，攻击条件仅需网络可达且目标启用了存在缺陷的 WMI 组件，CVSS 2.0 基础评分 6.8（中危）。成功利用后可读取敏感配置、执行恶意代码，严重威胁服务器安全。","severity":"MEDIUM","score":6.8,"aliases":["CVE-2010-1607"],"sources":["cve"],"published":"2010-04-29T00:00:00Z","updated":"2026-07-15T00:00:00Z","remediation":"建议立即卸载或禁用以存在缺陷的 com_wmi（Webmoney Web Merchant Interface）组件，或在 wmi.php/index.php 中对 controller 参数进行严格的白名单校验，过滤 ../ 等路径遍历字符；通过 .htaccess 限制对该组件脚本的访问，并关注 Joomla! 官方安全更新以升级至修复版本。","status":"completed","collected_at":"2026-07-15T00:00:00Z","references":["http://osvdb.org/63979","http://secunia.com/advisories/39539","http://www.exploit-db.com/exploits/12316","http://www.securityfocus.com/bid/39608","https://exchange.xforce.ibmcloud.com/vulnerabilities/58032"],"poc_urls":["http://www.exploit-db.com/exploits/12316"],"exp_urls":["http://www.exploit-db.com/exploits/12316"],"repo_poc_urls":[],"repo_exp_urls":[],"has_poc":false,"has_exp":false,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/2010/AVE-2010-0056.toml"},{"ave_id":"AVE-2010-0054","file_name":"2010/AVE-2010-0054.toml","cve_id":"CVE-2010-1602","title":"Joomla! ZiMB Comment 0.8.1 目录遍历漏洞","description":"Joomla! 的 ZiMB Comment（com_zimbcomment）组件 0.8.1 版本存在目录遍历漏洞。该漏洞源于程序对 index.php 的 controller 参数未进行充分过滤，攻击者可通过在该参数中注入 '../' 序列进行路径穿越，从而读取服务器上的任意文件，可能导致敏感信息泄露。此漏洞 CVSS 评分为 7.5 危害等级为高，攻击者无需身份验证即可利用。","severity":"HIGH","score":7.5,"aliases":["CVE-2010-1602"],"sources":["cve","nuclei"],"published":"2010-04-29T00:00:00Z","updated":"2026-06-16T00:00:00Z","remediation":"升级 Joomla! ZiMB Comment 组件至 0.8.2 或更高版本以修复目录遍历漏洞。如需立即缓解，可在后台禁用 com_zimbcomment 组件，或在 WAF 层面拦截包含 '../' 的 controller 参数请求。","status":"completed","collected_at":"2026-07-15T00:00:00Z","references":["http://packetstormsecurity.org/1004-exploits/joomlazimbcomment-lfi.txt","http://www.exploit-db.com/exploits/12283","http://www.securityfocus.com/bid/39548","http://www.vupen.com/english/advisories/2010/0932","https://www.exploit-db.com/exploits/12283","https://github.com/projectdiscovery/nuclei-templates/blob/main/http/cves/2010/CVE-2010-1602.yaml","https://github.com/trickest/cve/blob/a90de4f84b4783951362f491671e1e9decfc17cb/2010/CVE-2010-1602.md","https://github.com/projectdiscovery/nuclei-templates/blob/1482f62c613998b0fe0690591034b732c0bb2e0a/http/cves/2010/CVE-2010-1602.yaml","https://github.com/sepehrdaddev/zap-scripts/blob/2b63b02ca79cc7f0023cdbab72c5c6c774354b07/active/CVE-2010-1602.js","https://github.com/0xKayala/Custom-Nuclei-Templates/blob/1940dfd29577590f076c89dec5c30d809d68f210/5001-to-6000-templates/cve-2010-1602-1742.yaml","https://github.com/ExpLangcn/NucleiTP/blob/2b7ecb9031a6eda4f272793045f29b339d8e0cce/CVES/high/cve-2010-1602-1741.yaml","https://github.com/adampielak/nuclei-templates/blob/ac9605f5a915670fd80cb4e1904f4435f1835b65/nuclei-v2/C/CVE-2010-1602_9.yaml","https://github.com/patrickmpalmer/exploit-prediction-calculator/blob/a048424e68e6b5ea7f4d32bf29dddd4eda342b01/data_gathering/data/exploited_cves.csv","https://github.com/amad3us47/amad3us47.github.io/blob/07cfc0edf465277028554b47198f6f186d3215b6/data/cve-2010-1602-1740.yaml","https://github.com/TheMirkin/CVE-List-Public-Exploits/blob/f496d51148a2b151f14fe6d0bef5b42ee27f6ccb/CVE%20List/2010/1xxx/CVE-2010-1602.json","https://www.exploit-db.com/exploits/12283"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":[],"repo_exp_urls":[],"has_poc":false,"has_exp":false,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/2010/AVE-2010-0054.toml"},{"ave_id":"AVE-2010-0053","file_name":"2010/AVE-2010-0053.toml","cve_id":"CVE-2010-1601","title":"Joomla! JA Comment 组件 目录遍历漏洞","description":"Joomla! 的 JA Comment（com_jacomment）组件存在目录遍历漏洞，其 index.php 在处理 view 参数时未对用户输入做充分校验与过滤。远程攻击者无需身份认证，只需在请求 index.php 的 view 参数中构造包含 ..（点-点）的恶意路径序列，即可越权读取目标服务器上的任意文件（如配置文件、源码、密码等敏感信息）。该漏洞影响所有安装了存在缺陷版本 JA Comment 组件的 Joomla! 站点，攻击条件仅需网络可达目标 Web 服务并发送特制 HTTP 请求即可，CVSS 评分 5.0，危害等级为中。","severity":"MEDIUM","score":5.0,"aliases":["CVE-2010-1601"],"sources":["nuclei"],"published":"2010-04-29T00:00:00Z","updated":"2026-07-15T00:00:00Z","remediation":"建议立即升级 JA Comment 组件到官方发布的最新修复版本；若暂无法升级，可在后台扩展管理中停用或卸载 com_jacomment 组件以彻底消除风险。同时应在组件控制器中对 view 参数进行白名单校验，过滤 ../ 与空字节等非法字符，并在 Web 服务器层（如 Apache 的 .htaccess）限制对敏感路径参数的访问。","status":"completed","collected_at":"2026-07-15T00:00:00Z","references":["http://packetstormsecurity.org/1004-exploits/joomlajacomment-lfi.txt","http://secunia.com/advisories/39472","http://www.exploit-db.com/exploits/12236","http://www.osvdb.org/63802","http://www.securityfocus.com/bid/39516","https://exchange.xforce.ibmcloud.com/vulnerabilities/57848","https://www.exploit-db.com/exploits/12236","https://github.com/projectdiscovery/nuclei-templates/blob/main/http/cves/2010/CVE-2010-1601.yaml","https://github.com/trickest/cve/blob/a90de4f84b4783951362f491671e1e9decfc17cb/2010/CVE-2010-1601.md","https://github.com/projectdiscovery/nuclei-templates/blob/1482f62c613998b0fe0690591034b732c0bb2e0a/http/cves/2010/CVE-2010-1601.yaml","https://github.com/sepehrdaddev/zap-scripts/blob/2b63b02ca79cc7f0023cdbab72c5c6c774354b07/active/CVE-2010-1601.js","https://github.com/0xKayala/Custom-Nuclei-Templates/blob/1940dfd29577590f076c89dec5c30d809d68f210/5001-to-6000-templates/cve-2010-1601-1737.yaml","https://github.com/1in9e/gosint/blob/bdda4461515c4398c08638676bbbfe451b73ff95/client/vuln_scan/nuclei/tools/nuclei-templates/cves/2010/CVE-2010-1601.yaml","https://github.com/linuxadi/40k-nuclei-templates/blob/542be6820c801c02a33aee60f1c05ca7b0b5005f/aditya/folder5/cve-2010-1601-1736.yaml","https://github.com/patrickmpalmer/exploit-prediction-calculator/blob/a048424e68e6b5ea7f4d32bf29dddd4eda342b01/data_gathering/data/exploited_cves.csv","https://github.com/foreztgump/cve_json/blob/b5f345eafeb97dce3fe03de3869b187e0574a5c0/2010/CVE-2010-1601.json","https://github.com/amad3us47/amad3us47.github.io/blob/07cfc0edf465277028554b47198f6f186d3215b6/data/cve-2010-1601-1735.yaml","https://github.com/rix4uni/nucleihub-templates/blob/579a0234551b9e0e322460a62dc77bd6109e4aff/nucleihub-templates/CVE-2010-1601_2.yaml"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":[],"repo_exp_urls":[],"has_poc":false,"has_exp":false,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/2010/AVE-2010-0053.toml"},{"ave_id":"AVE-2010-0300","file_name":"2010/AVE-2010-0300.toml","cve_id":"CVE-2010-1428","title":"Red Hat JBoss Enterprise Application Platform Web Console 信息泄露漏洞","description":"Red Hat JBoss 企业应用平台（JBoss EAP）4.2 至 4.2.0.CP09 之前版本及 4.3 至 4.3.0.CP08 之前版本中的 Web 控制台（web-console）存在访问控制缺陷，仅对 GET 和 POST 方法执行权限检查，未对其他 HTTP 方法（如 PUT、DELETE、OPTIONS 等）进行鉴权。远程攻击者无需认证即可通过发送特制的非 GET/POST 请求绕过访问控制，获取服务器敏感配置信息，可能导致进一步攻击。该漏洞 CVSS 评分 7.5，危害等级高。","severity":"HIGH","score":7.5,"aliases":["CVE-2010-1428"],"sources":["kev"],"published":"2010-04-28T22:30:00Z","updated":"2026-06-16T23:18:22Z","remediation":"升级 JBoss EAP 4.2 至 4.2.0.CP09 及以上版本，或 4.3 至 4.3.0.CP08 及以上版本。如无法立即升级，可在反向代理或 Web 服务器层面（如 Apache/httpd 的 LimitExcept 指令）仅允许 GET/POST 方法访问 /web-console 路径，并限制该路径的源 IP 白名单作为临时缓解措施。","status":"completed","collected_at":"2026-07-22T00:00:00Z","references":["http://marc.info/?l=bugtraq&m=132698550418872&w=2","http://secunia.com/advisories/39563","http://securitytracker.com/id?1023917","http://www.securityfocus.com/bid/39710","http://www.vupen.com/english/advisories/2010/0992","https://bugzilla.redhat.com/show_bug.cgi?id=585899","https://exchange.xforce.ibmcloud.com/vulnerabilities/58148","https://rhn.redhat.com/errata/RHSA-2010-0376.html","https://rhn.redhat.com/errata/RHSA-2010-0377.html","https://rhn.redhat.com/errata/RHSA-2010-0378.html","https://rhn.redhat.com/errata/RHSA-2010-0379.html","https://www.cisa.gov/known-exploited-vulnerabilities-catalog?field_cve=CVE-2010-1428","https://github.com/trickest/cve/blob/ed228d55b7972f63e700a35a54fbcd94064b9ade/2010/CVE-2010-1428.md","https://github.com/CVEProject/cvelistV5/blob/34b929f9979d6d9d9584dfab31f29f50dcf08e3f/cves/2010/1xxx/CVE-2010-1428.json","https://github.com/LiuCan01/cve-list-pro/blob/78b55511cee3604c22d518e32822f0435d0cacc0/cve-list/CVE-2010/CVE-2010-1428","https://github.com/cisagov/vulnrichment/blob/a5255477d5a184aa815a0febf0096e43251805cf/2010/1xxx/CVE-2010-1428.json","https://github.com/zhzyker/vulmap/blob/3694afb7a3adec0b7f7c9027aab596e7b147c585/readme.md","https://github.com/e-m-b-a/emba/blob/4d0f24b3edae0bdb5391177851bad3be54ecea0f/config/msf_cve-db.txt","https://github.com/a-dhaou-tekup/VRA/blob/3e4f21c329250c5eca327489d3fd5be9b398ce7b/data/rag_corpus/cisa_kev_notes/CVE-2010-1428.txt","https://github.com/cyberdudebivash/cyberdudebivash-ai-security-hub/blob/13403e1745f63237e7ef6d51562fb36112320d77/frontend/cve/CVE-2010-1428.html","https://github.com/Ostorlab/KEV/blob/8feadeb8b7ff54359eab87941769781629146b23/README.md","https://github.com/lucacapacci/cisa_kev/blob/730547e3121e93fb4d300346c9d4aa5d5b39b4fc/data_single/2010/CVE-2010-1428.csv"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":["https://raw.githubusercontent.com/adysec/AVE/main/pocs/2010/POC-AVE-2010-0300.toml"],"repo_exp_urls":["https://raw.githubusercontent.com/adysec/AVE/main/exploits/2010/EXP-AVE-2010-0300.toml"],"has_poc":true,"has_exp":true,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/2010/AVE-2010-0300.toml"},{"ave_id":"AVE-2010-0206","file_name":"2010/AVE-2010-0206.toml","cve_id":"CVE-2010-0738","title":"Red Hat JBoss 企业应用平台 JMX-Console 权限绕过漏洞","description":"JBoss 中间件的 JMX-Console 管理控制台存在访问控制缺陷，仅对 GET 和 POST 方法实施了权限校验，攻击者可通过 PUT、DELETE 等其他 HTTP 方法绕过认证，直接访问 DeploymentFileRepository 的 GET 处理程序，进而上传并部署恶意 WAR 文件实现远程代码执行。该漏洞影响 JBoss EAP 4.2.0.CP09 之前及 4.3.0.CP08 之前的版本，CVSS 评分 5.3，危害等级中危。建议升级至修复版本或禁用 JMX-Console 对外暴露。","severity":"MEDIUM","score":5.3,"aliases":["CVE-2010-0738"],"sources":["kev"],"published":"2010-04-28T22:30:00Z","updated":"2026-06-16T23:16:45Z","remediation":"升级 Red Hat JBoss EAP 至 4.2.0.CP09 或 4.3.0.CP08 及以上版本（对应 RHSA-2010-0376/0377/0378/0379）。临时缓解措施：在反向代理或防火墙层面限制对 /jmx-console/ 路径的访问，仅允许可信 IP 访问，或禁用 JMX-Console 的 HTTP 非 GET/POST 方法。","status":"completed","collected_at":"2026-07-22T00:00:00Z","references":["http://marc.info/?l=bugtraq&m=132129312609324&w=2","http://public.support.unisys.com/common/public/vulnerability/NVD_Detail_Rpt.aspx?ID=35","http://secunia.com/advisories/39563","http://securityreason.com/securityalert/8408","http://securitytracker.com/id?1023918","http://www.securityfocus.com/bid/39710","http://www.vupen.com/english/advisories/2010/0992","https://bugzilla.redhat.com/show_bug.cgi?id=574105","https://exchange.xforce.ibmcloud.com/vulnerabilities/58147","https://rhn.redhat.com/errata/RHSA-2010-0376.html","https://rhn.redhat.com/errata/RHSA-2010-0377.html","https://rhn.redhat.com/errata/RHSA-2010-0378.html","https://rhn.redhat.com/errata/RHSA-2010-0379.html","https://www.cisa.gov/known-exploited-vulnerabilities-catalog?field_cve=CVE-2010-0738","https://www.exploit-db.com/exploits/16319",
23ce73df945527011e5cc49/2000/CVE-2000-0008.md","https://github.com/CVEProject/cvelistV5/blob/c8f1603cb76d37d7aca26a74458e0aff33b0985a/cves/2000/0xxx/CVE-2000-0008.json","https://github.com/LiuCan01/cve-list-pro/blob/78b55511cee3604c22d518e32822f0435d0cacc0/cve-list/CVE-2000/CVE-2000-0008","https://github.com/sari3l/Poc-Monitor/blob/2297c357ff5ff64d3949208296fbd1252169cc37/2000/CVE-2000-0008.json","https://github.com/mabitoski/cve_submodules/blob/44ad7e2705b3aef1b2ffaf64bd47596c10a6c2e4/2000/CVE-2000-0008.md","https://github.com/Patrowl/PatrowlHearsData/blob/1baa87c09640becdfd7ca993d7d2150d97be85a6/CVE/data/2000/CVE-2000-0008.json","https://github.com/intSpLoiT/intframework/blob/eabaa799d0260aa52b735fa9769266d1ce4b64ef/modules/cve_list.txt","https://github.com/SpeeDr00t/speedr00t.github.com/blob/0380f0c2190556fabe90257cb6c0034a42f68951/securityfocus/0x2000/1790/info.html","https://github.com/oasis-open/cti-stix-common-objects/blob/55ba7598cbd5a52577b6887871505d931d85cb61/objects/vulnerability/vulnerability--02e47c55-93fc-4f6f-853f-d254db309896.json","https://github.com/security-commits/security-patches-dataset/blob/e93fcdcc8c9b91785f962a06d66b7ee623780245/data/cve-details/year/1999.csv"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":[],"repo_exp_urls":[],"has_poc":false,"has_exp":false,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/2000/AVE-2000-0009.toml"},{"ave_id":"AVE-2000-0007","file_name":"2000/AVE-2000-0007.toml","cve_id":"CVE-2000-0006","title":"strace 任意文件读取漏洞","description":"strace 是一款 Linux/Unix 系统下的系统调用跟踪调试工具，其在处理内存映射文件名时存在缺陷，导致本地普通用户可利用 strace 跟踪其他进程系统调用的功能，通过构造特定的内存映射文件名来读取任意文件内容。该漏洞影响 strace 多个版本，攻击者需要拥有本地系统访问权限，无法远程利用，危害等级较低。厂商已发布修复版本，建议用户升级至最新版 strace。","severity":"LOW","score":2.6,"aliases":["CVE-2000-0006"],"sources":["avd"],"published":"1999-12-25T05:00:00.000","updated":"2026-06-16T21:50:48.500","remediation":"strace 4.4 之前的版本在解析 /proc/self/maps 时未正确限制内存映射文件名的读取权限，导致本地低权限用户可通过 trojan 程序配合 strace 读取任意文件内容。建议将 strace 升级至 4.4 或更高版本；如无法升级，应移除 strace 的 suid 权限位（`chmod u-s /usr/bin/strace`）并限制仅 root 用户可执行，同时避免在多用户环境下赋予不可信用户 strace 执行权限。","status":"completed","collected_at":"2026-07-21T00:00:00Z","references":["http://online.securityfocus.com/archive/1/39831","https://exchange.xforce.ibmcloud.com/vulnerabilities/4554","https://github.com/CVEProject/cvelistV5/blob/c8f1603cb76d37d7aca26a74458e0aff33b0985a/cves/2000/0xxx/CVE-2000-0006.json","https://github.com/LiuCan01/cve-list-pro/blob/78b55511cee3604c22d518e32822f0435d0cacc0/cve-list/CVE-2000/CVE-2000-0006","https://github.com/openbmc/openbmc/blob/753195abd6c649ec631ec3b8f5760dfa888c0829/upstream-layers/openembedded-core/meta/conf/distro/include/cve-extra-exclusions.inc","https://github.com/yarencheng/cve-devops-playground/blob/7f1c35ad28226319c149c937b6a2e7a1986924ce/content/CVE-2000-0006.md","https://github.com/Patrowl/PatrowlHearsData/blob/1baa87c09640becdfd7ca993d7d2150d97be85a6/CVE/data/2000/CVE-2000-0006.json","https://github.com/joaop9425/manual-do-tecnico/blob/cc6e0f5304777f18e55db554da5372bc31d4cae1/src/content/noticias/2026/01/04/seguranca/cve-2000-0006-strace-allows-local-users-to-read-ar-1767537313000.md","https://github.com/github/advisory-database/blob/23c72f0e29729596bf60b6750cbec12b936da4bf/advisories/unreviewed/2022/04/GHSA-fmp9-jf38-4px4/GHSA-fmp9-jf38-4px4.json","https://github.com/openembedded/openembedded-core/blob/a4eb7bc2a750f76d9772eb88b7afb2b801bd1250/meta/conf/distro/include/cve-extra-exclusions.inc","https://github.com/microsoft/AzureLinuxVulnerabilityData/blob/a83313f052bb2e5233541fa72d03772d59c63a86/osv/AZL-35286.json","https://github.com/intSpLoiT/intframework/blob/eabaa799d0260aa52b735fa9769266d1ce4b64ef/modules/cve_list.txt"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":[],"repo_exp_urls":[],"has_poc":false,"has_exp":false,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/2000/AVE-2000-0007.toml"}]
[{"ave_id":"AVE-2025-0742","file_name":"2025/AVE-2025-0742.toml","cve_id":"CVE-2025-21283","title":"Microsoft Edge（基于 Chromium）远程代码执行漏洞","description":"Microsoft Edge（基于 Chromium）存在远程代码执行漏洞。该漏洞源于 Chromium 内核在处理特制网页内容时存在缺陷，未经身份认证的攻击者可通过诱导用户访问恶意构造的网页触发漏洞，成功利用可在目标系统上以当前用户权限执行任意代码。攻击需要用户交互（如点击链接或访问恶意站点），无法远程直接利用。影响 Microsoft Edge 133.0.3065.51 之前版本，CVSS 评分 6.5，危害等级中危。Microsoft 已在 2025 年 2 月安全更新中修复此漏洞。","severity":"MEDIUM","score":6.5,"aliases":["CVE-2025-21283"],"sources":["msrc"],"published":"2025-02-06T23:15:09Z","updated":"2026-06-17T08:42:59Z","remediation":"立即将 Microsoft Edge 更新至 133.0.3065.51 或更高版本。可通过浏览器菜单「帮助和设置」→「关于 Microsoft Edge」自动检查并安装更新，或从 microsoft.com/edge 手动下载最新版本安装。企业用户可通过 Microsoft Endpoint Manager 或 WSUS 统一推送更新。","status":"completed","collected_at":"2026-08-03T00:00:00Z","references":["https://msrc.microsoft.com/update-guide/vulnerability/CVE-2025-21283","https://github.com/CVEProject/cvelistV5/blob/f7f0337cfdc7d8aab4c9eb0d8a44be53baa8f88d/cves/2025/21xxx/CVE-2025-21283.json","https://github.com/cisagov/vulnrichment/blob/256acfffdec561159f01d27b17d0320e6463101a/2025/21xxx/CVE-2025-21283.json","https://github.com/Patrowl/PatrowlHearsData/blob/df225994fea2bf22c3b73491021c40bfd2f964e1/CVE/data/2025/CVE-2025-21283.json","https://github.com/Patrowl/PatrowlHearsData/blob/df225994fea2bf22c3b73491021c40bfd2f964e1/SSVC/data/2025/CVE-2025-21283.json","https://github.com/nomi-sec/NVD-Database/blob/23dc120c34402aaa65883c51c1d03b3cb02c20cb/2025/CVE-2025-21283.json","https://github.com/olbat/nvdcve/blob/fe7f195231342e1e88104679c53c965e9a67ac35/nvdcve/CVE-2025-21283.json","https://github.com/fkie-cad/nvd-json-data-feeds/blob/d6e5bf87d27954c5a3cd48e565b212fb97932a81/CVE-2025/CVE-2025-212xx/CVE-2025-21283.json","https://github.com/opencve/opencve-kb/blob/da1453d4cae0dea874922584911158e4da10a575/2025/CVE-2025-21283.json","https://github.com/aquasecurity/vuln-list-nvd/blob/7bec7ab13a920b5bdca1b43ac1859f030aec77a0/api/2025/CVE-2025-21283.json","https://github.com/imSkows/Cyber-Vulnerability-Analysis-Data/blob/db26c44c5f45c25514223a46675daec7eea03092/data/mitre/CVE-2025-21283"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":[],"repo_exp_urls":[],"has_poc":false,"has_exp":false,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/2025/AVE-2025-0742.toml"},{"ave_id":"AVE-2025-0738","file_name":"2025/AVE-2025-0738.toml","cve_id":"CVE-2025-21279","title":"Microsoft Edge 远程代码执行漏洞","description":"Microsoft Edge（基于 Chromium）存在类型混淆（Type Confusion）远程代码执行漏洞，漏洞源于 Chromium 内核在处理特定对象时未能正确验证类型，导致内存访问越界。远程攻击者可通过构造特制的恶意网页并诱使用户在受影响浏览器中访问，成功利用该漏洞可在当前用户上下文中执行任意代码，导致敏感信息泄露。该漏洞影响 Microsoft Edge 133.0.3065.51 之前版本，CVSS 评分 6.5，危害等级中危。Microsoft 已在 2025 年 2 月安全更新中修复此漏洞。","severity":"MEDIUM","score":6.5,"aliases":["CVE-2025-21279"],"sources":["msrc"],"published":"2025-02-06T23:15:09Z","updated":"2026-06-17T08:42:58Z","remediation":"立即将 Microsoft Edge 升级至 133.0.3065.51 或更高版本。可通过浏览器内置更新（设置→关于 Microsoft Edge→检查更新）自动下载安装，或从 Microsoft 官网手动下载最新稳定版。企业用户可通过组策略配置自动更新策略，确保终端及时接收安全补丁。作为临时缓解措施，可配置浏览器安全策略禁用不信任的扩展程序，并提醒用户勿点击可疑链接。","status":"completed","collected_at":"2026-08-03T00:00:00Z","references":["https://msrc.microsoft.com/update-guide/vulnerability/CVE-2025-21279","https://github.com/CVEProject/cvelistV5/blob/f7f0337cfdc7d8aab4c9eb0d8a44be53baa8f88d/cves/2025/21xxx/CVE-2025-21279.json","https://github.com/cisagov/vulnrichment/blob/256acfffdec561159f01d27b17d0320e6463101a/2025/21xxx/CVE-2025-21279.json","https://github.com/Patrowl/PatrowlHearsData/blob/df225994fea2bf22c3b73491021c40bfd2f964e1/CVE/data/2025/CVE-2025-21279.json","https://github.com/Patrowl/PatrowlHearsData/blob/df225994fea2bf22c3b73491021c40bfd2f964e1/SSVC/data/2025/CVE-2025-21279.json","https://github.com/nomi-sec/NVD-Database/blob/23dc120c34402aaa65883c51c1d03b3cb02c20cb/2025/CVE-2025-21279.json","https://github.com/olbat/nvdcve/blob/fe7f195231342e1e88104679c53c965e9a67ac35/nvdcve/CVE-2025-21279.json","https://github.com/fkie-cad/nvd-json-data-feeds/blob/d6e5bf87d27954c5a3cd48e565b212fb97932a81/CVE-2025/CVE-2025-212xx/CVE-2025-21279.json","https://github.com/opencve/opencve-kb/blob/a8d9b19e8bcb98a5a7dedc851836a009f19fbc3e/2025/CVE-2025-21279.json","https://github.com/aquasecurity/vuln-list-nvd/blob/7bec7ab13a920b5bdca1b43ac1859f030aec77a0/api/2025/CVE-2025-21279.json","https://github.com/imSkows/Cyber-Vulnerability-Analysis-Data/blob/db26c44c5f45c25514223a46675daec7eea03092/data/first/CVE-2025-21279"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":[],"repo_exp_urls":[],"has_poc":false,"has_exp":false,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/2025/AVE-2025-0738.toml"},{"ave_id":"AVE-2025-0726","file_name":"2025/AVE-2025-0726.toml","cve_id":"CVE-2025-21267","title":"Microsoft Edge（基于Chromium）欺骗漏洞","description":"Microsoft Edge（基于 Chromium）存在欺骗漏洞，由于对用户界面元素的验证不充分，攻击者可通过诱导用户点击特制链接或与恶意页面交互，在浏览器地址栏或安全指示器中显示虚假内容，从而实施网络钓鱼或身份欺骗攻击。该漏洞影响 133.0.3065.51 之前版本的 Microsoft Edge（Chromium-based），攻击复杂度低，无需特权，但需要用户交互。Microsoft 已在 2025 年 2 月安全更新中修复此漏洞。","severity":"MEDIUM","score":4.4,"aliases":["CVE-2025-21267"],"sources":["msrc"],"published":"2025-02-06T23:15:08Z","updated":"2026-06-17T08:42:56Z","remediation":"立即将 Microsoft Edge 升级至 133.0.3065.51 或更高版本，可通过 Edge 内置更新工具（设置→关于 Microsoft Edge→检查更新）或从官网下载安装。如无法立即更新，可在浏览器设置中启用「增强安全模式」并避免点击来源不明的链接。企业用户可通过组策略配置自动更新策略强制推送补丁。","status":"completed","collected_at":"2026-08-03T00:00:00Z","references":["https://msrc.microsoft.com/update-guide/vulnerability/CVE-2025-21267","https://github.com/CVEProject/cvelistV5/blob/73e213348ddf142cab7e77d05861fa314ba8e1d0/cves/2025/21xxx/CVE-2025-21267.json","https://github.com/cisagov/vulnrichment/blob/2e0e3782ab192a0dba6edbe5e9deeb3c79e8414c/2025/21xxx/CVE-2025-21267.json","https://github.com/Patrowl/PatrowlHearsData/blob/cec9fb1846e25b24020f297f65ec2360af0f4267/CVE/data/2025/CVE-2025-21267.json","https://github.com/Patrowl/PatrowlHearsData/blob/cec9fb1846e25b24020f297f65ec2360af0f4267/SSVC/data/2025/CVE-2025-21267.json","https://github.com/nomi-sec/NVD-Database/blob/23dc120c34402aaa65883c51c1d03b3cb02c20cb/2025/CVE-2025-21267.json","https://github.com/olbat/nvdcve/blob/fe7f195231342e1e88104679c53c965e9a67ac35/nvdcve/CVE-2025-21267.json","https://github.com/fkie-cad/nvd-json-data-feeds/blob/d6e5bf87d27954c5a3cd48e565b212fb97932a81/CVE-2025/CVE-2025-212xx/CVE-2025-21267.json","https://github.com/opencve/opencve-kb/blob/106a1fdac91d72807fea971dfa93d601744b9ae9/2025/CVE-2025-21267.json","https://github.com/aquasecurity/vuln-list-nvd/blob/7bec7ab13a920b5bdca1b43ac1859f030aec77a0/api/2025/CVE-2025-21267.json","https://github.com/imSkows/Cyber-Vulnerability-Analysis-Data/blob/db26c44c5f45c25514223a46675daec7eea03092/data/mitre/CVE-2025-21267"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":[],"repo_exp_urls":[],"has_poc":false,"has_exp":false,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/2025/AVE-2025-0726.toml"},{"ave_id":"AVE-2025-0712","file_name":"2025/AVE-2025-0712.toml","cve_id":"CVE-2025-21253","title":"Microsoft Edge iOS Android 欺骗漏洞","description":"Microsoft Edge 在 iOS 与 Android 平台上存在 URL 欺骗（Spoofing）漏洞（CWE-451），源于浏览器在渲染地址栏或页面信息时对内容缺少充分的身份校验，导致远程攻击者可构造特制链接，诱导用户点击后使地址栏显示与真实目标不一致的网址，从而伪装成可信站点。该漏洞归于无需认证与用户交互的网络安全向量，攻击者无需先登录目标系统，仅需诱使用户在受影响的移动版 Edge 中访问恶意页面即可触发，进而实施钓鱼、仿冒或其他社会工程攻击，危害等级为中等。Microsoft 已在 2025 年 2 月安全更新中对受影响的 Edge for iOS/Android 版本进行修复，建议用户及时更新至最新版本。","severity":"MEDIUM","score":5.3,"aliases":["CVE-2025-21253"],"sources":["msrc"],"published":"2025-02-06T23:15:08Z","updated":"2026-06-17T08:42:54Z","remediation":"建议通过 App Store（iOS）或 Google Play（Android）将 Microsoft Edge 升级至修复该漏洞的版本（Edge 135.0.3170.98 及更新版本），并开启应用自动更新以确保及时获得安全补丁。由于该漏洞为界面欺骗（CWE-451），可在升级完成前注意核对浏览器地址栏显示的网址是否为官方域名，警惕任何诱导访问的链接，避免在可疑页面输入敏感信息；同时在企业环境中可通过 MDM/Intune 策略统一推送并强制更新组织内 Edge，并在行为感知层面启用 Microsoft Entra 登录保护，作为无法立即升级时的临时缓解措施。","status":"completed","collected_at":"2026-08-03T00:00:00Z","references":["https://msrc.microsoft.com/update-guide/vulnerability/CVE-2025-21253","https://github.com/CVEProject/cvelistV5/blob/0661b1b09ba7a2e855981f4a1781f3b8de7cf562/cves/2025/21xxx/CVE-2025-21253.json","https://github.com/cisagov/vulnrichment/blob/0812ebe932b97710173c59d3d74959fb420956eb/2025/21xxx/CVE-2025-21253.json","https://github.com/Patrowl/PatrowlHearsData/blob/8a257d250bdb59b542a188d62ddae45e6eb5d3f2/CVE/data/2025/CVE-2025-21253.json","https://github.com/Patrowl/PatrowlHearsData/blob/8a257d250bdb59b542a188d62ddae45e6eb5d3f2/SSVC/data/2025/CVE-2025-21253.json","https://github.com/nomi-sec/NVD-Database/blob/23dc120c34402aaa65883c51c1d03b3cb02c20cb/2025/CVE-2025-21253.json","https://github.com/olbat/nvdcve/blob/fe7f195231342e1e88104679c53c965e9a67ac35/nvdcve/CVE-2025-21253.json","https://github.com/fkie-cad/nvd-json-data-feeds/blob/b5070d3c2d6dc2fda079c163276abcda1c82b124/CVE-2025/CVE-2025-212xx/CVE-2025-21253.json","https://github.com/opencve/opencve-kb/blob/7753953b586683c230526e07a6b8b2948b832025/2025/CVE-2025-21253.json","https://github.com/aquasecurity/vuln-list-nvd/blob/ef57640f19da1737a8612e28839821eee8a753b5/api/2025/CVE-2025-21253.json","https://github.com/imSkows/Cyber-Vulnerability-Analysis-Data/blob/db26c44c5f45c25514223a46675daec7eea03092/data/first/CVE-2025-21253"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":[],"repo_exp_urls":[],"has_poc":false,"has_exp":false,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/2025/AVE-2025-0712.toml"},{"ave_id":"AVE-2025-0639","file_name":"2025/AVE-2025-0639.toml","cve_id":"CVE-2025-21177","title":"Microsoft Dynamics 365 Sales 服务端请求伪造特权提升漏洞","description":"Microsoft Dynamics 365 Sales 存在服务端请求伪造（SSRF）漏洞，CWE-918。已获得授权的攻击者可利用该漏洞向内部网络资源发送特制请求，绕过访问控制，实现权限提升。攻击者需具备低权限并诱使用户交互（如点击链接），即可利用该漏洞读取内部端点敏感信息或执行未授权操作。该漏洞影响 Microsoft Dynamics 365 Sales 相关版本，CVSS 评分 8.7，危害等级高。Microsoft 已在 2025 年 2 月安全更新中修复此漏洞。","severity":"HIGH","score":8.7,"aliases":["CVE-2025-21177"],"sources":["msrc"],"published":"2025-02-06T23:15:08Z","updated":"2026-06-17T08:42:42Z","remediation":"此漏洞影响 Microsoft Dynamics 365 Sales 云服务，微软已在服务端完成修复，用户无需执行任何操作。如使用自托管版本，请确保已安装 2025 年 2 月安全更新或升级至最新受支持版本，并在网络层面限制 Dynamics 365 对外部资源的出站请求以缓解 SSRF 风险。","status":"completed","collected_at":"2026-08-03T00:00:00Z","references":["https://msrc.microsoft.com/update-guide/vulnerability/CVE-2025-21177","https://github.com/CVEProject/cvelistV5/blob/81757a559270348b5ed9f7df6d4fbf1e7a4fae68/cves/2025/21xxx/CVE-2025-21177.json","https://github.com/cisagov/vulnrichment/blob/1fe56a0dafbbcb548bdcdd4fc990cca72ac81c28/2025/21xxx/CVE-2025-21177.json","https://github.com/Patrowl/PatrowlHearsData/blob/03a7e425813b5ae0ce33712378801e4e929dbdb7/CVE/data/2025/CVE-2025-21177.json","https://github.com/Patrowl/PatrowlHearsData/blob/03a7e425813b5ae0ce33712378801e4e929dbdb7/SSVC/data/2025/CVE-2025-21177.json","https://github.com/nomi-sec/NVD-Database/blob/23dc120c34402aaa65883c51c1d03b3cb02c20cb/2025/CVE-2025-21177.json","https://github.com/olbat/nvdcve/blob/9b1777f43cb72006ac01427b6823146d45a3862a/nvdcve/CVE-2025-21177.json","https://github.com/fkie-cad/nvd-json-data-feeds/blob/b9f52bb052695dac5cabbd58e049eaac73697161/CVE-2025/CVE-2025-211xx/CVE-2025-21177.json","https://github.com/opencve/opencve-kb/blob/bb000df9f27fa146ab353b5455f4a8607b3ce719/2025/CVE-2025-21177.json","https://github.com/zzzteph/low-hanging-vulns/blob/144e072a72718cf976367989b4ef7fcf3f72bd13/nvd/2025/HIGH/CVE-2025-21177/README.md","https://github.com/aquasecurity/vuln-list-nvd/blob/ef57640f19da1737a8612e28839821eee8a753b5/api/2025/CVE-2025-21177.json"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":[],"repo_exp_urls":[],"has_poc":false,"has_exp":false,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/2025/AVE-2025-0639.toml"},{"ave_id":"AVE-2025-0412","file_name":"2025/AVE-2025-0412.toml","cve_id":"CVE-2025-0725","title":"curl libcurl gzip 解压缩整数溢出漏洞","description":"libcurl 在处理 HTTP 响应中的 gzip 压缩内容时，若使用 zlib 1.2.0.3 或更早版本，存在整数溢出漏洞。当 libcurl 通过 CURLOPT_ACCEPT_ENCODING 选项启用自动 gzip 解压缩功能时，攻击者可构造特制的压缩数据触发整数溢出，进而导致堆缓冲区溢出。远程攻击者无需身份认证即可利用此漏洞，可能导致信息泄露、数据篡改或服务拒绝。该漏洞影响广泛使用 libcurl 的应用程序和系统，包括 curl 命令行工具及各类集成 libcurl 的软件。用户应升级 curl/libcurl 至修复版本或更新 zlib 至 1.2.0.4 及以上版本以缓解风险。","severity":"HIGH","score":7.3,"aliases":["CVE-2025-0725"],"sources":["msrc"],"published":"2025-02-05T10:15:22Z","updated":"2026-06-17T08:27:02Z","remediation":"立即将 curl/libcurl 升级至 8.12.0 或更高版本（官方已在该版本中移除对 zlib < 1.2.0.4 的支持，直接阻断溢出路径）。如无法立即升级，可应用官方补丁（https://github.com/curl/curl/commit/76f83f0db23846e254d940ec7）后重新编译，或临时避免使用 CURLOPT_ACCEPT_ENCODING 选项禁用自动 gzip 解压，同时确保系统 zlib 版本不低于 1.2.0.4。","status":"completed","collected_at":"2026-07-27T00:00:00Z","references":["https://curl.se/docs/CVE-2025-0725.html","https://curl.se/docs/CVE-2025-0725.json","https://hackerone.com/reports/2956023","http://www.openwall.com/lists/oss-security/2025/02/05/3","http://www.openwall.com/lists/oss-security/2025/02/06/2","http://www.openwall.com/lists/oss-security/2025/02/06/4","https://github.com/curl/curl/commit/76f83f0db23846e254d940ec7","https://security.netapp.com/advisory/ntap-20250306-0009/","https://github.com/trickest/cve/blob/be44b05b9428dc18bc0705cf60dd8d8640cd49b1/2025/CVE-2025-0725.md","https://github.com/gelusus/wxvl/blob/adf269d0776d63ad63598085918a36e4953f7c9c/doc/2025-02/%E3%80%90%E6%BC%8F%E6%B4%9E%E9%80%9A%E5%91%8A%E3%80%91gzip%20%E6%95%B4%E6%95%B0%E6%BA%A2%E5%87%BA(CVE-2025-0725).md","https://github.com/CVEProject/cvelistV5/blob/3fc46d7716e9a0dd9635d13e2bff8fffb122a860/cves/2025/0xxx/CVE-2025-0725.json","https://github.com/envoyproxy/envoy/blob/359861cdad48ead4b4ee1d08680ed509020d2a4e/changelogs/1.34.8.yaml","https://github.com/curl/curl-www/blob/245bd197493b521edc2f9a005c35c1a1d3e731ff/docs/CVE-2025-0725.md","https://github.com/bugbountywithmarco/bugbounty-disclosed-reports/blob/b6c76d1437e08a0ef77b7fbed612791c71cc4aa5/reports/2956023_CVE-2025-0725_gzip_integer_overflow.md","https://github.com/neuvector/vul-source/blob/83b6758c208f8fd7e22b7c88e002c3658ef467b8/ubuntu-cve-tracker/retired/CVE-2025-0725","https://github.com/microsoft/azurelinux/blob/db4dceaf9bd186cb20f62c3a43615b9421200bed/specs/c/curl/curl.spec","https://github.com/fluent/fluent-bit/blob/cb7256c2867494ae404ab6e3da936e8f6e0c9c94/lib/librdkafka-2.15.0/CHANGELOG.md","https://github.com/reddelexc/hackerone-reports/blob/420e41078cd65f59f446c2dc4b337051e83055bc/docs/tops_by_program/TOPCURL.md"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":[],"repo_exp_urls":[],"has_poc":false,"has_exp":false,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/2025/AVE-2025-0412.toml"},{"ave_id":"AVE-2025-0404","file_name":"2025/AVE-2025-0404.toml","cve_id":"CVE-2025-0665","title":"curl libcurl eventfd 双重关闭漏洞","description":"libcurl 在完成线程化域名解析后关闭连接通道时，会错误地将同一个 eventfd 文件描述符关闭两次，导致双重释放（double close）漏洞。攻击者可通过构造特定的 DNS 解析请求触发该漏洞，造成程序崩溃或文件描述符被重用的不可预测行为，可能导致信息泄露或拒绝服务。该漏洞影响 curl/libcurl 多个版本，CVSS 评分 7.0，危害等级高。攻击复杂度较高，需满足特定条件方可利用。官方已在 curl 8.14.1 版本中修复此问题。","severity":"HIGH","score":7.0,"aliases":["CVE-2025-0665"],"sources":["msrc"],"published":"2025-02-05T10:15:22Z","updated":"2026-06-17T08:26:55Z","remediation":"升级 curl/libcurl 至 8.12.0 或更高版本。如无法立即升级，可应用补丁 https://github.com/curl/curl/commit/ff5091aa9f73802e894b1cbdf 后重新编译，或在构建时禁用 eventfd（--disable-eventfd），或改用 c-ares 异步解析器作为临时缓解措施。","status":"completed","collected_at":"2026-07-27T00:00:00Z","references":["https://curl.se/docs/CVE-2025-0665.html","https://curl.se/docs/CVE-2025-0665.json","https://hackerone.com/reports/2954286","http://www.openwall.com/lists/oss-security/2025/02/05/2","http://www.openwall.com/lists/oss-security/2025/02/05/5","https://security.netapp.com/advisory/ntap-20250306-0007/","https://github.com/trickest/cve/blob/e69d88e0152845fc4d4b49970ca6e503f56b2f93/2025/CVE-2025-0665.md","https://github.com/CVEProject/cvelistV5/blob/3fc46d7716e9a0dd9635d13e2bff8fffb122a860/cves/2025/0xxx/CVE-2025-0665.json","https://github.com/gelusus/wxvl/blob/adf269d0776d63ad63598085918a36e4953f7c9c/doc/2025-02/%E3%80%90%E6%BC%8F%E6%B4%9E%E9%80%9A%E5%91%8A%E3%80%91eventfd%20%E5%8F%8C%E9%87%8D%E5%85%B3%E9%97%AD(CVE-2025-0665).md","https://github.com/bugbountywithmarco/bugbounty-disclosed-reports/blob/b6c76d1437e08a0ef77b7fbed612791c71cc4aa5/reports/2954286_CVE-2025-0665_eventfd_double_close.md","https://github.com/curl/curl-www/blob/245bd197493b521edc2f9a005c35c1a1d3e731ff/docs/CVE-2025-0665.md","https://github.com/transmission/transmission/blob/7c3d461c9de0ab21fe4226e740374257e57b3e12/libtransmission/web.cc","https://github.com/canonical/ubuntu-security-notices/blob/bb6cd0f1a29580d840cdb570b8b0c57cc39aac6d/osv/cve/2025/UBUNTU-CVE-2025-0665.json","https://github.com/cisagov/vulnrichment/blob/917696d148c885368c24cb2bf38f1552da3d5c31/2025/0xxx/CVE-2025-0665.json","https://github.com/neuvector/vul-source/blob/83b6758c208f8fd7e22b7c88e002c3658ef467b8/ubuntu-cve-tracker/retired/CVE-2025-0665","https://github.com/microsoft/azurelinux/blob/db4dceaf9bd186cb20f62c3a43615b9421200bed/specs/c/curl/curl.spec"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":[],"repo_exp_urls":[],"has_poc":false,"has_exp":false,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/2025/AVE-2025-0404.toml"},{"ave_id":"AVE-2025-0377","file_name":"2025/AVE-2025-0377.toml","cve_id":"CVE-2025-0167","title":"curl netrc 默认凭证泄露漏洞","description":"curl 在处理 .netrc 文件认证凭证与 HTTP 重定向时存在凭证泄露漏洞。当 curl 被配置为使用 .netrc 文件获取凭据，同时启用 HTTP 重定向跟随功能时，若 .netrc 文件中存在省略了登录名和密码的 default 条目，curl 会将用于第一个主机的密码泄露给重定向目标主机。攻击者可通过构造恶意重定向响应，诱使 curl 客户端泄露敏感凭证信息。该漏洞攻击复杂度较高，需要特定配置条件，CVSS 评分 3.4，危害等级低。curl 项目已在后续版本中修复此问题。","severity":"LOW","score":3.4,"aliases":["CVE-2025-0167"],"sources":["msrc"],"published":"2025-02-05T10:15:22Z","updated":"2026-06-17T08:25:59Z","remediation":"升级 curl 和 libcurl 至 8.12.0 或更高版本（8.12.0 于 2025 年 2 月 5 日发布），该版本已修复 netrc 默认条目凭证在 HTTP 重定向时泄漏的问题。如无法立即升级，可应用补丁 commit 0e120c5b925e8ca75d5319e 和 9bee39bfed2c413b4cc 后重新编译；临时缓解措施为避免在 .netrc 中使用 default 条目与 HTTP 重定向同时使用。","status":"completed","collected_at":"2026-07-27T00:00:00Z","references":["https://curl.se/docs/CVE-2025-0167.html","https://curl.se/docs/CVE-2025-0167.json","https://hackerone.com/reports/2917232","https://security.netapp.com/advisory/ntap-20250306-0008/","https://github.com/trickest/cve/blob/e69d88e0152845fc4d4b49970ca6e503f56b2f93/2025/CVE-2025-0167.md","https://github.com/CVEProject/cvelistV5/blob/257ebb29696cc311841c79ca4ceb0162bf5df44a/cves/2025/0xxx/CVE-2025-0167.json","https://github.com/curl/curl-www/blob/245bd197493b521edc2f9a005c35c1a1d3e731ff/docs/CVE-2025-0167.md","https://github.com/bugbountywithmarco/bugbounty-disclosed-reports/blob/b6c76d1437e08a0ef77b7fbed612791c71cc4aa5/reports/2917232_CVE-2025-0167_netrc_and_default_credential_leak.md","https://github.com/canonical/ubuntu-security-notices/blob/b7d9f3f65d1036a114c9bae4a66ed35d83999166/osv/cve/2025/UBUNTU-CVE-2025-0167.json","https://github.com/neuvector/vul-source/blob/83b6758c208f8fd7e22b7c88e002c3658ef467b8/ubuntu-cve-tracker/retired/CVE-2025-0167","https://github.com/microsoft/azurelinux/blob/db4dceaf9bd186cb20f62c3a43615b9421200bed/specs/c/curl/curl.spec","https://github.com/fluent/fluent-bit/blob/cb7256c2867494ae404ab6e3da936e8f6e0c9c94/lib/librdkafka-2.15.0/CHANGELOG.md","https://github.com/reddelexc/hackerone-reports/blob/420e41078cd65f59f446c2dc4b337051e83055bc/docs/tops_by_program/TOPCURL.md","https://github.com/Patrowl/PatrowlHearsData/blob/2b92b509a6091f543702b902d36eba35e2393da1/CVE/data/2025/CVE-2025-0167.json"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":[],"repo_exp_urls":[],"has_poc":false,"has_exp":false,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/2025/AVE-2025-0377.toml"},{"ave_id":"AVE-2025-0397","file_name":"2025/AVE-2025-0397.toml","cve_id":"CVE-2025-0451","title":"Google Chrome Extensions API 界面伪造漏洞","description":"Google Chrome 浏览器 Extensions API 存在不当实现漏洞（CWE-451），攻击者可构造特制的 Chrome 扩展程序，诱骗用户执行特定的 UI 交互手势，从而利用该扩展实施界面欺骗（UI Spoofing）攻击。攻击者需要先诱导用户安装恶意扩展并完成特定交互操作，攻击条件较为受限。该漏洞影响 Chrome 133.0.6943.53 之前版本及基于 Chromium 的 Microsoft Edge 等浏览器，CVSS 评分 6.3，危害等级中危。","severity":"MEDIUM","score":6.3,"aliases":["CVE-2025-0451"],"sources":["msrc"],"published":"2025-02-04T19:15:32Z","updated":"2026-06-17T08:26:30Z","remediation":"立即将 Google Chrome 升级至 133.0.6943.53 或更高版本（通过 chrome://settings/help 自动检查更新）；使用 Microsoft Edge 的用户需升级至 133.0.3065.51 或更高版本。临时缓解措施：在浏览器扩展管理页面禁用所有非官方来源的扩展程序，并启用「增强安全保护」模式。基于 Chromium 的其他浏览器（如 Brave、Opera、Vivaldi）请关注厂商同步更新。","status":"completed","collected_at":"2026-07-27T00:00:00Z","references":["https://chromereleases.googleblog.com/2025/02/stable-channel-update-for-desktop.html","https://issues.chromium.org/issues/40061026","https://github.com/trickest/cve/blob/e69d88e0152845fc4d4b49970ca6e503f56b2f93/2025/CVE-2025-0451.md","https://github.com/CVEProject/cvelistV5/blob/3ac44cfd6537e05d45dfec0ed67b6d47bebeee2b/cves/2025/0xxx/CVE-2025-0451.json","https://github.com/cisagov/vulnrichment/blob/917696d148c885368c24cb2bf38f1552da3d5c31/2025/0xxx/CVE-2025-0451.json","https://github.com/imSkows/Cyber-Vulnerability-Analysis-Data/blob/db26c44c5f45c25514223a46675daec7eea03092/data/first/CVE-2025-0451","https://github.com/mabitoski/cve_submodules/blob/44ad7e2705b3aef1b2ffaf64bd47596c10a6c2e4/2025/CVE-2025-0451.md","https://github.com/github/advisory-database/blob/1c8e3f4146e1bef501493d1237acb1611ea8f707/advisories/unreviewed/2025/02/GHSA-qjjm-cjhw-r68m/GHSA-qjjm-cjhw-r68m.json","https://github.com/TonneauBenjamin/ANSSI_Project/blob/f0e2d5e8be75f0351e759642d04d728399b4faa9/data/raw/mitre/CVE-2025-0451","https://github.com/Patrowl/PatrowlHearsData/blob/73cd39be077fdbedc5ca2ea7e2723723d25285cc/CVE/data/2025/CVE-2025-0451.json","https://github.com/bmwiedemann/openSUSE/blob/d8a287381c78b37aa3d10fca316ba2301f060da3/packages/c/chromium/.rev","https://github.com/DragonFlyBSD/DPorts/blob/e2f31ebea3a06041c3c693a21703388f71fe19de/security/vuxml/vuln/2025.xml"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":[],"repo_exp_urls":[],"has_poc":false,"has_exp":false,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/2025/AVE-2025-0397.toml"},{"ave_id":"AVE-2025-0393","file_name":"2025/AVE-2025-0393.toml","cve_id":"CVE-2025-0445","title":"Google Chrome V8 释放后使用漏洞","description":"Google Chrome 的 V8 JavaScript 引擎存在释放后使用（Use After Free）漏洞，CWE-416。远程攻击者可通过构造特制的 HTML 页面诱导用户访问，触发 V8 引擎对已释放内存的非法访问，导致堆破坏，进而可能造成信息泄露或任意代码执行。该漏洞影响 Chrome 133.0.6943.53 之前版本及基于 Chromium 的 Microsoft Edge 133.0.3065.51 之前版本，CVSS 评分 5.4，危害等级中危。攻击需用户交互（点击链接或访问恶意页面），无需身份认证。Google 和 Microsoft 已在 2025 年 2 月安全更新中修复。","severity":"MEDIUM","score":5.4,"aliases":["CVE-2025-0445"],"sources":["msrc"],"published":"2025-02-04T19:15:32Z","updated":"2026-06-17T08:26:29Z","remediation":"升级 Google Chrome 至 133.0.6943.53 及以上版本，或升级 Microsoft Edge (Chromium-based) 至 133.0.3065.51 及以上版本。无法立即升级时，可禁用 V8 JIT 编译（设置 --jitless 标志）作为临时缓解措施，但会影响 JavaScript 执行性能。","status":"completed","collected_at":"2026-07-27T00:00:00Z","references":["https://chromereleases.googleblog.com/2025/02/stable-channel-update-for-desktop.html","https://issues.chromium.org/issues/392521083","https://github.com/trickest/cve/blob/e69d88e0152845fc4d4b49970ca6e503f56b2f93/2025/CVE-2025-0445.md","https://github.com/CVEProject/cvelistV5/blob/3ac44cfd6537e05d45dfec0ed67b6d47bebeee2b/cves/2025/0xxx/CVE-2025-0445.json","https://github.com/cisagov/vulnrichment/blob/a4b68cf758bc6730b65b4f54ef98a7f612a68b51/2025/0xxx/CVE-2025-0445.json","https://github.com/imSkows/Cyber-Vulnerability-Analysis-Data/blob/db26c44c5f45c25514223a46675daec7eea03092/data/first/CVE-2025-0445","https://github.com/sec-dojo-com/cve-poc/blob/1c2e0105dfc8043b137c91cc2d5ac23317d19c53/pocs/2025/CVE-2025-0445.md","https://github.com/github/advisory-database/blob/1c8e3f4146e1bef501493d1237acb1611ea8f707/advisories/unreviewed/2025/02/GHSA-q4fq-38gr-ccp3/GHSA-q4fq-38gr-ccp3.json","https://github.com/TonneauBenjamin/ANSSI_Project/blob/f0e2d5e8be75f0351e759642d04d728399b4faa9/data/raw/mitre/CVE-2025-0445","https://github.com/hypnguyen1209/offensive-claude/blob/4d62be716fff90fb3249e525e8c771cf621f20c8/skills/exploit-development/references/browser-jit-uaf.md","https://github.com/Patrowl/PatrowlHearsData/blob/98f785d4de3da29b2a31131d1ba99ceeb9ee0484/CVE/data/2025/CVE-2025-0445.json","https://github.com/illuusio/freebsd-osv/blob/3234f9e67d0170ff9c6cada9a1f48f061b109728/md/2025/FreeBSD-2025-0046.md"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":[],"repo_exp_urls":[],"has_poc":false,"has_exp":false,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/2025/AVE-2025-0393.toml"},{"ave_id":"AVE-2025-0392","file_name":"2025/AVE-2025-0392.toml","cve_id":"CVE-2025-0444","title":"Google Chrome Skia 释放后使用漏洞","description":"Google Chrome（及基于 Chromium 的 Microsoft Edge）中的 Skia 图形引擎存在释放后使用（Use After Free）漏洞。远程攻击者可通过构造特制的 HTML 页面诱导用户访问，成功利用该漏洞可触发堆内存损坏，导致信息泄露、拒绝服务或潜在代码执行。该漏洞影响 Chrome 133.0.6943.53 之前版本及 Edge 133.0.3065.51 之前版本，攻击需用户交互，CVSS 评分 6.3，危害等级中危。Google 和 Microsoft 已在 2025 年 2 月安全更新中修复。","severity":"MEDIUM","score":6.3,"aliases":["CVE-2025-0444"],"sources":["msrc"],"published":"2025-02-04T19:15:32Z","updated":"2026-06-17T08:26:29Z","remediation":"立即将 Google Chrome 升级至 133.0.6943.53 或更高版本，Microsoft Edge 升级至 133.0.3065.51 或更高版本。可通过浏览器内置自动更新或访问官网下载安装。如使用 Chromium 内核的第三方浏览器，请关注厂商安全公告并及时更新。无法立即升级时，可禁用 JavaScript 解析不受信任的 HTML 页面作为临时缓解措施。","status":"completed","collected_at":"2026-07-27T00:00:00Z","references":["https://chromereleases.googleblog.com/2025/02/stable-channel-update-for-desktop.html","https://issues.chromium.org/issues/390889644","https://github.com/trickest/cve/blob/e69d88e0152845fc4d4b49970ca6e503f56b2f93/2025/CVE-2025-0444.md","https://github.com/CVEProject/cvelistV5/blob/3ac44cfd6537e05d45dfec0ed67b6d47bebeee2b/cves/2025/0xxx/CVE-2025-0444.json","https://github.com/cisagov/vulnrichment/blob/a4b68cf758bc6730b65b4f54ef98a7f612a68b51/2025/0xxx/CVE-2025-0444.json","https://github.com/imSkows/Cyber-Vulnerability-Analysis-Data/blob/db26c44c5f45c25514223a46675daec7eea03092/data/mitre/CVE-2025-0444","https://github.com/sec-dojo-com/cve-poc/blob/1c2e0105dfc8043b137c91cc2d5ac23317d19c53/pocs/2025/CVE-2025-0444.md","https://github.com/github/advisory-database/blob/1c8e3f4146e1bef501493d1237acb1611ea8f707/advisories/unreviewed/2025/02/GHSA-g9q6-f2j4-7cvg/GHSA-g9q6-f2j4-7cvg.json","https://github.com/TonneauBenjamin/ANSSI_Project/blob/f0e2d5e8be75f0351e759642d04d728399b4faa9/data/raw/mitre/CVE-2025-0444","https://github.com/Patrowl/PatrowlHearsData/blob/98f785d4de3da29b2a31131d1ba99ceeb9ee0484/CVE/data/2025/CVE-2025-0444.json","https://github.com/illuusio/freebsd-osv/blob/3234f9e67d0170ff9c6cada9a1f48f061b109728/md/2025/FreeBSD-2025-0046.md","https://github.com/bmwiedemann/openSUSE/blob/d8a287381c78b37aa3d10fca316ba2301f060da3/packages/c/chromium/.rev"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":[],"repo_exp_urls":[],"has_poc":false,"has_exp":false,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/2025/AVE-2025-0392.toml"},{"ave_id":"AVE-2025-0416","file_name":"2025/AVE-2025-0416.toml","cve_id":"CVE-2025-0938","title":"Python CPython 标准库 URL 解析器域名方括号解析差异漏洞","description":"Python 标准库 `urllib.parse` 模块中的 `urlsplit` 和 `urlparse` 函数存在输入验证缺陷，错误地允许域名中包含方括号字符，违反了 RFC 3986 规范（方括号仅应用于 IPv6/IPvFuture 地址定界）。这导致 Python URL 解析器与其他符合规范的解析器产生解析差异，攻击者可构造包含方括号的特制 URL 绕过安全检测机制（如 SSRF 防护、访问控制列表），造成安全策略失效。该漏洞影响 Python 3.x 系列版本，无需认证即可远程利用，CVSS 评分 6.3，危害等级中危。","severity":"MEDIUM","score":6.3,"aliases":["CVE-2025-0938"],"sources":["msrc"],"published":"2025-01-31T18:15:38Z","updated":"2026-06-17T08:27:24Z","remediation":"立即将 Python 升级至包含修复的版本：3.13.2 及以上、3.12.9 及以上、3.11.11 及以上、3.10.16 及以上或 3.9.21 及以上。SUSE Linux 用户可通过 zypper update python3 升级至 3.13.5。如无法立即升级，可在调用 urllib.parse.urlsplit/urlparse 前自行校验域名中不含方括号字符，或使用符合 RFC 3986 的第三方 URL 解析库作为临时缓解措施。","status":"completed","collected_at":"2026-07-27T00:00:00Z","references":["https://github.com/python/cpython/commit/526617ed68cde460236c973e5d0a8bad4de896ba","https://github.com/python/cpython/commit/90e526ae67b172ed7c6c56e7edad36263b0f9403","https://github.com/python/cpython/commit/a7084f6075c9595ba60119ce8c62f1496f50c568","https://github.com/python/cpython/commit/b8b4b713c5f8ec0958c7ef8d29d6711889bc94ab","https://github.com/python/cpython/commit/d89a5f6a6e65511a5f6e0618c4c30a7aa5aba56a","https://github.com/python/cpython/commit/ff4e5c25666f63544071a6b075ae8b25c98b7a32","https://github.com/python/cpython/issues/105704","https://github.com/python/cpython/pull/129418","https://mail.python.org/archives/list/security-announce@python.org/thread/K4EUG6EKV6JYFIC24BASYOZS4M5XOQIB/","https://lists.debian.org/debian-lts-announce/2025/03/msg00013.html","https://security.netapp.com/advisory/ntap-20250314-0002/","https://github.com/trickest/cve/blob/be44b05b9428dc18bc0705cf60dd8d8640cd49b1/2025/CVE-2025-0938.md","https://github.com/CVEProject/cvelistV5/blob/49bdd0da7f9ed7eb2c6a7d376de641a46364c00a/cves/2025/0xxx/CVE-2025-0938.json","https://github.com/fleetdm/fleet/blob/d06a4c222c31bd0369c4bdba5b59183eb3e7ec01/cmd/cve/validate/main.go","https://github.com/microsoft/azurelinux/blob/db4dceaf9bd186cb20f62c3a43615b9421200bed/specs/p/python3.6/00450-cve-2025-0938-disallow-square-brackets-and-in-domain-names-for-parsed-urls.patch","https://github.com/docker-hardened-images/advisories/blob/5008d89eb0ff6089c6e24f88f16748f0c1b8cb5b/osv/python/CVE-2025-0938.json.sha256","https://github.com/cisagov/vulnrichment/blob/e1dac7e3201a376abf5c74e8edebb6384afa032f/2025/0xxx/CVE-2025-0938.json","https://github.com/neuvector/vul-source/blob/83b6758c208f8fd7e22b7c88e002c3658ef467b8/ubuntu-cve-tracker/active/CVE-2025-0938","https://github.com/0xMarcio/cve/blob/75b5e380a041f7d82baaaae75856fe8702a1ff30/2025/CVE-2025-0938.md","https://github.com/canonical/ubuntu-security-notices/blob/bb6cd0f1a29580d840cdb570b8b0c57cc39aac6d/osv/cve/2025/UBUNTU-CVE-2025-0938.json","https://github.com/BUseclab/cve-genie/blob/71ca21d77aedec9528b8df1c6b014714cdc70067/results/reproduced_cves/CVE-2025-0938/scripts/exploit.py"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":[],"repo_exp_urls":[],"has_poc":false,"has_exp":false,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/2025/AVE-2025-0416.toml"},{"ave_id":"AVE-2025-0925","file_name":"2025/AVE-2025-0925.toml","cve_id":"CVE-2025-21683","title":"Linux 内核 BPF 模块内存泄漏漏洞","description":"Linux内核的eBPF模块中，bpf_sk_select_reuseport()函数在处理sockmap查找结果时存在引用计数错误，未能正确释放socket对象的引用计数，导致内存泄漏。当sockmap查找返回一个已处于TCP ESTABLISHED状态的socket时，该socket可能在连接建立前已通过setsockopt设置了SO_ATTACH_REUSEPORT_EBPF选项，此时sk_reuseport_cb非空但socket并未增加引用计数，函数在错误处理路径中直接返回而未释放引用，造成内核内存泄漏。该漏洞影响Linux内核，攻击者需要本地低权限用户权限，通过触发特定的BPF程序或socket操作即可复现该漏洞，长期运行可导致系统内存耗尽。CVSS 3.1评分为5.5，危害等级为中等。","severity":"MEDIUM","score":5.5,"aliases":["CVE-2025-21683"],"sources":["msrc"],"published":"2025-01-31T12:15:29Z","updated":"2026-06-17T08:44:00Z","remediation":"建议将 Linux 内核升级至以下修复版本之一：5.15.177、6.1.127、6.6.74、6.12.11 或更新版本。可通过发行版包管理器执行升级，例如 Debian/Ubuntu 使用 apt，RHEL/CentOS 使用 dnf/yum。如暂无法升级，可通过 sysctl 临时禁用 bpf_sk_select_reuseport() 相关 BPF 程序加载，或限制本地用户对 SO_ATTACH_REUSEPORT_EBPF setsockopt 的访问权限作为缓解措施。升级后请重启系统使新内核生效。","status":"completed","collected_at":"2026-08-06T00:00:00Z","references":["https://git.kernel.org/stable/c/0ab52a8ca6e156a64c51b5e7456cac9a0ebfd9bf","https://git.kernel.org/stable/c/b02e70be498b138e9c21701c2f33f4018ca7cd5e","https://git.kernel.org/stable/c/b3af60928ab9129befa65e6df0310d27300942bf","https://git.kernel.org/stable/c/bb36838dac7bb334a3f3d7eb29875593ec9473fc","https://git.kernel.org/stable/c/cccd51dd22574216e64e5d205489e634f86999f3","https://git.kernel.org/stable/c/d0a3b3d1176d39218b8edb2a2d03164942ab9ccd","https://lists.debian.org/debian-lts-announce/2025/03/msg00001.html","https://lists.debian.org/debian-lts-announce/2025/03/msg00002.html","https://cert-portal.siemens.com/productcert/html/ssa-265688.html","https://github.com/trickest/cve/blob/15eaa178baaf955987a866a2c9d91dc02a2fb4aa/2025/CVE-2025-21683.md","https://github.com/0xMarcio/cve/blob/735b7181f9cc676afd10704df69ba6e3d23ba358/2025/CVE-2025-21683.md","https://github.com/CVEProject/cvelistV5/blob/a7bcc119a9ab3b42563555b8edc8c417e3560925/cves/2025/21xxx/CVE-2025-21683.json","https://github.com/cisagov/vulnrichment/blob/5800be5111a4a9084bc37be685bd7d751f884e33/2025/21xxx/CVE-2025-21683.json","https://github.com/Patrowl/PatrowlHearsData/blob/82509eeac924c04179aa9efa2ba736077707b551/SSVC/data/2025/CVE-2025-21683.json","https://github.com/Patrowl/PatrowlHearsData/blob/82509eeac924c04179aa9efa2ba736077707b551/CVE/data/2025/CVE-2025-21683.json","https://github.com/mabitoski/cve_submodules/blob/44ad7e2705b3aef1b2ffaf64bd47596c10a6c2e4/2025/CVE-2025-21683.md","https://github.com/nomi-sec/NVD-Database/blob/23dc120c34402aaa65883c51c1d03b3cb02c20cb/2025/CVE-2025-21683.json","https://github.com/CVEProject/cve-reference-ingest-data/blob/0988da272fdff1c0478190f98ae908e713ffb42d/references/CveServices-CVE-2025-21683-2025-11-03-1453","https://github.com/CVEProject/cve-reference-ingest-data/blob/0988da272fdff1c0478190f98ae908e713ffb42d/references/CveServices-CVE-2025-21683-2025-11-03-1441"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":[],"repo_exp_urls":[],"has_poc":false,"has_exp":false,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/2025/AVE-2025-0925.toml"},{"ave_id":"AVE-2025-0924","file_name":"2025/AVE-2025-0924.toml","cve_id":"CVE-2025-21682","title":"Linux 内核 bnxt 以太网驱动空指针解引用漏洞","description":"CVE-2025-21682是一个安全漏洞，影响相关产品的安全性。攻击者可能利用此漏洞执行任意代码或获取未授权访问。建议用户及时更新到最新版本以修复此问题。","severity":"HIGH","score":7.3,"aliases":["CVE-2025-21682"],"sources":["msrc"],"published":"2025-01-31T12:15:29Z","updated":"2026-07-30T06:18:52Z","remediation":"升级 Linux 内核至修复版本：6.1.167、6.6.130、6.12.11 或 6.13-rc8 及更高版本，具体取决于所用稳定分支。如使用 Ubuntu 22.04 LTS 等长期支持发行版，请安装内核供应商提供的最新安全更新包以包含该补丁。如无法立即升级内核，可在所有使用 bnxt 驱动的网卡上禁用 XDP 功能作为临时缓解措施，执行命令 \"ip link set dev <interface> xdp off\" 并避免在 bnxt 接口上加载 XDP 程序。同时限制对系统本地控制台和物理访问权限，因为该漏洞需要本地提权权限才能触发空指针解引用崩溃。","status":"completed","collected_at":"2026-08-06T00:00:00Z","references":["https://git.kernel.org/stable/c/076a694a42ae3f0466bc6e4126050eeb7b7d299a","https://git.kernel.org/stable/c/08831a894d18abfaabb5bbde7c2069a7fb41dd93","https://git.kernel.org/stable/c/90336fc3d6f5e716ac39a9ddbbde453e23a5aa65","https://git.kernel.org/stable/c/f0aa6a37a3dbb40b272df5fc6db93c114688adcd","https://cert-portal.siemens.com/productcert/html/ssa-019113.html","https://cert-portal.siemens.com/productcert/html/ssa-082556.html","https://github.com/trickest/cve/blob/15eaa178baaf955987a866a2c9d91dc02a2fb4aa/2025/CVE-2025-21682.md","https://github.com/0xMarcio/cve/blob/735b7181f9cc676afd10704df69ba6e3d23ba358/2025/CVE-2025-21682.md","https://github.com/CVEProject/cvelistV5/blob/a7bcc119a9ab3b42563555b8edc8c417e3560925/cves/2025/21xxx/CVE-2025-21682.json","https://github.com/cisagov/vulnrichment/blob/5800be5111a4a9084bc37be685bd7d751f884e33/2025/21xxx/CVE-2025-21682.json","https://github.com/Patrowl/PatrowlHearsData/blob/82509eeac924c04179aa9efa2ba736077707b551/SSVC/data/2025/CVE-2025-21682.json","https://github.com/Patrowl/PatrowlHearsData/blob/82509eeac924c04179aa9efa2ba736077707b551/CVE/data/2025/CVE-2025-21682.json","https://github.com/mabitoski/cve_submodules/blob/44ad7e2705b3aef1b2ffaf64bd47596c10a6c2e4/2025/CVE-2025-21682.md","https://github.com/nomi-sec/NVD-Database/blob/23dc120c34402aaa65883c51c1d03b3cb02c20cb/2025/CVE-2025-21682.json","https://github.com/olbat/nvdcve/blob/336c506d8c2ab5b6ec8e55edc2021c49b3be8e2c/nvdcve/CVE-2025-21682.json","https://github.com/imSkows/Cyber-Vulnerability-Analysis-Data/blob/db26c44c5f45c25514223a46675daec7eea03092/data/first/CVE-2025-21682"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":[],"repo_exp_urls":[],"has_poc":false,"has_exp":false,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/2025/AVE-2025-0924.toml"},{"ave_id":"AVE-2025-0923","file_name":"2025/AVE-2025-0923.toml","cve_id":"CVE-2025-21681","title":"Linux kernel Open vSwitch 无限循环拒绝服务漏洞","description":"Linux 内核 Open vSwitch（OVS）子系统中存在无限循环漏洞。当网络设备正在注销（unregistering）过程中，其发送队列数归零，而 OVS 数据路径在发送数据包时未正确检查设备状态，导致 `skb_tx_hash` 函数中的哈希校验循环陷入无限循环，引发内核核心锁定。该漏洞影响使用 OVS 的 Linux 系统，攻击者无需身份认证，只要在目标设备处于注销状态时向其发送特制数据包即可触发内核死锁，系统将完全失去响应，唯一恢复方式为重启机器。","severity":"MEDIUM","score":5.5,"aliases":["CVE-2025-21681"],"sources":["msrc"],"published":"2025-01-31T12:15:29Z","updated":"2026-06-17T08:44:00Z","remediation":"立即升级 Linux 内核至包含修复的稳定版本。该漏洞位于 Open vSwitch 数据路径，当向正在注销的网络设备发送数据包时，因未同时检查设备运行状态导致内核无限循环锁死。上游修复已回移植至 6.1.127、6.6.74 及 6.12.11。主流发行版修复版本：Ubuntu 22.04 LTS HWE 内核升级至 6.8.0-64.67~22.04.1（执行 apt update && apt upgrade linux-image-hwe-6.8）；Ubuntu 24.04 LTS 升级至 6.8.0-62.65（执行 apt update && apt upgrade linux-image）；SUSE Linux Enterprise 15 应用 SUSE-SU-2025:0847-1（执行 zypper patch）。升级后必须重启系统。如暂时无法升级，可通过固定 Open vSwitch 端口配置、避免动态注销网络设备来降低触发概率。","status":"completed","collected_at":"2026-08-06T00:00:00Z","references":["https://git.kernel.org/stable/c/47e55e4b410f7d552e43011baa5be1aab4093990","https://git.kernel.org/stable/c/82f433e8dd0629e16681edf6039d094b5518d8ed","https://git.kernel.org/stable/c/87fcf0d137c770e6040ebfdb0abd8e7dd481b504","https://git.kernel.org/stable/c/930268823f6bccb697aa5d2047aeffd4a497308c","https://git.kernel.org/stable/c/b5c73fc92f8d15c16e5dc87b5c17d2abf1e6d092","https://git.kernel.org/stable/c/ea966b6698785fb9cd0fdb867acd91b222e4723f","https://git.kernel.org/stable/c/ea9e990356b7bee95440ba0e6e83cc4d701afaca","https://lists.debian.org/debian-lts-announce/2025/03/msg00001.html","https://github.com/trickest/cve/blob/15eaa178baaf955987a866a2c9d91dc02a2fb4aa/2025/CVE-2025-21681.md","https://github.com/0xMarcio/cve/blob/735b7181f9cc676afd10704df69ba6e3d23ba358/2025/CVE-2025-21681.md","https://github.com/CVEProject/cvelistV5/blob/a7bcc119a9ab3b42563555b8edc8c417e3560925/cves/2025/21xxx/CVE-2025-21681.json","https://github.com/Patrowl/PatrowlHearsData/blob/954745087cab3897c1945b517c4fc4f1575af37b/CVE/data/2025/CVE-2025-21681.json","https://github.com/mabitoski/cve_submodules/blob/44ad7e2705b3aef1b2ffaf64bd47596c10a6c2e4/2025/CVE-2025-21681.md","https://github.com/CVEProject/cve-reference-ingest-data/blob/0988da272fdff1c0478190f98ae908e713ffb42d/references/CveServices-CVE-2025-21681-2025-11-03-1441","https://github.com/nomi-sec/NVD-Database/blob/23dc120c34402aaa65883c51c1d03b3cb02c20cb/2025/CVE-2025-21681.json","https://github.com/opencve/opencve-kb/blob/1a293285bf198645eacfa1fb6bdd6757780626e5/2025/CVE-2025-21681.json","https://github.com/imSkows/Cyber-Vulnerability-Analysis-Data/blob/db26c44c5f45c25514223a46675daec7eea03092/data/first/CVE-2025-21681","https://github.com/aquasecurity/vuln-list-debian/blob/89fbba38c2d6be5ae7165c8ae7c8f3c0641ea56f/tracker/CVE/2025/CVE-2025-21681.json"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":[],"repo_exp_urls":[],"has_poc":false,"has_exp":false,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/2025/AVE-2025-0923.toml"}]
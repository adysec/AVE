://github.com/LiuCan01/cve-list-pro/blob/78b55511cee3604c22d518e32822f0435d0cacc0/cve-list/CVE-2012/CVE-2012-3601","https://github.com/canonical/ubuntu-security-notices/blob/cb915da527ff1f7ae59c6e959143aa27dc42dc24/osv/cve/2012/UBUNTU-CVE-2012-3601.json","https://github.com/canonical/ubuntu-security-notices/blob/cb915da527ff1f7ae59c6e959143aa27dc42dc24/vex/cve/2012/CVE-2012-3601.json","https://github.com/nottrobin/ubuntu-cve-tracker/blob/36e411296b5707284049ec2e0db8d2622feca498/retired/CVE-2012-3601","https://github.com/kees/ubuntu-cve-tracker/blob/66a43c37da527bc16621fb5548dca8aa1f46e537/retired/CVE-2012-3601","https://github.com/neuvector/vul-source/blob/07f0931dd35f996dbf6b1a3296eaf61225fd7563/ubuntu-cve-tracker/retired/CVE-2012-3601","https://github.com/Patrowl/PatrowlHearsData/blob/1cf21dc2c185a3301ffa683a942c44c61b3a4b1e/CVE/data/2012/CVE-2012-3601.json","https://github.com/nomi-sec/NVD-Database/blob/23dc120c34402aaa65883c51c1d03b3cb02c20cb/2012/CVE-2012-3601.json","https://github.com/eslerm/ubuntu-cve-tracker/blob/f17e5ebf7a87347cc68d8fae347d07409a857342/retired/CVE-2012-3601"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":[],"repo_exp_urls":[],"has_poc":false,"has_exp":false,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/2012/AVE-2012-0277.toml"},{"ave_id":"AVE-2012-0274","file_name":"2012/AVE-2012-0274.toml","cve_id":"CVE-2012-3598","title":"苹果 WebKit 远程代码执行漏洞","description":"WebKit 渲染引擎（存在于 Apple iTunes 10.7 之前版本中）存在内存损坏远程代码执行漏洞。未经身份认证的远程攻击者可通过构造包含恶意代码的网页，诱导用户使用受影响版本的 iTunes 打开该网页，从而触发 WebKit 引擎中的内存损坏缺陷，实现任意代码执行或导致应用程序崩溃。该漏洞影响运行 Windows 和 Mac OS X 系统的用户，攻击条件要求用户访问攻击者控制的恶意网站，利用方式为通过特制网页内容触发内存破坏，进而获得与当前用户相同的权限。","severity":"MEDIUM","score":6.8,"aliases":["CVE-2012-3598"],"sources":["tenable"],"published":"2012-09-13T10:30:18Z","updated":"2026-06-16T23:43:32Z","remediation":"建议将 iOS 设备升级至 6.0 或更高版本，Mac 上的 Safari 升级至 6.0.1 或更高版本，iTunes 升级至 10.7 或更高版本。iOS 用户可通过\"设置\"→\"通用\"→\"软件更新\"下载安装，Mac 用户通过 Mac App Store 或 Apple 官网获取 Safari 和 iTunes 最新版本。如无法立即升级，应避免在 Safari 或 iTunes 中打开未知网站或点击可疑链接，以降低被利用风险。","status":"completed","collected_at":"2026-08-05T00:00:00Z","references":["http://lists.apple.com/archives/security-announce/2012/Sep/msg00001.html","http://lists.apple.com/archives/security-announce/2012/Sep/msg00003.html","http://lists.apple.com/archives/security-announce/2012/Sep/msg00005.html","http://osvdb.org/85412","http://support.apple.com/kb/HT5485","http://support.apple.com/kb/HT5502","http://support.apple.com/kb/HT5503","https://exchange.xforce.ibmcloud.com/vulnerabilities/78534","https://oval.cisecurity.org/repository/search/definition/oval%3Aorg.mitre.oval%3Adef%3A17081","https://github.com/CVEProject/cvelistV5/blob/c67c7954c46b752d4b167913e3e046ed998744d0/cves/2012/3xxx/CVE-2012-3598.json","https://github.com/LiuCan01/cve-list-pro/blob/78b55511cee3604c22d518e32822f0435d0cacc0/cve-list/CVE-2012/CVE-2012-3598","https://github.com/canonical/ubuntu-security-notices/blob/cb915da527ff1f7ae59c6e959143aa27dc42dc24/osv/cve/2012/UBUNTU-CVE-2012-3598.json","https://github.com/canonical/ubuntu-security-notices/blob/cb915da527ff1f7ae59c6e959143aa27dc42dc24/vex/cve/2012/CVE-2012-3598.json","https://github.com/nottrobin/ubuntu-cve-tracker/blob/36e411296b5707284049ec2e0db8d2622feca498/retired/CVE-2012-3598","https://github.com/kees/ubuntu-cve-tracker/blob/66a43c37da527bc16621fb5548dca8aa1f46e537/retired/CVE-2012-3598","https://github.com/neuvector/vul-source/blob/07f0931dd35f996dbf6b1a3296eaf61225fd7563/ubuntu-cve-tracker/retired/CVE-2012-3598","https://github.com/Patrowl/PatrowlHearsData/blob/2e34647e2cb70f634f637d7ffe35fe3375a62e16/CVE/data/2012/CVE-2012-3598.json","https://github.com/nomi-sec/NVD-Database/blob/23dc120c34402aaa65883c51c1d03b3cb02c20cb/2012/CVE-2012-3598.json","https://github.com/eslerm/ubuntu-cve-tracker/blob/f17e5ebf7a87347cc68d8fae347d07409a857342/retired/CVE-2012-3598"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":[],"repo_exp_urls":[],"has_poc":false,"has_exp":false,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/2012/AVE-2012-0274.toml"},{"ave_id":"AVE-2012-0022","file_name":"2012/AVE-2012-0022.toml","cve_id":"CVE-2012-4889","title":"ManageEngine Firewall Analyzer 跨站脚本与目录遍历漏洞","description":"ManageEngine Firewall Analyzer 7.2 及 8.0 版本存在跨站脚本（XSS）漏洞。远程攻击者可通过向 createAnomaly.do、mindex.do、index2.do、syslogViewer.do 等页面的 subTab、tab、url、port 参数注入恶意 Web 脚本或 HTML 代码，当管理员查看日志时脚本被执行，导致敏感信息窃取。该漏洞影响 ManageEngine Firewall Analyzer 全系列，CVSS 评分 4.3，危害等级中危。","severity":"MEDIUM","score":4.3,"aliases":["CVE-2012-4889"],"sources":["nuclei"],"published":"2012-09-10T22:55:07Z","updated":"2026-06-16T23:45:51Z","remediation":"立即升级 ManageEngine Firewall Analyzer 至当前最新版本（12.8 或更高），该问题已在 7.2 之后的安全更新中修复。如无法升级，在 Web 服务器或反向代理层面配置输入校验规则，对 createAnomaly.do、mindex.do、index2.do、syslogViewer.do 等接口的 subTab、tab、url、port 参数进行严格过滤，拦截 HTML 标签和 JavaScript 关键字；同时在应用层对所有用户输入输出实施上下文相关的 HTML 编码转义，防止反射型 XSS 执行。","status":"completed","collected_at":"2026-07-22T00:00:00Z","references":["http://osvdb.org/80872","http://osvdb.org/80873","http://osvdb.org/80874","http://osvdb.org/80875","http://packetstormsecurity.org/files/111474/VL-437.txt","http://secunia.com/advisories/48657","http://www.securityfocus.com/bid/52841","http://www.vulnerability-lab.com/get_content.php?id=437","https://exchange.xforce.ibmcloud.com/vulnerabilities/74538","https://www.exploit-db.com/exploits/37032","https://github.com/projectdiscovery/nuclei-templates/blob/main/http/cves/2012/CVE-2012-4889.yaml","https://github.com/trickest/cve/blob/ed228d55b7972f63e700a35a54fbcd94064b9ade/2012/CVE-2012-4889.md","https://github.com/projectdiscovery/nuclei-templates/blob/efa56541ba84ae91eb0da267c473426b115491e2/http/cves/2012/CVE-2012-4889.yaml","https://github.com/sepehrdaddev/zap-scripts/blob/2b63b02ca79cc7f0023cdbab72c5c6c774354b07/active/CVE-2012-4889.js","https://github.com/rix4uni/nucleihub-templates/blob/579a0234551b9e0e322460a62dc77bd6109e4aff/nucleihub-templates/CVE-2012-4889-2216.yaml","https://github.com/fkie-cad/nvd-json-data-feeds/blob/422db14aea6c90ec23ceb3c50e97ae16c76d143d/CVE-2012/CVE-2012-48xx/CVE-2012-4889.json","https://github.com/veo/vscan/blob/1beb10c08e377e15b7dd417be1843bb75aa8c4f0/pocs_yml/nucleiFiles/cves/2012/CVE-2012-4889.yaml","https://github.com/lianqingsec/NucleiPocGather/blob/dcce204f62196117b9c95c52d8101ccf7a5d27bc/poc/cve/cve-2012-4889-2214.yaml","https://github.com/ExpLangcn/NucleiTP/blob/2b7ecb9031a6eda4f272793045f29b339d8e0cce/CVES/medium/cve-2012-4889-2216.yaml","https://github.com/exploit-io/nuclei-templates/blob/a4b7182985a6e45df346cfe45242d40455e152b5/templates/cve-2012-4889-2217.yaml","https://github.com/adampielak/nuclei-templates/blob/a2f3ff3fa5db5c7705ebd942909ec114df063700/nuclei-v3/C/CVE-2012-4889_7.yaml"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":[],"repo_exp_urls":[],"has_poc":false,"has_exp":false,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/2012/AVE-2012-0022.toml"}]
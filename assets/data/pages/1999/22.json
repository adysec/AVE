m=93923873006014&w=2"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":[],"repo_exp_urls":[],"has_poc":false,"has_exp":false,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/1999/AVE-1999-1060.toml"},{"ave_id":"AVE-1999-1988","file_name":"1999/AVE-1999-1988.toml","cve_id":"CVE-1999-1542","title":"RPMMail 远程命令执行漏洞","description":"RPMMail 1.4 之前版本存在远程代码执行漏洞，攻击者可通过向目标邮件服务器发送包含 shell 元字符的 MAIL FROM 命令的恶意邮件，触发命令注入漏洞，从而在服务器上以邮件服务进程权限执行任意系统命令。该漏洞影响 Linux 平台运行的 RPMMail 服务，CVSS 评分 10.0，危害等级严重，无需身份认证即可远程利用。","severity":"CRITICAL","score":10.0,"aliases":["CVE-1999-1542"],"sources":["avd"],"published":"1999-10-04T04:00:00Z","updated":"2026-06-16T21:50:40Z","remediation":"升级 RPMMail 至 1.4 或更高版本，该版本已修复输入校验缺陷。若无法升级，应在 MTA 层面过滤 MAIL FROM 参数中的 shell 元字符（; | & ` $ 等），或限制 RPMMail 仅监听内网接口。","status":"completed","collected_at":"2026-07-21T00:00:00Z","references":["http://marc.info/?l=bugtraq&m=93915641729415&w=2","http://marc.info/?l=bugtraq&m=93923853105687&w=2","https://exchange.xforce.ibmcloud.com/vulnerabilities/3353","https://github.com/CVEProject/cvelistV5/blob/9bf1bcd98df741ae892c1ba6b8127fb5da623fcc/cves/1999/1xxx/CVE-1999-1542.json","https://github.com/LiuCan01/cve-list-pro/blob/78b55511cee3604c22d518e32822f0435d0cacc0/cve-list/CVE-1999/CVE-1999-1542","https://github.com/yarencheng/cve-devops-playground/blob/7f1c35ad28226319c149c937b6a2e7a1986924ce/content/CVE-1999-1542.md","https://github.com/Patrowl/PatrowlHearsData/blob/84a8576323536424cfe4fe56907ba66e1ea3a744/CVE/data/1999/CVE-1999-1542.json","https://github.com/github/advisory-database/blob/9a3495eb833b3f1f2096187c4b14884afc98b67a/advisories/unreviewed/2022/04/GHSA-9wm7-qv7w-f74f/GHSA-9wm7-qv7w-f74f.json","https://github.com/olbat/nvdcve/blob/1c14ae4816efb67123e0664d061a6cbfe48f234b/nvdcve/CVE-1999-1542.json","https://github.com/KTZgraph/sarenka/blob/f1fb931ab722d6c096d581ed6e3c5966d799fbaa/sarenka/feeds/cve_details/cve_all_details_153700_153800.json","https://github.com/leego972/titanai/blob/afa5b2310463aae5781d3fd9408071bf38e79806/data/raw/corpus_D_cyber/nvd_cve_000811.txt","https://github.com/security-commits/security-patches-dataset/blob/e93fcdcc8c9b91785f962a06d66b7ee623780245/data/cve-details/year/1999.csv","https://github.com/oasis-open/cti-stix-common-objects/blob/55ba7598cbd5a52577b6887871505d931d85cb61/objects/vulnerability/vulnerability--86142d35-fed1-4d44-aeea-b5856001ce17.json"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":[],"repo_exp_urls":[],"has_poc":false,"has_exp":false,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/1999/AVE-1999-1988.toml"},{"ave_id":"AVE-1999-1173","file_name":"1999/AVE-1999-1173.toml","cve_id":"CVE-1999-1541","title":"Cactus Software Shell Lock 本地临时文件符号链接漏洞","description":"Cactus Software Shell Lock 的 shell-lock 组件在处理临时文件时存在不安全的符号链接跟随漏洞。本地攻击者可通过在目标系统上创建恶意符号链接，诱使 shell-lock 在解码受保护的 shell 脚本文件时，将内容写入或读取攻击者指定的任意文件，从而在脚本执行前窃取或篡改其中的敏感信息。该漏洞需要攻击者拥有本地系统访问权限，CVSS 评分 7.2，危害等级高危。","severity":"HIGH","score":7.2,"aliases":["CVE-1999-1541"],"sources":["avd"],"published":"1999-10-04T04:00:00Z","updated":"2026-06-16T21:50:40Z","remediation":"该产品已停止维护且无官方补丁。建议立即停止使用 Cactus Software Shell Lock，改用支持安全临时文件处理的替代工具（如 shc 或加密编译方案）。如必须继续使用，应在受控目录执行 shell-lock，并定期清理 /tmp 下可疑符号链接文件。此外，可配置系统级 umask 077 并启用 tmpfiles.d 定时清理机制作为临时缓解。","status":"completed","collected_at":"2026-07-21T00:00:00Z","references":["http://marc.info/?l=bugtraq&m=93916168802365&w=2","http://www.atstake.com/research/advisories/1999/shell-lock.txt","https://exchange.xforce.ibmcloud.com/vulnerabilities/3358","https://github.com/CVEProject/cvelistV5/blob/9bf1bcd98df741ae892c1ba6b8127fb5da623fcc/cves/1999/1xxx/CVE-1999-1541.json","https://github.com/LiuCan01/cve-list-pro/blob/78b55511cee3604c22d518e32822f0435d0cacc0/cve-list/CVE-1999/CVE-1999-1541","https://github.com/yarencheng/cve-devops-playground/blob/7f1c35ad28226319c149c937b6a2e7a1986924ce/content/CVE-1999-1541.md","https://github.com/Patrowl/PatrowlHearsData/blob/84a8576323536424cfe4fe56907ba66e1ea3a744/CVE/data/1999/CVE-1999-1541.json","https://github.com/github/advisory-database/blob/9a3495eb833b3f1f2096187c4b14884afc98b67a/advisories/unreviewed/2022/04/GHSA-hr9m-3c7j-qx9f/GHSA-hr9m-3c7j-qx9f.json","https://github.com/SpeeDr00t/speedr00t.github.com/blob/0380f0c2190556fabe90257cb6c0034a42f68951/securityfocus/0x88000/87913/info.html","https://github.com/olbat/nvdcve/blob/1c14ae4816efb67123e0664d061a6cbfe48f234b/nvdcve/CVE-1999-1541.json","https://github.com/KTZgraph/sarenka/blob/f1fb931ab722d6c096d581ed6e3c5966d799fbaa/sarenka/feeds/cve_details/cve_all_details_153700_153800.json","https://github.com/security-commits/security-patches-dataset/blob/e93fcdcc8c9b91785f962a06d66b7ee623780245/data/cve-details/year/1999.csv","https://github.com/nomi-sec/CVE-Easy-List/blob/ea1d952547221140681bbac63b918e1ec10d4d32/1999.tsv"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":[],"repo_exp_urls":[],"has_poc":false,"has_exp":false,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/1999/AVE-1999-1173.toml"},{"ave_id":"AVE-1999-1172","file_name":"1999/AVE-1999-1172.toml","cve_id":"CVE-1999-1540","title":"Let me analyze the information: - Vendor: Cactus Software - Product: Shell Lock - Vulnerability type: Weak encryption (trivial encoding) that allows attackers to easily decrypt and obtain source code - This is about source code disclosure due to weak encryption So the title should follow the format: \"厂商 产品 漏洞类型\" Cactus Software Shell Lock 弱加密导致源代码泄露漏洞 Let me think about this more carefully: - 厂商: Cactus Software（仙人掌软件） - 产品: Shell Lock - 漏洞类型: 弱加密导致源代码泄露漏洞 (weak encryption leading to source code disclosure) \"cactus software\" could be translated as \"仙人掌软件\" or kept as \"Cactus Software\". In Chinese vulnerability databases, foreign vendor names are often kept in English or mixed. Let me use a more standard Chinese format. \"Cactus Software Shell Lock 弱加密导致源代码泄露漏洞\" - this is good, but let me check the format more carefully. The example is \"Microsoft Windows TCP/IP 远程代码执行漏洞\" - so it's \"Vendor Product Vulnerability Type\" Cactus Software Shell Lock 弱加密导致源代码泄露漏洞 This seems reasonable. The vulnerability is about weak encryption (trivial encoding) that allows attackers to easily decrypt and obtain source code, which is essentially a source","description":"Cactus Software Shell Lock 是一款用于保护 Perl 脚本源代码的商业软件，但其使用的加密机制仅为简单的编码变换（弱加密），而非真正的加密算法。攻击者无需特殊权限，即可通过分析其编码逻辑轻易解码被保护的脚本，从而获取原始的源代码内容。该漏洞暴露出软件在代码保护设计上的严重缺陷，CVSS 评分 2.1，危害等级低，但会导致商业软件的核心知识产权保护失效。","severity":"LOW","score":2.1,"aliases":["CVE-1999-1540"],"sources":["avd"],"published":"1999-10-04T04:00:00Z","updated":"2026-06-16T21:50:40Z","remediation":"立即停止使用 Cactus Software Shell Lock，改用现代 shell 脚本加密工具（如 shc 配合 AES-256加密，或使用二进制编译工具打包）。该产品已停止维护且加密算法为简单编码，任何受此保护的脚本源码均应视为已泄露，需重置其中包含的凭据与密钥。","status":"completed","collected_at":"2026-07-21T00:00:00Z","references":["http://marc.info/?l=bugtraq&m=93916168802365&w=2","http://www.atstake.com/research/advisories/1999/shell-lock.txt","https://exchange.xforce.ibmcloud.com/vulnerabilities/3356","https://github.com/CVEProject/cvelistV5/blob/9bf1bcd98df741ae892c1ba6b8127fb5da623fcc/cves/1999/1xxx/CVE-1999-1540.json","https://github.com/LiuCan01/cve-list-pro/blob/78b55511cee3604c22d518e32822f0435d0cacc0/cve-list/CVE-1999/CVE-1999-1540","https://github.com/yarencheng/cve-devops-playground/blob/7f1c35ad28226319c149c937b6a2e7a1986924ce/content/CVE-1999-1540.md","https://github.com/Patrowl/PatrowlHearsData/blob/84a8576323536424cfe4fe56907ba66e1ea3a744/CVE/data/1999/CVE-1999-1540.json","https://github.com/github/advisory-database/blob/9a3495eb833b3f1f2096187c4b14884afc98b67a/advisories/unreviewed/2022/04/GHSA-c58m-4vx5-jf3r/GHSA-c58m-4vx5-jf3r.json","https://github.com/SpeeDr00t/speedr00t.github.com/blob/0380f0c2190556fabe90257cb6c0034a42f68951/securityfocus/0x88000/87921/info.html","https://github.com/olbat/nvdcve/blob/1c14ae4816efb67123e0664d061a6cbfe48f234b/nvdcve/CVE-1999-1540.json","https://github.com/KTZgraph/sarenka/blob/f1fb931ab722d6c096d581ed6e3c5966d799fbaa/sarenka/feeds/cve_details/cve_all_details_153700_153800.json","https://github.com/security-commits/security-patches-dataset/blob/e93fcdcc8c9b91785f962a06d66b7ee623780245/data/cve-details/year/1999.csv","https://github.com/nomi-sec/CVE-Easy-List/blob/ea1d952547221140681bbac63b918e1ec10d4d32/1999.tsv"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":[],"repo_exp_urls":[],"has_poc":false,"has_exp":false,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/1999/AVE-1999-1172.toml"},{"ave_id":"AVE-1999-1159","file_name":"1999/AVE-1999-1159.toml","cve_id":"CVE-1999-1523","title":"Sambar Web Server 4.2.1 远程代码执行漏洞","description":"Sambar Web Server 4.2.1 存在缓冲区溢出漏洞。远程攻击者无需身份认证，通过向目标服务器发送特制的超长 HTTP GET 请求即可触发该漏洞，导致服务器崩溃拒绝服务，甚至可能造成远程代码执行。该漏洞原理为服务器在处理畸形输入时未正确检查边界条件，导致内存损坏。","severity":"HIGH","score":7.5,"aliases":["CVE-1999-1523"],"sources":["avd"],"published":"1999-10-04T04:00:00Z","updated":"2026-06-16T21:50:37Z","remediation":"Sambar Web Server 已停止维护多年，不存在官方补丁。建议立即停止使用 Sambar 4.2.1 及更低版本，迁移至活跃维护的 Web 服务器（如 Apache httpd 或 Nginx）。若暂时无法迁移，可在 Web 服务器前端部署反向代理并配置 WAF 规则过滤超长 GET 请求以缓解风险。","status":"completed","collected_at":"2026-07-21T00:00:00Z","references":["http://marc.info/?l=bugtraq&m=93901161727373&w=2","http://marc.info/?l=bugtraq&m=93941351229256&w=2","https://exchange.xforce.ibmcloud.com/vulnerabilities/1672","https://github.com/CVEProject/cvelistV5/blob/4441343672f486c63736487674c197dfd2a4f256/cves/1999/1xxx/CVE-1999-1523.json","https://github.com/LiuCan01/cve-list-pro/blob/78b55511cee3604c22d518e32822f0435d0cacc0/cve-list/CVE-1999/CVE-1999-1523","https://github.com/yarencheng/cve-devops-playground/blob/7f1c35ad28226319c149c937b6a2e7a1986924ce/content/CVE-1999-1523.md","https://github.com/Patrowl/PatrowlHearsData/blob/81cdfffcd86317dec05d7dfba407f93d96d91273/CVE/data/1999/CVE-1999-1523.json","https://github.com/github/advisory-database/blob/9a3495eb833b3f1f2096187c4b14884afc98b67a/advisories/unreviewed/2022/04/GHSA-8977-643f-9jf5/GHSA-8977-643f-9jf5.json","https://github.com/SpeeDr00t/speedr00t.github.com/blob/0380f0c2190556fabe90257cb6c0034a42f68951/securityfocus/0x88000/87909/info.html","https://github.com/olbat/nvdcve/blob/1c14ae4816efb67123e0664d061a6cbfe48f234b/nvdcve/CVE-1999-1523.json","https://github.com/KTZgraph/sarenka/blob/f1fb931ab722d6c096d581ed6e3c5966d799fbaa/sarenka/feeds/cve_details/cve_all_details_153700_153800.json","https://github.com/leego972/titanai/blob/afa5b2310463aae5781d3fd9408071bf38e79806/data/raw/corpus_D_cyber/nvd_cve_000808.txt","https://github.com/security-commits/security-patches-dataset/blob/e93fcdcc8c9b91785f962a06d66b7ee623780245/data/cve-details/year/1999.csv"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":[],"repo_exp_urls":[],"has_poc":false,"has_exp":false,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/1999/AVE-1999-1159.toml"},{"ave_id":"AVE-1999-1112","file_name":"1999/AVE-1999-1112.toml","cve_id":"CVE-1999-1454","title":"Macromedia The Matrix 屏幕保护程序安全绕过漏洞","description":"Macromedia 公司开发的 \"The Matrix\" 屏幕保护程序在 Windows 95 系统中存在安全绕过漏洞。当系统启用了\"密码保护\"选项后，具有物理访问权限的攻击者只需按下键盘上的 ESC（Escape）键即可绕过密码验证界面，直接进入系统桌面。该漏洞利用方式简单，无需任何工具或特殊技能，攻击者仅需物理接触目标计算机即可完成绕过。严重影响受感染系统的机密性和完整性。","severity":"MEDIUM","score":4.6,"aliases":["CVE-1999-1454"],"sources":["avd"],"published":"1999-10-04T04:00:00Z","updated":"2026-06-16T21:50:28Z","remediation":"建议卸载 \"The Matrix\" 屏幕保护程序，改用 Windows 自带的密码保护屏保。如必须使用，请勿启用其密码保护功能，改为通过系统级安全措施（如 BIOS 开机密码、屏幕自动锁定）限制物理访问。长期方案是升级至受支持的操作系统（如 Windows 10/11），Windows 95 已停止安全更新多年。","status":"completed","collected_at":"2026-07-20T00:00:00Z","references":["http://marc.info/?l=bugtraq&m=93915027622690&w=2","https://github.com/CVEProject/cvelistV5/blob/4035b63c9f7b02a7407eb5dd431d3b6ffb26cebc/cves/1999/1xxx/CVE-1999-1454.json","https://github.com/LiuCan01/cve-list-pro/blob/78b55511cee3604c22d518e32822f0435d0cacc0/cve-list/CVE-1999/CVE-1999-1454","https://github.com/yarencheng/cve-devops-playground/blob/470a5f1c0d1bd36cd0a6327cda49cf96a1474588/content/CVE-1999-1454.md","https://github.com/Patrowl/PatrowlHearsData/b
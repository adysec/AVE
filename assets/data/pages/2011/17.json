-player-110209.nasl","https://github.com/kees/ubuntu-cve-tracker/blob/66a43c37da527bc16621fb5548dca8aa1f46e537/retired/CVE-2011-0571","https://github.com/RogoLabs/consensus-engine/blob/f09caa3ae3bd523ded47798246ed2d0175019dae/docs/data/2011/CVE-2011-0560.json","https://github.com/gentoo-mirror/gentoo/blob/11eb3781112e7224d6c9a6827b93963c33511dcb/metadata/glsa/glsa-201110-11.xml"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":[],"repo_exp_urls":[],"has_poc":false,"has_exp":false,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/2011/AVE-2011-0032.toml"},{"ave_id":"AVE-2011-0031","file_name":"2011/AVE-2011-0031.toml","cve_id":"CVE-2011-0559","title":"Adobe Flash Player ActionScript方法内存破坏远程代码执行漏洞","description":"Adobe Flash Player 10.2.152.26之前版本中存在内存破坏漏洞，远程攻击者通过向未指定的ActionScript方法传递特制参数，导致该参数被用作对象指针，从而触发内存破坏，成功利用可导致远程代码执行或拒绝服务。攻击者无需身份认证即可通过网络远程触发该漏洞，影响范围广泛。Adobe已在安全更新中修复此漏洞。","severity":"CRITICAL","score":9.3,"aliases":["CVE-2011-0559"],"sources":["tenable"],"published":"2011-02-10T16:00:32Z","updated":"2026-06-16T23:27:37Z","remediation":"立即升级 Adobe Flash Player 至 10.2.152.26 或更高版本。对于无法升级的环境，可在浏览器中禁用 Flash 插件或卸载 Flash Player。由于 Adobe 已于 2020 年 12 月 31 日停止对 Flash Player 的支持，建议彻底移除 Flash 组件并迁移至 HTML5 方案。","status":"completed","collected_at":"2026-07-27T00:00:00Z","references":["http://blogs.sun.com/security/entry/multiple_vulnerabilities_in_adobe_flash2","http://labs.idefense.com/intelligence/vulnerabilities/display.php?id=894","http://lists.opensuse.org/opensuse-security-announce/2011-02/msg00003.html","http://secunia.com/advisories/43267","http://secunia.com/advisories/43292","http://secunia.com/advisories/43340","http://secunia.com/advisories/43351","http://secunia.com/advisories/43747","http://www.adobe.com/support/security/bulletins/apsb11-02.html","http://www.redhat.com/support/errata/RHSA-2011-0206.html","http://www.redhat.com/support/errata/RHSA-2011-0259.html","http://www.redhat.com/support/errata/RHSA-2011-0368.html","http://www.securityfocus.com/bid/46186","http://www.securitytracker.com/id?1025055","http://www.vupen.com/english/advisories/2011/0348","http://www.vupen.com/english/advisories/2011/0383","http://www.vupen.com/english/advisories/2011/0402","http://www.vupen.com/english/advisories/2011/0646","https://oval.cisecurity.org/repository/search/definition/oval%3Aorg.mitre.oval%3Adef%3A14009","https://oval.cisecurity.org/repository/search/definition/oval%3Aorg.mitre.oval%3Adef%3A16231","https://github.com/trickest/cve/blob/be44b05b9428dc18bc0705cf60dd8d8640cd49b1/2011/CVE-2011-0559.md","https://github.com/CVEProject/cvelistV5/blob/cc838d0e5ff34a3026c5292897b23b79aee8bacf/cves/2011/0xxx/CVE-2011-0559.json","https://github.com/edoardottt/missing-cve-nuclei-templates/blob/b93b72c800b93d13fcc97984485ecaf9a9b5cbc1/data/year/2011.txt","https://github.com/github/advisory-database/blob/c55392b715d0e2e1caa8bc26997a940be7494a13/advisories/unreviewed/2022/05/GHSA-27jx-2xcq-7549/GHSA-27jx-2xcq-7549.json","https://github.com/xqcyberscore/nvt/blob/978f6a9acb495d7d669239530ffe6da5d631f4da/2011/gb_suse_2011_011.nasl","https://github.com/LiuCan01/cve-list-pro/blob/78b55511cee3604c22d518e32822f0435d0cacc0/cve-list/CVE-2011/CVE-2011-0574","https://github.com/nottrobin/ubuntu-cve-tracker/blob/36e411296b5707284049ec2e0db8d2622feca498/retired/CVE-2011-0607","https://github.com/blackhook/nessus-plugins/blob/64177d96abbb07c58cf7e131046b067ebc61fcb5/S/suse_flash-player-7332.nasl","https://github.com/kees/ubuntu-cve-tracker/blob/66a43c37da527bc16621fb5548dca8aa1f46e537/retired/CVE-2011-0578","https://github.com/RogoLabs/consensus-engine/blob/f09caa3ae3bd523ded47798246ed2d0175019dae/docs/data/2011/CVE-2011-0559.json"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":[],"repo_exp_urls":[],"has_poc":false,"has_exp":false,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/2011/AVE-2011-0031.toml"},{"ave_id":"AVE-2011-0030","file_name":"2011/AVE-2011-0030.toml","cve_id":"CVE-2011-0558","title":"Adobe Flash Player 整数溢出远程代码执行漏洞","description":"Adobe Flash Player 10.2.152.26 之前版本中存在整数溢出漏洞。攻击者通过构造包含超长数组长度值的 ActionScript Function 类方法，在处理过程中触发整数溢出，导致内存破坏，从而可实现远程代码执行。攻击者只需诱使用户访问包含恶意 SWF 文件的网页即可触发该漏洞，无需其他认证条件。该漏洞影响 Adobe Flash Player 10.2.152.26 及更早版本，CVSS 评分 9.3，危害等级严重。Adobe 已在 2011 年 2 月发布安全更新修复此漏洞。","severity":"CRITICAL","score":9.3,"aliases":["CVE-2011-0558"],"sources":["tenable"],"published":"2011-02-10T16:00:32Z","updated":"2026-06-16T23:27:37Z","remediation":"立即升级 Adobe Flash Player 至 10.2.152.26 或更高版本；使用 Google Chrome 的用户应升级至 9.0.597.94 或更高版本。如无法立即升级，可在浏览器中禁用 Flash 插件或通过组策略限制 Flash 内容执行作为临时缓解措施。","status":"completed","collected_at":"2026-07-27T00:00:00Z","references":["http://blogs.sun.com/security/entry/multiple_vulnerabilities_in_adobe_flash2","http://labs.idefense.com/intelligence/vulnerabilities/display.php?id=893","http://lists.opensuse.org/opensuse-security-announce/2011-02/msg00003.html","http://secunia.com/advisories/43267","http://secunia.com/advisories/43292","http://secunia.com/advisories/43340","http://secunia.com/advisories/43351","http://secunia.com/advisories/43747","http://www.adobe.com/support/security/bulletins/apsb11-02.html","http://www.redhat.com/support/errata/RHSA-2011-0206.html","http://www.redhat.com/support/errata/RHSA-2011-0259.html","http://www.redhat.com/support/errata/RHSA-2011-0368.html","http://www.securityfocus.com/bid/46194","http://www.securitytracker.com/id?1025055","http://www.vupen.com/english/advisories/2011/0348","http://www.vupen.com/english/advisories/2011/0383","http://www.vupen.com/english/advisories/2011/0402","http://www.vupen.com/english/advisories/2011/0646","https://exchange.xforce.ibmcloud.com/vulnerabilities/65230","https://oval.cisecurity.org/repository/search/definition/oval%3Aorg.mitre.oval%3Adef%3A14056","https://oval.cisecurity.org/repository/search/definition/oval%3Aorg.mitre.oval%3Adef%3A16129","https://github.com/trickest/cve/blob/be44b05b9428dc18bc0705cf60dd8d8640cd49b1/2011/CVE-2011-0558.md","https://github.com/CVEProject/cvelistV5/blob/cc838d0e5ff34a3026c5292897b23b79aee8bacf/cves/2011/0xxx/CVE-2011-0558.json","https://github.com/LiuCan01/cve-list-pro/blob/78b55511cee3604c22d518e32822f0435d0cacc0/cve-list/CVE-2011/CVE-2011-0558","https://github.com/nottrobin/ubuntu-cve-tracker/blob/36e411296b5707284049ec2e0db8d2622feca498/retired/CVE-2011-0558","https://github.com/Patrowl/PatrowlHearsData/blob/ad8af7b6d55e05f22d7ff67c808ccd8d54c89d32/CVE/data/2011/CVE-2011-0558.json","https://github.com/fkie-cad/COMIDDS/blob/33558552a989a4ffe899d371125fbcad2d8d84ac/content/datasets/vast_2011.md","https://github.com/xqcyberscore/nvt/blob/978f6a9acb495d7d669239530ffe6da5d631f4da/2011/gb_suse_2011_011.nasl","https://github.com/yarencheng/cve-devops-playground/blob/c54e59752dddfc9aa36c13774164384cfa0d1f04/content/CVE-2011-0558.md","https://github.com/blackhook/nessus-plugins/blob/64177d96abbb07c58cf7e131046b067ebc61fcb5/S/solaris10_125332.nasl","https://github.com/DragonFlyBSD/DPorts/blob/e2f31ebea3a06041c3c693a21703388f71fe19de/security/vuxml/vuln/2011.xml"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":[],"repo_exp_urls":[],"has_poc":false,"has_exp":false,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/2011/AVE-2011-0030.toml"},{"ave_id":"AVE-2011-0002","file_name":"2011/AVE-2011-0002.toml","cve_id":"CVE-2011-0049","title":"Majordomo Majordomo 2 目录遍历漏洞","description":"Majordomo 2 在 20110131 之前的版本中，lib/Majordomo.pm 文件的 _list_file_get 函数存在目录遍历漏洞。由于该函数未对用户输入中的文件路径进行充分过滤，远程攻击者可借助 help 命令中携带的\"..\"（点点）路径序列读取服务器上的任意文件。攻击条件为：攻击者无需身份认证，可通过发送特制的电子邮件，或经由 Web 接口中的 cgi-bin/mj_wwwusr 页面提交恶意请求来触发该漏洞。受影响范围为 Majordomo 2 早于 20110131 的所有版本，可能造成敏感文件（如配置文件、口令文件等）泄露，危害中等。","severity":"MEDIUM","score":5.0,"aliases":["CVE-2011-0049"],"sources":["nuclei"],"published":"2011-02-04T01:00:07Z","updated":"2026-06-16T23:26:41Z","remediation":"升级 Majordomo 至 2011-01-31 及之后版本（Majordomo 2.0 及以上修复版），从官方源码仓库获取并重新部署 lib/Majordomo.pm。如暂时无法升级，应限制 cgi-bin/mj_wwwusr 网络接口的访问来源（如 Web 服务器 ACL 或防火墙仅允许可信 IP），并禁用或过滤 help 命令中传入的“../”路径遍历字符，作为临时缓解措施。","status":"completed","collected_at":"2026-07-15T00:00:00Z","references":["http://osvdb.org/70762","http://secunia.com/advisories/43125","http://securityreason.com/securityalert/8061","http://www.exploit-db.com/exploits/16103","http://www.kb.cert.org/vuls/id/363726","http://www.securityfocus.com/archive/1/516150/100/0/threaded","http://www.securityfocus.com/bid/46127","http://www.securitytracker.com/id?1025024","http://www.vupen.com/english/advisories/2011/0288","https://bug628064.bugzilla.mozilla.org/attachment.cgi?id=506481","https://bugzilla.mozilla.org/show_bug.cgi?id=628064","https://exchange.xforce.ibmcloud.com/vulnerabilities/65113","https://sitewat.ch/en/Advisory/View/1","https://github.com/projectdiscovery/nuclei-templates/blob/main/http/cves/2011/CVE-2011-0049.yaml","https://github.com/trickest/cve/blob/8600ac0c091970175de0b53d9682f50858aef8dc/2011/CVE-2011-0049.md","https://github.com/projectdiscovery/nuclei-templates/blob/6bfef5eb290cbfeb2b2cb4d2bae8e5cab0243137/http/cves/2011/CVE-2011-0049.yaml","https://github.com/ExpLangcn/NucleiTP/blob/2b7ecb9031a6eda4f272793045f29b339d8e0cce/CVES/high/cve-2011-0049-2040.yaml","https://github.com/sepehrdaddev/zap-scripts/blob/2b63b02ca79cc7f0023cdbab72c5c6c774354b07/active/CVE-2011-0049.js","https://github.com/cckuailong/reapoc/blob/699762e4c31d0183733f64313d8fc3be6470bd37/2011/CVE-2011-0049/poc/nuclei/CVE-2011-0049.yaml","https://github.com/adampielak/nuclei-templates/blob/ac9605f5a915670fd80cb4e1904f4435f1835b65/nuclei-v3/C/CVE-2011-0049_4.yaml","https://github.com/exploit-io/nuclei-templates/blob/a4b7182985a6e45df346cfe45242d40455e152b5/templates/cve-2011-0049-2036.yaml","https://github.com/rix4uni/nucleihub-templates/blob/579a0234551b9e0e322460a62dc77bd6109e4aff/nucleihub-templates/CVE-2011-0049-2036.yaml","https://github.com/openctibr/threatFeeds/blob/ad98898aca7860353055ea2aee0af12336215af4/ExploitableVulnerabilitiesFeed.txt","https://github.com/jas502n/nmap-zh/blob/968f1f4ccb968c214ca1fa0414ba5023c9345ec2/nmap-7.70/scripts/http-majordomo2-dir-traversal.nse"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":[],"repo_exp_urls":[],"has_poc":false,"has_exp":false,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/2011/AVE-2011-0002.toml"},{"ave_id":"AVE-2011-0058","file_name":"2011/AVE-2011-0058.toml","cve_id":"CVE-2011-0720","title":"Plone 未授权访问与权限提升漏洞","description":"Plone（基于 Zope 构建的内容管理系统）在 2.5 至 4.0 版本中存在未正确实施身份认证的漏洞。由于 Zope 将 Python 对象及其方法映射为 URL 时，未对部分敏感管理方法施加必要的权限限制，导致远程攻击者无需任何认证即可通过直接访问特定 URL，获取管理员权限、读取或创建任意内容、修改站点皮肤。攻击者可利用该漏洞完全控制受影响系统，危害严重。","severity":"HIGH","score":7.5,"aliases":["CVE-2011-0720"],"sources":["tenable"],"published":"2011-02-03T17:00:03Z","updated":"2026-06-16T23:27:56Z","remediation":"将 Plone 升级至 4.0.1 或更高版本（官方已在该版本中修复未授权访问问题）。如使用 Red Hat 发行版中的 Conga/luci 组件，请安装 RHSA-2011:0393 或 RHSA-2011:0394 提供的更新包。临时缓解措施：在反向代理层限制对 Plone 管理端口的访问，仅允许可信 IP 访问 /manage、/portal_*/ 等敏感路径。","status":"completed","collected_at":"2026-07-27T00:00:00Z","references":["http://osvdb.org/70753","http://plone.org/products/plone/security/advisories/cve-2011-0720","http://secunia.com/advisories/43146","http://secunia.com/advisories/43914","http://www.redhat.com/support/errata/RHSA-2011-0393.html","http://www.redhat.com/support/errata/RHSA-2011-0394.html","http://www.securityfocus.com/bid/46102","http://www.securitytracker.com/id?1025258","http://www.vupen.com/english/advisories/2011/0796","https://exchange.xforce.ibmcloud.com/vulnerabilities/65099","https://github.com/CVEProject/cvelistV5/blob/487ea3f21ed49470634e758e1f8f2ac74b64d6b0/cves/2011/0xxx/CVE-2011-0720.json","https://github.com/Patrowl/PatrowlHearsData/blob/6052148b71cb79d42fd4a59f87982387b0487834/GHSA/data/2011/CVE-2011-0720.json","https://github.com/Patrowl/PatrowlHearsData/blob/6052148b71cb79d42fd4a59f87982387b0487834/CVE/data/2011/CVE-2011-0720.json","https://github.com/LiuCan01/cve-list-pro/blob/78b55511cee3604c22d518e32822f0435d0cacc0/cve-list/CVE-2011/CVE-2011-0720","https://github.com/Tabll/gemnasium-db/blob/7dd233fee5478e00f4ef27fbd6512a0d682c777d/pypi/Plone/CVE-2011-0720.yml","https://github.com/nomi-sec/NVD-Database/blob/23dc120c34402aaa65883c51c1d03b3cb02c20cb/2011/CVE-2011-0720.json","https://github.com/olbat/nvdcve/blob/add906b6a8ba20fd533c6fdd7f023c73e6090f3a/nvdcve/CVE-2011-0720.json","https://github.com/opencve/opencve-kb/blob/3a9acb85c323f70b3c41e59a73040cf73e226b4d/2011/CVE-2011-0720.json","https://github.com/fkie-cad/nvd-json-data-feeds/blob/4aa573a753d6387eff023ebcf6fc6297b912048e/CVE-2011/CVE-2011-07xx/CVE-2011-0720.json","https://github.com/aquasecurity/vuln-list-debian/blob/fd43b13f8510d28cd81479b29ef47ac56748619c/tracker/CVE/2011/CVE-2011-0720.json"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":["https://raw.githubusercontent.com/adysec/AVE/main/pocs/2011/POC-AVE-2011-0058.toml"],"repo_exp_urls":["https://raw.githubusercontent.com/adysec/AVE/main/exploits/2011/EXP-AVE-2011-0058.toml"],"has_poc":true,"has_exp":true,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/2011/AVE-2011-0058.toml"},{"ave_id":"AVE-2011-0061","file_name":"2011/AVE-2011-0061.toml","cve_id":"CVE-2011-0755","title":"PHP mt_rand函数整数溢出漏洞","description":"PHP 5.3.4 之前版本中的 mt_rand 函数存在整数溢出漏洞。当应用程序向 mt_rand 函数传递超过 mt_getrandmax() 返回值的超大 max 参数时，会触发整数溢出，导致随机数生成范围被意外截断，使得攻击者能够更容易预测后续随机数返回值。该漏洞降低了随机数的不可预测性，可能被利用于绕过依赖随机数的安全机制（如 CSRF token 生成、密码重置令牌等），影响 PHP 5.3.0 至 5.3.3 版本。攻击者无需身份认证即可远程利用，但需要目标应用使用了可控的 max 参数调用 mt_rand 函数。","severity":"MEDIUM","score":5.0,"aliases":["CVE-2011-0755"],"sources":["tenable"],"published":"2011-02-02T22:00:02Z","updated":"2026-06-16T23:28:00Z","remediation":"升级 PHP 至 5.3.4 或更高版本，该版本已修复 mt_rand 函数中因大参数导致的整数溢出问题。如无法立即升级，可在调用 mt_rand 时限制 max 参数不超过 mt_getrandmax() 返回值，避免传入超出范围的数值。","status":"completed","collected_at":"2026-07-27T00:00:00Z","references":["http://bugs.php.net/46587","http://www.php.net/ChangeLog-5.php","https://exchange.xforce.ibmcloud.com/vulnerabilities/65426","https://oval.cisecurity.org/repository/search/definition/oval%3Aorg.mitre.oval%3Adef%3A12589","https://github.com/CVEProject/cvelistV5/blob/487ea3f21ed49470634e758e1f8f2ac74b64d6b0/cves/2011/0xxx/CVE-2011-0755.json","https://github.com/LiuCan01/cve-list-pro/blob/78b55511cee3604c22d518e32822f0435d0cacc0/cve-list/CVE-2011/CVE-2011-0755","https://github.com/nottrobin/ubuntu-cve-tracker/blob/36e411296b5707284049ec2e0db8d2622feca498/ignored/CVE-2011-0755","https://github.com/neuvector/vul-source/blob/ada0c6c45d02a82e11f6f46403716f0946c37f98/ubuntu-cve-tracker/retired/CVE-2011-0755","https://github.com/Patrowl/PatrowlHearsData/blob/6052148b71cb79d42fd4a59f87982387b0487834/CVE/data/2011/CVE-2011-0755.json","https://github.com/opencve/opencve-kb/blob/9382985b1487c13b41847f6783f502ebface6ca6/2011/CVE-2011-0755.json","https://github.com/nomi-sec/NVD-Database/blob/23dc120c34402aaa65883c51c1d03b3cb02c20cb/2011/CVE-2011-0755.json","https://github.com/eslerm/ubuntu-cve-tracker/blob/f17e5ebf7a87347cc68d8fae347d07409a857342/retired/CVE-2011-0755","https://github.com/aquasecurity/vuln-list-debian/blob/fd43b13f8510d28cd81479b29ef47ac56748619c/tracker/CVE/2011/CVE-2011-0755.json","https://github.com/CyberSecAI/cve_info/blob/03b7e36424574a3a9ba5fd13480a326b666a1046/2011/0xxx/CVE-2011-0755.json"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":[],"repo_exp_urls":[],"has_poc":false,"has_exp":false,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/2011/AVE-2011-0061.toml"},{"ave_id":"AVE-2011-0060","file_name":"2011/AVE-2011-0060.toml","cve_id":"CVE-2011-0754","title":"PHP SPL扩展SplFileInfo::getType符号链接处理漏洞","description":"PHP 5.3.4 之前版本的 Standard PHP Library (SPL) 扩展中 SplFileInfo::getType 函数在 Windows 平台上未能正确检测符号链接，由于缺少 FILE_ATTRIBUTE_REPARSE_POINT 检查，导致 stat 结构存在跨平台差异。本地攻击者可利用此漏洞发起符号链接攻击，通过创建恶意符号链接诱导目标程序访问并操作非预期文件，从而造成敏感信息泄露、权限提升或文件破坏。攻击者需要具备本地系统访问权限，利用难度中等。","severity":"MEDIUM","score":4.4,"aliases":["CVE-2011-0754"],"sources":["tenable"],"published":"2011-02-02T22:00:02Z","updated":"2026-06-16T23:28:00Z","remediation":"升级 PHP 至 5.3.4 或更高版本。Windows 环境下，SplFileInfo::getType 函数在 5.3.4 之前无法正确检测符号链接，攻击者可利用跨平台 stat 结构差异实施符号链接攻击。建议立即更新 PHP 版本，并在 Windows 服务器上启用 FILE_ATTRIBUTE_REPARSE_POINT 检查机制。如无法升级，可通过禁用 SPL 扩展中涉及符号链接解析的功能作为临时缓解措施。","status":"completed","collected_at":"2026-07-27T00:00:00Z","references":["http://bugs.php.net/51763","http://www.php.net/ChangeLog-5.php","https://exchange.xforce.ibmcloud.com/vulnerabilities/65429","https://oval.cisecurity.org/repository/search/definition/oval%3Aorg.mitre.oval%3Adef%3A12334","https://github.com/CVEProject/cvelistV5/blob/487ea3f21ed49470634e758e1f8f2ac74b64d6b0/cves/2011/0xxx/CVE-2011-0754.json","https://github.com/LiuCan01/cve-list-pro/blob/78b55511cee3604c22d518e32822f0435d0cacc0/cve-list/CVE-2011/CVE-2011-0754","https://github.com/nottrobin/ubuntu-cve-tracker/blob/36e411296b5707284049ec2e0db8d2622feca498/retired/CVE-2011-0754","https://github.com/neuvector/vul-source/blob/ada0c6c45d02a82e11f6f46403716f0946c37f98/ubuntu-cve-tracker/retired/CVE-2011-0754","https://github.com/Patrowl/PatrowlHearsData/blob/6052148b71cb79d42fd4a59f87982387b0487834/CVE/data/2011/CVE-2011-0754.json","https://github.com/nomi-sec/NVD-Database/blob/23dc120c34402aaa65883c51c1d03b3cb02c20cb/2011/CVE-2011-0754.json","https://github.com/eslerm/ubuntu-cve-tracker/blob/f17e5ebf7a87347cc68d8fae347d07409a857342/retired/CVE-2011-0754","https://github.com/aquasecurity/vuln-list-debian/blob/fd43b13f8510d28cd81479b29ef47ac56748619c/tracker/CVE/2011/CVE-2011-0754.json","https://github.com/CyberSecAI/cve_info/blob/03b7e36424574a3a9ba5fd13480a326b666a1046/2011/0xxx/CVE-2011-0754.json","https://github.com/olbat/nvdcve/blob/add906b6a8ba20fd533c6fdd7f023c73e6090f3a/nvdcve/CVE-2011-0754.json"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":[],"repo_exp_urls":[],"has_poc":false,"has_exp":false,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/2011/AVE-2011-0060.toml"}]
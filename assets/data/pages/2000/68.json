.com/yarencheng/cve-devops-playground/blob/cbe73d6bdcced13ea57f08566d6bbf5345864f7e/content/CVE-2000-0361.md","https://github.com/Patrowl/PatrowlHearsData/blob/800f04b3cfadd1b9ab0343f5b9acd785dbc1e953/CVE/data/2000/CVE-2000-0361.json","https://github.com/github/advisory-database/blob/b21976b5bf1b11783559cbe4f375f11636b79518/advisories/unreviewed/2022/04/GHSA-3p92-jw9p-xx95/GHSA-3p92-jw9p-xx95.json","https://github.com/intSpLoiT/intframework/blob/eabaa799d0260aa52b735fa9769266d1ce4b64ef/modules/cve_list.txt","https://github.com/olbat/nvdcve/blob/5b92f5917a4a825187ccaac594f43456a77ea8f3/nvdcve/CVE-2000-0361.json","https://github.com/KTZgraph/sarenka/blob/f1fb931ab722d6c096d581ed6e3c5966d799fbaa/sarenka/feeds/cve_details/cve_all_details_154000_154100.json","https://github.com/security-commits/security-patches-dataset/blob/e93fcdcc8c9b91785f962a06d66b7ee623780245/data/cve-details/year/1999.csv","https://github.com/leego972/titanai/blob/afa5b2310463aae5781d3fd9408071bf38e79806/data/raw/corpus_D_cyber/nvd_cve_000938.txt"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":["https://raw.githubusercontent.com/adysec/AVE/main/pocs/2000/POC-AVE-2000-0372.toml"],"repo_exp_urls":[],"has_poc":true,"has_exp":false,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/2000/AVE-2000-0372.toml"},{"ave_id":"AVE-2000-0054","file_name":"2000/AVE-2000-0054.toml","cve_id":"CVE-2000-0068","title":"英特尔 InBusiness E-mail Station daynad 授权问题漏洞","description":"英特尔 InBusiness 电子邮件站的 daynad 程序存在授权验证缺失漏洞，远程攻击者无需任何认证即可通过网络访问该服务，进而修改设备配置、删除服务器文件或读取邮件内容。该漏洞影响英特尔 InBusiness E-mail Station 相关版本，CVSS 评分 7.5，危害等级高。厂商已发布安全公告，建议用户升级固件或限制网络访问。","severity":"HIGH","score":7.5,"aliases":["CVE-2000-0068"],"sources":["avd"],"published":"1999-12-14T05:00:00.000","updated":"2026-06-16T21:50:56.083","remediation":"Intel InBusiness E-mail Station 已停止技术支持，建议立即迁移至受支持的邮件服务器方案（如 Exchange 或 Postfix）；对于仍在使用该设备的场景，须在网络防火墙上严格限制对 daynad 端口（默认 63/TCP）的访问来源，仅允许受信任管理 IP 连接，并隔离该设备至独立 VLAN。","status":"completed","collected_at":"202
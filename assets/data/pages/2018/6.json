[{"ave_id":"AVE-2018-0078","file_name":"2018/AVE-2018-0078.toml","cve_id":"CVE-2018-13317","title":"TOTOLINK A3002RU 路由器密码泄露漏洞","description":"tags.<value>TOTOLINK A3002RU 固件 v1.0.8 的 password.htm 页面存在密码明文泄露漏洞，攻击者无需身份认证即可通过发送 GET 请求访问该页面，直接获取管理员用户的明文密码。该漏洞可被远程利用，攻击者仅需知道目标设备的 IP 地址即可触发，影响设备管理安全，可能导致管理员账户被完全接管。","severity":"MEDIUM","score":6.1,"aliases":["CVE-2018-13317"],"sources":["nuclei"],"published":"2018-11-26T23:29:00Z","updated":"2026-06-17T01:39:11Z","remediation":"升级到TOTOLINK A3002RU最新固件版本（高于1.0.8），修复password.htm页面明文泄露管理员密码漏洞；临时缓解措施为在路由器管理界面中禁用或移除password.htm页面的公开访问权限，或通过防火墙规则禁止外部网络对路由器管理端口的HTTP访问。","status":"completed","collected_at":"2026-08-02T00:00:00Z","references":["https://blog.securityevaluators.com/new-vulnerabilities-in-totolink-a3002ru-d6f42a081154","https://github.com/projectdiscovery/nuclei-templates/blob/main/http/cves/2018/CVE-2018-13317.yaml","https://github.com/trickest/cve/blob/7d40e7d94b41c478b4d1a654c7bc3bcf34fa7beb/2018/CVE-2018-13317.md","https://github.com/projectdiscovery/nuclei-templates/blob/f5a1370a5c99053077d951ed65ac8cc8cef6e9f7/http/cves/2018/CVE-2018-13317.yaml","https://github.com/CVEProject/cvelistV5/blob/14587a553af4d49d5605e1beebb7fda4e5c12c66/cves/2018/13xxx/CVE-2018-13317.json","https://github.com/0x727/FingerprintHub/blob/d8cd4a1ae21f91a5e3337a6b189b078a1a73a4aa/plugins/totolink/a3002ru/CVE-2018-13317.yaml","https://github.com/CVEDB/Poc-Git/blob/0275aeb329b0747c9a1d46160c921eae06095557/2018/CVE-2018-13317.md","https://github.com/Patrowl/PatrowlHearsData/blob/d2f8f41b3c8a1114b748f2f7bb00dbfa68417789/CVE/data/2018/CVE-2018-13317.json","https://github.com/crowdsecurity/hub/blob/9e987ce9652feb07217e72ab766842bc305285c8/appsec-rules/crowdsecurity/vpatch-CVE-2018-13317.yaml","https://github.com/ARPSyndicate/suricata-vedas/blob/fe24794ad36564b5bbc7c69101525011387b8650/2018/CVE-2018-13317.rules","https://github.com/adampielak/nuclei-templates/blob/a2f3ff3fa5db5c7705ebd942909ec114df063700/nuclei-v3/C/CVE-2018-13317.yaml","https://github.com/youki992/VscanPlus/blob/714a0e276a538a22c1a6215c71458a8b59a920ef/pocs_yml/nucleiFiles/http/cves/2018/CVE-2018-13317.yaml"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":["https://raw.githubusercontent.com/adysec/AVE/main/pocs/2018/POC-AVE-2018-0078.toml"],"repo_exp_urls":["https://raw.githubusercontent.com/adysec/AVE/main/exploits/2018/EXP-AVE-2018-0078.toml"],"has_poc":true,"has_exp":true,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/2018/AVE-2018-0078.toml"},{"ave_id":"AVE-2018-0150","file_name":"2018/AVE-2018-0150.toml","cve_id":"CVE-2018-19518","title":"PHP IMAP 远程命令执行漏洞","description":"PHP 的 imap_open() 函数在调用 IMAP 扩展时，底层依赖的 University of Washington IMAP Toolkit 2007f 中 imap_rimap() 和 tcp_aopen() 函数会通过 rsh 命令建立连接，但未对 mailbox 参数进行有效过滤，导致参数注入漏洞。在 Debian/Ubuntu 等系统中 rsh 被符号链接指向 ssh 时，攻击者可利用包含 -oProxyCommand 参数的恶意 IMAP 服务器名注入任意系统命令。该漏洞影响 PHP 5.6.x、7.0.x、7.1.x、7.2.x 及 7.3.x 等多个版本，攻击者只需具备 Web 应用用户权限即可触发，CVSS 评分 7.5，危害等级高。官方已在 PHP 5.6.39、7.0.33、7.1.25、7.2.13 及 7.3.0 版本中修复此漏洞。","severity":"HIGH","score":7.5,"aliases":["CVE-2018-19518"],"sources":["nuclei"],"published":"2018-11-25T10:29:00Z","updated":"2026-06-17T01:49:25Z","remediation":"升级 PHP 至 5.6.39、7.0.33、7.1.25 或 7.2.13 及以上版本（官方已修复 imap_open 参数注入问题）。如无法升级，在 php.ini 中禁用 imap 扩展（`extension=imap.so` 前加分号注释），或使用 `disable_functions=imap_open` 禁用该函数。同时避免将用户可控输入直接传递给 imap_open 的 mailbox 参数，并对 IMAP 服务器名做严格白名单校验。","status":"completed","collected_at":"2026-08-03T00:00:00Z","references":["http://www.securityfocus.com/bid/106018","http://www.securitytracker.com/id/1042157","https://antichat.com/threads/463395/#post-4254681","https://bugs.debian.org/913775","https://bugs.debian.org/913835","https://bugs.debian.org/913836","https://bugs.php.net/bug.php?id=76428","https://bugs.php.net/bug.php?id=77153","https://bugs.php.net/bug.php?id=77160","https://git.php.net/?p=php-src.git%3Ba=commit%3Bh=e5bfea64c81ae34816479bb05d17cdffe45adddb","https://github.com/Bo0oM/PHP_imap_open_exploit/blob/master/exploit.php","https://lists.debian.org/debian-lts-announce/2018/12/msg00006.html","https://lists.debian.org/debian-lts-announce/2019/03/msg00001.html","https://lists.debian.org/debian-lts-announce/2021/12/msg00031.html","https://security.gentoo.org/glsa/202003-57","https://security.netapp.com/advisory/ntap-20181221-0004/","https://usn.ubuntu.com/4160-1/","https://www.debian.org/security/2018/dsa-4353","https://www.exploit-db.com/exploits/45914/","https://www.openwall.com/lists/oss-security/2018/11/22/3","https://www.exploit-db.com/exploits/45914","https://github.com/projectdiscovery/nuclei-templates/blob/main/dast/cves/2018/CVE-2018-19518.yaml","https://github.com/trickest/cve/blob/7d40e7d94b41c478b4d1a654c7bc3bcf34fa7beb/2018/CVE-2018-19518.md","https://github.com/vulhub/vulhub/blob/aeaf65793f147f29bd50841ef77f4e9cad07ecc7/php/CVE-2018-19518/README.md","https://github.com/vulhub/vulhub/blob/aeaf65793f147f29bd50841ef77f4e9cad07ecc7/php/CVE-2018-19518/README.zh-cn.md","https://github.com/0xMarcio/cve/blob/986b45a0ac2dd215b3a5515fba0cebac769043dd/2018/CVE-2018-19518.md","https://github.com/nomi-sec/PoC-in-GitHub/blob/c908bbff86d2944f8f8a39e75f549a966c642420/2018/CVE-2018-19518.json","https://github.com/projectdiscovery/nuclei-templates/blob/e9f0fe7fa4f5c548bbd1a4d3b65d0f181021e664/dast/cves/2018/CVE-2018-19518.yaml","https://github.com/ExpLangcn/NucleiTP/blob/2b7ecb9031a6eda4f272793045f29b339d8e0cce/CVES/high/CVE-2018-19518.yaml","https://github.com/Threekiii/Awesome-POC/blob/0f9e22b660cb1ea12c1c3668f9128d93e08da412/开发语言漏洞/PHP imap 远程命令执行漏洞 CVE-2018-19518.md","https://github.com/wgpsec/AboutSecurity/blob/f3c8574e6fa1f9c1cd5aeaba5a209af796107b34/Vuln/middleware/php/CVE-2018-19518.md","https://github.com/Threekiii/Vulnerability-Wiki/blob/b32b83c01eabac4d6b4b334852be9cff76ba67ee/docs-base/docs/language/PHP-imap-远程命令执行漏洞-CVE-2018-19518.md","https://github.com/houqe/EXP_CVE-2018-19518","https://github.com/ensimag-security/CVE-2018-19518"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":["https://raw.githubusercontent.com/adysec/AVE/main/pocs/2018/POC-AVE-2018-0150.toml"],"repo_exp_urls":["https://raw.githubusercontent.com/adysec/AVE/main/exploits/2018/EXP-AVE-2018-0150.toml"],"has_poc":true,"has_exp":true,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/2018/AVE-2018-0150.toml"},{"ave_id":"AVE-2018-0149","file_name":"2018/AVE-2018-0149.toml","cve_id":"CVE-2018-19458","title":"PHP Proxy 本地文件包含漏洞","description":"PHP Proxy 3.0.3 存在本地文件包含漏洞，由于程序未对 `index.php` 中 `q` 参数传入的路径进行有效过滤和身份验证，未经认证的远程攻击者可通过构造 `index.php?q=file:///` 形式的 URI 读取服务器上的任意文件，导致敏感信息泄露。该漏洞攻击复杂度低，无需任何权限，仅需网络访问即可利用。","severity":"HIGH","score":7.5,"aliases":["CVE-2018-19458"],"sources":["nuclei"],"published":"2018-11-22T20:29:00Z","updated":"2026-06-17T01:49:20Z","remediation":"立即将 php-proxy-app 升级到 v4.0.0 或更高版本（通过 `composer update` 或重新执行 `composer create-project athlon1600/php-proxy-app`）。v4.0.0 已重构 URL 处理逻辑，移除了对 `file://` 协议的解析支持。如无法升级，在 Web 服务器（Nginx/Apache）层面添加规则拦截包含 `q=file://` 的请求，或在 `index.php` 入口处校验 `$_GET['q']` 参数禁止 `file://` 协议前缀。","status":"completed","collected_at":"2026-08-03T00:00:00Z","references":["https://pentest.com.tr/exploits/PHP-Proxy-3-0-3-Local-File-Inclusion.html","https://www.exploit-db.com/exploits/45780/","https://www.exploit-db.com/exploits/45780","https://github.com/projectdiscovery/nuclei-templates/blob/main/http/cves/2018/CVE-2018-19458.yaml","https://github.com/trickest/cve/blob/7d40e7d94b41c478b4d1a654c7bc3bcf34fa7beb/2018/CVE-2018-19458.md","https://github.com/projectdiscovery/nuclei-templates/blob/e9f0fe7fa4f5c548bbd1a4d3b65d0f181021e664/http/cves/2018/CVE-2018-19458.yaml","https://github.com/ExpLangcn/NucleiTP/blob/2b7ecb9031a6eda4f272793045f29b339d8e0cce/CVES/high/CVE-2018-19458.yaml","https://github.com/ExpLangcn/NucleiTP/blob/2b7ecb9031a6eda4f272793045f29b339d8e0cce/CVES/high/cve-2018-19458-3482.yaml","https://github.com/ExpLangcn/NucleiTP/blob/2b7ecb9031a6eda4f272793045f29b339d8e0cce/CVES/high/cve-2018-19458-3481.yaml","https://github.com/ExpLangcn/NucleiTP/blob/2b7ecb9031a6eda4f272793045f29b339d8e0cce/CVES/high/cve-2018-19458-3484.yaml","https://github.com/ExpLangcn/NucleiTP/blob/2b7ecb9031a6eda4f272793045f29b339d8e0cce/CVES/high/cve-2018-19458-3485.yaml","https://github.com/GhostTroops/scan4all/blob/fff03b51bf79c8993a46c1da766ec993e1102c47/config/51pwn/CVE-2018-19458.yaml","https://github.com/GhostTroops/scan4all/blob/fff03b51bf79c8993a46c1da766ec993e1102c47/config/51pwn/yaml/PHP-Proxy/CVE-2018-19458.yaml","https://github.com/SleepingBag945/dddd/blob/4c428a7c171275bfbb5fa72c2fb4bd7b48f4ff4a/common/config/pocs/CVE-2018-19458.yaml"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":[],"repo_exp_urls":[],"has_poc":false,"has_exp":false,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/2018/AVE-2018-0149.toml"},{"ave_id":"AVE-2018-0555","file_name":"2018/AVE-2018-0555.toml","cve_id":"CVE-2018-19410","title":"Paessler PRTG Network Monitor 本地文件包含漏洞","description":"Paessler PRTG Network Monitor 18.2.40.1683 之前版本存在本地文件包含漏洞，未经身份认证的远程攻击者可通过构造恶意 HTTP 请求，覆盖 /public/login.htm 中 'include' 指令的属性，包含并执行 /api/addusers 接口。攻击者仅需提供 'id' 和 'users' 参数，即可在无需认证的情况下创建具有读写权限（含管理员）的用户账户，进而完全控制监控系统。该漏洞影响所有未升级至 18.2.40.1683 版本的 PRTG Network Monitor 实例，CVSS 3.1 评分 9.8（严重），攻击向量为网络、攻击复杂度低、无需权限、无需用户交互，机密性/完整性/可用性均受高度影响。","severity":"CRITICAL","score":9.8,"aliases":["CVE-2018-19410"],"sources":["nuclei"],"published":"2018-11-21T16:29:00Z","updated":"2026-06-17T01:49:15Z","remediation":"立即升级 PRTG Network Monitor 至 18.2.40.1683 或更高版本（Paessler 官网下载最新安装包覆盖安装）。若暂时无法升级，请在防火墙层面限制 PRTG Web 界面（默认端口 80/443）仅允许受信任管理 IP 访问，并定期审计用户列表排查非授权创建的管理员账号。","status":"completed","collected_at":"2026-08-03T00:00:00Z","references":["https://www.ptsecurity.com/ww-en/analytics/threatscape/pt-2018-24/","https://www.cisa.gov/known-exploited-vulnerabilities-catalog?field_cve=CVE-2018-19410","https://github.com/projectdiscovery/nuclei-templates/blob/main/http/cves/2018/CVE-2018-19410.yaml","https://github.com/trickest/cve/blob/7d40e7d94b41c478b4d1a654c7bc3bcf34fa7beb/2018/CVE-2018-19410.md","https://github.com/0xMarcio/cve/blob/986b45a0ac2dd215b3a5515fba0cebac769043dd/2018/CVE-2018-19410.md","https://github.com/nomi-sec/PoC-in-GitHub/blob/c908bbff86d2944f8f8a39e75f549a966c642420/2018/CVE-2018-19410.json","https://github.com/projectdiscovery/nuclei-templates/blob/e9f0fe7fa4f5c548bbd1a4d3b65d0f181021e664/http/cves/2018/CVE-2018-19410.yaml","https://github.com/CVEProject/cvelistV5/blob/73e213348ddf142cab7e77d05861fa314ba8e1d0/cves/2018/19xxx/CVE-2018-19410.json","https://github.com/cisagov/vulnrichment/blob/bc943eb819a406135c2391ed30d595e2ea60281b/2018/19xxx/CVE-2018-19410.json","https://github.com/sari3l/Poc-Monitor/blob/ed3533775a9ade21f1577e57c130e65e8f80898c/2018/CVE-2018-19410.json","https://github.com/0x727/FingerprintHub/blob/dce139c84c439e9fc87d0eb2079ddda89aaeb75c/plugins/paessler/prtg_network_monitor/CVE-2018-19410.yaml","https://github.com/CVEDB/Poc-Git/blob/0275aeb329b0747c9a1d46160c921eae06095557/2018/CVE-2018-19410.md","https://github.com/rix4uni/cvemapping/blob/23441ec855d45e03157b693d7c6d0ff023fe3af5/2018/CVE-2018-19410/CVE-2018-19410-POC.py","https://github.com/himash/CVE-2018-19410-POC"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":[],"repo_exp_urls":[],"has_poc":false,"has_exp":false,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/2018/AVE-2018-0555.toml"},{"ave_id":"AVE-2018-0145","file_name":"2018/AVE-2018-0145.toml","cve_id":"CVE-2018-19326","title":"Zyxel VMG1312-B10D 目录遍历漏洞","description":"该漏洞存在于 Zyxel VMG1312-B10D 无线网关设备（版本低于 5.13(AAXA.8)C0）。攻击者可通过向设备发送包含 \"..\" 目录遍历字符的特制 HTTP 请求，绕过路径限制访问受保护文件，例如读取 /etc/passwd 等敏感系统文件。该漏洞利用无需身份验证，攻击复杂性低，可远程触发，对设备保密性造成高风险影响，已识别为 CWE-22 目录遍历类漏洞。攻击者只需构造简单的 HTTP 请求即可利用此漏洞，危害设备数据安全。","severity":"HIGH","score":7.5,"aliases":["CVE-2018-19326"],"sources":["nuclei"],"published":"2018-11-17T14:29:00Z","updated":"2026-06-17T01:49:08Z","remediation":"建议立即将 Zyxel VMG1312-B10D 设备固件升级至 5.13(AAXA.8)C0 或更高版本，可通过 Zyxel 官网下载库 (https://www.zyxel.com/global/en/support/download) 获取最新固件。升级前请备份配置，升级后重启设备验证版本。若无法立即升级，可在防火墙层面限制设备管理界面仅允许受信任 IP 访问，并禁用不必要的 Web 管理端口作为临时缓解措施。","status":"completed","collected_at":"2026-08-03T00:00:00Z","references":["https://gist.github.com/numanturle/4988b5583e5ebe501059bd368636de33","https://github.com/projectdiscovery/nuclei-templates/blob/main/http/cves/2018/CVE-2018-19326.yaml","https://github.com/trickest/cve/blob/7d40e7d94b41c478b4d1a654c7bc3bcf34fa7beb/2018/CVE-2018-19326.md","https://github.com/projectdiscovery/nuclei-templates/blob/83234ce456da3e90dda86dfbc5e605e64a846df3/http/cves/2018/CVE-2018-19326.yaml","https://github.com/ExpLangcn/NucleiTP/blob/2b7ecb9031a6eda4f272793045f29b339d8e0cce/CVES/high/CVE-2018-19326.yaml","https://github.com/ExpLangcn/NucleiTP/blob/2b7ecb9031a6eda4f272793045f29b339d8e0cce/CVES/high/cve-2018-19326-3463.yaml","https://github.com/ExpLangcn/NucleiTP/blob/2b7ecb9031a6eda4f272793045f29b339d8e0cce/CVES/high/cve-2018-19326-3464.yaml","https://github.com/ExpLangcn/NucleiTP/blob/2b7ecb9031a6eda4f272793045f29b339d8e0cce/CVES/high/cve-2018-19326-3465.yaml","https://github.com/GhostTroops/scan4all/blob/fff03b51bf79c8993a46c1da766ec993e1102c47/config/51pwn/TPALL/LFI/CVE-2018-19326.yaml","https://github.com/GhostTroops/scan4all/blob/fff03b51bf79c8993a46c1da766ec993e1102c47/config/51pwn/yaml/ZyXEL 无线网关设备/CVE-2018-19326.yaml","https://github.com/CVEProject/cvelistV5/blob/0235c22e9b6c7ddb8ada469b545320bce3ffcbfa/cves/2018/19xxx/CVE-2018-19326.json","https://github.com/sepehrdaddev/zap-scripts/blob/2b63b02ca79cc7f0023cdbab72c5c6c774354b07/active/CVE-2018-19326.js"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":[],"repo_exp_urls":[],"has_poc":false,"has_exp":false,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/2018/AVE-2018-0145.toml"},{"ave_id":"AVE-2018-0144","file_name":"2018/AVE-2018-0144.toml","cve_id":"CVE-2018-19287","title":"WordPress Ninja Forms 插件跨站脚本漏洞","description":"WordPress Ninja Forms 插件 3.3.18 之前版本的 includes/Admin/Menus/Submissions.php（提交页面）存在反射型跨站脚本漏洞，由于对 begin_date、end_date、form_id 参数缺乏充分的输入验证与输出编码，远程攻击者可构造包含恶意 JavaScript 代码的 URL 诱导管理员点击，在管理员浏览器上下文中执行任意脚本，可窃取会话 Cookie、篡改页面内容或发起进一步攻击。该漏洞影响所有使用受影响版本 Ninja Forms 插件的 WordPress 站点，CVSS 3.0 评分 6.1（中危），攻击向量为网络、攻击复杂度低、无需权限但需用户交互、范围改变、机密性和完整性影响较低。升级至 3.3.18 或更高版本可修复此漏洞。","severity":"MEDIUM","score":6.1,"aliases":["CVE-2018-19287"],"sources":["nuclei"],"published":"2018-11-15T06:29:00Z","updated":"2026-06-17T01:49:04Z","remediation":"立即升级WordPress Ninja Forms插件到3.3.18或更高版本，这包含官方安全补丁修复XSS漏洞；更新后访问插件设置页面，确认“提交”功能中的表单验证已启用，并禁用不需要的表单字段；如无法立即更新，可临时通过导入安全规则的Web应用防火墙规则过滤包含恶意脚本的提交请求，阻止XSS攻击载荷；定期备份网站数据和插件配置，以便在紧急情况下快速恢复安全版本","status":"completed","collected_at":"2026-08-03T00:00:00Z","references":["https://plugins.trac.wordpress.org/changeset/1974335/ninja-forms/trunk/includes/Admin/Menus/Submissions.php","https://wordpress.org/plugins/ninja-forms/#developers","https://www.exploit-db.com/exploits/45880/","https://www.exploit-db.com/exploits/45880","https://github.com/projectdiscovery/nuclei-templates/blob/main/http/cves/2018/CVE-2018-19287.yaml","https://github.com/trickest/cve/blob/7d40e7d94b41c478b4d1a654c7bc3bcf34fa7beb/2018/CVE-2018-19287.md","https://github.com/projectdiscovery/nuclei-templates/blob/2c6b2e1482debf55f607b200837f63426669df52/http/cves/2018/CVE-2018-19287.yaml","https://github.com/ExpLangcn/NucleiTP/blob/2b7ecb9031a6eda4f272793045f29b339d8e0cce/CVES/medium/CVE-2018-19287.yaml","https://github.com/CVEProject/cvelistV5/blob/0235c22e9b6c7ddb8ada469b545320bce3ffcbfa/cves/2018/19xxx/CVE-2018-19287.json","https://github.com/CVEDB/Poc-Git/blob/0275aeb329b0747c9a1d46160c921eae06095557/2018/CVE-2018-19287.md","https://github.com/cckuailong/reapoc/blob/699762e4c31d0183733f64313d8fc3be6470bd37/2018/CVE-2018-19287/poc/nuclei/CVE-2018-19287.yaml","https://github.com/kaismax/CVE-Poc/blob/6d8c93dabf674cea102713781cc534d577412357/2018/CVE-2018-19287.md","https://github.com/linuxadi/40k-nuclei-templates/blob/542be6820c801c02a33aee60f1c05ca7b0b5005f/aditya/folder5/CVE-2018-19287.yaml","https://github.com/Ares-X/VulWiki/blob/40e0273754a36f49a6be6a77a7a4c210a07063ed/Web安全/Wordpress/Wordpress 插件漏洞/（CVE-2018-19287）WordPress Plugin - Ninja Forms 3.3.17 XSS.md","https://github.com/topscoder/nuclei-wordfence-cve/blob/cb3bd36094377a25dbc2de0dacc69b62a09f7685/nuclei-templates/2018/CVE-2018-19287-ninja_forms-5adc88e9-3fcd-4ad6-8eb9-1a111bf9cdc7.yaml"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":[],"repo_exp_urls":[],"has_poc":false,"has_exp":false,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/2018/AVE-2018-0144.toml"},{"ave_id":"AVE-2018-0809","file_name":"2018/AVE-2018-0809.toml","cve_id":"CVE-2018-6065","title":"Google Chrome V8 整数溢出漏洞","description":"Google Chrome V8 JavaScript 引擎在实例化新 JavaScript 对象时计算所需分配大小存在整数溢出漏洞（CWE-190），远程攻击者可构造特制 HTML 页面诱导用户访问，触发堆破坏（heap corruption），可能导致任意代码执行。该漏洞影响 Chrome 65.0.3325.146 之前版本，CVSS 评分 8.8，危害等级高危。Google 已在 Chrome 65 版本中修复此漏洞。","severity":"HIGH","score":8.8,"aliases":["CVE-2018-6065"],"sources":["kev"],"published":"2018-11-14T15:29:01Z","updated":"2026-06-17T02:01:16Z","remediation":"升级 Google Chrome 至 65.0.3325.146 或更高版本（Chrome 会自动检查更新，也可通过 chrome://settings/help 手动触发更新）。基于 Chromium 的浏览器用户应更新至对应版本（如 Debian stretch 升级 chromium-browser 至 66.0.3359.117-1~deb9u1）。无法立即升级时，可禁用 JavaScript（chrome://settings/content/javascript）作为临时缓解措施，但会影响正常网页功能。","status":"completed","collected_at":"2026-07-29T00:00:00Z","references":["http://www.securityfocus.com/bid/103297","https://access.redhat.com/errata/RHSA-2018:0484","https://chromereleases.googleblog.com/2018/03/stable-channel-update-for-desktop.html","https://crbug.com/808192","https://www.debian.org/security/2018/dsa-4182","https://www.exploit-db.com/exploits/44584/","https://www.zerodayinitiative.com/advisories/ZDI-19-367/","https://www.cisa.gov/known-exploited-vulnerabilities-catalog?field_cve=CVE-2018-6065","https://www.exploit-db.com/exploits/44584","https://github.com/trickest/cve/blob/b3a270a001a31742516eaea5c494f365de9d3c80/2018/CVE-2018-6065.md","https://github.com/tunz/js-vuln-db/blob/26d3f06008cbf95d05f066d2bf2a220deff491fc/v8/CVE-2018-6065.md","https://github.com/nomi-sec/PoC-in-GitHub/blob/b859fc75b332184195f1952ddeea761c6913ce9b/2018/CVE-2018-6065.json","https://github.com/CVEProject/cvelistV5/blob/3ea93936438a97f1459a1dd6e83719dbfc798be2/cves/2018/6xxx/CVE-2018-6065.json","https://github.com/cisagov/vulnrichment/blob/c16d5de75824639ce100418081f1869662c7d360/2018/6xxx/CVE-2018-6065.json","https://github.com/CVEDB/Poc-Git/blob/0275aeb329b0747c9a1d46160c921eae06095557/2018/CVE-2018-6065.md","https://github.com/kaismax/CVE-Poc/blob/6d8c93dabf674cea102713781cc534d577412357/2018/CVE-2018-6065.md","https://github.com/LiuCan01/cve-list-pro/blob/78b55511cee3604c22d518e32822f0435d0cacc0/cve-list/CVE-2018/CVE-2018-6065","https://github.com/canonical/ubuntu-security-notices/blob/f52824ab85b4a56207060d8a0fb7319df7a49552/vex/cve/2018/CVE-2018-6065.json","https://github.com/canonical/ubuntu-security-notices/blob/f52824ab85b4a56207060d8a0fb7319df7a49552/osv/cve/2018/UBUNTU-CVE-2018-6065.json","https://github.com/b1tg/CVE-2018-6065-exploit"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":["https://raw.githubusercontent.com/adysec/AVE/main/pocs/2018/POC-AVE-2018-0809.toml"],"repo_exp_urls":["https://raw.githubusercontent.com/adysec/AVE/main/exploits/2018/EXP-AVE-2018-0809.toml"],"has_poc":true,"has_exp":true,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/2018/AVE-2018-0809.toml"},{"ave_id":"AVE-2018-0500","file_name":"2018/AVE-2018-0500.toml","cve_id":"CVE-2018-17463","title":"Google Chrome V8 类型混淆远程代码执行漏洞","description":"Google Chrome 70.0.3538.64 之前版本中的 V8 JavaScript 引擎存在不正确的副作用注释（Incorrect side effect annotation）漏洞，导致 Object.create 类型混淆（Type Confusion）。远程攻击者可通过构造特制的 HTML 页面，诱使用户访问后触发该漏洞，从而在沙箱内执行任意代码。该漏洞影响所有 Chrome 70.0.3538.64 之前版本，CVSS 评分 8.8，危害等级高，且已被 CISA 列入已知被利用漏洞目录。","severity":"HIGH","score":8.8,"aliases":["CVE-2018-17463"],"sources":["kev"],"published":"2018-11-14T15:29:00Z","updated":"2026-06-17T01:45:53Z","remediation":"升级 Google Chrome 至 70.0.3538.64 及以上版本，可通过 Chrome 设置 > 关于 Chrome > 自动检查更新完成升级。如无法立即更新，可在浏览器中禁用 V8 JIT 编译（通过 --jitless 启动参数）作为临时缓解措施。","status":"completed","collected_at":"2026-07-28T00:00:00Z","references":["http://packetstormsecurity.com/files/156640/Google-Chrome-67-68-69-Object.create-Type-Confusion.html","http://www.securityfocus.com/bid/105666","https://access.redhat.com/errata/RHSA-2018:3004","https://chromereleases.googleblog.com/2018/10/stable-channel-update-for-desktop.html","https://crbug.com/888923","https://security.gentoo.org/glsa/201811-10","https://www.debian.org/security/2018/dsa-4330","https://www.cisa.gov/known-exploited-vulnerabilities-catalog?field_cve=CVE-2018-17463","https://www.exploit-db.com/exploits/48184","https://github.com/trickest/cve/blob/be44b05b9428dc18bc0705cf60dd8d8640cd49b1/2018/CVE-2018-17463.md","https://github.com/tunz/js-vuln-db/blob/26d3f06008cbf95d05f066d2bf2a220deff491fc/v8/CVE-2018-17463.md","https://github.com/0xMarcio/cve/blob/d08f837f771e6cd83ec9c845b0c4f72f125cbe84/2018/CVE-2018-17463.md","https://github.com/nomi-sec/PoC-in-GitHub/blob/bed70a0a2e2dec8bd34bd440f68f32280391094f/2018/CVE-2018-17463.json","https://github.com/CVEDB/Poc-Git/blob/0275aeb329b0747c9a1d46160c921eae06095557/2018/CVE-2018-17463.md","https://github.com/kaismax/CVE-Poc/blob/6d8c93dabf674cea102713781cc534d577412357/2018/CVE-2018-17463.md","https://github.com/Patrowl/PatrowlHearsData/blob/485b16e111d5be129c27a026bd0160d48eb6b893/SSVC/data/2018/CVE-2018-17463.json","https://github.com/rycbar77/V8Exploits/blob/5dfb50781bd52d37cfc381e5f40b0db79e535b2e/CVE-2018-17463.js","https://github.com/rix4uni/cvemapping/blob/74eb38d48bf4ff1f1c91e4f5d37b571a985efa6f/2018/CVE-2018-17463/README.md","https://github.com/Patrowl/PatrowlHearsData/blob/485b16e111d5be129c27a026bd0160d48eb6b893/CVE/data/2018/CVE-2018-17463.json","https://github.com/jhalon/CVE-2018-17463","https://github.com/kdmarti2/CVE-2018-17463"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":["https://raw.githubusercontent.com/adysec/AVE/main/pocs/2018/POC-AVE-2018-0500.toml"],"repo_exp_urls":["https://raw.githubusercontent.com/adysec/AVE/main/exploits/2018/EXP-AVE-2018-0500.toml"],"has_poc":true,"has_exp":true,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/2018/AVE-2018-0500.toml"},{"ave_id":"AVE-2018-0031","file_name":"2018/AVE-2018-0031.toml","cve_id":"CVE-2018-8589","title":"Microsoft Windows Win32k 特权提升漏洞","description":"Windows Win32k 内核组件在处理特定调用时存在缺陷，导致 Win32k.sys 驱动程序无法正确处理请求，从而产生特权提升漏洞。攻击者可通过在受影响的 Windows 系统（如 Windows 7, Windows Server 2008, Windows Server 2008 R2）上运行特制的恶意代码，在获得低权限用户访问权限的条件下，利用该漏洞非法提升权限至 SYSTEM 级别。该漏洞影响范围涵盖多个早期 Windows 版本，一旦被成功利用，攻击者将能够完全控制目标受害系统。","severity":"HIGH","score":7.8,"aliases":["CVE-2018-8589"],"sources":["kev"],"published":"2018-11-14T01:29:02Z","updated":"2026-06-17T02:05:09Z","remediation":"立即安装微软 2018 年 11 月发布的累积安全更新（对应 KB4042240 或后续更高版本补丁）。对于已停止支持的 Windows 7 或 Server 2008 及其 R2 版本，建议升级至更新的操作系统版本以根除 Win32k 内核漏洞。","status":"completed","collected_at":"2026-07-29T00:00:00Z","references":["http://www.securityfocus.com/bid/105796","http://www.securitytracker.com/id/1042140","https://portal.msrc.microsoft.com/en-US/security-guidance/advisory/CVE-2018-8589","https://www.cisa.gov/known-exploited-vulnerabilities-catalog?field_cve=CVE-2018-8589","https://github.com/trickest/cve/blob/b349e2ac98435c78e6eec698cf95df82dacb0ca1/2018/CVE-2018-8589.md","https://github.com/ruanyf/weekly/blob/07fea239b574fa2677bdb60696eb117184bd9b0d/docs/issue-68.md","https://github.com/cisagov/vulnrichment/blob/d39b6ea8bd1db5015fd4719557f42ea872f89939/2018/8xxx/CVE-2018-8589.json","https://github.com/CVEDB/Poc-Git/blob/0275aeb329b0747c9a1d46160c921eae06095557/2018/CVE-2018-8589.md","https://github.com/kaismax/CVE-Poc/blob/6d8c93dabf674cea102713781cc534d577412357/2018/CVE-2018-8589.md","https://github.com/Patrowl/PatrowlHearsData/blob/12510680d47d531059ad635931375e3cc99ef556/CVE/data/2018/CVE-2018-8589.json","https://github.com/Patrowl/PatrowlHearsData/blob/12510680d47d531059ad635931375e3cc99ef556/SSVC/data/2018/CVE-2018-8589.json","https://github.com/nomi-sec/NVD-Database/blob/23dc120c34402aaa65883c51c1d03b3cb02c20cb/2018/CVE-2018-8589.json","https://github.com/olbat/nvdcve/blob/add906b6a8ba20fd533c6fdd7f023c73e6090f3a/nvdcve/CVE-2018-8589.json","https://github.com/fkie-cad/nvd-json-data-feeds/blob/42f7ce3fe01d1b8b4a37ed409361811a74eb1f5b/CVE-2018/CVE-2018-85xx/CVE-2018-8589.json"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":[],"repo_exp_urls":[],"has_poc":false,"has_exp":false,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/2018/AVE-2018-0031.toml"},{"ave_id":"AVE-2018-1168","file_name":"2018/AVE-2018-1168.toml","cve_id":"CVE-2018-8581","title":"Microsoft Exchange Server 特权提升漏洞","description":"Microsoft Exchange Server 存在特权提升漏洞，攻击者无需身份认证即可通过向目标服务器发送特制的网络请求，利用 Exchange Server 处理邮件或协议解析时的权限控制缺陷，将自身权限提升至系统管理员级别。该漏洞影响 Microsoft Exchange Server 多个版本，CVSS 评分为 7.4（高危），攻击复杂度高但无需用户交互，远程即可触发。攻击者可借此获取服务器上的敏感邮件数据并篡改系统配置。Microsoft 已在 2018 年 11 月的安全更新中修复此漏洞，建议管理员及时安装补丁。","severity":"HIGH","score":7.4,"aliases":["CVE-2018-8581"],"sources":["kev"],"published":"2018-11-14T01:29:01Z","updated":"2026-06-17T02:05:08Z","remediation":"立即安装 Microsoft 2018 年 12 月安全更新：Exchange Server 2010 安装 KB4465477，Exchange Server 2013 安装 KB4465743，Exchange Server 2016 安装 KB4465463，Exchange Server 2019 安装 KB4465455。如无法立即打补丁，可临时在 Exchange 服务器前端禁用 Outlook Web Access（OWA）或限制 Exchange Web Services（EWS）的外部访问，并通过防火墙规则仅允许受信任的内部 IP 访问 EWS 端口，以减缓攻击面。","status":"completed","collected_at":"2026-07-29T00:00:00Z","references":["http://www.securityfocus.com/bid/105837","http://www.securitytracker.com/id/1042141","https://portal.msrc.microsoft.com/en-US/security-guidance/advisory/CVE-2018-8581","https://www.cisa.gov/known-exploited-vulnerabilities-catalog?field_cve=CVE-2018-8581","https://github.com/trickest/cve/blob/b3a270a001a31742516eaea5c494f365de9d3c80/2018/CVE-2018-8581.md","https://github.com/0xMarcio/cve/blob/4d49d726b1fb3c9b2aca31cc43dccec4b6f94cc1/2018/CVE-2018-8581.md","https://github.com/nomi-sec/PoC-in-GitHub/blob/f7fdc93b8d4d470f2c23e4fffbdda828848b6048/2018/CVE-2018-8581.json","https://github.com/arschlochnop/VulnWatchdog/blob/b0566b6cda8cbec1cb3686eeca1658482c532efd/data/by-cve/CVE-2018-8581.md","https://github.com/sari3l/Poc-Monitor/blob/322dcc378d349a48b71cd3f597f71b0338dda93b/2018/CVE-2018-8581.json","https://github.com/arschlochnop/VulnWatchdog/blob/b0566b6cda8cbec1cb3686eeca1658482c532efd/data/2018/CVE-2018-8581-WyAtu_CVE-2018-8581.md","https://github.com/WyAtu/CVE-2018-8581/blob/72ef44ff70919b9422076b8b8254d7b454bb80f1/CVE-2018-8581.py","https://github.com/CVEDB/Poc-Git/blob/0275aeb329b0747c9a1d46160c921eae06095557/2018/CVE-2018-8581.md","https://github.com/arschlochnop/VulnWatchdog/blob/b0566b6cda8cbec1cb3686eeca1658482c532efd/data/2018/CVE-2018-8581-Ridter_Exchange2domain.md","https://github.com/arschlochnop/VulnWatchdog/blob/b0566b6cda8cbec1cb3686eeca1658482c532efd/data/2018/CVE-2018-8581-qiantu88_CVE-2018-8581.md","https://github.com/Ridter/Exchange2domain","https://github.com/WyAtu/CVE-2018-8581","https://github.com/qiantu88/CVE-2018-8581"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":["https://raw.githubusercontent.com/adysec/AVE/main/pocs/2018/POC-AVE-2018-1168.toml"],"repo_exp_urls":["https://raw.githubusercontent.com/adysec/AVE/main/exploits/2018/EXP-AVE-2018-1168.toml"],"has_poc":true,"has_exp":true,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/2018/AVE-2018-1168.toml"},{"ave_id":"AVE-2018-0142","file_name":"2018/AVE-2018-0142.toml","cve_id":"CVE-2018-19207","title":"WordPress Van Ons WP GDPR Compliance 插件任意代码执行漏洞","description":"WordPress 的 Van Ons WP GDPR Compliance（wp-gdpr-compliance）插件在 1.4.3 版本之前存在远程代码执行漏洞。该漏洞的根本原因是插件在处理数据库查询时错误地使用了 $wpdb->prepare() 函数的输入处理逻辑，导致对用户可控参数的转义与绑定过程存在缺陷，攻击者提交的恶意数据未被正确参数化处理而是被直接拼接入 SQL 查询，从而能够注入并执行任意代码。该漏洞攻击条件简单，未认证的远程攻击者无需任何权限，通过网络即可发起攻击，无需用户交互，在 2018 年 11 月已被发现在野利用。攻击者可借此获得目标站点的高权限访问，进一步窃取数据、篡改网页内容或植入后门，造成机密性、完整性和可用性的全面破坏。CVSS 评分为 9.8，危害等级为严重，官方建议立即升级到 1.4.3 及以上版本以修复该缺陷。","severity":"CRITICAL","score":9.8,"aliases":["CVE-2018-19207"],"sources":["nuclei"],"published":"2018-11-12T17:29:00Z","updated":"2026-06-17T01:48:58Z","remediation":"立即将 WordPress 站点中的 Van Ons WP GDPR Compliance（wp-gdpr-compliance）插件升级至 1.4.3 或更高版本，该版本修复了因 $wpdb->prepare() 输入处理不当导致的任意代码执行问题（该漏洞已在 2018 年 11 月遭野外利用）。升级前请备份数据库与插件目录，并在 WordPress 管理后台\"插件\"页面点击\"立即更新\"；同时检查是否已安装且激活 1.4.3 及以上版本。作为缓解措施，若暂无法升级，应停用该插件，并通过防火墙或访问控制规则限制对含有该插件相关功能的挂载点（如任意 PHP 文件上传/执行路径）的外网访问，同时排查是否存在已被入侵的迹象（异常文件、可疑挂载进程及非预期管理员账号），及时清除作为临时管控手段。","status":"completed","collected_at":"2026-08-03T00:00:00Z","references":["http://www.securityfocus.com/bid/105921","https://wordpress.org/plugins/wp-gdpr-compliance/#developers","https://wpvulndb.com/vulnerabilities/9144","https://www.wordfence.com/blog/2018/11/trends-following-vulnerability-in-wp-gdpr-compliance-plugin/","https://github.com/projectdiscovery/nuclei-templates/blob/main/http/cves/2018/CVE-2018-19207.yaml","https://github.com/trickest/cve/blob/7d40e7d94b41c478b4d1a654c7bc3bcf34fa7beb/2018/CVE-2018-19207.md","https://github.com/0xMarcio/cve/blob/986b45a0ac2dd215b3a5515fba0cebac769043dd/2018/CVE-2018-19207.md","https://github.com/nomi-sec/PoC-in-GitHub/blob/57432302d64f9bc08597d61c88fc5f900569476d/2018/CVE-2018-19207.json","https://github.com/projectdiscovery/nuclei-templates/blob/2c6b2e1482debf55f607b200837f63426669df52/http/cves/2018/CVE-2018-19207.yaml","https://github.com/arschlochnop/VulnWatchdog/blob/96acb02a8d6942d7cdf496f8d887cd0035972f4b/data/by-cve/CVE-2018-19207.md","https://github.com/CVEProject/cvelistV5/blob/0661b1b09ba7a2e855981f4a1781f3b8de7cf562/cves/2018/19xxx/CVE-2018-19207.json","https://github.com/sari3l/Poc-Monitor/blob/74a17114d313d1fcf11590910ec4d27e95394ac2/2018/CVE-2018-19207.json","https://github.com/CVEDB/Poc-Git/blob/0275aeb329b0747c9a1d46160c921eae06095557/2018/CVE-2018-19207.md","https://github.com/arschlochnop/VulnWatchdog/blob/96acb02a8d6942d7cdf496f8d887cd0035972f4b/data/2018/CVE-2018-19207-Pwdnx1337_CVE-2018-19207.md","https://github.com/arschlochnop/VulnWatchdog/blob/96acb02a8d6942d7cdf496f8d887cd0035972f4b/data/2018/CVE-2018-19207-cved-sources_cve-2018-19207.md","https://github.com/aeroot/WP-GDPR-Compliance-Plugin-Exploit","https://github.com/AnotherSec/CVE-2018-19207","https://github.com/cved-sources/cve-2018-19207"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":[],"repo_exp_urls":[],"has_poc":false,"has_exp":false,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/2018/AVE-2018-0142.toml"},{"ave_id":"AVE-2018-0141","file_name":"2018/AVE-2018-0141.toml","cve_id":"CVE-2018-19137","title":"DomainMOD 跨站脚本漏洞","description":"DomainMOD 4.11.01 及更早版本在资产编辑页面的 IP 地址管理功能中存在存储型跨站脚本（XSS）漏洞。该漏洞源于 assets/edit/ip-address.php 文件对 ipid 参数的处理缺少充分的输入过滤与输出编码，攻击者可通过向该参数注入恶意 JavaScript 脚本，在目标用户浏览器中执行任意脚本代码，从而窃取会话 Cookie、执行越权操作或篡改页面内容。该漏洞利用无需身份认证前置条件之外的特殊权限，但需诱使已登录的管理员用户访问特制的恶意链接方可触发，攻击复杂度较低。CVSS 评分为 6.1，危害等级为中等，建议升级至修复版本并对 ipid 参数进行严格校验。","severity":"MEDIUM","score":6.1,"aliases":["CVE-2018-19137"],"sources":["nuclei"],"published":"2018-11-09T19:29:00Z","updated":"2026-06-17T01:48:51Z","remediation":"` markers embedded. The validator says remediation is empty (probably because of the format issue - the field is a multiline string starting with `\"\"\"tags.已确认修复版本...` which is invalid TOML).\n\nWait, actually the issue is the current remediation field is malformed - it starts with `tags.已确认修复版本` which is a TOML key error (the `tags.` prefix). The validator flagged remediation as empty. I need to output just the field value between <value>...\n","status":"completed","collected_at":"2026-08-03T00:00:00Z","references":["https://github.com/domainmod/domainmod/issues/79","https://github.com/projectdiscovery/nuclei-templates/blob/main/http/cves/2018/CVE-2018-19137.yaml","https://github.com/trickest/cve/blob/7d40e7d94b41c478b4d1a654c7bc3bcf34fa7beb/2018/CVE-2018-19137.md","https://github.com/projectdiscovery/nuclei-templates/blob/2c6b2e1482debf55f607b200837f63426669df52/http/cves/2018/CVE-2018-19137.yaml","https://github.com/ExpLangcn/NucleiTP/blob/2b7ecb9031a6eda4f272793045f29b339d8e0cce/CVES/medium/CVE-2018-19137.yaml","https://github.com/CVEProject/cvelistV5/blob/0661b1b09ba7a2e855981f4a1781f3b8de7cf562/cves/2018/19xxx/CVE-2018-19137.json","https://github.com/SleepingBag945/dddd/blob/4c428a7c171275bfbb5fa72c2fb4bd7b48f4ff4a/common/config/pocs/CVE-2018-19137.yaml","https://github.com/0x727/FingerprintHub/blob/dce139c84c439e9fc87d0eb2079ddda89aaeb75c/plugins/domainmod/domainmod/CVE-2018-19137.yaml","https://github.com/CVEDB/Poc-Git/blob/0275aeb329b0747c9a1d46160c921eae06095557/2018/CVE-2018-19137.md","https://github.com/cckuailong/reapoc/blob/699762e4c31d0183733f64313d8fc3be6470bd37/2018/CVE-2018-19137/poc/nuclei/CVE-2018-19137.yaml","https://github.com/Patrowl/PatrowlHearsData/blob/8a257d250bdb59b542a188d62ddae45e6eb5d3f2/CVE/data/2018/CVE-2018-19137.json","https://github.com/linuxadi/40k-nuclei-templates/blob/542be6820c801c02a33aee60f1c05ca7b0b5005f/aditya/folder3/cve-2018-19137.yaml"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":[],"repo_exp_urls":[],"has_poc":false,"has_exp":false,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/2018/AVE-2018-0141.toml"},{"ave_id":"AVE-2018-0140","file_name":"2018/AVE-2018-0140.toml","cve_id":"CVE-2018-19136","title":"DomainMOD 至 4.11.01 registrar-account.php 跨站点脚本漏洞","description":"DomainMOD 至 4.11.01 版本中存在跨站脚本（XSS）漏洞，位于 assets/edit/registrar-account.php 文件的 raid 参数中。攻击者无需身份认证即可通过社会工程学方式诱使已登录管理员点击特制链接，导致恶意脚本在用户浏览器中执行，从而窃取会话 Cookie、劫持管理会话或篡改页面内容。该漏洞影响 DomainMOD 4.11.01 及之前所有版本，CVSS 评分 6.1，危害等级中危。官方尚未发布修复补丁，建议限制后台管理页面的访问权限。","severity":"MEDIUM","score":6.1,"aliases":["CVE-2018-19136"],"sources":["nuclei"],"published":"2018-11-09T19:29:00Z","updated":"2026-06-17T01:48:51Z","remediation":"立即升级 DomainMOD 至最新版本（v4.23.0 或更高），该版本已移除存在 XSS 漏洞的旧版文件。如无法升级，在 `assets/edit/registrar-account.php` 和 `assets/edit/ip-address.php` 中对 `$_GET['raid']` 和 `$_GET['ipid']` 参数使用 `htmlspecialchars()` 进行 HTML 实体编码输出，并设置 `Content-Security-Policy` 响应头限制脚本执行。","status":"completed","collected_at":"2026-08-03T00:00:00Z","references":["https://github.com/domainmod/domainmod/issues/79","https://www.exploit-db.com/exploits/45883/","https://www.exploit-db.com/exploits/45883","https://github.com/projectdiscovery/nuclei-templates/blob/main/http/cves/2018/CVE-2018-19136.yaml","https://github.com/trickest/cve/blob/7d40e7d94b41c478b4d1a654c7bc3bcf34fa7beb/2018/CVE-2018-19136.md","https://github.com/projectdiscovery/nuclei-templates/blob/2c6b2e1482debf55f607b200837f63426669df52/http/cves/2018/CVE-2018-19136.yaml","https://github.com/ExpLangcn/NucleiTP/blob/2b7ecb9031a6eda4f272793045f29b339d8e0cce/CVES/medium/CVE-2018-19136.yaml","https://github.com/SleepingBag945/dddd/blob/4c428a7c171275bfbb5fa72c2fb4bd7b48f4ff4a/common/config/pocs/CVE-2018-19136.yaml","https://github.com/CVEProject/cvelistV5/blob/0661b1b09ba7a2e855981f4a1781f3b8de7cf562/cves/2018/19xxx/CVE-2018-19136.json","https://github.com/0x727/FingerprintHub/blob/dce139c84c439e9fc87d0eb2079ddda89aaeb75c/plugins/domainmod/domainmod/CVE-2018-19136.yaml","https://github.com/CVEDB/Poc-Git/blob/0275aeb329b0747c9a1d46160c921eae06095557/2018/CVE-2018-19136.md","https://github.com/cckuailong/reapoc/blob/699762e4c31d0183733f64313d8fc3be6470bd37/2018/CVE-2018-19136/poc/nuclei/CVE-2018-19136.yaml","https://github.com/Patrowl/PatrowlHearsData/blob/8a257d250bdb59b542a188d62ddae45e6eb5d3f2/CVE/data/2018/CVE-2018-19136.json","https://github.com/linuxadi/40k-nuclei-templates/blob/542be6820c801c02a33aee60f1c05ca7b0b5005f/aditya/folder4/CVE-2018-19136.yaml"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":[],"repo_exp_urls":[],"has_poc":false,"has_exp":false,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/2018/AVE-2018-0140.toml"},{"ave_id":"AVE-2018-0139","file_name":"2018/AVE-2018-0139.toml","cve_id":"CVE-2018-19127","title":"PHPCMS 2008 type.php 远程代码执行漏洞","description":"PHPCMS 2008 的 /type.php 存在代码注入漏洞，远程攻击者无需身份认证即可通过构造特制的 HTTP 请求，向 template 参数中注入恶意 PHP 代码。该参数内容会被写入 data/cache_template/ 目录下可控文件名的 .tpl.php 缓存文件中，并拼接 \"<?php function \" 前缀，导致任意 PHP 代码执行。攻击者可利用此漏洞完全控制目标服务器，执行系统命令、窃取敏感数据或植入后门。影响所有使用 PHPCMS 2008 版本的网站。","severity":"CRITICAL","score":9.8,"aliases":["CVE-2018-19127"],"sources":["nuclei"],"published":"2018-11-09T12:29:00Z","updated":"2026-06-17T01:48:49Z","remediation":"PHPCMS 2008 已停止维护，官方未发布安全补丁。建议立即升级至受支持的 CMS 版本或迁移至其他安全 CMS。若无法立即升级，可在 Nginx/Apache 中配置规则禁止外部访问 /type.php，或删除 data/cache_template/ 目录的 Web 写入权限，同时在应用层对 template 参数进行严格白名单校验，仅允许预定义模板文件名。","status":"completed","collected_at":"2026-08-03T00:00:00Z","references":["https://github.com/ab1gale/phpcms-2008-CVE-2018-19127","https://github.com/projectdiscovery/nuclei-templates/blob/main/http/cves/2018/CVE-2018-19127.yaml","https://github.com/trickest/cve/blob/7d40e7d94b41c478b4d1a654c7bc3bcf34fa7beb/2018/CVE-2018-19127.md","https://github.com/0xMarcio/cve/blob/986b45a0ac2dd215b3a5515fba0cebac769043dd/2018/CVE-2018-19127.md","https://github.com/nomi-sec/PoC-in-GitHub/blob/57432302d64f9bc08597d61c88fc5f900569476d/2018/CVE-2018-19127.json","https://github.com/projectdiscovery/nuclei-templates/blob/2c6b2e1482debf55f607b200837f63426669df52/http/cves/2018/CVE-2018-19127.yaml","https://github.com/shadow1ng/fscan/blob/bf036fd9b272a56d493796badcf0a269f0a83ec0/webscan/pocs/phpcms-cve-2018-19127.yml","https://github.com/ym2011/POC-EXP/blob/206b22d3a6b2a172359678df33bbc5b2ad04b6c3/CVE-2018-19127/CVE-2018-19127.py","https://github.com/zan8in/afrog/blob/9c47a2b9b7e12375757acdfbc179354920c87bd8/pocs/afrog-pocs/CVE/2018/CVE-2018-19127.yaml","https://github.com/CVEProject/cvelistV5/blob/0661b1b09ba7a2e855981f4a1781f3b8de7cf562/cves/2018/19xxx/CVE-2018-19127.json","https://github.com/veo/vscan/blob/1beb10c08e377e15b7dd417be1843bb75aa8c4f0/pocs_yml/xrayFiles/phpcms-cve-2018-19127.yml","https://github.com/awake1t/linglong/blob/bedbe49597412abab1c1635e133957d782e65325/pkg/pocs/phpcms-cve-2018-19127.yml"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":[],"repo_exp_urls":[],"has_poc":false,"has_exp":false,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/2018/AVE-2018-0139.toml"},{"ave_id":"AVE-2018-0306","file_name":"2018/AVE-2018-0306.toml","cve_id":"CVE-2018-14667","title":"JBoss RichFaces EL表达式注入远程代码执行漏洞","description":"JBoss RichFaces 框架 3.X 至 3.3.4 版本存在表达式语言（EL）注入漏洞，位于 UserResource 资源处理组件中。远程未认证攻击者可利用 org.ajax4jsf.resource.UserResource$UriData 类构造特制的 Java 序列化对象链，通过向目标服务器发送恶意 HTTP 请求触发 EL 表达式解析，从而在服务器端执行任意代码。该漏洞无需用户交互，攻击复杂度低，可完全控制受影响系统，导致数据泄露、服务中断或进一步横向移动。CVSS 评分 9.8，危害等级严重。Red Hat 已确认该漏洞并发布安全公告，建议用户升级至不受影响的版本或应用官方补丁。","severity":"CRITICAL","score":9.8,"aliases":["CVE-2018-14667"],"sources":["kev"],"published":"2018-11-06T22:29:00Z","updated":"2026-06-17T01:41:24Z","remediation":"立即将 RichFaces 升级到 4.x 版本或迁移至 JSF 2.x 兼容的 UI 框架（如 PrimeFaces）。如无法立即升级，应在应用部署中禁用 org.ajax4jsf.resource.UserResource 资源映射，通过在 web.xml 或 faces-config 中移除该资源的注册来阻断攻击入口。同时在 Web 应用防火墙（WAF）层拦截包含 /a4j/res 路径的异常请求。对于使用 Red Hat JBoss EAP 的用户，安装 RHSA-2018:3518 安全公告中提供的补丁。RichFaces 3.x 已停止维护，建议制定迁移计划彻底替换。","status":"completed","collected_at":"2026-07-28T00:00:00Z","references":["http://packetstormsecurity.com/files/156663/Richsploit-RichFaces-Exploitation-Toolkit.html","http://seclists.org/fulldisclosure/2020/Mar/21","http://www.securitytracker.com/id/1042037","https://access.redhat.com/errata/RHSA-2018:3517","https://access.redhat.com/errata/RHSA-2018:3518","https://access.redhat.com/errata/RHSA-2018:3519","https://access.redhat.com/errata/RHSA-2018:3581","https://bugzilla.redhat.com/show_bug.cgi?id=CVE-2018-14667","https://www.cisa.gov/known-exploited-vulnerabilities-catalog?field_cve=CVE-2018-14667","https://github.com/trickest/cve/blob/be44b05b9428dc18bc0705cf60dd8d8640cd49b1/2018/CVE-2018-14667.md","https://github.com/nomi-sec/PoC-in-GitHub/blob/bed70a0a2e2dec8bd34bd440f68f32280391094f/2018/CVE-2018-14667.json","https://github.com/CVEProject/cvelistV5/blob/95e02b73a69df169404c6b2708e1f8d0346744bc/cves/2018/14xxx/CVE-2018-14667.json","https://github.com/cisagov/vulnrichment/blob/f167926487b7da90867c80cac87302a7f8196ec5/2018/14xxx/CVE-2018-14667.json","https://github.com/Cryin/Paper/blob/ea1ef67ba4e3bc21280527dc3d93d605388987ab/CVE-2018-14667 - JBoss RichFaces EL Injection RCE Analysis.md","https://github.com/CVEDB/Poc-Git/blob/0275aeb329b0747c9a1d46160c921eae06095557/2018/CVE-2018-14667.md","https://github.com/kaismax/CVE-Poc/blob/6d8c93dabf674cea102713781cc534d577412357/2018/CVE-2018-14667.md","https://github.com/Patrowl/PatrowlHearsData/blob/e2322a1c7ec352a09ed3f56a28a4b08df0e6844e/CVE/data/2018/CVE-2018-14667.json","https://github.com/Patrowl/PatrowlHearsData/blob/e2322a1c7ec352a09ed3f56a28a4b08df0e6844e/SSVC/data/2018/CVE-2018-14667.json","https://github.com/Patrowl/PatrowlHearsData/blob/e2322a1c7ec352a09ed3f56a28a4b08df0e6844e/GHSA/data/2018/CVE-2018-14667.json","https://github.com/syriusbughunt/CVE-2018-14667","https://github.com/Venscor/CVE-2018-14667-poc","https://github.com/zeroto01/CVE-2018-14667","https://github.com/quandqn/cve-2018-14667","https://github.com/r00t4dm/CVE-2018-14667"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":[],"repo_exp_urls":[],"has_poc":false,"has_exp":false,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/2018/AVE-2018-0306.toml"}]
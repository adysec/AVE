om/archives/bugtraq/2000-08/0488.html","http://www.osvdb.org/5829","https://exchange.xforce.ibmcloud.com/vulnerabilities/5196","https://github.com/CVEProject/cvelistV5/blob/73e213348ddf142cab7e77d05861fa314ba8e1d0/cves/2000/0xxx/CVE-2000-0876.json","https://github.com/Patrowl/PatrowlHearsData/blob/cec9fb1846e25b24020f297f65ec2360af0f4267/CVE/data/2000/CVE-2000-0876.json","https://github.com/LiuCan01/cve-list-pro/blob/78b55511cee3604c22d518e32822f0435d0cacc0/cve-list/CVE-2000/CVE-2000-0876","https://github.com/nomi-sec/NVD-Database/blob/23dc120c34402aaa65883c51c1d03b3cb02c20cb/2000/CVE-2000-0876.json","https://github.com/olbat/nvdcve/blob/fe7f195231342e1e88104679c53c965e9a67ac35/nvdcve/CVE-2000-0876.json","https://github.com/opencve/opencve-kb/blob/1a96290b5e035ce53ab9adc58193928385ac790b/2000/CVE-2000-0876.json","https://github.com/HORKimhab/poc-cve-collection/blob/918ac66f0b50ab0d2a013bdf692688d3c0abefbc/2000/0xxx/CVE-2000-0876.md","https://github.com/fkie-cad/nvd-json-data-feeds/blob/b5070d3c2d6dc2fda079c163276abcda1c82b124/CVE-2000/CVE-2000-08xx/CVE-2000-0876.json","https://github.com/CyberSecAI/cve_info/blob/03b7e36424574a3a9ba5fd13480a326b666a1046/2000/0xxx/CVE-2000-0876.json","https://github.com/CVEProject/cvelist-dev/blob/5b8fbb570438e8094550205589cc6f1d122acc94/2000/0xxx/CVE-2000-0876.json"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":[],"repo_exp_urls":[],"has_poc":false,"has_exp":false,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/2000/AVE-2000-0988.toml"},{"ave_id":"AVE-2000-0987","file_name":"2000/AVE-2000-0987.toml","cve_id":"CVE-2000-0875","title":"泰克萨斯帝国软件 WFTPD 拒绝服务漏洞","description":"Texas Imperial Software WFTPD 和 WFTPD Pro 2.41 RC12 版本存在拒绝服务漏洞，远程攻击者可通过发送包含大量不可打印字符的长字符串，导致 FTP 服务进程崩溃或停止响应，从而实现拒绝服务攻击。该漏洞源于程序对异常字符输入缺乏有效过滤和边界检查，攻击者无需身份认证即可远程触发，影响使用受影响版本 WFTPD 服务的所有系统。CVSS 评分 5.0（AV:N/AC:L/Au:N/C:N/I:N/A:P），属中危级别。","severity":"MEDIUM","score":5.0,"aliases":["CVE-2000-0875"],"sources":["avd"],"published":"2000-11-14T05:00:00Z","updated":"2026-06-16T21:52:39Z","remediation":"建议立即升级到 Texas Imperial Software WFTPD和WFTPD Pro的最新版本（当前至少2.41 RC13或更高版本），并彻底删除已知存在漏洞的2.41 RC12版本。在升级过程中，请确保关闭FTP调试日志功能，并限制客户端连接速率到每分钟100个连接以内，以防止长期遭受不打印字符DoS攻击。如无法立即升级，建议在防火墙上配置IP封锁规则，禁止来自高风险网络段的连接，并启用FTP命令频率限制为每分钟50条以内，以降低被利用风险。","status":"completed","collected_at":"2026-08-03T00:00:00Z","references":["http://archives.neohapsis.com/archives/bugtraq/2000-08/0488.html","http://www.wftpd.com/bug_gpf.htm","https://exchange.xforce.ibmcloud.com/vulnerabilities/5194","https://github.com/CVEProject/cvelistV5/blob/0235c22e9b6c7ddb8ada469b545320bce3ffcbfa/cves/2000/0xxx/CVE-2000-0875.json","https://github.com/Patrowl/PatrowlHearsData/blob/cec9fb1846e25b24020f297f65ec2360af0f4267/CVE/data/2000/CVE-2000-0875.json","https://github.com/LiuCan01/cve-list-pro/blob/78b55511cee3604c22d518e32822f0435d0cacc0/cve-list/CVE-2000/CVE-2000-0875","https://github.com/nomi-sec/NVD-Database/blob/23dc120c34402aaa65883c51c1d03b3cb02c20cb/2000/CVE-2000-0875.json","https://github.com/olbat/nvdcve/blob/fe7f195231342e1e88104679c53c965e9a67ac35/nvdcve/CVE-2000-0875.json","https://github.com/opencve/opencve-kb/blob/1a96290b5e035ce53ab9adc58193928385ac790b/2000/CVE-2000-0875.json","https://github.com/HORKimhab/poc-cve-collection/blob/918ac66f0b50ab0d2a013bdf692688d3c0abefbc/2000/0xxx/CVE-2000-0875.md","https://github.com/fkie-cad/nvd-json-data-feeds/blob/b5070d3c2d6dc2fda079c163276abcda1c82b124/CVE-2000/CVE-2000-08xx/CVE-2000-0875.json","https://github.com/CyberSecAI/cve_info/blob/03b7e36424574a3a9ba5fd13480a326b666a1046/2000/0xxx/CVE-2000-0875.json","https://github.com/CVEProject/cvelist-dev/blob/5b8fbb570438e8094550205589cc6f1d122acc94/2000/0xxx/CVE-2000-0875.json"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":[],"repo_exp_urls":[],"has_poc":false,"has_exp":false,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/2000/AVE-2000-0987.toml"},{"ave_id":"AVE-2000-0986","file_name":"2000/AVE-2000-0986.toml","cve_id":"CVE-2000-0874","title":"Eudora 邮件客户端 VCF 虚拟通行证主机路径泄露漏洞","description":"该漏洞存在于 Eudora 邮件客户端中。Eudora 在生成虚拟名片（VCF）文件时，会将发送者主机的绝对路径信息嵌入到 VCF 文件内容之中，导致敏感信息泄露。远程攻击者无需身份认证，仅需诱导目标用户发送包含虚拟名片的电子邮件，即可获取发送者主机上的文件系统绝对路径信息。这可能暴露内部网络拓扑结构、用户名目录路径等系统信息，进而辅助攻击者实施更进一步的针对性攻击。漏洞利用难度低，攻击成本小，危害范围主要涉及 Eudora 邮件客户端用户的隐私与系统安全。建议用户及时升级至新版本以规避该风险。","severity":"MEDIUM","score":5.0,"aliases":["CVE-2000-0874"],"sources":["avd"],"published":"2000-11-14T05:00:00Z","updated":"2026-06-16T21:52:38Z","remediation":"建议立即升级到 Eudora 最后官方版本：Windows 版 7.1.0.9 或 Macintosh 版 6.2.4（2006 年 10 月发布）。在“工具→选项→编写邮件” 中禁用“发送虚拟名片 (VCF)”功能以阻断泄露路径。鉴于 Qualcomm 已于 2006 年停止维护 Eudora，长期缓解方案建议迁移至仍在维护的邮件客户端（如 Thunderbird、Outlook、Apple Mail），并在邮件网关层面配置内容过滤规则拦截包含绝对路径的 VCF 附件。","status":"completed","collected_at":"2026-08-03T00:00:00Z","references":["http://www.osvdb.org/1545","http://www.securityfocus.com/archive/1/80888","http://www.securityfocus.com/bid/1653","https://exchange.xforce.ibmcloud.com/vulnerabilities/5206","https://github.com/CVEProject/cvelistV5/blob/0235c22e9b6c7ddb8ada469b545320bce3ffcbfa/cves/2000/0xxx/CVE-2000-0874.json","https://github.com/Patrowl/PatrowlHearsData/blob/cec9fb1846e25b24020f297f65ec2360af0f4267/CVE/data/2000/CVE-2000-0874.json","https://github.com/LiuCan01/cve-list-pro/blob/78b55511cee3604c22d518e32822f0435d0cacc0/cve-list/CVE-2000/CVE-2000-0874","https://github.com/nomi-sec/NVD-Database/blob/23dc120c34402aaa65883c51c1d03b3cb02c20cb/2000/CVE-2000-0874.json","https://github.com/olbat/nvdcve/blob/fe7f195231342e1e88104679c53c965e9a67ac35/nvdcve/CVE-2000-0874.json","https://github.com/opencve/opencve-kb/blob/4f65f772070b3f93cf10dae516c0292b5e70e1bb/2000/CVE-2000-0874.json","https://github.com/fkie-cad/nvd-json-data-feeds/blob/b5070d3c2d6dc2fda079c163276abcda1c82b124/CVE-2000/CVE-2000-08xx/CVE-2000-0874.json","https://github.com/HORKimhab/poc-cve-collection/blob/918ac66f0b50ab0d2a013bdf692688d3c0abefbc/2000/0xxx/CVE-2000-0874.md","https://github.com/CyberSecAI/cve_info/blob/03b7e36424574a3a9ba5fd13480a326b666a1046/2000/0xxx/CVE-2000-0874.json","https://github.com/CVEProject/cvelist-dev/blob/5b8fbb570438e8094550205589cc6f1d122acc94/2000/0xxx/CVE-2000-0874.json"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":[],"repo_exp_urls":[],"has_poc":false,"has_exp":false,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/2000/AVE-2000-0986.toml"},{"ave_id":"AVE-2000-0985","file_name":"2000/AVE-2000-0985.toml","cve_id":"CVE-2000-0871","title":"Khamil Landross And Zack Jones EFTP 缓冲区溢出导致的拒绝服务漏洞","description":"Khamil Landross 和 Zack Jones 开发的 EFTP 2.0.4.281 版本存在缓冲区溢出漏洞，远程攻击者可通过发送不包含换行符的字符串并断开连接，触发服务端缓冲区溢出导致拒绝服务。该漏洞影响 EFTP 2.0.4.281 版本，CVSS 评分 5.0（AV:N/AC:L/Au:N/C:N/I:N/A:P），属于中危级别。攻击者无需身份认证即可远程利用，仅需向目标服务发送畸形数据包即可导致服务崩溃，严重影响业务连续性。","severity":"MEDIUM","score":5.0,"aliases":["CVE-2000-0871"],"sources":["avd"],"published":"2000-11-14T05:00:00Z","updated":"2026-06-16T21:52:38Z","remediation":"立即停止使用过时的 EFTP 服务，部署现代化的安全文件传输解决方案（如 SFTP 或 FTP over TLS）。如必须保留 EFTP，则将其隔离在内部网络，限制访问权限，并部署额外的缓冲区溢出防护机制。","status":"completed","collected_at":"2026-08-03T00:00:00Z","references":["http://archives.neohapsis.com/archives/bugtraq/2000-09/0089.html","http://www.osvdb.org/409","http://www.securityfocus.com/bid/1677","https://exchange.xforce.ibmcloud.com/vulnerabilities/5220","https://github.com/CVEProject/cvelistV5/blob/0235c22e9b6c7ddb8ada469b545320bce3ffcbfa/cves/2000/0xxx/CVE-2000-0871.json","https://github.com/Patrowl/PatrowlHearsData/blob/8a257d250bdb59b542a188d62ddae45e6eb5d3f2/CVE/data/2000/CVE-2000-0871.json","https://github.com/LiuCan01/cve-list-pro/blob/78b55511cee3604c22d518e32822f0435d0cacc0/cve-list/CVE-2000/CVE-2000-0871","https://github.com/nomi-sec/NVD-Database/blob/23dc120c34402aaa65883c51c1d03b3cb02c20cb/2000/CVE-2000-0871.json","https://github.com/olbat/nvdcve/blob/fe7f195231342e1e88104679c53c965e9a67ac35/nvdcve/CVE-2000-0871.json","https://github.com/opencve/opencve-kb/blob/7634b452e97baac8445d2f4e188785cc5c593d5a/2000/CVE-2000-0871.json","https://github.com/fkie-cad/nvd-json-data-feeds/blob/b5070d3c2d6dc2fda079c163276abcda1c82b124/CVE-2000/CVE-2000-08xx/CVE-2000-0871.json","https://github.com/HORKimhab/poc-cve-collection/blob/918ac66f0b50ab0d2a013bdf692688d3c0abefbc/2000/0xxx/CVE-2000-0871.md","https://github.com/CyberSecAI/cve_info/blob/03b7e36424574a3a9ba5fd13480a326b666a1046/2000/0xxx/CVE-2000-0871.json","https://github.com/CVEProject/cvelist-dev/blob/5b8fbb570438e8094550205589cc6f1d122acc94/2000/0xxx/CVE-2000-0871.json"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":[],"repo_exp_urls":[],"has_poc":false,"has_exp":false,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/2000/AVE-2000-0985.toml"},{"ave_id":"AVE-2000-0984","file_name":"2000/AVE-2000-0984.toml","cve_id":"CVE-2000-0870","title":"Eftp Eftp 缓冲区溢出远程拒绝服务漏洞","description":"EFTP（易文件传输协议）在数据处理过程中存在缓冲区溢出漏洞，攻击者可通过向目标系统发送特制的超长字符串触发溢出，导致缓冲区控制流被破坏并引发拒绝服务。该漏洞影响 EFTP 协议实现，远程攻击者无需身份验证即可触发，造成服务不可用。漏洞影响涉及系统可用性，可能导致网络文件传输服务中断，影响用户正常操作。该漏洞利用原始的网络协议通信特点，通过畸形报文引发程序异常，最终使服务进程崩溃或进入无限循环状态，持续消耗系统资源。","severity":"HIGH","score":7.5,"aliases":["CVE-2000-0870"],"sources":["avd"],"published":"2000-11-14T05:00:00Z","updated":"2026-06-16T21:52:38Z","remediation":"立即升级到最新版本的EFTP软件（如v2.1或更高版本），其中修复了缓冲区溢出漏洞。如果无法更新，建议通过防火墙禁用不必要的端口访问EFTP服务，并限制远程用户权限，防止攻击者提交超长数据导致服务拒绝。","status":"completed","collected_at":"2026-08-03T00:00:00Z","references":["http://archives.neohapsis.com/archives/bugtraq/2000-09/0089.html","http://www.osvdb.org/1555","http://www.securityfocus.com/bid/1675","https://exchange.xforce.ibmcloud.com/vulnerabilities/5219","https://github.com/CVEProject/cvelistV5/blob/0661b1b09ba7a2e855981f4a1781f3b8de7cf562/cves/2000/0xxx/CVE-2000-0870.json","https://github.com/Patrowl/PatrowlHearsData/blob/8a257d250bdb59b542a188d62ddae45e6eb5d3f2/CVE/data/2000/CVE-2000-0870.json","https://github.com/LiuCan01/cve-list-pro/blob/78b55511cee3604c22d518e32822f0435d0cacc0/cve-list/CVE-2000/CVE-2000-0870","https://github.com/nomi-sec/NVD-Database/blob/23dc120c34402aaa65883c51c1d03b3cb02c20cb/2000/CVE-2000-0870.json","https://github.com/olbat/nvdcve/blob/fe7f195231342e1e88104679c53c965e9a67ac35/nvdcve/CVE-2000-0870.json","https://github.com/fkie-cad/nvd-json-data-feeds/blob/b5070d3c2d6dc2fda079c163276abcda1c82b124/CVE-2000/CVE-2000-08xx/CVE-2000-0870.json","https://github.com/opencve/opencve-kb/blob/7753953b586683c230526e07a6b8b2948b832025/2000/CVE-2000-0870.json","https://github.com/HORKimhab/poc-cve-collection/blob/918ac66f0b50ab0d2a013bdf692688d3c0abefbc/2000/0xxx/CVE-2000-0870.md","https://github.com/CyberSecAI/cve_info/blob/03b7e36424574a3a9ba5fd13480a326b666a1046/2000/0xxx/CVE-2000-0870.json","https://github.com/CVEProject/cvelist-dev/blob/5b8fbb570438e8094550205589cc6f1d122acc94/2000/0xxx/CVE-2000-0870.json"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":[],"repo_exp_urls":[],"has_poc":false,"has_exp":false,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/2000/AVE-2000-0984.toml"},{"ave_id":"AVE-2000-0983","file_name":"2000/AVE-2000-0983.toml","cve_id":"CVE-2000-0868","title":"SuSE Linux Apache 读取源代码漏洞","description":"SuSE Linux 6.4 系统自带的 Apache 1.3.12 存在 Web 服务器源码泄露漏洞。由于默认配置中 CGI 脚本目录 /cgi-bin/ 与实际可执行脚本目录 /cgi-bin-sdb/ 的映射关系处理不当，未经身份认证的远程攻击者仅通过对 URL 路径进行简单替换，将请求中的 /cgi-bin/ 改为 /cgi-bin-sdb/，即可绕过 Apache 对 CGI 脚本的限制，直接读取 CGI 脚本的源代码。该漏洞属于目录别名配置错误导致的敏感信息泄露，攻击者无需任何认证即可利用，可获取服务器上 CGI 脚本的逻辑与源码，为进一步分析并实施攻击提供便利。该漏洞影响 SuSE Linux 6.4 及使用该默认 Apache 1.3.12 配置的版本，建议升级或修正 Apache 的脚本目录映射配置，并对不可信的 CGI 脚本访问请求实施拦截以降低泄露风险。","severity":"MEDIUM","score":5.0,"aliases":["CVE-2000-0868"],"sources":["avd"],"published":"2000-11-14T05:00:00Z","updated":"2026-06-16T21:52:38Z","remediation":"建议将 SuSE Linux 6.4 的 Apache 升级至 1.3.12 以上的修复版本（SuSE 官方已修复该默认配置缺陷），或安装 SuSE 发布的相应安全更新。若无法立即升级，可编辑 Apache 主配置文件 /etc/httpd/httpd.conf，删除或注释掉将 cgi 目录映射为源码下载的别名定义（尤其针对用于调试的 /cgi-bin-sdb/ 别名），并确保 /cgi-bin/ 对应的 ScriptAlias 配置启用 ExecCGI 且不允许以普通静态文件方式访问脚本源码，从配置层面阻断攻击者通过改写 URL 读取 CGI 脚本内容。","status":"completed","collected_at":"2026-08-03T00:00:00Z","references":["http://archives.neohapsis.com/archives/linux/suse/2000-q3/0906.html","http://www.atstake.com/research/advisories/2000/a090700-2.txt","http://www.securityfocus.com/bid/1658","https://exchange.xforce.ibmcloud.com/vulnerabilities/5197","https://github.com/CVEProject/cvelistV5/blob/0661b1b09ba7a2e855981f4a1781f3b8de7cf562/cves/2000/0xxx/CVE-2000-0868.json","https://github.com/Patrowl/PatrowlHearsData/blob/8a257d250bdb59b542a188d62ddae45e6eb5d3f2/CVE/data/2000/CVE-2000-0868.json","https://github.com/LiuCan01/cve-list-pro/blob/78b55511cee3604c22d518e32822f0435d0cacc0/cve-list/CVE-2000/CVE-2000-0868","https://github.com/nomi-sec/NVD-Database/blob/23dc120c34402aaa65883c51c1d03b3cb02c20cb/2000/CVE-2000-0868.json","https://github.com/olbat/nvdcve/blob/fe7f195231342e1e88104679c53c965e9a67ac35/nvdcve/CVE-2000-0868.json","https://github.com/opencve/opencve-kb/blob/7753953b586683c230526e07a6b8b2948b832025/2000/CVE-2000-0868.json","https://github.com/HORKimhab/poc-cve-collection/blob/918ac66f0b50ab0d2a013bdf692688d3c0abefbc/2000/0xxx/CVE-2000-0868.md","https://github.com/fkie-cad/nvd-json-data-feeds/blob/b5070d3c2d6dc2fda079c163276abcda1c82b124/CVE-2000/CVE-2000-08xx/CVE-2000-0868.json","https://github.com/CyberSecAI/cve_info/blob/03b7e36424574a3a9ba5fd13480a326b666a1046/2000/0xxx/CVE-2000-0868.json","https://github.com/CVEProject/cvelist-dev/blob/5b8fbb570438e8094550205589cc6f1d122acc94/2000/0xxx/CVE-2000-0868.json"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":["https://raw.githubusercontent.com/adysec/AVE/main/pocs/2000/POC-AVE-2000-0983.toml"],"repo_exp_urls":["https://raw.githubusercontent.com/adysec/AVE/main/exploits/2000/EXP-AVE-2000-0983.toml"],"has_poc":true,"has_exp":true,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/2000/AVE-2000-0983.toml"}]
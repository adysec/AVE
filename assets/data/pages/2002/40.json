[{"ave_id":"AVE-2002-0168","file_name":"2002/AVE-2002-0168.toml","cve_id":"CVE-2002-0081","title":"PHP 缓冲区溢出远程代码执行漏洞","description":"PHP 4.0.6 及更早版本、4.1.0/4.1.1 中的 php_mime_split 函数以及 PHP 3.0.x 中的 php3_mime_split 函数存在缓冲区溢出漏洞。当 file_uploads 选项启用时，远程攻击者可通过向目标服务器发送特制的 multipart/form-data HTTP POST 请求触发该漏洞，导致任意代码执行。该漏洞影响 PHP 3.0.x 至 4.1.1 版本，CVSS 评分 7.5，危害等级高，攻击者无需身份认证即可远程利用。","severity":"HIGH","score":7.5,"aliases":["CVE-2002-0081"],"sources":["redhat"],"published":"2002-03-08T05:00:00Z","updated":"2026-06-16T21:56:43Z","remediation":"立即升级 PHP 至 4.1.2 或更高版本（PHP 4.0.x 用户升级至 4.0.7 以上，PHP 3.0.x 用户升级至 4.x 系列）。各发行版用户请安装对应安全更新：Red Hat 安装 RHSA-2002:035/RHSA-2002:040、Debian 安装 DSA-115、Mandrake 安装 MDKSA-2002:017。如无法立即升级，可在 php.ini 中将 `file_uploads = Off` 作为临时缓解措施。","status":"completed","collected_at":"2026-07-27T00:00:00Z","references":["http://distro.conectiva.com.br/atualizacoes/?id=a&anuncio=000468","http://marc.info/?l=bugtraq&m=101484705523351&w=2","http://marc.info/?l=bugtraq&m=101497256024338&w=2","http://marc.info/?l=bugtraq&m=101537076619812&w=2","http://marc.info/?l=ntbugtraq&m=101484975231922&w=2","http://marc.info/?l=vuln-dev&m=101468694824998&w=2","http://online.securityfocus.com/advisories/3911","http://security.e-matters.de/advisories/012002.html","http://www.cert.org/advisories/CA-2002-05.html","http://www.debian.org/security/2002/dsa-115","http://www.iss.net/security_center/static/8281.php","http://www.kb.cert.org/vuls/id/297363","http://www.linux-mandrake.com/en/security/2002/MDKSA-2002-017.php","http://www.linuxsecurity.com/advisories/other_advisory-1924.html","http://www.novell.com/linux/security/advisories/2002_007_mod_php4_txt.html","http://www.php.net/downloads.php","http://www.redhat.com/support/errata/RHSA-2002-035.html","http://www.redhat.com/support/errata/RHSA-2002-040.html","http://www.securityfocus.com/bid/4183","https://github.com/trickest/cve/blob/be44b05b9428dc18bc0705cf60dd8d8640cd49b1/2002/CVE-2002-0081.md","https://github.com/CVEProject/cveli
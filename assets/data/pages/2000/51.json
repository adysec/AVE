270","http://www.securityfocus.com/bid/1085","http://www2.allaire.com/handlers/index.cfm?ID=15099&Method=Full","https://github.com/CVEProject/cvelistV5/blob/5c4b2ba2a59a96457ab4b8ea4ee82efc5782bb1d/cves/2000/0xxx/CVE-2000-0297.json","https://github.com/LiuCan01/cve-list-pro/blob/78b55511cee3604c22d518e32822f0435d0cacc0/cve-list/CVE-2000/CVE-2000-0297","https://github.com/yarencheng/cve-devops-playground/blob/cbe73d6bdcced13ea57f08566d6bbf5345864f7e/content/CVE-2000-0297.md","https://github.com/Patrowl/PatrowlHearsData/blob/475f53ac063af305fc146a443cce993188109d56/CVE/data/2000/CVE-2000-0297.json","https://github.com/github/advisory-database/blob/e6b10ee602769bd7be4675bf10e3382c1f100e32/advisories/unreviewed/2022/04/GHSA-j8c5-pxv3-7287/GHSA-j8c5-pxv3-7287.json","https://github.com/intSpLoiT/intframework/blob/eabaa799d0260aa52b735fa9769266d1ce4b64ef/modules/cve_list.txt","https://github.com/olbat/nvdcve/blob/5b92f5917a4a825187ccaac594f43456a77ea8f3/nvdcve/CVE-2000-0297.json","https://github.com/KTZgraph/sarenka/blob/f1fb931ab722d6c096d581ed6e3c5966d799fbaa/sarenka/feeds/cve_details/cve_all_details_152300_152400.json","https://github.com/Yuning-J/VulnerabilityClassifier/blob/c0f06c21b73c26b5ee2b75c21a498eb04eada4b5/threatPrediction/cveIDThreatType/cve_idbypass","https://github.com/nomi-sec/CVE-Easy-List/blob/1e58254e5bdaf937b4bd41c6a50d0d633bef0eb7/2000.tsv"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":["https://raw.githubusercontent.com/adysec/AVE/main/pocs/2000/POC-AVE-2000-0287.toml"],"repo_exp_urls":[],"has_poc":true,"has_exp":false,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/2000/AVE-2000-0287.toml"},{"ave_id":"AVE-2000-0262","file_name":"2000/AVE-2000-0262.toml","cve_id":"CVE-2000-0277","title":"Microsoft Excel 97/2000 XLM 文本宏自动执行漏洞","description":"Microsoft Excel 97 及 2000 版本在处理外部文本文件中的 Excel 宏语言（XLM）宏时，未向用户发出安全警告，导致攻击者可通过诱导用户打开包含恶意 XLM 宏的文本文件触发宏病毒执行。该漏洞影响 Excel 97/2000 等版本，CVSS 评分 7.2，危害等级高。攻击者无需身份认证，利用社会工程学手段即可实现任意代码执行。","severity":"HIGH","score":7.2,"aliases":["CVE-2000-0277"],"sources":["avd"],"published":"2000-04-03T04:00:00.000","updated":"2026-06-16T21:51:22.867","remediation":"Excel 97 用户需先安装 Office 97 Service Release 2，再安装 MS00-022 专用补丁；Excel 2000 用户应安装 Office 2000 Service Release 1。由于该版本已停止支持，建议升级到受支持的 Office 版本（如 Office 2016 及以上），同时在 Excel 中启用宏安全级别为\"禁用所有宏，并发出通知\"，并禁止从外部文本文件自动加载执行 XLM 宏。","status":"completed","collected_at":"2026-07-22T00:00:00Z","references":["http://www.osvdb.org/1272","http://www.securityfocus.com/bid/1087","https://docs.microsoft.com/en-us/security-updates/securitybulletins/2000/ms00-022","https://github.com/CVEProject/cvelistV5/blob/fbc52696b7594c66d398b40fcc0dc269121d7362/cves/2000/0xxx/CVE-2000-0277.json","https://github.com/LiuCan01/cve-list-pro/blob/78b55511cee3604c22d518e32822f0435d0cacc0/cve-list/CVE-2000/CVE-2000-0277","https://github.com/yarencheng/cve-devops-playground/blob/cbe73d6bdcced13ea57f08566d6bbf5345864f7e/content/CVE-2000-0277.md","https://github.com/Patrowl/PatrowlHearsData/blob/6af0515548db3ee9e7e86d58b079762631fa8897/CVE/data/2000/CVE-2000-0277.json","https://github.com/github/advisory-database/blob/e6b10ee602769bd7be4675bf10e3382c1f100e32/advisories/unreviewed/2022/04/GHSA-j2mj-gpqp-ph4f/GHSA-j2mj-gpqp-ph4f.json","https://github.com/KTZgraph/sarenka/blob/f1fb931ab722d6c096d581ed6e3c5966d799fbaa/sarenka/feeds/cwe_details/cwe_details_600_700.json","https://github.com/intSpLoiT/intframework/blob/eabaa799d0260aa52b735fa9769266d1ce4b64ef/modules/cve_list.txt","https://github.com/olbat/nvdcve/blob/5b92f5917a4a825187ccaac594f43456a77ea8f3/nvdcve/CVE-2000-0277.json","https://github.com/leego972/titanai/blob/afa5b2310463aae5781d3fd9408071bf38e79806/data/raw/corpus_D_cyber/nvd_cve_001260.txt","https://github.com/oasis-open/cti-stix-common-objects/blob/55ba7598cbd5a52577b6887871505d931d85cb61/objects/vulnerability/vulnerability--acc5c563-9029-46a4-b95f-87d160f3d3e6.json"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":[],"repo_exp_urls":[],"has_poc":false,"has_exp":fals
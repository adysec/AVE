[{"ave_id":"AVE-2015-0706","file_name":"2015/AVE-2015-0706.toml","cve_id":"CVE-2015-8651","title":"Adobe Flash Player和Adobe AIR整数溢出漏洞","description":"Adobe Flash Player 存在整数溢出漏洞（CWE-190），攻击者可通过构造恶意 Flash 内容在用户系统中触发整数溢出，进而实现任意代码执行。该漏洞影响 Windows、macOS 和 Linux 系统上的 Flash Player 18.0.0.324 之前版本、19.x 以及 20.0.0.267 之前的版本，同时波及 Adobe AIR 及 SDK/Compiler 20.0.0.233 之前的版本。攻击者需通过网络向目标发送恶意 SWF 或嵌入恶意 Flash 内容的网页，诱导用户通过浏览器访问，即可在无需身份认证的情况下实现远程代码执行，CVSS v3.1 评分为 8.8。CISA 已将本漏洞列入已知被利用漏洞目录，历史上曾被多起定向攻击和勒索软件组织利用，危害程度极高。","severity":"HIGH","score":8.8,"aliases":["CVE-2015-8651"],"sources":["kev"],"published":"2015-12-28T23:59:19.050","updated":"2026-06-17T00:34:57.970","remediation":"立即升级 Adobe Flash Player 至 20.0.0.267 版本（Windows/OS X）或 11.2.202.559 版本（Linux）；升级 Adobe AIR/AIR SDK/Compiler 至 20.0.0.233 版本。因 Flash Player 已于 2020 年底停止支持，强烈建议彻底卸载 Flash Player 并迁移至 HTML5 替代方案；若暂时无法卸载，请在浏览器设置中禁用 Flash 插件或配置点击播放策略作为临时缓解措施。","status":"completed","collected_at":"2026-07-25T00:00:00Z","references":["http://lists.opensuse.org/opensuse-security-announce/2015-12/msg00045.html","http://lists.opensuse.org/opensuse-security-announce/2015-12/msg00046.html","http://lists.opensuse.org/opensuse-security-announce/2015-12/msg00047.html","http://lists.opensuse.org/opensuse-security-announce/2015-12/msg00048.html","http://rhn.redhat.com/errata/RHSA-2015-2697.html","http://www.securityfocus.com/bid/79705","http://www.securitytracker.com/id/1034544","https://h20566.www2.hpe.com/portal/site/hpsc/public/kb/docDisplay?docId=emr_na-c05356388","https://h20566.www2.hpe.com/portal/site/hpsc/public/kb/docDisplay?docId=emr_na-c05385680","https://h20566.www2.hpe.com/portal/site/hpsc/public/kb/docDisplay?docId=emr_na-c05390722","https://helpx.adobe.com/security/products/flash-player/apsb16-01.html","https://security.gentoo.org/glsa/201601-03","https://www.cisa.gov/known-exploited-vulnerabilities-catalog?field_cve=CVE-2015-8651","https://github.com/trickest/cve/blob/d4b28c21b943332687c38515600e40190ff00a4e/2015/CVE-2015-8651.md","https://github.com/nomi-sec/PoC-in-GitHub/blob/a7134bcb421dcd50635dbcd395da27ad4c104761/2015/CVE-2015-8651.json","https://github.com/LiuCan01/cve-list-pro/blob/78b55511cee3604c22d518e32822f0435d0cacc0/cve-list/CVE-2015/CVE-2015-8651","https://github.com/jiji262/wooyun_articles/blob/047a8eaf7accf18e889faaa7043c5bb51430ec17/drops/%E6%B7%B1%E5%85%A5%E5%89%96%E6%9E%90%E6%9F%90%E5%9B%BD%E5%A4%96%E7%BB%84%E7%BB%87%E9%92%88%E5%AF%B9%E4%B8%AD%E5%9B%BD%E4%BC%81%E4%B8%9A%E7%9A%84APT%E6%94%BB%E5%87%BB(CVE-2015-8651).html","https://github.com/cisagov/vulnrichment/blob/cf9c3ae88cb7ef3fbb07b1a3ca376caed892be03/2015/8xxx/CVE-2015-8651.json","https://github.com/fankh/vulnerability-poc/blob/ffa50060b7ba6ae58d60d6d90533e77eaf10d466/2015/CVE-2015-8651/README.md","https://github.com/a-dhaou-tekup/VRA/blob/3e4f21c329250c5eca327489d3fd5be9b398ce7b/data/rag_corpus/cisa_kev_notes/CVE-2015-8651.txt","https://github.com/govbk/WIKI-POC-EXP/blob/7d1194429dab9f9dd8139408e79b70ddb41a468f/Security%20WiKi/011-drops/007-papers/062-%E6%B7%B1%E5%85%A5%E5%89%96%E6%9E%90%E6%9F%90%E5%9B%BD%E5%A4%96%E7%BB%84%E7%BB%87%E9%92%88%E5%AF%B9%E4%B8%AD%E5%9B%BD%E4%BC%81%E4%B8%9A%E7%9A%84APT%E6%94%BB%E5%87%BB(CVE-2015-8651).md","https://github.com/cyberdudebivash/cyberdudebivash-ai-security-hub/blob/18f8914e401b3086d2483ccc3fd79a5028186684/frontend/cve/CVE-2015-8651.html","https://github.com/su18/wooyun-drops/blob/b2a5416cbf0ad8be532513dd3db7f61c18f7d7de/papers/%E6%B7%B1%E5%85%A5%E5%89%96%E6%9E%90%E6%9F%90%E5%9B%BD%E5%A4%96%E7%BB%84%E7%BB%87%E9%92%88%E5%AF%B9%E4%B8%AD%E5%9B%BD%E4%BC%81%E4%B8%9A%E7%9A%84APT%E6%94%BB%E5%87%BB(CVE-2015-8651).md","https://github.com/Gitlabpro/The-analysis-of-the-cve-2015-8651"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":[],"repo_exp_urls":[],"has_poc":false,"has_exp":false,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/2015/AVE-2015-0706.toml"},{"ave_id":"AVE-2015-0700","file_name":"2015/AVE-2015-0700.toml","cve_id":"CVE-2015-7755","title":"瞻博网络 ScreenOS 认证后门漏洞","description":"Juniper Networks ScreenOS 固件存在未授权的硬编码后门账户漏洞。未经身份认证的远程攻击者可利用该后门，通过在 SSH 或 TELNET 远程会话中输入特定的后门密码，绕过身份认证机制获得设备的管理员权限。该漏洞影响 ScreenOS 6.2.0r15 至 6.2.0r18 以及 6.3.0r12 至 6.3.0r20 等多个版本，CVSS 评分 9.8，危害等级严重。攻击者可利用该后门完全控制受影响的网络设备，进而读取、修改设备配置并截获网络流量。Juniper 已确认此漏洞并发布安全公告，受影响用户应及时升级至修复版本。","severity":"CRITICAL","score":9.8,"aliases":["CVE-2015-7755"],"sources":["kev"],"published":"2015-12-19T14:59:01.453","updated":"2026-06-17T00:33:04.553","remediation":"立即升级 Juniper ScreenOS 至修复版本：6.2 分支升级至 6.2.0r19 或更高版本；6.3 分支升级至 6.3.0r12b、6.3.0r13b、6.3.0r14b、6.3.0r15b、6.3.0r16b、6.3.0r17b、6.3.0r18b、6.3.0r19b 或 6.3.0r21 及以上版本。若无法立即升级，请在防火墙策略中禁用 SSH 和 Telnet 管理访问，或仅允许受信任 IP 访问管理端口作为临时缓解措施。","status":"completed","collected_at":"2026-07-25T00:00:00Z","references":["http://arstechnica.com/security/2015/12/unauthorized-code-in-juniper-firewalls-decrypts-encrypted-vpn-traffic/","http://kb.juniper.net/InfoCenter/index?page=content&id=JSA10713","http://twitter.com/cryptoron/statuses/677900647560253442","http://www.forbes.com/sites/thomasbrewster/2015/12/18/juniper-says-it-didnt-work-with-government-to-add-unauthorized-code-to-network-gear/","http://www.kb.cert.org/vuls/id/640184","http://www.securityfocus.com/bid/79626","http://www.securitytracker.com/id/1034489","http://www.wired.com/2015/12/juniper-networks-hidden-backdoors-show-the-risk-of-government-backdoors/","https://adamcaudill.com/2015/12/17/much-ado-about-juniper/","https://forums.juniper.net/t5/Security-Incident-Response/Important-Announcement-about-ScreenOS/ba-p/285554","https://github.com/hdm/juniper-cve-2015-7755","https://www.cisa.gov/known-exploited-vulnerabilities-catalog?field_cve=CVE-2015-7755","https://github.com/trickest/cve/blob/d4b28c21b943332687c38515600e40190ff00a4e/2015/CVE-2015-7755.md","https://github.com/nomi-sec/PoC-in-GitHub/blob/a7134bcb421dcd50635dbcd395da27ad4c104761/2015/CVE-2015-7755.json","https://github.com/rapid7/metasploit-framework/blob/472bd8320e2c6801740215e4aff621ae2ae69c83/modules/auxiliary/scanner/ssh/juniper_backdoor.rb","https://github.com/rix4uni/cvemapping/blob/4bd7e871438f4c40b63fb396ac47b9f385a2b52b/2015/CVE-2015-7755/CVE-2015-7755_JuniperPOC.py","https://github.com/wonderkun/crawler/blob/281e1d1564e073bd4c1322f63767c0f4fbfcf5eb/www.anquanke.com/CVE-2015-7755_%20Juniper%20ScreenOS%E8%AE%A4%E8%AF%81%E5%90%8E%E9%97%A8%E5%88%86%E6%9E%90.md","https://github.com/ARPSyndicate/suricata-vedas/blob/fe24794ad36564b5bbc7c69101525011387b8650/2015/CVE-2015-7755.rules","https://github.com/CVEProject/cvelistV5/blob/3290bfd28d98351fcc1665e3427425a500ba46e2/cves/2015/7xxx/CVE-2015-7755.json","https://github.com/w-digital-scanner/w9scan/blob/aa725571897f095635c4b7660db5ce90c655946c/plugins/ip/2089.py","https://github.com/fankh/vulnerability-poc/blob/ffa50060b7ba6ae58d60d6d90533e77eaf10d466/2015/CVE-2015-7755/README.md","https://github.com/Simpsonpt/AppSecEzine/blob/5f446fcfcccf21c49b6f4258aeb7ced58439d410/Ezines/97%20-%20AppSec%20Ezine","https://github.com/cinno/CVE-2015-7755-POC"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":[],"repo_exp_urls":[],"has_poc":false,"has_exp":false,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/2015/AVE-2015-0700.toml"},{"ave_id":"AVE-2015-0609","file_name":"2015/AVE-2015-0609.toml","cve_id":"CVE-2015-6175","title":"Microsoft Windows 内核内存特权提升漏洞","description":"Microsoft Windows 10 内核存在内存权限提升漏洞，未经身份验证的本地低权限用户可通过构造恶意应用程序触发该漏洞，实现向 SYSTEM 权限的特权提升。该漏洞的影响范围包括 Windows 10 Gold 及 Windows 10 初始版本（x86 与 x64 架构），攻击者仅需在目标系统上以普通用户身份运行特制程序即可利用，无需额外权限。成功利用后，攻击者可在内核级别执行任意代码，完全控制受影响系统，进而安装程序、查看或修改敏感数据、创建具有完全管理权限的账户，对系统机密性和完整性造成严重威胁。该漏洞 CVSS v3 评分为 7.8（高危），并被 CISA 列入已知被利用漏洞目录，已在真实攻击中被广泛利用。Microsoft 在 2015 年 12 月发布的安全公告 MS15-135 中提供了修复补丁，受影响用户应尽快安装该安全更新以消除风险。","severity":"HIGH","score":7.8,"aliases":["CVE-2015-6175"],"sources":["kev"],"published":"2015-12-09T11:59:56.580","updated":"2026-06-17T00:30:30.480","remediation":"安装 Microsoft 2015 年 12 月安全更新 MS15-135，对应 KB3119075（Windows Vista/7/8/Server 2008/Server 2012）或 KB3116869（Windows 10），可通过 Windows Update 自动获取，亦可在 Microsoft Update Catalog 手动下载安装。如暂时无法打补丁，建议在防火墙或组策略中限制本地低权限用户运行未签名或任意来源应用程序的权限，以降低本地提权攻击成功概率。该漏洞已被 CISA 列入已知被利用漏洞目录，建议优先安排补丁部署。","status":"completed","collected_at":"2026-07-24T00:00:00Z","references":["http://www.securitytracker.com/id/1034334","https://docs.microsoft.com/en-us/security-updates/securitybulletins/2015/ms15-135","https://www.cisa.gov/known-exploited-vulnerabilities-catalog?field_cve=CVE-2015-6175","https://github.com/trickest/cve/blob/d4b28c21b943332687c38515600e40190ff00a4e/2015/CVE-2015-6175.md","https://github.com/CVEProject/cvelistV5/blob/443201f18f73f1db21c099e42f4e1967b96993dc/cves/2015/6xxx/CVE-2015-6175.json","https://github.com/LiuCan01/cve-list-pro/blob/78b55511cee3604c22d518e32822f0435d0cacc0/cve-list/CVE-2015/CVE-2015-6175","https://github.com/cisagov/vulnrichment/blob/3d20146fe31e76b5443be51ca0e94122b00af63b/2015/6xxx/CVE-2015-6175.json","https://github.com/a-dhaou-tekup/VRA/blob/3e4f21c329250c5eca327489d3fd5be9b398ce7b/data/rag_corpus/cisa_kev_notes/CVE-2015-6175.txt","https://github.com/cyberdudebivash/cyberdudebivash-ai-security-hub/blob/bc81b65ff03afc15c78504c9249fb5f2b24454d7/frontend/cve/CVE-2015-6175.html","https://github.com/Ostorlab/KEV/blob/8feadeb8b7ff54359eab87941769781629146b23/README.md","https://github.com/lucacapacci/cisa_kev/blob/798a31226c5b1d5c9cc61c5fe52f04996d380b21/data_single/2015/CVE-2015-6175.csv","https://github.com/mabitoski/cve_submodules/blob/44ad7e2705b3aef1b2ffaf64bd47596c10a6c2e4/2015/CVE-2015-6175.md","https://github.com/github/advisory-database/blob/a296135b4fb6684177b1ef84e538a96d91a93adb/advisories/unreviewed/2022/05/GHSA-4r4r-223f-8hjj/GHSA-4r4r-223f-8hjj.json"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":[],"repo_exp_urls":[],"has_poc":false,"has_exp":false,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/2015/AVE-2015-0609.toml"},{"ave_id":"AVE-2015-0608","file_name":"2015/AVE-2015-0608.toml","cve_id":"CVE-2015-5317","title":"CloudBees Jenkins 信息泄露漏洞","description":"CloudBees Jenkins 在 1.638 之前的版本以及 LTS 1.625.2 之前的版本中，Fingerprints 页面存在信息泄露漏洞。未经身份认证的远程攻击者可通过直接发送 HTTP 请求访问该页面，获取敏感的作业（Job）和构建（Build）名称信息。该漏洞影响所有使用受影响版本 Jenkins 的系统，攻击条件宽松，无需认证即可利用。CVSS 评分为 7.5，危害等级为 HIGH。Jenkins 官方已在后续版本中修复此问题，建议用户升级至 Jenkins 1.638 或 LTS 1.625.2 及以上版本。","severity":"HIGH","score":7.5,"aliases":["CVE-2015-5317"],"sources":["kev"],"published":"2015-11-25T20:59:07.680","updated":"2026-06-17T00:28:55.150","remediation":"立即将 Jenkins 升级至 1.638 或更高版本，或将 Jenkins LTS 升级至 1.625.2 或更高版本以修复信息泄露漏洞。如无法立即升级，可通过 Jenkins 反向代理或防火墙规则限制对 /fingerprints/ 路径的未授权外部访问，仅允许可信 IP 范围访问该端点作为临时缓解措施。","status":"completed","collected_at":"2026-07-24T00:00:00Z","references":["http://rhn.redhat.com/errata/RHSA-2016-0489.html","https://access.redhat.com/errata/RHSA-2016:0070","https://wiki.jenkins-ci.org/display/SECURITY/Jenkins+Security+Advisory+2015-11-11","https://www.cisa.gov/known-exploited-vulnerabilities-catalog?field_cve=CVE-2015-5317","https://github.com/trickest/cve/blob/d4b28c21b943332687c38515600e40190ff00a4e/2015/CVE-2015-5317.md","https://github.com/CVEProject/cvelistV5/blob/9fdf581dbf8be77b6942da71b599d68003a669b8/cves/2015/5xxx/CVE-2015-5317.json","https://github.com/LiuCan01/cve-list-pro/blob/78b55511cee3604c22d518e32822f0435d0cacc0/cve-list/CVE-2015/CVE-2015-5317","https://github.com/joaomatosf/jexboss/blob/338b531a2a2aee9d294f394086d6718b60526350/README.md","https://github.com/cisagov/vulnrichment/blob/7fa480de4a35333628fd1174156087809fb9b203/2015/5xxx/CVE-2015-5317.json","https://github.com/Tabll/gemnasium-db/blob/61c26bb0fa513d67ff37c47a0aee18a8017dee2d/maven/org.jenkins-ci.main/jenkins-core/CVE-2015-5317.yml","https://github.com/a-dhaou-tekup/VRA/blob/3e4f21c329250c5eca327489d3fd5be9b398ce7b/data/rag_corpus/cisa_kev_notes/CVE-2015-5317.txt","https://github.com/cyberdudebivash/cyberdudebivash-ai-security-hub/blob/bc81b65ff03afc15c78504c9249fb5f2b24454d7/frontend/cve/CVE-2015-5317.html","https://github.com/jenkins-infra/jenkins.io/blob/98ef77f1a5c6452ca52aa5456602e35207785eb3/content/security/advisory/2015-11-11.adoc","https://github.com/1120362990/vulnerability-list/blob/ef35be4029f4e7160e64d8339f9e43513a7fc40f/jboss/jexboss.py"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":["https://raw.githubusercontent.com/adysec/AVE/main/pocs/2015/POC-AVE-2015-0608.toml"],"repo_exp_urls":["https://raw.githubusercontent.com/adysec/AVE/main/exploits/2015/EXP-AVE-2015-0608.toml"],"has_poc":true,"has_exp":true,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/2015/AVE-2015-0608.toml"},{"ave_id":"AVE-2015-0509","file_name":"2015/AVE-2015-0509.toml","cve_id":"CVE-2015-4852","title":"Oracle WebLogic Server T3 反序列化远程代码执行漏洞","description":"Oracle WebLogic Server 的 WLS Security 组件在处理 T3 协议流量时存在 Java 反序列化漏洞。远程攻击者可通过 TCP 7001 端口向目标服务器发送特制的序列化 Java 对象，利用 Apache Commons Collections 等组件中的反序列化链，在无需身份认证的情况下执行任意操作系统命令，实现远程代码执行。该漏洞影响 Oracle WebLogic Server 10.3.6.0、12.1.2.0、12.1.3.0 及 12.2.1.0 等版本，CVSS v3.1或将评分为 9.8，危害等级严重。攻击者仅需网络可达目标服务器即可发起利用，且已有公开 PoC 及在野利用记录，建议立即升级至官方安全补丁版本并限制 7001 端口的网络访问。","severity":"CRITICAL","score":9.8,"aliases":["CVE-2015-4852"],"sources":["kev"],"published":"2015-11-18T15:59:00.133","updated":"2026-06-17T00:28:02.700","remediation":"建议立即安装 Oracle WebLogic Server October 2015 Critical Patch Update（CPU），10.3.6.0 升级到 10.3.6.0.6，12.1.2.0/12.1.3.0/12.2.1.0 应用对应补丁集更新。若无法立即打补丁，应在防火墙或网络层面限制 TCP 7001 端口的 T3 协议访问权限，仅允许可信来源 IP 连接，作为临时缓解措施。","status":"completed","collected_at":"2026-07-24T00:00:00Z","references":["http://foxglovesecurity.com/2015/11/06/what-do-weblogic-websphere-jboss-jenkins-opennms-and-your-application-have-in-common-this-vulnerability/","http://packetstormsecurity.com/files/152268/Oracle-Weblogic-Server-Deserialization-Remote-Code-Execution.html","http://www.openwall.com/lists/oss-security/2015/11/17/19","http://www.oracle.com/technetwork/security-advisory/cpuapr2017-3236618.html","http://www.oracle.com/technetwork/security-advisory/cpujan2018-3236628.html","http://www.oracle.com/technetwork/security-advisory/cpuoct2016-28
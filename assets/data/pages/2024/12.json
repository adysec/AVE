agov/vulnrichment/blob/6d175f59444084675ba336cc9e2bc51fc5338e6d/2024/12xxx/CVE-2024-12087.json","https://github.com/bell-sw/osv-database/blob/ee84993ad655ae5f90f9948f27d13851ad8b9fd3/BELL-CVE/BELL-CVE-2024-12087.json"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":[],"repo_exp_urls":[],"has_poc":false,"has_exp":false,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/2024/AVE-2024-0476.toml"},{"ave_id":"AVE-2024-0475","file_name":"2024/AVE-2024-0475.toml","cve_id":"CVE-2024-12086","title":"Rsync 服务器端泄露客户端任意文件漏洞","description":"Rsync 文件同步工具中存在客户端文件信息泄露漏洞（CWE-390），攻击者可通过搭建恶意 rsync 服务器诱导客户端连接。在文件从客户端向服务端传输过程中，服务端会发送本地文件的校验和供客户端比对以确定需传输的数据。恶意服务端通过发送针对任意文件的特制校验和值，基于客户端的响应逐字节重建客户端文件内容，导致敏感信息泄露。该漏洞影响所有使用 rsync 进行文件传输的场景，CVSS 评分 6.1，危害等级中危。","severity":"MEDIUM","score":6.1,"aliases":["CVE-2024-12086"],"sources":["msrc"],"published":"2025-01-14T18:15:25Z","updated":"2026-06-30T00:16:48Z","remediation":"立即将 rsync 升级至 3.4.0 或更高版本。RHEL 用户安装 RHSA-2026:19368/RHSA-2026:20603 等安全更新；Debian 用户参照 DLA-2025-008 更新至修复版本。如无法升级，避免使用 rsync 从不可信服务器拉取文件，或使用 --dry-run 预览文件操作后再执行。","status":"completed","collected_at":"2026-07-22T00:00:00Z","references":["https://access.redhat.com/errata/RHBA-2025:6470","https://access.redhat.com/errata/RHSA-2026:19368","https://access.redhat.com/errata/RHSA-2026:20603","https://access.redhat.com/errata/RHSA-2026:29197","https://access.redhat.com/security/cve/CVE-2024-12086","https://bugzilla.redhat.com/show_bug.cgi?id=2330577","https://kb.cert.org/vuls/id/952657","https://lists.debian.org/debian-lts-announce/2025/01/msg00008.html","https://security.netapp.com/advisory/ntap-20250131-0002/","https://www.kb.cert.org/vuls/id/952657","https://github.com/google/security-research/security/advisories/GHSA-p5pg-x43v-mvqj","https://github.com/trickest/cve/blob/ed228d55b7972f63e700a35a54fbcd94064b9ade/2024/CVE-2024-12086.md","https://github.com/CVEProject/cvelistV5/blob/fbc52696b7594c66d398b40fcc0dc269121d7362/cves/2024/12xxx/CVE-2024-12086.json","https://github.com/c
[{"ave_id":"AVE-2023-0120","file_name":"2023/AVE-2023-0120.toml","cve_id":"无","title":"Nuclei HTTP 配置文件 YAML 解析漏洞","description":"该漏洞存在于Nuclei HTTP测试框架中，受影响的组件是YAML配置解析器。攻击者可以通过提供恶意YAML文件触发解析过程中的处理异常，导致应用崩溃或可能执行任意代码。此类漏洞通常存在于使用PYYAML库解析用户输入配置的软件中。相关漏洞类型包括代码执行、拒绝服务和不正确的解析。","severity":"MEDIUM","score":5.0,"aliases":["NUCLEI-HTTP-CNVD-2023-CNVD-C-2023-76801-YAML"],"sources":["nuclei","cnvd"],"published":"2023-08-01T00:00:00Z","updated":"2023-11-15T00:00:00Z","remediation":"升级到Nuclei 2.9.7或更高版本，升级到PYYAML 6.0或更高版本。","status":"completed","collected_at":"2026-07-14T23:20:36Z","references":["https://github.com/projectdiscovery/nuclei/releases/tag/v2.9.7"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":[],"repo_exp_urls":[],"has_poc":false,"has_exp":false,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/2023/AVE-2023-0120.toml"},{"ave_id":"AVE-2023-0001","file_name":"2023/AVE-2023-0001.toml","cve_id":"CVE-2023-3792","title":"网康 NS-ASG 安全网关信息泄露漏洞","description":"网康 NS-ASG 安全网关 6.3 版本中 /admin/test_status.php 接口存在直接请求漏洞。未经授权的远程攻击者可通过直接访问该接口获取敏感信息，导致信息泄露。该漏洞源于应用程序未对管理员后台接口实施有效的访问控制（CWE-425），攻击者无需认证即可通过构造特定 HTTP 请求利用此漏洞。CVSS 评分 4.3，危害等级中危。厂商已获知漏洞报告但未给出官方回应。","severity":"MEDIUM","score":4.3,"aliases":["CVE-2023-3792"],"sources":["hwpoc"],"published":"2023-07-20T19:15:10Z","updated":"2026-06-17T06:14:51Z","remediation":"在反向代理或WAF中添加规则，禁止外网直接访问/admin/路径，仅允许可信管理IP段（如内网192.168.0.0/16）访问/admin/test_status.php等管理页面。同时在NS-ASG设备上启用管理接口IP白名单，限制仅特定IP可登录管理后台。由于厂商未提供官方补丁，建议联系网康科技（400-950-15）确认最新修复版本，或评估升级到受支持的ASG版本以消除风险。","status":"completed","collected_at":"2026-07-13T00:00:00Z","references":["https://github.com/CYN521/cve/blob/main/NS-ASG.md","https://vuldb.com/?ctiid.235059","https://vuldb.com/?id.235059","https://nvd.nist.gov/vuln/detail/CVE-2023-3792"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":["https://raw.githubusercontent.com/adysec/AVE/main/pocs/2023/POC-AVE-2023-0001.toml"],"repo_exp_urls":["https://raw.githubusercontent.com/adysec/AVE/main/exploits/2023/EXP-AVE-2023-0001.toml"],"has_poc":true,"has_exp":true,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/2023/AVE-2023-0001.toml"},{"ave_id":"AVE-2023-0339","file_name":"2023/AVE-2023-0339.toml","cve_id":"CVE-2023-37464","title":"OpenIDC cjose AES GCM 解密身份验证标签长度不正确漏洞","description":"OpenIDC/cjose 库在 AES GCM 解密时错误地使用了 JWE 中实际提供的认证标签长度，而非规范要求的固定 16 字节长度。攻击者可通过提供截断的认证标签并相应修改 JWE 载荷触发该漏洞，导致数据完整性校验被绕过。该漏洞影响所有使用 AES GCM 加密算法的 cjose 版本，CVSS 评分 8.6，危害等级高。用户需升级至 0.6.2.2 及以上版本修复。","severity":"HIGH","score":8.6,"aliases":["CVE-2023-37464"],"sources":["msrc"],"published":"2023-07-14T21:15:08Z","updated":"2026-06-17T06:08:16Z","remediation":"升级 cjose 至 >=0.6.2.2 版本。无法升级时，在应用配置中将加密算法从 AES GCM 切换到 AES CBC，禁用 GCM 模式使用。","status":"completed","collected_at":"2026-07-22T00:00:00Z","references":["https://datatracker.ietf.org/doc/html/rfc7518#section-4.7","https://github.com/OpenIDC/cjose/commit/7325e9a5e71e2fc0e350487ecac7d84acdf0ed5e","https://github.com/OpenIDC/cjose/releases/tag/v0.6.2.2","https://github.com/OpenIDC/cjose/security/advisories/GHSA-3rhg-3gf2-6xgj","https://lists.debian.org/debian-lts-announce/2023/08/msg00002.html","https://lists.fedoraproject.org/archives/list/package-announce@lists.fedoraproject.org/message/DFWAPMYYVBO2U65HPYDTBEKNSXG4TP5C/","https://lists.fedoraproject.org/archives/list/package-announce@lists.fedoraproject.org/message/LCQJXKDPCWCXB2V4JMQ3UWYJ4UIBPUW6/","https://lists.fedoraproject.org/archives/list/package-announce@lists.fedoraproject.org/message/PTZHOVGY7AHGNMEY245HK4Q36AMA53AL/","https://www.debian.org/security/2023/dsa-5472","https://github.com/trickest/cve/blob/3ffa2a96db84a89f71e1c7ad889e5f4fcc755a48/2023/CVE-2023-37464.md","https://github.com/CVEProject/cvelistV5/blob/837e8232e5e0f859088f714711fc711909aefe8c/cves/2023/37xxx/CVE-2023-37464.json","https://github.com/canonical/ubuntu-security-notices/blob/935010a28fdab6bbd2dc347ebc953db9773080d4/osv/cve/2023/UBUNTU-CVE-2023-37464.json","https://github.com/microsoft/azurelinux/blob/dabd751ebee99e2986a17e0dd685d32ee33f3524/specs/c/cjose/cjose.spec","https://github.com/EGI-Federation/SVG-advisories/blob/81083d796997366d2004dbfee7fa7406e87cd57e/2023/Advisory-SVG-CVE-2023-37464.md","https://github.com/kees/ubuntu-cve-tracker/blob/66a43c37da527bc16621fb5548dca8aa1f46e537/active/CVE-2023-37464","https://github.com/alpinelinux/aports/blob/9423bc929e1be211017751517de96adbdf361c82/community/cjose/APKBUILD","https://github.com/cisagov/vulnrichment/blob/ecab81d7d04fc29e521ba40362078f57ea679e40/2023/37xxx/CVE-2023-37464.json","https://github.com/ElectricNroff/test2/blob/b264e0b0e0bee977aa036a25a79baad17899f89b/references/CVE-2023-37464-2023-09-10-0204","https://github.com/ctrliq/advisories/blob/b05bfbc3a1de170377430c48777435c2cc639f64/csaf/vex/cve/2023/cve-2023-37464.json"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":[],"repo_exp_urls":[],"has_poc":false,"has_exp":false,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/2023/AVE-2023-0339.toml"},{"ave_id":"AVE-2023-0207","file_name":"2023/AVE-2023-0207.toml","cve_id":"无","title":"华为产品安全漏洞导致拒绝服务风险","description":"华为产品存在安全漏洞，攻击者可能利用该漏洞导致拒绝服务或信息泄露，影响系统正常运行和数据安全","severity":"MEDIUM","score":5.0,"aliases":["HWPOC-2023-01fe5e9d"],"sources":["hwpoc"],"published":"2023-06-15T00:00:00Z","updated":"2023-09-20T00:00:00Z","remediation":"升级到厂商发布的最新固件版本，在边界防火墙上配置访问控制策略限制非必要端口，禁用受影响设备的远程管理功能","status":"completed","collected_at":"2026-07-16T17:24:35Z","references":[],"poc_urls":[],"exp_urls":[],"repo_poc_urls":[],"repo_exp_urls":[],"has_poc":false,"has_exp":false,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/2023/AVE-2023-0207.toml"},{"ave_id":"AVE-2023-0115","file_name":"2023/AVE-2023-0115.toml","cve_id":"无","title":"宏景eHR人力资源管理系统SQL注入漏洞","description":"宏景eHR人力资源管理软件存在SQL注入漏洞，未经过身份认证的远程攻击者可利用categories参数构造恶意SQL语句，执行任意SQL指令，从而窃取后端数据库中敏感信息，如用户凭证、人事数据等。","severity":"CRITICAL","score":9.8,"aliases":["NUCLEI-HTTP-CNVD-2023-CNVD-2023-08743-YAML","CNVD-2023-08743"],"sources":["nuclei","cnvd"],"published":"2023-06-01T00:00:00Z","updated":"2026-07-14T00:00:00Z","remediation":"升级宏景eHR至8.2或更高版本，联系厂商获取安全补丁。同时建议对categories参数实施严格的输入过滤和参数化查询，防止SQL注入攻击。","status":"completed","collected_at":"2026-07-14T21:39:51Z","references":["https://blog.csdn.net/qq_41904294/article/details/130944159","https://github.com/projectdiscovery/nuclei-templates/blob/main/http/cnvd/2023/CNVD-2023-08743.yaml"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":[],"repo_exp_urls":[],"has_poc":false,"has_exp":false,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/2023/AVE-2023-0115.toml"},{"ave_id":"AVE-2023-0093","file_name":"2023/AVE-2023-0093.toml","cve_id":"无","title":"泛微 e-cology9 WorkflowService SQL注入漏洞","description":"泛微e-cology9办公自动化系统的WorkflowService组件存在SQL注入漏洞，攻击者可通过构造恶意POST请求向WorkflowService接口的特定参数中注入SQL语句，绕过系统输入验证机制执行任意SQL命令。成功利用该漏洞可导致数据库中的敏感业务数据泄露、数据被篡改删除，甚至可能获取数据库服务器操作系统级别的控制权限。该漏洞影响e-cology9版本流程管理核心功能，攻击无需身份认证，远程攻击者利用难度较低。","severity":"MEDIUM","score":5.0,"aliases":["HWPOC-2023-02028b03"],"sources":["hwpoc"],"published":"2023-06-01T00:00:00Z","updated":"2023-08-08T00:00:00Z","remediation":"联系泛微官方获取e-cology9 WorkflowService SQL注入安全补丁，或从官方安全补丁下载中心（www.weaver.com.cn/cs/securityDownload.asp）下载E9最新全量安全补丁进行升级安装。临时缓解措施包括：在WAF或反向代理中配置SQL注入检测规则拦截对/workflow/WorkflowService等接口的恶意参数；限制该接口仅允许可信IP来源访问；检查并关闭不必要的流程服务暴露端口。","status":"completed","collected_at":"2023-08-08T00:00:00Z","references":["https://www.weaver.com.cn/cs/securityDownload.asp"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":[],"repo_exp_urls":[],"has_poc":false,"has_exp":false,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/2023/AVE-2023-0093.toml"},{"ave_id":"AVE-2023-0336","file_name":"2023/AVE-2023-0336.toml","cve_id":"CVE-2023-2804","title":"libjpeg-turbo 堆缓冲区溢出漏洞","description":"libjpeg-turbo 的 jdmrgext.c 文件中 h2v2_merged_upsample_internal() 函数存在基于堆的缓冲区溢出漏洞。该漏洞仅在 12 位数据精度下可被利用，此时样本数据类型范围超出有效样本范围。攻击者可通过构造包含越界 12 位样本的无损 JPEG 图像，诱使目标应用使用合并上采样方式解压该图像，触发段错误或缓冲区溢出，导致应用崩溃。影响所有使用受影响版本 libjpeg-turbo 的系统和应用。","severity":"MEDIUM","score":6.5,"aliases":["CVE-2023-2804"],"sources":["msrc"],"published":"2023-05-25T22:15:09Z","updated":"2026-06-17T05:53:28Z","remediation":"该漏洞仅影响 libjpeg-turbo 2.1.90（3.0 beta1），已在其 2.1.91（3.0 beta2）版本中修复。立即升级到 libjpeg-turbo 3.0.0 或更高版本。对于无法立即升级的环境，在调用 djpeg 解压 12 位无损 JPEG 图像时添加 `-nosmooth` 参数可禁用 merged upsampling 作为临时缓解措施。应用程序开发者也应在代码层面避免对 12 位精度图像使用 merged upsampling 处理路径。","status":"completed","collected_at":"2026-07-22T00:00:00Z","references":["https://access.redhat.com/security/cve/CVE-2023-2804","https://bugzilla.redhat.com/show_bug.cgi?id=2208447","https://github.com/libjpeg-turbo/libjpeg-turbo/commit/9f756bc67a84d4566bf74a0c2432aa55da404021","https://github.com/libjpeg-turbo/libjpeg-turbo/issues/668#issuecomment-1492586118","https://github.com/libjpeg-turbo/libjpeg-turbo/issues/675","https://www.intel.com/content/www/us/en/security-center/advisory/intel-sa-01006.html","https://github.com/trickest/cve/blob/3ffa2a96db84a89f71e1c7ad889e5f4fcc755a48/2023/CVE-2023-2804.md","https://github.com/CVEProject/cvelistV5/blob/837e8232e5e0f859088f714711fc711909aefe8c/cves/2023/2xxx/CVE-2023-2804.json","https://github.com/sumatrapdfreader/sumatrapdf/blob/1d6244a27af1f2769927ceae701957f9d96cf948/ext/libjpeg-turbo/ChangeLog.md","https://github.com/cisagov/vulnrichment/blob/ecab81d7d04fc29e521ba40362078f57ea679e40/2023/2xxx/CVE-2023-2804.json","https://github.com/eslerm/ubuntu-cve-tracker/blob/f17e5ebf7a87347cc68d8fae347d07409a857342/retired/CVE-2023-2804","https://github.com/alpinelinux/aports/blob/c6636dded79203a5eb50ecd452ad5cce24b08f87/main/libjpeg-turbo/APKBUILD","https://github.com/mozilla/mozjpeg/blob/08265790774cd0714832c9e675522acbe5581437/ChangeLog.md","https://github.com/github/advisory-database/blob/a96652a2a06e880f217d1d6526622d8501dbbd69/advisories/unreviewed/2023/05/GHSA-jv36-3qpq-7g23/GHSA-jv36-3qpq-7g23.json","https://github.com/mabitoski/cve_submodules/blob/44ad7e2705b3aef1b2ffaf64bd47596c10a6c2e4/2023/CVE-2023-2804.md","https://github.com/OpenHD/rockchip-sdk/blob/01cc45b8cbf2a6fb6c629b287f053b667570a03a/yocto/poky/meta/recipes-graphics/jpeg/files/CVE-2023-2804-2.patch"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":[],"repo_exp_urls":[],"has_poc":false,"has_exp":false,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/2023/AVE-2023-0336.toml"},{"ave_id":"AVE-2023-0139","file_name":"2023/AVE-2023-0139.toml","cve_id":"CVE-2023-2648","title":"泛微 E-Office v9.5 文件上传漏洞","description":"泛微 E-Office v9.5 系统中存在一个危险的文件类型上传漏洞，攻击者可通过 /inc/jquery/uploadify/uploadify.php 上传恶意文件（如 php 文件）。由于缺乏有效验证，攻击者可以上传恶意脚本并在服务器上执行代码，完全控制目标系统，导致数据泄露、篡改或破坏，威胁企业信息安全。该漏洞仅需要网络访问权限即可触发，风险极高。","severity":"CRITICAL","score":9.8,"aliases":["CVE-2023-2648","HWPOC-2023-029da3bd"],"sources":["cve"],"published":"2023-05-11T00:00:00Z","updated":"2026-07-16T00:00:00Z","remediation":"升级到泛微 E-Office 10.0 或更高版本，并配置 IIS URL 校验以禁止 .php 文件上传，同时使用上传文件类型白名单验证和文件内容检测，增强 Web 应用防火墙规则，并定期进行安全扫描。","status":"completed","collected_at":"2026-07-16T00:00:00Z","references":["https://github.com/sunyixuan1228/cve/blob/main/weaver.md","https://vuldb.com/?id=228777"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":[],"repo_exp_urls":[],"has_poc":false,"has_exp":false,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/2023/AVE-2023-0139.toml"},{"ave_id":"AVE-2023-0331","file_name":"2023/AVE-2023-0331.toml","cve_id":"CVE-2023-24932","title":"Microsoft Windows Secure Boot 安全功能绕过漏洞","description":"该漏洞是 Windows 安全启动（Secure Boot）功能中的安全特性绕过漏洞，位于 Windows BitLocker 和 Secure Boot 组件中。具有管理员权限或物理访问权限的攻击者可通过安装被撤销的启动管理器，绕过 Secure Boot 的安全策略和 BitLocker 加密保护机制，从而在系统启动过程中加载未签名的恶意代码。成功利用后将导致系统安全启动链被破坏，影响 Windows 10/11 及 Windows Server 各版本。Microsoft 已在相关安全更新中发布针对此漏洞的修复措施。","severity":"MEDIUM","score":6.7,"aliases":["CVE-2023-24932"],"sources":["msrc"],"published":"2023-05-09T18:15:12Z","updated":"2026-06-17T05:40:18Z","remediation":"安装最新的 Windows 安全更新（截至 2025 年 7 月已发布多轮累积更新），使系统获得最新的 Windows Boot Manager 和 Secure Boot 吊销列表。补丁安装后保护默认未启用，需参照 KB5025885 手动启用：以管理员身份运行命令 `reg add HKLM\\SYSTEM\\CurrentControlSet\\Control\\SecureBoot\\SBAT /v OptIn /t REG_DWORD /d 1` 或通过组策略启用 Secure Boot 可变 SVN；然后重启设备使吊销生效。如无法立即启用，可在 UEFI 固件设置中确保 Secure Boot 处于开启状态并更新到最新固件版本作为临时缓解。","status":"completed","collected_at":"2026-07-22T00:00:00Z","references":["https://msrc.microsoft.com/update-guide/vulnerability/CVE-2023-24932","https://github.com/trickest/cve/blob/3ffa2a96db84a89f71e1c7ad889e5f4fcc755a48/2023/CVE-2023-24932.md","https://github.com/nomi-sec/PoC-in-GitHub/blob/539c8778fbf849d4aae7a8197b26f2ccbad6a7a4/2023/CVE-2023-24932.json","https://github.com/gwblok/garytown/blob/3ac3b55f376234db87045b3d9ec992a2ae712f46/ConfigMgr/Baselines/CVE-2023-24932/CVE-2023-24932-PR-Detection_v2_July.ps1","https://github.com/mukul975/Anthropic-Cybersecurity-Skills/blob/673da1f3b0b7be34ffc9624ef3858fe45f1c3bed/skills/detecting-secure-boot-bypass/SKILL.md","https://github.com/rix4uni/cvemapping/blob/dc4a87067238e8e55e5d3f9777b54558310f6d6e/2023/CVE-2023-24932/README.md","https://github.com/petripaavola/Intune/blob/da72198b76ededd9558e6ab5d616e8018755f3bc/CVE-2023-24932/readme.md","https://github.com/Patrowl/PatrowlHearsData/blob/765c58d21032d831d20918314a5f12dad607f124/SSVC/data/2023/CVE-2023-24932.json","https://github.com/microsoft/secureboot_objects/blob/06fe58a31d2da381fb68c6d9f30af0dfb91cbe3a/PostSignedObjects/Readme.md","https://github.com/CVEProject/cvelistV5/blob/f410e8277949e9113269176595e70bd0c0230a55/cves/2024/23xxx/CVE-2024-23593.json","https://github.com/github/advisory-database/blob/36ddac9224d3973c64320c39be98ecc1f1ca5395/advisories/unreviewed/2023/05/GHSA-cgcm-2v5q-v3w9/GHSA-cgcm-2v5q-v3w9.json","https://github.com/Wack0/CVE-2022-21894","https://github.com/ajf8729/BlackLotus","https://github.com/helleflo1312/Orchestrated-Powershell-for-CVE-2023-24932","https://github.com/v1ckxy/Orchestrated-Powershell-for-CVE-2023-24932-en"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":[],"repo_exp_urls":[],"has_poc":false,"has_exp":false,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/2023/AVE-2023-0331.toml"},{"ave_id":"AVE-2023-0160","file_name":"2023/AVE-2023-0160.toml","cve_id":"CVE-2023-28771","title":"合勤USG系列防火墙命令注入漏洞","description":"合勤ZyWALL/USG/ATP/USG FLEX系列防火墙固件4.60至5.35版本存在操作系统命令注入漏洞，未经认证的远程攻击者可通过向受影响设备发送特制数据包执行任意OS命令，获取设备完全控制权限。","severity":"CRITICAL","score":9.8,"aliases":["HWPOC-2023-030b7f05","CVE-2023-28771"],"sources":["hwpoc"],"published":"2023-05-04T00:00:00Z","updated":"2026-07-16T13:26:48Z","remediation":"立即升级ZyWALL/USG系列固件至4.73以上版本，升级VPN/USG FLEX/ATP系列固件至5.36及以上版本，并在防火墙管理界面限制可信IP访问。","status":"completed","collected_at":"2026-07-16T13:26:48Z","references":["https://www.zyxel.com/global/en/support/security-advisories/zyxel-security-advisory-for-remote-command-injection-vulnerability-of-firewalls","https://nvd.nist.gov/vuln/detail/CVE-2023-28771"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":[],"repo_exp_urls":[],"has_poc":false,"has_exp":false,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/2023/AVE-2023-0160.toml"},{"ave_id":"AVE-2023-0324","file_name":"2023/AVE-2023-0324.toml","cve_id":"无","title":"天融信上网行为管理系统命令执行漏洞","description":"天融信上网行为管理系统存在命令执行漏洞，攻击者可利用该漏洞通过特殊构造的请求在目标服务器上执行任意系统命令，导致服务器被控制、敏感信息泄露或进一步横向移动。攻击无需认证，远程即可触发。","severity":"MEDIUM","score":5.0,"aliases":["HWPOC-2023-05e17edd"],"sources":["hwpoc"],"published":"2023-05-01T00:00:00Z","updated":"2026-07-17T00:00:00Z","remediation":"升级天融信上网行为管理系统至最新安全版本，或联系厂商获取安全补丁。建议限制管理口访问来源IP，关闭非必要对外暴露端口。","status":"completed","collected_at":"2026-07-17T06:57:02Z","references":[],"poc_urls":[],"exp_urls":[],"repo_poc_urls":[],"repo_exp_urls":[],"has_poc":false,"has_exp":false,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/2023/AVE-2023-0324.toml"},{"ave_id":"AVE-2023-0317","file_name":"2023/AVE-2023-0317.toml","cve_id":"CVE-2023-0317","title":"Secomea GateManager 调试控制台未受保护备用通道信息泄露漏洞","description":"Secomea GateManager 的调试控制台存在未受保护的备用通道（Unprotected Alternate Channel）漏洞，CWE-420。具有管理员权限的攻击者可通过该备用通道获取敏感信息。该漏洞影响 GateManager 10.0 至 10.1 之前版本，攻击者需具备管理员权限且能网络访问目标系统，成功利用后可导致敏感信息泄露，进一步威胁系统安全。","severity":"MEDIUM","score":4.9,"aliases":["CVE-2023-0317","HWPOC-2023-05d6201b"],"sources":["cve","hwpoc"],"published":"2023-04-19T00:00:00Z","updated":"2026-06-17T00:00:00Z","remediation":"建议升级 GateManager 至 10.1 或更高版本，或应用补丁版本 10.0.622425017 及以上。如无法立即升级，应限制对调试控制台的管理员访问权限，仅允许受信 IP 访问，并审计所有管理员账户的访问行为。","status":"completed","collected_at":"2026-07-17T00:00:00Z","references":["https://www.secomea.com/support/cybersecurity-advisory/"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":[],"repo_exp_urls":[],"has_poc":false,"has_exp":false,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/2023/AVE-2023-0317.toml"},{"ave_id":"AVE-2023-0116","file_name":"2023/AVE-2023-0116.toml","cve_id":"无","title":"泛微 e-cology 9 协同办公系统 SQL 注入漏洞","description":"泛微 e-cology 9 协同办公系统的 /mobile/plugin/browser.jsp 接口存在 SQL 注入漏洞。该系统由泛微为中大型组织打造，集知识管理、人力管理、客户管理、流程管理等功能于一体。由于对用户输入数据缺乏充分校验，未经身份认证的远程攻击者可通过向 keyword 参数传入经过三层 URL 编码的恶意 SQL 语句，利用 UNION 注入方式获取数据库中的敏感信息，包括数据库版本、用户凭证等。该漏洞影响 e-cology V9 系列中低于 10.56 的版本。","severity":"HIGH","score":7.5,"aliases":["NUCLEI-HTTP-CNVD-2023-CNVD-2023-12632-YAML"],"sources":["nuclei"],"published":"2023-04-06T00:00:00Z","updated":"2026-07-14T00:00:00Z","remediation":"升级至泛微 e-cology V10.56 或更高版本。官方安全补丁下载中心（https://www.weaver.com.cn/cs/securityDownload.asp）已提供适用于 E9 产品的全量安全补丁（当前最新 v10.80）及基于 v10.56 的增量安全补丁包。升级前请备份应用与数据库，按照官方升级操作说明进行部署；同时建议在 WAF 层对 /mobile/plugin/browser.jsp 接口的 keyword 参数设置严格的输入过滤规则，拦截 SQL 注入特征请求。","status":"completed","collected_at":"2026-07-14T22:06:45Z","references":["https://github.com/projectdiscovery/nuclei-templates/blob/main/http/cnvd/2023/CNVD-2023-12632.yaml","https://blog.csdn.net/qq_50854662/article/details/129992329","https://www.zhihu.com/tardis/zm/art/625931869?source_id=1003","https://www.weaver.com.cn/cs/securityDownload.asp"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":[],"repo_exp_urls":[],"has_poc":false,"has_exp":false,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/2023/AVE-2023-0116.toml"},{"ave_id":"AVE-2023-0063","file_name":"2023/AVE-2023-0063.toml","cve_id":"CVE-2023-0063","title":"WordPress Shortcodes插件存储型跨站脚本漏洞（CVE-2023-0063）","description":"WordPress Shortcodes插件（版本1.6.36及之前）存在存储型跨站脚本漏洞，未正确验证和转义短代码属性，导致具有贡献者及以上权限的用户可在页面或文章中注入恶意脚本。","severity":"MEDIUM","score":5.4,"aliases":["HWPOC-2023-015e365c","CVE-2023-0063"],"sources":["WPScan","NVD"],"published":"2023-03-06T00:00:00Z","updated":"2026-06-17T00:00:00Z","remediation":"升级WordPress Shortcodes插件至1.6.36以上版本，对用户输入的短代码属性进行严格的验证和转义处理。","status":"completed","collected_at":"2026-07-14T07:33:19Z","references":["https://wpscan.com/vulnerability/2262f2fc-8122-46ed-8e67-8c34ee35fc97"],"poc_urls":["https://wpscan.com/vulnerability/2262f2fc-8122-46ed-8e67-8c34ee35fc97"],"exp_urls":[],"repo_poc_urls":[],"repo_exp_urls":[],"has_poc":false,"has_exp":false,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/2023/AVE-2023-0063.toml"},{"ave_id":"AVE-2023-0249","file_name":"2023/AVE-2023-0249.toml","cve_id":"CVE-2023-0249","title":"Delta Electronics DIAScreen 越界写入远程代码执行漏洞","description":"Delta Electronics DIAScreen 1.2.1.23及之前版本存在越界写入漏洞（CWE-787），攻击者可诱使用户打开特制的项目文件触发堆栈缓冲区溢出，进而导致任意代码执行。该漏洞利用复杂度低，成功利用将造成机密性、完整性和可用性完全丧失。","severity":"HIGH","score":7.8,"aliases":["CVE-2023-0249"],"sources":["cve","nvd","ics-cert"],"published":"2023-02-08T00:00:00Z","updated":"2023-06-17T00:00:00Z","remediation":"厂商已发布 DIAScreen 1.3.0 版本修复该漏洞，建议用户立即升级。同时应将控制系统网络与业务网络隔离，禁止从互联网直接访问。","status":"completed","collected_at":"2023-06-17T00:00:00Z","references":["https://www.cisa.gov/uscert/ics/advisories/icsa-23-033-01","https://nvd.nist.gov/vuln/detail/CVE-2023-0249"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":[],"repo_exp_urls":[],"has_poc":false,"has_exp":false,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/2023/AVE-2023-0249.toml"}]
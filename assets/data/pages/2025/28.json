vice）作为临时缓解措施，或在网络边界限制对 RPC 端口的访问。","status":"completed","collected_at":"2026-08-03T00:00:00Z","references":["https://msrc.microsoft.com/update-guide/vulnerability/CVE-2025-21190","https://github.com/CVEProject/cvelistV5/blob/03dbfc069b6c638678ff904c80e89aaf72b93764/cves/2025/21xxx/CVE-2025-21190.json","https://github.com/cisagov/vulnrichment/blob/1fe56a0dafbbcb548bdcdd4fc990cca72ac81c28/2025/21xxx/CVE-2025-21190.json","https://github.com/Patrowl/PatrowlHearsData/blob/2d66b7c0b89f8bfe02ef8d342b4bf0a1bab5ffd1/SSVC/data/2025/CVE-2025-21190.json","https://github.com/Patrowl/PatrowlHearsData/blob/2d66b7c0b89f8bfe02ef8d342b4bf0a1bab5ffd1/CVE/data/2025/CVE-2025-21190.json","https://github.com/nomi-sec/NVD-Database/blob/23dc120c34402aaa65883c51c1d03b3cb02c20cb/2025/CVE-2025-21190.json","https://github.com/opencve/opencve-kb/blob/b258f1790af19a85ccc98f5e771360cd7a4cb4d7/2025/CVE-2025-21190.json","https://github.com/olbat/nvdcve/blob/9b1777f43cb72006ac01427b6823146d45a3862a/nvdcve/CVE-2025-21190.json","https://github.com/imSkows/Cyber-Vulnerability-Analysis-Data/blob/db26c44c5f45c25514223a46675daec7eea03092/data/first/CVE-2025-21190","https://github.com/CyberSecAI/cve_info/blob/03b7e36424574a3a9ba5fd13480a326b666a1046/2025/21xxx/CVE-2025-21190.json","https://github.com/TonneauBenjamin/ANSSI_Project/blob/f0e2d5e8be75f0351e759642d04d728399b4faa9/data/raw/first/CVE-2025-21190"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":[],"repo_exp_urls":[],"has_poc":false,"has_exp":false,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/2025/AVE-2025-0652.toml"}]
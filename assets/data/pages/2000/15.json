/NVD-Database/blob/23dc120c34402aaa65883c51c1d03b3cb02c20cb/2000/CVE-2000-0943.json","https://github.com/olbat/nvdcve/blob/fe7f195231342e1e88104679c53c965e9a67ac35/nvdcve/CVE-2000-0943.json","https://github.com/fkie-cad/nvd-json-data-feeds/blob/b6c80ad7b47e52f64ae2ee2b20e56d7eaaaa57fe/CVE-2000/CVE-2000-09xx/CVE-2000-0943.json","https://github.com/opencve/opencve-kb/blob/abb3d9c240bc75ee9d5885882897d780d10d15cb/2000/CVE-2000-0943.json","https://github.com/HORKimhab/poc-cve-collection/blob/1d7706ed603ab73481cbc20e5bea092e02e7c9be/2000/0xxx/CVE-2000-0943.md","https://github.com/CyberSecAI/cve_info/blob/03b7e36424574a3a9ba5fd13480a326b666a1046/2000/0xxx/CVE-2000-0943.json","https://github.com/CVEProject/cvelist-dev/blob/5b8fbb570438e8094550205589cc6f1d122acc94/2000/0xxx/CVE-2000-0943.json"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":[],"repo_exp_urls":[],"has_poc":false,"has_exp":false,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/2000/AVE-2000-1023.toml"},{"ave_id":"AVE-2000-1022","file_name":"2000/AVE-2000-1022.toml","cve_id":"CVE-2000-0940","title":"Metertek pagelog.cgi 目录遍历任意文件读取漏洞","description":"Metertek pagelog.cgi 存在目录遍历漏洞，远程攻击者可通过向 \"name\" 或 \"display\" 参数提交包含 `..`（点点）序列的恶意请求，绕过路径限制读取服务器上的任意文件。该漏洞影响使用 pagelog.cgi 的 Metertek 产品，攻击者无需身份认证即可利用，可能导致敏感信息泄露。CVSS 评分 6.4，危害等级中危。","severity":"MEDIUM","score":6.4,"aliases":["CVE-2000-0940"],"sources":["avd"],"published":"2000-12-19T05:00:00Z","updated":"2026-06-16T21:52:48Z","remediation":"立即删除或禁用服务器上的 pagelog.cgi 脚本，该脚本已停止维护且无安全补丁。如业务必须使用，修改脚本对 name 和 display 参数进行严格过滤，拒绝包含 \"..\" 或 \"/\" 的输入，并限制文件读取路径为指定目录。部署 Web 应用防火墙（WAF）拦截目录遍历攻击载荷作为临时缓解措施。","status":"completed","collected_at":"2026-08-03T00:00:00Z","references":["http://archives.neohapsis.com/archives/bugtraq/2000-10/0422.html","http://www.securityfocus.com/bid/1864","https://exchange.xforce.ibmcloud.com/vulnerabilities/5451","https://github.com/CVEProject/cvelistV5/blob/a31aa101497b2d23391e84ef31f75e6600381dae/cves/2000/0xxx/CVE-2000-0940.json","https:/
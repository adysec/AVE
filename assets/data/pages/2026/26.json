ces":["ghsa"],"published":"2026-07-02T00:16:45Z","updated":"2026-07-02T15:12:53Z","remediation":"立即升级 Craft CMS 至 5.10.0 或更高版本。如无法立即升级，可暂时限制控制面板用户编辑条目的权限，并在 WAF 层面对 HTTP Referer 头部进行过滤，阻止包含 Twig 模板语法的请求。","status":"completed","collected_at":"2026-07-28T00:00:00Z","references":["https://github.com/craftcms/cms/pull/18680","https://github.com/craftcms/cms/security/advisories/GHSA-f74w-488g-8x5r","https://github.com/CVEProject/cvelistV5/blob/0118bdf83d51e7ec6262ccd7acc694cb751b5bf8/cves/2026/55xxx/CVE-2026-55794.json","https://github.com/cisagov/vulnrichment/blob/5f10816d455ad0d7b2a1abab6159b8d8e7afc3c8/2026/55xxx/CVE-2026-55794.json","https://github.com/Patrowl/PatrowlHearsData/blob/6550296d9cb5b12971003dddc7912cdc0707af50/SSVC/data/2026/CVE-2026-55794.json","https://github.com/anchore/nvd-data-overrides/blob/4c26ebbfb2437ed90b3e4375ee155f638be2c4bd/data/2026/CVE-2026-55794.json","https://github.com/Patrowl/PatrowlHearsData/blob/6550296d9cb5b12971003dddc7912cdc0707af50/CVE/data/2026/CVE-2026-55794.json","https://github.com/nomi-sec/NVD-Database/blob/23dc120c34402aaa65883c51c1d03b3cb02c20cb/2026/CVE-2026-55794.json","https://github.com/olbat/nvdcve/blob/add906b6a8ba20fd533c6fdd7f023c73e6090f3a/nvdcve/CVE-2026-55794.json","https://github.com/alan-turing-institute/cyber-threat-observatory/blob/575eefe00f82443f5f87947d8e6e0e475795a92e/reports/2026-07-01/TIER_2_CVE-2026-55794.md","https://github.com/anchore/cve-data-enrichment/blob/1c0dfd8c28507756be9a283d40cf1d9bdcdb241c/data/anchore/2026/CVE-2026-55794.json","https://github.com/fkie-cad/nvd-json-data-feeds/blob/3e38e95f2e1dd1607b843a3c921eb524d7c4f47f/CVE-2026/CVE-2026-557xx/CVE-2026-55794.json"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":["https://raw.githubusercontent.com/adysec/AVE/main/pocs/2026/POC-AVE-2026-0636.toml"],"repo_exp_urls":[],"has_poc":true,"has_exp":false,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/2026/AVE-2026-0636.toml"}]
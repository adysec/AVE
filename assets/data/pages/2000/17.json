[{"ave_id":"AVE-2000-0729","file_name":"2000/AVE-2000-0729.toml","cve_id":"CVE-2000-0994","title":"OpenBSD fstat 格式字符串本地权限提升漏洞","description":"OpenBSD 2.x 系统中的 fstat 程序存在格式字符串漏洞，由于程序在处理 PWD 环境变量时未正确进行格式化输出，将用户可控的字符串直接作为 printf 系列函数的格式化参数使用。本地攻击者可通过设置恶意的 PWD 环境变量并执行 fstat 程序触发该漏洞，利用格式字符串 %n 等写入操作覆盖任意内存地址，从而提升至 root 权限。该漏洞影响 OpenBSD 2.x 及可能其他基于 BSD 的操作系统，攻击者需拥有本地账户即可利用，无需交互，危害严重。","severity":"HIGH","score":7.2,"aliases":["CVE-2000-0994"],"sources":["avd"],"published":"2000-12-19T05:00:00Z","updated":"2026-06-16T21:52:55Z","remediation":"升级 OpenBSD 至 2.8 或更高版本，该版本已修复 fstat 格式字符串漏洞。如无法立即升级，可移除 fstat 的 setuid 位（chmod u-s /usr/bin/fstat）以消除本地提权风险。","status":"completed","collected_at":"2026-08-05T00:00:00Z","references":["http://marc.info/?l=bugtraq&m=97068555106135&w=2","http://www.securityfocus.com/bid/1746","https://exchange.xforce.ibmcloud.com/vulnerabilities/5338","https://www.exploit-db.com/exploits/20256","https://github.com/CVEProject/cvelistV5/blob/cbc8909f965784fa84e604f999ad78ba1a862d6c/cves/2000/0xxx/CVE-2000-0994.json","https://github.com/Patrowl/PatrowlHearsData/blob/d9d0e44f54f90ad1b4ec106b1cac94be29b99757/CVE/data/2000/CVE-2000-0994.json","https://github.com/LiuCan01/cve-list-pro/blob/78b55511cee3604c22d518e32822f0435d0cacc0/cve-list/CVE-2000/CVE-2000-0994","https://github.com/CVEProject/cve-reference-ingest-data/blob/5fae8f88e2e8a4ac78626293067c0fc30e58cea0/references/CVE-2000-0994-2023-09-21-1730","https://github.com/nomi-sec/NVD-Database/blob/23dc120c34402aaa65883c51c1d03b3cb02c20cb/2000/CVE-2000-0994.json","https://github.com/olbat/nvdcve/blob/2aff155da1d1b98876d6e9c312b912d434f32dca/nvdcve/CVE-2000-0994.json","https://github.com/opencve/opencve-kb/blob/bd65d87495327c522ef03e0100b7141c41565410/2000/CVE-2000-0994.json","https://github.com/HORKimhab/poc-cve-collection/blob/8e09cd003036511dff025515f28920f1d343007b/2000/0xxx/CVE-2000-0994.md","https://github.com/fkie-cad/nvd-json-data-feeds/blob/2045bff4b424e5738e99702781803fdc8b55ff87/CVE-2000/CVE-2000-09xx/CVE-2000-0994.json","https://github.com/CyberSecAI/cve_info/blob/03b7e36424574a3a9ba5fd13480a326b666a1046/2000/0xxx/CVE-2000-0994.json"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":[],"repo_exp_urls":[],"has_poc":false,"has_exp":false,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/2000/AVE-2000-0729.toml"},{"ave_id":"AVE-2000-0728","file_name":"2000/AVE-2000-0728.toml","cve_id":"CVE-2000-0993","title":"BSD libutil pw_error 函数格式化字符串本地权限提升漏洞","description":"BSD libutil 库中的 pw_error 函数存在格式化字符串漏洞，本地攻击者可通过在 chpass 或 passwd 等命令中提交特制的畸形密码字符串触发该漏洞，导致以 root 权限执行任意代码。该漏洞影响多个 BSD 系统版本，CVSS 评分 7.2，危害等级高。攻击者需拥有本地账户即可利用，无需其他特殊权限。","severity":"HIGH","score":7.2,"aliases":["CVE-2000-0993"],"sources":["avd"],"published":"2000-12-19T05:00:00Z","updated":"2026-06-16T21:52:55Z","remediation":"建议立即升级 BSD libutil 库至包含格式字符串漏洞修复的版本（如 FreeBSD 3.5.1 及以上、OpenBSD 2.8 及以上），或应用对应 BSD 发行版的安全补丁。如无法升级，可通过移除 chpass/passwd 等受影响命令的 setuid root 权限作为临时缓解措施：`chmod u-s /usr/bin/chpass /usr/bin/passwd`。","status":"completed","collected_at":"2026-08-05T00:00:00Z","references":["http://marc.info/?l=bugtraq&m=97068555106135&w=2","http://www.openbsd.org/errata27.html#pw_error","http://www.securityfocus.com/bid/1744","https://exchange.xforce.ibmcloud.com/vulnerabilities/5339","https://www.exploit-db.com/exploits/243","https://github.com/CVEProject/cvelistV5/blob/cbc8909f965784fa84e604f999ad78ba1a862d6c/cves/2000/0xxx/CVE-2000-0993.json","https://github.com/LiuCan01/cve-list-pro/blob/78b55511cee3604c22d518e32822f0435d0cacc0/cve-list/CVE-2000/CVE-2000-0993","https://github.com/Patrowl/PatrowlHearsData/blob/d9d0e44f54f90ad1b4ec106b1cac94be29b99757/CVE/data/2000/CVE-2000-0993.json","https://github.com/nomi-sec/NVD-Database/blob/23dc120c34402aaa65883c51c1d03b3cb02c20cb/2000/CVE-2000-0993.json","https://github.com/opencve/opencve-kb/blob/bd65d87495327c522ef03e0100b7141c41565410/2000/CVE-2000-0993.json","https://github.com/HORKimhab/poc-cve-collection/blob/8e09cd003036511dff025515f28920f1d343007b/2000/0xxx/CVE-2000-0993.md","https://github.com/olbat/nvdcve/blob/2aff155da1d1b98876d6e9c312b912d434f32dca/nvdcve/CVE-2000-0993.json","https://github.com/CyberSecAI/cve_info/blob/03b7e36424574a3a9ba5fd13480a326b666a1046/2000/0xxx/CVE-2000-0993.json","https://github.com/fkie-cad/nvd-json-data-feeds/blob/2045bff4b424e5738e99702781803fdc8b55ff87/CVE-2000/CVE-2000-09xx/CVE-2000-0993.json","https://github.com/yarencheng/cve-devops-playground/blob/b41e970743d15aec60299cbc12139ba5a0ac3bb6/content/CVE-2000-0993.md"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":[],"repo_exp_urls":[],"has_poc":false,"has_exp":false,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/2000/AVE-2000-0728.toml"},{"ave_id":"AVE-2000-0727","file_name":"2000/AVE-2000-0727.toml","cve_id":"CVE-2000-0992","title":"OpenSSH sshd scp 目录遍历漏洞","description":"OpenSSH 1.2.x 系列中 scp 组件存在目录遍历漏洞。当客户端连接至恶意的 scp 服务器下载文件时，攻击者可在返回的文件名中包含 ..（点点）序列，绕过路径限制将文件写入任意目录，覆盖客户端任意文件（如 .ssh/authorized_keys）。该漏洞无需身份认证，远程攻击者只需搭建恶意 SCP 服务器并诱骗受害者使用 scp 下载文件即可触发，危害较大。","severity":"MEDIUM","score":5.0,"aliases":["CVE-2000-0992"],"sources":["avd"],"published":"2000-12-19T05:00:00Z","updated":"2026-06-16T21:52:55Z","remediation":"[id]\nave_id = \"AVE-2000-00001\"\naliases = [\"CVE-2000-0992\"]\n\n[basic]\ntitle = \"OpenSSH 1.2 scp 目录遍历漏洞\"\ndescription = \"OpenSSH 1.2.x 系列中 scp 客户端存在目录遍历漏洞。当客户端从恶意的 scp 服务器下载文件时，服务器可返回包含 ..（点点）的构造文件名，导致客户端将文件写入任意目录，覆盖任意文件。攻击者只需搭建恶意 SCP 服务器并诱骗受害者使用 scp 下载文件即可触发，无需认证。\"\nseverity = \"MEDIUM\"\nscore = 5.0\nsources = [\"cve\", \"exploitdb\"]\npublished = \"2000-12-19\"\nupdated = \"2000-12-19\"\nremediation = \"升级至 OpenSSH 2.1 或更高版本，该版本已修复 scp 对服务器返回文件名的路径校验问题。临时缓解措施：仅从可信来源使用 scp 下载文件，或改用 sftp 替代 scp。\"\n\n[references]\nurls = [\"https://nvd.nist.gov/vuln/detail/CVE-2000-0992\", \"https://www.exploit-db.com/exploits/20253\", \"http://archives.neohapsis.com/archives/bugtraq/2000-09/0359.html\", \"http://www.securityfocus.com/bid/1742\", \"https://exchange.xforce.ibmcloud.com/vulnerabilities/5312\"]\n\n[exploit]\npoc_urls = [\"https://www.exploit-db.com/exploits/20253\"]\nexp_urls = []\n\n[meta]\nstatus = \"completed\"\ncollected_at = \"2026-08-05T00:00:00Z\"","status":"completed","collected_at":"2026-08-05T00:00:00Z","references":["http://archives.neohapsis.com/archives/bugtraq/2000-09/0359.html","http://frontal2.mandriva.com/security/advisories?name=MDKSA-2000:057","http://www.securityfocus.com/bid/1742","https://exchange.xforce.ibmcloud.com/vulnerabilities/5312","https://www.exploit-db.com/exploits/20253","https://github.com/CVEProject/cvelistV5/blob/86965a1ef7a64a35a4bffc5193446981deb1b2f5/cves/2000/0xxx/CVE-2000-0992.json","https://github.com/LiuCan01/cve-list-pro/blob/78b55511cee3604c22d518e32822f0435d0cacc0/cve-list/CVE-2000/CVE-2000-0992","https://github.com/Patrowl/PatrowlHearsData/blob/d9d0e44f54f90ad1b4ec106b1cac94be29b99757/CVE/data/2000/CVE-2000-0992.json","https://github.com/nomi-sec/NVD-Database/blob/23dc120c34402aaa65883c51c1d03b3cb02c20cb/2000/CVE-2000-0992.json","https://github.com/opencve/opencve-kb/blob/6c23d699ab95dd8042ecb6df739cafdf209913a6/2000/CVE-2000-0992.json","https://github.com/HORKimhab/poc-cve-collection/blob/8e09cd003036511dff025515f28920f1d343007b/2000/0xxx/CVE-2000-0992.md","https://github.com/olbat/nvdcve/blob/2aff155da1d1b98876d6e9c312b912d434f32dca/nvdcve/CVE-2000-0992.json","https://github.com/aquasecurity/vuln-list-debian/blob/c6e457224984003aac7610b750677033fb679879/tracker/CVE/2000/CVE-2000-0992.json","https://github.com/CyberSecAI/cve_info/blob/03b7e36424574a3a9ba5fd13480a326b666a1046/2000/0xxx/CVE-2000-0992.json","https://github.com/fkie-cad/nvd-json-data-feeds/blob/2045bff4b424e5738e99702781803fdc8b55ff87/CVE-2000/CVE-2000-09xx/CVE-2000-0992.json"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":[],"repo_exp_urls":[],"has_poc":false,"has_exp":false,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/2000/AVE-2000-0727.toml"},{"ave_id":"AVE-2000-0725","file_name":"2000/AVE-2000-0725.toml","cve_id":"CVE-2000-0991","title":"Hilgraeve HyperTerminal Telnet 缓冲区溢出漏洞","description":"Hilgraeve HyperTerminal 6.0 客户端在处理超长 telnet:// URL 时存在缓冲区溢出漏洞。远程攻击者可通过向目标用户发送特制的 telnet 链接，当用户点击该链接时触发缓冲区溢出，从而在目标系统上执行任意代码。该漏洞影响 Windows 98、ME 和 2000 系统上安装的 HyperTerminal 6.0 版本，CVSS 评分 7.5，危害等级高。目前该产品已停止维护，建议用户卸载 HyperTerminal 或升级到替代产品。","severity":"HIGH","score":7.5,"aliases":["CVE-2000-0991"],"sources":["avd"],"published":"2000-12-19T05:00:00Z","updated":"2026-06-16T21:52:55Z","remediation":"安装 Microsoft 安全公告 MS00-079 提供的补丁，或升级到不受影响的 Windows XP 及以上版本。如无法打补丁，可删除或重命名 HyperTerminal 程序文件 hypertrm.exe，或通过组策略禁用 Telnet 协议处理程序关联，避免浏览器自动调用 HyperTerminal 处理 telnet:// 链接。","status":"completed","collected_at":"2026-08-05T00:00:00Z","references":["http://www.securityfocus.com/bid/1815","https://docs.microsoft.com/en-us/security-updates/securitybulletins/2000/ms00-079","https://exchange.xforce.ibmcloud.com/vulnerabilities/5387","https://www.exploit-db.com/exploits/20307","https://github.com/CVEProject/cvelistV5/blob/86965a1ef7a64a35a4bffc5193446981deb1b2f5/cves/2000/0xxx/CVE-2000-0991.json","https://github.com/Patrowl/PatrowlHearsData/blob/d9d0e44f54f90ad1b4ec106b1cac94be29b99757/CVE/data/2000/CVE-2000-0991.json","https://github.com/LiuCan01/cve-list-pro/blob/78b55511cee3604c22d518e32822f0435d0cacc0/cve-list/CVE-2000/CVE-2000-0991","https://github.com/nomi-sec/NVD-Database/blob/23dc120c34402aaa65883c51c1d03b3cb02c20cb/2000/CVE-2000-0991.json","https://github.com/olbat/nvdcve/blob/2aff155da1d1b98876d6e9c312b912d434f32dca/nvdcve/CVE-2000-0991.json","https://github.com/fkie-cad/nvd-json-data-feeds/blob/2045bff4b424e5738e99702781803fdc8b55ff87/CVE-2000/CVE-2000-09xx/CVE-2000-0991.json","https://github.com/opencve/opencve-kb/blob/6c23d699ab95dd8042ecb6df739cafdf209913a6/2000/CVE-2000-0991.json","https://github.com/HORKimhab/poc-cve-collection/blob/8e09cd003036511dff025515f28920f1d343007b/2000/0xxx/CVE-2000-0991.md","https://github.com/CyberSecAI/cve_info/blob/03b7e36424574a3a9ba5fd13480a326b666a1046/2000/0xxx/CVE-2000-0991.json","https://github.com/CVEProject/cvelist-dev/blob/5b8fbb570438e8094550205589cc6f1d122acc94/2000/0xxx/CVE-2000-0991.json"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":[],"repo_exp_urls":[],"has_poc":false,"has_exp":false,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/2000/AVE-2000-0725.toml"},{"ave_id":"AVE-2000-0724","file_name":"2000/AVE-2000-0724.toml","cve_id":"CVE-2000-0989","title":"Intel InBusiness eMail Station 1.4.87 POP服务缓冲区溢出漏洞","description":"Intel InBusiness eMail Station 1.04.87 的 POP 服务存在缓冲区溢出漏洞，远程攻击者可通过向该服务发送超长的用户名参数触发缓冲区溢出，导致服务崩溃拒绝服务，甚至可能执行任意命令。该漏洞无需身份认证即可远程利用，攻击复杂度低，影响邮件服务的可用性。","severity":"MEDIUM","score":5.0,"aliases":["CVE-2000-0989"],"sources":["avd"],"published":"2000-12-19T05:00:00Z","updated":"2026-06-16T21:52:55Z","remediation":"Intel InBusiness eMail Station已停止技术支持，建议更换为受支持的邮件服务器设备。如无法立即更换，可在网络边界防火墙限制对TCP 110端口的访问，仅允许可信IP连接，作为临时缓解措施。","status":"completed","collected_at":"2026-08-05T00:00:00Z","references":["http://archives.neohapsis.com/archives/bugtraq/2000-10/0293.html","http://www.osvdb.org/6488","https://exchange.xforce.ibmcloud.com/vulnerabilities/5414","https://www.exploit-db.com/exploits/20328","https://github.com/CVEProject/cvelistV5/blob/86965a1ef7a64a35a4bffc5193446981deb1b2f5/cves/2000/0xxx/CVE-2000-0989.json","https://github.com/Patrowl/PatrowlHearsData/blob/f80eaead111eac7128eaf77e46b372cdbd675cc9/CVE/data/2000/CVE-2000-0989.json","https://github.com/LiuCan01/cve-list-pro/blob/78b55511cee3604c22d518e32822f0435d0cacc0/cve-list/CVE-2000/CVE-2000-0989","https://github.com/nomi-sec/NVD-Database/blob/23dc120c34402aaa65883c51c1d03b3cb02c20cb/2000/CVE-2000-0989.json","https://github.com/olbat/nvdcve/blob/2aff155da1d1b98876d6e9c312b912d434f32dca/nvdcve/CVE-2000-0989.json","https://github.com/fkie-cad/nvd-json-data-feeds/blob/2045bff4b424e5738e99702781803fdc8b55ff87/CVE-2000/CVE-2000-09xx/CVE-2000-0989.json","https://github.com/opencve/opencve-kb/blob/aea030fdb9f850918f67ec4845c1a97cd9f61f7a/2000/CVE-2000-0989.json","https://github.com/HORKimhab/poc-cve-collection/blob/e2cba2a029d0a53c95f0000f5eb42e0eb69717b8/2000/0xxx/CVE-2000-0989.md","https://github.com/CyberSecAI/cve_info/blob/03b7e36424574a3a9ba5fd13480a326b666a1046/2000/0xxx/CVE-2000-0989.json","https://github.com/CVEProject/cvelist-dev/blob/5b8fbb570438e8094550205589cc6f1d122acc94/2000/0xxx/CVE-2000-0989.json"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":[],"repo_exp_urls":[],"has_poc":false,"has_exp":false,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/2000/AVE-2000-0724.toml"},{"ave_id":"AVE-2000-0722","file_name":"2000/AVE-2000-0722.toml","cve_id":"CVE-2000-0987","title":"Oracle 8.1.6 oidldapd 缓冲区溢出漏洞","description":"Oracle 8.1.6 中的 oidldapd 组件存在缓冲区溢出漏洞，本地用户可通过向 \"connect\" 命令行参数传递超长字符串触发该漏洞，成功利用后可获取目标系统的提升权限，实现机密性、完整性和可用性的部分破坏。该漏洞攻击复杂度低，无需身份认证，但需要本地访问权限。CVSS 评分 4.6，危害等级中危。Oracle 已在后续版本中修复此漏洞。","severity":"MEDIUM","score":4.6,"aliases":["CVE-2000-0987"],"sources":["avd"],"published":"2000-12-19T05:00:00Z","updated":"2026-06-16T21:52:55Z","remediation":"Oracle 8.1.6 已停止支持，建议升级到受支持的 Oracle 数据库版本（如 19c 或 21c）。如无法升级，可移除 oidldapd 二进制文件的 setuid 权限（chmod u-s /path/to/oidldapd），或限制仅可信任用户执行该程序，同时通过本地防火墙和文件系统权限控制访问。","status":"completed","collected_at":"2026-08-05T00:00:00Z","references":["http://www.securityfocus.com/archive/1/140340","http://www.securityfocus.com/archive/1/140709","https://exchange.xforce.ibmcloud.com/vulnerabilities/5401","https://www.exploit-db.com/exploits/20312","https://github.com/CVEProject/cvelistV5/blob/7db8931ea0378982e66f435e269a4ed0e4efb7aa/cves/2000/0xxx/CVE-2000-0987.json","https://github.com/Patrowl/PatrowlHearsData/blob/f80eaead111eac7128eaf77e46b372cdbd675cc9/CVE/data/2000/CVE-2000-0987.json","https://github.com/LiuCan01/cve-list-pro/blob/78b55511cee3604c22d518e32822f0435d0cacc0/cve-list/CVE-2000/CVE-2000-0987","https://github.com/nomi-sec/NVD-Database/blob/23dc120c34402aaa65883c51c1d03b3cb02c20cb/2000/CVE-2000-0987.json","https://github.com/olbat/nvdcve/blob/2aff155da1d1b98876d6e9c312b912d434f32dca/
ector/vul-source/blob/2880bce38b1c3fec315752297be30e3d60dabff9/ubuntu-cve-tracker/retired/CVE-2012-0445","https://github.com/Patrowl/PatrowlHearsData/blob/37abbcb2a8225ed14d2b9dfffb1ad41b15cc2cc8/CVE/data/2012/CVE-2012-0445.json","https://github.com/nomi-sec/NVD-Database/blob/23dc120c34402aaa65883c51c1d03b3cb02c20cb/2012/CVE-2012-0445.json","https://github.com/eslerm/ubuntu-cve-tracker/blob/f17e5ebf7a87347cc68d8fae347d07409a857342/retired/CVE-2012-0445","https://github.com/pombredanne/git.launchpad.net-ubuntu-cve-tracker-/blob/fcedabe073a8eb8b2e85c436aeec152320c7cde3/retired/CVE-2012-0445","https://github.com/aquasecurity/vuln-list-debian/blob/338375e9291959a955b9c4f1b7794c4836fe2985/tracker/CVE/2012/CVE-2012-0445.json"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":["https://raw.githubusercontent.com/adysec/AVE/main/pocs/2012/POC-AVE-2012-0035.toml"],"repo_exp_urls":[],"has_poc":true,"has_exp":false,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/2012/AVE-2012-0035.toml"},{"ave_id":"AVE-2012-0034","file_name":"2012/AVE-2012-0034.toml","cve_id":"CVE-2012-0444","title":"Mozilla Firefox/SeaMonkey/Thunderbird Ogg Vorbis 文件解码内存破坏漏洞","description":"Mozilla Firefox 3.6.26之前版本及4.x至9.0版本、Thunderbird 3.1.18之前版本及5.0至9.0版本、SeaMonkey 2.7之前版本中存在内存破坏漏洞。该漏洞源于nsChildView数据结构初始化不当，远程攻击者可通过诱使用户打开特制的Ogg Vorbis音频文件触发内存破坏，导致拒绝服务（应用程序崩溃）或可能执行任意代码。攻击无需身份认证，CVSS评分10.0，危害等级严重。","severity":"CRITICAL","score":10.0,"aliases":["CVE-2012-0444"],"sources":["tenable"],"published":"2012-02-01T16:55:01Z","updated":"2026-06-16T23:37:16Z","remediation":"升级 Firefox 至 3.6.26 或 10.0 及以上版本，Thunderbird 升级至 3.1.18 或 10.0 及以上版本，SeaMonkey 升级至 2.7 及以上版本。可通过各产品内置自动更新功能或从官网下载最新版安装。如无法立即升级，建议禁用 Ogg Vorbis 相关插件或使用内容安全策略限制媒体文件解析作为临时缓解措施。","status":"completed","collected_at":"2026-08-03T00:00:00Z","references":["http://lists.opensuse.org/opensuse-security-announce/2012-02/msg00003.html","http://lists.opensuse.org/opensuse-security-announce/2012-02/msg00007.html","http://lists.opensuse.org/opensuse-security-an
":"completed","collected_at":"2026-07-28T00:00:00Z","references":["http://archives.neohapsis.com/archives/bugtraq/2002-02/0187.html","http://marc.info/?l=bugtraq&m=101467193803592&w=2","http://www.securityfocus.com/bid/4115","https://exchange.xforce.ibmcloud.com/vulnerabilities/8223","https://www.exploit-db.com/exploits/21290","https://github.com/CVEProject/cvelistV5/blob/6d13b43de313698fc7b472535f6d74902fcb6edb/cves/2002/0xxx/CVE-2002-0296.json","https://github.com/LiuCan01/cve-list-pro/blob/78b55511cee3604c22d518e32822f0435d0cacc0/cve-list/CVE-2002/CVE-2002-0296","https://github.com/Patrowl/PatrowlHearsData/blob/9fbc3eab0f67f21cdc1f59fce6ae94d3ff015719/CVE/data/2002/CVE-2002-0296.json","https://github.com/nomi-sec/NVD-Database/blob/23dc120c34402aaa65883c51c1d03b3cb02c20cb/2002/CVE-2002-0296.json","https://github.com/olbat/nvdcve/blob/add906b6a8ba20fd533c6fdd7f023c73e6090f3a/nvdcve/CVE-2002-0296.json","https://github.com/opencve/opencve-kb/blob/a196abedeefb2e62546c2e07053b77dfd3a06a5f/2002/CVE-2002-0296.json","https://github.com/HORKimhab/poc-cve-collection/blob/f7bd0fe22e1d3cba01a68479d76cd5ea63a69c91/2002/0xxx/CVE-2002-0296.md","https://github.com/fkie-cad/nvd-json-data-feeds/blob/4cd7841d39f8c59056b450c5339511feb54f9bc6/CVE-2002/CVE-2002-02xx/CVE-2002-0296.json","https://github.com/CyberSecAI/cve_info/blob/03b7e36424574a3a9ba5fd13480a326b666a1046/2002/0xxx/CVE-2002-0296.json","https://github.com/CVEProject/cvelist-dev/blob/5b8fbb570438e8094550205589cc6f1d122acc94/2002/0xxx/CVE-2002-0296.json"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":[],"repo_exp_urls":[],"has_poc":false,"has_exp":false,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/2002/AVE-2002-0252.toml"}]
6a9acb495d7d669239530ffe6da5d631f4da/2011/gb_fedora_2011_0121_webkitgtk_fc13.nasl","https://github.com/openSUSE/news-o-o/blob/f00a24fa16e9d957a04b4b8d47c2090853697549/_posts/2010/2010-08-22-opensuse-weekly-news-issue-137-is-out.md","https://github.com/DragonFlyBSD/DPorts/blob/e2f31ebea3a06041c3c693a21703388f71fe19de/security/vuxml/vuln/2010.xml"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":[],"repo_exp_urls":[],"has_poc":false,"has_exp":false,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/2010/AVE-2010-0176.toml"},{"ave_id":"AVE-2010-0174","file_name":"2010/AVE-2010-0174.toml","cve_id":"CVE-2010-1764","title":"Apple Safari WebKit 表单重定向信息泄露漏洞","description":"WebKit（Apple Safari 浏览器使用的渲染引擎）在处理 HTTP 重定向时存在设计缺陷。当用户通过 Safari 浏览器提交表单时，WebKit 会跟随多个重定向跳转，导致表单数据（如用户名、密码等敏感信息）被发送到中间的重定向服务器。攻击者可通过构造恶意的重定向链，在用户不知情的情况下截获提交的表单数据，造成信息泄露。该漏洞影响 Mac OS X 10.4 至 10.6 及 Windows 平台上的 Safari 5.0 以下版本（Mac OS X 10.4 上为 4.1 以下版本），CVSS 评分 4.3，危害等级中危。用户需升级至 Safari 5.0 或 4.1 及以上版本修复此漏洞。","severity":"MEDIUM","score":4.3,"aliases":["CVE-2010-1764"],"sources":["tenable"],"published":"2010-06-11T19:30:20Z","updated":"2026-06-16T23:19:16Z","remediation":"升级 Apple Safari 至 5.0 或更高版本（Mac OS X 10.5~10.6/Windows）或 4.1 或更高版本（Mac OS X 10.4）；Linux 用户更新 webkit 包至修复版本（参考 USN-1006-1）。无法升级时，避免在不可信站点提交表单数据。","status":"completed","collected_at":"2026-07-27T00:00:00Z","references":["http://lists.apple.com/archives/security-announce/2010//Nov/msg00003.html","http://lists.apple.com/archives/security-announce/2010//Sep/msg00002.html","http://lists.apple.com/archives/security-announce/2010/Jun/msg00000.html","http://lists.opensuse.org/opensuse-security-announce/2011-01/msg00006.html","http://secunia.com/advisories/40105","http://secunia.com/advisories/41856","http://secunia.com/advisories/42314","http://secunia.com/advisories/43068","http://securitytracker.com/id?1024067","http://support.apple.com/kb/HT4196","http://support.apple.com/kb/HT4334","http://support.apple.com/kb/HT4456","http://www.mandriva.com/
[{"ave_id":"AVE-2000-0186","file_name":"2000/AVE-2000-0186.toml","cve_id":"CVE-2000-0211","title":"Microsoft Windows Media Services 远程拒绝服务漏洞","description":"Windows Media Services 4.0/4.1 的握手过程存在序列验证缺陷，远程攻击者无需身份认证即可向目标服务器发送精心构造的异常顺序握手数据包，触发服务处理逻辑混乱，导致 Windows Media 服务进程崩溃或停止响应，造成拒绝服务。该漏洞影响运行 Windows Media Services 4.0 及 4.1 版本的 Windows NT 4.0 和 Windows 2000 系统，CVSS 评分 5.0，危害等级中危。","severity":"MEDIUM","score":5.0,"aliases":["CVE-2000-0211"],"sources":["cve","avd"],"published":"2000-02-23T00:00:00Z","updated":"2026-06-16T00:00:00Z","remediation":"安装 Microsoft 安全公告 MS00-013 提供的补丁程序。由于 Windows Media Services 4.0/4.1 已停止支持，建议升级到受支持的 Windows Server 版本。临时缓解措施可在防火墙层限制对 Windows Media 服务端口 1755/TCP 及 UDP 的访问。","status":"completed","collected_at":"2026-07-22T00:00:00Z","references":["http://www.securityfocus.com/bid/1000","https://docs.microsoft.com/en-us/security-updates/securitybulletins/2000/ms00-013","https://www.exploit-db.com/exploits/19759"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":[],"repo_exp_urls":[],"has_poc":false,"has_exp":false,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/2000/AVE-2000-0186.toml"},{"ave_id":"AVE-2000-0509","file_name":"2000/AVE-2000-0509.toml","cve_id":"CVE-2000-0166","title":"Pragma Systems InterAccess TelnetD Server 缓冲区溢出远程代码执行漏洞","description":"Pragma Systems InterAccess TelnetD Server 4.0 Build 4 存在缓冲区溢出漏洞，远程攻击者可通过向 TelnetD 服务发送超长的登录用户名触发该漏洞，导致缓冲区溢出，进而能够在目标系统上执行任意命令。该漏洞无需身份认证即可利用，CVSS 评分高达 10.0，危害等级严重。","severity":"CRITICAL","score":10.0,"aliases":["CVE-2000-0166"],"sources":["avd"],"published":"2000-02-21T05:00:00Z","updated":"2026-06-16T21:51:08Z","remediation":"建议立即升级至 Pragma InterAccess TelnetD 4.1 及以上版本，该版本已修复缓冲区溢出漏洞。如厂商已停止维护，应彻底停用 InterAccess TelnetD 服务，改用 OpenSSH 等安全远程访问方案，并在防火墙禁用 Telnet 端口（23/TCP）。","status":"completed","collected_at":"2026-07-22T00:00:00Z","references":["http://marc.info/?l=bugtraq&m=95142756403323&w=2","http://www.securityfocus.com/bid/995","http://www.securityfocus.com/templates/archive.pike?list=1&m
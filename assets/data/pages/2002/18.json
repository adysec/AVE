8"],"sources":["exploitdb"],"published":"2002-10-04T04:00:00Z","updated":"2026-06-16T21:58:26Z","remediation":"立即停用 MakeBook 2.2 CGI 程序，该软件已停止维护且厂商失联。如必须使用，在 Apache 配置中禁用 SSI 功能（Options -Includes），并在 Web 服务器或应用入口处对 Name 和 Email 参数实施严格的输入过滤，禁止 HTML 标签和 SSI 指令字符（<、>、<!--、#exec 等）。建议迁移至其他仍在维护的留言簿程序。","status":"completed","collected_at":"2026-08-03T00:00:00Z","references":["http://archives.neohapsis.com/archives/bugtraq/2002-06/0094.html","http://cert.uni-stuttgart.de/archive/bugtraq/2002/06/msg00135.html","http://www.iss.net/security_center/static/9356.php","http://www.linguistic-funland.com/scripts/MakeBook/makebook.script","http://www.securityfocus.com/bid/4996","http://www.tesol.net/scriptmail.html","https://www.exploit-db.com/exploits/21535","https://github.com/CVEProject/cvelistV5/blob/a14f4e66db68a75a9270d6c9081e9ffb7f931cd8/cves/2002/0xxx/CVE-2002-0948.json","https://github.com/Patrowl/PatrowlHearsData/blob/3eab0e512529a79daadefaadf0f05372813e7876/CVE/data/2002/CVE-2002-0948.json","https://github.com/LiuCan01/cve-list-pro/blob/78b55511cee3604c22d518e32822f0435d0cacc0/cve-list/CVE-2002/CVE-2002-0948","https://github.com/nomi-sec/NVD-Database/blob/23dc120c34402aaa65883c51c1d03b3cb02c20cb/2002/CVE-2002-0948.json","https://github.com/olbat/nvdcve/blob/fe7f195231342e1e88104679c53c965e9a67ac35/nvdcve/CVE-2002-0948.json","https://github.com/opencve/opencve-kb/blob/2adf3d659b2229087465cbedc27cc02d5736df99/2002/CVE-2002-0948.json","https://github.com/HORKimhab/poc-cve-collection/blob/1d7706ed603ab73481cbc20e5bea092e02e7c9be/2002/0xxx/CVE-2002-0948.md","https://github.com/fkie-cad/nvd-json-data-feeds/blob/e9b51a58e4ac0e6b00dc38147f459707e98ae056/CVE-2002/CVE-2002-09xx/CVE-2002-0948.json","https://github.com/CyberSecAI/cve_info/blob/03b7e36424574a3a9ba5fd13480a326b666a1046/2002/0xxx/CVE-2002-0948.json","https://github.com/yarencheng/cve-devops-playground/blob/2ea9851780633b2caab16fe048a14b38ca9a0b56/content/CVE-2002-0948.md"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":["h
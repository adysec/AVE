[{"ave_id":"AVE-2017-0001","file_name":"2017/AVE-2017-0001.toml","cve_id":"CVE-2017-20230","title":"Perl Storable 模块堆栈溢出漏洞","description":"Perl 的 Storable 模块 3.05 之前版本中存在栈溢出漏洞，位于 retrieve_hook 函数处理类名长度时。该函数将类名长度存储为有符号整数，但在读取操作中将其作为无符号整数处理，导致攻击者可通过构造特制的序列化数据触发栈溢出。该漏洞 CVSS 评分 10.0，危害等级严重，影响所有使用受影响 Storable 模块的 Perl 应用，攻击者无需身份认证即可利用。","severity":"CRITICAL","score":10.0,"aliases":["CVE-2017-20230"],"sources":["msrc"],"published":"2026-04-21T16:16:18.077","updated":"2026-06-17T01:15:27.847","remediation":"立即升级 Perl Storable 模块至 3.05 或以上版本，可通过 CPAN 执行 `cpan -i Storable` 更新。如无法立即升级，避免使用 Storable 反序列化不可信来源数据，并限制应用程序对不受信任二进制数据的解包操作。补丁已合入 Perl 5 主干分支，提交 ID 为 a258c17c6937f79529c8319a829310e09cdbd216。","status":"completed","collected_at":"2026-07-21T00:00:00Z","references":["https://github.com/Perl/perl5/commit/a258c17c6937f79529c8319a829310e09cdbd216.patch","https://github.com/Perl/perl5/issues/15831","https://metacpan.org/release/RURBAN/Storable-3.05/changes","https://www.nntp.perl.org/group/perl.perl5.porters/2017/01/msg242533.html","https://www.nntp.perl.org/group/perl.perl5.porters/2017/01/msg242703.html","http://www.openwall.com/lists/oss-security/2026/04/21/5","https://github.com/CVEProject/cvelistV5/blob/fe843ab2b4a415ff4c1b33508a5c7bbbe8d1116c/cves/2017/20xxx/CVE-2017-20230.json","https://github.com/canonical/ubuntu-security-notices/blob/b3f14a770d93b602b06aecf87f2033bd6818a62d/osv/cve/2017/UBUNTU-CVE-2017-20230.json","https://github.com/alan-turing-institute/cyber-threat-observatory/blob/39897d9afb3c6d42c7013893163963e5f59b4180/reports/2026-04-21/TIER_3_CVE-2017-20230.md","https://github.com/neuvector/vul-source/blob/27dcc23268ea595c1e22ac2008b340bb4e848cb2/ubuntu-cve-tracker/active/CVE-2017-20230","https://github.com/cisagov/vulnrichment/blob/593bdbc51deef90595839eb5f1cfcb624c57384b/2017/20xxx/CVE-2017-20230.json","https://github.com/TMA84/cvealert/blob/1f0131172164da5118cebcfe86d95fcf67ebc271/content/posts/cve-2017-20230.md","https://github.com/yarencheng/cve-devops-playground/blob/7f1c35ad28226319c149c937b6a2e7a1986924ce/content/CVE-2017-20230.md","https://github.com/CVEProject/cve-reference-ingest-data/blob/54ab2d6e8edcc52192915a067c45b2190f568993/references/CVE-2017-20230-2026-05-02-0005","https://github.com/github/advisory-database/blob/ca4032f687e5627fcf86913a0441b18137902527/advisories/unreviewed/2026/04/GHSA-6r7m-2wh8-438w/GHSA-6r7m-2wh8-438w.json","https://github.com/CVEProject/cve-reference-ingest/blob/4e0329739775d4c7a2559f4f72992787e49b59f3/references/contrib1-CVE-2017-20230-2026-05-01-0305"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":[],"repo_exp_urls":[],"has_poc":false,"has_exp":false,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/2017/AVE-2017-0001.toml"},{"ave_id":"AVE-2017-0002","file_name":"2017/AVE-2017-0002.toml","cve_id":"CVE-2017-9047","title":"libxml2 xmlSnprintfElements 堆栈缓冲区溢出漏洞","description":"libxml2 的 valid.c 文件中 xmlSnprintfElements 函数存在栈缓冲区溢出漏洞。当对不可信文档或外部 DTD 进行 DTD 验证时，攻击者可通过构造特制的 XML 文件触发该漏洞。漏洞成因在于函数在拼接元素内容定义到缓冲区时，未使用更新后的缓冲区长度进行边界检查，导致可越界写入约\"size\"字节数据。该漏洞可导致使用 libxml2 库的程序（如 PHP）崩溃，CVSS 评分 7.5，危害等级高。受影响版本包括 libxml2 2.9.4 及之前版本。","severity":"HIGH","score":7.5,"aliases":["CVE-2017-9047"],"sources":["msrc"],"published":"2017-05-18T06:29:00.403","updated":"2026-06-17T01:27:23.397","remediation":"升级 libxml2 至 2.9.5 及以上版本。各发行版用户可通过包管理器更新（如 apt upgrade libxml2、yum update libxml2）。PHP 用户需同时升级 php-xml 扩展并重启 Web 服务。如无法立即升级，作为临时缓解措施，可避免对不可信文档执行 DTD 验证，或设置 LIBXML_DTDLOAD 与 LIBXML_DTDATTR 解析选项为 0 以禁用外部 DTD 加载。","status":"completed","collected_at":"2026-07-21T00:00:00Z","references":["http://www.debian.org/security/2017/dsa-3952","http://www.openwall.com/lists/oss-security/2017/05/15/1","http://www.securityfocus.com/bid/98599","https://lists.apache.org/thread.html/r58af02e294bd07f487e2c64ffc0a29b837db5600e33b6e698b9d696b%40%3Cissues.bookkeeper.apache.org%3E","https://lists.apache.org/thread.html/rf4c02775860db415b4955778a131c2795223f61cb8c6a450893651e4%40%3Cissues.bookkeeper.apache.org%3E","https://security.gentoo.org/glsa/201711-01","https://github.com/trickest/cve/blob/3ffa2a96db84a89f71e1c7ad889e5f4fcc755a48/2017/CVE-2017-9047.md","https://github.com/CVEProject/cvelistV5/blob/f655f864c18bd25e1fca21f5741c644854233bf0/cves/2017/9xxx/CVE-2017-9047.json","https://github.com/canonical/ubuntu-security-notices/blob/b3f14a770d93b602b06aecf87f2033bd6818a62d/osv/cve/2017/UBUNTU-CVE-2017-9047.json","https://github.com/nottrobin/ubuntu-cve-tracker/blob/36e411296b5707284049ec2e0db8d2622feca498/retired/CVE-2017-9047","https://github.com/Tabll/gemnasium-db/blob/ccf2cc3d762789b06638ba5aa3e06982a53080c8/nuget/libxml2/CVE-2017-9047.yml","https://github.com/vmware/photon/blob/0b37ad6f1c30ccbcabda429e5ce34657065d26ca/SPECS/libxml2/libxml2.spec","https://github.com/unprovable/OrchidMantis/blob/b5893f26d79c98b214daae2877ab2f2ac54b8192/targets/04-libxml2-cve-2017-9047-upstream.c","https://github.com/fullwaywang/QlRules/blob/241853bffb1f550aca9b1eba7b1c65f00f09ae18/libxml2/CVE-2017-9047-932cc98/xmlSnprintfElementContent-autogen.ql","https://github.com/alibaba/AliOS-Things-Linux-Edition/blob/a78f19107de74beaef40b33c9648cf5dadce37e6/meta-yp/meta/recipes-core/libxml/libxml2/libxml2-CVE-2017-9047_CVE-2017-9048.patch","https://github.com/rubysec/ruby-advisory-db/blob/d608525060b1c7d4a9217b60250c9f4de771ba90/gems/nokogiri/CVE-2017-9050.yml"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":[],"repo_exp_urls":[],"has_poc":false,"has_exp":false,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/2017/AVE-2017-0002.toml"}]
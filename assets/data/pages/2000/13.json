[{"ave_id":"AVE-2000-0849","file_name":"2000/AVE-2000-0849.toml","cve_id":"CVE-2000-1230","title":"Phorum 3.0.7 auth.php3 后门认证绕过漏洞","description":"Phorum 3.0.7 的 auth.php3 文件中存在后门漏洞，远程攻击者无需身份认证即可通过构造包含 PHP_AUTH_USER 参数值为 \"boogieman\" 的 HTTP 请求绕过访问控制，从而获取受限页面的访问权限。该漏洞利用难度低，攻击者仅需发送特制 HTTP 请求即可触发，可能导致敏感信息泄露。CVSS 评分 5.0，危害等级中危。","severity":"MEDIUM","score":5.0,"aliases":["CVE-2000-1230"],"sources":["epss"],"published":"2000-12-31T05:00:00Z","updated":"2026-06-16T21:53:25Z","remediation":"[id]\nave_id = \"AVE-2000-00001\"\naliases = [\"CVE-2000-1230\"]\n\n[basic]\ntitle = \"Phorum 3.0.7 auth.php3 后门漏洞\"\ndescription = \"Phorum 3.0.7 的 auth.php3 脚本中存在硬编码后门密码。远程攻击者无需任何身份认证，只需在 HTTP 请求中设置 PHP_AUTH_USER 参数为特殊值 \\\"boogieman\\\"，即可绕过身份验证机制，访问本应受限制的 Web 管理页面和资源。该漏洞影响所有使用 auth.php3 进行访问控制的页面，攻击者可借此获取敏感信息或进一步提权。\"\nseverity = \"MEDIUM\"\nscore = 5.0\nsources = [\"cve\", \"exploitdb\"]\npublished = \"2000-12-31\"\nupdated = \"2024-06-16\"\nremediation = \"升级到 Phorum 3.0.8 或更高版本。由于 Phorum 已停止维护，建议迁移到其他活跃维护的论坛系统。临时缓解措施可在 Web 服务器层面配置规则，拦截包含 PHP_AUTH_USER=boogieman 的 HTTP 请求。\"\n\n[references]\nurls = [\"https://www.exploit-db.com/exploits/20588\", \"http://www.securityfocus.com/bid/2274\", \"http://hispahack.ccc.de/mi020.html\", \"http://www.digitalsec.net/stuff/z-mirrors/hispahack/mi020.htm\"]\n\n[exploit]\npoc_urls = [\"https://www.exploit-db.com/exploits/20588\"]\nexp_urls = [\"https://www.exploit-db.com/exploits/20588\"]\n\n[meta]\nstatus = \"completed\"\ncollected_at = \"2026-08-06T00:00:00Z\"\n\n---\n\n[info]\nid = \"POC-AVE-2000-00001\"\nname = \"CVE-2000-1230 PoC\"\nauthor = \"AVE\"\nseverity = \"medium\"\ntags = [\"cve-2000-1230\"]\ndescription = \"检测 Phorum 3.0.7 auth.php3 后门漏洞，通过设置 PHP_AUTH_USER=boogieman 绕过认证访问受限页面\"\nvuln_id = [\"CVE-2000-1230\", \"AVE-2000-00001\"]\n\n[poc]\nlogic = \"any\"\n\n[[poc.requests]]\nprotocol = \"http\"\nmethod = \"GET\"\npath = \"/{{BaseURL}}/admin.php3?PHP_AUTH_USER=boogieman\"\n\n[[poc.requests.matchers]]\ntype = \"status\"\nstatus = [200]\nexpect = true\n\n---\n\n[info]\nid = \"EXP-AVE-2000-00001\"\nname = \"CVE-2000-1230 EXP\"\nauthor = \"AVE\"\nseverity = \"medium\"\ntags = [\"cve-2000-1230\"]\ndescription = \"利用 Phorum 3.0.7 auth.php3 后门，通过 PHP_AUTH_USER=boogieman 参数绕过认证获取受限页面访问权限\"\nvuln_id = [\"CVE-2000-1230\", \"AVE-2000-00001\"]\n\n[poc]\nlogic = \"any\"\n\n[[poc.requests]]\nprotocol = \"http\"\nmethod = \"GET\"\npath = \"/{{BaseURL}}/admin.php3?PHP_AUTH_USER=boogieman\"\n\n[[poc.requests.matchers]]\ntype = \"status\"\nstatus = [200]\nexpect = true\n","status":"completed","collected_at":"2026-08-05T00:00:00Z","references":["http://cert.uni-stuttgart.de/archive/bugtraq/2000/01/msg00215.html","http://hispahack.ccc.de/mi020.html","http://www.digitalsec.net/stuff/z-mirrors/hispahack/mi020.htm","http://www.securityfocus.com/bid/2274","https://www.exploit-db.com/exploits/20588","https://github.com/CVEProject/cvelistV5/blob/9e1d600240836820e3a1b1e4977c0af8cbdc05f2/cves/2000/1xxx/CVE-2000-1230.json","https://github.com/Patrowl/PatrowlHearsData/blob/6604e71750f28c1fc12ae269817332f21f2b9d84/CVE/data/2000/CVE-2000-1230.json","https://github.com/LiuCan01/cve-list-pro/blob/78b55511cee3604c22d518e32822f0435d0cacc0/cve-list/CVE-2000/CVE-2000-1230","https://github.com/nomi-sec/NVD-Database/blob/23dc120c34402aaa65883c51c1d03b3cb02c20cb/2000/CVE-2000-1230.json","https://github.com/olbat/nvdcve/blob/2aff155da1d1b98876d6e9c312b912d434f32dca/nvdcve/CVE-2000-1230.json","https://github.com/opencve/opencve-kb/blob/81a148a05078ecaf8ff30dafcb6a9851540b3434/2000/CVE-2000-1230.json","https://github.com/fkie-cad/nvd-json-data-feeds/blob/2045bff4b424e5738e99702781803fdc8b55ff87/CVE-2000/CVE-2000-12xx/CVE-2000-1230.json","https://github.com/HORKimhab/poc-cve-collection/blob/7e55a51637777fc04c5ee78af002f3381c04b9ec/2000/1xxx/CVE-2000-1230.md","https://github.com/CyberSecAI/cve_info/blob/03b7e36424574a3a9ba5fd13480a326b666a1046/2000/1xxx/CVE-2000-1230.json","https://github.com/CVEProject/cvelist-dev/blob/5b8fbb570438e8094550205589cc6f1d122acc94/2000/1xxx/CVE-2000-1230.json"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":["https://raw.githubusercontent.com/adysec/AVE/main/pocs/2000/POC-AVE-2000-0849.toml"],"repo_exp_urls":["https://raw.githubusercontent.com/adysec/AVE/main/exploits/2000/EXP-AVE-2000-0849.toml"],"has_poc":true,"has_exp":true,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/2000/AVE-2000-0849.toml"},{"ave_id":"AVE-2000-0848","file_name":"2000/AVE-2000-0848.toml","cve_id":"CVE-2000-1228","title":"Phorum 3.0.7 管理员密码未授权修改漏洞","description":"Phorum 3.0.7 存在未授权管理员密码修改漏洞。远程攻击者无需任何身份认证，只需向 admin.php3 发送 HTTP 请求并构造 step、option、confirm 和 newPssword 参数，即可直接修改管理员密码。该漏洞源于管理后台缺乏有效的身份验证检查，攻击者无需登录或拥有任何权限即可完成操作，成功利用后可完全控制论坛管理后台，影响 Phorum 3.0.7 及更早版本。","severity":"MEDIUM","score":5.0,"aliases":["CVE-2000-1228"],"sources":["epss"],"published":"2000-12-31T05:00:00Z","updated":"2026-06-16T21:53:25Z","remediation":"升级 Phorum 至 3.0.8 或更高版本，该版本修复了 admin.php3 未经验证即可修改管理员密码的问题。如无法升级，在 Web 服务器（Apache/Nginx）层面对 admin.php3 添加 IP 白名单或 HTTP 基本认证限制访问，同时在 Phorum 配置中禁用远程管理功能。","status":"completed","collected_at":"2026-08-05T00:00:00Z","references":["http://cert.uni-stuttgart.de/archive/bugtraq/2000/01/msg00215.html","http://hispahack.ccc.de/mi020.html","http://www.digitalsec.net/stuff/z-mirrors/hispahack/mi020.htm","http://www.securityfocus.com/bid/2271","https://www.exploit-db.com/exploits/20586","https://github.com/CVEProject/cvelistV5/blob/0b2099d0f1ceb94625ab1ba6dca5a48307538ab8/cves/2000/1xxx/CVE-2000-1228.json","https://github.com/Patrowl/PatrowlHearsData/blob/6604e71750f28c1fc12ae269817332f21f2b9d84/CVE/data/2000/CVE-2000-1228.json","https://github.com/LiuCan01/cve-list-pro/blob/78b55511cee3604c22d518e32822f0435d0cacc0/cve-list/CVE-2000/CVE-2000-1228","https://github.com/nomi-sec/NVD-Database/blob/23dc120c34402aaa65883c51c1d03b3cb02c20cb/2000/CVE-2000-1228.json","https://github.com/olbat/nvdcve/blob/2aff155da1d1b98876d6e9c312b912d434f32dca/nvdcve/CVE-2000-1228.json","https://github.com/opencve/opencve-kb/blob/81a148a05078ecaf8ff30dafcb6a9851540b3434/2000/CVE-2000-1228.json","https://github.com/fkie-cad/nvd-json-data-feeds/blob/2045bff4b424e5738e99702781803fdc8b55ff87/CVE-2000/CVE-2000-12xx/CVE-2000-1228.json","https://github.com/HORKimhab/poc-cve-collection/blob/8eabcabeccc08fd880f454fd53f7419ecf9a8d7e/2000/1xxx/CVE-2000-1228.md","https://github.com/CyberSecAI/cve_info/blob/03b7e36424574a3a9ba5fd13480a326b666a1046/2000/1xxx/CVE-2000-1228.json","https://github.com/CVEProject/cvelist-dev/blob/5b8fbb570438e8094550205589cc6f1d122acc94/2000/1xxx/CVE-2000-1228.json"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":[],"repo_exp_urls":[],"has_poc":false,"has_exp":false,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/2000/AVE-2000-0848.toml"},{"ave_id":"AVE-2000-1888","file_name":"2000/AVE-2000-1888.toml","cve_id":"CVE-2000-0982","title":"Microsoft Internet Explorer 缓存凭据泄露漏洞","description":"Internet Explorer 5.5 之前版本存在缓存凭据转发漏洞，当用户访问同一网站的 HTTPS 安全页面后，浏览器会将缓存的用户凭据自动转发给该网站上的 HTTP 不安全页面。远程攻击者可通过监控网络连接或中间人攻击截获这些明文传输的凭据信息，导致用户账号密码泄露。该漏洞影响 Windows 平台上所有 IE 5.5 以下版本，CVSS 评分 7.5，危害等级高。","severity":"HIGH","score":7.5,"aliases":["CVE-2000-0982"],"sources":["avd"],"published":"2000-12-19T05:00:00Z","updated":"2026-06-16T21:52:54Z","remediation":"升级 Internet Explorer 至 5.5 或更高版本（IE 5.5 不受此漏洞影响）；若无法升级，为 IE 5.01 安装 SP1 并应用 MS00-076 补丁（KB Q273868）；IE 4.x 用户应升级至 IE 5.01 SP1 或 IE 5.5。临时缓解措施：关闭浏览器结束会话后重新启动，清除缓存的凭据。","status":"completed","collected_at":"2026-08-05T00:00:00Z","references":["http://www.acrossecurity.com/aspr/ASPR-2000-07-22-2-PUB.txt","http://www.securityfocus.com/bid/1793","https://docs.microsoft.com/en-us/security-updates/securitybulletins/2000/ms00-076","https://exchange.xforce.ibmcloud.com/vulnerabilities/5367","https://github.com/CVEProject/cvelistV5/blob/7db8931ea0378982e66f435e269a4ed0e4efb7aa/cves/2000/0xxx/CVE-2000-0982.json","https://github.com/LiuCan01/cve-list-pro/blob/78b55511cee3604c22d518e32822f0435d0cacc0/cve-list/CVE-2000/CVE-2000-0982","https://github.com/Patrowl/PatrowlHearsData/blob/f80eaead111eac7128eaf77e46b372cdbd675cc9/CVE/data/2000/CVE-2000-0982.json","https://github.com/nomi-sec/NVD-Database/blob/23dc120c34402aaa65883c51c1d03b3cb02c20cb/2000/CVE-2000-0982.json","https://github.com/olbat/nvdcve/blob/2aff155da1d1b98876d6e9c312b912d434f32dca/nvdcve/CVE-2000-0982.json","https://github.com/opencve/opencve-kb/blob/8ed64b4e31209e933908eff50d33cf701402ff24/2000/CVE-2000-0982.json","https://github.com/HORKimhab/poc-cve-collection/blob/e2cba2a029d0a53c95f0000f5eb42e0eb69717b8/2000/0xxx/CVE-2000-0982.md","https://github.com/fkie-cad/nvd-json-data-feeds/blob/2045bff4b424e5738e99702781803fdc8b55ff87/CVE-2000/CVE-2000-09xx/CVE-2000-0982.json","https://github.com/CyberSecAI/cve_info/blob/03b7e36424574a3a9ba5fd13480a326b666a1046/2000/0xxx/CVE-2000-0982.json","https://github.com/CVEProject/cvelist-dev/blob/5b8fbb570438e8094550205589cc6f1d122acc94/2000/0xxx/CVE-2000-0982.json"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":[],"repo_exp_urls":[],"has_poc":false,"has_exp":false,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/2000/AVE-2000-1888.toml"},{"ave_id":"AVE-2000-1809","file_name":"2000/AVE-2000-1809.toml","cve_id":"CVE-2000-0970","title":"Microsoft IIS ASP 安全会话劫持漏洞","description":"Microsoft IIS 4.0和5.0在处理ASP页面时，对安全（HTTPS）和非安全（HTTP）Web会话使用相同的Session ID Cookie。当用户从安全会话切换到非安全会话时，攻击者可通过网络嗅探或中间人攻击获取该Session ID Cookie，从而劫持用户的安全Web会话，导致敏感信息泄露。攻击者无需身份认证，只需诱使用户访问非安全页面即可利用此漏洞。","severity":"HIGH","score":7.5,"aliases":["CVE-2000-0970"],"sources":["avd"],"published":"2000-12-19T05:00:00Z","updated":"2026-06-16T21:52:52Z","remediation":"tags.The page didn't give much detail. This is a very old Microsoft IIS vulnerability. Let me construct the remediation based on known facts.\n\nThe vulnerability: IIS 4.0/5.0 .ASP pages send the same Session ID cookie for secure and insecure web sessions, allowing session hijacking. Fix: Microsoft released a security patch (this was part of Microsoft Security Bulletin MS00-087 or the December 2000 patch). Practical remediations:\n\n1. Install the security update from Microsoft (the December 2000 cumulative security patch for IIS)\n2. Upgrade to later IIS versions (IIS 6.0+)\n3. Configure the application so the Session ID cookie is only issued over HTTPS / mark cookie Secure attribute\n4. Force users to only use HTTPS, disable HTTP access\n5. Use ASP directives / registry to ensure secure cookies\n\nLet me write the Chinese remediation ≥20 chars.该漏洞（IIS 4.0/5.0 会话 Cookie 标记缺陷）的修复建议如下。微软已于 2000 年 12 月发布相应安全补丁，另有配置层面的加固手段。\n\n<value>建议安装微软针对 IIS 4.0/5.0 发布的相关安全补丁（MS00-087 及后续累积安全更新），彻底修复会话 Cookie 标记缺陷；或直接升级至 IIS 6.0 及以上版本以消除此漏洞。同时应加固应用配置：在 IIS 中为该站点强制启用 SSL 并要求所有客户端仅通过 HTTPS 访问，关闭 HTTP 明文入口；在 ASP 应用层面将 SessionID Cookie 设置为 Secure 属性，确保浏览器只在加密通道中传输会话标识，防止会话在 HTTP 与 HTTPS 间切换时被截获复用。若暂无法升级，可在防火墙或反向代理上丢弃或重定向非 HTTPS 会话请求，并缩短会话超时时间作为临时缓解。","status":"completed","collected_at":"2026-08-05T00:00:00Z","references":["http://www.acrossecurity.com/aspr/ASPR-2000-07-22-1-PUB.txt","http://www.osvdb.org/7265","https://docs.microsoft.com/en-us/security-updates/securitybulletins/2000/ms00-080","https://exchange.xforce.ibmcloud.com/vulnerabilities/5396","https://github.com/CVEProject/cvelistV5/blob/3eae031b5df6a3c6a1cc304f5e054cd002eb1bd6/cves/2000/0xxx/CVE-2000-0970.json","https://github.com/Patrowl/PatrowlHearsData/blob/5d8a0e95a20fbbbf3a45b439096d57770d841dec/CVE/data/2000/CVE-2000-0970.json","https://github.com/LiuCan01/cve-list-pro/blob/78b55511cee3604c22d518e32822f0435d0cacc0/cve-list/CVE-2000/CVE-2000-0970","https://github.com/nomi-sec/NVD-Database/blob/23dc120c34402aaa65883c51c1d03b3cb02c20cb/2000/CVE-2000-0970.json","https://github.com/olbat/nvdcve/blob/2aff155da1d1b98876d6e9c312b912d434f32dca/nvdcve/CVE-2000-0970.json","https://github.com/opencve/opencve-kb/blob/f9ec51bb42a17e0dd0492f440cee3d253cc8275e/2000/CVE-2000-0970.json","https://github.com/fkie-cad/nvd-json-data-feeds/blob/2045bff4b424e5738e99702781803fdc8b55ff87/CVE-2000/CVE-2000-09xx/CVE-2000-0970.json","https://github.com/HORKimhab/poc-cve-collection/blob/c45038e15e6e81771cce5512f28070ebf02ca969/2000/0xxx/CVE-2000-0970.md","https://github.com/CyberSecAI/cve_info/blob/03b7e36424574a3a9ba5fd13480a326b666a1046/2000/0xxx/CVE-2000-0970.json","https://github.com/CVEProject/cvelist-dev/blob/5b8fbb570438e8094550205589cc6f1d122acc94/2000/0xxx/CVE-2000-0970.json"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":["https://raw.githubusercontent.com/adysec/AVE/main/pocs/2000/POC-AVE-2000-1809.toml"],"repo_exp_urls":[],"has_poc":true,"has_exp":false,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/2000/AVE-2000-1809.toml"},{"ave_id":"AVE-2000-1808","file_name":"2000/AVE-2000-1808.toml","cve_id":"CVE-2000-0969","title":"Valve Half-Life Dedicated Server 格式化字符串远程代码执行漏洞","description":"Half-Life 专用服务器（build 3104 及更早版本）存在格式化字符串漏洞，远程攻击者可通过系统控制台或 rcon 接口向 changelevel 命令中注入格式化字符串，导致任意代码执行。该漏洞影响所有运行受影响版本的 Half-Life 专用服务器，CVSS 评分 10.0，危害等级严重。攻击者无需身份认证即可远程利用，可完全控制目标服务器。Valve 已发布更新修复此漏洞。","severity":"CRITICAL","score":10.0,"aliases":["CVE-2000-0969"],"sources":["avd"],"published":"2000-12-19T05:00:00Z","updated":"2026-06-16T21:52:52Z","remediation":"立即将 Half-Life 专用服务器升级至 build 3104 之后的版本（Valve 已发布补丁修复该格式化字符串漏洞）。如无法立即升级，应在防火墙层面限制对服务器 UDP/TCP 27015 端口的非信任来源访问，并禁用 rcon 远程控制功能或设置强 rcon 密码，防止未授权攻击者通过控制台或 rcon 接口注入恶意格式化字符串。","status":"completed","collected_at":"2026-08-05T00:00:00Z","references":["http://archives.neohapsis.com/archives/bugtraq/2000-10/0254.html","http://archives.neohapsis.com/archives/bugtraq/2000-10/0409.html","http://www.osvdb.org/6983","http://www.securityfocus.com/archive/1/141060","https://exchange.xforce.ibmcloud.com/vulnerabilities/5413","https://github.com/CVEProject/cvelistV5/blob/3eae031b5df6a3c6a1cc304f5e054cd002eb1bd6/cves/2000/0xxx/CVE-2000-0969.json","https://github.com/Patrowl/PatrowlHearsData/blob/5d8a0e95a20fbbbf3a45b439096d57770d841dec/CVE/data/2000/CVE-2000-0969.json","https://github.com/LiuCan01/cve-list-pro/blob/78b55511cee3604c22d518e32822f0
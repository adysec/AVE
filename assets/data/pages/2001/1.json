tp://www.vergenet.net/linux/perdition/string_format.html"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":[],"repo_exp_urls":[],"has_poc":false,"has_exp":false,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/2001/AVE-2001-0126.toml"},{"ave_id":"AVE-2001-0416","file_name":"2001/AVE-2001-0416.toml","cve_id":"CVE-2001-1352","title":"Namazu 2.0.9 跨站脚本漏洞","description":"Namazu 2.0.9 及更早版本存在跨站脚本（XSS）漏洞，远程攻击者可通过在 idxname 参数中指定无效索引文件，触发错误消息返回时注入恶意 JavaScript 脚本，导致其他用户在浏览器中执行任意脚本代码。该漏洞影响 Namazu 2.0.9 及之前所有版本，攻击者无需身份认证即可利用，危害较大。建议升级至最新版本或对 idxname 参数进行严格过滤。","severity":"HIGH","score":7.5,"aliases":["CVE-2001-1352"],"sources":["redhat"],"published":"2001-12-27T05:00:00.000","updated":"2026-06-16T21:56:06.100","remediation":"立即将 Namazu 升级至 2.0.10 或更高版本，该版本已修复 idxname 参数未正确过滤导致的跨站脚本漏洞。Red Hat Linux 7.0J 用户可通过 RHSA-2001:179-05 获取更新包（namazu-2.0.10-0j1）。如无法升级，在 Web 服务器层（如 Apache mod_rewrite）对 idxname 等 CGI 参数做输入校验，过滤 HTML 标签和特殊字符。","status":"completed","collected_at":"2026-07-27T00:00:00Z","references":["http://marc.info/?l=bugtraq&m=100947261916155&w=2","http://marc.info/?l=bugtraq&m=101060476404565&w=2","http://marc.info/?l=bugtraq&m=101068116016472&w=2","http://www.osvdb.org/5691","https://exchange.xforce.ibmcloud.com/vulnerabilities/7875","https://github.com/CVEProject/cvelistV5/blob/4657e449ea7feba15f77fd2fcd7d3eb9c12c86f5/cves/2001/1xxx/CVE-2001-1352.json","https://github.com/LiuCan01/cve-list-pro/blob/78b55511cee3604c22d518e32822f0435d0cacc0/cve-list/CVE-2001/CVE-2001-1352","https://github.com/HORKimhab/poc-cve-collection/blob/11a92cc3c0d31b9e78fe8f2a857dd04df3195701/2001/1xxx/CVE-2001-1352.md","https://github.com/Patrowl/PatrowlHearsData/blob/0298403c910e42219c357a4f56dac428565b2e47/CVE/data/2001/CVE-2001-1352.json","https://github.com/github/advisory-database/blob/724a585dd64bbf0d8e6760dd16b808140e9a0dd8/advisories/unreviewed/2022/04/GHSA-6vp8-72hx-47vm/GHSA-6vp8-72hx-47vm.json","https://github.com/yarencheng/cve-devops-playground/blob/a1f8b3e954dc569a9faaf2d530236d865bca3340/content/CVE-2001-1352.md","https://github.com/anonymous-55443259/CVE_Vul_File_Localization/blob/24756649f99ff5cea566f1e66a7fdd2ed0e7aced/Result/repository/repository_collection/repo_from_gpt/result/CVE-2001-1352/2.json","https://github.com/nomi-sec/NVD-Database/blob/23dc120c34402aaa65883c51c1d03b3cb02c20cb/2001/CVE-2001-1352.json","https://github.com/hungryfoolou/Vulnerability_Mining/blob/3df1d8ed0489ae1228f975ae1f58a690aae53886/craw/cveid_craw/cveid_craw/data/cveid_by_kind/cveid_xss.txt","https://github.com/nomi-sec/CVE-Easy-List/blob/bf88a9513efcd3d06fe8051f7c894c6d1196d7ba/2001.tsv"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":[],"repo_exp_urls":[],"has_poc":false,"has_exp":false,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/2001/AVE-2001-0416.toml"},{"ave_id":"AVE-2001-0414","file_name":"2001/AVE-2001-0414.toml","cve_id":"CVE-2001-1351","title":"Namazu 2.0.8 跨站脚本攻击","description":"Namazu 2.0.8及更早版本的索引文件命中数显示功能存在跨站脚本漏洞。远程攻击者可通过构造恶意的索引文件名，在显示命中数时注入任意JavaScript代码，导致其他Web用户浏览时执行恶意脚本。该漏洞影响Namazu 2.0.8及更早版本，CVSS评分7.5（高危），攻击向量为网络、攻击复杂度低、无需认证，可导致机密性、完整性、可用性部分受损。攻击者无需认证即可通过构造恶意索引文件名诱导用户访问，触发跨站脚本攻击，窃取用户会话、窃取敏感信息或执行其他恶意操作。建议升级至Namazu 2.0.9及以上版本修复该漏洞。","severity":"HIGH","score":7.5,"aliases":["CVE-2001-1351"],"sources":["redhat"],"published":"2001-12-25T05:00:00.000","updated":"2026-06-16T21:56:05.983","remediation":"建议立即升级到 Namazu 2.0.9 或更高版本（当前最新稳定版为 2.0.21），可从 http://www.namazu.org/stable/ 下载源码重新编译安装。如无法立即升级，可在 Web 服务器层面对搜索结果页的索引文件名输出进行 HTML 实体编码，防止 index 文件名称中的 JavaScript 代码在浏览器中执行，或在防火墙/反向代理层对包含 script、onerror 等关键字的搜索请求参数进行过滤拦截。","status":"completed","collected_at":"2026-07-26T00:00:00Z","references":["http://marc.info/?l=bugtraq&w=2&r=1&s=namazu&q=b","http://www.osvdb.org/5690","https://exchange.xforce.ibmcloud.com/vulnerabilities/7875","https://github.com/CVEProject/cvelistV5/blob/3619c6454232bc86bc1c5ee6d49baecbff394f3b/cves/2001/1xxx/CVE-2001-1351.json","https://github.com/LiuCan01/cve-list-pro/blob/78b55511cee3604c22d518e32822f0435d0cacc0/cve-
[{"ave_id":"AVE-2016-0406","file_name":"2016/AVE-2016-0406.toml","cve_id":"CVE-2016-3976","title":"SAP NetWeaver AS Java 目录遍历漏洞","description":"SAP NetWeaver Java AS 存在目录遍历漏洞，远程攻击者无需身份认证即可通过向 CrashFileDownloadServlet 的 fileName 参数传入 `..\\`（点反斜杠）序列绕过路径限制，实现任意文件读取。该漏洞影响 SAP NetWeaver AS Java 7.1 至 7.5 版本，可导致敏感配置文件、源代码等机密信息泄露。攻击者只需发送特制 HTTP 请求即可利用，无需特殊权限，CVSS 评分 7.5，危害等级高。SAP 已在安全公告 2234971 中发布修复补丁。","severity":"HIGH","score":7.5,"aliases":["CVE-2016-3976"],"sources":["kev"],"published":"2016-04-07T23:59:10Z","updated":"2026-06-17T00:46:39Z","remediation":"立即应用 SAP Security Note 2234971 对应的补丁包。对于 SAP NetWeaver AS Java 7.1-7.5，通过 SAP Solution Manager 或 SAP Launchpad 下载并安装最新 Support Package 或补丁。如无法立即打补丁，可在 Web 应用防火墙（WAF）层面拦截包含 `..\\` 路径遍历特征的请求，并限制对 CrashFileDownloadServlet 的访问权限作为临时缓解措施。","status":"completed","collected_at":"2026-07-27T00:00:00Z","references":["http://packetstormsecurity.com/files/137528/SAP-NetWeaver-AS-JAVA-7.5-Directory-Traversal.html","http://seclists.org/fulldisclosure/2016/Jun/40","https://erpscan.io/advisories/erpscan-16-012/","https://erpscan.io/press-center/blog/sap-security-notes-march-2016-review/","https://launchpad.support.sap.com/#/notes/2234971","https://www.exploit-db.com/exploits/39996/","https://www.cisa.gov/known-exploited-vulnerabilities-catalog?field_cve=CVE-2016-3976","https://www.exploit-db.com/exploits/39996","https://github.com/trickest/cve/blob/e69d88e0152845fc4d4b49970ca6e503f56b2f93/2016/CVE-2016-3976.md","https://github.com/cisagov/vulnrichment/blob/9553fde5ed5ff45a613d88bc99087dbba2111555/2016/3xxx/CVE-2016-3976.json","https://github.com/LiuCan01/cve-list-pro/blob/78b55511cee3604c22d518e32822f0435d0cacc0/cve-list/CVE-2016/CVE-2016-3976","https://github.com/vulncheck-oss/0day.today.archive/blob/3664abdd71985a44aff3260896a8f36e2f4a9682/web-applications/25126.txt","https://github.com/a-dhaou-tekup/VRA/blob/3e4f21c329250c5eca327489d3fd5be9b398ce7b/data/rag_corpus/cisa_kev_notes/CVE-2016-3976.txt","https://github.com/Ostorlab/KEV/blob/8feadeb8b7ff54359eab87941769781629146b23/README.md","https://github.com/nomi-sec/NVD-Database/blob/23dc120c34402aaa65883c51c1d03b3cb02c20cb/2016/CVE-2016-3976.json","https://github.com/lucacapacci/cisa_kev/blob/63008d9134e74f63e93e48616bac78e5f7abdf5b/data_single/2016/CVE-2016-3976.csv","https://github.com/mabitoski/cve_submodules/blob/44ad7e2705b3aef1b2ffaf64bd47596c10a6c2e4/2016/CVE-2016-3976.md","https://github.com/xqcyberscore/nvt/blob/978f6a9acb495d7d669239530ffe6da5d631f4da/2016/gb_sap_netweaver_mult_vuln_jun16.nasl"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":[],"repo_exp_urls":[],"has_poc":false,"has_exp":false,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/2016/AVE-2016-0406.toml"},{"ave_id":"AVE-2016-0106","file_name":"2016/AVE-2016-0106.toml","cve_id":"CVE-2016-1019","title":"Adobe Flash Player 远程代码执行漏洞","description":"Adobe Flash Player 21.0.0.197及之前版本中存在高危漏洞，远程攻击者可通过构造特制的Flash内容诱导用户访问，触发JIT Spraying攻击绕过地址空间布局随机化（ASLR）保护机制，进而导致应用程序崩溃或实现任意代码执行。该漏洞已在2016年4月被检测到在野利用，影响Windows、macOS、Linux等多个平台上的Flash Player。Adobe已在后续版本21.0.0.213中修复此漏洞。","severity":"CRITICAL","score":9.8,"aliases":["CVE-2016-1019"],"sources":["kev"],"published":"2016-04-07T10:59:01Z","updated":"2026-06-17T00:41:08Z","remediation":"立即升级 Adobe Flash Player 至 21.0.0.213 及以上版本（Windows/Mac）或 11.2.202.616 及以上版本（Linux）。由于 Adobe 已于 2020 年 12 月 31 日停止 Flash Player 支持并推荐卸载，建议彻底卸载 Flash Player 组件，并在浏览器中禁用 Flash 插件，同时通过组策略或注册表禁用 Flash 执行权限以彻底消除风险。","status":"completed","collected_at":"2026-07-27T00:00:00Z","references":["http://blogs.adobe.com/psirt/?p=1330","http://lists.opensuse.org/opensuse-security-announce/2016-04/msg00009.html","http://lists.opensuse.org/opensuse-security-announce/2016-04/msg00010.html","http://lists.opensuse.org/opensuse-security-announce/2016-04/msg00012.html","http://lists.opensuse.org/opensuse-security-announce/2016-04/msg00055.html","http://lists.opensuse.org/opensuse-security-announce/2016-05/msg00044.html","http://lists.opensuse.org/opensuse-security-announc
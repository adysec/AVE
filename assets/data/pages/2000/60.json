%40clico.pl","https://www.exploit-db.com/exploits/19870","https://github.com/CVEProject/cvelistV5/blob/60bbc98c39201e6f5661b9e41f1492ce39335948/cves/2000/0xxx/CVE-2000-0338.json","https://github.com/LiuCan01/cve-list-pro/blob/78b55511cee3604c22d518e32822f0435d0cacc0/cve-list/CVE-2000/CVE-2000-0338","https://github.com/yarencheng/cve-devops-playground/blob/cbe73d6bdcced13ea57f08566d6bbf5345864f7e/content/CVE-2000-0338.md","https://github.com/Patrowl/PatrowlHearsData/blob/f2c577e1255b2c3fd617b7f1c499a222feb7b668/CVE/data/2000/CVE-2000-0338.json","https://github.com/github/advisory-database/blob/d8c03b84658bbca948e09e4af723cb11141fb41e/advisories/unreviewed/2022/04/GHSA-5fxq-3r3p-42m4/GHSA-5fxq-3r3p-42m4.json","https://github.com/KTZgraph/sarenka/blob/f1fb931ab722d6c096d581ed6e3c5966d799fbaa/sarenka/feeds/cwe_details/cwe_details_0_100.json","https://github.com/intSpLoiT/intframework/blob/eabaa799d0260aa52b735fa9769266d1ce4b64ef/modules/cve_list.txt","https://github.com/Team-Atlanta/aixcc-asc-atlantis/blob/785c446f980e12155935db586aa30c3b54adcc86/crs/src/crs-patch/smith/smith/lib/cwe/raw/CWE-412.txt","https://github.com/andreafioraldi/ToolsForCyberChallenge/blob/197d3dfd204cf1b9d1af1451455c8831c3ff9948/generated/files_4.list.dict","https://github.com/nomi-sec/NVD-Exploit-List-Ja/blob/b82432e7d59d95db9f183c0cefa7744595784afa/2000.tsv"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":["https://raw.githubusercontent.com/adysec/AVE/main/pocs/2000/POC-AVE-2000-0285.toml"],"repo_exp_urls":["https://raw.githubusercontent.com/adysec/AVE/main/exploits/2000/EXP-AVE-2000-0285.toml"],"has_poc":true,"has_exp":true,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/2000/AVE-2000-0285.toml"},{"ave_id":"AVE-2000-0511","file_name":"2000/AVE-2000-0511.toml","cve_id":"CVE-2000-0459","title":"IMP MSWordView 拒绝服务漏洞","description":"IMP up to 2.2 Pre12 版本的 MSWordView 应用程序存在文件清理漏洞。当应用程序异常退出时，无法正确删除文档处理过程中产生的临时文件。攻击者可通过反复打开大量文档并提前中断请求，导致系统积累大量未处理的临时文件，逐渐填满磁盘空间，引发拒绝服务攻击，使正常用户无法使用该应用程序。该漏洞影响广泛部署的 IMP 软件中的 MSWordView 模块，由于涉及本地用户权限，攻击者可轻松利用此缺陷破坏系统可用性，尤其在磁盘空间有限的环境中威胁性更大。","severity":"MEDIUM","score":5.0,"aliases":["CVE-2000-0459"],"sources":["avd"],"published":"2000-04-22T04:00:00Z","updated":"2026-06-16T21:51:46Z","remediation":"建议升级 IMP 到 2.2 Pre12 及以上版本（该版本已修复 MSWordView 退出时未清理临时文件的问题）。若无法立即升级，可配置定时任务定期清理 /tmp 目录下 MSWordView 遗留的临时文件（如 /tmp/mswv_*），或限制单用户最大磁盘配额防止磁盘被填满导致拒绝服务。","status":"completed","collected_at":"2026-07-24T00:00:00Z","references":["http://marc.info/?l=bugtraq&m=95672120116627&w=2","http://www.securityfocus.com/bid/1361","https://github.com/CVEProject/cvelistV5/blob/67d48875bcd35ab339290b9a99c435b09bd5c40b/cves/2000/0xxx/CVE-2000-0459.json","https://github.com/LiuCan01/cve-list-pro/blob/78b55511cee3604c22d518e32822f0435d0cacc0/cve-list/CVE-2000/CVE-2000-0459","https://github.com/HORKimhab/poc-cve-collection/blob/f7d503345a02e01eaaf915c0e3939c46f947a88c/2000/0xxx/CVE-2000-0459.md","https://github.com/Patrowl/PatrowlHearsData/blob/c52ac29e3e33d673083c7aada18d2fe25f185ca8/CVE/data/2000/CVE-2000-0459.json","https://github.com/github/advisory-database/blob/2b8a7bdd977d852aa4b7aade01f4fcd4d623cfde/advisories/unreviewed/2022/04/GHSA-6cjc-9cq5-fc4r/GHSA-6cjc-9cq5-fc4r.json","https://github.com/yarencheng/cve-devops-playground/blob/4731f60845c8f35e2bdb03d333a9e9d84c7b1c27/content/CVE-2000-0459.md","https://github.com/intSpLoiT/intframework/blob/eabaa799d0260aa52b735fa9769266d1ce4b64ef/modules/cve_list.txt","https://github.com/nomi-sec/NVD-Database/blob/23dc120c34402aaa65883c51c1d03b3cb02c20cb/2000/CVE-2000-0459.json","https://github.com/oasis-open/cti-stix-common-objects/blob/55ba7598cbd5a52577b6887871505d931d85cb61/objects/vulnerability/vulnerability--904c9cfb-5b32-46a1-bbe7-e7d08990a7f9.json","https://github.com/leego972/titanai/blob/afa5b2310463aae5781d3fd9408071bf38e79806/data/raw/corpus_D_cyber/nvd_cve_001311.txt"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":[],"repo_exp_urls":[],"has_poc":false,"has_exp":false,"raw_url":"https://github.com/ady
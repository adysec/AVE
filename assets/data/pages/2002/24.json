ty_center/static/9095.php","http://www.kb.cert.org/vuls/id/970915","http://www.osvdb.org/11187","http://www.quakesrc.org/forum/topicDisplay.php?topicID=160","http://www.securityfocus.com/bid/4744","https://www.exploit-db.com/exploits/21450","https://github.com/CVEProject/cvelistV5/blob/2e429c9a0087eb0ee678d77c344076eb39564d19/cves/2002/0xxx/CVE-2002-0770.json","https://github.com/LiuCan01/cve-list-pro/blob/78b55511cee3604c22d518e32822f0435d0cacc0/cve-list/CVE-2002/CVE-2002-0770","https://github.com/Patrowl/PatrowlHearsData/blob/604ddf5b05f9e8ce70a7b6f9716ba166db0bd437/CVE/data/2002/CVE-2002-0770.json","https://github.com/nomi-sec/NVD-Database/blob/23dc120c34402aaa65883c51c1d03b3cb02c20cb/2002/CVE-2002-0770.json","https://github.com/olbat/nvdcve/blob/fe7f195231342e1e88104679c53c965e9a67ac35/nvdcve/CVE-2002-0770.json","https://github.com/opencve/opencve-kb/blob/fbdcc0a51e272b519ec8a57a1db338df26d96406/2002/CVE-2002-0770.json","https://github.com/HORKimhab/poc-cve-collection/blob/c80cd921505a9f88e4aae41f1414ac3763e708ba/2002/0xxx/CVE-2002-0770.md","https://github.com/fkie-cad/nvd-json-data-feeds/blob/3a7c0c4aa01967d2633d808f80f3fcd65491b947/CVE-2002/CVE-2002-07xx/CVE-2002-0770.json","https://github.com/CyberSecAI/cve_info/blob/03b7e36424574a3a9ba5fd13480a326b666a1046/2002/0xxx/CVE-2002-0770.json","https://github.com/yarencheng/cve-devops-playground/blob/2ea9851780633b2caab16fe048a14b38ca9a0b56/content/CVE-2002-0770.md"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":[],"repo_exp_urls":[],"has_poc":false,"has_exp":false,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/2002/AVE-2002-0431.toml"},{"ave_id":"AVE-2002-0428","file_name":"2002/AVE-2002-0428.toml","cve_id":"CVE-2002-0769","title":"Cisco ATA-186 HTTP设备配置信息泄露漏洞","description":"Cisco ATA-186 模拟电话适配器的 Web 管理界面存在身份认证绕过漏洞。远程攻击者可通过向该设备的配置接口发送仅包含单个字节的 HTTP POST 请求绕过登录认证，从而获取管理员密码或修改设备配置参数。该漏洞影响 Cisco ATA-186 全系列版本，攻击者无需任何身份凭证即可利用，可能导致设备被完全控制及通信数据泄露。","severity":"MEDIUM","score":6.4,"aliases":["CVE-2002-0769"],"sources":["exploitdb"],"published":"2002-08-12T04:00:00Z","updated":"2026-06-16T21:58:05Z","remediation":"立即升级 Cisco ATA 186 固件至厂商修复版本（参见 Cisco 安全公告：http://www.cisco.com/warp/public/707/ata186-password-disclosure.shtml）。如无法升级，在设备所在网络边界部署访问控制列表（ACL），仅允许受信任管理 IP 访问设备的 Web 管理端口（默认 TCP 80），并禁用 WAN 侧对管理界面的访问。同时建议将设备置于内部管理 VLAN 中，避免暴露在不可信网络中。","status":"completed","collected_at":"2026-08-03T00:00:00Z","references":["http://archives.neohapsis.com/archives/bugtraq/2002-05/0083.html","http://www.cisco.com/warp/public/707/ata186-password-disclosure.shtml","http://www.iss.net/security_center/static/9056.php","http://www.iss.net/security_center/static/9057.php","http://www.securityfocus.com/bid/4711","http://www.securityfocus.com/bid/4712","https://www.exploit-db.com/exploits/21441","https://github.com/trickest/cve/blob/7d40e7d94b41c478b4d1a654c7bc3bcf34fa7beb/2002/CVE-2002-0769.md","https://github.com/CVEProject/cvelistV5/blob/2e429c9a0087eb0ee678d77c344076eb39564d19/cves/2002/0xxx/CVE-2002-0769.json","https://github.com/Patrowl/PatrowlHearsData/blob/604ddf5b05f9e8ce70a7b6f9716ba166db0bd437/CVE/data/2002/CVE-2002-0769.json","https://github.com/LiuCan01/cve-list-pro/blob/78b55511cee3604c22d518e32822f0435d0cacc0/cve-list/CVE-2002/CVE-2002-0769","https://github.com/mabitoski/cve_submodules/blob/44ad7e2705b3aef1b2ffaf64bd47596c10a6c2e4/2002/CVE-2002-0769.md","https://github.com/nomi-sec/NVD-Database/blob/23dc120c34402aaa65883c51c1d03b3cb02c20cb/2002/CVE-2002-0769.json","https://github.com/olbat/nvdcve/blob/fe7f195231342e1e88104679c53c965e9a67ac35/nvdcve/CVE-2002-0769.json","https://github.com/brenonevs/prs-pentest/blob/001cf17eedeb4aad73618d3140ca1f5dc93e69b3/CVEs & POCs/2002/CVE-2002-0769.md","https://github.com/opencve/opencve-kb/blob/cbf0905811e3a7a53efa9a65584bb426cc9bcca8/2002/CVE-2002-0769.json","https://github.com/HORKimhab/poc-cve-collection/blob/c80cd921505a9f88e4aae41f1414ac3763e708ba/2002/0xxx/CVE-2002-0769.md"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":["https://raw.githubusercontent.com/adysec/AVE/main/pocs/2002/POC-AVE-2002-0428.toml"],"repo_exp_urls":["https://raw.githubusercontent.com/adysec/AVE/main/exploits/2002/EXP-AVE-2002-0428.toml"],"has_poc":true,"has_exp":true,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/2002/AVE-2002-0428.toml"},{"ave_id":"AVE-2002-0424","file_name":"2002/AVE-2002-0424.toml","cve_id":"CVE-2002-0767","title":"Richard Gooch SimpleInit 文件描述符未关闭导致本地权限提升漏洞","description":"Linux 系统下的 SimpleInit 2.0.2 存在文件描述符泄露漏洞。SimpleInit 在创建子进程前未关闭已打开的读写 FIFO 文件描述符，导致子进程可通过该描述符向父进程 SimpleInit 发送恶意指令，从而以 root 权限执行任意程序。攻击者需拥有本地访问权限，利用难度较低，可完全控制目标系统。该漏洞影响 Richard Gooch SimpleInit 2.0.2 及可能更早版本。","severity":"HIGH","score":7.2,"aliases":["CVE-2002-0767"],"sources":["exploitdb"],"published":"2002-08-12T04:00:00Z","updated":"2026-06-16T21:58:05Z","remediation":"立即升级 simpleinit 至 2.0.3 或更高版本，该版本在 fork 子进程前关闭 /dev/initctl 的读写文件描述符。如无法升级，可手动修改 simpleinit 源码，在 fork() 调用前添加 close(3) 关闭 FIFO 描述符后重新编译。对于仍使用 simpleinit 的旧系统，建议迁移至 systemd 或 sysvinit 等现代 init 系统以彻底消除此风险。","status":"completed","collected_at":"2026-08-03T00:00:00Z","references":["http://online.securityfocus.com/archive/1/276739","http://www.iss.net/security_center/static/9357.php","http://www.securityfocus.com/bid/5001","https://www.exploit-db.com/exploits/21538","https://github.com/CVEProject/cvelistV5/blob/2e429c9a0087eb0ee678d77c344076eb39564d19/cves/2002/0xxx/CVE-2002-0767.json","https://github.com/Patrowl/PatrowlHearsData/blob/604ddf5b05f9e8ce70a7b6f9716ba166db0bd437/CVE/data/2002/CVE-2002-0767.json","https://github.com/LiuCan01/cve-list-pro/blob/78b55511cee3604c22d518e32822f0435d0cacc0/cve-list/CVE-2002/CVE-2002-0767","https://github.com/nomi-sec/NVD-Database/blob/23dc120c34402aaa65883c51c1d03b3cb02c20cb/2002/CVE-2002-0767.json","https://github.com/olbat/nvdcve/blob/fe7f195231342e1e88104679c53c965e9a67ac35/nvdcve/CVE-2002-0767.json","https://github.com/opencve/opencve-kb/blob/30161b4638c37443322916a4d97a62c41686781e/2002/CVE-2002-0767.json","https://github.com/fkie-cad/nvd-json-data-feeds/blob/3a7c0c4aa01967d2633d808f80f3fcd65491b947/CVE-2002/CVE-2002-07xx/CVE-2002-0767.json","https://github.com/HORKimhab/poc-cve-collection/blob/c80cd921505a9f88e4aae41f1414ac3763e708ba/2002/0xxx/CVE-2002-0767.md","https://github.com/CyberSecAI/cve_info/blob/03b7e36424574a3a9ba5fd13480a326b666a1046/2002/0xxx/CVE-2002-0767.json","https://github.com/CVEProject/cvelist-dev/blob/5b8fbb570438e8094550205589cc6f1d122acc94/2002/0xxx/CVE-2002-0767.json"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":[],"repo_exp_urls":[],"has_poc":false,"has_exp":false,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/2002/AVE-2002-0424.toml"},{"ave_id":"AVE-2002-0422","file_name":"2002/AVE-2002-0422.toml","cve_id":"CVE-2002-0764","title":"Phorum 3.3.2a 远程命令执行漏洞","description":"Phorum 3.3.2a 存在远程命令执行漏洞，远程攻击者可通过向 plugin.php、admin.php 或 del.php 发送特制 HTTP 请求，修改 PHORUM[settings_dir] 变量指向包含恶意 PHP 文件的目录，从而在服务器上执行任意命令。该漏洞影响 Phorum 3.3.2a 及更早版本，攻击无需身份认证，危害严重。目前厂商已发布修复版本，建议升级至最新版。","severity":"HIGH","score":7.5,"aliases":["CVE-2002-0764"],"sources":["exploitdb"],"published":"2002-08-12T04:00:00Z","updated":"2026-06-16T21:58:05Z","remediation":"升级 Phorum 至 3.3.2b 或更高版本以修复变量覆盖漏洞；如无法升级，删除或限制对 plugin.php、admin.php、del.php 的 Web 访问权限，并在 php.ini 中禁用 allow_url_include 和 register_globals。由于 Phorum 已停止维护，建议迁移至现代论坛系统。","status":"completed","collected_at":"2026-08-03T00:00:00Z","references":["http://archives.neohapsis.com/archives/bugtraq/2002-05/0147.html","http://archives.neohapsis.com/archives/bugtraq/2002-05/0153.html","http://www.iss.net/security_center/static/9107.php","http://www.phorum.org/","http://www.securityfocus.com/bid/4763","https://www.exploit-db.com/exploits/21459","https://github.com/CVEProject/cvelistV5/blob/2e429c9a0087eb0ee678d77c344076eb39564d19/cves/2002/0xxx/CVE-2002-0764.json","https://github.com/Patrowl/PatrowlHearsData/blob/604ddf5b05f9e8ce70a7b6f9716ba166db0bd437/CVE/data/2002/CVE-2002-0764.json","https://github.com/LiuCan01/cve-list-pro/blob/78b5
","https://github.com/yarencheng/cve-devops-playground/blob/1fe9b156eeeb72b8f8baa50bbe7bc0d9806e8c64/content/CVE-1999-1113.md","https://github.com/Patrowl/PatrowlHearsData/blob/248c2167e720df96125f6ac9925793063a207510/CVE/data/1999/CVE-1999-1113.json","https://github.com/github/advisory-database/blob/cdfc8886d71af7ef3bdab3e4db46753ff8af6538/advisories/unreviewed/2022/04/GHSA-f3c5-443m-3w9q/GHSA-f3c5-443m-3w9q.json","https://github.com/blackhook/nessus-plugins/blob/64177d96abbb07c58cf7e131046b067ebc61fcb5/P/poppassd_too_long_user.nasl","https://github.com/SpeeDr00t/speedr00t.github.com/blob/0380f0c2190556fabe90257cb6c0034a42f68951/securityfocus/0x1000/75/info.html","https://github.com/olbat/nvdcve/blob/63d4031680b3d3fa77b826660a1e30ffc70ff5cd/nvdcve/CVE-1999-1113.json","https://github.com/oasis-open/cti-stix-common-objects/blob/55ba7598cbd5a52577b6887871505d931d85cb61/objects/vulnerability/vulnerability--9f9f8904-8bd2-49ab-807a-504523f0e837.json","https://github.com/nomi-sec/CVE-Easy-List/blob/0b7b3d855cd8fca7b800fb29d6754e2da82897b6/1999.tsv"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":[],"repo_exp_urls":[],"has_poc":false,"has_exp":false,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/1999/AVE-1999-1236.toml"},{"ave_id":"AVE-1999-1290","file_name":"1999/AVE-1999-1290.toml","cve_id":"CVE-1999-1499","title":"ISC BIND 符号链接本地文件破坏漏洞","description":"ISC BIND 4.9 及 8.1 版本中 `named` 服务进程存在本地符号链接漏洞。当管理员使用 SIGINT 或 SIGIOT 信号终止 `named` 进程时，该进程会向 `named_dump.db` 或 `named.stats` 文件写入数据。本地攻击者可预先创建同名符号链接指向系统关键文件，诱使 `named` 进程以 root 权限覆写目标文件，造成文件破坏或拒绝服务。该漏洞攻击复杂度低，但需要本地访问权限，CVSS 评分 2.1，危害较低。","severity":"LOW","score":2.1,"aliases":["CVE-1999-1499"],"sources":["avd"],"published":"1998-04-10T04:00:00Z","updated":"2026-06-16T21:50:34Z","remediation":"立即升级至 BIND 9 系列最新稳定版（如 9.20.24），BIND 4.x/8.x 已停止维护多年。如无法升级，将 named 运行在 chroot 或容器隔离环境中，限制其对文件系统的写入权限；同时确保 named_dump.db 和 named.stats 所在目录仅允许 named 用户写入，并启用文件系统防护机制（如 nosuid、noexec 挂载选项）防止符号链接攻击。","status":"completed","collected_
[{"ave_id":"AVE-2013-0100","file_name":"2013/AVE-2013-0100.toml","cve_id":"CVE-2013-0641","title":"Adobe Acrobat Reader 远程代码执行漏洞","description":"Adobe Reader 和 Acrobat 存在缓冲区溢出漏洞，攻击者可构造特制的 PDF 文档并诱使用户打开，触发缓冲区溢出，从而在目标系统上执行任意代码。该漏洞影响 Adobe Reader/Acrobat 9.5.4 之前版本、10.1.6 之前版本及 11.0.02 之前版本，已在 2013 年 2 月被检测到在野利用。攻击者无需身份认证，仅需用户通过邮件或网页等方式打开恶意 PDF 文件即可触发，危害严重。","severity":"HIGH","score":7.8,"aliases":["CVE-2013-0641"],"sources":["kev"],"published":"2013-02-14T01:55:02Z","updated":"2026-06-16T23:49:49Z","remediation":"立即升级 Adobe Reader/Acrobat 至 9.5.4、10.1.6 或 11.0.02 及以上版本（对应 APSB13-15 安全公告）。如无法升级，在 Adobe Reader 中启用保护模式（沙箱）并禁用 JavaScript 执行（编辑→首选项→JavaScript→取消勾选\"启用 Acrobat JavaScript\"），同时建议使用组策略禁用 PDF 内嵌对象的自动解析功能。对于企业环境，可通过 Adobe 自定义部署工具批量推送更新。","status":"completed","collected_at":"2026-07-22T00:00:00Z","references":["http://blog.fireeye.com/research/2013/02/in-turn-its-pdf-time.html","http://blogs.adobe.com/psirt/2013/02/adobe-reader-and-acrobat-vulnerability-report.html","http://blogs.mcafee.com/mcafee-labs/digging-into-the-sandbox-escape-technique-of-the-recent-pdf-exploit","http://lists.opensuse.org/opensuse-security-announce/2013-02/msg00021.html","http://lists.opensuse.org/opensuse-security-announce/2013-02/msg00023.html","http://lists.opensuse.org/opensuse-security-announce/2013-02/msg00024.html","http://rhn.redhat.com/errata/RHSA-2013-0551.html","http://security.gentoo.org/glsa/glsa-201308-03.xml","http://www.adobe.com/support/security/advisories/apsa13-02.html","http://www.adobe.com/support/security/bulletins/apsb13-07.html","http://www.kb.cert.org/vuls/id/422807","https://oval.cisecurity.org/repository/search/definition/oval%3Aorg.mitre.oval%3Adef%3A16296","https://www.cisa.gov/known-exploited-vulnerabilities-catalog?field_cve=CVE-2013-0641","https://github.com/trickest/cve/blob/ed228d55b7972f63e700a35a54fbcd94064b9ade/2013/CVE-2013-0641.md","https://github.com/CVEProject/cvelistV5/blob/6e1fee15e021f95477107e3e5d652470f76f7bac/cves/2013/0xxx/CVE-2013-0641.json","https://github.com/LiuCan01/cve-list-pro/blob/78b55511cee3604c22d518e32822f0435d0cacc0/cve-list/CVE-2013/CVE-2013-0641","https://github.com/cisagov/vulnrichment/blob/40201653244e9d985cea536a2ac651eca18f5fd4/2013/0xxx/CVE-2013-0641.json","https://github.com/hardik05/hardik05.github.io/blob/fbaf75354452796b925e63fc62b4720575079a4d/blog/cve-2013-0641-analysis.html","https://github.com/a-dhaou-tekup/VRA/blob/3e4f21c329250c5eca327489d3fd5be9b398ce7b/data/rag_corpus/cisa_kev_notes/CVE-2013-0641.txt","https://github.com/cyberdudebivash/cyberdudebivash-ai-security-hub/blob/13403e1745f63237e7ef6d51562fb36112320d77/frontend/cve/CVE-2013-0641.html","https://github.com/Ostorlab/KEV/blob/8feadeb8b7ff54359eab87941769781629146b23/README.md","https://github.com/kees/ubuntu-cve-tracker/blob/66a43c37da527bc16621fb5548dca8aa1f46e537/retired/CVE-2013-0641","https://github.com/sslab-gatech/platpal/blob/864bc64e561645deff60fb5280aa70e90f4b9c01/result/exploits/cve.list"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":["https://raw.githubusercontent.com/adysec/AVE/main/pocs/2013/POC-AVE-2013-0100.toml"],"repo_exp_urls":[],"has_poc":true,"has_exp":false,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/2013/AVE-2013-0100.toml"},{"ave_id":"AVE-2013-0099","file_name":"2013/AVE-2013-0099.toml","cve_id":"CVE-2013-0640","title":"Adobe Acrobat/Reader 远程代码执行漏洞","description":"Adobe Reader 和 Acrobat 在处理特制 PDF 文档时存在内存破坏漏洞，攻击者可通过构造恶意的 PDF 文件并诱使用户打开，触发内存越界写入，从而在目标系统上执行任意代码或导致拒绝服务。该漏洞在 2013 年 2 月已被野外利用，影响 Adobe Reader 和 Acrobat 9.5.4 之前版本、10.1.6 之前版本及 11.0.02 之前版本，CVSS 评分 7.8，危害等级高。用户仅需打开恶意 PDF 文件即可被远程攻击，无需额外交互条件。","severity":"HIGH","score":7.8,"aliases":["CVE-2013-0640"],"sources":["kev"],"published":"2013-02-14T01:55:02Z","updated":"2026-06-16T23:49:49Z","remediation":"升级 Adobe Reader/Acrobat 至 9.5.4、10.1.6 或 11.0.02 及以上版本。在组策略中禁用 PDF 浏览器内嵌插件，设置 Adobe Reader 为「受保护的视图」模式，并启用增强安全设置阻止自动执行 JavaScript。对于无法立即升级的系统，建议使用替代 PDF 阅读器或通过应用白名单机制限制 Acrobat 进程启动。","status":"completed","collected_at":"2026-0
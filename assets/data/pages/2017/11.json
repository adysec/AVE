_urls":[],"repo_exp_urls":[],"has_poc":false,"has_exp":false,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/2017/AVE-2017-1109.toml"},{"ave_id":"AVE-2017-0126","file_name":"2017/AVE-2017-0126.toml","cve_id":"CVE-2017-7925","title":"大华数字录像机和IP摄像机配置文件密码漏洞","description":"大华多款数字录像机和IP摄像机的配置文件以明文或弱保护方式存储管理员密码，攻击者无需身份认证即可远程读取配置文件获取密码，随后冒充管理员身份登录设备，访问敏感监控数据并进行恶意操控。该漏洞影响大华DH-IPC-HDBW23A0RN-ZS、DH-IPC-HDBW13A0SN、DH-IPC-HDW1XXX、DH-IPC-HDW2XXX、DH-IPC-HDW4XXX、DH-IPC-HFW1XXX、DH-IPC-HFW2XXX、DH-IPC-HFW4XXX、DH-SD6CXX、DH-NVR1XXX、DH-HCVR4XXX、DH-HCVR5XXX等多款设备。由于攻击条件宽松（无需认证、网络可达即可），该漏洞被评定为严重等级。","severity":"CRITICAL","score":9.8,"aliases":["CVE-2017-7925"],"sources":["nuclei"],"published":"2017-05-06T00:29:00Z","updated":"2026-06-17T01:25:29Z","remediation":"立即升级 Dahua 受影响设备固件至最新版本（联系 Dahua 技术支持或授权经销商获取），同时修改所有默认密码，启用高强度密码策略。将设备移至防火墙后部隔离网段，禁止从 Internet 直接访问；如需远程管理则通过 VPN 接入并启用双因素认证。定期清理配置文件中明文密码，部署后执行配置变更审计。","status":"completed","collected_at":"2026-07-28T00:00:00Z","references":["http://us.dahuasecurity.com/en/us/Security-Bulletin_030617.php","http://www.securityfocus.com/bid/98312","https://ics-cert.us-cert.gov/advisories/ICSA-17-124-02","https://github.com/projectdiscovery/nuclei-templates/blob/main/http/cves/2017/CVE-2017-7925.yaml","https://github.com/trickest/cve/blob/b3a270a001a31742516eaea5c494f365de9d3c80/2017/CVE-2017-7925.md","https://github.com/projectdiscovery/nuclei-templates/blob/3887f9deba3194900fbfb1022d8155887325c384/http/cves/2017/CVE-2017-7925.yaml","https://github.com/ExpLangcn/NucleiTP/blob/2b7ecb9031a6eda4f272793045f29b339d8e0cce/CVES/critical/CVE-2017-7925.yaml","https://github.com/zan8in/afrog/blob/9c47a2b9b7e12375757acdfbc179354920c87bd8/pocs/afrog-pocs/CVE/2017/CVE-2017-7925.yaml","https://github.com/SleepingBag945/dddd/blob/4c428a7c171275bfbb5fa72c2fb4bd7b48f4ff4a/common/config/pocs/CVE-2017-7925.yaml","https://github.com/CVEProject/cvelistV5/blob/ee7574df80bfcc012868b69b66762b8e0d540545/cves/2017/7xxx/CVE-2017-7925.json","https://github.com/0x727/FingerprintHub/blob/be9cbbdcace5bb1f0274d67feb2141e8b491875d/plugins/dahuasecurity/dh-ipc-hdbw23a0rn-zs_firmware/CVE-2017-7925.yaml","https://github.com/zan8in/afrog-pocs/blob/253291be2d307a6c836d5997bbb838f1e846f9ba/CVE/2017/CVE-2017-7925.yaml","https://github.com/linuxadi/40k-nuclei-templates/blob/542be6820c801c02a33aee60f1c05ca7b0b5005f/aditya/folder4/CVE-2017-7925.yaml","https://github.com/LiuCan01/cve-list-pro/blob/78b55511cee3604c22d518e32822f0435d0cacc0/cve-list/CVE-2017/CVE-2017-7925"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":[],"repo_exp_urls":[],"has_poc":false,"has_exp":false,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/2017/AVE-2017-0126.toml"},{"ave_id":"AVE-2017-0777","file_name":"2017/AVE-2017-0777.toml","cve_id":"CVE-2017-5689","title":"Intel Active Management Technology 远程权限提升漏洞","description":"Intel Active Management Technology (AMT)、Intel Standard Manageability (ISM) 及 Intel Small Business Technology (SBT) 版本 6.x 至 11.6 存在访问控制缺陷（CWE-269），未授权的远程网络攻击者可通过向 AMT/ISM 管理端口（如 16992/16993）发送特制 Digest 认证请求绕过鉴权，直接获取系统级权限；本地未授权攻击者亦可启用管理功能提升至网络或本地系统权限。该漏洞影响广泛部署于企业服务器、工作站的 Intel 管理引擎固件，CVSS 3.1 评分 9.8 (CRITICAL，AV:N/AC:L/PR:N/UI:N/S:U/C:H/I:H/A:H)，已列入 CISA 已知被利用漏洞目录，攻击者无需认证即可远程接管设备管理控制权，最终完全控制目标主机操作系统。","severity":"CRITICAL","score":9.8,"aliases":["CVE-2017-5689"],"sources":["nuclei"],"published":"2017-05-02T14:59:00Z","updated":"2026-06-17T01:21:02Z","remediation":"升级 Intel AMT/ISM 固件到 v12.0 或更高版本，从 Intel 支持网站下载并应用官方固件更新包，或通过 Windows Update 自动更新 AMT 组件。如无法立即应用固件更新，请在防火墙中禁用未授权的 AMT 网络访问，并确保 AMT 管理密码安全设置（启用强密码+双因素认证），同时禁用 AMT 的 Internet 共享功能 IDS。","status":"completed","collected_at":"2026-07-28T00:00:00Z","references":["http://www.oracle.com/technetwork/security-advisory/cpujul2017-3236622.html","http://www.securityfocus.com/bid/98269","http://www.securitytracker.com/id/1038385","https://cert-portal.siemens.com/productcert/pdf/ssa-874235.pdf","https://downloadmirror.intel.com/26754/eng/INTEL-SA-00075%20Mitigation%20Guide-Rev%201.1.pdf","https://h20566.www2.hpe.com/hpsc/doc/public/display?docLocale=en_US&docId=emr_na-hpesbhf03754en_us","https://security-center.intel.com/advisory.aspx?intelid=INTEL-SA-00075&languageid=en-fr","https://security.netapp.com/advisory/ntap-20170509-0001/","https://www.embedi.com/files/white-papers/Silent-Bob-is-Silent.pdf","https://www.embedi.com/news/mythbusters-cve-2017-5689","https://www.tenable.com/blog/rediscovering-the-intel-amt-vulnerability","https://www.cisa.gov/known-exploited-vulnerabilities-catalog?field_cve=CVE-2017-5689","https://www.exploit-db.com/exploits/43385","https://github.com/projectdiscovery/nuclei-templates/blob/main/http/cves/2017/CVE-2017-5689.yaml","https://github.com/trickest/cve/blob/be44b05b9428dc18bc0705cf60dd8d8640cd49b1/2017/CVE-2017-5689.md","https://github.com/qazbnm456/awesome-cve-poc/blob/fc862e38e03ea68cdc62618d14891a426daff1a4/CVE-2017-5689.md","https://github.com/0xMarcio/cve/blob/d08f837f771e6cd83ec9c845b0c4f72f125cbe84/2017/CVE-2017-5689.md","https://github.com/nomi-sec/PoC-in-GitHub/blob/bed70a0a2e2dec8bd34bd440f68f32280391094f/2017/CVE-2017-5689.json","https://github.com/nixawk/labs/blob/ce800ddc00a8bbf716afe754a1e81e58570b8c50/CVE-2017-5689/CVE-2017-5689.py","https://github.com/sari3l/Poc-Monitor/blob/6a32bab1b63e302ab8a4aae06190853195172067/2017/CVE-2017-5689.json","https://github.com/nmap/nmap/blob/486c990d1562f3a9f79527b0aa854bf4fa7784c7/scripts/http-vuln-cve2017-5689.nse","https://github.com/Ostorlab/KEV/blob/8feadeb8b7ff54359eab87941769781629146b23/nuclei/CVE-2017-5689.yaml","https://github.com/CVEDB/Poc-Git/blob/0275aeb329b0747c9a1d46160c921eae06095557/2017/CVE-2017-5689.md","https://github.com/kaismax/CVE-Poc/blob/6d8c93dabf674cea102713781cc534d577412357/2017/CVE-2017-5689.md","https://github.com/bartblaze/Disable-Intel-AMT","https://github.com/embedi/amt_auth_bypass_poc","https://github.com/CerberusSecurity/CVE-2017-5689","https://github.com/Bijaye/intel_amt_bypass","https://github.com/MlSebrell/amthoneypot"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":[],"repo_exp_urls":[],"has_poc":false,"has_exp":false,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/2017/AVE-2017-0777.toml"},{"ave_id":"AVE-2017-0115","file_name":"2017/AVE-2017-0115.toml","cve_id":"CVE-2017-5631","title":"KMCIS CaseAware login.php 反射型跨站脚本漏洞","description":"KMCIS CaseAware 的 login.php 页面中存在反射型跨站脚本（XSS）漏洞，用户参数（usr）在传递至查询字符串时未经过充分的过滤与转义处理。远程攻击者可构造包含恶意 JavaScript 代码的特制 URL，诱使已登录用户点击，从而在目标浏览器会话中执行任意脚本，窃取会话凭证或发起钓鱼攻击。该漏洞影响 KMCIS CaseAware 相关版本，CVSS 评分 6.1，危害等级中危。","severity":"MEDIUM","score":6.1,"aliases":["CVE-2017-5631"],"sources":["nuclei"],"published":"2017-05-01T14:59:00Z","updated":"2026-06-17T01:20:53Z","remediation":"对 login.php 中 usr 参数的所有用户输入进行严格的 HTML 实体编码和输出转义，使用白名单过滤机制禁止特殊字符。建议在 Web 应用防火墙（WAF）层面添加针对 XSS 的检测规则，拦截包含 &lt;script&gt;、onerror 等恶意载荷的请求。由于 KMCIS 已停止维护，建议迁移至其他受支持的案件管理系统。","status":"completed","collected_at":"2026-07-28T00:00:00Z","references":["https://www.exploit-db.com/exploits/42042/","https://www.openbugbounty.org/incidents/228262/","https://www.exploit-db.com/exploits/42042","https://github.com/projectdiscovery/nuclei-templates/blob/main/http/cves/2017/CVE-2017-5631.yaml","https://github.com/trickest/cve/blob/be44b05b9428dc18bc0705cf60dd8d8640cd49b1/2017/CVE-2017-5631.md","https://github.com/projectdiscovery/nuclei-templates/blob/d45959218d975ac3d65b6dea81478745e4a6e03d/http/cves/2017/CVE-2017-5631.yaml","https://github.com/ExpLangcn/NucleiTP/blob/2b7ecb9031a6eda4f272793045f29b339d8e0cce/CVES/medium/CVE-2017-5631.yaml","https://github.com/ExpLangcn/NucleiTP/blob/2b7ecb9031a6eda4f272793045f29b339d8e0cce/CVES/medium/cve-2017-5631-3031.yaml","https://github.com/ExpLangcn/NucleiTP/blob/2b7ecb9031a6eda4f272793045f29b339d8e0cce/CVES/medium/cve-2017-5631-3030.yaml","https://github.com/GhostTroops/scan4all/blob/fff03b51bf79c8993a46c1da766ec993e1102c47/config/51pwn/yaml/CaseAware/CVE-2017-5631.yaml","https://github.com/CVEProject/cvelistV5/blob/676b40fa5dad82f5f5be4cb920867579d5869c49/cves/2017/5xxx/CVE-2017-5631.json","https://github.com/sepehrdaddev/zap-scripts/blob/2b63b02ca79cc7f0023cdbab72c5c6c774354b07/active/CVE-2017-5631.js","https://github.com/veo/vscan/blob/1beb10c08e377e15b7dd417be1843bb75aa8c4f0/pocs_yml/nucleiFiles/cves/2017/CVE-2017-5631.yaml","https://github.com/cckuailong/reapoc/blob/699762e4c31d0183733f64313d8fc3be6470bd37/2017/CVE-2017-5631/poc/nuclei/CVE-2017-5631.yaml"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":[],"repo_exp_urls":[],"has_poc":false,"has_exp":false,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/2017/AVE-2017-0115.toml"},{"ave_id":"AVE-2017-0609","file_name":"2017/AVE-2017-0609.toml","cve_id":"CVE-2017-3066","title":"Adobe ColdFusion 反序列化漏洞","description":"Adobe ColdFusion 的 Apache BlazeDS 库存在 Java 反序列化漏洞（CWE-502），攻击者可通过向目标服务器发送特制的序列化数据包触发该漏洞，无需身份认证即可实现远程代码执行。该漏洞影响 ColdFusion 2016 Update 3 及更早版本、ColdFusion 11 Update 11 及更早版本、ColdFusion 10 Update 22 及更早版本，CVSS 评分 9.8，危害等级严重。攻击者只需网络可达即可利用，无需任何权限或用户交互，已有公开的 Exploit-DB 及 GitHub PoC 代码，实际威胁极高。Adobe 官方已发布安全更新修复此漏洞。","severity":"CRITICAL","score":9.8,"aliases":["CVE-2017-3066"],"sources":["kev"],"published":"2017-04-27T14:59:00Z","updated":"2026-06-17T01:17:26Z","remediation":"升级 Adobe ColdFusion 至 2016 Update 4、ColdFusion 11 Update 12 或 ColdFusion 10 Update 23 及以上版本。如无法立即升级，可在 ColdFusion 管理后台禁用 BlazeDS 远程访问，或通过防火墙限制 /flex2gateway/ 和 /messagebroker/ 路径的外部访问。","status":"completed","collected_at":"2026-07-27T00:00:00Z","references":["http://www.securityfocus.com/bid/98003","http://www.securitytracker.com/id/1038364","https://helpx.adobe.com/security/products/coldfusion/apsb17-14.html","https://www.exploit-db.com/exploits/43993/","https://www.cisa.gov/known-exploited-vulnerabilities-catalog?field_cve=CVE-2017-3066","https://www.exploit-db.com/exploits/43993","https://github.com/trickest/cve/blob/be44b05b9428dc18bc0705cf60dd8d8640cd49b1/2017/CVE-2017-3066.md","https://github.com/vulhub/vulhub/blob/aeaf65793f147f29bd50841ef77f4e9cad07ecc7/coldfusion/CVE-2017-3066/README.md","https://github.com/nomi-sec/PoC-in-GitHub/blob/d0611a30d788ecc6797a40a15a38427bf0c3c17b/2017/CVE-2017-3066.json","https://github.com/Threekiii/Awesome-POC/blob/0f9e22b660cb1ea12c1c3668f9128d93e08da412/%E4%B8%AD%E9%97%B4%E4%BB%B6%E6%BC%8F%E6%B4%9E/Adobe%20ColdFusion%20%E5%8F%8D%E5%BA%8F%E5%88%97%E5%8C%96%E6%BC%8F%E6%B4%9E%20CVE-2017-3066.md","https://github.com/fofapro/vulfocus/blob/4b7a2eaacce4ed770f289e6e72f7240da1e16c74/writeup/CVE-2017-3066/CVE-2017-3066.md","https://github.com/CCrashBandicot/helpful/blob/336b2c95b482d6c9de7756109b2699c7cfd8545c/CVE-2017-3066.py","https://github.com/BaizeSec/bylibrary/blob/dee1fbaa831df860c6905f80de8700211ba63098/docs/%E6%BC%8F%E6%B4%9E%E5%BA%93/03-%E4%BA%A7%E5%93%81%E6%BC%8F%E6%B4%9E/Adobe/Adobe%20ColdFusion/Adobe%20ColdFusion%20%E5%8F%8D%E5%BA%8F%E5%88%97%E5%8C%96%E6%BC%8F%E6%B4%9E%EF%BC%88CVE-2017-3066%EF%BC%89.md","https://github.com/Metarget/metarget/blob/3cd1d6256fbc0e9a7b82d8449ded87f76340af27/vulns_app/coldfusion/CVE-2017-3066/desc.yaml","https://github.com/gelusus/wxvl/blob/adf269d0776d63ad63598085918a36e4953f7c9c/doc/2025-04/CVE-2017-3066%20%E6%B7%B1%E5%85%A5%E5%88%A9%E7%94%A8%E8%8E%B7%E5%8F%96%E5%91%BD%E4%BB%A4%E5%9B%9E%E6%98%BE.md","https://github.com/Threekiii/Vulnerability-Wiki/blob/b32b83c01eabac4d6b4b334852be9cff76ba67ee/docs-base/docs/middleware/Adobe-ColdFusion-%E5%8F%8D%E5%BA%8F%E5%88%97%E5%8C%96%E6%BC%8F%E6%B4%9E-CVE-2017-3066.md","https://github.com/codewhitesec/ColdFusionPwn","https://github.com/cucadili/CVE-2017-3066"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":["https://raw.githubusercontent.com/adysec/AVE/main/pocs/2017/POC-AVE-2017-0609.toml"],"repo_exp_urls":["https://raw.githubusercontent.com/adysec/AVE/main/exploits/2017/EXP-AVE-2017-0609.toml"],"has_poc":true,"has_exp":true,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/2017/AVE-2017-0609.toml"},{"ave_id":"AVE-2017-1111","file_name":"2017/AVE-2017-1111.toml","cve_id":"CVE-2017-8291","title":"Artifex Ghostscript 类型转换远程命令执行漏洞","description":"Artifex Ghostscript 存在类型混淆漏洞，攻击者可通过构造特制的 EPS 文档，在文档中嵌入包含 \"/OutputFile (%pipe%\" 子串的 .rsdparams 参数，绕过 Ghostscript 的 -dSAFER 安全沙箱保护机制，导致远程命令执行。该漏洞影响 Ghostscript 9.21 及之前版本，已在 2017 年 4 月被野外利用。攻击者只需诱使用户使用 Ghostscript 或依赖 Ghostscript 的应用程序（如 ImageMagick、Python PIL 库等）打开恶意 EPS 文件即可触发，无需身份认证，危害严重。","severity":"HIGH","score":7.8,"aliases":["CVE-2017-8291"],"sources":["kev"],"published":"2017-04-27T01:59:02Z","updated":"2026-06-17T01:26:08Z","remediation":"升级到 Ghostscript 9.22 或更高版本（9.21 及之前版本均受影响）。可通过包管理器更新：`apt install ghostscript`（Debian/Ubuntu）、`yum update ghostscript`（CentOS/RHEL）或从 https://www.ghostscript.com/download/gsdnld.html 下载源码编译安装。如无法立即升级，可在使用 ImageMagick/Python PIL 等库处理用户上传图像时，禁用 EPS 处理或添加 `-dSAFER -dDELAYSAFER` 参数，并在系统层面移除或限制 `gs` 二进制文件的 SUID 权限。","status":"completed","collected_at":"2026-07-27T00:00:00Z","references":["http://openwall.com/lists/oss-security/2017/04/28/2","http://www.debian.org/security/2017/dsa-3838","http://www.securityfocus.com/bid/98476","https://access.redhat.com/errata/RHSA-2017:1230","https://bugs.ghostscript.com/show_bug.cgi?id=697808","https://bugzilla.redhat.com/show_bug.cgi?id=1446063","https://bugzilla.suse.com/show_bug.cgi?id=1036453","https://git.ghostscript.com/?p=ghostpdl.git%3Ba=commit%3Bh=04b37bbce174eed24edec7ad5b920eb93db4d47d","https://security.gentoo.org/glsa/201708-06","https://www.exploit-db.com/exploits/41955/","https://www.cisa.gov/known-exploited-vulnerabilities-catalog?field_cve=CVE-2017-8291","https://www.exploit-db.com/exploits/41955","https://github.com/trickest/cve/blob/be44b05b9428dc18bc0705cf60dd8d8640cd49b1/2017/CVE-2017-8291.md","https://github.com/vulhub/vulhub/blob/aeaf65793f147f29bd50841ef77f4e9cad07ecc7/python/PIL-CVE-2017-8291/README.zh-cn.md","https://github.com/nomi-sec/PoC-in-GitHub/blob/7fe82fb470b3291b506f74c6717a29e3837f8a29/2017/CVE-2017-8291.json","https://github.com/wgpsec/AboutSecurity/blob/f3c8574e6fa1f9c1cd5aeaba5a209af796107b34/Vuln/middleware/python/PYTHON-PIL-CVE-2017-8291.md","https://github.com/arschlochnop/VulnWatchdog/blob/b55cbd6817c4f7c7c0ef55106259948a3caf7541/data/2017/CVE-2017-8291-shun1403_CVE-2017-8291.md","https://github.com/cckuailong/reapoc/blob/699762e4c31d0183733f64313d8fc3be6470bd37/2017/CVE-2017-8291/vultarget/README.md","https://github.com/Threekiii/Awesome-POC/blob/0f9e22b660cb1ea12c1c3668f9128d93e08da412/%E5%BC%80%E5%8F%91%E8%AF%AD%E8%A8%80%E6%BC%8F%E6%B4%9E/Python%20PIL%20%E8%BF%9C%E7%A8%8B%E5%91%BD%E4%BB%A4%E6%89%A7%E8%A1%8C%E6%BC%8F%E6%B4%9E%20CVE-2017-8291.md","https://github.com/LiuCan01/cve-list-pro/blob/78b55511cee3604c22d518e32822f0435d0cacc0/cve-list/CVE-2017/CVE-2017-8291","https://github.com/cisagov/vulnrichment/blob/c21137571cced5c6655bc31f22872abfb39df64b/2017/8xxx/CVE-2017-8291.json","https://github.com/microsoft/azurelinux/blob/27107f5514277fed0ee65866b65406fc77bacf4d/specs/g/ghostscript/ghostscript.spec","https://github.com/shun1403/CVE-2017-8291","https://github.com/DaniilOrchikov/PIL-CVE-2017-8291","https://github.com/hkcfs/PIL-CVE-2017-8291","https://github.com/shun1403/PIL-CVE-2017-8291-study"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":["https://raw.githubusercontent.com/adysec/AVE/main/pocs/2017/POC-AVE-2017-1111.toml"],"repo_exp_urls":["https://raw.githubusercontent.com/adysec/AVE/main/exploits/2017/EXP-AVE-2017-1111.toml"],"has_poc":true,"has_exp":true,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/2017/AVE-2017-1111.toml"}]
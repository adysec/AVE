6887871505d931d85cb61/objects/vulnerability/vulnerability--074a9c77-eebe-436c-8c4c-7bd43da86fd3.json"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":[],"repo_exp_urls":[],"has_poc":false,"has_exp":false,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/2001/AVE-2001-0206.toml"},{"ave_id":"AVE-2001-0205","file_name":"2001/AVE-2001-0205.toml","cve_id":"CVE-2001-0521","title":"Aladdin eSafe Gateway 3.0 Unicode 脚本过滤绕过漏洞","description":"Aladdin eSafe Gateway 3.0 及更早版本存在 Unicode 编码绕过漏洞，远程攻击者可通过将 HTML 文档中的 SCRIPT 标签进行 Unicode 编码，绕过网关的 HTML 脚本过滤机制。成功利用该漏洞可导致跨站脚本攻击（XSS），造成敏感信息泄露、会话劫持或恶意脚本执行。攻击无需认证，仅需诱使用户访问特制网页即可触发。","severity":"HIGH","score":7.5,"aliases":["CVE-2001-0521"],"sources":["exploitdb"],"published":"2001-08-14T04:00:00Z","updated":"2026-06-16T21:54:27Z","remediation":"升级到 Aladdin eSafe Gateway 3.0 以上版本（如 3.1 或更高），该漏洞已在后续版本中修复。由于该产品已停止维护，建议迁移至现代 Web 安全网关产品（如 Fortinet FortiWeb、F5 BIG-IP ASM 等），并在迁移前在网络层部署 WAF 规则对 Unicode 编码的 `<SCRIPT>` 标签进行规范化检测和拦截。","status":"completed","collected_at":"2026-07-22T00:00:00Z","references":["http://archives.neohapsis.com/archives/bugtraq/2001-05/0285.html","https://exchange.xforce.ibmcloud.com/vulnerabilities/6580","https://www.exploit-db.com/exploits/20891","https://github.com/CVEProject/cvelistV5/blob/6e1fee15e021f95477107e3e5d652470f76f7bac/cves/2001/0xxx/CVE-2001-0521.json","https://github.com/LiuCan01/cve-list-pro/blob/78b55511cee3604c22d518e32822f0435d0cacc0/cve-list/CVE-2001/CVE-2001-0521","https://github.com/yarencheng/cve-devops-playground/blob/cbe73d6bdcced13ea57f08566d6bbf5345864f7e/content/CVE-2001-0521.md","https://github.com/Patrowl/PatrowlHearsData/blob/d449633638bc4d33beb359a70dee0dbe66d39a20/CVE/data/2001/CVE-2001-0521.json","https://github.com/github/advisory-database/blob/9a63d131cc61df62c077c7700617ad6343ec52ef/advisories/unreviewed/2022/04/GHSA-pgcc-58m2-q23c/GHSA-pgcc-58m2-q23c.json","https://github.com/SpeeDr00t/speedr00t.github.com/blob/0380f0c2190556fabe90257cb6c0034a42f68951/securityfocus/0x89000/88862/info.html","https://github.com/intSpLoiT/intframework/blob/eabaa799d0260aa52b735fa9769266d1ce4b64ef/modules/cve_list.txt","https://github.com/olbat/nvdcve/blob/5b92f5917a4a825187ccaac594f43456a77ea8f3/nvdcve/CVE-2001-0521.json","https://github.com/oasis-open/cti-stix-common-objects/blob/55ba7598cbd5a52577b6887871505d931d85cb61/objects/vulnerability/vulnerability--2a82b635-2546-405f-8605-655a65020384.json","https://github.com/nomi-sec/CVE-Easy-List/blob/f352dfaf39e3e89c1c3ab384d9e74e4219126910/2001.tsv"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":["https://raw.githubusercontent.com/adysec/AVE/main/pocs/2001/POC-AVE-2001-0205.toml"],"repo_exp_urls":["https://raw.githubusercontent.com/adysec/AVE/main/exploits/2001/EXP-AVE-2001-0205.toml"],"has_poc":true,"has_exp":true,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/2001/AVE-2001-0205.toml"},{"ave_id":"AVE-2001-0204","file_name":"2001/AVE-2001-0204.toml","cve_id":"CVE-2001-0520","title":"Aladdin eSafe Gateway 脚本过滤绕过漏洞","description":"Aladdin eSafe Gateway 3.0 及更早版本存在脚本过滤绕过漏洞。远程攻击者可通过将恶意 SCRIPT 代码嵌入特定 HTML 标签属性中（如 BODY 标签的 onload 属性、A 标签的 href 属性、BUTTON 标签、INPUT 标签以及其他支持脚本定义的 HTML 标签），绕过网关的安全过滤机制，在目标用户浏览器中执行任意脚本代码。该漏洞无需身份认证即可远程利用，可能导致敏感信息泄露、会话劫持或进一步攻击。CVSS 评分 7.5，危害等级高。","severity":"HIGH","score":7.5,"aliases":["CVE-2001-0520"],"sources":["exploitdb"],"published":"2001-08-14T04:00:00Z","updated":"2026-06-16T21:54:27Z","remediation":"升级 Aladdin eSafe Gateway 至 3.0 以上版本（厂商已发布修复版本）。由于该产品已停止维护，建议迁移至受支持的 Web 安全网关产品。如无法立即升级，可在网关上启用更严格的 HTTP 内容过滤规则，对包含 onload、onclick、onerror 等事件处理器的 HTML 标签进行深度检测和拦截，并禁用不必要的 HTML 标签白名单外的所有标签。","status":"completed","collected_at":"2026-07-22T00:00:00Z","references":["http://archives.neohapsis.com/archives/bugtraq/2001-05/0284.html","https://exchange.xforce.ibmcloud.com/vulnerabilities/6580","https://www.exploit-db.com/exploits/20869","https://github.com/CVEProject/cvelistV5/blob/6e1fee15e021f95477107e3e5d652470f76f7bac/cves/2001/0xxx/CVE-2001-0520.json","https://github.com/LiuCan01/cve-list-pro/blob/78b55511cee3604c22d518e32822f0435d0cacc0/cve-list/CVE-2001/CVE-2001-0520","https://github.com/yarencheng/cve-devops-playground/blob/cbe73d6bdcced13ea57f08566d6bbf5345864f7e/content/CVE-2001-0520.md","https://github.com/Patrowl/PatrowlHearsData/blob/d449633638bc4d33beb359a70dee0dbe66d39a20/CVE/data/2001/CVE-2001-0520.json","https://github.com/github/advisory-database/blob/9119295a984ba3fccef08b7eec3fc9b62b1da974/advisories/unreviewed/2022/04/GHSA-jv87-5579-838c/GHSA-jv87-5579-838c.json","https://github.com/SpeeDr00t/speedr00t.github.com/blob/0380f0c2190556fabe90257cb6c0034a42f68951/securityfocus/0x89000/88824/info.html","https://github.com/nomi-sec/NVD-Database/blob/23dc120c34402aaa65883c51c1d03b3cb02c20cb/2001/CVE-2001-0520.json","https://github.com/KTZgraph/sarenka/blob/f1fb931ab722d6c096d581ed6e3c5966d799fbaa/sarenka/feeds/cve_details/cve_all_details_151300_151400.json","https://github.com/andreafioraldi/ToolsForCyberChallenge/blob/197d3dfd204cf1b9d1af1451455c8831c3ff9948/generated/files_3.list.dict","https://github.com/lardianos/Security/blob/611d68cad16afa3eb18254e639badc38b2f85777/CWE_83/tex/chapters/intro/intro.tex"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":["https://raw.githubusercontent.com/adysec/AVE/main/pocs/2001/POC-AVE-2001-0204.toml"],"repo_exp_urls":["https://raw.githubusercontent.com/adysec/AVE/main/exploits/2001/EXP-AVE-2001-0204.toml"],"has_poc":true,"has_exp":true,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/2001/AVE-2001-0204.toml"},{"ave_id":"AVE-2001-0203","file_name":"2001/AVE-2001-0203.toml","cve_id":"CVE-2001-0519","title":"Aladdin eSafe Gateway HTML标签脚本过滤绕过漏洞","description":"Aladdin eSafe Gateway 2.x 版本存在 HTML 脚本过滤绕过漏洞。远程攻击者可通过将 SCRIPT 标签嵌套嵌入其他 SCRIPT 标签内的特殊 HTML 标签排列方式，绕过网关的 HTML SCRIPT 过滤机制，导致恶意脚本代码被传递至目标用户浏览器执行。攻击者无需身份认证即可远程利用，成功利用后可窃取用户会话 Cookie、篡改网页内容或发起钓鱼攻击，影响机密性、完整性和可用性。该漏洞影响 Aladdin eSafe Gateway 2.x 及 3.0 版本。","severity":"HIGH","score":7.5,"aliases":["CVE-2001-0519"],"sources":["exploitdb"],"published":"2001-08-14T04:00:00Z","updated":"2026-06-16T21:54:27Z","remediation":"该产品已停止维护，建议立即升级至受支持的 Web 安全网关产品。如暂时无法替换，可在 eSafe Gateway 管理控制台中启用深度内容检测（Deep Content Inspection）功能，并在上游防火墙或反向代理层部署额外的 Web 应用过滤规则，拦截嵌套的 `<SCRIPT>` 标签模式。","status":"completed","collected_at":"2026-07-22T00:00:00Z","references":["http://archives.neohapsis.com/archives/bugtraq/2001-05/0282.html","https://exchange.xforce.ibmcloud.com/vulnerabilities/6580","https://www.exploit-db.com/exploits/20890","https://github.com/CVEProject/cvelistV5/blob/6e1fee15e021f95477107e3e5d652470f76f7bac/cves/2001/0xxx/CVE-2001-0519.json","https://github.com/LiuCan01/cve-list-pro/blob/78b55511cee3604c22d518e32822f0435d0cacc0/cve-list/CVE-2001/CVE-2001-0519","https://github.com/yarencheng/cve-devops-playground/blob/cbe73d6bdcced13ea57f08566d6bbf5345864f7e/content/CVE-2001-0519.md","https://github.com/Patrowl/PatrowlHearsData/blob/d449633638bc4d33beb359a70dee0dbe66d39a20/CVE/data/2001/CVE-2001-0519.json","https://github.com/github/advisory-database/blob/7c78b01f402841eaeb570a26d276cd67a60a9531/advisories/unreviewed/2022/04/GHSA-3pqf-w3gx-274j/GHSA-3pqf-w3gx-274j.json","https://github.com/SpeeDr00t/speedr00t.github.com/blob/0380f0c2190556fabe90257cb6c0034a42f68951/securityfocus/0x89000/88850/info.html","https://github.com/intSpLoiT/intframework/blob/eabaa799d0260aa52b735fa9769266d1ce4b64ef/modules/cve_list.txt","https://github.com/olbat/nvdcve/blob/5b92f5917a4a825187ccaac594f43456a77ea8f3/nvdcve/CVE-2001-0519.json","https://github.com/oasis-open/cti-stix-common-objects/blob/55ba7598cbd5a52577b6887871505d931d85cb61/objects/vulnerability/vulnerability--d0ab60e6-fb4c-4056-99a5-1cfbf5174b3d.json","https://github.com/nomi-sec/CVE-Easy-List/blob/864adb9ddf294417a5a4e84f90f9adf54e9dca89/2001.tsv"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":["https://raw.githubusercontent.com/adysec/AVE/main/pocs/2001/POC-AVE-2001-0203.toml"],"repo_exp_urls":[],"has_poc":true,"has_exp":false,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/2001/AVE-2001-0203.toml"},{"ave_id":"AVE-2001-0464","file_name":"2001/AVE-2001-0464.toml","cve_id":"CVE-2001-1115","title":"SIX-webboard 2.01 任意文件读取漏洞","description":"SIX-webboard 2.01 及更早版本中的 generate.cgi 脚本存在目录遍历漏洞，远程攻击者无需身份认证即可通过在 content 参数中插入 ../（点点斜杠）序列读取服务器上的任意文件。该漏洞可导致敏感信息泄露，如配置文件、密码文件等。攻击者只需向目标 Web 服务器发送特制的 HTTP 请求即可触发，利用门槛低，危害较大。","severity":"MEDIUM","score":5.0,"aliases":["CVE-2001-1115"],"sources":["exploitdb"],"published":"2001-08-13T04:00:00Z","updated":"2026-06-16T21:55:36Z","remediation":"立即升级 SIX-webboard 至 2.01 以上版本（如厂商已停止维护，建议迁移至其他受支持的论坛系统）。临时缓解措施：在 Web 服务器（Apache/Nginx）层面配置规则，对 `/cgi-bin/webboard/generate.cgi` 的 `content` 参数过滤 `../` 和空字节 `%00`，或直接禁用该 CGI 脚本的访问权限。","status":"completed","collected_at":"2026-07-27T00:00:00Z","references":["http://www.securityfocus.com/archive/1/204053","http://www.securityfocus.com/bid/3175","https://exchange.xforce.ibmcloud.com/vulnerabilities/6975","https://www.exploit-db.com/exploits/21068","https://github.com/CVEProject/cvelistV5/blob/4a22bba3217932039300edbc77cd188c415d71c8/cves/2001/1xxx/CVE-2001-1115.json","https://github.com/LiuCan01/cve-list-pro/blob/78b55511cee3604c22d518e32822f0435d0cacc0/cve-list/CVE-2001/CVE-2001-1115","https://github.com/HORKimhab/poc-cve-collection/blob/41644568d1e47f962c2cefae75c8b09359290a26/2001/1xxx/CVE-2001-1115.md","https://github.com/Patrowl/PatrowlHearsData/blob/4bd823fa5ff72ec859371ff3ef0f5e18be2f2c77/CVE/data/2001/CVE-2001-1115.json","https://github.com/github/advisory-database/blob/29919db3f954d9ce9be0e7e3cf177436392d45d3/advisories/unreviewed/2022/04/GHSA-g8vq-gg5f-2hc9/GHSA-g8vq-gg5f-2hc9.json","https://github.com/blackhook/nessus-plugins/blob/64177d96abbb07c58cf7e131046b067ebc61fcb5/S/six_webboard.nasl","https://github.com/SpeeDr00t/speedr00t.github.com/blob/0380f0c2190556fabe90257cb6c0034a42f68951/securityfocus/0x4000/3175/info.html","https://github.com/nomi-sec/NVD-Database/blob/23dc120c34402aaa65883c51c1d03b3cb02c20cb/2001/CVE-2001-1115.json","https://github.com/KTZgraph/sarenka/blob/f1fb931ab722d6c096d581ed6e3c5966d799fbaa/sarenka/feeds/cve_details/cve_all_details_151400_151500.json","https://github.com/nomi-sec/CVE-Easy-List/blob/b3f8802d959465aac8f9cdd0806abe7fb52f94b5/2001.tsv"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":[],"repo_exp_urls":[],"has_poc":false,"has_exp":false,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/2001/AVE-2001-0464.toml"},{"ave_id":"AVE-2001-0498","file_name":"2001/AVE-2001-0498.toml","cve_id":"CVE-2001-1259","title":"Avaya Argent Office DNS 数据包拒绝服务漏洞","description":"Avaya Argent Office 存在拒绝服务漏洞，远程攻击者可通过向目标系统的 DNS 端口（UDP 53）发送无载荷的空数据包，导致服务进程崩溃或停止响应。该漏洞无需身份认证即可远程触发，攻击复杂度低，影响 Avaya Argent Office 通信系统的正常可用性。ExploitDB 上已有公开的利用代码，攻击者可直接使用。","severity":"MEDIUM","score":5.0,"aliases":["CVE-2001-1259"],"sources":["exploitdb"],"published":"2001-08-07T04:00:00Z","updated":"2026-06-16T21:55:54Z","remediation":"该产品已于多年前停止支持，Avaya 不再提供安全补丁。建议在网络边界防火墙或 ACL 中阻止向该设备 UDP 53 端口发送非授权 DNS 流量，仅允许受信任的内部 DNS 服务器与其通信。如业务允许，应尽快将 Avaya Argent Office 替换为受支持的现代通信系统，从根本上消除风险。","status":"completed","collected_at":"2026-07-27T00:00:00Z","references":["http://online.securityfocus.com/archive/1/202344","http://www.iss.net/security_center/static/6953.php","https://www.exploit-db.com/exploits/23337","https://github.com/CVEProject/cvelistV5/blob/3fc46d7716e9a0dd9635d13e2bff8fffb122a860/cves/2001/1xxx/CVE-2001-1259.json","https://github.com/LiuCan01/cve-list-pro/blob/78b55511cee3604c22d518e32822f0435d0cacc0/cve-list/CVE-2001/CVE-2001-1259","https://github.com/HORKimhab/poc-cve-collection/blob/41644568d1e47f962c2cefae75c8b09359290a26/2001/1xxx/CVE-2001-1259.md","https://github.com/Patrowl/PatrowlHearsData/blob/73cd39be077fdbedc5ca2ea7e2723723d25285cc/CVE/data/2001/CVE-2001-1259.json","https://github.com/github/advisory-database/blob/1c8e3f4146e1bef501493d1237acb1611ea8f707/advisories/unreviewed/2022/04/GHSA-qqff-4wqg-8vmv/GHSA-qqff-4wqg-8vmv.json","https://github.com/SpeeDr00t/speedr00t.github.com/blob/0380f0c2190556fabe90257cb6c0034a42f68951/securityfocus/0x88000/87006/info.html","https://github.com/nomi-sec/NVD-Database/blob/23dc120c34402aaa65883c51c1d03b3cb02c20cb/2001/CVE-2001-1259.json","https://github.com/KTZgraph/sarenka/blob/f1fb931ab722d6c096d581ed6e3c5966d799fbaa/sarenka/feeds/cve_details/cve_all_details_151400_151500.json","https://github.com/hungryfoolou/Vulnerability_Mining/blob/3df1d8ed0489ae1228f975ae1f58a690aae53886/craw/cveid_craw/cveid_craw/data/cveid_by_kind/cveid_dos.txt","https://github.com/nomi-sec/NVD-Exploit-List-Ja/blob/b82432e7d59d95db9f183c0cefa7744595784afa/2001.tsv"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":["https://raw.githubusercontent.com/adysec/AVE/main/pocs/2001/POC-AVE-2001-0498.toml"],"repo_exp_urls":[],"has_poc":true,"has_exp":false,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/2001/AVE-2001-0498.toml"},{"ave_id":"AVE-2001-0276","file_name":"2001/AVE-2001-0276.toml","cve_id":"CVE-2001-0647","title":"Orange Software Orange Web Server 2.1 拒绝服务漏洞","description":"Orange Software Orange Web Server 2.1 基于 GoAhead Web 服务器开发，在处理不包含 HTTP 版本号的 HTTP GET 请求时存在输入验证缺陷。远程未认证攻击者可发送畸形的 HTTP GET 请求（缺少 HTTP/1.0 或 HTTP/1.1 版本标识），导致服务器进程崩溃或陷入死循环，造成拒绝服务攻击。该漏洞影响 Orange Web Server 2.1 版本，攻击者无需认证即可远程发起攻击，攻击复杂度低，仅影响服务可用性（CVSS 5.0，AV:N/AC:L/Au:N/C:N/I:N/A:P）。攻击者只需向目标服务器发送精心构造的不含 HTTP 版本的 GET 请求即可触发拒绝服务，导致 Web 服务停止响应合法请求。ExploitDB (EDB-20655) 等公开渠道已披露 PoC 代码，攻击者可直接利用现成脚本发起攻击。建议升级至修复版本或迁移至受支持的 Web 服务器软件。","severity":"MEDIUM","score":5.0,"aliases":["CVE-2001-0647"],"sources":["exploitdb"],"published":"2001-08-06T04:00:00Z","updated":"2026-06-16T21:54:41Z","remediation":"建议立即升级 Orange Web Server 至 2.1 以上版本（建议升级至最新版本），或升级底层 GoAhead Web Server 至已修复该漏洞的版本（GoAhead 2.1.8 或更高版本已修复此 HTTP 版本缺失导致的 DoS 问题）。如无法立即升级，可在前端部署 WAF 或负载均衡器，配置规则拦截缺少 HTTP 版本号的 HTTP GET 请求（如 \"GET /path\" 而非 \"GET /path HTTP/1.0\"），或在防火墙层面拦截不符合 RFC 2616 规范的 HTTP 请求行作为临时缓解措施。建议尽快联系厂商获取官方补丁包并尽快部署。","status":"completed","collected_at":"2026-07-23T00:00:00Z","references":["http://www.securityfocus.com/archive/1/165658","http://www.securityfocus.com/bid/2432","https://www.exploit-db.com/exploits/20655","https://github.com/CVEProject/cvelistV5/blob/f02fdda2bd389f5492ddcbf2ad808b3b60f20645/cves/2001/0xxx/CVE-2001-0647.json","https://github.com/LiuCan01/cve-list-pro/blob/78b55511cee3604c22d518e32822f0435d0cacc0/cve-list/CVE-2001/CVE-2001-0647","https://github.com/yarencheng/cve-devops-playground/blob/4731f60845c8f35e2bdb03d333a9e9d84c7b1c27/content/CVE-2001-0647.md","https://github.com/Patrowl/PatrowlHearsData/blob/45906bb48c7a525a11d1008ce22e1e5c2f2f58c2/CVE/data/2001/CVE-2001-0647.json","https://github.com/github/advisory-database/blob/24f07005949aaf2eb169012a6779e6dffdc5a952/advisories/unreviewed/2022/04/GHSA-f2pj-5wrm-j9xg/GHSA-f2pj-5wrm-j9xg.json","https://github.com/Freem93/grammar_nasl_v2/blob/63834ebb8cd6e97050e155291c7500ad53bb20c6/plugins/orange_dos.nasl","https://github.com/nomi-sec/NVD-Database/blob/23dc120c34402aaa65883c51c1d03b3cb02c20cb/2001/CVE-2001-0647.json","https://github.com/SpeeDr00t/speedr00t.github.com/blob/0380f0c2190556fabe90257cb6c0034a42f68951/securityfocus/0x3000/2432/info.html","https://github.com/andreafioraldi/ToolsForCyberChallenge/blob/197d3dfd204cf1b9d1af1451455c8831c3ff9948/generated/files_5.list.dict","https://github.com/hungryfoolou/Vulnerability_Mining/blob/3df1d8ed0489ae1228f975ae1f58a690aae53886/craw/cveid_craw/cveid_craw/data/cveid_by_kind/cveid_dos.txt"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":[],"repo_exp_urls":[],"has_poc":false,"has_exp":false,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/2001/AVE-2001-0276.toml"},{"ave_id":"AVE-2001-0551","file_name":"2001/AVE-2001-0551.toml","cve_id":"CVE-2001-1472","title":"phpBB 1.4 SQL注入漏洞","description":"phpBB 1.4.0 和 1.4.1 版本的 prefs.php 文件中存在 SQL 注入漏洞，远程已认证攻击者可通过 viewemail 参数注入任意 SQL 命令，从而执行任意 SQL 语句并获取管理员权限。该漏洞影响 phpBB 1.4.0 和 1.4.1 版本，攻击者需具备有效用户账号进行认证后，通过构造恶意的 viewemail 参数值注入 SQL 语句，绕过权限控制实现权限提升至管理员权限。CVSS 评分 4.6（中等危害），属于 SQL 注入类漏洞（CWE-89）。","severity":"MEDIUM","score":4.6,"aliases":["CVE-2001-1472"],"sources":["exploitdb"],"published":"2001-08-03T04:00:00Z","updated":"2026-06-16T21:56:20Z","remediation":"升级 phpBB 至 2.0.0 及以上版本（该版本重构了输入过滤机制，修复了 prefs.php 中的 SQL 注入问题）；如无法升级，在 prefs.php 中对 viewemail 参数进行严格的输入验证和转义处理，使用 addslashes() 或数据库专用转义函数处理用户输入，并限制 prefs.php 仅允许管理员访问。","status":"completed","collected_at":"2026-07-27T00:00:00Z","references":["http://www.kb.cert.org/vuls/id/314347","http://www.securityfocus.com/archive/1/201715","http://www.securityfocus.com/bid/3142","https://exchange.xforce.ibmcloud.com/vulnerabilities/6944","https://www.exploit-db.com/exploits/21046","https://github.com/CVEProject/cvelistV5/blob/145038fbd12ba507a810d82f3ca7bed9554ecf9f/cves/2001/1xxx/CVE-2001-1472.json","https://github.com/LiuCan01/cve-list-pro/blob/78b55511cee3604c22d518e32822f0435d0cacc0/cve-list/CVE-2001/CVE-2001-1472","https://github.com/HORKimhab/poc-cve-collection/blob/56ecbe5708e7172ccdeffde501e0321bbd31bea6/2001/1xxx/CVE-2001-1472.md","https://github.com/Patrowl/PatrowlHearsData/blob/68711f4b9de04c730603adbbe0fe7b126b6784b4/CVE/data/2001/CVE-2001-1472.json","https://github.com/github/advisory-database/blob/effb2f348554323580d029ec0e691334888b7fed/advisories/unreviewed/2022/04/GHSA-3jqm-4487-ppp7/GHSA-3jqm-4487-ppp7.json","https://github.com/yarencheng/cve-devops-playground/blob/c54e59752dddfc9aa36c13774164384cfa0d1f04/content/CVE-2001-1472.md","https://github.com/KTZgraph/sarenka/blob/f1fb931ab722d6c096d581ed6e3c5966d799fbaa/sarenka/feeds/cve_details/cve_all_details_151400_151500.json","https://github.com/andreafioraldi/ToolsForCyberChallenge/blob/197d3dfd204cf1b9d1af1451455c8831c3ff9948/generated/files_1.list.dict","https://github.com/nomi-sec/NVD-Exploit-List-Ja/blob/b82432e7d59d95db9f183c0cefa7744595784afa/2001.tsv","https://github.com/olbat/nvdcve/blob/add906b6a8ba20fd533c6fdd7f023c73e6090f3a/nvdcve/CVE-2001-1472.json"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":[],"repo_exp_urls":[],"has_poc":false,"has_exp":false,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/2001/AVE-2001-0551.toml"},{"ave_id":"AVE-2001-0465","file_name":"2001/AVE-2001-0465.toml","cve_id":"CVE-2001-1122","title":"Microsoft Windows NT 4.0 本地拒绝服务漏洞","description":"Windows NT 4.0 SP 6a 系统中 lsass.exe 进程存在拒绝服务漏洞。具有 winnt/system32 目录写入权限的本地攻击者可通过运行 NT4ALL 利用程序并指定 SPECIAL 模式，向 lsass.exe 发送特制请求触发异常处理错误，导致 lsass.exe 崩溃，造成系统拒绝服务。该漏洞为本地利用，攻击者需先获得系统本地访问权限及特定目录写入权限，影响 Windows NT 4.0 系统。","severity":"LOW","score":2.1,"aliases":["CVE-2001-1122"],"sources":["exploitdb"],"published":"2001-08-03T04:00:00Z","updated":"2026-06-16T21:55:37Z","remediation":"The user wants me to generate a remediation field for CVE-2001-1122. Let me analyze the vulnerability:\n\n- Windows NT 4.0 SP 6a\n- Local user with write access to winnt/system32 can cause DoS (crash in lsass.exe) by running NT4ALL exploit in 'SPECIAL' mode\n- CVSS 2.1 (Low)\n- Published 2001-08-03\n\nThis is a very old vulnerability (2001) for Windows NT 4.0, which is long out of support. The remediation should be practical and actionable.\n\nSince Windows NT 4.0 is long end-of-life, the primary remediation would be to upgrade to a supported Windows version. Let me think about what specific steps to recommend.\n\nKey points:\n1. Windows NT 4.0 is EOL - no patches available\n2. The vulnerability requires local write access to system32\n3. Mitigation: restrict write access to system32, upgrade to supported Windows version\n\nLet me craft a specific, actionable remediation in Chinese, ≥20 characters.<value>Windows NT 4.0 已停止支持，建议升级至受支持的 Windows 版本（如 Windows 10/11 或 Windows Server 2019/2022）。如无法升级，严格限制 winnt\\system32 目录的写入权限，仅允许 Administrators 组写入，移除普通用户的写入权限，并禁用不必要的本地用户账户。\n","status":"completed","collected_at":"2026-07-27T00:00:00Z","references":["http://www.securityfocus.com/archive/1/201722","http://www.securityfocus.com/bid/3144","https://exchange.xforce.ibmcloud.com/vulnerabilities/6943","https://www.exploit-db.com/exploits/21047","https://github.com/CVEProject/cvelistV5/blob/4a22bba3217932039300edbc77cd188c415d71c8/cves/2001/1xxx/CVE-2001-1122.json","https://github.com/LiuCan01/cve-list-pro/blob/78b55511cee3604c22d518e32822f0435d0cacc0/cve-list/CVE-2001/CVE-2001-1122","https://github.com/HORKimhab/poc-cve-collection/blob/41644568d1e47f962c2cefae75c8b09359290a26/2001/1xxx/CVE-2001-1122.md","https://github.com/Patrowl/PatrowlHearsData/blob/4bd823fa5ff72ec859371ff3ef0f5e18be2f2c77/CVE/data/2001/CVE-2001-1122.json","https://github.com/github/advisory-database/blob/29919db3f954d9ce9be0e7e3cf177436392d45d3/advisories/unreviewed/2022/04/GHSA-v64g-ccfg-9cfv/GHSA-v64g-ccfg-9cfv.json","https://github.com/yarencheng/cve-devops-playground/blob/c54e59752dddfc9aa36c13774164384cfa0d1f04/content/CVE-2001-1122.md","https://github.com/KTZgraph/sarenka/blob/f1fb931ab722d6c096d581ed6e3c5966d799fbaa/sarenka/feeds/cve_details/cve_all_details_151400_151500.json","https://github.com/andreafioraldi/ToolsForCyberChallenge/blob/197d3dfd204cf1b9d1af1451455c8831c3ff9948/generated/files_0.list.dict","https://github.com/nomi-sec/NVD-Exploit-List-Ja/blob/b82432e7d59d95db9f183c0cefa7744595784afa/2001.tsv","https://github.com/oasis-open/cti-stix-common-objects/blob/55ba7598cbd5a52577b6887871505d931d85cb61/objects/vulnerability/vulnerability--c1946aa5-0c75-400d-bc29-0027464f902c.json"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":[],"repo_exp_urls":[],"has_poc":false,"has_exp":false,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/2001/AVE-2001-0465.toml"},{"ave_id":"AVE-2001-0467","file_name":"2001/AVE-2001-0467.toml","cve_id":"CVE-2001-1130","title":"SuSE Linux Sdbsearch.cgi 任意命令执行漏洞","description":"SuSE Linux 6.0 至 7.2 版本中自带的 sdbsearch.cgi 脚本存在任意命令执行漏洞。攻击者可通过上传包含 shell 元字符（如管道符、分号等）文件名的 keylist.txt 文件，并在 HTTP Referer 字段中构造目录遍历序列（`..`）将搜索路径指向该文件所在目录，从而触发 CGI 脚本执行恶意命令。远程未经认证的攻击者可利用此漏洞在目标服务器上以 Web 服务器权限执行任意系统命令，进而完全控制受影响的 SuSE Linux 系统。","severity":"HIGH","score":7.5,"aliases":["CVE-2001-1130"],"sources":["exploitdb"],"published":"2001-08-02T04:00:00Z","updated":"2026-06-16T21:55:38Z","remediation":"升级到 SuSE Linux Enterprise Server 11 或更高版本（如 12 SP3+），这些版本修复了 sdbsearch.cgi 中的 shell 命令注入漏洞。确保升级到包含 Security Update for SuSE Linux 6.3/6.4/7.0 sdb (CVE-2001-1130) 的补丁包（如 sbd-1.3.4-26.93+）。如无法立即升级，可通过修改 httpd 配置禁用对 .. 文件名的搜索功能，并限制通过 HTTP_REFERER 变量传递的路径长度，将 risk_level 参数设置为 high 以拒绝可疑的目录遍历请求。","status":"completed","collected_at":"2026-07-27T00:00:00Z","references":["http://www.novell.com/linux/security/advisories/2001_027_sdb_txt.html","http://www.securityfocus.com/archive/1/201216","https://exchange.xforce.ibmcloud.com/vulnerabilities/7003","https://www.exploit-db.com/exploits/21075","https://github.com/CVEProject/cvelistV5/blob/257ebb29696cc311841c79ca4ceb0162bf5df44a/cves/2001/1xxx/CVE-2001-1130.json","https://github.com/LiuCan01/cve-list-pro/blob/78b55511cee3604c22d518e32822f0435d0cacc0/cve-list/CVE-2001/CVE-2001-1130","https://github.com/HORKimhab/poc-cve-collection/blob/41644568d1e47f962c2cefae75c8b09359290a26/2001/1xxx/CVE-2001-1130.md","https://github.com/Patrowl/PatrowlHearsData/blob/4bd823fa5ff72ec859371ff3ef0f5e18be2f2c77/CVE/data/2001/CVE-2001-1130.json","https://github.com/rhuitl/uClinux/blob/0486e80a025dccbe4a2213715a2ab8a5063ea86b/user/nessus/nessus-plugins/scripts/sdbsearch.nasl","https://github.com/github/advisory-database/blob/29919db3f954d9ce9be0e7e3cf177436392d45d3/advisories/unreviewed/2022/04/GHSA-cr34-rcr6-jr32/GHSA-cr34-rcr6-jr32.json","https://github.com/KTZgraph/sarenka/blob/f1fb931ab722d6c096d581ed6e3c5966d799fbaa/sarenka/feeds/cve_details/cve_all_details_151400_151500.json","https://github.com/andreafioraldi/ToolsForCyberChallenge/blob/197d3dfd204cf1b9d1af1451455c8831c3ff9948/generated/files_5.list.dict","https://github.com/oasis-open/cti-stix-common-objects/blob/55ba7598cbd5a52577b6887871505d931d85cb61/objects/vulnerability/vulnerability--49c40791-454f-4701-9d94-731552a794b1.json","https://github.com/xqcyberscore/nvt/blob/978f6a9acb495d7d669239530ffe6da5d631f4da/2008/sdbsearch.nasl"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":[],"repo_exp_urls":[],"has_poc":false,"has_exp":false,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/2001/AVE-2001-0467.toml"},{"ave_id":"AVE-2001-0265","file_name":"2001/AVE-2001-0265.toml","cve_id":"CVE-2001-0623","title":"SAFT Sendfile 本地权限提升漏洞","description":"SAFT（Simple Asynchronous File Transfer）套件中的 sendfiled 服务在发送通知邮件时未能正确降低权限，导致本地攻击者可利用该缺陷以提升的权限执行任意命令。该漏洞影响多种 Linux 系统上包含 SAFT 的 Sendfile 1.x/2.1 版本，攻击者需具备本地访问权限，CVSS 评分 4.6，危害等级中危。","severity":"MEDIUM","score":4.6,"aliases":["CVE-2001-0623"],"sources":["exploitdb"],"published":"2001-08-02T04:00:00Z","updated":"2026-06-16T21:54:39Z","remediation":"升级 sendfile 至 2.1-20.2 或更高版本。Debian 2.2 (potato) 用户可通过 apt 更新：`apt-get update && apt-get install sendfile`，或从 `http://security.debian.org/dists/stable/updates/` 下载对应架构的 deb 包手动安装。如无法升级，建议禁用 sendfiled 服务（`/etc/init.d/sendfiled stop` 并移除自启动）作为临时缓解措施。","status":"completed","collected_at":"2026-07-23T00:00:00Z","references":["http://www.debian.org/security/2001/dsa-050","http://www.debian.org/security/2001/dsa-052","https://exchange.xforce.ibmcloud.com/vulnerabilities/6430","https://www.exploit-db.com/exploits/20795","https://github.com/CVEProject/cvelistV5/blob/2ee9e77ceac534c670c42073c99286dbb69e9733/cves/2001/0xxx/CVE-2001-0623.json","https://github.com/LiuCan01/cve-list-pro/blob/78b55511cee3604c22d518e32822f0435d0cacc0/cve-list/CVE-2001/CVE-2001-0623","https://github.com/yarencheng/cve-devops-playground/blob/4731f60845c8f35e2bdb03d333a9e9d84c7b1c27/content/CVE-2001-0623.md","https://github.com/Patrowl/PatrowlHearsData/blob/c872795777255e25a47f155fd6d323c05ea13ab9/CVE/data/2001/CVE-2001-0623.json","https://github.com/rhuitl/uClinux/blob/0486e80a025dccbe4a2213715a2ab8a5063ea86b/user/nessus/nessus-plugins/scripts/debian_DSA-050.nasl","https://github.com/github/advisory-database/blob/daf3a08cbe0139b666db9d48681b6efcebbecad5/advisories/unreviewed/2022/04/GHSA-7pw9-r7h7-2x88/GHSA-7pw9-r7h7-2x88.json","https://github.com/jdkoftinoff/mb-linux-msli/blob/8adb103e34af9ff1d8d122e9ee2a1808836f0a14/uClinux-dist/user/nessus/nessus-plugins/scripts/debian_DSA-052.nasl","https://github.com/intSpLoiT/intframework/blob/eabaa799d0260aa52b735fa9769266d1ce4b64ef/modules/cve_list.txt","https://github.com/nomi-sec/NVD-Database/blob/23dc120c34402aaa65883c51c1d03b3cb02c20cb/2001/CVE-2001-0623.json","https://github.com/debiancn/debian.org/blob/6abc98daa6356b20e410013a6920b3764af682d4/english/security/2001/dsa-050.data"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":["https://raw.githubusercontent.com/adysec/AVE/main/pocs/2001/POC-AVE-2001-0265.toml"],"repo_exp_urls":["https://raw.githubusercontent.com/adysec/AVE/main/exploits/2001/EXP-AVE-2001-0265.toml"],"has_poc":true,"has_exp":true,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/2001/AVE-2001-0265.toml"},{"ave_id":"AVE-2001-0259","file_name":"2001/AVE-2001-0259.toml","cve_id":"CVE-2001-0610","title":"KDE KFM 临时文件符号链接漏洞","description":"KDE 1.x 中集成的文件管理器 KFM 在 /tmp 缓存目录下以不安全方式创建临时文件（.tmp），本地攻击者可利用符号链接（symlink）攻击，在 KFM 创建临时文件前预先建立指向目标文件的符号链接，从而劫持文件写入操作，实现权限提升。该漏洞影响 SuSE 7.0 等使用 KDE 1.x 的系统，攻击者需拥有本地账户权限，CVSS 评分 4.6，危害等级中危。","severity":"MEDIUM","score":4.6,"aliases":["CVE-2001-0610"],"sources":["exploitdb"],"published":"2001-08-02T04:00:00Z","updated":"2026-06-16T21:54:37Z","remediation":"升级 KDE 至 2.0 及以上版本（KFM 在 KDE 2.0 中已修复此问题），或升级 SuSE Linux 至 7.1 及以上版本。临时缓解措施：手动删除 /tmp/kfm-cache-* 目录并以 root 执行 `chmod 700 /tmp/kfm-cache-*` 限制目录权限，或移除 kfm 二进制文件的 setuid 位（`chmod u-s /opt/kde/bin/kfm`）。","status":"completed","collected_at":"2026-07-23T00:00:00Z","references":["http://archives.neohapsis.com/archives/bugtraq/2001-04/0336.html","https://exchange.xforce.ibmcloud.com/vulnerabilities/6428","https://www.exploit-db.com/exploits/20781","https://github.com/CVEProject/cvelistV5/blob/2ee9e77ceac534c670c42073c99286dbb69e9733/cves/2001/0xxx/CVE-2001-0610.json","https://github.com/LiuCan01/cve-list-pro/blob/78b55511cee3604c22d518e32822f0435d0cacc0/cve-list/CVE-2001/CVE-2001-0610","https://github.com/yarencheng/cve-devops-playground/blob/4731f60845c8f35e2bdb03d333a9e9d84c7b1c27/content/CVE-2001-0610.md","https://github.com/Patrowl/PatrowlHearsData/blob/c872795777255e25a47f155fd6d323c05ea13ab9/CVE/data/2001/CVE-2001-0610.json","https://github.com/github/advisory-database/blob/daf3a08cbe0139b666db9d48681b6efcebbecad5/advisories/unreviewed/2022/04/GHSA-jxjg-6pwx-g6rw/GHSA-jxjg-6pwx-g6rw.json","https://github.com/SpeeDr00t/speedr00t.github.com/blob/0380f0c2190556fabe90257cb6c0034a42f68951/securityfocus/0x90000/89002/info.html","https://github.com/intSpLoiT/intframework/blob/eabaa799d0260aa52b735fa9769266d1ce4b64ef/modules/cve_list.txt","https://github.com/KTZgraph/sarenka/blob/f1fb931ab722d6c096d581ed6e3c5966d799fbaa/sarenka/feeds/cve_details/cve_all_details_151300_151400.json","https://github.com/olbat/nvdcve/blob/5b92f5917a4a825187ccaac594f43456a77ea8f3/nvdcve/CVE-2001-0610.json","https://github.com/oasis-open/cti-stix-common-objects/blob/55ba7598cbd5a52577b6887871505d931d85cb61/objects/vulnerability/vulnerability--d3afd88d-73f9-4b84-a7f0-94c9897291d9.json"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":[],"repo_exp_urls":[],"has_poc":false,"has_exp":false,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/2001/AVE-2001-0259.toml"},{"ave_id":"AVE-2001-0258","file_name":"2001/AVE-2001-0258.toml","cve_id":"CVE-2001-0609","title":"Infodrom cfingerd 格式字符串漏洞","description":"cfingerd 1.4.3 及更早版本中存在格式字符串漏洞，当该服务处理特制的 ident 响应时，会将用户可控的输入直接传递给 syslog 函数作为格式化字符串参数，导致攻击者可以利用格式字符串特性（如 %n、%s 等）实现任意内存读写。远程攻击者无需身份认证即可通过网络向目标 cfingerd 服务发送恶意构造的 ident 响应触发该漏洞，从而获取系统额外权限，实现完全控制目标主机。该漏洞影响 Infodrom cfingerd 1.4.3 及之前所有版本，危害严重。","severity":"CRITICAL","score":9.8,"aliases":["CVE-2001-0609"],"sources":["exploitdb"],"published":"2001-08-02T04:00:00Z","updated":"2026-06-16T21:54:37Z","remediation":"升级 cfingerd 至 1.4.4 或更高版本（该版本修复了 syslog 格式化字符串漏洞）。Debian 用户可参考 DSA-049 安全公告，通过 `apt-get update && apt-get install cfingerd` 更新。如无法立即升级，可在 inetd/xinetd 配置中注释 cfingerd 行并重启服务以临时禁用 finger 协议，或通过防火墙限制对 79/TCP 端口的访问。","status":"completed","collected_at":"2026-07-23T00:00:00Z","references":["http://archives.neohapsis.com/archives/bugtraq/2001-04/0202.html","http://www.securityfocus.com/bid/2576","https://exchange.xforce.ibmcloud.com/vulnerabilities/6364","https://www.exploit-db.com/exploits/20749","https://github.com/CVEProject/cvelistV5/blob/2ee9e77ceac534c670c42073c99286dbb69e9733/cves/2001/0xxx/CVE-2001-0609.json","https://github.com/LiuCan01/cve-list-pro/blob/78b55511cee3604c22d518e32822f0435d0cacc0/cve-list/CVE-2001/CVE-2001-0609","https://github.com/yarencheng/cve-devops-playground/blob/4731f60845c8f35e2bdb03d333a9e9d84c7b1c27/content/CVE-2001-0609.md","https://github.com/Patrowl/PatrowlHearsData/blob/c872795777255e25a47f155fd6d323c05ea13ab9/CVE/data/2001/CVE-2001-0609.json","https://github.com/bb1nfosec/Information-Security-Tasks/blob/f4624a2c25d8fbfb76929a1d5b57dbb13dd8ca9d/feeds/2026-06-07.md","https://github.com/rhuitl/uClinux/blob/0486e80a025dccbe4a2213715a2ab8a5063ea86b/user/nessus/nessus-plugins/scripts/debian_DSA-049.nasl","https://github.com/github/advisory-database/blob/daf3a08cbe0139b666db9d48681b6efcebbecad5/advisories/unreviewed/2022/04/GHSA-fppm-3x24-27q8/GHSA-fppm-3x24-27q8.json","https://github.com/jdkoftinoff/mb-linux-msli/blob/8adb103e34af9ff1d8d122e9ee2a1808836f0a14/uClinux-dist/user/nessus/nessus-plugins/scripts/cfinger_format_bug.nasl","https://github.com/KTZgraph/sarenka/blob/f1fb931ab722d6c096d581ed6e3c5966d799fbaa/sarenka/feeds/cwe_details/cwe_details_600_700.json","https://github.com/intSpLoiT/intframework/blob/eabaa799d0260aa52b735fa9769266d1ce4b64ef/modules/cve_list.txt"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":[],"repo_exp_urls":[],"has_poc":false,"has_exp":false,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/2001/AVE-2001-0258.toml"}]
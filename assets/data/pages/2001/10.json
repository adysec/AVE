,"https://github.com/github/advisory-database/blob/daf3a08cbe0139b666db9d48681b6efcebbecad5/advisories/unreviewed/2022/04/GHSA-x7mj-wjqj-jc9c/GHSA-x7mj-wjqj-jc9c.json","https://github.com/intSpLoiT/intframework/blob/eabaa799d0260aa52b735fa9769266d1ce4b64ef/modules/cve_list.txt","https://github.com/nomi-sec/NVD-Database/blob/23dc120c34402aaa65883c51c1d03b3cb02c20cb/2001/CVE-2001-0574.json","https://github.com/andreafioraldi/ToolsForCyberChallenge/blob/197d3dfd204cf1b9d1af1451455c8831c3ff9948/generated/files_4.list.dict","https://github.com/oasis-open/cti-stix-common-objects/blob/55ba7598cbd5a52577b6887871505d931d85cb61/objects/vulnerability/vulnerability--62e6a573-d5b1-4f3c-8783-f3c5915bc12e.json","https://github.com/akabe1/windows_exploit_dowser/blob/11b24e36173cd382721db28581e575faf687d06b/cve_from_exploitdb_website.csv"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":[],"repo_exp_urls":[],"has_poc":false,"has_exp":false,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/2001/AVE-2001-0238.toml"},{"ave_id":"AVE-2001-0236","file_name":"2001/AVE-2001-0236.toml","cve_id":"CVE-2001-0566","title":"Cisco Catalyst 2900XL Switch SNMP 拒绝服务漏洞","description":"Cisco Catalyst 2900XL 系列交换机 SNMP 服务存在输入验证不当漏洞（CWE-20）。当 SNMP 服务被禁用时，远程攻击者无需认证即可向目标设备的 UDP 161 端口发送特制的空数据包，触发服务处理异常，导致设备拒绝服务。该漏洞影响运行 Cisco IOS 12.0 及 '5.2'XU 版本的 Catalyst 2900XL 交换机，攻击复杂度低，无需特殊权限，仅需网络可达即可实施攻击。Cisco 已发布相关安全公告，建议用户升级固件或配置访问控制列表（ACL）限制 SNMP 端口的访问。","severity":"MEDIUM","score":5.0,"aliases":["CVE-2001-0566"],"sources":["exploitdb"],"published":"2001-08-14T04:00:00.000","updated":"2026-06-16T21:54:32.837","remediation":"升级 Cisco Catalyst 2900XL 交换机 IOS 至 12.0(5.2)XU 之后的修复版本；如无法升级，在交换机上配置 ACL 拒绝非信任源对 UDP 161 端口的访问：access-list 100 deny udp any any eq 161；若 SNMP 已禁用仍受影响，建议在边界防火墙上直接过滤入站 UDP 161 流量作为临时缓解。该设备已停产多年，强烈建议替换为受支持的 Catalyst 9000 系列交换机。","status":"completed","collected_at":"2026-07-23T00:00:00Z","references":["http://archives.neohapsis.com/archives/bugtraq/2001-05/0040.html","https://exchange.xforce.ibmcloud.com/vulnerabilities/6515","https://www.exploit-db.com/exploits/20824","https://github.com/CVEProject/cvelistV5/blob/7a274ec07043f54c07d0a3b5c7fc89ba5793f023/cves/2001/0xxx/CVE-2001-0566.json","https://github.com/LiuCan01/cve-list-pro/blob/78b55511cee3604c22d518e32822f0435d0cacc0/cve-list/CVE-2001/CVE-2001-0566","https://github.com/yarencheng/cve-devops-playground/blob/cbe73d6bdcced13ea57f08566d6bbf5345864f7e/content/CVE-2001-0566.md","https://github.com/Patrowl/PatrowlHearsData/blob/1decc7ade63192f9f527bfb87145d1636c01cc59/CVE/data/2001/CVE-2001-0566.json","https://github.com/github/advisory-database/blob/7007cbf91cfd56bead27c222fc520c733ed0ad71/advisories/unreviewed/2022/04/GHSA-w4fp-j2mm-3rrv/GHSA-w4fp-j2mm-3rrv.json","https://github.com/SpeeDr00t/speedr00t.github.com/blob/0380f0c2190556fabe90257cb6c0034a42f68951/securityfocus/0x89000/88841/info.html","https://github.com/intSpLoiT/intframework/blob/eabaa799d0260aa52b735fa9769266d1ce4b64ef/modules/cve_list.txt","https://github.com/olbat/nvdcve/blob/5b92f5917a4a825187ccaac594f43456a77ea8f3/nvdcve/CVE-2001-0566.json","https://github.com/andreafioraldi/ToolsForCyberChallenge/blob/197d3dfd204cf1b9d1af1451455c8831c3ff9948/generated/files_1.list.dict","https://github.com/oasis-open/cti-stix-common-objects/blob/55ba7598cbd5a52577b6887871505d931d85cb61/objects/vulnerability/vulnerability--18cf2c24-9dd5-4d58-802d-c0011dd401b4.json"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":[],"repo_exp_urls":[],"has_poc":false,"has_exp":false,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/2001/AVE-2001-0236.toml"},{"ave_id":"AVE-2001-0235","file_name":"2001/AVE-2001-0235.toml","cve_id":"CVE-2001-0565","title":"Oracle Solaris mailx 本地缓冲区溢出漏洞","description":"Solaris 8及更早版本系统中的 mailx 程序存在本地缓冲区溢出漏洞。当 mailx 处理超长的 '-F' 命令行参数时，由于未对输入长度进行充分检查，导致缓冲区溢出，本地攻击者可利用该漏洞覆盖内存中的关键数据，从而获取额外的系统权限。攻击者只需拥有本地 shell 访问权限即可触发该漏洞，无需身份认证。该漏洞影响 Solaris 2.5、2.6、7.0 及 8 等多个版本。","severity":"MEDIUM","score":4.6,"aliases":["CVE-2001-0565"],"sources":["exploitdb"],"published":"2001-08-14T04:00:00.000","updated":"2026-06-16T21:54:32.717","remediation":"升级到 Solaris 9 或更高版本，该漏洞已在后续版本中修复。如无法升级，可移除 mailx 的 setuid 权限（chmod u-s /usr/bin/mailx），限制本地普通用户通过 -F 参数触发缓冲区溢出。同时建议限制可登录系统的用户范围，仅允许受信任用户访问本地 shell。","status":"completed","collected_at":"2026-07-23T00:00:00Z","references":["http://archives.neohapsis.com/archives/bugtraq/2001-05/0016.html","http://online.securityfocus.com/archive/1/184210","http://www.kb.cert.org/vuls/id/446864","http://www.securityfocus.com/bid/2610","https://exchange.xforce.ibmcloud.com/vulnerabilities/8246","https://www.exploit-db.com/exploits/20773","https://github.com/CVEProject/cvelistV5/blob/7a274ec07043f54c07d0a3b5c7fc89ba5793f023/cves/2001/0xxx/CVE-2001-0565.json","https://github.com/LiuCan01/cve-list-pro/blob/78b55511cee3604c22d518e32822f0435d0cacc0/cve-list/CVE-2001/CVE-2001-0565","https://github.com/yarencheng/cve-devops-playground/blob/cbe73d6bdcced13ea57f08566d6bbf5345864f7e/content/CVE-2001-0565.md","https://github.com/Patrowl/PatrowlHearsData/blob/1decc7ade63192f9f527bfb87145d1636c01cc59/CVE/data/2001/CVE-2001-0565.json","https://github.com/github/advisory-database/blob/7007cbf91cfd56bead27c222fc520c733ed0ad71/advisories/unreviewed/2022/04/GHSA-4m9v-c2fv-vcv2/GHSA-4m9v-c2fv-vcv2.json","https://github.com/intSpLoiT/intframework/blob/eabaa799d0260aa52b735fa9769266d1ce4b64ef/modules/cve_list.txt","https://github.com/KTZgraph/sarenka/blob/f1fb931ab722d6c096d581ed6e3c5966d799fbaa/sarenka/feeds/cve_details/cve_all_details_151300_151400.json","https://github.com/andreafioraldi/ToolsForCyberChallenge/blob/197d3dfd204cf1b9d1af1451455c8831c3ff9948/generated/files_4.list.dict","https://github.com/nomi-sec/NVD-Database/blob/23dc120c34402aaa65883c51c1d03b3cb02c20cb/2001/CVE-2001-0565.json","https://github.com/hungryfoolou/Vulnerability_Mining/blob/3df1d8ed0489ae1228f975ae1f58a690aae53886/craw/cveid_craw/cveid_craw/data/cveid_by_kind/cveid_gainpre.txt"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":[],"repo_exp_urls":[],"has_poc":false,"has_exp":false,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/2001/AVE-2001-0235.toml"},{"ave_id":"AVE-2001-0231","file_name":"2001/AVE-2001-0231.toml","cve_id":"CVE-2001-0563","title":"ElectroSoft ElectroComm Telnet 服务拒绝服务漏洞","description":"ElectroSystems Engineering Inc. 出品的 ElectroComm 2.0 及更早版本的 Telnet 服务存在拒绝服务漏洞。远程攻击者无需身份认证即可通过向目标系统的 23 端口发送超过 160000 个字符的超长字符串，导致 Telnet 服务崩溃或停止响应，造成拒绝服务。该漏洞利用方式简单，攻击门槛低，影响 ElectroComm 1.0/2.0 版本。","severity":"MEDIUM","score":5.0,"aliases":["CVE-2001-0563"],"sources":["exploitdb"],"published":"2001-08-14T04:00:00.000","updated":"2026-06-16T21:54:32.487","remediation":"建议升级到 ElectroComm 2.0 以上版本（如厂商已停止支持，应迁移至替代产品）。临时缓解措施：在防火墙上限制对 TCP 端口 23 的访问，仅允许可信 IP 连接；或禁用 Telnet 服务改用 SSH 替代。","status":"completed","collected_at":"2026-07-23T00:00:00Z","references":["http://archives.neohapsis.com/archives/bugtraq/2001-05/0049.html","http://www.securityfocus.com/bid/2706","https://exchange.xforce.ibmcloud.com/vulnerabilities/6514","https://www.exploit-db.com/exploits/20834","https://github.com/CVEProject/cvelistV5/blob/7a274ec07043f54c07d0a3b5c7fc89ba5793f023/cves/2001/0xxx/CVE-2001-0563.json","https://github.com/LiuCan01/cve-list-pro/blob/78b55511cee3604c22d518e32822f0435d0cacc0/cve-list/CVE-2001/CVE-2001-0563","https://github.com/yarencheng/cve-devops-playground/blob/cbe73d6bdcced13ea57f08566d6bbf5345864f7e/content/CVE-2001-0563.md","https://github.com/Patrowl/PatrowlHearsData/blob/1decc7ade63192f9f527bfb87145d1636c01cc59/CVE/data/2001/CVE-2001-0563.json","https://github.com/github/advisory-database/blob/7007cbf91cfd56bead27c222fc520c733ed0ad71/advisories/unreviewed/2022/04/GHSA-qr36-6223-92fj/GHSA-qr36-6223-92fj.json","https://github.com/nomi-sec/NVD-Database/blob/23dc120c34402aaa65883c51c1d03b3cb02c20cb/2001/CVE-2001-0563.json","https://github.com/KTZgraph/sarenka/blob/f1fb931ab722d6c096d581ed6e3c5966d799fbaa/sarenka/feeds/cve_details/cve_all_details_151300_151400.json","https://github.com/oasis-open
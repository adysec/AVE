cus.com/bid/44980","http://www.securitytracker.com/id?1024761","http://www.vupen.com/english/advisories/2010/3027","http://www.vupen.com/english/advisories/2010/3313","http://www.vupen.com/english/advisories/2011/0020","http://www.vupen.com/english/advisories/2011/0021","https://bugzilla.redhat.com/show_bug.cgi?id=656917","https://exchange.xforce.ibmcloud.com/vulnerabilities/63390","https://oval.cisecurity.org/repository/search/definition/oval%3Aorg.mitre.oval%3Adef%3A12489","https://github.com/trickest/cve/blob/be44b05b9428dc18bc0705cf60dd8d8640cd49b1/2010/CVE-2010-4150.md","https://github.com/CVEProject/cvelistV5/blob/0db929612f090dc6aa0346061c42364c4634c480/cves/2010/4xxx/CVE-2010-4150.json","https://github.com/LiuCan01/cve-list-pro/blob/78b55511cee3604c22d518e32822f0435d0cacc0/cve-list/CVE-2010/CVE-2010-4150","https://github.com/php/web-php/blob/430b2bed08283f7ef9ec517a3930a64352bd7387/releases/5_3_4.php","https://github.com/canonical/ubuntu-security-notices/blob/bb6cd0f1a29580d840cdb570b8b0c57cc39aac6d/osv/cve/2010/UBUNTU-CVE-2010-4150.json","https://github.com/kaltura/platform-install-packages/blob/8f3e08e3694e938af32f9741013b84ffe0d342f2/deb/kaltura-php/debian/changelog","https://github.com/edoardottt/missing-cve-nuclei-templates/blob/b93b72c800b93d13fcc97984485ecaf9a9b5cbc1/data/year/2010.txt","https://github.com/nottrobin/ubuntu-cve-tracker/blob/36e411296b5707284049ec2e0db8d2622feca498/retired/CVE-2010-4150","https://github.com/mabitoski/cve_submodules/blob/44ad7e2705b3aef1b2ffaf64bd47596c10a6c2e4/2010/CVE-2010-4150.md","https://github.com/xqcyberscore/nvt/blob/978f6a9acb495d7d669239530ffe6da5d631f4da/2011/freebsd_php57.nasl"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":[],"repo_exp_urls":[],"has_poc":false,"has_exp":false,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/2010/AVE-2010-0256.toml"},{"ave_id":"AVE-2010-0281","file_name":"2010/AVE-2010-0281.toml","cve_id":"CVE-2010-4494","title":"libxml2 XPath处理双重释放漏洞","description":"libxml2 2.7.8及之前版本中存在双重释放漏洞（CWE-415），该漏洞位于XPath表达式处理模块中。远程攻击者可通过向使用libxml2库的应用程序（如Google Chrome 8.0.552.215之前版本、OpenOffice等）发送特制的XPath查询请求，触发内存双重释放操作，导致拒绝服务或潜在的任意代码执行。攻击无需身份认证，通过网络即可远程触发，CVSS评分7.5，危害等级高。","severity":"HIGH","score":7.5,"aliases":["CVE-2010-4494"],"sources":["tenable"],"published":"2010-12-07T21:00:09Z","updated":"2026-06-16T23:24:55Z","remediation":"将 libxml2 升级至 2.7.8 之后包含修复的版本（如 2.9.0+），或根据发行版安装对应安全更新：Debian 用户执行 `apt-get install libxml2` 更新至 DSA-2137 修复版本；Red Hat/CentOS 用户安装 RHSA-2011-1749 或 RHSA-2013-0217 提供的更新；Google Chrome 用户升级至 8.0.552.215 及以上版本；OpenOffice 用户升级至 3.3 及以上版本。如无法立即升级，可在应用层禁用 XML XPath 解析功能作为临时缓解措施。","status":"completed","collected_at":"2026-07-27T00:00:00Z","references":["http://code.google.com/p/chromium/issues/detail?id=63444","http://googlechromereleases.blogspot.com/2010/12/stable-beta-channel-updates.html","http://lists.apple.com/archives/security-announce/2011//Mar/msg00003.html","http://lists.apple.com/archives/security-announce/2011//Mar/msg00004.html","http://lists.apple.com/archives/security-announce/2011/Mar/msg00000.html","http://lists.apple.com/archives/security-announce/2011/Mar/msg00006.html","http://lists.fedoraproject.org/pipermail/package-announce/2011-March/055775.html","http://lists.opensuse.org/opensuse-security-announce/2011-04/msg00000.html","http://marc.info/?l=bugtraq&m=139447903326211&w=2","http://rhn.redhat.com/errata/RHSA-2013-0217.html","http://secunia.com/advisories/40775","http://secunia.com/advisories/42472","http://secunia.com/advisories/42721","http://secunia.com/advisories/42762","http://support.apple.com/kb/HT4554","http://support.apple.com/kb/HT4564","http://support.apple.com/kb/HT4566","http://support.apple.com/kb/HT4581","http://www.debian.org/security/2010/dsa-2137","http://www.mandriva.com/security/advisories?name=MDVSA-2010:260","http://www.openoffice.org/security/cves/CVE-2010-4008_CVE-2010-4494.html","http://www.redhat.com/support/errata/RHSA-2011-1749.html","http://www.vupen.com/english/advisories/2010/3319","http://www.vupen.com/english/advisories/2010/3336","http://www.vupen.com/english/advisories/2011/0230","https://oval.cisecurity.org/repository/search/definition/oval%3Aorg.mitre.oval%3Adef%3A11916","https://github.com/CVEProject/cvelistV5/blob/933422a5f82611777877a3549b9b8e3c7d70117d/cves/2010/4xxx/CVE-2010-4494.json","https://github.com/apache/openoffice-org/blob/8229366d1e4d6b49b6b7814c530e13f2c4dcb931/content/security/cves/CVE-2010-4008_CVE-2010-4494.html","https://github.com/LiuCan01/cve-list-pro/blob/78b55511cee3604c22d518e32822f0435d0cacc0/cve-list/CVE-2010/CVE-2010-4494","https://github.com/Tabll/gemnasium-db/blob/7dd233fee5478e00f4ef27fbd6512a0d682c777d/nuget/libxml2/CVE-2010-4494.yml","https://github.com/microsoft/azurelinux/blob/b1937ff37cca040858bab5da20d395f6f93139fd/specs/l/libxml2/libxml2.spec","https://github.com/yarencheng/cve-devops-playground/blob/c54e59752dddfc9aa36c13774164384cfa0d1f04/content/CVE-2010-4494.md","https://github.com/nottrobin/ubuntu-cve-tracker/blob/36e411296b5707284049ec2e0db8d2622feca498/retired/CVE-2010-4494","https://github.com/github/advisory-database/blob/c55392b715d0e2e1caa8bc26997a940be7494a13/advisories/unreviewed/2022/05/GHSA-3m5c-7hqx-55x7/GHSA-3m5c-7hqx-55x7.json","https://github.com/nomi-sec/NVD-Database/blob/23dc120c34402aaa65883c51c1d03b3cb02c20cb/2010/CVE-2010-4494.json","https://github.com/SunStarSys/orion/blob/845dc4a772afcfef0a471ab5dd3dbc00f5e99397/ooo-trunk/content/security/cves/CVE-2010-4008_CVE-2010-4494.html"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":[],"repo_exp_urls":[],"has_poc":false,"has_exp":false,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/2010/AVE-2010-0281.toml"},{"ave_id":"AVE-2010-0409","file_name":"2010/AVE-2010-0409.toml","cve_id":"CVE-2010-3904","title":"Linux Kernel RDS 协议本地权限提升漏洞","description":"Linux 内核 2.6.36 之前版本中 Reliable Datagram Sockets（RDS）协议的 rds_page_copy_user 函数未正确验证用户空间传入的内存地址，本地攻击者可通过精心构造 sendmsg 和 recvmsg 系统调用触发此漏洞，实现权限提升至 root。该漏洞影响所有使用受影响内核版本的 Linux 发行版，攻击者需拥有本地用户权限即可利用，危害等级高。","severity":"HIGH","score":7.8,"aliases":["CVE-2010-3904"],"sources":["kev"],"published":"2010-12-06T20:13:00Z","updated":"2026-06-16T23:23:47Z","remediation":"立即将 Linux 内核升级至 2.6.36 及以上版本，该版本修复了 rds_page_copy_user 函数未正确验证用户空间地址的问题。如无法立即升级内核，可通过 `modprobe -r rds` 命令卸载 RDS 内核模块，并在 `/etc/modprobe.d/` 中添加 `blacklist rds` 配置禁止自动加载，作为临时缓解措施。","status":"completed","collected_at":"2026-07-22T00:00:00Z","references":["http://git.kernel.org/?p=linux/kernel/git/torvalds/linux-2.6.git%3Ba=commit%3Bh=799c10559d60f159ab2232203f222f18fa3c4a5f","http://lists.opensuse.org/opensuse-security-announce/2010-10/msg00008.html","http://lists.opensuse.org/opensuse-security-announce/2010-11/msg00004.html","http://lists.opensuse.org/opensuse-security-announce/2011-02/msg00000.html","http://packetstormsecurity.com/files/155751/vReliable-Datagram-Sockets-RDS-rds_page_copy_user-Privilege-Escalation.html","http://secunia.com/advisories/46397","http://securitytracker.com/id?1024613","http://www.kb.cert.org/vuls/id/362983","http://www.kernel.org/pub/linux/kernel/v2.6/ChangeLog-2.6.36","http://www.redhat.com/support/errata/RHSA-2010-0792.html","http://www.redhat.com/support/errata/RHSA-2010-0842.html","http://www.securityfocus.com/archive/1/520102/100/0/threaded","http://www.ubuntu.com/usn/USN-1000-1","http://www.vmware.com/security/advisories/VMSA-2011-0012.html","http://www.vsecurity.com/download/tools/linux-rds-exploit.c","http://www.vsecurity.com/resources/advisory/20101019-1/","http://www.vupen.com/english/advisories/2011/0298","https://bugzilla.redhat.com/show_bug.cgi?id=642896","https://www.exploit-db.com/exploits/44677/","https://www.cisa.gov/known-exploited-vulnerabilities-catalog?field_cve=CVE-2010-3904","https://www.exploit-db.com/exploits/15285","https://github.com/trickest/cve/blob/ed228d55b7972f63e700a35a54fbcd94064b9ade/2010/CVE-2010-3904.md","https://github.com/SecWiki/linux-kernel-exploits/blob/2d2152cf9a58f668da720d12423e5a8a424eca3a/2010/CVE-2010-3904/README.
sercontent.com/adysec/AVE/main/pocs/2012/POC-AVE-2012-0209.toml"],"repo_exp_urls":["https://raw.githubusercontent.com/adysec/AVE/main/exploits/2012/EXP-AVE-2012-0209.toml"],"has_poc":true,"has_exp":true,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/2012/AVE-2012-0209.toml"},{"ave_id":"AVE-2012-0200","file_name":"2012/AVE-2012-0200.toml","cve_id":"CVE-2012-2539","title":"Microsoft Word RTF解析远程代码执行漏洞","description":"Microsoft Word 在处理特制 RTF 文件时，对 'listoverridecount' 字段的解析存在内存破坏漏洞。攻击者可构造恶意 RTF 文档并通过邮件或网页等方式诱使用户打开，成功利用后可获取与当前用户相同的系统权限执行任意代码。该漏洞影响 Microsoft Word 2003 SP3、2007 SP2/SP3、2010 SP1、Word Viewer、Office 兼容包 SP2/SP3 及 Office Web Apps 2010 SP1，CVSS 评分 7.8，危害等级高。Microsoft 已在 2012 年 12 月安全更新中修复此漏洞。","severity":"HIGH","score":7.8,"aliases":["CVE-2012-2539"],"sources":["kev"],"published":"2012-12-12T00:55:01Z","updated":"2026-06-16T23:41:39Z","remediation":"立即安装 Microsoft 安全公告 MS12-079 提供的安全更新：Word 2003 安装 KB2760497，Word 2007 安装 KB2760421，Word 2010 安装 KB2760410，Office 兼容包安装 KB2760416，Word Viewer 安装 KB2760498。可通过 Windows Update 自动更新或从 Microsoft 下载中心手动获取。如无法立即打补丁，可配置 Office 文件阻止策略禁止打开 RTF 文件，或设置 Outlook 以纯文本方式阅读邮件作为临时缓解措施。","status":"completed","collected_at":"2026-07-22T00:00:00Z","references":["http://www.us-cert.gov/cas/techalerts/TA12-346A.html","https://docs.microsoft.com/en-us/security-updates/securitybulletins/2012/ms12-079","https://oval.cisecurity.org/repository/search/definition/oval%3Aorg.mitre.oval%3Adef%3A16073","https://www.cisa.gov/known-exploited-vulnerabilities-catalog?field_cve=CVE-2012-2539","https://github.com/trickest/cve/blob/ed228d55b7972f63e700a35a54fbcd94064b9ade/2012/CVE-2012-2539.md","https://github.com/CVEProject/cvelistV5/blob/97700d7e657426c8e1ee6cf44a0a2b88c60738c3/cves/2012/2xxx/CVE-2012-2539.json","https://github.com/LiuCan01/cve-list-pro/blob/78b55511cee3604c22d518e32822f0435d0cacc0/cve-list/CVE-2012/CVE-2012-2539","https://github.com/ARPSyndicate/suricata-vedas/blob/fe24794ad36564b5bbc7c69101525011387b8650/2012/CVE-2012-2539.rules","https://github.com/cisagov/vulnrichment/blob/a538bd81432b918b342e413f43256da1f80b6c0d/2012/2xxx/CVE-2012-2539.json","https://github.com/a-dhaou-tekup/VRA/blob/3e4f21c329250c5eca327489d3fd5be9b398ce7b/data/rag_corpus/cisa_kev_notes/CVE-2012-2539.txt","https://github.com/cyberdudebivash/cyberdudebivash-ai-security-hub/blob/13403e1745f63237e7ef6d51562fb36112320d77/frontend/cve/CVE-2012-2539.html","https://github.com/EFI-Demo/Endpoint-Forecasting-and-Interpreting/blob/eff05b6ccc939b8164d47884f2faf7d3e8f99eb1/CTIs/talosintelligence/talosintelligence/2014/CVE-2014-1761,%20Oh%20did%20you%20mean%20CVE-2012-2539.txt","https://github.com/Ostorlab/KEV/blob/8feadeb8b7ff54359eab87941769781629146b23/README.md","https://github.com/edoardottt/missing-cve-nuclei-templates/blob/115c94bd1da3cc18977d652d6e78c9f4a5dfc13b/data/year/2012.txt"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":[],"repo_exp_urls":[],"has_poc":false,"has_exp":false,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/2012/AVE-2012-0200.toml"},{"ave_id":"AVE-2012-0024","file_name":"2012/AVE-2012-0024.toml","cve_id":"CVE-2012-4982","title":"Forescout CounterACT 开放重定向漏洞","description":"Forescout CounterACT NAC 设备 7.0 之前版本的 assets/login 页面存在开放重定向漏洞。远程攻击者可通过向 a 参数传入恶意 URL，将用户重定向至任意外部网站，进而实施钓鱼攻击。该漏洞源于程序对用户输入的 URL 参数缺乏充分校验，属于输入验证不完善（CWE-20）。CVSS 评分 5.8，危害等级中危，影响部署了 Forescout CounterACT NAC 设备的网络环境。","severity":"MEDIUM","score":5.8,"aliases":["CVE-2012-4982"],"sources":["nuclei"],"published":"2012-12-05T11:57:15Z","updated":"2026-06-16T23:46:00Z","remediation":"升级 Forescout CounterACT 至 7.0 或更高版本，该版本修复了 `/assets/login` 中 `a` 参数未正确校验 URL 导致开放重定向的问题。如无法立即升级，可在反向代理或 WAF 层面对 `/assets/login` 的 `a` 参数添加 URL 白名单校验，仅允许内部可信域名，防止被用于钓鱼跳转。","status":"completed","collected_at":"2026-07-22T00:00:00Z","references":["http://www.reactionpenetrationtesting.co.uk/forescout-cross-site-redirection.html","http://www.securityfocus.com/bid/56687","https://www.exploit-db.com/exploits/38062","https://github.com/projectdiscovery/nuclei-
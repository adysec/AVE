abase/blob/23dc120c34402aaa65883c51c1d03b3cb02c20cb/1999/CVE-1999-1393.json","https://github.com/KTZgraph/sarenka/blob/f1fb931ab722d6c096d581ed6e3c5966d799fbaa/sarenka/feeds/cve_details/cve_all_details_153400_153500.json","https://github.com/leego972/titanai/blob/afa5b2310463aae5781d3fd9408071bf38e79806/data/raw/corpus_D_cyber/nvd_cve_000643.txt","https://github.com/Yuning-J/VulnerabilityClassifier/blob/c0f06c21b73c26b5ee2b75c21a498eb04eada4b5/threatPrediction/cveIDThreatType/cve_idbypass"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":[],"repo_exp_urls":[],"has_poc":false,"has_exp":false,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/1999/AVE-1999-1096.toml"},{"ave_id":"AVE-1999-0312","file_name":"1999/AVE-1999-0312.toml","cve_id":"CVE-1999-0715","title":"Microsoft Windows NT RAS Phonebook 缓冲区溢出漏洞","description":"Windows NT 4.0 系列系统的远程访问服务（RAS）客户端在解析电话簿条目时存在缓冲区溢出漏洞。攻击者可通过构造恶意的电话簿文件并诱使用户在 RAS 连接中打开该条目，触发溢出后可在目标系统上执行任意命令或造成拒绝服务。该漏洞影响 Windows NT 4.0 及 SP1 至 SP5 所有版本，攻击条件要求能够诱导用户导入或打开特制电话簿文件。Microsoft 已发布 MS99-030 安全公告对此漏洞进行修复，建议受影响用户下载并安装官方补丁。","severity":"MEDIUM","score":4.6,"aliases":["CVE-1999-0715"],"sources":["epss"],"published":"1999-05-20T04:00:00Z","updated":"2026-06-16T21:48:54Z","remediation":"建议立即安装 Microsoft Windows NT 4.0 的 RAS Phonebook 漏洞安全补丁（Microsoft Security Bulletin MS99-020，对应补丁 Q194693）。如无法立即打补丁，可暂时停用 Remote Access Service (RAS) 服务，并限制普通用户对相关 .pbk 电话簿文件及 RAS 配置目录的写权限作为临时缓解措施。","status":"completed","collected_at":"2026-07-17T00:00:00Z","references":["http://support.microsoft.com/default.aspx?scid=kb%3B%5BLN%5D%3BQ230677","https://docs.microsoft.com/en-us/security-updates/securitybulletins/1999/ms99-016","https://www.exploit-db.com/exploits/19211","https://github.com/CVEProject/cvelistV5/blob/64d76d92cfbd9c4de4a352a59a2e52cadebc3afd/cves/1999/0xxx/CVE-1999-0715.json","https://github.com/LiuCan01/cve-list-pro/blob/78b55511cee3604c22d518e32822f0435d0cacc0/cve-list/CVE-1999/CVE-1999-0715","https://github.com/yarencheng/cve-devops-playground/blo
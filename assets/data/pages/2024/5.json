/golang/vulndb/blob/05da64c166d4f0c1282a01018eb34f5a34c00175/data/reports/GO-2025-3414.yaml"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":[],"repo_exp_urls":[],"has_poc":false,"has_exp":false,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/2024/AVE-2024-0469.toml"},{"ave_id":"AVE-2024-0467","file_name":"2024/AVE-2024-0467.toml","cve_id":"CVE-2024-10846","title":"Docker Compose compose-go 库解析 YAML 时资源消耗漏洞","description":"compose-go 库在解析包含递归循环的 Compose 文件时存在平台资源过度消耗漏洞（CWE-20 输入验证不当），由于未对 YAML 结构的递归深度进行有效限制，导致解析过程中 CPU 和内存被大量占用。经授权的攻击者可通过发送包含递归引用的恶意 YAML 载荷触发此漏洞，造成服务拒绝。该漏洞影响 compose-go v2.1.0 至 v2.4.0 及 Docker Compose v2.27.0 至 v2.29.7 版本，CVSS 评分 5.9，危害等级中危。","severity":"MEDIUM","score":5.9,"aliases":["CVE-2024-10846"],"sources":["cve","ghsa"],"published":"2025-01-21","updated":"2026-07-22","remediation":"将 compose-go 库升级至 v2.4.1 或更高版本。如使用 Docker Compose，应升级至 v2.30.0 及以上版本。该漏洞无已知临时缓解措施，仅可通过升级修复。","status":"completed","collected_at":"2026-07-22T00:00:00Z","references":["https://github.com/compose-spec/compose-go/security/advisories/GHSA-36gq-35j3-p9r9","https://security.netapp.com/advisory/ntap-20250425-0008/","https://github.com/CVEProject/cvelistV5/blob/a54ce91ca4eed5acb1176739213f8ac035b9fa27/cves/2024/10xxx/CVE-2024-10846.json","https://github.com/cisagov/vulnrichment/blob/6d175f59444084675ba336cc9e2bc51fc5338e6d/2024/10xxx/CVE-2024-10846.json","https://github.com/Tabll/gemnasium-db/blob/de1cbf8802a4c6060caaa5924b50812f2a62fead/go/github.com/compose-spec/compose-go/v2/CVE-2024-10846.yml","https://github.com/yarencheng/cve-devops-playground/blob/cbe73d6bdcced13ea57f08566d6bbf5345864f7e/content/CVE-2024-10846.md","https://github.com/CVEProject/cve-reference-ingest-data/blob/54ab2d6e8edcc52192915a067c45b2190f568993/references/CVE-2024-10846-2025-04-25-2205","https://github.com/golang/vulndb/blob/05da64c166d4f0c1282a01018eb34f5a34c00175/data/reports/GO-2025-3412.yaml","https://github.com/Hashmire/cpeApplicabilityGeneratorPages/blob/4588dccb1f913705444975eb2a5eb79962bf2513/generated_pages/CVE-2024-10846.html","https://github.com/joaop9425/manual-do-tecnico/blob/cc6e0f5304777f18e55db554da5372bc31d4cae1/src/content/noticias/2026/02/18/seguranca/cve-2024-10846-excessive-platform-resource-consump-1771411060000.md","https://github.com/github/advisory-database/blob/1721417c5dc7c1cbf858e5ea5a5245ea62e70cce/advisories/github-reviewed/2025/01/GHSA-36gq-35j3-p9r9/GHSA-36gq-35j3-p9r9.json","https://github.com/Patrowl/PatrowlHearsData/blob/c30cb75c630bd0892c286bac41dd51c65d6a6546/CVE/data/2024/CVE-2024-10846.json"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":[],"repo_exp_urls":[],"has_poc":false,"has_exp":false,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/2024/AVE-2024-0467.toml"},{"ave_id":"AVE-2024-0485","file_name":"2024/AVE-2024-0485.toml","cve_id":"CVE-2024-13176","title":"OpenSSL ECDSA 签名计算定时侧信道漏洞","description":"OpenSSL FIPS 模块 3.0 至 3.4 版本中的 ECDSA 签名计算存在时序侧信道漏洞。当经过逆运算的 ECDSA nonce 值最高位字为零时，会产生约 300 纳秒的时序差异，攻击者可通过精确测量签名操作的执行时间推断出私钥信息。该漏洞主要影响 NIST P-521 椭圆曲线，利用条件苛刻，攻击者需与目标位于同一物理主机或具备极低延迟的高速网络连接。CVSS 评分 4.1，危害等级中危。","severity":"MEDIUM","score":4.1,"aliases":["CVE-2024-13176"],"sources":["msrc"],"published":"2025-01-20T14:15:26.247","updated":"2026-06-17T07:01:23.167","remediation":"升级 OpenSSL 至修复版本：3.0.x 升级至 3.0.16+，3.1.x 升级至 3.1.8+，3.2.x 升级至 3.2.4+，3.3.x 升级至 3.3.3+，3.4.0 升级至 3.4.1+。如无法立即升级，可通过限制签名操作仅允许本地受信进程访问、避免在高延迟网络环境下使用 ECDSA P-521 曲线签名来降低攻击风险。","status":"completed","collected_at":"2026-07-22T00:00:00Z","references":["https://github.com/openssl/openssl/commit/07272b05b04836a762b4baa874958af51d513844","https://github.com/openssl/openssl/commit/2af62e74fb59bc469506bc37eb2990ea408d9467","https://github.com/openssl/openssl/commit/392dcb336405a0c94486aa6655057f59fd3a0902","https://github.com/openssl/openssl/commit/4b1cb94a734a7d4ec363ac0a215a25c181e11f65","https://github.com/openssl/openssl/commit/77c608f4c8857e63e98e66444e2e761c9627916f","https://github.openssl.org/openssl/extended-releases/commit/0d5fd1ab987f7571e2c955d8d8b638fc0fb54ded","https://github.openssl.org/openssl/extended-releases/commit/a2639000db19878d5d89586ae7b725080592ae86","https://openssl-library.org/news/secadv/20250120.txt","http://www.openwall.com/lists/oss-security/2025/01/20/2","https://lists.debian.org/debian-lts-announce/2025/05/msg00028.html","https://security.netapp.com/advisory/ntap-20250124-0005/","https://security.netapp.com/advisory/ntap-20250418-0010/","https://security.netapp.com/advisory/ntap-20250502-0006/","https://github.com/trickest/cve/blob/ed228d55b7972f63e700a35a54fbcd94064b9ade/2024/CVE-2024-13176.md","https://github.com/openssl/openssl/blob/ba2f3b557a660cbe2a0fc0e99b1830cb930a090f/NEWS.md","https://github.com/CVEProject/cvelistV5/blob/5c4b2ba2a59a96457ab4b8ea4ee82efc5782bb1d/cves/2024/13xxx/CVE-2024-13176.json","https://github.com/archlinuxcn/repo/blob/ce45ab34f3eda708550319e335a10018899c42e9/archlinuxcn/openssl-1.1/CVE-2024-13176.patch","https://github.com/saltstack/salt/blob/c8f7e9ab9b833333ac9d8d3d16e31878c58aab3e/doc/topics/releases/3006.10.md","https://github.com/NixOS/nixpkgs/blob/2e6ec20a07f4ebfeb7d385d6c2a7f71173f514fa/pkgs/by-name/ov/ovftool/package.nix","https://github.com/RMerl/asuswrt-merlin.ng/blob/2b88ab2e96c95718b0eb9b836590129a06a3dd0b/Changelog-3006.txt","https://github.com/aquasecurity/trivy/blob/e73c76d83b609cd5c387833e2467dbb52df06e46/docs/guide/configuration/reporting.md","https://github.com/google/boringssl/blob/bbae15127720290fb1216cf5a933a4bda6abf323/docs/advisories/2025-01-21.md","https://github.com/Azure/azure-cli/blob/6e3b4eab87bc1ec9e58d76361507e9e0be27dd4f/src/azure-cli-core/HISTORY.rst"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":[],"repo_exp_urls":[],"has_poc":false,"has_exp":false,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/2024/AVE-2024-0485.toml"},{"ave_id":"AVE-2024-0641","file_name":"2024/AVE-2024-0641.toml","cve_id":"CVE-2024-57924","title":"Linux Kernel 文件句柄编码失败断言错误拒绝服务漏洞","description":"Linux 内核文件系统导出层（exportfs）在处理文件句柄编码失败时存在可触发的断言（WARN_ON）漏洞。当文件系统的 `->encode_fh()` 方法因各种原因（如缓存回收、overlayfs 配置等）返回失败时，内核会错误地触发 WARN_ON 断言，导致内核崩溃或系统拒绝服务。本地低权限攻击者可通过结合 overlayfs（挂载 index=on,nfs_export=on 选项）、inotify 和 drop_caches 等操作触发该断言，造成系统可用性受损。该漏洞影响 Linux 内核 v6.6 及更早版本，CVSS 评分 5.5，危害等级中等。Linux 内核社区已通过移除错误的 WARN_ON 断言来修复此问题。","severity":"MEDIUM","score":5.5,"aliases":["CVE-2024-57924"],"sources":["msrc"],"published":"2025-01-19T12:15:26.530","updated":"2026-07-14T13:17:14.107","remediation":"立即将 Linux 内核升级至 6.1.151、6.6.74、6.12.10 或 6.13 及以上版本，对应补丁提交为 974e3fe0ac61、adcde2872f8f、f47c834a9131、73697928c806。如无法立即升级，可临时限制本地用户对 overlayfs（挂载 index=on,nfs_export=on）和 inotify 的访问权限以降低触发风险。","status":"completed","collected_at":"2026-07-27T00:00:00Z","references":["https://git.kernel.org/stable/c/73697928c806fe4689939722184a86fc1c1957b4","https://git.kernel.org/stable/c/974e3fe0ac61de85015bbe5a4990cf4127b304b2","https://git.kernel.org/stable/c/adcde2872f8fc399b249758ae1990dcd53b694ea","https://git.kernel.org/stable/c/f47c834a9131ae64bee3c462f4e610c67b0a000f","https://lists.debian.org/debian-lts-announce/2025/10/msg00008.html","https://cert-portal.siemens.com/productcert/html/ssa-019113.html","https://cert-portal.siemens.com/productcert/html/ssa-032379.html","https://cert-portal.siemens.com/productcert/html/ssa-082556.html","https://github.com/trickest/cve/blob/e69d88e0152845fc4d4b49970ca6e503f56b2f93/2024/CVE-2024-57924.md","https://github.com/CVEProject/cvelistV5/blob/bb04e7276eb5376f975ca811b9a340d0d55b901d/cves/2024/57xxx/CVE-2024-57924.json","https://github.com/NUS-Curiosity/KernJC/blob/798845a541a5396395c7e0c1670cb4872dac7105/db/vuln_desc/2024/CVE-2024-57924.yaml","https://github.com/imSkows/Cyber-Vulnerability-Analysis-Data/blob/db26c44c5f45c25514223a46675daec7eea03092/data/first/CVE-2024-57924","https://github.com/0xMarcio/cve/blob/acf4fca32ae3e6d7d43276d798ba52a241ef3b49/2024/CVE-2024-57924.md","https://github.com/bell-sw/osv-database/blob/027c37e8e73e99b2a68cafab2e6594bde5db273e/BELL-CVE/BELL-CVE-2024-57924.json","https://github.com/CVEProject/cve-reference-ingest-data/blob/066c76d152f5fd6bc8455ceb09c7d8c2c3b74da6/references/CveServices-CVE-2024-57924-2025-11-03-1121","https://github.com/Patrowl/PatrowlHearsData/blob/0298403c910e42219c357a4f56dac428565b2e47/CVE/data/2024/CVE-2024-57924.json","https://github.com/Hashmire/cpeApplicabilityGeneratorPages/blob/4588dccb1f913705444975eb2a5eb79962bf2513/generated_pages/CVE-2024-57924.html","https://github.com/github/advisory-database/blob/724a585dd64bbf0d8e6760dd16b808140e9a0dd8/advisories/unreviewed/2025/01/GHSA-f344-cfpj-cvmx/GHSA-f344-cfpj-cvmx.json"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":[],"repo_exp_urls":[],"has_poc":false,"has_exp":false,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/2024/AVE-2024-0641.toml"},{"ave_id":"AVE-2024-0640","file_name":"2024/AVE-2024-0640.toml","cve_id":"CVE-2024-57922","title":"Linux AMD Display 驱动除零错误漏洞","description":"Linux 内核 DRM/AMD Display 驱动中的 dml ceil/floor 辅助函数（dcn_bw_ceil2 和 dcn_bw_floor2）缺少对 granularity 参数的零值检查，当传入零值时触发除零错误，导致内核崩溃（拒绝服务）。本地低权限攻击者可利用此漏洞造成系统可用性受影响。该漏洞影响 Linux 内核各发行版，CVSS 评分 5.5，危害等级中等。修复补丁已合入主线内核，需更新至包含该修复的内核版本。","severity":"MEDIUM","score":5.5,"aliases":["CVE-2024-57922"],"sources":["msrc"],"published":"2025-01-19T12:15:26.337","updated":"2026-06-17T08:14:14.363","remediation":"立即更新 Linux 内核至包含提交 f6e09701c3eb2ccb8cb0518e0b67f1c69742a4ec 的版本（主线内核 ≥ 6.13，或各发行版已合入该补丁的内核包）。Ubuntu 20.04 LTS 用户升级至 linux-image-5.15.0-1077-intel-iotg 及以上版本；Debian 11 用户应用 DLA-4075-1 安全更新。如无法立即升级，可通过禁用受影响 AMD GPU 的显示模式库（DML）相关功能模块作为临时缓解措施。","status":"completed","collected_at":"2026-07-27T00:00:00Z","references":["https://git.kernel.org/stable/c/0881fbc4fd62e00a2b8e102725f76d10351b2ea8","https://git.kernel.org/stable/c/497471baf53bb8fd3cd1529d65d4d7f7b81f1917","https://git.kernel.org/stable/c/4f0dd09ed3001725ffd8cdc2868e71df585392fe","https://git.kernel.org/stable/c/8a9315e6f7b2d94c65a1ba476481deddb20fc3ae","https://git.kernel.org/stable/c/95793f9684e58d2aa56671b2d616b4f9f577a0a8","https://git.kernel.org/stable/c/ae9ab63a268be99a27a4720ca24f6be801744fee","https://git.kernel.org/stable/c/f3d1e4062ef251fa55ccfeca1e54a98b6818b3a1","https://lists.debian.org/debian-lts-announce/2025/03/msg00001.html","https://lists.debian.org/debian-lts-announce/2025/03/msg00002.html","https://github.com/trickest/cve/blob/e69d88e0152845fc4d4b49970ca6e503f56b2f93/2024/CVE-2024-57922.md","https://github.com/CVEProject/cvelistV5/blob/bb04e7276eb5376f975ca811b9a340d0d55b901d/cves/2024/57xxx/CVE-2024-57922.json","https://github.com/NUS-Curiosity/KernJC/blob/798845a541a5396395c7e0c1670cb4872dac7105/db/vuln_desc/2024/CVE-2024-57922.yaml","https://github.com/imSkows/Cyber-Vulnerability-Analysis-Data/blob/db26c44c5f45c25514223a46675daec7eea03092/data/first/CVE-2024-57922","https://github.com/cisagov/vulnrichment/blob/59adead62d41f907bd4d8297210669925a301433/2024/57xxx/CVE-2024-57922.json","https://github.com/bell-sw/osv-database/blob/027c37e8e73e99b2a68cafab2e6594bde5db273e/BELL-CVE/BELL-CVE-2024-57922.json","https://github.com/CVEProject/cve-reference-ingest-data/blob/066c76d152f5fd6bc8455ceb09c7d8c2c3b74da6/references/CveServices-CVE-2024-57922-2025-11-03-1440","https://github.com/mabitoski/cve_submodules/blob/44ad7e2705b3aef1b2ffaf64bd47596c10a6c2e4/2024/CVE-2024-57922.md","https://github.com/github/advisory-database/blob/724a585dd64bbf0d8e6760dd16b808140e9a0dd8/advisories/unreviewed/2025/01/GHSA-94vx-hxvv-26m7/GHSA-94vx-hxvv-26m7.json","https://github.com/TonneauBenjamin/ANSSI_Project/blob/f0e2d5e8be75f0351e759642d04d728399b4faa9/data/raw/first/CVE-2024-57922"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":[],"repo_exp_urls":[],"has_poc":false,"has_exp":false,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/2024/AVE-2024-0640.toml"},{"ave_id":"AVE-2024-0634","file_name":"2024/AVE-2024-0634.toml","cve_id":"CVE-2024-57913","title":"Linux 内核 USB Gadget FunctionFS 竞态条件导致内核恐慌漏洞","description":"Linux 内核 USB gadget 子系统的 FunctionFS（f_fs）驱动中存在条件竞争漏洞。当系统启用 `panic_on_warn` 参数时，`functionfs_bind` 函数中不必要的 `WARN_ON` 调用会触发内核恐慌（kernel panic），导致系统重启或不可用。该漏洞影响运行 Linux 内核且使用 USB gadget 功能的设备，CVSS 评分为 4.7（中危）。攻击者需在本地具有一定权限并能够触发 ADB 功能路径与 UDC 写操作的竞争场景才能利用此漏洞。攻击利用会导致系统服务中断（可用性影响），但无法获取敏感数据或提升权限。上游社区已通过移除 `functionfs_bind` 中的 `WARN_ON` 调用来修复此问题。","severity":"MEDIUM","score":4.7,"aliases":["CVE-2024-57913"],"sources":["msrc"],"published":"2025-01-19T12:15:25.477","updated":"2026-06-17T08:14:13.227","remediation":"升级 Linux 内核至 >=5.15.0 或 >=6.1.0（具体取决于发行版的补丁策略），并重启系统。Debian 12 (bookworm) 应升级到 学士计划中的补丁版本；Ubuntu 24.04 LTS 应应用 USN-7381-1 安全更新；所有 RHEL/CentOS/Fedora 系统应更新到官方提供的内核补丁。升级后验证内核版本包含对 CVE-2024-57913 的修复（检查补丁日志中的 \"usb: gadget: f_fs: Remove WARN_ON in functionfs_bind\"）。如无法立即升级，可通过 `/proc/sys/kernel/panic_on_oops` 设置为 0 临时禁用 panic_on_warn 以减少风险。重启后检查 functionfs 驱动状态，确保 none 警告已被移除。","status":"completed","collected_at":"2026-07-23T00:00:00Z","references":["https://git.kernel.org/stable/c/19fc1c83454ca9d5699e39633ec79ce26355251c","https://git.kernel.org/stable/c/3e4d32cc145955d5c56c5498a3ff057e4aafa9d1","https://git.kernel.org/stable/c/82f60f3600aecd9ffcd0fbc4e193694511c85b47","https://git.kernel.org/stable/c/a8b6a18b9b66cc4c016d63132b59ce5383f7cdd2","https://git.kernel.org/stable/c/bfe60030fcd976e3546e1f73d6d0eb3fea26442e","https://git.kernel.org/stable/c/dfc51e48bca475bbee984e90f33fdc537ce09699","https://git.kernel.org/stable/c/ea6a1498742430eb2effce0d1439ff29ef37dd7d","https://lists.debian.org/debian-lts-announce/2025/03/msg00001.html","https://lists.debian.org/debian-lts-announce/2025/03/msg00002.html","https://cert-portal.siemens.com/productcert/html/ssa-265688.html","https://github.com/trickest/cve/blob/ed228d55b7972f63e700a35a54fbcd94064b9ade/2024/CVE-2024-57913.md","https://github.com/CVEProject/cvelistV5/blob/9615a84be27b28681e8a92dcc11ff360547df421/cves/2024/57xxx/CVE-2024-57913.json","https://github.com/imSkows/Cyber-Vulnerability-Analysis-Data/blob/db26c44c5f45c25514223a46675daec7eea03092/data/first/CVE-2024-57913","https://github.com/NUS-Curiosity/KernJC/blob/798845a541a5396395c7e0c1670cb4872dac7105/db/vuln_desc/2024/CVE-2024-57913.yaml","https://github.com/cisagov/vulnrichment/blob/dde61f61b53e6605a407232356bfa1ca7643b1ec/2024/57xxx/CVE-2024-57913.json","https://github.com/0xMarcio/cve/blob/ebd29ed5f9b5a2615e147ccbf1deed9bc7c5ae84/2024/CVE-2024-57913.md","https://github.com/bell-sw/osv-database/blob/ee84993ad655ae5f90f9948f27d13851ad8b9fd3/BELL-CVE/BELL-CVE-2024-57913.json","https://github.com/CVEProject/cve-reference-ingest-data/blob/f8224d6e888aa8987939b8288dc9909ca3aff5bd/references/CveServices-CVE-2024-57913-2025-11-03-1440","https://github.com/github/advisory-database/blob/bd18194e7d4afd6af63b4895317531a574628e62/advisories/unreviewed/2025/01/GHSA-5m3g-gpvq-34jp/GHSA-5m3g-gpvq-34jp.json","https://github.com/TonneauBenjamin/ANSSI_Project/blob/f0e2d5e8be75f0351e759642d04d728399b4faa9/data/raw/first/CVE-2024-57913"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":[],"repo_exp_urls":[],"has_poc":false,"has_exp":false,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/2024/AVE-2024-0634.toml"},{"ave_id":"AVE-2024-0633","file_name":"2024/AVE-2024-0633.toml","cve_id":"CVE-2024-57912","title":"Linux 内核 ZPA2326 压力传感器驱动 信息泄漏漏洞","description":"Linux 内核 IIO 子系统中压力传感器驱动 zpa2326 的触发缓冲区实现存在信息泄漏漏洞。驱动使用的 'sample' 本地结构体在 temperature 字段（u16）与 timestamp 字段（u64）之间存在未初始化的内存空洞，当通过触发缓冲机制将数据推送至用户空间时，该空洞中的未初始化内核内存内容会被泄露给用户态进程。攻击者需具备本地访问权限且低权限即可利用，无需用户交互，可读取内核栈/堆内存中的敏感信息（如指针、密钥等），CVSS 3.1 评分 7.1（HIGH，AV:L/AC:L/PR:L/UI:N/S:U/C:H/I:N/A:H）。影响使用 zpa2326 压力传感器驱动的 Linux 内核版本，修复方案是在使用前将结构体零初始化以避免信息泄露。","severity":"HIGH","score":7.1,"aliases":["CVE-2024-57912"],"sources":["msrc"],"published":"2025-01-19T12:15:25.380","updated":"2026-06-17T08:14:13.043","remediation":"建议立即升级 Linux 内核至已修复版本：Debian 11 (bullseye) 请升级 linux-6.1 至 6.1.6.1.128-1~deb11u1 或更高版本（`apt update && apt install linux-image-6.1.0-32-amd64`）；Ubuntu 24.04 LTS 请应用 USN-7381-1 提供的内核更新（`apt update && apt upgrade linux-image-generic`）；通用内核请升级至 5.4.290、5.10.234、5.15.177、6.1.125、6.6.72、6.12.10 或 6.13 及以上版本。若无法立即升级内核，可临时卸载 zpa2326 压力传感器驱动作为缓解措施：`modprobe -r zpa2326` 并将其加入 `/etc/modprobe.d/blacklist-zpa2326.conf`（`echo \"blacklist zpa2326\" > /etc/modprobe.d/blacklist-zpa2326.conf`），重启后生效；同时限制非受信本地用户访问 IIO 子系统设备节点（`/dev/iio:device*`）。","status":"completed","collected_at":"2026-07-23T00:00:00Z","references":["https://git.kernel.org/stable/c/6007d10c5262f6f71479627c1216899ea7f09073","https://git.kernel.org/stable/c/64a989aa7475b8e76e69b9ec86819ea293e53bab","https://git.kernel.org/stable/c/9629ff1a86823269b12fb1ba9ca4efa945906287","https://git.kernel.org/stable/c/979a0db76ceda8fe1f2f85a116bfe97620ebbadf","https://git.kernel.org/stable/c/b7849f62e61242e0e02c776e1109eb81e59c567c","https://git.kernel.org/stable/c/d25f1fc273670271412a52a1efbdaf5dcf274ed8","https://git.kernel.org/stable/c/fefb88a4da961a0b9c2473cbdcfce1a942fcfa9a","https://lists.debian.org/debian-lts-announce/2025/03/msg00001.html","https://lists.debian.org/debian-lts-announce/2025/03/msg00002.html","https://github.com/trickest/cve/blob/ed228d55b7972f63e700a35a54fbcd94064b9ade/2024/CVE-2024-57912.md","https://github.com/CVEProject/cvelistV5/blob/9615a84be27b28681e8a92dcc11ff360547df421/cves/2024/57xxx/CVE-2024-57912.json","https://github.com/NUS-Curiosity/KernJC/blob/798845a541a5396395c7e0c1670cb4872dac7105/db/vuln_desc/2024/CVE-2024-57912.yaml","https://github.com/imSkows/Cyber-Vulnerability-Analysis-Data/blob/db26c44c5f45c25514223a46675daec7eea03092/data/first/CVE-2024-57912","https://github.com/cisagov/vulnrichment/blob/dde61f61b53e6605a407232356bfa1ca7643b1ec/2024/57xxx/CVE-2024-57912.json","https://github.com/bell-sw/osv-database/blob/ee84993ad655ae5f90f9948f27d13851ad8b9fd3/BELL-CVE/BELL-CVE-2024-57912.json","https://github.com/CVEProject/cve-reference-ingest-data/blob/f8224d6e888aa8987939b8288dc9909ca3aff5bd/references/CveServices-CVE-2024-57912-2025-11-03-1452","https://github.com/mabitoski/cve_submodules/blob/44ad7e2705b3aef1b2ffaf64bd47596c10a6c2e4/2024/CVE-2024-57912.md","https://github.com/github/advisory-database/blob/bd18194e7d4afd6af63b4895317531a574628e62/advisories/unreviewed/2025/01/GHSA-37pg-r5mj-5q6w/GHSA-37pg-r5mj-5q6w.json","https://github.com/TonneauBenjamin/ANSSI_Project/blob/f0e2d5e8be75f0351e759642d04d728399b4faa9/data/raw/first/CVE-2024-57912"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":[],"repo_exp_urls":[],"has_poc":false,"has_exp":false,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/2024/AVE-2024-0633.toml"},{"ave_id":"AVE-2024-0632","file_name":"2024/AVE-2024-0632.toml","cve_id":"CVE-2024-57911","title":"Linux Kernel IIO 子系统 信息泄露漏洞","description":"该漏洞存在于 Linux 核心 IIO 虚拟设备驱动程序 iio_simply_dummy_buffer 的触发缓冲区处理过程中。 由于使用 iio_for_each_active_channel 仅遍历活动通道，导致分配的 data 数组无法清空不活跃通道的数据。 这样的缺陷导致在向用户空间推送数据时，反复出现初始化不完整，从而形成信息泄漏。 攻击者仅需要低权限本地访问权限即可触发该漏洞，成功会导致严重的信息泄漏和可用性破坏。 通过修改内核代码，将 kmalloc 替换为 kzalloc，确保内存区域初始化完毕，此类方法可有效解决上述问题。","severity":"HIGH","score":7.1,"aliases":["CVE-2024-57911"],"sources":["msrc"],"published":"2025-01-19T12:15:25.277","updated":"2026-06-17T08:14:12.867","remediation":"升级内核到 ≥6.8 版本（含 CVE-2024-57911 修复），或针对 Debian/Ubuntu 执行 `apt-get install linux-image-$(uname -r | grep -E '^[0-9]+' | cut -d'.' -f1).$(uname -r | awk -F'-' '{print $1}' | cut -d'.' -f2) && reboot`。对于 RHEL/CentOS 使用 `yum update kernel` 或 `dnf install kernel`. 停用所有 iio 虚拟设备模块并避免使用 iio_simply_dummy_buffer 驱动程序，降低信息泄露风险。系统管理员应立即验证内核版本，确保基础补丁已安装。","status":"completed","collected_at":"2026-07-23T00:00:00Z","references":["https://git.kernel.org/stable/c/006073761888a632c5d6f93e47c41760fa627f77","https://git.kernel.org/stable/c/03fa47621bf8fcbf5994c5716021527853f9af3d","https://git.kernel.org/stable/c/333be433ee908a53f283beb95585dfc14c8ffb46","https://git.kernel.org/stable/c/74058395b2c63c8a438cf199d09094b640f8c7f4","https://git.kernel.org/stable/c/b0642d9c871aea1f28eb02cd84d60434df594f67","https://git.kernel.org/stable/c/e1c1e8c05010103c9c9ea3e9c4304b0b7e2c8e4a","https://git.kernel.org/stable/c/ea703cda36da0dacb9a2fd876370003197d8a019","https://lists.debian.org/debian-lts-announce/2025/03/msg00001.html","https://lists.debian.org/debian-lts-announce/2025/03/msg00002.html","https://github.com/trickest/cve/blob/ed228d55b7972f63e700a35a54fbcd94064b9ade/2024/CVE-2024-57911.md","https://github.com/CVEProject/cvelistV5/blob/9615a84be27b28681e8a92dcc11ff360547df421/cves/2024/57xxx/CVE-2024-57911.json","https://github.com/NUS-Curiosity/KernJC/blob/798845a541a5396395c7e0c1670cb4872dac7105/db/vuln_desc/2024/CVE-2024-57911.yaml","https://github.com/imSkows/Cyber-Vulnerability-Analysis-Data/blob/db26c44c5f45c25514223a46675daec7eea03092/data/first/CVE-2024-57911","https://github.com/cisagov/vulnrichment/blob/dde61f61b53e6605a407232356bfa1ca7643b1ec/2024/57xxx/CVE-2024-57911.json","https://github.com/bell-sw/osv-database/blob/ee84993ad655ae5f90f9948f27d13851ad8b9fd3/BELL-CVE/BELL-CVE-2024-57911.json","https://github.com/CVEProject/cve-reference-ingest-data/blob/f8224d6e888aa8987939b8288dc9909ca3aff5bd/references/CveServices-CVE-2024-57911-2025-11-03-1440","https://github.com/mabitoski/cve_submodules/blob/44ad7e2705b3aef1b2ffaf64bd47596c10a6c2e4/2024/CVE-2024-57911.md","https://github.com/joaop9425/manual-do-tecnico/blob/cc6e0f5304777f18e55db554da5372bc31d4cae1/src/content/noticias/2026/02/18/seguranca/cve-2024-57911-iio-dummy-iio-simply-dummy-buffer-f-1771412482000.md","https://github.com/github/advisory-database/blob/bd18194e7d4afd6af63b4895317531a574628e62/advisories/unreviewed/2025/01/GHSA-2w6v-cv9c-qwv2/GHSA-2w6v-cv9c-qwv2.json"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":[],"repo_exp_urls":[],"has_poc":false,"has_exp":false,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/2024/AVE-2024-0632.toml"},{"ave_id":"AVE-2024-0631","file_name":"2024/AVE-2024-0631.toml","cve_id":"CVE-2024-57910","title":"Linux内核 vcnl4035光传感器驱动 信息泄漏漏洞","description":"Linux 内核 vcnl4035 光传感器驱动（IIO 子系统）的触发缓冲区实现存在未初始化内存泄漏漏洞。驱动在向用户空间推送触发缓冲区数据时，使用的局部数组未对单个数据元素（u16 对齐至 8 字节）进行初始化，导致至少 4 字节未初始化内核内存被泄露至用户空间。本地攻击者只需低权限即可触发缓冲区读取，无需用户交互，可获取内核栈/堆敏感信息（机密性影响高），且可能引发拒绝服务（可用性影响高）。影响使用 vcnl4035 驱动的 Linux 内核版本，CVSS 3.1 评分 7.1（HIGH），攻击向量本地、攻击复杂度低、权限要求低。Linux 内核已通过将缓冲区数组初始化为零修复该漏洞。","severity":"HIGH","score":7.1,"aliases":["CVE-2024-57910"],"sources":["msrc"],"published":"2025-01-19T12:15:25.187","updated":"2026-06-17T08:14:12.680","remediation":"建议立即升级 Linux 内核至已修复版本：Ubuntu 24.04 LTS 升级至 linux-image-6.8.0-52-generic (USN-7381-1)；Ubuntu 20.04 LTS 升级至 linux-image-5.15.0-127-generic (USN-7459-1)；Debian 11 升级至 linux-image-5.10.223-1 (DLA-4075-1)。上游内核已在 v6.12-rc1 合并修复提交 8f8a6b8c8f3a (iio: light: vcnl4035: fix information leak in triggered buffer)。若无法立即升级内核，可通过禁用 vcnl4035 驱动缓解：echo \"blacklist vcnl4035\" > /etc/modprobe.d/blacklist-vcnl4035.conf 并重启或执行 modprobe -r vcnl4035 卸载模块（需确认设备不依赖该光线传感器）。","status":"completed","collected_at":"2026-07-23T00:00:00Z","references":["https://git.kernel.org/stable/c/13e56229fc81051a42731046e200493c4a7c28ff","https://git.kernel.org/stable/c/47b43e53c0a0edf5578d5d12f5fc71c019649279","https://git.kernel.org/stable/c/47d245be86492974db3aeb048609542167f56518","https://git.kernel.org/stable/c/a15ea87d4337479c9446b5d71616f4668337afed","https://git.kernel.org/stable/c/b0e9c11c762e4286732d80e66c08c2cb3157b06b","https://git.kernel.org/stable/c/cb488706cdec0d6d13f2895bcdf0c32b283a7cc7","https://git.kernel.org/stable/c/f6fb1c59776b4263634c472a5be8204c906ffc2c","https://lists.debian.org/debian-lts-announce/2025/03/msg00001.html","https://lists.debian.org/debian-lts-announce/2025/03/msg00002.html","https://github.com/trickest/cve/blob/ed228d55b7972f63e700a35a54fbcd94064b9ade/2024/CVE-2024-57910.md","https://github.com/CVEProject/cvelistV5/blob/9615a84be27b28681e8a92dcc11ff360547df421/cves/2024/57xxx/CVE-2024-57910.json","https://github.com/NUS-Curiosity/KernJC/blob/798845a541a5396395c7e0c1670cb4872dac7105/db/vuln_desc/2024/CVE-2024-57910.yaml","https://github.com/imSkows/Cyber-Vulnerability-Analysis-Data/blob/db26c44c5f45c25514223a46675daec7eea03092/data/first/CVE-2024-57910","https://github.com/0xMarcio/cve/blob/ebd29ed5f9b5a2615e147ccbf1deed9bc7c5ae84/2024/CVE-2024-57910.md","https://github.com/cisagov/vulnrichment/blob/48383ebc821dc38e09ecfcea6060abac8038780f/2024/57xxx/CVE-2024-57910.json","https://github.com/bell-sw/osv-database/blob/ee84993ad655ae5f90f9948f27d13851ad8b9fd3/BELL-CVE/BELL-CVE-2024-57910.json","https://github.com/CVEProject/cve-reference-ingest-data/blob/f8224d6e888aa8987939b8288dc9909ca3aff5bd/references/CveServices-CVE-2024-57910-2025-11-03-1452","https://github.com/github/advisory-database/blob/24f07005949aaf2eb169012a6779e6dffdc5a952/advisories/unreviewed/2025/01/GHSA-rwgg-m734-wvjr/GHSA-rwgg-m734-wvjr.json","https://github.com/TonneauBenjamin/ANSSI_Project/blob/f0e2d5e8be75f0351e759642d04d728399b4faa9/data/raw/first/CVE-2024-57910"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":[],"repo_exp_urls":[],"has_poc":false,"has_exp":false,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/2024/AVE-2024-0631.toml"},{"ave_id":"AVE-2024-0630","file_name":"2024/AVE-2024-0630.toml","cve_id":"CVE-2024-57908","title":"Linux Kernel KMX61 IMU 驱动 信息泄漏漏洞","description":"Linux 内核 IIO 子系统中的 Kionix KMX61 IMU 驱动触发缓冲区存在信息泄漏漏洞。漏洞原理是驱动使用的本地 buffer 数组在向用户空间推送触发缓冲区数据时，仅通过 iio_for_each_active_channel() 为活跃通道赋值，未初始化非活跃通道的数组元素，导致未初始化的内核栈内存被泄露至用户空间。影响范围为启用了 CONFIG_IIO_STM_SENSORS_KMX61 配置的 Linux 内核版本。攻击条件为本地攻击者拥有低权限访问权限，无需用户交互，可通过触发缓冲区读取操作获取内核内存敏感信息，导致高机密性影响和高可用性影响，CVSS 3.1 评分 7.1（HIGH）。修复方式为在使用 buffer 数组前将其初始化为零。Linux 内核已在相关版本中通过提交修复此漏洞。","severity":"HIGH","score":7.1,"aliases":["CVE-2024-57908"],"sources":["msrc"],"published":"2025-01-19T12:15:24.990","updated":"2026-06-17T08:14:12.337","remediation":"建议立即升级 Linux 内核至 6.12.10 或更高版本（包含修复补丁 0495104b0f2f36cb7a3413ea0cf997a2ae2a70e9）。Ubuntu/Debian 执行：apt-get update && apt-get install linux-image-6.12.10；CentOS/RHEL 执行：yum update kernel；Fedora 执行：dnf update kernel。如无法立即升级内核，可临时禁用 KMX61 驱动：echo \"blacklist kmx61\" > /etc/modprobe.d/kmx61.conf 并重启，或在内核配置中禁用 CONFIG_IIO_STM_SENSORS_KMX61 后重新编译内核。该漏洞影响内核 4.0 至 6.12.9 版本，本地低权限攻击者可读取内核栈内存，建议尽快应用厂商安全更新。","status":"completed","collected_at":"2026-07-23T00:00:00Z","references":["https://git.kernel.org/stable/c/0871eb8d700b33dd7fa86c80630d62ddaef58c2c","https://git.kernel.org/stable/c/565814cbbaa674d2901428796801de49a611e59d","https://git.kernel.org/stable/c/6985ba4467e4b15b809043fa7740d1fb23a1897b","https://git.kernel.org/stable/c/6ae053113f6a226a2303caa4936a4c37f3bfff7b","https://git.kernel.org/stable/c/a07f698084412a3ef5e950fcac1d6b0f53289efd","https://git.kernel.org/stable/c/a386d9d2dc6635f2ec210b8199cfb3acf4d31305","https://git.kernel.org/stable/c/cde312e257b59ecaa0fad3af9ec7e2370bb24639","https://lists.debian.org/debian-lts-announce/2025/03/msg00001.html","https://lists.debian.org/debian-lts-announce/2025/03/msg00002.html","https://github.com/trickest/cve/blob/ed228d55b7972f63e700a35a54fbcd94064b9ade/2024/CVE-2024-57908.md","https://github.com/CVEProject/cvelistV5/blob/9615a84be27b28681e8a92dcc11ff360547df421/cves/2024/57xxx/CVE-2024-57908.json","https://github.com/NUS-Curiosity/KernJC/blob/798845a541a5396395c7e0c1670cb4872dac7105/db/vuln_desc/2024/CVE-2024-57908.yaml","https://github.com/imSkows/Cyber-Vulnerability-Analysis-Data/blob/db26c44c5f45c25514223a46675daec7eea03092/data/first/CVE-2024-57908","https://github.com/cisagov/vulnrichment/blob/48383ebc821dc38e09ecfcea6060abac8038780f/2024/57xxx/CVE-2024-57908.json","https://github.com/bell-sw/osv-database/blob/ee84993ad655ae5f90f9948f27d13851ad8b9fd3/BELL-CVE/BELL-CVE-2024-57908.json","https://github.com/CVEProject/cve-reference-ingest-data/blob/f8224d6e888aa8987939b8288dc9909ca3aff5bd/references/CveServices-CVE-2024-57908-2025-11-03-1452","https://github.com/mabitoski/cve_submodules/blob/44ad7e2705b3aef1b2ffaf64bd47596c10a6c2e4/2024/CVE-2024-57908.md","https://github.com/github/advisory-database/blob/24f07005949aaf2eb169012a6779e6dffdc5a952/advisories/unreviewed/2025/01/GHSA-f5j6-wv5v-rgw9/GHSA-f5j6-wv5v-rgw9.json","https://github.com/TonneauBenjamin/ANSSI_Project/blob/f0e2d5e8be75f0351e759642d04d728399b4faa9/data/raw/first/CVE-2024-57908"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":[],"repo_exp_urls":[],"has_poc":false,"has_exp":false,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/2024/AVE-2024-0630.toml"}]
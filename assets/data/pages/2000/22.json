,"https://github.com/CVEProject/cvelistV5/blob/5c4b2ba2a59a96457ab4b8ea4ee82efc5782bb1d/cves/2000/0xxx/CVE-2000-0717.json","https://github.com/LiuCan01/cve-list-pro/blob/78b55511cee3604c22d518e32822f0435d0cacc0/cve-list/CVE-2000/CVE-2000-0717","https://github.com/yarencheng/cve-devops-playground/blob/cbe73d6bdcced13ea57f08566d6bbf5345864f7e/content/CVE-2000-0717.md","https://github.com/Patrowl/PatrowlHearsData/blob/475f53ac063af305fc146a443cce993188109d56/CVE/data/2000/CVE-2000-0717.json","https://github.com/github/advisory-database/blob/e6b10ee602769bd7be4675bf10e3382c1f100e32/advisories/unreviewed/2022/04/GHSA-52vv-c34v-c37f/GHSA-52vv-c34v-c37f.json","https://github.com/nomi-sec/NVD-Database/blob/23dc120c34402aaa65883c51c1d03b3cb02c20cb/2000/CVE-2000-0717.json","https://github.com/KTZgraph/sarenka/blob/f1fb931ab722d6c096d581ed6e3c5966d799fbaa/sarenka/feeds/cve_details/cve_all_details_152700_152800.json","https://github.com/oasis-open/cti-stix-common-objects/blob/55ba7598cbd5a52577b6887871505d931d85cb61/objects/vulnerability/vulnerability--f2485a17-ad77-44a7-b90a-9fee446f16f6.json","https://github.com/hungryfoolou/Vulnerability_Mining/blob/3df1d8ed0489ae1228f975ae1f58a690aae53886/craw/cveid_craw/cveid_craw/data/cveid_by_kind/cveid_dos.txt","https://github.com/nomi-sec/CVE-Easy-List/blob/1e58254e5bdaf937b4bd41c6a50d0d633bef0eb7/2000.tsv"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":[],"repo_exp_urls":[],"has_poc":false,"has_exp":false,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/2000/AVE-2000-0871.toml"},{"ave_id":"AVE-2000-0870","file_name":"2000/AVE-2000-0870.toml","cve_id":"CVE-2000-0716","title":"MDaemon WorldClient 邮件客户端会话劫持漏洞","description":"MDaemon 2.8 的 WorldClient 邮件客户端存在会话标识符泄露漏洞。当用户点击邮件中的 URL 时，WorldClient 会将当前会话 ID 附加在 HTTP 请求的 Referer 字段中发送给目标网站，攻击者可借此获取用户会话 ID 并劫持会话，进而读取用户的邮件内容。攻击者只需诱使用户点击恶意链接即可利用此漏洞，无需额外认证条件。","severity":"LOW","score":2.6,"aliases":["CVE-2000-0716"],"sources":["cve"],"published":"2000-10-20T04:00:00.000","updated":"2026-06-16T21:52:19.890","remediation":"立即升级 MDaemon 至 3.0 或更高版本，该版本已修复 WorldClient 在 HTTP Referer 头中泄露会话 ID 的问题。如无法升级，建议配置反向代理在请求转发前移除 Referer 头中的会话标识，并强制 WorldClient 仅通过 HTTPS 访问以防止中间人窃取会话。","status":"completed","collected_at":"2026-07-22T00:00:00Z","references":["http://www.ntbugtraq.com/default.asp?pid=36&sid=1&A2=ind0008&L=ntbugtraq&F=&S=&P=459","http://www.securityfocus.com/bid/1553","https://exchange.xforce.ibmcloud.com/vulnerabilities/5070","https://github.com/CVEProject/cvelistV5/blob/5c4b2ba2a59a96457ab4b8ea4ee82efc5782bb1d/cves/2000/0xxx/CVE-2000-0716.json","https://github.com/LiuCan01/cve-list-pro/blob/78b55511cee3604c22d518e32822f0435d0cacc0/cve-list/CVE-2000/CVE-2000-0716","https://github.com/yarencheng/cve-devops-playground/blob/cbe73d6bdcced13ea57f08566d6bbf5345864f7e/content/CVE-2000-0716.md","https://github.com/Patrowl/PatrowlHearsData/blob/475f53ac063af305fc146a443cce993188109d56/CVE/data/2000/CVE-2000-0716.json","https://github.com/github/advisory-database/blob/e6b10ee602769bd7be4675bf10e3382c1f100e32/advisories/unreviewed/2022/04/GHSA-hrwj-3h8v-xmqx/GHSA-hrwj-3h8v-xmqx.json","https://github.com/intSpLoiT/intframework/blob/eabaa799d0260aa52b735fa9769266d1ce4b64ef/modules/cve_list.txt","https://github.com/SpeeDr00t/speedr00t.github.com/blob/0380f0c2190556fabe90257cb6c0034a42f68951/securityfocus/0x2000/1553/info.html","https://github.com/KTZgraph/sarenka/blob/f1fb931ab722d6c096d581ed6e3c5966d799fbaa/sarenka/feeds/cve_details/cve_all_details_152700_152800.json","https://github.com/olbat/nvdcve/blob/5b92f5917a4a825187ccaac594f43456a77ea8f3/nvdcve/CVE-2000-0716.json","https://github.com/oasis-open/cti-stix-common-objects/blob/55ba7598cbd5a52577b6887871505d931d85cb61/objects/vulnerability/vulnerability--4bafeb93-e521-4bc1-aacc-b216f136df79.json"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":[],"repo_exp_urls":[],"has_poc":false,"has_exp":false,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/2000/AVE-2000-0870.toml"},{"ave_id":"AVE-2000-0869","file_name":"2000/AVE-2000-0869.toml","cve_id":"CVE-2000-0715","title":"Red Hat Linux diskcheck 符号链接攻击任意文件写入漏洞","description":"Red Hat Linux 6.2 自带的 DiskCheck 脚本 diskcheck.pl 在处理临时文件时未正确检查文件链接，存在典型的条件竞争/符号链接漏洞。本地攻击者可通过在临时文件创建前预置符号链接指向目标文件，诱使脚本以当前用户权限覆盖或写入任意系统文件，导致本地权限提升或系统文件被破坏。该漏洞影响 Red Hat Linux 6.2 及可能使用该脚本的其他发行版，CVSS 评分 2.1，危害等级低，攻击前提是拥有本地账户权限。","severity":"LOW","score":2.1,"aliases":["CVE-2000-0715"],"sources":["redhat"],"published":"2000-10-20T04:00:00.000","updated":"2026-06-16T21:52:19.767","remediation":"升级至 Red Hat Enterprise Linux 7 及以上版本以彻底修复。如无法升级，请手动修改 diskcheck.pl：1) 编辑 /etc/diskcheck.conf 将临时文件路径 $tempfile 改为 /var/local/diskusagealert.txt；2) 在 diskcheck.pl 中引入 Perl 的 File::Temp 模块替代直接拼接临时文件名，避免可预测路径；3) 使用 O_CREAT|O_EXCL 标志创建临时文件，防止符号链接跟随攻击。","status":"completed","collected_at":"2026-07-22T00:00:00Z","references":["http://seclists.org/bugtraq/2000/Aug/0082.html","http://seclists.org/bugtraq/2000/Aug/0096.html","http://seclists.org/bugtraq/2000/Jun/0298.html","http://www.securityfocus.com/bid/1552","https://github.com/CVEProject/cvelistV5/blob/86060d5336eceede57f01ccb65fb3037638af8db/cves/2000/0xxx/CVE-2000-0715.json","https://github.com/LiuCan01/cve-list-pro/blob/78b55511cee3604c22d518e32822f0435d0cacc0/cve-list/CVE-2000/CVE-2000-0715","https://github.com/yarencheng/cve-devops-playground/blob/cbe73d6bdcced13ea57f08566d6bbf5345864f7e/content/CVE-2000-0715.md","https://github.com/Patrowl/PatrowlHearsData/blob/1b84eedba993546f37a880c6d2d084176a1f04a7/CVE/data/2000/CVE-2000-0715.json","https://github.com/github/advisory-database/blob/1684cfa32e43376c48beb06819bce86de6ba421b/advisories/unreviewed/2022/04/GHSA-gh68-vx3r-mw6g/GHSA-gh68-vx3r-mw6g.json","https://github.com/intSpLoiT/intframework/blob/eabaa799d0260aa52b735fa9769266d1ce4b64ef/modules/cve_list.txt","https://github.com/KTZgraph/sarenka/blob/f1fb931ab722d6c096d581ed6e3c5966d799fbaa/sarenka/feeds/cve_details/cve_all_details_152700_152800.json","https://github.com/olbat/nvdcve/blob/5b92f5917a4a825187ccaac594f43456a77ea8f3/nvdcve/CVE-2000-0715.json","https://github.com/oasis-open/cti-stix-common-objects/blob/55ba7598cbd5a52577b6887871505d931d85cb61/objects/vulnerability/vulnerability--8d43a6b1-e347-46d4-94c9-121b00816758.json","https://github.com/nomi-sec/CVE-Easy-List/blob/3944e09fb28929da2e246a8b27f3b2564782fb22/2000.tsv"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":[],"repo_exp_urls":[],"has_poc":false,"has_exp":false,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/2000/AVE-2000-0869.toml"},{"ave_id":"AVE-2000-0868","file_name":"2000/AVE-2000-0868.toml","cve_id":"CVE-2000-0714","title":"Red Hat Linux umb-scheme 文件权限配置不当漏洞","description":"Red Hat Linux 系统中 umb-scheme 3.2-11 软件包在安装时未正确设置文件权限，导致相关文件被设置为全局可写。本地攻击者可利用该配置缺陷，通过修改 umb-scheme 的可执行文件或库文件，插入恶意代码，从而在系统启动或普通用户调用该程序时以 root 权限执行任意命令。该漏洞影响 Red Hat Linux 系统，CVSS 评分 7.2，危害等级高，需通过限制文件权限或升级软件包修复。","severity":"HIGH","score":7.2,"aliases":["CVE-2000-0714"],"sources":["redhat"],"published":"2000-10-20T04:00:00.000","updated":"2026-06-16T21:52:19.637","remediation":"立即使用 `chmod -R o-w /usr/lib/umb-scheme*` 命令移除 umb-scheme 相关文件的全域可写权限，或升级到 umb-scheme 3.2-12 及以上版本。如不再使用该软件包，建议直接通过 `rpm -e umb-scheme` 卸载以彻底消除风险。","status":"completed","collected_at":"2026-07-22T00:00:00Z","references":["http://www.redhat.com/support/errata/RHSA-2000-047.html","http://www.securityfocus.com/bid/1551","https://github.com/CVEProject/cvelistV5/blob/86060d5336eceede57f01ccb65fb3037638af8db/cves/2000/0xxx/CVE-2000-0714.json","https://github.com/LiuCan01/cve-list-pro/blob/78b55511cee3604c22d518e32822f0435d0cacc0/cve-list/CVE-2000/CVE-2000-0714","https://github.com/yarencheng/cve-devops-playground/blob/cbe73d6bdcced13ea57f08566d6bbf5345864f7e/content/CVE-2000-0714.md","https://github.com/Patrowl/PatrowlHearsData/blob/1b84eedba993546f37a880c6d2d084176a1f04a7/CVE/data/2000/CVE-2000-0714.json","https://github.com/github/advisory-database/blob/1684cfa32e43376c48beb06819bce86de6ba421b/advisories/unreviewed/2022/04/GHSA-vr3h-889p-pwx2/GHSA-vr3h-889p-pwx2.json","https://github.com/intSpLoiT/intframework/blob/eabaa799d0260aa52b735fa9769266d1ce4b64ef/modules/cve_list.txt","https://github.com/olbat/nvdcve/blob/5b92f5917a4a825187ccaac594f43456a77ea8f3/nvdcve/CVE-2000-0714.json","https://github.com/KTZgraph/sarenka/blob/f1fb931ab722d6c096d581ed6e3c5966d799fbaa/sarenka/feeds/cve_details/cve_all_details_152700_152800.json","https://github.com/williamjsmail/piranha/blob/e60f12e6edcde8585ee473f701c2421f6efe72d9/CVE2CAPEC/database/CVE-2000.jsonl","https://github.com/aboutcode-org/aboutcode-mirror-euvd/blob/2f3c8464ecb7e7fdc3b1076605ef127bac54ce3e/advisories/2022/04/EUVD-2000-0710.json"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":[],"repo_exp_urls":[],"has_poc":false,"has_exp":false,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/2000/AVE-2000-0868.toml"},{"ave_id":"AVE-2000-0866","file_name":"2000/AVE-2000-0866.toml","cve_id":"CVE-2000-0710","title":"Microsoft FrontPage 2000 Server Extensions shtml.exe 物理路径泄露漏洞","description":"Microsoft FrontPage 2000 Server Extensions 1.1 的 shtml.exe 组件存在信息泄露漏洞。远程攻击者可通过向服务器发送包含标准 DOS 设备名称（如 CON、NUL、AUX 等）的畸形 URL 请求，触发 shtml.exe 处理异常，从而获取服务器组件的物理路径信息。该漏洞可被利用于进一步探测目标系统结构，为后续攻击提供信息支撑。攻击无需身份认证，仅需向目标服务器发送特制 HTTP 请求即可触发。","severity":"MEDIUM","score":5.0,"aliases":["CVE-2000-0710"],"sources":["cve"],"published":"2000-10-20T04:00:00.000","updated":"2026-06-16T21:52:19.130","remediation":"建议升级至 Microsoft FrontPage 2000 Server Extensions 1.2 或更高版本，该版本已修复 shtml.exe 路径泄露问题。如无法升级，可在 IIS 中移除 shtml.exe 的脚本映射执行权限，或通过 URLScan 工具拦截包含 DOS 设备名（如 CON、NUL、AUX）的请求作为临时缓解措施。","status":"completed","collected_at":"2026-07-22T00:00:00Z","references":["http://archives.neohapsis.com/archives/bugtraq/2000-08/0288.html","http://msdn.microsoft.com/workshop/languages/fp/2000/sr12.asp","http://www.securityfocus.com/bid/1608","https://github.com/trickest/cve/blob/ed228d55b7972f63e700a35a54fbcd94064b9ade/2000/CVE-2000-0710.md","https://github.com/CVEProject/cvelistV5/blob/21e8713bd16ad152d6b946e7bfcd11df673c4829/cves/2000/0xxx/CVE-2000-0710.json","https://github.com/LiuCan01/cve-list-pro/blob/78b55511cee3604c22d518e32822f0435d0cacc0/cve-list/CVE-2000/CVE-2000-0710","https://github.com/nomi-sec/NVD-Database/blob/23dc120c34402aaa65883c51c1d03b3cb02c20cb/2000/CVE-2000-0710.json","https://github.com/mabitoski/cve_submodules/blob/44ad7e2705b3aef1b2ffaf64bd47596c10a6c2e4/2000/CVE-2000-0710.md","https://github.com/github/advisory-database/blob/e6b10ee602769bd7be4675bf10e3382c1f100e32/advisories/unreviewed/2022/04/GHSA-7cv3-2v97-6cpf/GHSA-7cv3-2v97-6cpf.json","https://github.com/ivanitlearning/CTF-Repos/blob/b5364388a861fc7457409d494a9d075d73e7867e/Vulnhub/SkyTower/Web-scan.txt","https://github.com/intSpLoiT/intframework/blob/eabaa799d0260aa52b735fa9769266d1ce4b64ef/modules/cve_list.txt","https://github.com/KTZgraph/sarenka/blob/f1fb931ab722d6c096d581ed6e3c5966d799fbaa/sarenka/feeds/cve_details/cve_all_details_152700_152800.json","https://github.com/olbat/nvdcve/blob/5b92f5917a4a825187ccaac594f43456a77ea8f3/nvdcve/CVE-2000-0710.json"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":["https://raw.githubusercontent.com/adysec/AVE/main/pocs/2000/POC-AVE-2000-0866.toml"],"repo_exp_urls":[],"has_poc":true,"has_exp":false,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/2000/AVE-2000-0866.toml"},{"ave_id":"AVE-2000-0865","file_name":"2000/AVE-2000-0865.toml","cve_id":"CVE-2000-0709","title":"Microsoft FrontPage 2000 Server Extensions 1.1 shtml.exe 拒绝服务漏洞","description":"Microsoft FrontPage 2000 Server Extensions 1.1 的 shtml.exe 组件存在拒绝服务漏洞。远程攻击者可通过向目标服务器发送包含标准 DOS 设备名（如 CON、NUL、AUX 等）的特制 URL 请求，导致服务器组件崩溃或停止响应，造成拒绝服务。该漏洞影响 FrontPage 2000 Server Extensions 1.1 版本，攻击无需身份认证，利用难度较低。","severity":"MEDIUM","score":5.0,"aliases":["CVE-2000-0709"],"sources":["cve"],"published":"2000-10-20T04:00:00.000","updated":"2026-06-16T21:52:19.003","remediation":"微软于 2000 年发布安全公告 MS00-060，建议安装 FrontPage 2000 Server Extensions 1.1 补丁。该产品已停止支持，无法获取官方更新，建议升级至受支持的 Web 服务器平台（如 IIS 10.0 或 Apache），并禁用不必要的老旧 ISAPI 扩展 shtml.exe。","status":"completed","collected_at":"2026-07-22T00:00:00Z","references":["http://archives.neohapsis.com/archives/bugtraq/2000-08/0288.html","http://msdn.microsoft.com/workshop/languages/fp/2000/sr12.asp","http://www.securityfocus.com/bid/1608","https://github.com/trickest/cve/blob/ed228d55b7972f63e700a35a54fbcd94064b9ade/2000/CVE-2000-0709.md","https://github.com/CVEProject/cvelistV5/blob/21e8713bd16ad152d6b946e7bfcd11df673c4829/cves/2000/0xxx/CVE-2000-0709.json","https://github.com/LiuCan01/cve-list-pro/blob/78b55511cee3604c22d518e32822f0435d0cacc0/cve-list/CVE-2000/CVE-2000-0709","https://github.com/Patrowl/PatrowlHearsData/blob/03de0f4bc3d6ed449f7108b4761b99fb0c8c56d7/CVE/data/2000/CVE-2000-0709.json","https://github.com/mabitoski/cve_submodules/blob/44ad7e2705b3aef1b2ffaf64bd47596c10a6c2e4/2000/CVE-2000-0709.md","https://github.com/github/advisory-database/blob/e6b10ee602769bd7be4675bf10e3382c1f100e32/advisories/unreviewed/2022/04/GHSA-qxh4-gwjr-r2m4/GHSA-qxh4-gwjr-r2m4.json","https://github.com/ivanitlearning/CTF-Repos/blob/b5364388a861fc7457409d494a9d075d73e7867e/Vulnhub/SkyTower/Web-scan.txt","https://github.com/blackhook/nessus-plugins/blob/64177d96abbb07c58cf7e131046b067ebc61fcb5/F/frontpage_dos.nasl","https://github.com/nomi-sec/NVD-Database/blob/23dc120c34402aaa65883c51c1d03b3cb02c20cb/2000/CVE-2000-0709.json","https://github.com/intSpLoiT/intframework/blob/eabaa799d0260aa52b735fa9769266d1ce4b64ef/modules/cve_list.txt"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":["https://raw.githubusercontent.com/adysec/AVE/main/pocs/2000/POC-AVE-2000-0865.toml"],"repo_exp_urls":["https://raw.githubusercontent.com/adysec/AVE/main/exploits/2000/EXP-AVE-2000-0865.toml"],"has_poc":true,"has_exp":true,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/2000/AVE-2000-0865.toml"},{"ave_id":"AVE-2000-0864","file_name":"2000/AVE-2000-0864.toml","cve_id":"CVE-2000-0708","title":"Pragma Systems TelnetServer 2000 rexec 缓冲区溢出漏洞","description":"Pragma Systems TelnetServer 2000 4.0 版本 rexec 组件存在缓冲区溢出漏洞，远程攻击者可通过向 rexec 端口发送大量空字符（null characters）触发该漏洞，导致目标服务崩溃，造成拒绝服务。该漏洞攻击复杂度低，无需身份认证即可远程利用，影响该版本及可能受影响的衍生版本。","severity":"MEDIUM","score":5.0,"aliases":["CVE-2000-0708"],"sources":["cve"],"published":"2000-10-20T04:00:00.000","updated":"2026-06-16T21:52:18.880","remediation":"建议立即升级 Pragma TelnetServer 2000 到官方最新版本（当前支持 Windows Server 2025/2022/2019/2016 及 Windows 11/10/8/7），该漏洞已在后续版本中修复。如无法立即升级，可在防火墙层面阻断对 rexec 服务端口（TCP 512）的外部访问，或在 Windows 服务管理器中禁用 rexec 服务作为临时缓解措施。","status":"completed","collected_at":"2026-07-22T00:00:00Z","references":["http://www.ntbugtraq.com/default.asp?pid=36&sid=1&A2=ind0008&L=NTBUGTRAQ&P=R4247","http://www.pragmasys.com/TelnetServer/","http://www.securityfocus.com/bid/1605","https://github.com/CVEProject/cvelistV5/blob/21e8713bd16ad152d6b946e7bfcd11df673c4829/cves/2000/0xxx/CVE-2000-0708.json","https://github.com/LiuCan01/cve-list-pro/blob/78b55511cee3604c22d518e32822f0435d0cacc0/cve-list/CVE-2000/CVE-2000-0708","https://github.com/yarencheng/cve-devops-playground/blob/cbe73d6bdcced13ea57f08566d6bbf5345864f7e/content/CVE-2000-0708.md","https://github.com/Patrowl/PatrowlHearsData/blob/03de0f4bc3d6ed449f7108b4761b99fb0c8c56d7/CVE/data/2000/CVE-2000-0708.json","https://github.com/eldondev/Snort/blob/34bdcf6a7a638b55c7c04f77ef1efa526ad08e33/doc/signatures/2114.txt","https://github.com/nomi-sec/NVD-Database/blob/23dc120c34402aaa65883c51c1d03b3cb02c20cb/2000/CVE-2000-0708.json","https://github.com/intSpLoiT/intframework/blob/eabaa799d0260aa52b735fa9769266d1ce4b64ef/modules/cve_list.txt","https://github.com/oasis-open/cti-stix-common-objects/blob/55ba7598cbd5a52577b6887871505d931d85cb61/objects/vulnerability/vulnerability--a070326a-52da-441b-b979-8fff474f31f9.json","https://github.com/hungryfoolou/Vulnerability_Mining/blob/3df1d8ed0489ae1228f975ae1f58a690aae53886/craw/cveid_craw/cveid_craw/data/cveid_by_kind/cveid_dos.txt","https://github.com/bailehang/snort_2.2.0/blob/34f8a3a85f15645aea53d6e0d46863c7c57e43ef/doc/signatures/2114.txt"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":[],"repo_exp_urls":[],"has_poc":false,"has_exp":false,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/2000/AVE-2000-0864.toml"},{"ave_id":"AVE-2000-0863","file_name":"2000/AVE-2000-0863.toml","cve_id":"CVE-2000-0707","title":"PCCS MySQLDatabase Admin Tool Manager 信息泄露漏洞","description":"PCCS MySQLDatabase Admin Tool Manager 1.2.4 及更早版本在安装过程中将包含数据库连接凭据的配置文件 dbconnect.inc 放置在 Web 根目录下，导致远程攻击者可直接通过 HTTP 访问该文件获取数据库管理员密码等敏感信息。该漏洞影响 MySQLDatabase Admin Tool Manager 全系列版本，攻击者无需身份认证即可利用，可能导致数据库被未授权访问和数据泄露。","severity":"HIGH","score":7.5,"aliases":["CVE-2000-0707"],"sources":["cve"],"published":"2000-10-20T04:00:00.000","updated":"2026-06-16T21:52:18.757","remediation":"立即将 PCCS MySQLDatabase Admin Tool 升级至 1.2.4 以上版本；将 dbconnect.inc 配置文件移出 Web 根目录（如放置于上级目录），并设置 Web 服务器（Apache/Nginx）拒绝访问 .inc 后缀文件，同时限制管理后台仅允许内网 IP 访问。","status":"completed","collected_at":"2026-07-22T00:00:00Z","references":["http://archives.neohapsis.com/archives/bugtraq/2000-08/0015.html","http://pccs-linux.com/public/view.php3?bn=agora_pccslinux&key=965951324","http://www.securityfocus.com/bid/1557","https://github.com/CVEProject/cvelistV5/blob/21e8713bd16ad152d6b946e7bfcd11df673c4829/cves/2000/0xxx/CVE-2000-0707.json","https://github.com/LiuCan01/cve-list-pro/blob/78b55511cee3604c22d518e32822f0435d0cacc0/cve-list/CVE-2000/CVE-2000-0707","https://github.com/yarencheng/cve-devops-playground/blob/cbe73d6bdcced13ea57f08566d6bbf5345864f7e/content/CVE-2000-0707.md","https://github.com/Patrowl/PatrowlHearsData/blob/03de0f4bc3d6ed449f7108b4761b99fb0c8c56d7/CVE/data/2000/CVE-2000-0707.json","https://github.com/rhuitl/uClinux/blob/0486e80a025dccbe4a2213715a2ab8a5063ea86b/user/nessus/nessus-plugins/scripts/pccsmysqladm.nasl","https://github.com/github/advisory-database/blob/e6b10ee602769bd7be4675bf10e3382c1f100e32/advisories/unreviewed/2022/04/GHSA-m2xp-5rxh-x3wc/GHSA-m2xp-5rxh-x3wc.json","https://github.com/eldondev/Snort/blob/34bdcf6a7a6
[{"ave_id":"AVE-2000-0739","file_name":"2000/AVE-2000-0739.toml","cve_id":"CVE-2000-0615","title":"LPRng LPD setuid root 权限配置不当导致日志信息泄露漏洞","description":"LPRng 3.6.x 版本在安装时将 lpd 守护进程错误地设置了 setuid root 权限，导致本地用户可利用该权限向任意文件中追加 lpd 调试跟踪日志信息。该漏洞源于不正确的文件权限配置，攻击者需拥有本地系统访问权限，利用 lpd 的日志功能将任意内容写入系统文件，可能造成日志伪造或敏感信息泄露。CVSS 评分 2.1，危害等级低。","severity":"LOW","score":2.1,"aliases":["CVE-2000-0615"],"sources":["cve"],"published":"2000-07-19T04:00:00.000","updated":"2026-06-16T21:52:06.920","remediation":"建议升级 LPRng 至 3.7.0 或更高版本，该版本移除了 lpd 的不必要 setuid root 权限设置。如无法升级，可立即执行 chmod u-s /usr/sbin/lpd 去除 setuid 位，并限制本地非授权用户对 lpd 日志目录的写入权限作为临时缓解措施。","status":"completed","collected_at":"2026-07-21T00:00:00Z","references":["http://archives.neohapsis.com/archives/bugtraq/2000-07/0117.html","http://www.securityfocus.com/bid/1447","https://exchange.xforce.ibmcloud.com/vulnerabilities/7361","https://github.com/CVEProject/cvelistV5/blob/59955f89028f6eb26686f8a6493373afe445701a/cves/2000/0xxx/CVE-2000-0615.json","https://github.com/LiuCan01/cve-list-pro/blob/78b55511cee3604c22d518e32822f0435d0cacc0/cve-list/CVE-2000/CVE-2000-0615","https://github.com/yarencheng/cve-devops-playground/blob/7f1c35ad28226319c149c937b6a2e7a1986924ce/content/CVE-2000-0615.md","https://github.com/Patrowl/PatrowlHearsData/blob/834e72bf1d790a78930554cd283f772f3690fc67/CVE/data/2000/CVE-2000-0615.json","https://github.com/github/advisory-database/blob/e52c2c075f8ae41771cb3f6120956c7f745eea35/advisories/unreviewed/2022/04/GHSA-xq2m-9f8c-rr6w/GHSA-xq2m-9f8c-rr6w.json","https://github.com/intSpLoiT/intframework/blob/eabaa799d0260aa52b735fa9769266d1ce4b64ef/modules/cve_list.txt","https://github.com/KTZgraph/sarenka/blob/f1fb931ab722d6c096d581ed6e3c5966d799fbaa/sarenka/feeds/cve_details/cve_all_details_152600_152700.json","https://github.com/oasis-open/cti-stix-common-objects/blob/55ba7598cbd5a52577b6887871505d931d85cb61/objects/vulnerability/vulnerability--877fce88-883a-4021-ad46-943c76441b12.json","https://github.com/nomi-sec/NVD-Database/blob/23dc120c34402aaa65883c51c1d03b3cb02c20cb/2000/CVE-2000-0615.json","https://github.com/williamjsmail/piranha/blob/e60f12e6edcde8585ee473f701c2421f6efe72d9/CVE2CAPEC/database/CVE-2000.jsonl"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":[],"repo_exp_urls":[],"has_poc":false,"has_exp":false,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/2000/AVE-2000-0739.toml"},{"ave_id":"AVE-2000-0486","file_name":"2000/AVE-2000-0486.toml","cve_id":"CVE-2000-0636","title":"HP JetDirect FTP 命令拒绝服务漏洞","description":"HP JetDirect 打印机的 FTP 服务存在拒绝服务漏洞，未经身份认证的远程攻击者可通过向目标设备的 FTP 端口发送特制的畸形 FTP QUOTE 命令，触发了服务组件对异常命令处理不当，导致打印机的 FTP 服务停止响应或崩溃。该漏洞影响 JetDirect 系列打印机固件版本 H.08.20 及更早版本，CVSS 评分 5.0，危害等级中危。厂商建议用户升级固件至最新版本以修复此问题。","severity":"MEDIUM","score":5.0,"aliases":["CVE-2000-0636"],"sources":["cve"],"published":"2000-07-19T04:00:00.000","updated":"2026-06-16T21:52:09.580","remediation":"升级 HP JetDirect 固件至 H.08.21 或更高版本（HP 已发布修复固件）。如无法立即升级，可在打印机管理界面禁用 FTP 服务，或在网络防火墙上封锁 TCP 21 端口对打印机的访问作为临时缓解措施。","status":"completed","collected_at":"2026-07-21T00:00:00Z","references":["http://archives.neohapsis.com/archives/bugtraq/2000-07/0265.html","http://www.securityfocus.com/bid/1491","https://exchange.xforce.ibmcloud.com/vulnerabilities/4947","https://www.exploit-db.com/exploits/20090","https://github.com/CVEProject/cvelistV5/blob/4382b0b8593e7ef30616ab300314afbbf1571636/cves/2000/0xxx/CVE-2000-0636.json","https://github.com/LiuCan01/cve-list-pro/blob/78b55511cee3604c22d518e32822f0435d0cacc0/cve-list/CVE-2000/CVE-2000-0636","https://github.com/yarencheng/cve-devops-playground/blob/7f1c35ad28226319c149c937b6a2e7a1986924ce/content/CVE-2000-0636.md","https://github.com/Patrowl/PatrowlHearsData/blob/cae595683b6fe65324ec717750e7cdca928c1db7/CVE/data/2000/CVE-2000-0636.json","https://github.com/github/advisory-database/blob/29756569ae7c866e39492d6faf2dcdff310590f7/advisories/unreviewed/2022/04/GHSA-j5xj-256c-jv3v/GHSA-j5xj-256c-jv3v.json","https://github.com/intSpLoiT/intframework/blob/eabaa799d0260aa52b735fa9769266d1ce4b64ef/modules/cve_list.txt","https://github.com/oasis-open/cti-stix-common-objects/blob/55ba7598cbd5a52577b6887871505d931d85cb61/objects/vulnerability/vulnerability--f6c76f78-6128-4ca7-b68c-4a69a54ba171.json","https://github.com/andreafioraldi/ToolsForCyberChallenge/blob/197d3dfd204cf1b9d1af1451455c8831c3ff9948/generated/files_0.list.dict","https://github.com/nomi-sec/NVD-Exploit-List-Ja/blob/b82432e7d59d95db9f183c0cefa7744595784afa/2000.tsv","https://github.com/hungryfoolou/Vulnerability_Mining/blob/3df1d8ed0489ae1228f975ae1f58a690aae53886/craw/cveid_craw/cveid_craw/data/cveid_by_kind/cveid_dos.txt"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":[],"repo_exp_urls":[],"has_poc":false,"has_exp":false,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/2000/AVE-2000-0486.toml"},{"ave_id":"AVE-2000-0479","file_name":"2000/AVE-2000-0479.toml","cve_id":"CVE-2000-0622","title":"O'Reilly WebSite Professional webfind.exe 远程缓冲区溢出漏洞","description":"OReilly WebSite Professional Web 服务器的 webfind.exe CGI 程序存在缓冲区溢出漏洞。远程攻击者无需身份认证即可通过构造包含超长 \"keywords\" 参数的 URL 触发缓冲区溢出，从而在目标服务器上执行任意命令。该漏洞影响 WebSite Professional 2.3.18、2.4 及 2.4.9 版本，CVSS 评分为 10，危害等级严重，攻击条件宽松，利用方式简单，仅需发送特制的 HTTP 请求即可完成远程代码执行。","severity":"CRITICAL","score":10.0,"aliases":["CVE-2000-0622"],"sources":["epss"],"published":"2000-07-19T04:00:00.000","updated":"2026-06-16T21:52:07.803","remediation":"立即将 O'Reilly WebSite Professional 升级到 2.5 或更高版本以修复 webfind.exe 缓冲区溢出。若无法升级，删除或重命名服务器上的 webfind.exe（通常位于 cgi-shl 目录），并在 Web 服务器配置中禁用搜索 CGI；同时在防火墙或访问控制中拦截对 /cgi-shl/webfind.exe 及含超长 keywords 参数请求的访问。该产品已停更，长期应迁移至受支持的 Web 服务器。","status":"completed","collected_at":"2026-07-25T00:00:00Z","references":["http://website.oreilly.com/support/software/wspro25_releasenotes.txt","http://www.nai.com/research/covert/advisories/043.asp","http://www.securityfocus.com/bid/1487","https://exchange.xforce.ibmcloud.com/vulnerabilities/4962","https://www.exploit-db.com/exploits/20086","https://github.com/trickest/cve/blob/1ba39e3ba737b838bba789f1cc5a339b5a2399ad/2000/CVE-2000-0622.md","https://github.com/CVEProject/cvelistV5/blob/24762ffc4408618d0c62379d258b248e81056dc1/cves/2000/0xxx/CVE-2000-0622.json","https://github.com/LiuCan01/cve-list-pro/blob/78b55511cee3604c22d518e32822f0435d0cacc0/cve-list/CVE-2000/CVE-2000-0622","https://github.com/fankh/vulnerability-poc/blob/ffa50060b7ba6ae58d60d6d90533e77eaf10d466/2000/CVE-2000-0622/README.md","https://github.com/Patrowl/PatrowlHearsData/blob/8305d7f6f9031873a5609178b8b2d4422836eee7/CVE/data/2000/CVE-2000-0622.json","https://github.com/rhuitl/uClinux/blob/0486e80a025dccbe4a2213715a2ab8a5063ea86b/user/nessus/nessus-plugins/scripts/webfind.nasl","https://github.com/mabitoski/cve_submodules/blob/44ad7e2705b3aef1b2ffaf64bd47596c10a6c2e4/2000/CVE-2000-0622.md","https://github.com/github/advisory-database/blob/c94c1772ba718b7f105ed32361c896b35042b2b3/advisories/unreviewed/2022/04/GHSA-c9gg-qqjg-6v7f/GHSA-c9gg-qqjg-6v7f.json","https://github.com/intSpLoiT/intframework/blob/eabaa799d0260aa52b735fa9769266d1ce4b64ef/modules/cve_list.txt","https://github.com/nomi-sec/NVD-Database/blob/23dc120c34402aaa65883c51c1d03b3cb02c20cb/2000/CVE-2000-0622.json"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":[],"repo_exp_urls":[],"has_poc":false,"has_exp":false,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/2000/AVE-2000-0479.toml"},{"ave_id":"AVE-2000-0771","file_name":"2000/AVE-2000-0771.toml","cve_id":"CVE-2000-0633","title":"Mandrake Linux usermode 本地拒绝服务漏洞","description":"Mandrake Linux usermode 软件包存在权限控制不当漏洞，本地攻击者可通过执行 usermode 提供的系统管理命令，触发目标系统非预期的关机或重启操作。该漏洞源于 usermode 软件包对 halt 和 reboot 等敏感命令的权限校验机制不完善，未正确限制普通用户的执行权限。攻击者只需拥有本地 shell 访问权限即可利用此漏洞，导致系统可用性受影响，造成拒绝服务。受影响的 Mandrake Linux 系统应安装 Red Hat 安全公告 RHSA-2000-053 中提供的更新补丁进行修复。","severity":"LOW","score":2.1,"aliases":["CVE-2000-0633"],"sources":["redhat"],"published":"2000-07-18T04:00:00.000","updated":"2026-06-16T21:52:09.197","remediation":"将 usermode 软件包升级至修复版本：Mandrake Linux 7.1 升级至 usermode-1.22-2mdk，Red Hat Linux 用户安装 RHSA-2000:053 提供的更新包。可通过 rpm -Uvh usermode-1.22-2mdk.i586.rpm 命令手动升级，或使用 MandrakeUpdate 自动更新。升级后将移除允许普通用户执行 reboot/halt/shutdown/poweroff 的权限，禁止无 root 权限的关机重启操作。","status":"completed","collected_at":"2026-07-22T00:00:00Z","references":["http://archives.neohapsis.com/archives/bugtraq/2000-07/0251.html","http://archives.neohapsis.com/archives/bugtraq/2000-08/0117.html","http://www.redhat.com/support/errata/RHSA-2000-053.html","http://www.securityfocus.com/bid/1489","https://exchange.xforce.ibmcloud.com/vulnerabilities/4944","https://github.com/CVEProject/cvelistV5/blob/9342e5394ee109ffc3617b5105797cdfcfcb78cf/cves/2000/0xxx/CVE-2000-0633.json","https://github.com/LiuCan01/cve-list-pro/blob/78b55511cee3604c22d518e32822f0435d0cacc0/cve-list/CVE-2000/CVE-2000-0633","https://github.com/yarencheng/cve-devops-playground/blob/cbe73d6bdcced13ea57f08566d6bbf5345864f7e/content/CVE-2000-0633.md","https://github.com/Patrowl/PatrowlHearsData/blob/4591185d8ea1fe47b6e30df3286bd52753a931ce/CVE/data/2000/CVE-2000-0633.json","https://github.com/github/advisory-database/blob/1684cfa32e43376c48beb06819bce86de6ba421b/advisories/unreviewed/2022/04/GHSA-j74f-5rh4-57cv/GHSA-j74f-5rh4-57cv.json","https://github.com/intSpLoiT/intframework/blob/eabaa799d0260aa52b735fa9769266d1ce4b64ef/modules/cve_list.txt","https://github.com/KTZgraph/sarenka/blob/f1fb931ab722d6c096d581ed6e3c5966d799fbaa/sarenka/feeds/cve_details/cve_all_details_152600_152700.json","https://github.com/nomi-sec/NVD-Database/blob/23dc120c34402aaa65883c51c1d03b3cb02c20cb/2000/CVE-2000-0633.json","https://github.com/Vasileios-Mavroeidis/semantic-stix-vulnerability/blob/30f07606133364b9623f401bc306c8c9cbcf9386/vulnerability/vulnerability--2c36f0d9-bd42-4f77-9dd3-32e8b7edf685.owl","https://github.com/williamjsmail/piranha/blob/e60f12e6edcde8585ee473f701c2421f6efe72d9/CVE2CAPEC/database/CVE-2000.jsonl"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":[],"repo_exp_urls":[],"has_poc":false,"has_exp":false,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/2000/AVE-2000-0771.toml"},{"ave_id":"AVE-2000-0757","file_name":"2000/AVE-2000-0757.toml","cve_id":"CVE-2000-0627","title":"BlackBoard CourseInfo 认证绕过与权限提升漏洞","description":"BlackBoard CourseInfo 4.0 存在认证缺陷漏洞，由于未对直接调用的 CGI 程序（如 user_update_passwd.pl 和 user_update_admin.pl）进行用户身份验证，导致本地攻击者可直接访问并修改 CourseInfo 数据库信息，进而提升权限。攻击者无需复杂前置条件即可实施利用，影响系统完整性和机密性。","severity":"HIGH","score":7.5,"aliases":["CVE-2000-0627"],"sources":["epss"],"published":"2000-07-18T04:00:00.000","updated":"2026-06-16T21:52:08.453","remediation":"立即联系 Blackboard 厂商获取 CourseInfo 4.0 的安全补丁并安装，或升级至已修复此漏洞的最新版本。作为临时缓解措施，在 Web 服务器（如 Apache）中配置访问控制，限制对 CGI 目录（如 /cgi-bin/）的直接调用，仅允许经过身份验证的管理员 IP 访问 user_update_passwd.pl 和 user_update_admin.pl 等后台 CGI 脚本；同时在脚本入口处添加 session 认证检查，拒绝未登录用户的直接请求。","status":"completed","collected_at":"2026-07-25T00:00:00Z","references":["http://archives.neohapsis.com/archives/bugtraq/2000-07/0254.html","http://www.securityfocus.com/bid/1486","http://www.securityfocus.com/frames/?content=/templates/archive.pike%3Flist%3D1%26msg%3D20000719151904.I17986%40securityfocus.com","https://exchange.xforce.ibmcloud.com/vulnerabilities/4946","https://github.com/CVEProject/cvelistV5/blob/c7415a52c8c7c49b12758f6cb68d7d41d1190b12/cves/2000/0xxx/CVE-2000-0627.json","https://github.com/LiuCan01/cve-list-pro/blob/78b55511cee3604c22d518e32822f0435d0cacc0/cve-list/CVE-2000/CVE-2000-0627","https://github.com/HORKimhab/poc-cve-collection/blob/333d3943ba23bf18333ea9f9256241d1bb61356e/2000/0xxx/CVE-2000-0627.md","https://github.com/Patrowl/PatrowlHearsData/blob/12664c75fe6d00113fe15964cee65a90965e367a/CVE/data/2000/CVE-2000-0627.json","https://github.com/github/advisory-database/blob/c94c1772ba718b7f105ed32361c896b35042b2b3/advisories/unreviewed/2022/04/GHSA-w2fq-mj73-7568/GHSA-w2fq-mj73-7568.json","https://github.com/yarencheng/cve-devops-playground/blob/7c450063cd3f12f7aa97a070bb18c68d6bc6767e/content/CVE-2000-0627.md","https://github.com/rhuitl/uClinux/blob/0486e80a025dccbe4a2213715a2ab8a5063ea86b/user/snort/drop-rules/sid-msg.map","https://github.com/intSpLoiT/intframework/blob/eabaa799d0260aa52b735fa9769266d1ce4b64ef/modules/cve_list.txt","https://github.com/jdkoftinoff/mb-linux-msli/blob/8adb103e34af9ff1d8d122e9ee2a1808836f0a14/uClinux-dist/user/snort/drop-rules/web-cgi.rules","https://github.com/nomi-sec/NVD-Database/blob/23dc120c34402aaa65883c51c1d03b3cb02c20cb/2000/CVE-2000-0627.json"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":["https://raw.githubusercontent.com/adysec/AVE/main/pocs/2000/POC-AVE-2000-0757.toml"],"repo_exp_urls":["https://raw.githubusercontent.com/adysec/AVE/main/exploits/2000/EXP-AVE-2000-0757.toml"],"has_poc":true,"has_exp":true,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/2000/AVE-2000-0757.toml"},{"ave_id":"AVE-2000-0751","file_name":"2000/AVE-2000-0751.toml","cve_id":"CVE-2000-0625","title":"NetZero ZeroPort 用户登录信息弱加密漏洞","description":"NetZero ZeroPort 3.0 及更早版本使用弱加密方法存储用户的登录凭据信息，本地攻击者可通过分析程序存储的加密数据，利用加密算法的弱安全性还原出明文密码。该漏洞源于软件对用户密码的加密强度不足，攻击者需具备本地系统访问权限，可导致用户账户凭证泄露，进而威胁账户安全。CVSS 评分 4.6，危害等级中危。","severity":"MEDIUM","score":4.6,"aliases":["CVE-2000-0625"],"sources":["cve"],"published":"2000-07-18T04:00:00.000","updated":"2026-06-16T21:52:08.213","remediation":"升级 NetZero ZeroPort 至 3.0 以上版本，新版本改用了更强加密算法保护本地存储的登录凭据。如无法升级，可删除程序自动保存的密码（在拨号连接设置中取消\"保存密码\"选项），每次手动输入密码以降低泄露风险。对仍使用此类旧版拨号软件的终端，建议迁移至支持现代加密协议（如 TLS）的连接方案。","status":"completed","collected_at":"2026-07-21T00:00:00Z","references":["http://www.l0pht.com/advisories/netzero.txt","http://www.securityfocus.com/bid/1483","https://github.com/trickest/cve/blob/3ffa2a96db84a89f71e1c7ad889e5f4fcc755a48/2000/CVE-2000-0625.md","https://github.com/CVEProject/cvelistV5/blob/a986b2f03c729ac57ae7d269a03d86211c579de0/cves/2000/0xxx/CVE-2000-0625.json","https://github.com/LiuCan01/cve-list-pro/blob/78b55511cee3604c22d518e32822f0435d0cacc0/cve-list/CVE-2000/CVE-2000-0625","https://github.com/nomi-sec/NVD-Database/blob/23dc120c34402aaa65883c51c1d03b3cb02c20cb/2000/CVE-2000-0625.json","https://github.com/mabitoski/cve_submodules/blob/44ad7e2705b3aef1b2ffaf64bd47596c10a6c2e4/2000/CVE-2000-0625.md","https://github.com/github/advisory-database/blob/1b194ae9b3fc8440f53a0c7f2468079802625f41/advisories/unreviewed/2022/04/GHSA-rpxp-9755-926w/GHSA-rpxp-9755-926w.json","https://github.com/olbat/nvdcve/blob/1c14ae4816efb67123e0664d061a6cbfe48f234b/nvdcve/CVE-2000-0625.json","https://github.com/SpeeDr00t/speedr00t.github.com/blob/0380f0c2190556fabe90257cb6c0034a42f68951/securityfocus/0x2000/1483/info.html","https://github.com/KTZgraph/sarenka/blob/f1fb931ab722d6c096d581ed6e3c5966d799fbaa/sarenka/feeds/cve_details/cve_all_details_152600_152700.json","https://github.com/akabe1/windows_exploit_dowser/blob/11b24e36173cd382721db28581e575faf687d06b/cve_from_exploitdb_website.csv"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":[],"repo_exp_urls":[],"has_poc":false,"has_exp":false,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/2000/AVE-2000-0751.toml"},{"ave_id":"AVE-2000-0482","file_name":"2000/AVE-2000-0482.toml","cve_id":"CVE-2000-0626","title":"Computer Software Manufaktur Alibaba 2.0 Web服务器 缓冲区溢出拒绝服务漏洞","description":"Computer Software Manufaktur 出品的 Alibaba Web 服务器 2.0 存在缓冲区溢出漏洞。攻击者无需身份认证，可通过网络向目标发送超长 GET 请求触发缓冲区溢出，导致服务拒绝服务（DoS）崩溃。该漏洞影响 Alibaba 2.0 等版本，攻击条件为可访问目标 HTTP 服务即可利用，公开 PoC 已证实可通过构造超长请求完成远程拒绝服务攻击。","severity":"MEDIUM","score":5.0,"aliases":["CVE-2000-0626"],"sources":["epss"],"published":"2000-07-18T04:00:00.000","updated":"2026-06-16T21:52:08.330","remediation":"立即停止对外暴露 Computer Software Manufaktur Alibaba 2.0 Web Server，卸载该服务并迁移至 Nginx、Apache、IIS 等仍在维护的 Web 服务器。若短期无法替换，请在前置防火墙或反向代理上限制 HTTP GET 请求 URI 长度（例如拒绝超过 2048 字节的请求），仅允许可信源 IP 访问 80/443 端口，并对 Alibaba 进程配置异常崩溃后自动重启与监控告警。","status":"completed","collected_at":"2026-07-25T00:00:00Z","references":["http://archives.neohapsis.com/archives/bugtraq/2000-07/0237.html","http://www.securityfocus.com/bid/1482","https://www.exploit-db.com/exploits/20080","https://github.com/CVEProject/cvelistV5/blob/5b3647aa8630e92d52def237a668e1c7c212a696/cves/2000/0xxx/CVE-2000-0626.json","https://github.com/LiuCan01/cve-list-pro/blob/78b55511cee3604c22d518e32822f0435d0cacc0/cve-list/CVE-2000/CVE-2000-0626","https://github.com/HORKimhab/poc-cve-collection/blob/1b90054999de26e10cbd417a0bad0a4c95c3a80e/2000/0xxx/CVE-2000-0626.md","https://github.com/Patrowl/PatrowlHearsData/blob/03565a27475d500737670f7247b6cadb2e7c3d33/CVE/data/2000/CVE-2000-0626.json","https://github.com/github/advisory-database/blob/c94c1772ba718b7f105ed32361c896b35042b2b3/advisories/unreviewed/2022/04/GHSA-7j9c-jj55-7hhm/GHSA-7j9c-jj55-7hhm.json","https://github.com/blackhook/nessus-plugins/blob/64177d96abbb07c58cf7e131046b067ebc61fcb5/A/alibaba_overflow.nasl","https://github.com/nomi-sec/NVD-Database/blob/23dc120c34402aaa65883c51c1d03b3cb02c20cb/2000/CVE-2000-0626.json","https://github.com/intSpLoiT/intframework/blob/eabaa799d0260aa52b735fa9769266d1ce4b64ef/modules/cve_list.txt","https://github.com/SpeeDr00t/speedr00t.github.com/blob/0380f0c2190556fabe90257cb6c0034a42f68951/securityfocus/0x2000/1482/info.html","https://github.com/andreafioraldi/ToolsForCyberChallenge/blob/197d3dfd204cf1b9d1af1451455c8831c3ff9948/generated/files_0.list.dict"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":[],"repo_exp_urls":[],"has_poc":false,"has_exp":false,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/2000/AVE-2000-0482.toml"},{"ave_id":"AVE-2000-0450","file_name":"2000/AVE-2000-0450.toml","cve_id":"CVE-2000-0567","title":"Microsoft Outlook 与 Outlook Express 缓冲区溢出漏洞","description":"Microsoft Outlook 97/98/2000 及 Outlook Express 4.0/5.0 的邮件头解析模块存在缓冲区溢出漏洞，攻击者通过构造包含超长 GMT/Date 字段的恶意电子邮件，利用邮件客户端对邮件头长度校验缺失触发栈溢出，导致未经身份认证的远程攻击者可在目标系统上下文中执行任意代码。该漏洞影响广泛使用的 Outlook 与 Outlook Express 多个版本，攻击向量为网络邮件投递，无需用户交互即可触发，属于典型的“畸形邮件头”缓冲区溢出漏洞，CVSS 5.0 中危评级。Microsoft 已发布 MS00-043 安全公告修复该漏洞，建议用户升级至 Office 2000 SR-1 或应用对应补丁。","severity":"MEDIUM","score":5.0,"aliases":["CVE-2000-0567"],"sources":["epss"],"published":"2000-07-18T04:00:00.000","updated":"2026-06-16T21:52:00.813","remediation":"建议安装Microsoft 2000 年 7 月发布的Office 2000 SR-1（Service Release 1）或Outlook 2000 SR-1补丁，修复GMT字段缓冲区溢漏洞。如无法立即应用补丁，可在企业防火墙中阻止包含异常长日期字段的电子邮件头部作为临时缓解措施。","status":"completed","collected_at":"2026-07-24T00:00:00Z","references":["http://www.securityfocus.com/bid/1481","https://docs.microsoft.com/en-us/security-updates/securitybulletins/2000/ms00-043","https://exchange.xforce.ibmcloud.com/vulnerabilities/4953","https://www.exploit-db.com/exploits/20079","https://github.com/trickest/cve/blob/efd7fc726910da5a47b5ea864d60bf92f66b594e/2000/CVE-2000-0567.md","https://github.com/CVEProject/cvelistV5/blob/67d48875bcd35ab339290b9a99c435b09bd5c40b/cves/2000/0xxx/CVE-2000-0567.json","https://github.com/LiuCan01/cve-list-pro/blob/78b55511cee3604c22d518e32822f0435d0cacc0/cve-list/CVE-2000/CVE-2000-0567","https://github.com/xaitax/SploitScan/blob/938d5f69569a096cf728175efd0ca15f6fd92c6a/README.md","https://github.com/Patrowl/PatrowlHearsData/blob/1ea1fd4e9132e508aaecde8cf383b74de1fcf0a5/CVE/data/2000/CVE-2000-0567.json","https://github.com/biggerwing/nsfocus-rsas-knowledge-base/blob/156208b301d4649ead13cd15f827830d08245b89/example","https://github.com/mabitoski/cve_submodules/blob/44ad7e2705b3aef1b2ffaf64bd47596c10a6c2e4/2000/CVE-2000-0567.md","https://github.com/github/advisory-database/blob/2b8a7bdd977d852aa4b7aade01f4fcd4d623cfde/advisories/unreviewed/2022/04/GHSA-4w6m-4639-4jgr/GHSA-4w6m-4639-4jgr.json","https://github.com/intSpLoiT/intframework/blob/eabaa799d0260aa52b735fa9769266d1ce4b64ef/modules/cve_list.txt","https://github.com/olbat/nvdcve/blob/a036095fb2c093f3863681adc5999690c37b930e/nvdcve/CVE-2000-0567.json"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":[],"repo_exp_urls":[],"has_poc":false,"has_exp":false,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/2000/AVE-2000-0450.toml"},{"ave_id":"AVE-2000-1406","file_name":"2000/AVE-2000-1406.toml","cve_id":"CVE-2000-0623","title":"O'Reilly WebSite Professional 缓冲区溢出远程代码执行漏洞","description":"O'Reilly WebSite Professional 是一款 Web 服务器软件，该软件在 2.4 及更早版本中存在缓冲区溢出漏洞。远程攻击者无需身份验证，即可通过向目标服务器发送超长的 GET 请求或构造超长的 Referrer 头字段触发溢出，进而执行任意系统命令，完全控制服务器。该漏洞影响所有运行受影响版本 WebSite Professional 的站点，攻击者仅需具备网络可达性即可发起利用。O'Reilly 公司已发布修复补丁，建议用户升级至安全版本以消除风险。","severity":"CRITICAL","score":10.0,"aliases":["CVE-2000-0623"],"sources":["epss"],"published":"2000-07-17T04:00:00.000","updated":"2026-06-16T21:52:07.947","remediation":"立即升级 O'Reilly WebSite Professional 至 2.4 之后已修复版本。若厂商不再提供安全补丁，请在 Web 服务器配置中限制 HTTP 请求头最大长度和 GET 请求 URI 长度，丢弃超长的 Referrer 头字段，并部署 WAF 规则拦截异常长请求，以缓解缓冲区溢出风险。","status":"completed","collected_at":"2026-07-25T00:00:00Z","references":["http://www.ntbugtraq.com/default.asp?pid=36&sid=1&A2=ind0007&L=ntbugtraq&F=&S=&P=5946","http://www.securityfocus.com/bid/1492","https://github.com/CVEProject/cvelistV5/blob/e2b7e39540f8003a5fc1c3ce83959dcdba6671a4/cves/2000/0xxx/CVE-2000-0623.json","https://github.com/LiuCan01/cve-list-pro/blob/78b55511cee3604c22d518e32822f0435d0cacc0/cve-list/CVE-2000/CVE-2000-0623","https://github.com/sullo/nikto/blob/999670cb6a939b6c93840ce666941756e4c5dcf5/program/databases/db_server_msgs","https://github.com/fankh/vulnerability-poc/blob/ffa50060b7ba6ae58d60d6d90533e77eaf10d466/2000/CVE-2000-0623/README.md","https://github.com/HORKimhab/poc-cve-collection/blob/a62a80fdc2396b876bbf0b9654bdb65410ca206f/2000/0xxx/CVE-2000-0623.md","https://github.com/Patrowl/PatrowlHearsData/blob/17761d0bb7d0c679e07e3a6bd812f9ec07c3dd92/CVE/data/2000/CVE-2000-0623.json","https://github.com/github/advisory-database/blob/c94c1772ba718b7f105ed32361c896b35042b2b3/advisories/unreviewed/2022/04/GHSA-xxfm-q6cq-gcwc/GHSA-xxfm-q6cq-gcwc.json","https://github.com/yarencheng/cve-devops-playground/blob/7c450063cd3f12f7aa97a070bb18c68d6bc6767e/content/CVE-2000-0623.md","https://github.com/jdkoftinoff/mb-linux-msli/blob/8adb103e34af9ff1d8d122e9ee2a1808836f0a14/uClinux-dist/user/nessus/nessus-plugins/scripts/websitepro_overflow.nasl","https://github.com/intSpLoiT/intframework/blob/eabaa799d0260aa52b735fa9769266d1ce4b64ef/modules/cve_list.txt"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":["https://raw.githubusercontent.com/adysec/AVE/main/pocs/2000/POC-AVE-2000-1406.toml"],"repo_exp_urls":["https://raw.githubusercontent.com/adysec/AVE/main/exploits/2000/EXP-AVE-2000-1406.toml"],"has_poc":true,"has_exp":true,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/2000/AVE-2000-1406.toml"},{"ave_id":"AVE-2000-0768","file_name":"2000/AVE-2000-0768.toml","cve_id":"CVE-2000-0632","title":"L-Soft Listserv Web Archive 组件缓冲区溢出远程代码执行漏洞","description":"L-Soft Listserv 1.8d 及更早版本的 Web 归档组件中存在缓冲区溢出漏洞。远程攻击者可通过向该组件发送特制超长查询字符串触发溢出，从而在目标系统上执行任意命令。该漏洞影响广泛部署的邮件列表管理软件 Listserv，CVSS 评分 7.5，危害等级高。厂商已发布修复版本，建议升级至 1.8e 或更新版本。","severity":"HIGH","score":7.5,"aliases":["CVE-2000-0632"],"sources":["cve"],"published":"2000-07-17T04:00:00.000","updated":"2026-06-16T21:52:09.080","remediation":"立即升级 L-Soft Listserv 至 1.8e 或更高版本。如无法升级，临时缓解措施为在 Web 服务器配置中移除或禁用 web archive CGI 组件（如 wa.exe），并限制外部流量对该组件的访问。","status":"completed","collected_at":"2026-07-21T00:00:00Z","references":["http://www.lsoft.com/news/default.asp?item=Advisory1","http://www.nai.com/nai_labs/asp_set/advisory/43_Advisory.asp","http://www.securityfocus.com/bid/1490","https://exchange.xforce.ibmcloud.com/vulnerabilities/4952","https://github.com/trickest/cve/blob/3ffa2a96db84a89f71e1c7ad889e5f4fcc755a48/2000/CVE-2000-0632.md","https://github.com/CVEProject/cvelistV5/blob/4603507d019be3585b2e7bcddcb6c6f57901b490/cves/2000/0xxx/CVE-2000-0632.json","https://github.com/LiuCan01/cve-list-pro/blob/78b55511cee3604c22d518e32822f0435d0cacc0/cve-list/CVE-2000/CVE-2000-0632","https://github.com/Patrowl/PatrowlHearsData/blob/cae595683b6fe65324ec717750e7cdca928c1db7/CVE/data/2000/CVE-2000-0632.json","https://github.com/mabitoski/cve_submodules/blob/44ad7e2705b3aef1b2ffaf64bd47596c10a6c2e4/2000/CVE-2000-0632.md","https://github.com/github/advisory-database/blob/f5ee58102af366026efb2988554e99ff8cc7a609/advisories/unreviewed/2022/04/GHSA-3v52-43ch-8qcg/GHSA-3v52-43ch-8qcg.json","https://github.com/intSpLoiT/intframework/blob/eabaa799d0260aa52b735fa9769266d1ce4b64ef/modules/cve_list.txt","https://github.com/nomi-sec/NVD-Database/blob/23dc120c34402aaa65883c51c1d03b3cb02c20cb/2000/CVE-2000-0632.json","https://github.com/KTZgraph/sarenka/blob/f1fb931ab722d6c096d581ed6e3c5966d799fbaa/sarenka/feeds/cve_details/cve_all_details_152600_152700.json","https://github.com/yarencheng/cve-devops-playground/blob/7f1c35ad28226319c149c937b6a2e7a1986924ce/content/CVE-2000-0632.md"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":[],"repo_exp_urls":[],"has_poc":false,"has_exp":false,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/2000/AVE-2000-0768.toml"},{"ave_id":"AVE-2000-0517","file_name":"2000/AVE-2000-0517.toml","cve_id":"CVE-2000-0665","title":"GAMSoft TelSrv 远程缓冲区溢出漏洞","description":"GAMSoft TelSrv 服务端软件存在缓冲区溢出漏洞，远程攻击者可通过向目标服务器的 telnet 服务发送超长用户名数据包，触发缓冲区溢出，导致服务崩溃拒绝服务，甚至可能执行任意代码。该漏洞影响 GAMSoft TelSrv 1.5 及更早版本，攻击者无需认证即可远程利用，危害较大。","severity":"MEDIUM","score":5.0,"aliases":["CVE-2000-0665"],"sources":["cve"],"published":"2000-07-17T04:00:00.000","updated":"2026-06-16T21:52:13.277","remediation":"立即停止使用 GAMSoft TelSrv 1.5 及更早版本，因其厂商已停止维护且官方未发布补丁。建议迁移至现代 SSH 或安全 Telnet 服务器替代。如无法立即替换，在防火墙层面限制对 TCP 23 端口的访问来源，仅允许可信 IP 连接，以降低攻击面。","status":"completed","collected_at":"2026-07-21T00:00:00Z","references":["http://archives.neohapsis.com/archives/ntbugtraq/2000-q3/0031.html","http://archives.neohapsis.com/archives/ntbugtraq/2000-q3/0056.html","http://www.osvdb.org/373","http://www.securityfocus.com/bid/1478","https://exchange.xforce.ibmcloud.com/vulnerabilities/4945","https://www.exploit-db.com/exploits/16816","https://github.com/CVEProject/cvelistV5/blob/47aadecb5d7f9b0723652503f764f5addc1275b9/cves/2000/0xxx/CVE-2000-0665.json","https://github.com/LiuCan01/cve-list-pro/blob/78b55511cee3604c22d518e32822f0435d0cacc0/cve-list/CVE-2000/CVE-2000-0665","https://github.com/e-m-b-a/emba/blob/4d0f24b3edae0bdb5391177851bad3be54ecea0f/config/msf_cve-db.txt","https://github.com/yarencheng/cve-devops-playground/blob/7f1c35ad28226319c149c937b6a2e7a1986924ce/content/CVE-2000-0665.md","https://github.com/Patrowl/PatrowlHearsData/blob/4dd512046a74ddd9ae16741caf0933056ffd666e/CVE/data/2000/CVE-2000-0665.json","https://github.com/Chudry/Xerror/blob/07ec57cabcd27cdb47c89af452bdf4ed07207347/xerror/parsing/msf_module_result/msf_module_cve.txt","https://github.com/openctibr/threatFeeds/blob/0c1943928e18d8739c9776e9094da2df90ca5e87/ExploitableVulnerabilitiesFeed.txt","https://github.com/LubyRuffy/plugins/blob/f873b19f27c95eaf2993ca4acde5cb7965d2ee3f/pre2008/TelSrv_DoS.nasl","https://github.com/KTZgraph/sarenka/blob/f1fb931ab722d6c096d581ed6e3c5966d799fbaa/sarenka/feeds/cve_details/cve_all_details_152600_152700.json","https://github.com/nomi-sec/NVD-Database/blob/23dc120c34402aaa65883c51c1d03b3cb02c20cb/2000/CVE-2000-0665.json"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":[],"repo_exp_urls":[],"has_poc":false,"has_exp":false,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/2000/AVE-2000-0517.toml"},{"ave_id":"AVE-2000-0484","file_name":"2000/AVE-2000-0484.toml","cve_id":"CVE-2000-0630","title":"Microsoft IIS 4.0/5.0 源码片段泄露漏洞","description":"Microsoft IIS 4.0 和 5.0 存在源代码片段泄露漏洞，远程攻击者通过在 URL 后附加 \"+.htr\" 即可触发该漏洞，这是 \".HTR 文件片段读取\" 漏洞的变种。攻击者无需身份认证即可通过网络远程利用，导致服务器返回 ASP 等脚本文件的源代码片段，从而泄露数据库连接字符串、业务逻辑等敏感信息。该漏洞影响 IIS 4.0 和 5.0 版本，攻击条件简单，危害中等。","severity":"MEDIUM","score":5.0,"aliases":["CVE-2000-0630"],"sources":["epss"],"published":"2000-07-17T04:00:00.000","updated":"2026-06-16T21:52:08.837","remediation":"建议立即移除 IIS 中的 .HTR 脚本映射：打开 Internet 服务管理器 → 右键网站属性 → 主属性 → WWW 服务 → 编辑 → 主目录 → 配置，删除 .HTR 条目。如业务必须保留 HTR 功能，则安装 MS00-044 补丁（已被 MS01-004 取代），同时收紧 /scripts/iisadmin 目录权限，仅允许管理员访问。","status":"completed","collected_at":"2026-07-27T00:00:00Z","references":["http://www.securityfocus.com/bid/1488","https://docs.microsoft.com/en-us/security-updates/securitybulletins/2000/ms00-044","https://exchange.xforce.ibmcloud.com/vulnerabilities/5104","https://www.exploit-db.com/exploits/20089","https://github.com/CVEProject/cvelistV5/blob/bb04e7276eb5376f975ca811b9a340d0d55b901d/cves/2000/0xxx/CVE-2000-0630.json","https://github.com/LiuCan01/cve-list-pro/blob/78b55511cee3604c22d518e32822f0435d0cacc0/cve-list/CVE-2000/CVE-2000-0630","https://github.com/HORKimhab/poc-cve-collection/blob/11a92cc3c0d31b9e78fe8f2a857dd04df3195701/2000/0xxx/CVE-2000-0630.md","https://github.com/Patrowl/PatrowlHearsData/blob/0298403c910e42219c357a4f56dac428565b2e47/CVE/data/2000/CVE-2000-0630.json","https://github.com/github/advisory-database/blob/724a585dd64bbf0d8e6760dd16b808140e9a0dd8/advisories/unreviewed/2022/04/GHSA-4pcm-9qq9-65qc/GHSA-4pcm-9qq9-65qc.json","https://github.com/rhuitl/uClinux/blob/0486e80a025dccbe4a2213715a2ab8a5063ea86b/user/snort/drop-rules/web-iis.rules","https://github.com/yarencheng/cve-devops-playground/blob/c54e59752dddfc9aa36c13774164384cfa0d1f04/content/CVE-2000-0630.md","https://github.com/marcellodesales/aibbp-reverse-engineer/blob/960f610d597aae9fec1cc5f03c68679be00c222d/reverse_engineer/invicti/vulnerabilities/db/vulnerabilities/vdb/2000/0xxx/cve-2000-0630.yaml","https://github.com/xqcyberscore/nvt/blob/978f6a9acb495d7d669239530ffe6da5d631f4da/pre2008/iis_frag_disclosure.nasl","https://github.com/intSpLoiT/intframework/blob/eabaa799d0260aa52b735fa9769266d1ce4b64ef/modules/cve_list.txt"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":["https://raw.githubusercontent.com/adysec/AVE/main/pocs/2000/POC-AVE-2000-0484.toml"],"repo_exp_urls":["https://raw.githubusercontent.com/adysec/AVE/main/exploits/2000/EXP-AVE-2000-0484.toml"],"has_poc":true,"has_exp":true,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/2000/AVE-2000-0484.toml"},{"ave_id":"AVE-2000-0518","file_name":"2000/AVE-2000-0518.toml","cve_id":"CVE-2000-0666","title":"Linux nfs-utils rpc.statd 远程格式字符串漏洞","description":"rpc.statd 是 NFS 文件共享服务中的状态监控守护进程，nfs-utils 软件包中的 rpc.statd 存在格式字符串漏洞。远程攻击者可通过向目标系统发送特制的 RPC 请求，利用未正确过滤的格式字符串参数执行任意代码，从而获取 root 权限。该漏洞影响 Conectiva、Debian、RedHat、S.u.S.E、Trustix 等多个 Linux 发行版的早期版本，CVSS 评分 10.0，危害等级严重。厂商已发布安全补丁修复此漏洞。","severity":"CRITICAL","score":10.0,"aliases":["CVE-2000-0666"],"sources":["redhat"],"published":"2000-07-16T04:00:00.000","updated":"2026-06-16T21:52:13.413","remediation":"升级 nfs-utils 至 0.1.17 及以上版本，该版本修复了 rpc.statd 中未正确清理格式化字符串的问题。如无法立即升级，可在 /etc/hosts.deny 中添加 \"rpc.statd: ALL\" 并在 /etc/hosts.allow 中仅放行可信 IP，或禁用 NFS 服务 (service nfs stop && chkconfig nfs off) 作为临时缓解措施。","status":"completed","collected_at":"2026-07-22T00:00:00Z","references":["http://archives.neohapsis.com/archives/bugtraq/2000-07/0206.html","http://archives.neohapsis.com/archives/bugtraq/2000-07/0230.html","http://archives.neohapsis.com/archives/bugtraq/2000-07/0236.html","http://archives.neohapsis.com/archives/bugtraq/2000-07/0260.html","http://www.calderasystems.com/support/security/advisories/CSSA-2000-025.0.txt","http://www.cert.org/advisories/CA-2000-17.html","http://www.redhat.com/support/errata/RHSA-2000-043.html","http://www.securityfocus.com/bid/1480","https://exchange.xforce.ibmcloud.com/vulnerabilities/4939","https://www.exploit-db.com/exploits/20077","https://github.com/CVEProject/cvelistV5/blob/9342e5394ee109ffc3617b5105797cdfcfcb78cf/cves/2000/0xxx/CVE-2000-0666.json","https://github.com/LiuCan01/cve-list-pro/blob/78b55511cee3604c22d518e32822f0435d0cacc0/cve-list/CVE-2000/CVE-2000-0666","https://github.com/fankh/vulnerability-poc/blob/ffa50060b7ba6ae58d60d6d90533e77eaf10d466/2000/CVE-2000-0666/README.md","https://github.com/yarencheng/cve-devops-playground/blob/cbe73d6bdcced13ea57f08566d6bbf5345864f7e/content/CVE-2000-0666.md","https://github.com/eldondev/Snort/blob/34bdcf6a7a638b55c7c04f77ef1efa526ad08e33/doc/signatures/1916.txt","https://github.com/Patrowl/PatrowlHearsData/blob/4591185d8ea1fe47b6e30df3286bd52753a931ce/CVE/data/2000/CVE-2000-0666.json","https://github.com/rhuitl/uClinux/blob/0486e80a025dccbe4a2213715a2ab8a5063ea86b/user/nessus/nessus-plugins/scripts/redhat_fixes.nasl","https://github.com/github/advisory-database/blob/1684cfa32e43376c48beb06819bce86de6ba421b/advisories/unreviewed/2022/04/GHSA-jc43-58xv-97mp/GHSA-jc43-58xv-97mp.json","https://github.com/bailehang/snort_2.2.0/blob/34f8a3a85f15645aea53d6e0d46863c7c57e43ef/doc/signatures/1890.txt","https://github.com/gadievron/raptor/blob/117ae98018f0e5f1508cde2ba2b4e30bfee2d63e/packages/cve_diff/data/samples/random_200_full_v3.json"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":["https://raw.githubusercontent.com/adysec/AVE/main/pocs/2000/POC-AVE-2000-0518.toml"],"repo_exp_urls":[],"has_poc":true,"has_exp":false,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/2000/AVE-2000-0518.toml"},{"ave_id":"AVE-2000-0766","file_name":"2000/AVE-2000-0766.toml","cve_id":"CVE-2000-0631","title":"Microsoft IIS 管理脚本拒绝服务漏洞","description":"Microsoft IIS 3.0/4.0/5.0 的管理脚本存在拒绝服务漏洞。远程攻击者无需认证即可通过 HTTP 访问管理脚本，且不提供特定参数（Absent Directory Browser Argument），导致 IIS 服务进程崩溃或资源耗尽，造成拒绝服务。该漏洞攻击条件简单，无需特殊权限，影响 IIS 3.0 至 5.0 版本。","severity":"MEDIUM","score":5.0,"aliases":["CVE-2000-0631"],"sources":["epss"],"published":"2000-07-14T04:00:00.000","updated":"2026-06-16T21:52:08.957","remediation":"强烈建议优先禁用 IIS 中的 .HTR 脚本映射：打开 Internet 服务管理器，右键单击 Web 服务器 → 属性 → 主属性 → WWW 服务 → 编辑 → 主目录 → 配置，删除 .HTR 条目。如因业务必须保留 .HTR 功能，请安装 MS01-004 安全更新（已取代 MS00-044 补丁），该补丁适用于 Windows NT 4.0 SP5/SP6a 和 Windows 2000 Gold/SP1/SP2。同时收紧 /scripts/iisadmin 目录权限，仅允许管理员访问。若服务器已因该漏洞陷入无限循环，停止并重启 IIS 服务即可恢复，无需重启操作系统。","status":"completed","collected_at":"2026-07-27T00:00:00Z","references":["http://marc.info/?l=bugtraq&m=96390444022878&w=2","http://www.securityfocus.com/bid/1476","https://docs.microsoft.com/en-us/security-updates/securitybulletins/2000/ms00-044","https://exchange.xforce.ibmcloud.com/vulnerabilities/4951","https://github.com/trickest/cve/blob/e69d88e0152845fc4d4b49970ca6e503f56b2f93/2000/CVE-2000-0631.md","https://github.com/CVEProject/cvelistV5/blob/bb04e7276eb5376f975ca811b9a340d0d55b901d/cves/2000/0xxx/CVE-2000-0631.json","https://github.com/LiuCan01/cve-list-pro/blob/78b55511cee3604c22d518e32822f0435d0cacc0/cve-list/CVE-2000/CVE-2000-0631","https://github.com/ARPSyndicate/suricata-vedas/blob/fe24794ad36564b5bbc7c69101525011387b8650/2000/CVE-2000-0631.rules","https://github.com/edoardottt/missing-cve-nuclei-templates/blob/115c94bd1da3cc18977d652d6e78c9f4a5dfc13b/data/year/2000.txt","https://github.com/Patrowl/PatrowlHearsData/blob/0298403c910e42219c357a4f56dac428565b2e47/CVE/data/2000/CVE-2000-0631.json","https://github.com/mabitoski/cve_submodules/blob/44ad7e2705b3aef1b2ffaf64bd47596c10a6c2e4/2000/CVE-2000-0631.md","https://github.com/github/advisory-database/blob/724a585dd64bbf0d8e6760dd16b808140e9a0dd8/advisories/unreviewed/2022/04/GHSA-gm9r-p48q-qmx6/GHSA-gm9r-p48q-qmx6.json","https://github.com/marcellodesales/aibbp-reverse-engineer/blob/960f610d597aae9fec1cc5f03c68679be00c222d/reverse_engineer/acunetix/vulnerabilities/vdb/2000/0xxx/cve-2000-0631.yaml","https://github.com/intSpLoiT/intframework/blob/eabaa799d0260aa52b735fa9769266d1ce4b64ef/modules/cve_list.txt"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":["https://raw.githubusercontent.com/adysec/AVE/main/pocs/2000/POC-AVE-2000-0766.toml"],"repo_exp_urls":[],"has_poc":true,"has_exp":false,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/2000/AVE-2000-0766.toml"},{"ave_id":"AVE-2000-0804","file_name":"2000/AVE-2000-0804.toml","cve_id":"CVE-2000-0662","title":"Microsoft Internet Explorer/Outlook DHTML Edit Control 任意文件读取漏洞","description":"Microsoft Internet Explorer 5.x 及 Outlook 中 DHTML 编辑控件（DHTMLED）存在任意文件读取漏洞。远程攻击者可构造恶意网页，通过操控 IFRAME 元素重定向其内容，诱使用户访问后即可读取目标系统上的任意文件内容。该漏洞影响 IE 5.x 及 Outlook 等多个微软产品，攻击者需诱导用户访问恶意页面，无需额外认证即可窃取敏感信息。","severity":"MEDIUM","score":5.0,"aliases":["CVE-2000-0662"],"sources":["cve","nvd"],"published":"2000-07-14","updated":"2026-06-16","remediation":"安装 Microsoft 安全公告 MS00-055 提供的 Internet Explorer 累积安全更新补丁，该补丁限制 Scriptlet 组件仅渲染 HTML 文件，阻止非 HTML 文件的跨域读取。由于 IE 5.x 已停止支持，建议升级至 Microsoft Edge 或使用受支持的现代浏览器。","status":"completed","collected_at":"2026-07-21T00:00:00Z","references":["https://learn.microsoft.com/en-us/security-updates/securitybulletins/2000/ms00-055","http://www.securityfocus.com/bid/1474","http://www.securityfocus.com/templates/archive.pike?list=1&msg=396EF9D5.62EEC625%40nat.bg","https://exchange.xforce.ibmcloud.com/vulnerabilities/5107"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":[],"repo_exp_urls":[],"has_poc":false,"has_exp":false,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/2000/AVE-2000-0804.toml"}]
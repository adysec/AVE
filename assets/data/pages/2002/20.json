/NVD-Database/blob/23dc120c34402aaa65883c51c1d03b3cb02c20cb/2002/CVE-2002-1090.json","https://github.com/olbat/nvdcve/blob/add906b6a8ba20fd533c6fdd7f023c73e6090f3a/nvdcve/CVE-2002-1090.json","https://github.com/fkie-cad/nvd-json-data-feeds/blob/1b01d01b655cac08088621898fd70278524e2f0e/CVE-2002/CVE-2002-10xx/CVE-2002-1090.json","https://github.com/opencve/opencve-kb/blob/10e9467be38429ca2d719aefc6850e69115854fd/2002/CVE-2002-1090.json","https://github.com/HORKimhab/poc-cve-collection/blob/63bc6ccb7d9e7d0447e23eb842c0b23beddd261c/2002/1xxx/CVE-2002-1090.md","https://github.com/aquasecurity/vuln-list-debian/blob/464c797de515f2d88fce07a24f8ad97207296c93/tracker/CVE/2002/CVE-2002-1090.json","https://github.com/aquasecurity/vuln-list-nvd/blob/a61093fe8784b8ca7275942dc1f03ea5da66b812/api/2002/CVE-2002-1090.json"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":[],"repo_exp_urls":[],"has_poc":false,"has_exp":false,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/2002/AVE-2002-0039.toml"},{"ave_id":"AVE-2002-0038","file_name":"2002/AVE-2002-0038.toml","cve_id":"CVE-2002-1050","title":"HylaFAX faxgetty 缓冲区溢出远程代码执行漏洞","description":"HylaFAX 传真服务器 4.1.3 之前版本中的 faxgetty 组件存在缓冲区溢出漏洞。远程攻击者可通过向目标系统发送特制的超长图像数据行触发该漏洞，导致 faxgetty 进程崩溃从而造成拒绝服务，在特定条件下可能实现任意代码执行。该漏洞影响运行 HylaFAX 4.1.3 之前版本的各类 Unix/Linux 系统，攻击无需身份认证，危害等级高。","severity":"HIGH","score":7.5,"aliases":["CVE-2002-1050"],"sources":["osv"],"published":"2002-10-04T04:00:00Z","updated":"2026-06-16T21:58:38Z","remediation":"立即将 HylaFAX 升级至 4.1.3 或更高版本。Debian Woody 用户应升级至 1:4.1.1-1.1（DSA-148），SUSE Linux 用户安装 SA 2002_035 安全更新。如无法立即升级，可在 faxgetty 配置中限制客户端连接来源 IP 或禁用远程传真接收功能作为临时缓解措施。","status":"completed","collected_at":"2026-07-22T00:00:00Z","references":["http://archives.neohapsis.com/archives/bugtraq/2002-07/0358.html","http://bugs.hylafax.org/bugzilla/show_bug.cgi?id=312","http://www.debian.org/security/2002/dsa-148","http://www.iss.net/security_center/static/9729.php","http://www.mandrakesoft.com/security/advisories?name=MDKSA-2
hub.com/cyberdudebivash/cyberdudebivash-ai-security-hub/blob/db7b79d6c7c784d1fe9dff4a2c837eeb2235c805/frontend/cve/CVE-2015-4902.html","https://github.com/Ostorlab/KEV/blob/8feadeb8b7ff54359eab87941769781629146b23/README.md","https://github.com/nottrobin/ubuntu-cve-tracker/blob/36e411296b5707284049ec2e0db8d2622feca498/retired/CVE-2015-4902","https://github.com/mabitoski/cve_submodules/blob/44ad7e2705b3aef1b2ffaf64bd47596c10a6c2e4/2015/CVE-2015-4902.md","https://github.com/frknaykc/Dragon-ThreatResearchHQ/blob/60fee7342ce45714e093570c2b43b364e1deecb8/feeds/cves.txt"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":[],"repo_exp_urls":[],"has_poc":false,"has_exp":false,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/2015/AVE-2015-0520.toml"},{"ave_id":"AVE-2015-0058","file_name":"2015/AVE-2015-0058.toml","cve_id":"CVE-2015-7823","title":"Kentico CMS 开放重定向漏洞","description":"Kentico CMS 8.2至8.2.41版本的CMSPages/GetDocLink.ashx页面存在开放重定向漏洞。远程攻击者无需身份认证，通过向link参数传入恶意URL即可将用户重定向至任意外部网站，进而实施钓鱼攻击窃取用户凭证。该漏洞利用方式简单，攻击者可通过邮件或社交工程诱导用户点击特制链接，危害较大。","severity":"MEDIUM","score":5.8,"aliases":["CVE-2015-7823"],"sources":["nuclei"],"published":"2015-10-21T15:59:02Z","updated":"2026-06-17T00:33:12Z","remediation":"升级 Kentico CMS 至 8.2.42 或更高版本，该漏洞已在后续热修复中修复。如无法立即升级，在 Web 服务器（IIS）层面配置 URL 重写规则，对 CMSPages/GetDocLink.ashx 的 link 参数进行白名单校验，仅允许可信域名，防止开放重定向被用于钓鱼攻击。","status":"completed","collected_at":"2026-07-27T00:00:00Z","references":["http://packetstormsecurity.com/files/133981/Kentico-CMS-8.2-Cross-Site-Scripting-Open-Redirect.html","https://github.com/projectdiscovery/nuclei-templates/blob/main/http/cves/2015/CVE-2015-7823.yaml","https://github.com/trickest/cve/blob/e69d88e0152845fc4d4b49970ca6e503f56b2f93/2015/CVE-2015-7823.md","https://github.com/projectdiscovery/nuclei-templates/blob/4ccef9ea7c907d917b1608d60d73b12823bdfdf5/http/cves/2015/CVE-2015-7823.yaml","https://github.com/cckuailong/reapoc/blob/699762e4c31d0183733f64313d8fc3be6470bd37/2015/CVE-2015-7823/poc/pocsploit/CVE-2015-7823.py","https://github.com/lianqingsec/NucleiPocGather/blob/dcce204f62196117b9c95c52d8101ccf7a5d27bc/poc/cve/CVE-2015-7823_1.yaml","https://github.com/exploit-io/nuclei-templates/blob/a4b7182985a6e45df346cfe45242d40455e152b5/templates/cve-2015-7823-2608.yaml","https://github.com/CVEProject/cvelistV5/blob/50b2026c1039c6a81b95d80535c772b9d8685178/cves/2015/7xxx/CVE-2015-7823.json","https://github.com/adampielak/nuclei-templates/blob/a2f3ff3fa5db5c7705ebd942909ec114df063700/nuclei-v3/C/CVE-2015-7823_2.yaml","https://github.com/linuxadi/40k-nuclei-templates/blob/542be6820c801c02a33aee60f1c05ca7b0b5005f/aditya/folder4/cve-2015-7823-2609.yaml","https://github.com/Patrowl/PatrowlHearsData/blob/050b62cac636d83be07e6d4c77e70114e1ca7c93/CVE/data/2015/CVE-2015-7823.json","https://github.com/aboutcode-org/aboutcode-mirror-euvd/blob/6ca409c176d64774782bd4356ed8947593e3b94d/advisories/2022/05/EUVD-2015-7721.json"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":[],"repo_exp_urls":[],"has_poc":false,"has_exp":false,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/2015/AVE-2015-0058.toml"},{"ave_id":"AVE-2015-0050","file_name":"2015/AVE-2015-0050.toml","cve_id":"CVE-2015-6477","title":"Nordex Control 2 SCADA Wind Farm Portal 跨站脚本漏洞","description":"Nordex Control 2 (NC2) SCADA 系统的 Wind Farm Portal 应用存在多处跨站脚本（XSS）漏洞。攻击者可通过向受影响页面注入恶意 Web 脚本或 HTML 代码，当管理员或其他用户访问特制链接时，脚本在浏览器中执行，导致敏感信息泄露或会话劫持。攻击需诱使用户点击恶意链接，无需身份认证。该漏洞影响 NC2 16 及更早版本，CVSS 评分 6.1，危害等级中危。","severity":"MEDIUM","score":6.1,"aliases":["CVE-2015-6477"],"sources":["nuclei"],"published":"2015-10-18T19:59:01Z","updated":"2026-06-17T00:30:56Z","remediation":"联系 Nordex 厂商获取 NC2 SCADA 补丁版本并安排升级；如无有效服务合同，可通过当地 Nordex 服务组织订购补丁。临时缓解措施：将 Wind Farm Portal 应用置于防火墙后，禁止从互联网直接访问，隔离 SCADA 网络与办公网络，远程访问必须通过 VPN 加密通道。同时对所有用户输入实施严格的输出编码和过滤，防止 XSS 注入。","status":"completed","collected_at":"2026-07-27T00:00:00Z","references":["http://packetstormsecurity.com/files/135068/Nordex-Control-2-NC2-SCADA-16-Cross-Site-Scripting.html","http://seclists.org/fulldisclosure/2015/Dec/117","https://ics-cert.us-cert.gov/advisories/ICSA-15-286-01","https://github.com/projectdiscovery/nuclei-templates/blob/main/http/cves/2015/CVE-2015-6477.yaml","https://github.com/trickest/cve/blob/e69d88e0152845fc4d4b49970ca6e503f56b2f93/2015/CVE-2015-6477.md","https://github.com/projectdiscovery/nuclei-templates/blob/f0b5f4bdc45a495b4184bd2ebc02bf95dd4ebcf7/http/cves/2015/CVE-2015-6477.yaml","https://github.com/cckuailong/reapoc/blob/699762e4c31d0183733f64313d8fc3be6470bd37/2015/CVE-2015-6477/poc/pocsploit/CVE-2015-6477.py","https://github.com/adampielak/nuclei-templates/blob/a2f3ff3fa5db5c7705ebd942909ec114df063700/nuclei-v2/C/CVE-2015-6477-2578.yaml","https://github.com/hack007x/veil_poc/blob/5cfe1da6e975ba816d728597885a5c5e79bda8bd/cves/2015/CVE-2015-6477.poc","https://github.com/RogoLabs/consensus-engine/blob/dcd526fb689714d5f3e3864d909b86e28c091c65/docs/data/2015/CVE-2015-6477.json","https://github.com/ExpLangcn/NucleiTP/blob/2b7ecb9031a6eda4f272793045f29b339d8e0cce/CVES/medium/cve-2015-6477-2578.yaml","https://github.com/KTZgraph/sarenka/blob/f1fb931ab722d6c096d581ed6e3c5966d799fbaa/sarenka/feeds/cve_details/cve_all_details_85600_85700.json","https://github.com/chessredoffsec/nuclei-templates/blob/bf798045b1c57839b4998bf6e08c74fbfd076879/http/cves/2015/CVE-2015-6477.yaml","https://github.com/amad3us47/amad3us47.github.io/blob/038bbc4e769d48f20238029d708287b68d5d159f/data/cve-2015-6477-2576.yaml"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":["https://raw.githubusercontent.com/adysec/AVE/main/pocs/2015/POC-AVE-2015-0050.toml"],"repo_exp_urls":["https://raw.githubusercontent.com/adysec/AVE/main/exploits/2015/EXP-AVE-2015-0050.toml"],"has_poc":true,"has_exp":true,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/2015/AVE-2015-0050.toml"},{"ave_id":"AVE-2015-0056","file_name":"2015/AVE-2015-0056.toml","cve_id":"CVE-2015-7377","title":"WordPress Pie Register 插件跨站脚本漏洞","description":"Pie Register WordPress 插件 2.0.18 及之前版本中的 pie-register.php 文件存在反射型跨站脚本（XSS）漏洞。远程攻击者无需身份认证，通过向 pie-register 页面的默认 URI 中构造恶意的 invitaion_code 参数，即可注入任意 Web 脚本或 HTML 代码。当管理员或其他用户访问该恶意链接时，脚本将在浏览器中执行，可能导致会话劫持、钓鱼攻击或敏感信息泄露。该漏洞影响所有使用 Pie Register 插件的 WordPress 站点，CVSS 评分 4.3，危害等级中危。建议升级至 2.0.19 或更高版本修复。","severity":"MEDIUM","score":4.3,"aliases":["CVE-2015-7377"],"sources":["nuclei"],"published":"2015-10-16T20:59:14Z","updated":"2026-06-17T00:32:20Z","remediation":"立即将 Pie Register 插件升级至 2.0.19 或更高版本。在 WordPress 后台插件管理页面搜索 Pie Register 并点击更新，或从 https://wordpress.org/plugins/pie-register/ 下载最新版本手动安装。如无法立即更新，可在服务器 WAF 层添加规则过滤 invitaion_code 参数中的 HTML 标签字符作为临时缓解措施。","status":"completed","collected_at":"2026-07-27T00:00:00Z","references":["http://packetstormsecurity.com/files/133928/WordPress-Pie-Register-2.0.18-Cross-Site-Scripting.html","http://www.securityfocus.com/archive/1/536668/100/0/threaded","https://github.com/GTSolutions/Pie-Register/blob/2.0.19/readme.txt","https://wpvulndb.com/vulnerabilities/8212","https://github.com/projectdiscovery/nuclei-templates/blob/main/http/cves/2015/CVE-2015-7377.yaml","https://github.com/trickest/cve/blob/e69d88e0152845fc4d4b49970ca6e503f56b2f93/2015/CVE-2015-7377.md","https://github.com/projectdiscovery/nuclei-templates/blob/4ccef9ea7c907d917b1608d60d73b12823bdfdf5/http/cves/2015/CVE-2015-7377.yaml","https://github.com/cckuailong/reapoc/blob/699762e4c31d0183733f64313d8fc3be6470bd37/2015/CVE-2015-7377/poc/pocsploit/CVE-2015-7377.py","https://github.com/linuxadi/40k-nuclei-templates/blob/542be6820c801c02a33aee60f1c05ca7b0b5005f/aditya/folder3/cve-2015-7377-2592.yaml","https://github.com/0xKayala/Custom-Nuclei-Templates/blob/1940dfd29577590f076c89dec5c30d809d68f210/7001-to-8000-templates/cve-2015-7377-2595.yaml","https://github.com/rix4uni/nucleihub-templates/blob/579a0234551b9e0e322460a62dc77bd6109e4aff/nucleihub-templates/CVE-2015-7377_5.yaml","https://github.com/fkie-cad/nvd-json-data-feeds/blob/4b74680d5a0e543abc5d2cd403e55944096555a8/CVE-2015/CVE-2015-73xx/CVE-2015-7377.json","https://github.com/u21h2/nacs/blob/1eaa239ded7496317a47073605c8ddda70686ef5/web/poc/pocs_dev/nucleibak/cves/2015/CVE-2015-7377.yaml","https://github.com/lucacapacci/pocs/blob/fc0f46b0c022ab3645a696682e4a25138498f60d/data_single/2015/CVE-2015-7377.json","https://github.com/itsmenaga/Nuclei-Templates-All/blob/7e93c24e44969db15f4072e1c6a322a026452d6b/Vulnerability-Templates/cve-2015-7377-2593.yaml"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":[],"repo_exp_urls":[],"has_poc":false,"has_exp":false,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/2015/AVE-2015-0056.toml"},{"ave_id":"AVE-2015-0686","file_name":"2015/AVE-2015-0686.toml","cve_id":"CVE-2015-7645","title":"Adobe Flash Player 远程代码执行漏洞","description":"Adobe Flash Player 的 AVM 序列化器（AvmSerializer.cpp）在处理实现 IExternalizable 接口的类时存在类型混淆漏洞。当 IExternalizable.writeExternal 方法被非函数值覆盖时，Flash Player 仍将其当作函数调用，导致方法在 ActionScript vtable 之外执行，引发内存损坏，最终可实现任意代码执行。该漏洞影响 Adobe Flash Player 18.x 至 18.0.0.252、19.x 至 19.0.0.207（Windows 和 macOS）以及 11.x 至 11.2.202.535（Linux）版本。攻击条件为受害者打开含恶意 SWF 文件的网页，无需身份认证，攻击者可通过恶意网页、电子邮件或社工手段诱使目标在浏览器或 Flash Player 中加载特制 SWF 文件即可触发。该漏洞于 2015 年 10 月已被在野利用，攻击者构造特制的 SWF 文件，利用 writeExternal 的类型混淆机制覆盖方法为变量，从而触发内存损坏并执行任意代码。Adobe 已在安全公告 APSB15-27 中发布更新版本修复此漏洞，建议用户升级至最新版 Flash Player。","severity":"HIGH","score":7.8,"aliases":["CVE-2015-7645"],"sources":["kev"],"published":"2015-10-15T10:59:10Z","updated":"2026-06-17T00:32:53Z","remediation":"建议立即卸载 Adobe Flash Player（Adobe 已于 2020 年 12 月 31 日停止支持），从控制面板或使用官方卸载工具彻底移除，以根除攻击面。如业务必须使用，请升级至安全公告 APSB15-27 中的修复版本（Flash Player 19.0.0.245 或更高），并在所有浏览器中将 Flash 插件设为\"点击运行\"或彻底禁用，同时限制用户访问不可信网站及打开可疑 SWF 文件。","status":"completed","collected_at":"2026-07-24T00:00:00Z","references":["http://blog.trendmicro.com/trendlabs-security-intelligence/new-adobe-flash-zero-day-used-in-pawn-storm-campaign/","http://lists.opensuse.org/opensuse-security-announce/2015-10/msg00015.html","http://lists.opensuse.org/opensuse-security-announce/2015-10/msg00016.html","http://lists.opensuse.org/opensuse-security-announce/2015-10/msg00017.html","http://lists.opensuse.org/opensuse-security-announce/2015-10/msg00018.html","http://packetstormsecurity.com/files/134009/Adobe-Flash-IExternalizable.writeExternal-Type-Confusion.html","http://rhn.redhat.com/errata/RHSA-2015-1913.html","http://rhn.redhat.com/errata/RHSA-2015-2024.html","http://www.securityfocus.com/bid/77081","http://www.securitytracker.com/id/1033850","https://helpx.adobe.com/security/products/flash-player/apsa15-05.html","https://helpx.adobe.com/security/products/flash-player/apsb15-27.html","https://security.gentoo.org/glsa/201511-02","https://www.exploit-db.com/exploits/38490/","https://www.cisa.gov/known-exploited-vulnerabilities-catalog?field_cve=CVE-2015-7645","https://www.exploit-db.com/exploits/38490","https://github.com/trickest/cve/blob/d4b28c21b943332687c38515600e40190ff00a4e/2015/CVE-2015-7645.md","https://github.com/cisagov/vulnrichment/blob/2ec755a8842ea85cee0159a0fa44132731ba801f/2015/7xxx/CVE-2015-7645.json","https://github.com/LiuCan01/cve-list-pro/blob/78b55511cee3604c22d518e32822f0435d0cacc0/cve-list/CVE-2015/CVE-2015-7645","https://github.com/irsdl/top10webseclist/blob/6f669896be0e6634f335cdeb80bf91c986e0e552/2015.md","https://github.com/thdusdl1219/CVE-Study/blob/6bc0a2f8bf5ddd6089bc9ce22188a24c1d44d24e/CVEs/CVE-2015-7645/README.md","https://github.com/cyberdudebivash/cyberdudebivash-ai-security-hub/blob/18f8914e401b3086d2483ccc3fd79a5028186684/frontend/cve/CVE-2015-7645.html","https://github.com/Patrowl/PatrowlHearsData/blob/73a8b58807bbd8e2a24b27e9365e9527f4708b8f/SSVC/data/2015/CVE-2015-7645.json","https://github.com/Ebiquity/CASIE/blob/2c8beef56d48e8de6599891c6a5e0e5f0d82e20c/data/source/120.txt","https://github.com/nottrobin/ubuntu-cve-tracker/blob/36e411296b5707284049ec2e0db8d2622feca498/retired/CVE-2015-7645","https://github.com/eyalmazuz/ThreatIntelligenceCorpus/blob/c47f9d2b7ba92e0cbba71c67b938a49e055c5cdc/Corpus/115073.txt"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":[],"repo_exp_urls":[],"has_poc":false,"has_exp":false,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/2015/AVE-2015-0686.toml"},{"ave_id":"AVE-2015-0052","file_name":"2015/AVE-2015-0052.toml","cve_id":"CVE-2015-6920","title":"WordPress sourceAFRICA 插件 0.1.3 跨站脚本漏洞","description":"WordPress 的 sourceAFRICA 插件 0.1.3 版本中 `js/window.php` 文件存在反射型跨站脚本漏洞（CWE-79）。远程攻击者无需认证即可通过向 `wpbase` 参数注入恶意 Web 脚本或 HTML 代码，当管理员或用户访问特制 URL 时恶意脚本将在浏览器中执行，可能导致敏感信息泄露或会话劫持。攻击需诱使用户点击恶意链接，CVSS 评分 4.3，危害等级中危。","severity":"MEDIUM","score":4.3,"aliases":["CVE-2015-6920"],"sources":["nuclei"],"published":"2015-09-11T20:59:02Z","updated":"2026-06-17T00:31:35Z","remediation":"立即在 WordPress 后台停用并卸载 sourceAFRICA 插件 0.1.3 版本，该插件已长期未维护且无安全更新。如仍需音频嵌入功能，建议替换为 SoundCloud 官方插件或其他活跃维护的替代方案。若无法立即卸载，在服务器端 WAF（如 ModSecurity）中添加规则拦截 `js/window.php?wpbase=` 请求中的 `<script>`、`<img>` 等 HTML 标签及 `onerror`、`onload` 等事件处理器，或通过 WordPress 函数 `esc_url()` 对 `wpbase` 参数进行输出转义处理。","status":"completed","collected_at":"2026-07-27T00:00:00Z","references":["http://packetstormsecurity.com/files/133371/WordPress-sourceAFRICA-0.1.3-Cross-Site-Scripting.html","https://wpvulndb.com/vulnerabilities/8169","https://github.com/projectdiscovery/nuclei-templates/blob/main/http/cves/2015/CVE-2015-6920.yaml","https://github.com/trickest/cve/blob/e69d88e0152845fc4d4b49970ca6e503f56b2f93/2015/CVE-2015-6920.md","https://github.com/projectdiscovery/nuclei-templates/blob/f0b5f4bdc45a495b4184bd2ebc02bf95dd4ebcf7/http/cves/2015/CVE-2015-6920.yaml","https://github.com/cckuailong/reapoc/blob/699762e4c31d0183733f64313d8fc3be6470bd37/2015/CVE-2015-6920/poc/pocsploit/CVE-2015-6920.py","https://github.com/linuxadi/40k-nuclei-templates/blob/542be6820c801c02a33aee60f1c05ca7b0b5005f/aditya/folder4/cve-2015-6920-2584.yaml","https://github.com/0xKayala/Custom-Nuclei-Templates/blob/1940dfd29577590f076c89dec5c30d809d68f210/7001-to-8000-templates/cve-2015-6920-2582.yaml","https://github.com/u21h2/nacs/blob/1eaa239ded7496317a47073605c8ddda70686ef5/web/poc/pocs/nuclei/cves/2015/CVE-2015-6920.yaml","https://github.com/adampielak/nuclei-templates/blob/a2f3ff3fa5db5c7705ebd942909ec114df063700/nuclei-v3/C/CVE-2015-6920-e01c7e66a6d75c6edd319fd0290446c1.yaml","https://github.com/sepehrdaddev/zap-scripts/blob/2b63b02ca79cc7f0023cdbab72c5c6c774354b07/active/CVE-2015-6920.js","https://github.com/0xAwali/Virtual-Host/blob/a2988987751a6ab1f30d71e0d002b7af148c5c79/Templates/CVE/CVE-2015-6920.yaml","https://github.com/coreruleset/seaweed-reports/blob/3e2a1bd3dbca1b431f18ed0dabb71fa729d4d059/2023/Mar/19/Reports/xssReport.csv"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":[],"repo_exp_urls":[],"has_poc":false,"has_exp":false,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/2015/AVE-2015-0052.toml"}]
[{"ave_id":"AVE-2025-0880","file_name":"2025/AVE-2025-0880.toml","cve_id":"CVE-2025-21420","title":"Microsoft Windows 磁盘清理工具特权提升漏洞","description":"[id]\nave_id = \"AVE-2025-21420\"\naliases = [\"CVE-2025-21420\"]\n\n[basic]\ntitle = \"Windows 磁盘清理工具特权提升漏洞\"\ndescription = \"Windows 磁盘清理工具 (cleanmgr.exe) 存在 DLL 劫持漏洞 (CWE-59)，攻击者可在特定系统目录放置恶意 DLL，诱导高权限用户或系统进程运行磁盘清理工具时加载该 DLL，从而实现权限提升至 SYSTEM 级别。攻击者需具备本地低权限访问，无需用户交互即可触发。\"\nseverity = \"HIGH\"\nscore = 7.8\nsources = [\"cve\", \"msrc\", \"github\"]\npublished = \"2025-02-11\"\nupdated = \"2025-02-11\"\nremediation = \"安装 Microsoft 2025 年 2 月安全更新 (KB5051974)，升级至不受影响的 Windows 版本。临时缓解措施包括限制普通用户对系统目录的写入权限，并监控 cleanmgr.exe 的异常 DLL 加载行为。\"\n\n[references]\nurls = [\"https://msrc.microsoft.com/update-guide/vulnerability/CVE-2025-21420\", \"https://nvd.nist.gov/vuln/detail/CVE-2025-21420\", \"https://github.com/Dmitri131313/CVE-2025-21420-PoC\"]\n\n[exploit]\npoc_urls = [\"https://github.com/Dmitri131313/CVE-2025-21420-PoC\"]\nexp_urls = []\n\n[meta]\nstatus = \"completed\"\ncollected_at = \"2026-08-06T00:00:00Z\"\n\n[info]\nid = \"POC-AVE-2025-21420\"\nname = \"CVE-2025-21420 PoC\"\nauthor = \"AVE\"\nseverity = \"high\"\ntags = [\"cve-2025-21420\", \"windows\", \"privilege-escalation\", \"dll-sideloading\"]\ndescription = \"检测 Windows 磁盘清理工具 cleanmgr.exe 是否存在 DLL 劫持漏洞，通过验证系统版本是否在受影响范围内判断漏洞存在\"\nvuln_id = [\"CVE-2025-21420\", \"AVE-2025-21420\"]\n\n[poc]\nlogic = \"any\"\n\n[[poc.requests]]\nprotocol = \"file\"\npath = \"C:\\\\Windows\\\\System32\\\\cleanmgr.exe\"\n\n[[poc.requests.matchers]]\ntype = \"word\"\nwords = [\"cleanmgr\"]\nexpect = true\n","severity":"HIGH","score":7.8,"aliases":["CVE-2025-21420"],"sources":["msrc"],"published":"2025-02-11T18:15:40Z","updated":"2026-06-17T08:43:20Z","remediation":"[id]\nave_id = \"AVE-2025-21420\"\naliases = [\"CVE-2025-21420\"]\n\n[basic]\ntitle = \"Windows 磁盘清理工具特权提升漏洞\"\ndescription = \"Windows 磁盘清理工具 (cleanmgr.exe) 存在 DLL 侧加载漏洞。低权限攻击者可将恶意 DLL 放置在 cleanmgr.exe 搜索路径中的可写目录（如 C:\\\\Users\\\\<username>\\\\System32\\\\System32\\\\System32\\\\dokannp1.dll），当系统或管理员触发 cleanmgr.exe 时，该 DLL 被加载并以 cleanmgr.exe 进程权限执行任意代码，从而实现权限提升至 SYSTEM。攻击需要本地访问权限，无需用户交互。\"\nseverity = \"HIGH\"\nscore = 7.8\nsources = [\"cve\", \"msrc\", \"tenable\", \"github\"]\npublished = \"2025-02-11\"\nupdated = \"2025-02-11\"\nremediation = \"安装 Microsoft 2025 年 2 月安全更新 (KB5051974)，更新至 Windows 10/11 及 Windows Server 的最新安全版本，限制低权限用户对系统目录的写入权限。\"\n\n[references]\nurls = [\"https://nvd.nist.gov/vuln/detail/CVE-2025-21420\", \"https://msrc.microsoft.com/update-guide/vulnerability/CVE-2025-21420\", \"https://github.com/Dmitri131313/CVE-2025-21420-PoC\", \"https://github.com/trickest/cve/blob/15eaa178baaf955987a866a2c9d91dc02a2fb4aa/2025/CVE-2025-21420.md\"]\n\n[exploit]\npoc_urls = [\"https://github.com/Dmitri131313/CVE-2025-21420-PoC\"]\nexp_urls = []\n\n[meta]\nstatus = \"completed\"\ncollected_at = \"2025-02-11T18:15:40Z\"\n","status":"completed","collected_at":"2026-08-05T00:00:00Z","references":["https://msrc.microsoft.com/update-guide/vulnerability/CVE-2025-21420","https://github.com/Dmitri131313/CVE-2025-21420-PoC","https://github.com/trickest/cve/blob/15eaa178baaf955987a866a2c9d91dc02a2fb4aa/2025/CVE-2025-21420.md","https://github.com/0xMarcio/cve/blob/1a583c77a151b9c5f4534bb6fe376ed9456e38c3/2025/CVE-2025-21420.md","https://github.com/nomi-sec/PoC-in-GitHub/blob/15bf95c7b4616c8551a2bd666d40a8a1a07282d6/2025/CVE-2025-21420.json","https://github.com/MzHmO/Exploit-Street/blob/2ab66b966b8ab7a11c5dc1e4015620f222886f9a/2025/CVE-2025-21420/links.txt","https://github.com/arschlochnop/VulnWatchdog/blob/cc5d6bb14ee44fe6899a66509a45981e4f045448/data/by-cve/CVE-2025-21420.md","https://github.com/sari3l/Poc-Monitor/blob/086426bef313267803353e4e1e756713fe1da650/2025/CVE-2025-21420.json","https://github.com/arschlochnop/VulnWatchdog/blob/cc5d6bb14ee44fe6899a66509a45981e4f045448/data/2025/CVE-2025-21420-toxy4ny_edge-maradeur.md","https://github.com/CVEProject/cvelistV5/blob/0b2099d0f1ceb94625ab1ba6dca5a48307538ab8/cves/2025/21xxx/CVE-2025-21420.json","https://github.com/arschlochnop/VulnWatchdog/blob/cc5d6bb14ee44fe6899a66509a45981e4f045448/data/2025/CVE-2025-21420-moiz-2x_CVE-2025-21420_POC.md","https://github.com/arschlochnop/VulnWatchdog/blob/cc5d6bb14ee44fe6899a66509a45981e4f045448/data/2025/CVE-2025-21420-Network-Sec_CVE-2025-21420-PoC.md","https://github.com/moiz-2x/CVE-2025-21420_POC"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":[],"repo_exp_urls":[],"has_poc":false,"has_exp":false,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/2025/AVE-2025-0880.toml"},{"ave_id":"AVE-2025-0879","file_name":"2025/AVE-2025-0879.toml","cve_id":"CVE-2025-21419","title":"Microsoft Windows 安装程序文件清理特权提升漏洞","description":"Windows 安装程序文件清理组件存在 Improper Link Resolution Before File Access（链接跟随）漏洞。本地攻击者在获得低权限后，可通过创建特制的符号链接，诱导系统安装程序文件清理进程以更高权限访问恶意目标文件，从而导致权限提升。该漏洞影响 Windows 10/11 及 Windows Server 2008 R2 至 2025 等多个版本，CVSS 评分 7.1，危害等级高危。攻击者需具备本地访问权限和低权限用户身份，无法远程利用。Microsoft 已在 2025 年 2 月安全更新（KB5051974）中修复此漏洞。","severity":"HIGH","score":7.1,"aliases":["CVE-2025-21419"],"sources":["msrc"],"published":"2025-02-11T18:15:40Z","updated":"2026-06-17T08:43:19Z","remediation":"立即安装 Microsoft 2025 年 2 月安全更新 (KB5051974)，该更新修复了 Windows Setup Files Cleanup 中的符号链接竞争条件漏洞。受影响版本包括 Windows 10 1507/1607/1809/21H2/22H2、Windows 11 22H2/23H2/24H2 及 Windows Server 2016/2019/2022/2025，对应修复版本号分别为 10.0.10240.20915、10.0.14393.7785、10.0.17763.6893、10.0.19044.5487、10.0.19045.5487、10.0.22621.4890、10.0.22631.4890、10.0.26100.3194、10.0.20348.3207、10.0.25398.1425。可通过 Windows Update 自动获取，或从 Microsoft Update Catalog 手动下载。临时缓解措施：限制低权限用户对系统安装目录的写入权限，并启用 Windows Defender 攻击面减少规则以阻止符号链接提权攻击。","status":"completed","collected_at":"2026-08-05T00:00:00Z","references":["https://msrc.microsoft.com/update-guide/vulnerability/CVE-2025-21419","https://github.com/CVEProject/cvelistV5/blob/0b2099d0f1ceb94625ab1ba6dca5a48307538ab8/cves/2025/21xxx/CVE-2025-21419.json","https://github.com/cisagov/vulnrichment/blob/20c018f1a1b9bca1242ee2249074773858b2a0ac/2025/21xxx/CVE-2025-21419.json","https://github.com/Patrowl/PatrowlHearsData/blob/6604e71750f28c1fc12ae269817332f21f2b9d84/SSVC/data/2025/CVE-2025-21419.json","https://github.com/Patrowl/PatrowlHearsData/blob/6604e71750f28c1fc12ae269817332f21f2b9d84/CVE/data/2025/CVE-2025-21419.json","https://github.com/fankh/vulnerability-poc/blob/d2f211a2392a33dc3802dfba918604d771c8ebf3/2025/CVE-2025-21419/README.md","https://github.com/nomi-sec/NVD-Database/blob/23dc120c34402aaa65883c51c1d03b3cb02c20cb/2025/CVE-2025-21419.json","https://github.com/fankh/vulnerability-poc/blob/d2f211a2392a33dc3802dfba918604d771c8ebf3/2025/CVE-2025-21419/poc.py","https://github.com/olbat/nvdcve/blob/2aff155da1d1b98876d6e9c312b912d434f32dca/nvdcve/CVE-2025-21419.json","https://github.com/opencve/opencve-kb/blob/81a148a05078ecaf8ff30dafcb6a9851540b3434/2025/CVE-2025-21419.json","https://github.com/imSkows/Cyber-Vulnerability-Analysis-Data/blob/db26c44c5f45c25514223a46675daec7eea03092/data/first/CVE-2025-21419"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":[],"repo_exp_urls":[],"has_poc":false,"has_exp":false,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/2025/AVE-2025-0879.toml"},{"ave_id":"AVE-2025-0878","file_name":"2025/AVE-2025-0878.toml","cve_id":"CVE-2025-21418","title":"Microsoft Windows WinSock 辅助功能驱动程序权限提升漏洞","description":"Windows Ancillary Function Driver (AFD) for WinSock 存在堆缓冲区溢出漏洞，该驱动负责处理 Winsock 套接字 I/O 操作。已获得低权限的本地攻击者可利用特制的 IOCTL 调用触发堆缓冲区溢出，成功利用可将权限提升至 SYSTEM 级别，实现完全控制目标系统。该漏洞已被 CISA 列入已知被利用漏洞目录，表明已在野外被积极利用。Microsoft 已在 2025 年 2 月安全更新中修复此漏洞。","severity":"HIGH","score":7.8,"aliases":["CVE-2025-21418"],"sources":["msrc"],"published":"2025-02-11T18:15:40Z","updated":"2026-06-17T08:43:19Z","remediation":"安装 Microsoft 2025 年 2 月安全更新（补丁编号 5051974），升级受影响的 Windows 系统至最新版本。该漏洞已在 afd.sys 驱动中被积极利用，建议立即应用补丁以防止权限提升攻击。","status":"completed","collected_at":"2026-08-05T00:00:00Z","references":["https://msrc.microsoft.com/update-guide/vulnerability/CVE-2025-21418","https://www.cisa.gov/known-exploited-vulnerabilities-catalog?field_cve=CVE-2025-21418","https://github.com/trickest/cve/blob/15eaa178baaf955987a866a2c9d91dc02a2fb4aa/2025/CVE-2025-21418.md","https://github.com/0xMarcio/cve/blob/1a583c77a151b9c5f4534bb6fe376ed9456e38c3/2025/CVE-2025-21418.md","https://github.com/CVEProject/cvelistV5/blob/0b2099d0f1ceb94625ab1ba6dca5a48307538ab8/cves/2025/21xxx/CVE-2025-21418.json","https://github.com/cisagov/vulnrichment/blob/20c018f1a1b9bca1242ee2249074773858b2a0ac/2025/21xxx/CVE-2025-21418.json","https://github.com/Patrowl/PatrowlHearsData/blob/6604e71750f28c1fc12ae269817332f21f2b9d84/CVE/data/2025/CVE-2025-21418.json","https://github.com/Patrowl/PatrowlHearsData/blob/6604e71750f28c1fc12ae269817332f21f2b9d84/SSVC/data/2025/CVE-2025-21418.json","https://github.com/splintersfury/KernelSight/blob/c4101ef9174b083b99cf79d99e0c61308bb26f06/docs/case-studies/CVE-2025-21418.md","https://github.com/gelusus/wxvl/blob/96c1e5030cd59d2e06d8a9c9959ff981a1b632c6/doc/2025-02/【安全圈】Microsoft补丁积极利用零时缺陷-CVE-2025-21418 & CVE-2025-21391.md","https://github.com/nailara-technologies/protocol-7/blob/355cb847bc4d33c37a7ff6bd602777a6d36f0eed/data/protocols/cisa/CVE-2025-21418","https://github.com/mabitoski/cve_submodules/blob/44ad7e2705b3aef1b2ffaf64bd47596c10a6c2e4/2025/CVE-2025-21418.md"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":[],"repo_exp_urls":[],"has_poc":false,"has_exp":false,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/2025/AVE-2025-0878.toml"},{"ave_id":"AVE-2025-0874","file_name":"2025/AVE-2025-0874.toml","cve_id":"CVE-2025-21414","title":"Microsoft Windows Core Messaging 特权提升漏洞","description":"Windows Core Messaging 组件存在堆缓冲区溢出漏洞（CWE-122），已获得低权限的本地攻击者可通过特制系统调用触发该漏洞，利用堆内存损坏实现权限提升至 SYSTEM 级别。该漏洞攻击复杂度较高，但成功利用后可完全控制目标系统，影响机密性、完整性和可用性。Microsoft 已在 2025 年 2 月安全更新（KB5051974）中修复此漏洞。","severity":"HIGH","score":7.0,"aliases":["CVE-2025-21414"],"sources":["msrc"],"published":"2025-02-11T18:15:39Z","updated":"2026-06-17T08:43:18Z","remediation":"立即安装 Microsoft 2025 年 2 月安全更新 (KB5051974)，可通过 Windows Update 自动获取或从 Microsoft Update Catalog 手动下载。该更新修复了 Windows Core Messaging 组件的堆缓冲区溢出漏洞 (CWE-122)。如无法立即安装补丁，可限制低权限用户对 Core Messaging 接口的访问作为临时缓解措施。","status":"completed","collected_at":"2026-08-05T00:00:00Z","references":["https://msrc.microsoft.com/update-guide/vulnerability/CVE-2025-21414","https://github.com/CVEProject/cvelistV5/blob/8798e9cd5ef72b150fb2d268c425b46a0c6a1408/cves/2025/21xxx/CVE-2025-21414.json","https://github.com/cisagov/vulnrichment/blob/4683223ae150496144b181156e51d2b32e6b15f8/2025/21xxx/CVE-2025-21414.json","https://github.com/Patrowl/PatrowlHearsData/blob/a8ca4b37f0ada74ec6b08db2309dab894440907e/SSVC/data/2025/CVE-2025-21414.json","https://github.com/Patrowl/PatrowlHearsData/blob/a8ca4b37f0ada74ec6b08db2309dab894440907e/CVE/data/2025/CVE-2025-21414.json","https://github.com/nomi-sec/NVD-Database/blob/23dc120c34402aaa65883c51c1d03b3cb02c20cb/2025/CVE-2025-21414.json","https://github.com/fankh/vulnerability-poc/blob/d2f211a2392a33dc3802dfba918604d771c8ebf3/2025/CVE-2025-21414/README.md","https://github.com/olbat/nvdcve/blob/2aff155da1d1b98876d6e9c312b912d434f32dca/nvdcve/CVE-2025-21414.json","https://github.com/fankh/vulnerability-poc/blob/d2f211a2392a33dc3802dfba918604d771c8ebf3/2025/CVE-2025-21414/poc.py","https://github.com/opencve/opencve-kb/blob/7f15ca12380fc765fd5195387509666c3b113208/2025/CVE-2025-21414.json","https://github.com/fkie-cad/nvd-json-data-feeds/blob/2045bff4b424e5738e99702781803fdc8b55ff87/CVE-2025/CVE-2025-214xx/CVE-2025-21414.json"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":[],"repo_exp_urls":[],"has_poc":false,"has_exp":false,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/2025/AVE-2025-0874.toml"},{"ave_id":"AVE-2025-0871","file_name":"2025/AVE-2025-0871.toml","cve_id":"CVE-2025-21410","title":"Microsoft Windows 路由和远程访问服务 (RRAS) 远程代码执行漏洞","description":"Windows Routing and Remote Access Service (RRAS) 存在堆缓冲区溢出漏洞，远程攻击者可通过向目标系统的 RRAS 服务发送特制请求触发该漏洞，成功利用可在目标系统上以服务进程权限执行任意代码。攻击需要用户交互（如点击恶意链接或打开恶意文件），但无需身份认证，攻击复杂度低。该漏洞影响多个 Windows Server 版本，CVSS 评分 8.8，危害等级高。Microsoft 已在 2025 年 2 月安全更新中修复此漏洞。","severity":"HIGH","score":8.8,"aliases":["CVE-2025-21410"],"sources":["msrc"],"published":"2025-02-11T18:15:39Z","updated":"2026-06-17T08:43:18Z","remediation":"安装 Microsoft 2025 年 2 月安全更新 (KB5051987) 或热补丁 (KB5052105)。受影响版本升级目标：Windows Server 2016 至 10.0.14393.7785 及以上、Server 2019 至 10.0.17763.6893 及以上、Server 2022 至 10.0.20348.3207 及以上、Server 2025 至 10.0.26100.3194 及以上。如无法立即打补丁，建议在防火墙限制对 RRAS 服务的远程访问，并禁用不必要的路由和远程访问功能以降低攻击面。","status":"completed","collected_at":"2026-08-05T00:00:00Z","references":["https://msrc.microsoft.com/update-guide/vulnerability/CVE-2025-21410","https://github.com/CVEProject/cvelistV5/blob/8f86f3866df0d1c5d8aff409ea4847883047cbe6/cves/2025/21xxx/CVE-2025-21410.json","https://github.com/cisagov/vulnrichment/blob/4683223ae150496144b181156e51d2b32e6b15f8/2025/21xxx/CVE-2025-21410.json","https://github.com/Patrowl/PatrowlHearsData/blob/a8ca4b37f0ada74ec6b08db2309dab894440907e/CVE/data/2025/CVE-2025-21410.json","https://github.com/Patrowl/PatrowlHearsData/blob/a8ca4b37f0ada74ec6b08db2309dab894440907e/SSVC/data/2025/CVE-2025-21410.json","https://github.com/nomi-sec/NVD-Database/blob/23dc120c34402aaa65883c51c1d03b3cb02c20cb/2025/CVE-2025-21410.json","https://github.com/fankh/vulnerability-poc/blob/d2f211a2392a33dc3802dfba918604d771c8ebf3/2025/CVE-2025-21410/README.md","https://github.com/olbat/nvdcve/blob/2aff155da1d1b98876d6e9c312b912d434f32dca/nvdcve/CVE-2025-21410.json","https://github.com/opencve/opencve-kb/blob/963310d0117c8de2c6908e6e4a8dba13966a88f4/2025/CVE-2025-21410.json","https://github.com/fankh/vulnerability-poc/blob/d2f211a2392a33dc3802dfba918604d771c8ebf3/2025/CVE-2025-21410/poc.py","https://github.com/fkie-cad/nvd-json-data-feeds/blob/2045bff4b424e5738e99702781803fdc8b55ff87/CVE-2025/CVE-2025-214xx/CVE-2025-21410.json"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":[],"repo_exp_urls":[],"has_poc":false,"has_exp":false,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/2025/AVE-2025-0871.toml"},{"ave_id":"AVE-2025-0868","file_name":"2025/AVE-2025-0868.toml","cve_id":"CVE-2025-21407","title":"Microsoft Windows 电话服务远程代码执行漏洞","description":"Windows 电话服务（Telephony Service）在处理特定远程过程调用（RPC）请求时存在堆缓冲区溢出漏洞（CWE-122）。未经身份认证的远程攻击者可通过向目标系统发送特制的 RPC 报文触发该漏洞，成功利用可在目标系统上以 SYSTEM 权限执行任意代码。攻击复杂度低，但需要用户交互（如诱导用户访问恶意服务器），影响 Windows 10/11 及 Windows Server 多个版本。CVSS 评分 8.8，危害等级高。Microsoft 已在 2025 年 2 月安全更新中修复此漏洞。","severity":"HIGH","score":8.8,"aliases":["CVE-2025-21407"],"sources":["msrc"],"published":"2025-02-11T18:15:39Z","updated":"2026-06-17T08:43:17Z","remediation":"立即安装 Microsoft 2025 年 2 月安全更新 (KB5051987)，或通过 Windows Update 自动获取更新。对于无法立即打补丁的系统，可在组策略中禁用 TAPI 服务 (Telephony) 并限制对 RPC 端口的网络访问作为临时缓解措施。","status":"completed","collected_at":"2026-08-05T00:00:00Z","references":["https://msrc.microsoft.com/update-guide/vulnerability/CVE-2025-21407","https://github.com/CVEProject/cvelistV5/blob/8f86f3866df0d1c5d8aff409ea4847883047cbe6/cves/2025/21xxx/CVE-2025-21407.json","https://github.com/cisagov/vulnrichment/blob/1d36f3e9bfc6430c5bcee0e6bd4df5788a4946f1/2025/21xxx/CVE-2025-21407.json","https://github.com/Patrowl/PatrowlHearsData/blob/eef981a35a6293dd42587dac1f9be4de4ae1256e/SSVC/data/2025/CVE-2025-21407.json","https://github.com/Patrowl/PatrowlHearsData/blob/eef981a35a6293dd42587dac1f9be4de4ae1256e/CVE/data/2025/CVE-2025-21407.json","https://github.com/fankh/vulnerability-poc/blob/d2f211a2392a33dc3802dfba918604d771c8ebf3/2025/CVE-2025-21407/README.md","https://github.com/nomi-sec/NVD-Database/blob/23dc120c34402aaa65883c51c1d03b3cb02c20cb/2025/CVE-2025-21407.json","https://github.com/fankh/vulnerability-poc/blob/d2f211a2392a33dc3802dfba918604d771c8ebf3/2025/CVE-2025-21407/poc.py","https://github.com/olbat/nvdcve/blob/2aff155da1d1b98876d6e9c312b912d434f32dca/nvdcve/CVE-2025-21407.json","https://github.com/opencve/opencve-kb/blob/2f1dc3c74795bf8c2a96508a614db2a7dd079182/2025/CVE-2025-21407.json","https://github.com/imSkows/Cyber-Vulnerability-Analysis-Data/blob/db26c44c5f45c25514223a46675daec7eea03092/data/first/CVE-2025-21407"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":[],"repo_exp_urls":[],"has_poc":false,"has_exp":false,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/2025/AVE-2025-0868.toml"},{"ave_id":"AVE-2025-0867","file_name":"2025/AVE-2025-0867.toml","cve_id":"CVE-2025-21406","title":"Microsoft Windows 电话服务远程代码执行漏洞","description":"Windows Telephony Service（电话服务）存在释放后使用（Use-After-Free）漏洞，远程攻击者可通过诱导用户访问恶意网站或打开特制文件触发该漏洞，导致在目标系统上以服务权限执行任意代码。该漏洞影响多个 Windows 版本，CVSS 评分 8.8，危害等级高。Microsoft 已在 2025 年 2 月安全更新中修复此漏洞，用户需安装更新 KB5051987 或对应版本补丁。","severity":"HIGH","score":8.8,"aliases":["CVE-2025-21406"],"sources":["msrc"],"published":"2025-02-11T18:15:38Z","updated":"2026-06-17T08:43:17Z","remediation":"立即安装 Microsoft 2025 年 2 月安全更新：Windows 10/11 用户安装 KB5051974，Windows Server 用户安装 KB5051987（或热补丁 KB5052105），其他受影响版本安装 KB5052072。可通过 Windows Update 自动获取更新，或从 Microsoft 更新目录网站手动下载。如无法立即打补丁，可在防火墙层面限制 TAPI 服务的网络暴露面，并禁用不必要的电话服务（TapiSrv）以降低攻击面。","status":"completed","collected_at":"2026-08-05T00:00:00Z","references":["https://msrc.microsoft.com/update-guide/vulnerability/CVE-2025-21406","https://github.com/CVEProject/cvelistV5/blob/90ce235668535187d033418a98446c7a08506c82/cves/2025/21xxx/CVE-2025-21406.json","https://github.com/cisagov/vulnrichment/blob/1d36f3e9bfc6430c5bcee0e6bd4df5788a4946f1/2025/21xxx/CVE-2025-21406.json","https://github.com/Patrowl/PatrowlHearsData/blob/eef981a35a6293dd42587dac1f9be4de4ae1256e/SSVC/data/2025/CVE-2025-21406.json","https://github.com/Patrowl/PatrowlHearsData/blob/eef981a35a6293dd42587dac1f9be4de4ae1256e/CVE/data/2025/CVE-2025-21406.json","https://github.com/fankh/vulnerability-poc/blob/d2f211a2392a33dc3802dfba918604d771c8ebf3/2025/CVE-2025-21406/README.md","https://github.com/nomi-sec/NVD-Database/blob/23dc120c34402aaa65883c51c1d03b3cb02c20cb/2025/CVE-2025-21406.json","https://github.com/fankh/vulnerability-poc/blob/d2f211a2392a33dc3802dfba918604d771c8ebf3/2025/CVE-2025-21406/poc.py","https://github.com/olbat/nvdcve/blob/2aff155da1d1b98876d6e9c312b912d434f32dca/nvdcve/CVE-2025-21406.json","https://github.com/opencve/opencve-kb/blob/7ed8df0083f452d49c6e50d6c61a40c3f4b97ff9/2025/CVE-2025-21406.json","https://github.com/imSkows/Cyber-Vulnerability-Analysis-Data/blob/db26c44c5f45c25514223a46675daec7eea03092/data/first/CVE-2025-21406"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":[],"repo_exp_urls":[],"has_poc":false,"has_exp":false,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/2025/AVE-2025-0867.toml"},{"ave_id":"AVE-2025-0861","file_name":"2025/AVE-2025-0861.toml","cve_id":"CVE-2025-21400","title":"Microsoft SharePoint Server 远程执行代码漏洞","description":"Microsoft SharePoint Server 存在授权不当漏洞（CWE-285），低权限认证攻击者可通过向受影响版本的 SharePoint 服务器发送特制请求触发远程代码执行。该漏洞源于 SharePoint 对用户权限的校验不充分，导致低权限用户能够以更高权限执行任意代码。攻击者需先获得 SharePoint 的低权限账户，并诱导高权限用户（如管理员）执行特定操作（如点击恶意链接或打开特制文件），从而在目标服务器上实现完全控制，包括读取、修改和删除数据。该漏洞影响 SharePoint Enterprise Server 2016、SharePoint Server 2019 及 SharePoint Server Subscription Edition。Microsoft 已在 2025 年 2 月安全更新中发布补丁修复此漏洞。","severity":"HIGH","score":8.0,"aliases":["CVE-2025-21400"],"sources":["msrc"],"published":"2025-02-11T18:15:38Z","updated":"2026-06-17T08:43:16Z","remediation":"建议立即安装 Microsoft 2025 年 2 月安全更新，将 SharePoint Enterprise Server 2016 升级至 16.0.5487.1000 及以上版本、SharePoint Server 2019 升级至 16.0.10416.20050 及以上版本、SharePoint Server Subscription Edition 升级至 16.0.17928.20396 及以上版本。如无法立即打补丁，建议限制低权限用户对 SharePoint 站点的访问，并审核所有用户上传内容以防止利用授权不当触发远程代码执行。","status":"completed","collected_at":"2026-08-05T00:00:00Z","references":["https://msrc.microsoft.com/update-guide/vulnerability/CVE-2025-21400","https://github.com/CVEProject/cvelistV5/blob/9c6bb4d80b2633b04c3d95cd11fee4b8b1b012c2/cves/2025/21xxx/CVE-2025-21400.json","https://github.com/cisagov/vulnrichment/blob/1d36f3e9bfc6430c5bcee0e6bd4df5788a4946f1/2025/21xxx/CVE-2025-21400.json","https://github.com/Patrowl/PatrowlHearsData/blob/559ec87f609d31af7a4580139706f217d81d7a2e/CVE/data/2025/CVE-2025-21400.json","https://github.com/Patrowl/PatrowlHearsData/blob/559ec87f609d31af7a4580139706f217d81d7a2e/SSVC/data/2025/CVE-2025-21400.json","https://github.com/nomi-sec/NVD-Database/blob/23dc120c34402aaa65883c51c1d03b3cb02c20cb/2025/CVE-2025-21400.json","https://github.com/olbat/nvdcve/blob/2aff155da1d1b98876d6e9c312b912d434f32dca/nvdcve/CVE-2025-21400.json","https://github.com/fkie-cad/nvd-json-data-feeds/blob/2045bff4b424e5738e99702781803fdc8b55ff87/CVE-2025/CVE-2025-214xx/CVE-2025-21400.json","https://github.com/fankh/vulnerability-poc/blob/d2f211a2392a33dc3802dfba918604d771c8ebf3/2025/CVE-2025-21400/README.md","https://github.com/opencve/opencve-kb/blob/967da9d6d460202310d5ea881594506ef29aa587/2025/CVE-2025-21400.json","https://github.com/fankh/vulnerability-poc/blob/d2f211a2392a33dc3802dfba918604d771c8ebf3/2025/CVE-2025-21400/poc.py"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":[],"repo_exp_urls":[],"has_poc":false,"has_exp":false,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/2025/AVE-2025-0861.toml"},{"ave_id":"AVE-2025-0859","file_name":"2025/AVE-2025-0859.toml","cve_id":"CVE-2025-21397","title":"Microsoft Office 远程代码执行漏洞","description":"Microsoft Office 存在释放后使用（Use-After-Free，CWE-416）漏洞，攻击者可通过诱导用户打开特制的 Office 文件触发该漏洞。成功利用此漏洞的攻击者可在当前用户权限上下文中执行任意代码，获取对受影响系统的完全控制，包括读取、修改或删除数据以及安装恶意程序。该漏洞影响 Microsoft Office 系列产品，CVSS 评分 7.8，危害等级高。Microsoft 已在 2025 年 2 月安全更新中修复此漏洞。","severity":"HIGH","score":7.8,"aliases":["CVE-2025-21397"],"sources":["msrc"],"published":"2025-02-11T18:15:38Z","updated":"2026-06-17T08:43:16Z","remediation":"建议立即安装 Microsoft 2025 年 2 月安全更新，通过 https://aka.ms/OfficeSecurityReleases 获取最新补丁，或通过 Windows Update 自动更新。受影响版本包括 Microsoft 365 Apps for Enterprise、Office LTSC 2021 及 Office LTSC 2024。该漏洞为 Use-After-Free 类型，攻击者需诱导用户打开特制 Office 文件方可利用，临时缓解措施可启用受保护视图（Protected View）并禁用来自不受信任来源的 OLE 对象嵌入。","status":"completed","collected_at":"2026-08-05T00:00:00Z","re
rls":[],"has_poc":false,"has_exp":false,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/2019/AVE-2019-1406.toml"},{"ave_id":"AVE-2019-1668","file_name":"2019/AVE-2019-1668.toml","cve_id":"CVE-2019-8394","title":"ZOHO ManageEngine ServiceDesk Plus 任意文件上传漏洞","description":"ZOHO ManageEngine ServiceDesk Plus（SDP）10.0 build 10012之前版本存在任意文件上传漏洞。具有低权限的远程攻击者可通过登录页面自定义功能上传恶意文件，利用该漏洞可在服务器上写入任意文件，可能导致服务器被完全控制。攻击无需用户交互，攻击复杂度低，仅需低权限即可触发。","severity":"MEDIUM","score":6.5,"aliases":["CVE-2019-8394"],"sources":["kev"],"published":"2019-02-17T04:29:00Z","updated":"2026-06-17T02:41:56Z","remediation":"立即升级 ZOHO ManageEngine ServiceDesk Plus 至 10.0 build 10012 或更高版本，该版本已修复登录页面自定义功能中的任意文件上传漏洞。如无法立即升级，可在 Web 服务器（如 IIS/Apache）层面限制 /custom 目录仅允许上传图片类型文件（如 .jpg/.png/.gif），并禁用该目录的脚本执行权限作为临时缓解措施。","status":"completed","collected_at":"2026-08-03T00:00:00Z","references":["http://www.securityfocus.com/bid/107129","https://www.exploit-db.com/exploits/46413/","https://www.manageengine.com/products/service-desk/readme.html","https://www.cisa.gov/known-exploited-vulnerabilities-catalog?field_cve=CVE-2019-8394","https://www.exploit-db.com/exploits/46413","https://github.com/trickest/cve/blob/7d40e7d94b41c478b4d1a654c7bc3bcf34fa7beb/2019/CVE-2019-8394.md","https://github.com/CVEProject/cvelistV5/blob/1cc9b895b10fb3dcc8a308563cbbcfad083cd221/cves/2019/8xxx/CVE-2019-8394.json","https://github.com/cisagov/vulnrichment/blob/256acfffdec561159f01d27b17d0320e6463101a/2019/8xxx/CVE-2019-8394.json","https://github.com/CVEDB/Poc-Git/blob/0275aeb329b0747c9a1d46160c921eae06095557/2019/CVE-2019-8394.md","https://github.com/Patrowl/PatrowlHearsData/blob/5828423617831cae14862aac31158752df709f44/SSVC/data/2019/CVE-2019-8394.json","https://github.com/Patrowl/PatrowlHearsData/blob/5828423617831cae14862aac31158752df709f44/CVE/data/2019/CVE-2019-8394.json","https://github.com/nomi-sec/NVD-Database/blob/23dc120c34402aaa65883c51c1d03b3cb02c20cb/2019/CVE-2019-8394.json","https://github.com/olbat/nvdcve/blob/fe7f195231342e1e88104679c53c965e9a67ac35/nvdcve/CVE-2019-8394.json","https://github.com/mabitoski/cve_submodules/blob/44ad7e2705b3aef1b2ffaf64bd47596c10a6c2e4/2019/CVE-2019-8394.md","https://github.com/fkie-cad/nvd-json-data-feeds/blob/7c13974e8672408967145db42c357210cb59d951/CVE-2019/CVE-2019-83xx/CVE-2019-8394.json"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":[],"repo_exp_urls":[],"has_poc":false,"has_exp":false,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/2019/AVE-2019-1668.toml"},{"ave_id":"AVE-2019-0806","file_name":"2019/AVE-2019-0806.toml","cve_id":"CVE-2019-1653","title":"思科 Small Business RV320 和 RV325 路由器 访问控制不当信息泄露漏洞","description":"tags.<value>思科 Small Business RV320 和 RV325 双千兆 WAN VPN 路由器的 Web 管理界面存在访问控制不当漏洞，未经身份认证的远程攻击者可通过 HTTP 或 HTTPS 协议连接到受影响设备并请求特定 URL 路径，绕过访问控制获取路由器配置文件或详细诊断信息等敏感数据。该漏洞影响 RV320 和 RV325 系列路由器，CVSS 评分 7.5（高危），思科已发布固件更新修复此漏洞。","severity":"HIGH","score":7.5,"aliases":["CVE-2019-1653"],"sources":["nuclei"],"published":"2019-01-24T16:29:00Z","updated":"2026-06-17T02:28:58Z","remediation":"立即将 Cisco Small Business RV320 和 RV325 路由器的固件升级至 1.4.2.22 或更高版本：登录设备 Web 管理界面，依次进入\"维护\"→\"固件升级\"，上传 Cisco 官方提供的新固件文件并完成重启。如暂时无法升级，应在\"防火墙\"→\"常规设置\"中关闭远程管理功能，仅保留 LAN 侧管理接口访问，以降低未授权信息泄露风险。升级文件可从 Cisco 软件中心或思科技术支持渠道获取。","status":"completed","collected_at":"2026-08-06T00:00:00Z","references":["http://packetstormsecurity.com/files/152260/Cisco-RV320-Unauthenticated-Configuration-Export.html","http://packetstormsecurity.com/files/152261/Cisco-RV320-Unauthenticated-Diagnostic-Data-Retrieval.html","http://packetstormsecurity.com/files/152305/Cisco-RV320-RV325-Unauthenticated-Remote-Code-Execution.html","http://seclists.org/fulldisclosure/2019/Mar/59","http://seclists.org/fulldisclosure/2019/Mar/60","http://www.securityfocus.com/bid/106732","https://badpackets.net/over-9000-cisco-rv320-rv325-routers-vulnerable-to-cve-2019-1653/","https://seclists.org/bugtraq/2019/Mar/53","https://seclists.org/bugtraq/2019/Mar/54","https://threatpost.com/scans-cisco-routers-code-execution/141218/","https://tools.cisco.com/security/center/content/CiscoSecurityAdvisory/cisco-sa-20190123-rv-info","https://www.exploit-db.com/exploits/46262/","https://www.exploit-db.com/exploits/46655/","https://www.youtube.com/watch?v=bx0RQJDlGbY","https://www.zdnet.com/article/hackers-are-going-after-cisco-rv320rv325-routers-using-a-new-exploit/","https://www.cisa.gov/known-exploited-vulnerabilities-catalog?field_cve=CVE-2019-1653","https://www.exploit-db.com/exploits/46262","https://www.exploit-db.com/exploits/47403","https://github.com/projectdiscovery/nuclei-templates/blob/main/http/cves/2019/CVE-2019-1653.yaml","https://github.com/trickest/cve/blob/15eaa178baaf955987a866a2c9d91dc02a2fb4aa/2019/CVE-2019-1653.md","https://github.com/amcai/myscan/blob/c0ed549669ec76cc9fea660554943244cbdd703b/myscan/pocs/perfolder/cisco/pcc_cisco_route_cve-2019-1653_2019.py","https://github.com/cisagov/vulnrichment/blob/76a9c1d3e08b5513880c6f072ae2e14cd09953e6/2019/1xxx/CVE-2019-1653.json","https://github.com/sepehrdaddev/zap-scripts/blob/2b63b02ca79cc7f0023cdbab72c5c6c774354b07/active/CVE-2019-1653.js","https://github.com/trickest/cve/blob/15eaa178baaf955987a866a2c9d91dc02a2fb4aa/2003/CVE-2003-1567.md","https://github.com/sari3l/Poc-Monitor/blob/1b8036f6bf20f17e964eaec9897b470f15ef1f0c/2019/CVE-2019-1653.json","https://github.com/CVEDB/Poc-Git/blob/0275aeb329b0747c9a1d46160c921eae06095557/2019/CVE-2019-1653.md","https://github.com/kaismax/CVE-Poc/blob/6d8c93dabf674cea102713781cc534d577412357/2019/CVE-2019-1653.md","https://github.com/trickest/cve/blob/15eaa178baaf955987a866a2c9d91dc02a2fb4aa/2019/CVE-2019-16538.md","https://github.com/trickest/cve/blob/15eaa178baaf955987a866a2c9d91dc02a2fb4aa/2019/CVE-2019-16535.md","https://github.com/0x27/CiscoRV320Dump","https://github.com/k8gege/CiscoExploit","https://github.com/shaheemirza/CiscoSpill","https://github.com/dubfr33/CVE-2019-1653","https://github.com/ibrahimzx/CVE-2019-1653"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":["https://raw.githubusercontent.com/adysec/AVE/main/pocs/2019/POC-AVE-2019-0806.toml"],"repo_exp_urls":["https://raw.githubusercontent.com/adysec/AVE/main/exploits/2019/EXP-AVE-2019-0806.toml"],"has_poc":true,"has_exp":true,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/2019/AVE-2019-0806.toml"},{"ave_id":"AVE-2019-0800","file_name":"2019/AVE-2019-0800.toml","cve_id":"CVE-2019-1652","title":"Cisco Small Business RV320和RV325 命令注入漏洞","description":"Cisco Small Business RV320 和 RV325 双千兆 WAN VPN 路由器的基于 Web 的管理界面存在输入验证漏洞。该漏洞源于程序对用户提供的输入验证不充分，具有管理员权限的已认证远程攻击者可通过向受影响设备的管理界面发送特制的 HTTP POST 请求，利用该漏洞在底层 Linux shell 中以 root 权限执行任意命令。Cisco 已发布固件更新修复此漏洞。","severity":"HIGH","score":7.2,"aliases":["CVE-2019-1652"],"sources":["kev"],"published":"2019-01-24T15:29:00Z","updated":"2026-06-17T02:28:57Z","remediation":"立即将 Cisco RV320/RV325 固件升级至 1.4.2.22 或更高版本（1.4.2.21 修复不完整，必须升级到 1.4.2.22）。登录设备管理界面，导航至 Administration > Firmware Upgrade，上传从 Cisco.com 下载的最新固件并重启。如无法立即升级，在 Firewall > General 中禁用 Remote Management（远程管理）功能，阻止从 WAN 口访问管理界面，仅保留 LAN 侧管理访问作为临时缓解措施。","status":"completed","collected_at":"2026-08-03T00:00:00Z","references":["http://packetstormsecurity.com/files/152262/Cisco-RV320-Command-Injection.html","http://packetstormsecurity.com/files/152305/Cisco-RV320-RV325-Unauthenticated-Remote-Code-Execution.html","http://seclists.org/fulldisclosure/2019/Mar/61","http://www.securityfocus.com/bid/106728","https://seclists.org/bugtraq/2019/Mar/55","https://tools.cisco.com/security/center/content/CiscoSecurityAdvisory/cisco-sa-20190123-rv-inject","https://www.exploit-db.com/exploits/46243/","https://www.exploit-db.com/exploits/46655/","https://www.cisa.gov/known-exploited-vulnerabilities-catalog?field_cve=CVE-2019-1652","https://www.exploit-db.com/exploits/46243","https://github.com/projectdiscovery/nuclei-templates/blob/main/http/cves/2019/CVE-2019-16525.yaml","https://github.com/trickest/cve/blob/7d40e7d94b41c478b4d1a654c7bc3bcf34fa7beb/2019/CVE-2019-1652.md","https://gi
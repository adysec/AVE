o_exp_urls":[],"has_poc":false,"has_exp":false,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/2012/AVE-2012-0223.toml"},{"ave_id":"AVE-2012-0221","file_name":"2012/AVE-2012-0221.toml","cve_id":"CVE-2012-1957","title":"Mozilla Firefox/Thunderbird/SeaMonkey RSS Feed跨站脚本漏洞","description":"Mozilla Firefox 4.x 至 13.0、Firefox ESR 10.x 至 10.0.6、Thunderbird 5.0 至 13.0、Thunderbird ESR 10.x 至 10.0.6 及 SeaMonkey 至 2.11 版本的解析器工具类在处理 RSS feed 中 description 元素内的 EMBED 元素时存在跨站脚本漏洞。远程攻击者可构造恶意的 RSS feed，诱使用户订阅或访问，当浏览器解析该 feed 时，EMBED 元素中的恶意脚本会在用户浏览器上下文中执行，导致敏感信息泄露、会话劫持等危害。攻击无需用户交互，仅需用户浏览恶意 RSS 内容即可触发。","severity":"MEDIUM","score":4.3,"aliases":["CVE-2012-1957"],"sources":["tenable"],"published":"2012-07-18T10:26:48Z","updated":"2026-06-16T23:40:39Z","remediation":"升级Firefox至14.0及以上版本、Firefox ESR至10.0.6及以上版本、Thunderbird至14.0及以上版本、Thunderbird ESR至10.0.6及以上版本、SeaMonkey至2.11及以上版本。无法立即升级时，可禁用RSS feed订阅功能或配置浏览器禁止自动解析RSS feed中的EMBED元素作为临时缓解措施。各Linux发行版用户可通过系统包管理器安装对应安全更新（如Red Hat RHSA-2012-1088、Ubuntu USN-1509-1/USN-1510-1）。","status":"completed","collected_at":"2026-08-05T00:00:00Z","references":["http://lists.opensuse.org/opensuse-security-announce/2012-07/msg00011.html","http://lists.opensuse.org/opensuse-security-announce/2012-07/msg00012.html","http://lists.opensuse.org/opensuse-security-announce/2012-07/msg00013.html","http://lists.opensuse.org/opensuse-security-announce/2012-07/msg00016.html","http://osvdb.org/84000","http://rhn.redhat.com/errata/RHSA-2012-1088.html","http://secunia.com/advisories/49965","http://secunia.com/advisories/49968","http://secunia.com/advisories/49972","http://secunia.com/advisories/49977","http://secunia.com/advisories/49979","http://secunia.com/advisories/49992","http://secunia.com/advisories/49993","http://secunia.com/advisories/49994","http://www.mozilla.org/security/announce/2012/mfsa2012-47.html","http://www.securityfocus.com/bid/54583","http://www.securitytracker.com/id?1027256","http://www.securitytracker.com/id?1027257","http://www.securitytracker.com/id?1027258","http://www.ubuntu.com/usn/USN-1509-1","http://www.ubuntu.com/usn/USN-1509-2","http://www.ubuntu.com/usn/USN-1510-1","https://bugzilla.mozilla.org/show_bug.cgi?id=750096","https://oval.cisecurity.org/repository/search/definition/oval%3Aorg.mitre.oval%3Adef%3A16844","https://github.com/trickest/cve/blob/15eaa178baaf955987a866a2c9d91dc02a2fb4aa/2012/CVE-2012-1957.md","https://github.com/CVEDB/Poc-Git/blob/0275aeb329b0747c9a1d46160c921eae06095557/2012/CVE-2012-1957.md","https://github.com/CVEProject/cvelistV5/blob/7db8931ea0378982e66f435e269a4ed0e4efb7aa/cves/2012/1xxx/CVE-2012-1957.json","https://github.com/kaismax/CVE-Poc/blob/6d8c93dabf674cea102713781cc534d577412357/2012/CVE-2012-1957.md","https://github.com/LiuCan01/cve-list-pro/blob/78b55511cee3604c22d518e32822f0435d0cacc0/cve-list/CVE-2012/CVE-2012-1957","https://github.com/nottrobin/ubuntu-cve-tracker/blob/36e411296b5707284049ec2e0db8d2622feca498/retired/CVE-2012-1957","https://github.com/kees/ubuntu-cve-tracker/blob/66a43c37da527bc16621fb5548dca8aa1f46e537/retired/CVE-2012-1957","https://github.com/mabitoski/cve_submodules/blob/44ad7e2705b3aef1b2ffaf64bd47596c10a6c2e4/2012/CVE-2012-1957.md","https://github.com/neuvector/vul-source/blob/a424b5e505273e5365b7d0be8eebfa24fc1b2b60/ubuntu-cve-tracker/retired/CVE-2012-1957","https://github.com/Patrowl/PatrowlHearsData/blob/f80eaead111eac7128eaf77e46b372cdbd675cc9/CVE/data/2012/CVE-2012-1957.json"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":[],"repo_exp_urls":[],"has_poc":false,"has_exp":false,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/2012/AVE-2012-0221.toml"},{"ave_id":"AVE-2012-0219","file_name":"2012/AVE-2012-0219.toml","cve_id":"CVE-2012-1955","title":"Mozilla Firefox、SeaMonkey、Thunderbird 地址栏欺骗漏洞","description":"Mozilla Firefox 4.x至13.0、Firefox ESR 10.x至10.0.6、Thunderbird 5.0至13.0、Thunderbird ESR 10.x至10.0.6及SeaMonkey 2.11之前版本中存在地址栏欺骗漏洞。该漏洞源于JavaScript的history.forward和history.back函数在处理浏览器历史导航时未能正确更新地址栏显示内容，远程攻击者可通过构造特制网页诱导用户访问，利用历史记录操作使地址栏显示与当前页面实际URL不一致的虚假地址，从而实施钓鱼攻击或欺骗用户信任恶意网站。攻击需用户交互（如点击链接），CVSS评分6.8，危害等级中危。Mozilla已在Firefox 14.0及相应ESR更新中修复此漏洞。","severity":"MEDIUM","score":6.8,"aliases":["CVE-2012-1955"],"sources":["tenable"],"published":"2012-07-18T10:26:48Z","updated":"2026-06-16T23:40:39Z","remediation":"升级 Mozilla Firefox 至 14.0 及以上版本，Firefox ESR 升级至 10.0.6 及以上版本，Thunderbird 升级至 14.0 及以上版本（ESR 升级至 10.0.6 及以上），SeaMonkey 升级至 2.11 及以上版本。如无法立即升级，可禁用 JavaScript 作为临时缓解措施（在 about:config 中将 javascript.enabled 设为 false）。","status":"completed","collected_at":"2026-08-05T00:00:00Z","references":["http://lists.opensuse.org/opensuse-security-announce/2012-07/msg00011.html","http://lists.opensuse.org/opensuse-security-announce/2012-07/msg00012.html","http://lists.opensuse.org/opensuse-security-announce/2012-07/msg00013.html","http://lists.opensuse.org/opensuse-security-announce/2012-07/msg00016.html","http://osvdb.org/83996","http://rhn.redhat.com/errata/RHSA-2012-1088.html","http://secunia.com/advisories/49965","http://secunia.com/advisories/49968","http://secunia.com/advisories/49972","http://secunia.com/advisories/49977","http://secunia.com/advisories/49979","http://secunia.com/advisories/49992","http://secunia.com/advisories/49993","http://secunia.com/advisories/49994","http://www.mozilla.org/security/announce/2012/mfsa2012-45.html","http://www.securityfocus.com/bid/54586","http://www.securitytracker.com/id?1027256","http://www.securitytracker.com/id?1027257","http://www.securitytracker.com/id?1027258","http://www.ubuntu.com/usn/USN-1509-1","http://www.ubuntu.com/usn/USN-1509-2","http://www.ubuntu.com/usn/USN-1510-1","https://bugzilla.mozilla.org/show_bug.cgi?id=757376","https://oval.cisecurity.org/repository/search/definition/oval%3Aorg.mitre.oval%3Adef%3A17004","https://github.com/trickest/cve/blob/15eaa178baaf955987a866a2c9d91dc02a2fb4aa/2012/CVE-2012-1955.md","https://github.com/CVEDB/Poc-Git/blob/0275aeb329b0747c9a1d46160c921eae06095557/2012/CVE-2012-1955.md","https://github.com/CV
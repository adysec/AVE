thub.com/github/advisory-database/blob/1721417c5dc7c1cbf858e5ea5a5245ea62e70cce/advisories/unreviewed/2022/04/GHSA-3fmx-7555-v8rg/GHSA-3fmx-7555-v8rg.json","https://github.com/rhuitl/uClinux/blob/0486e80a025dccbe4a2213715a2ab8a5063ea86b/user/nessus/nessus-plugins/scripts/solaris26_106592.nasl","https://github.com/feng-li/tools-for-data-science-course/blob/8e62d47ee8ffbebe9a0e50aee193617f83883118/2019spring/2017312271/result.txt","https://github.com/jdkoftinoff/mb-linux-msli/blob/8adb103e34af9ff1d8d122e9ee2a1808836f0a14/uClinux-dist/user/nessus/nessus-plugins/scripts/solaris251_104166.nasl","https://github.com/Freem93/grammar_nasl_v2/blob/63834ebb8cd6e97050e155291c7500ad53bb20c6/plugins/rpc_statd.nasl","https://github.com/intSpLoiT/intframework/blob/eabaa799d0260aa52b735fa9769266d1ce4b64ef/modules/cve_list.txt"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":[],"repo_exp_urls":[],"has_poc":false,"has_exp":false,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/1999/AVE-1999-0171.toml"},{"ave_id":"AVE-1999-1806","file_name":"1999/AVE-1999-1806.toml","cve_id":"CVE-1999-1237","title":"smbvalid SMB 认证库缓冲区溢出远程代码执行漏洞","description":"smbvalid/smbval SMB 认证库存在多处缓冲区溢出漏洞，远程攻击者可通过向受影响的应用程序（如 Apache::AuthenSmb）发送超长的用户名、密码或其他特制输入触发该漏洞，导致任意代码执行。该漏洞影响使用 smbval 库的多个模块，CVSS 评分 10.0，危害等级严重。","severity":"CRITICAL","score":10.0,"aliases":["CVE-1999-1237"],"sources":["epss"],"published":"1999-06-06T04:00:00Z","updated":"2026-06-16T21:50:00Z","remediation":"立即停止使用已无人维护的 Apache::AuthenSmb 模块及 smbvalid/smbval 库，迁移至 mod_authnz_ldap 或 mod_authn_file 等 Apache 官方维护的认证模块替代 SMB 认证功能。如短期内无法替换，须在 Perl 应用层对所有用户输入（用户名、密码等）做严格长度限制，限制用户名不超过 32 字节、密码不超过 128 字节，并使用正则过滤非 ASCII 高危字符，同时将 Apache::AuthenSmb 运行在受限容器或沙箱环境中以降低溢出代码执行风险。","status":"completed","collected_at":"2026-07-20T00:00:00Z","references":["http://www.securityfocus.com/archive/1/14384","https://exchange.xforce.ibmcloud.com/vulnerabilities/2272","https://github.com/CVEProject/cvelistV5/blob/50269681ee58c9b5bf7169b73546eef94697389c/cves/1999
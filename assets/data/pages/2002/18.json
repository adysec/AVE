lob/fe7f195231342e1e88104679c53c965e9a67ac35/nvdcve/CVE-2002-0946.json","https://github.com/brenonevs/prs-pentest/blob/001cf17eedeb4aad73618d3140ca1f5dc93e69b3/CVEs & POCs/2002/CVE-2002-0946.md","https://github.com/opencve/opencve-kb/blob/2adf3d659b2229087465cbedc27cc02d5736df99/2002/CVE-2002-0946.json","https://github.com/fkie-cad/nvd-json-data-feeds/blob/e9b51a58e4ac0e6b00dc38147f459707e98ae056/CVE-2002/CVE-2002-09xx/CVE-2002-0946.json"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":[],"repo_exp_urls":[],"has_poc":false,"has_exp":false,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/2002/AVE-2002-0484.toml"},{"ave_id":"AVE-2002-0483","file_name":"2002/AVE-2002-0483.toml","cve_id":"CVE-2002-0942","title":"Lumigent Log Explorer 扩展存储过程缓冲区溢出漏洞","description":"Lumigent Log Explorer 3.02 之前版本中存在缓冲区溢出漏洞，具有数据库权限的攻击者可通过向扩展存储过程 xp_logattach_StartProf、xp_logattach_setport 或 xp_logattach 传递超长参数触发缓冲区溢出，从而在数据库服务器上以系统权限执行任意代码。该漏洞 CVSS 评分 7.5，危害等级高，攻击复杂度低且无需认证，远程即可利用，影响数据的机密性、完整性和可用性。Exploit-DB 上已有公开的利用代码。","severity":"HIGH","score":7.5,"aliases":["CVE-2002-0942"],"sources":["exploitdb"],"published":"2002-10-04T04:00:00Z","updated":"2026-06-16T21:58:25Z","remediation":"升级 Lumigent Log Explorer 至 3.02 或更高版本，该版本已修复 xp_logattach_StartProf、xp_logattach_setport 和 xp_logattach 三个扩展存储过程中的缓冲区溢出漏洞。如无法升级，应在 SQL Server 中撤销对数据库用户执行上述扩展存储过程的权限，并限制非授权数据库账户的登录访问。","status":"completed","collected_at":"2026-08-03T00:00:00Z","references":["http://archives.neohapsis.com/archives/bugtraq/2002-06/0146.html","http://online.securityfocus.com/archive/1/277026","http://www.iss.net/security_center/static/9346.php","http://www.lumigent.com/LogExplorer/Support/whatsnew3_03.htm","http://www.securityfocus.com/bid/5016","http://www.securityfocus.com/bid/5017","http://www.securityfocus.com/bid/5018","https://www.exploit-db.com/exploits/21550","https://github.com/CVEProject/cvelistV5/blob/a14f4e66db68a75a9270d6c9081e9ffb7f931cd8/cves/2002/0xxx/CVE-2002-0942.json","https://github.com/LiuCan01/cve-list-pro/
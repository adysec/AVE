00:00:00Z","references":["http://archives.neohapsis.com/archives/bugtraq/2000-03/0236.html","http://ftp.gnqs.org/pub/gnqs/source/by-version-number/v3.50/Generic-NQS-3.50.8-ChangeLog.txt","http://www.securityfocus.com/bid/1842","https://exchange.xforce.ibmcloud.com/vulnerabilities/4306","https://github.com/CVEProject/cvelistV5/blob/6b6ab35c79a8cf8624d21f1a20325bab41c1211a/cves/2000/0xxx/CVE-2000-0247.json","https://github.com/LiuCan01/cve-list-pro/blob/78b55511cee3604c22d518e32822f0435d0cacc0/cve-list/CVE-2000/CVE-2000-0247","https://github.com/yarencheng/cve-devops-playground/blob/cbe73d6bdcced13ea57f08566d6bbf5345864f7e/content/CVE-2000-0247.md","https://github.com/Patrowl/PatrowlHearsData/blob/d880529b2028116bddf6c732baf8f599b169f01e/CVE/data/2000/CVE-2000-0247.json","https://github.com/github/advisory-database/blob/a96652a2a06e880f217d1d6526622d8501dbbd69/advisories/unreviewed/2022/05/GHSA-jqmm-w8m7-wfw9/GHSA-jqmm-w8m7-wfw9.json","https://github.com/intSpLoiT/intframework/blob/eabaa799d0260aa52b735fa9769266d1ce4b64ef/modules/cve_list.txt","https://github.com/nomi-sec/NVD-Database/blob/23dc120c34402aaa65883c51c1d03b3cb02c20cb/2000/CVE-2000-0247.json","https://github.com/oasis-open/cti-stix-common-objects/blob/55ba7598cbd5a52577b6887871505d931d85cb61/objects/vulnerability/vulnerability--38bd4543-9cdf-475f-abdd-c9205f728f1f.json","https://github.com/Yuning-J/VulnerabilityClassifier/blob/c0f06c21b73c26b5ee2b75c21a498eb04eada4b5/threatPrediction/cveIDThreatType/cve_idgainpre","https://github.com/hungryfoolou/Vulnerability_Mining/blob/3df1d8ed0489ae1228f975ae1f58a690aae53886/craw/cveid_craw/cveid_craw/data/cveid_by_kind/cveid_gainpre.txt"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":[],"repo_exp_urls":[],"has_poc":false,"has_exp":false,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/2000/AVE-2000-0224.toml"},{"ave_id":"AVE-2000-0205","file_name":"2000/AVE-2000-0205.toml","cve_id":"CVE-2000-0229","title":"gpm gpm-root 本地权限提升漏洞","description":"gpm 软件包中的 gpm-root 组件未能正确释放特权，存在本地权限提升漏洞。本地攻击者可通过 gpm-root 启动系统工具，利用该漏洞获取目标系统的 root 权限。该漏洞影响 gpm 1.18.1/1.19 版本及 Debian 2.x、RedHat 6.x、S.u.S.E 5.3/6.x 等 Linux 发行版，CVSS 评分 7.2，危害等级高。","severity":"HIGH","score":7.2,"aliases":["CVE-2000-0229"],"sources":["redhat"],"published":"2000-03-22T05:00:00Z","updated":"2026-06-16T21:51:16Z","remediation":"立即升级 gpm 至 1.20 或更高版本，该版本已修复 gpm-root 未正确释放特权的问题。如无法升级，可执行 `chmod ug-s /usr/bin/gpm-root` 移除 setgid 位作为临时缓解措施，或直接卸载 gpm 软件包（非必需时）。","status":"completed","collected_at":"2026-07-22T00:00:00Z","references":["http://archives.neohapsis.com/archives/bugtraq/2000-03/0242.html","http://www.novell.com/linux/security/advisories/suse_security_announce_45.html","http://www.redhat.com/support/errata/RHSA-2000-009.html","http://www.redhat.com/support/errata/RHSA-2000-045.html","http://www.securityfocus.com/bid/1069","https://www.exploit-db.com/exploits/19816","https://github.com/CVEProject/cvelistV5/blob/fbc52696b7594c66d398b40fcc0dc269121d7362/cves/2000/0xxx/CVE-2000-0229.json","https://github.com/LiuCan01/cve-list-pro/blob/78b55511cee3604c22d518e32822f0435d0cacc0/cve-list/CVE-2000/CVE-2000-0229","https://github.com/yarencheng/cve-devops-playground/blob/cbe73d6bdcced13ea57f08566d6bbf5345864f7e/content/CVE-2000-0229.md","https://github.com/Patrowl/PatrowlHearsData/blob/6af0515548db3ee9e7e86d58b079762631fa8897/CVE/data/2000/CVE-2000-0229.json","https://github.com/github/advisory-database/blob/e6b10ee602769bd7be4675bf10e3382c1f100e32/advisories/unreviewed/2022/04/GHSA-jj5p-pw57-256v/GHSA-jj5p-pw57-256v.json","https://github.com/intSpLoiT/intframework/blob/eabaa799d0260aa52b735fa9769266d1ce4b64ef/modules/cve_list.txt","https://github.com/blackhook/nessus-plugins/blob/64177d96abbb07c58cf7e131046b067ebc61fcb5/M/mandrake_MDKSA-2000-002.nasl","https://github.com/oasis-open/cti-stix-common-objects/blob/55ba7598cbd5a52577b6887871505d931d85cb61/objects/vulnerability/vulnerability--5941c4d2-c5d3-40b1-8edf-f63ec1d9445b.json","https://github.com/andreafioraldi/ToolsForCyberChallenge/blob/197d3dfd204cf1b9d1af1451455c8831c3ff9948/generated/files_3.list.dict","https://github.com/nomi-sec/NVD-Database/blob/23dc120c34402aaa65883c51c1d03b3cb02c20cb/2000/CVE-2000-0229.json"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":[],"repo_exp_urls":[],"has_poc":false,"has_exp":false,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/2000/AVE-2000-0205.toml"},{"ave_id":"AVE-2000-0219","file_name":"2000/AVE-2000-0219.toml","cve_id":"CVE-2000-0241","title":"vqSoft vqServer 敏感信息泄露漏洞","description":"vqSoft vqServer 存在敏感信息明文存储漏洞，服务器将用户密码等敏感信息以明文形式保存在 server.cfg 配置文件中，本地攻击者可读取该文件获取明文凭证，进而实现权限提升。该漏洞影响 vqServer 相关版本，攻击复杂度低，无需特殊权限即可利用。","severity":"MEDIUM","score":5.0,"aliases":["CVE-2000-0241"],"sources":["avd"],"published":"2000-03-21T05:00:00Z","updated":"2026-06-16T21:51:18Z","remediation":"建议立即升级 vqServer 至厂商发布的最新版本，并检查 server.cfg 文件内容确保密码不以明文方式存储；如厂商已停止维护（vqServer 为早期产品，极可能已 EOL），应迁移至持续安全更新的替代 Web 服务器（如 Apache httpd 或 Nginx）。临时缓解措施：通过文件系统权限将 server.cfg 的读取权限仅限于必要管理员账户，并移除配置文件中所有明文凭据。","status":"completed","collected_at":"2026-07-22T00:00:00Z","references":["http://www.securityfocus.com/bid/1068","http://www.securityfocus.com/templates/archive.pike?list=1&msg=4.1.20000321084646.0095c7f0%40olga.swip.net","https://github.com/CVEProject/cvelistV5/blob/0e6d432d517e5cdf9829125ecfaa3a6437985a0c/cves/2000/0xxx/CVE-2000-0241.json","https://github.com/LiuCan01/cve-list-pro/blob/78b55511cee3604c22d518e32822f0435d0cacc0/cve-list/CVE-2000/CVE-2000-0241","https://github.com/yarencheng/cve-devops-playground/blob/cbe73d6bdcced13ea57f08566d6bbf5345864f7e/content/CVE-2000-0241.md","https://github.com/Patrowl/PatrowlHearsData/blob/6a25a9384d7c18dfb53a1d1532073678a2c29fe5/CVE/data/2000/CVE-2000-0241.json","https://github.com/github/advisory-database/blob/a96652a2a06e880f217d1d6526622d8501dbbd69/advisories/unreviewed/2022/04/GHSA-q9jx-r63x-g7f5/GHSA-q9jx-r63x-g7f5.json","https://github.com/intSpLoiT/intframework/blob/eabaa799d0260aa52b735fa9769266d1ce4b64ef/modules/cve_list.txt","https://github.com/olbat/nvdcve/blob/5b92f5917a4a825187ccaac594f43456a77ea8f3/nvdcve/CVE-2000-0241.json","https://github.com/SpeeDr00t/speedr00t.github.com/blob/0380f0c2190556fabe90257cb6c0034a42f68951/securityfocus/0x2000/1068/info.html","https://github.com/KTZgraph/sarenka/blob/f1fb931ab722d6c096d581ed6e3c5966d799fbaa/sarenka/feeds/cve_details/cve_all_details_152200_152300.json","https://github.com/nomi-sec/NVD-Exploit-List-Ja/blob/b82432e7d59d95db9f183c0cefa7744595784afa/2000.tsv"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":[],"repo_exp_urls":[],"has_poc":false,"has_exp":false,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/2000/AVE-2000-0219.toml"},{"ave_id":"AVE-2000-0218","file_name":"2000/AVE-2000-0218.toml","cve_id":"CVE-2000-0240","title":"vqSoft vqServer for Windows 目录遍历漏洞","description":"vqSoft vqServer for Windows 1.9.9 存在目录遍历漏洞，远程攻击者无需认证即可通过在 URL 中构造特制的 `/./` 路径序列（`..` 点号攻击的变种）绕过访问限制，遍历服务器文件系统并读取任意文件。该漏洞利用方式简单，攻击者可借此获取敏感配置信息或源代码，影响服务器数据机密性。建议升级至更高版本或部署访问控制措施。","severity":"MEDIUM","score":5.0,"aliases":["CVE-2000-0240"],"sources":["cve"],"published":"2000-03-21T00:00:00Z","updated":"2026-06-16T00:00:00Z","remediation":"vqSoft vqServer 1.9.9 for Windows 已达生命周期，厂商不再发布安全补丁。建议立即迁移至其他仍在维护的 Web 服务器（如 Apache HTTP Server、Nginx 或 IIS）。如无法立即替换，可在 Web 服务器前部署反向代理或 WAF，配置规则拦截包含连续 `../` 及 `.//` 等目录遍历特征的 URL 请求，并限制网站进程对系统目录的读取权限。","status":"completed","collected_at":"2026-07-22T00:00:00Z","references":["https://nvd.nist.gov/vuln/detail/CVE-2000-0240","http://www.osvdb.org/270","http://www.securityfocus.com/bid/1067","http://www.securityfocus.com/templates/archive.pike?list=1&msg=4.1.20000321084646.0095c7f0%40olga.swip.net","http://www.vqsoft.com/vq/server/faqs/dotdotbug.html","https://www.exploit-db.com/exploits/19815"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":[],"repo_exp_urls":[],"has_poc":false,"has_exp":false,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/2000/AVE-2000-0218.toml"},{"ave_id":"AVE-2000-0477","file_name":"2000/AVE-2000-0477.toml","cve_id":"CVE-2000-0613","title":"Cisco PIX Firewall TCP伪造RST包安全绕过漏洞","description":"Cisco Secure PIX 防火墙在处理伪造的 TCP 重置（RST）数据包时存在安全验证缺陷，远程攻击者可通过向目标防火墙发送特制的 TCP RST 数据包，伪造合法连接的中断信号，强制防火墙关闭正在进行的正常 TCP 连接，导致拒绝服务。该漏洞影响 PIX Firewall 2.7/3.x/4.x/5.x 版本，攻击无需身份认证，利用难度较低。","severity":"MEDIUM","score":5.0,"aliases":["CVE-2000-0613"],"sources":["avd"],"published":"2000-03-20T05:00:00Z","updated":"2026-06-16T21:52:06Z","remediation":"升级 Cisco PIX 防火墙软件至 5.2(1) 或更高版本，该版本已正确验证 TCP RST 包的序列号，防止伪造的 RST 包中断合法连接。对于已停止支持的旧版本（2.7/3.x/4.x/5.1），建议迁移至受支持的 Cisco 安全设备（如 ASA 系列）并应用最新固件。","status":"completed","collected_at":"2026-07-27T00:00:00Z","references":["http://www.cisco.com/warp/public/707/pixtcpreset-pub.shtml","http://www.osvdb.org/1457","http://www.securityfocus.com/bid/1454","http://www.securityfocus.com/templates/archive.pike?list=1&msg=B3D6883199DBD311868100A0C9FC2CDC046B72%40protea.citec.net","https://exchange.xforce.ibmcloud.com/vulnerabilities/4928","https://www.exploit-db.com/exploits/20067","https://github.com/trickest/cve/blob/be44b05b9428dc18bc0705cf60dd8d8640cd49b1/2000/CVE-2000-0613.md","https://github.com/CVEProject/cvelistV5/blob/49bdd0da7f9ed7eb2c6a7d376de641a46364c00a/cves/2000/0xxx/CVE-2000-0613.json","https://github.com/LiuCan01/cve-list-pro/blob/78b55511cee3604c22d518e32822f0435d0cacc0/cve-list/CVE-2000/CVE-2000-0613","https://github.com/Patrowl/PatrowlHearsData/blob/06bd4bafa29f2b5ddfa107ad565d92d39b9a40e1/CVE/data/2000/CVE-2000-0613.json","https://github.com/mabitoski/cve_submodules/blob/44ad7e2705b3aef1b2ffaf64bd47596c10a6c2e4/2000/CVE-2000-0613.md","https://github.com/github/advisory-database/blob/d91e95989ea5d3a9186ceb621d53a71dff03cab4/advisories/unreviewed/2022/04/GHSA-pxcf-v9c2-vw3r/GHSA-pxcf-v9c2-vw3r.json","https://github.com/intSpLoiT/intframework/blob/eabaa799d0260aa52b735fa9769266d1ce4b64ef/modules/cve_list.txt","https://github.com/nomi-sec/NVD-Database/blob/23dc120c34402aaa65883c51c1d03b3cb02c20cb/2000/CVE-2000-0613.json","https://github.com/HORKimhab/poc-cve-collection/blob/5ea14f17ec38fb7850c23056beec64877fabc5b1/2000/0xxx/CVE-2000-0613.md","https://github.com/leego972/titanai/blob/afa5b2310463aae5781d3fd9408071bf38e79806/data/raw/corpus_D_cyber/nvd_cve_001242.txt"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":[],"repo_exp_urls":[],"has_poc":false,"has_exp":false,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/2000/AVE-2000-0477.toml"}]
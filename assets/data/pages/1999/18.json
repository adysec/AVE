l/PatrowlHearsData/blob/c30cb75c630bd0892c286bac41dd51c65d6a6546/CVE/data/1999/CVE-1999-0832.json","https://github.com/github/advisory-database/blob/1721417c5dc7c1cbf858e5ea5a5245ea62e70cce/advisories/unreviewed/2022/05/GHSA-qp45-m6rw-r6x9/GHSA-qp45-m6rw-r6x9.json","https://github.com/blackhook/nessus-plugins/blob/64177d96abbb07c58cf7e131046b067ebc61fcb5/R/rpc_nfsd.nasl","https://github.com/intSpLoiT/intframework/blob/eabaa799d0260aa52b735fa9769266d1ce4b64ef/modules/cve_list.txt","https://github.com/KTZgraph/sarenka/blob/f1fb931ab722d6c096d581ed6e3c5966d799fbaa/sarenka/feeds/cve_details/cve_all_details_153700_153800.json","https://github.com/debiancn/debian.org/blob/6abc98daa6356b20e410013a6920b3764af682d4/english/security/1999/19991111.data","https://github.com/nomi-sec/NVD-Database/blob/23dc120c34402aaa65883c51c1d03b3cb02c20cb/1999/CVE-1999-0832.json"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":[],"repo_exp_urls":[],"has_poc":false,"has_exp":false,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/1999/AVE-1999-0906.toml"},{"ave_id":"AVE-1999-0796","file_name":"1999/AVE-1999-0796.toml","cve_id":"CVE-1999-0983","title":"Internic Whois Lookup whois.cgi 远程代码执行漏洞","description":"Internic Whois Lookup whois.cgi 命令执行漏洞","severity":"HIGH","score":7.5,"aliases":["CVE-1999-0983"],"sources":["epss"],"published":"1999-11-09T05:00:00Z","updated":"2026-06-16T21:49:27Z","remediation":"立即删除或禁用服务器上存在的 whois.cgi 脚本，该脚本已停止维护且存在命令注入漏洞。如仍需 Whois 查询功能，改用官方维护的 whois 命令行工具（如 jwhois）替代，并在 Web 应用中严格过滤用户输入中的 `;` `|` `&` `$` `` ` `` 等 shell 元字符。","status":"completed","collected_at":"2026-07-19T00:00:00Z","references":["https://exchange.xforce.ibmcloud.com/vulnerabilities/CVE-1999-0983","https://github.com/trickest/cve/blob/638563f1ec085a412c2e42f3935801ae34f0dfd9/1999/CVE-1999-0983.md","https://github.com/CVEProject/cvelistV5/blob/ad08212eac84f46206c2da8a50436d48e5ad608c/cves/1999/0xxx/CVE-1999-0983.json","https://github.com/LiuCan01/cve-list-pro/blob/78b55511cee3604c22d518e32822f043
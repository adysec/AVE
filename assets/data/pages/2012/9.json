json","https://github.com/brenonevs/prs-pentest/blob/001cf17eedeb4aad73618d3140ca1f5dc93e69b3/CVEs & POCs/2012/CVE-2012-1948.md"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":[],"repo_exp_urls":[],"has_poc":false,"has_exp":false,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/2012/AVE-2012-0212.toml"},{"ave_id":"AVE-2012-0195","file_name":"2012/AVE-2012-0195.toml","cve_id":"CVE-2012-1757","title":"Oracle MySQL Server InnoDB 拒绝服务漏洞","description":"Oracle MySQL Server 5.5.23 及之前版本中的 InnoDB 存储引擎存在未指定的安全漏洞，已认证的远程攻击者可通过向 MySQL 服务器发送特制的数据库查询请求，利用 InnoDB 组件中的未知错误触发拒绝服务条件，导致 MySQL 服务进程崩溃或无法响应正常请求。该漏洞影响 MySQL 5.5.x 全系版本，攻击者需拥有数据库有效登录凭据方可利用，CVSS 评分 4.0，危害等级中低。Oracle 已在 2012 年 7 月的关键补丁更新（CPU）中发布 MySQL 5.5.24 修复此问题。","severity":"MEDIUM","score":4.0,"aliases":["CVE-2012-1757"],"sources":["tenable"],"published":"2012-07-17T23:55:02Z","updated":"2026-06-16T23:40:14Z","remediation":"升级 MySQL Server 至 5.5.24 或更高版本。可通过 Oracle 官方 July 2012 Critical Patch Update (My Oracle Support Note 1446033.1) 获取补丁，或从 MySQL 官网下载 5.5.24 及以上版本进行升级。如无法立即升级，可在 my.cnf 中限制 InnoDB 相关参数并严格控制数据库用户权限，仅授予必要的最小权限，降低认证用户利用 InnoDB 组件发动拒绝服务攻击的风险。","status":"completed","collected_at":"2026-08-05T00:00:00Z","references":["http://osvdb.org/83977","http://www.mandriva.com/security/advisories?name=MDVSA-2013:150","http://www.oracle.com/technetwork/topics/security/cpujul2012-392727.html","http://www.securityfocus.com/bid/54526","http://www.securitytracker.com/id?1027263","https://exchange.xforce.ibmcloud.com/vulnerabilities/77062","https://github.com/trickest/cve/blob/0950a261126c1029f51ef04a190f1baacd16eb08/2012/CVE-2012-1757.md","https://github.com/CVEProject/cvelistV5/blob/a0edea60322bafbed67887cf7a4d97a55df8a9fa/cves/2012/1xxx/CVE-2012-1757.json","https://github.com/CVEDB/Poc-Git/blob/0275aeb329b0747c9a1d46160c921eae06095557/2012/CVE-2012-1757.md","https://github.com/kaismax/CVE-Poc/blob/6d8c93dabf674cea102713781cc534d577412357/2012/CVE-2012-1757.md","https://github.com/LiuCan01/cve-list-pro/blob/78b55511cee3604c22d518e32822f0435d0cacc0/cve-list/CVE-2012/CVE-2012-1757","https://github.com/Patrowl/PatrowlHearsData/blob/e6d30197c1ae0e0b416414f6f0ed16544575a73f/CVE/data/2012/CVE-2012-1757.json","https://github.com/nottrobin/ubuntu-cve-tracker/blob/36e411296b5707284049ec2e0db8d2622feca498/retired/CVE-2012-1757","https://github.com/Ch4120N/Ch4120N-CVE-Pulse/blob/d85e3a1792768837470e0c79fd15b0f8bd851146/CVEs/2012/CVE-2012-1757.md","https://github.com/mabitoski/cve_submodules/blob/44ad7e2705b3aef1b2ffaf64bd47596c10a6c2e4/2012/CVE-2012-1757.md","https://github.com/neuvector/vul-source/blob/da5ad7125749ac49ac2c49c4f3cd740b81c2c723/ubuntu-cve-tracker/retired/CVE-2012-1757"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":[],"repo_exp_urls":[],"has_poc":false,"has_exp":false,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/2012/AVE-2012-0195.toml"},{"ave_id":"AVE-2012-0194","file_name":"2012/AVE-2012-0194.toml","cve_id":"CVE-2012-1756","title":"Oracle MySQL Server 拒绝服务漏洞","description":"Oracle MySQL Server 5.5.23及之前版本中存在一个未明确的拒绝服务漏洞，位于Server Optimizer组件中。远程认证用户可通过发送特制的SQL查询或利用GIS扩展、InnoDB存储引擎中的异常处理缺陷，触发服务进程异常终止或资源耗尽，导致数据库服务不可用。攻击者需拥有有效数据库账户才能利用此漏洞，CVSS评分4.0，危害等级中低。Oracle已在2012年7月的关键补丁更新中修复该漏洞，建议升级至MySQL 5.5.24及以上版本。","severity":"MEDIUM","score":4.0,"aliases":["CVE-2012-1756"],"sources":["tenable"],"published":"2012-07-17T22:55:02Z","updated":"2026-06-16T23:40:14Z","remediation":"升级 MySQL Server 至 5.5.24 或更高版本。如使用 Oracle 官方发行版，从 support.oracle.com 下载对应补丁；如使用操作系统包管理器（apt/yum），执行 `apt-get update && apt-get upgrade mysql-server` 或 `yum update mysql-server`。无法立即升级时，限制可信用户对 MySQL 服务的访问权限，通过防火墙仅允许必要 IP 连接 3306 端口作为临时缓解措施。","status":"completed","collected_at":"2026-08-05T00:00:00Z","references":["http://osvdb.org/83978","http://www.mandriva.com/security/advisories?name=MDVSA-2013:150","http://www.oracle.com/technetwork/topics/security/cpujul2012-392727.html","http://www.securityfocus.com/bid/54524","http://www.securitytracker.com/id?1027263","https://exchange.xforce.ibmcloud.com/vulnerabilities/77063","https://github.com/trickest/cve/blob/0950a261126c1029f51ef04a190f1baacd16eb08/2012/CVE-2012-1756.md","https://github.com/CVEProject/cvelistV5/blob/a0edea60322bafbed67887cf7a4d97a55df8a9fa/cves/2012/1xxx/CVE-2012-1756.json","https://github.com/CVEDB/Poc-Git/blob/0275aeb329b0747c9a1d46160c921eae06095557/2012/CVE-2012-1756.md","https://github.com/kaismax/CVE-Poc/blob/6d8c93dabf674cea102713781cc534d577412357/2012/CVE-2012-1756.md","https://github.com/LiuCan01/cve-list-pro/blob/78b55511cee3604c22d518e32822f0435d0cacc0/cve-list/CVE-2012/CVE-2012-1756","https://github.com/Patrowl/PatrowlHearsData/blob/e6d30197c1ae0e0b416414f6f0ed16544575a73f/CVE/data/2012/CVE-2012-1756.json","https://github.com/nottrobin/ubuntu-cve-tracker/blob/36e411296b5707284049ec2e0db8d2622feca498/retired/CVE-2012-1756","https://github.com/Ch4120N/Ch4120N-CVE-Pulse/blob/d85e3a1792768837470e0c79fd15b0f8bd851146/CVEs/2012/CVE-2012-1756.md","https://github.com/mabitoski/cve_submodules/blob/44ad7e2705b3aef1b2ffaf64bd47596c10a6c2e4/2012/CVE-2012-1756.md","https://github.com/CVEProject/cve-reference-ingest-data/blob/77593eb98c5b4442e1d39edb33f054611a117bc4/references/CVE-2012-1756-2023-09-21-1730"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":[],"repo_exp_urls":[],"has_poc":false,"has_exp":false,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/2012/AVE-2012-0194.toml"},{"ave_id":"AVE-2012-0193","file_name":"2012/AVE-2012-0193.toml","cve_id":"CVE-2012-1735","title":"Oracle MySQL Server Server Optimizer 拒绝服务漏洞","description":"Oracle MySQL Server 5.5.23及之前版本的Server Optimizer组件中存在未指定的安全漏洞。远程认证用户可通过向数据库服务器发送特制的查询请求，利用优化器在处理查询计划时的未知向量，导致MySQL服务进程崩溃或进入不可用状态，造成拒绝服务。该漏洞无需特殊权限即可远程利用，攻击复杂度低，影响数据库服务的可用性。Oracle已在2012年7月的关键补丁更新中修复此漏洞，建议升级至MySQL 5.5.24及以上版本。","severity":"MEDIUM","score":6.8,"aliases":["CVE-2012-1735"],"sources":["tenable"],"published":"2012-07-17T22:55:01Z","updated":"2026-06-16T23:40:12Z","remediation":"升级 MySQL 5.5 至 5.5.24 或更高版本，或升级至 MySQL 5.6.x 系列。如无法立即升级，可在 my.cnf 中设置 optimizer_prune_level=1 和 optimizer_search_depth=62 限制优化器搜索深度，降低触发拒绝服务的风险；同时通过 max_user_connections 和 max_connections 限制数据库用户的并发连接数，减少攻击面。","status":"completed","collected_at":"2026-08-05T00:00:00Z","references":["http://osvdb.org/83975","http://www.mandriva.com/security/advisories?name=MDVSA-2013:150","http://www.oracle.com/technetwork/topics/security/cpujul2012-392727.html","http://www.securityfocus.com/bid/54549","http://www.securitytracker.com/id?1027263","https://exchange.xforce.ibmcloud.com/vulnerabilities/77060","https://github.com/trickest/cve/blob/0950a261126c1029f51ef04a190f1baacd16eb08/2012/CVE-2012-1735.md","https://github.com/CVEProject/cvelistV5/blob/a0edea60322bafbed67887cf7a4d97a55df8a9fa/cves/2012/1xxx/CVE-2012-1735.json","https://github.com/CVEDB/Poc-Git/blob/0275aeb329b0747c9a1d46160c921eae06095557/2012/CVE-2012-1735.md","https://github.com/kaismax/CVE-Poc/blob/6d8c93dabf674cea102713781cc534d577412357/2012/CVE-2012-1735.md","https://github.com/LiuCan01/cve-list-pro/blob/78b55511cee3604c22d518e32822f0435d0cacc0/cve-list/CVE-2012/CVE-2012-1735","https://github.com/Patrowl/PatrowlHearsData/blob/e6d30197c1ae0e0b416414f6f0ed16544575a73f/CVE/data/2012/CVE-2012-1735.json","https://github.com/nottrobin/ubuntu-cve-tracker/blob/36e411296b5707284049ec2e0db8d2622feca498/retired/CVE-2012-1735","https://github.com/mabitoski/cve_submodules/blob/44ad7e2705b3aef1b2ffaf64bd47596c10a6c2e4/2012/CVE-2012-1735.md","https://github.com/neuvector/vul-source/blob/da5ad7125749ac49ac2c49c4f3cd740b81c2c723/ubuntu-cve-tracker/retired/CVE-2012-1735","https://github.com/nomi-sec/NVD-Database/blob/23dc120c34402aaa65883c51c1d03b3cb02c20cb/2012/CVE-2012-1735.json"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":[],"repo_exp_urls":[],"has_poc":false,"has_exp":false,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/2012/AVE-2012-0193.toml"}]
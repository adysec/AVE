"https://github.com/Patrowl/PatrowlHearsData/blob/e55eacb4f05da66af6c788dc1e36dafe4a12a8f8/CVE/data/1999/CVE-1999-1478.json","https://github.com/github/advisory-database/blob/0c0a10d79f5b2cb31273b4689494721df2c3dfcc/advisories/unreviewed/2022/04/GHSA-chqh-vf5r-qvxr/GHSA-chqh-vf5r-qvxr.json","https://github.com/marcellodesales/aibbp-reverse-engineer/blob/960f610d597aae9fec1cc5f03c68679be00c222d/reverse_engineer/acunetix/vulnerabilities/vdb/1999/1xxx/cve-1999-1478.yaml","https://github.com/nomi-sec/NVD-Database/blob/23dc120c34402aaa65883c51c1d03b3cb02c20cb/1999/CVE-1999-1478.json","https://github.com/KTZgraph/sarenka/blob/f1fb931ab722d6c096d581ed6e3c5966d799fbaa/sarenka/feeds/cve_details/cve_all_details_153500_153600.json","https://github.com/leego972/titanai/blob/afa5b2310463aae5781d3fd9408071bf38e79806/data/raw/corpus_D_cyber/nvd_cve_000690.txt","https://github.com/oasis-open/cti-stix-common-objects/blob/55ba7598cbd5a52577b6887871505d931d85cb61/objects/vulnerability/vulnerability--44b1a868-b5e3-4dd6-8a6e-aa90eec10ca0.json"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":["https://raw.githubusercontent.com/adysec/AVE/main/pocs/1999/POC-AVE-1999-1127.toml"],"repo_exp_urls":["https://raw.githubusercontent.com/adysec/AVE/main/exploits/1999/EXP-AVE-1999-1127.toml"],"has_poc":true,"has_exp":true,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/1999/AVE-1999-1127.toml"},{"ave_id":"AVE-1999-0509","file_name":"1999/AVE-1999-0509.toml","cve_id":"CVE-1999-0728","title":"Microsoft Windows NT IOCTL 权限控制不当漏洞","description":"Windows NT 操作系统在处理键盘与鼠标的输入输出控制时存在权限校验缺陷，本地已登录的普通用户可绕过系统限制，直接调用内核中控制输入设备的 IOCTL（如用于禁用键盘或鼠标的设备控制码），强制关闭或禁用这些输入设备。该漏洞影响运行 Windows NT 的本地系统，攻击前提是攻击者需在目标主机上拥有合法的交互式登录会话，利用方式为执行特制程序直接下发相应的 IOCTL 请求，使目标主机的键盘或鼠标失去响应，导致本地拒绝服务，干扰正常用户的操作并影响系统可用性。","severity":"HIGH","score":7.8,"aliases":["CVE-1999-0728"],"sources":["epss"],"published":"1999-07-06T04:00:00Z","updated":"2026-06-16T21:48:55Z","remediation":"安装 Microsoft 针对 Windows NT 发布的安全更新补丁，或升级至 Windows NT 4.0 Service Pack 6 及以上版本。如无法立即补丁，可通过修改注册表限制普通用户对键盘和鼠标设备驱动程序的访问权限，将相关 IOCTL 调用权限仅授予管理员账户，或通过组策略禁用非管理员用户的交互式桌面访问作为临时缓解措施。","status":"completed","collected_at":"2026-07-18T00:00:00Z","references":["http://support.microsoft.com/default.aspx?scid=kb%3B%5BLN%5D%3BQ236359","https://docs.microsoft.com/en-us/security-updates/securitybulletins/1999/ms99-024","https://github.com/CVEProject/cvelistV5/blob/0f25967d744704fe14324ac10f2b57e945aed081/cves/1999/0xxx/CVE-1999-0728.json","https://github.com/LiuCan01/cve-list-pro/blob/78b55511cee3604c22d518e32822f0435d0cacc0/cve-list/CVE-1999/CVE-1999-0728","https://github.com/yarencheng/cve-devops-playground/blob/e046e4965f64348bd29a0c62edd023b3c580939e/content/CVE-1999-0728.md","https://github.com/Patrowl/PatrowlHearsData/blob/d2eb55660fa7a900eec90103b031be5d6f98d9ec/CVE/data/1999/CVE-1999-0728.json","https://github.com/github/advisory-database/blob/1dbd44058e428445290bfb1f6fc6ecc0addbfd35/advisories/unreviewed/2022/04/GHSA-r7mg-fmm2-chj3/GHSA-r7mg-fmm2-chj3.json","https://github.com/feng-li/tools-for-data-science-course/blob/8e62d47ee8ffbebe9a0e50aee193617f83883118/2019spring/2017312271/result.txt","https://github.com/nomi-sec/NVD-Database/blob/23dc120c34402aaa65883c51c1d03b3cb02c20cb/1999/CVE-1999-0728.json","https://github.com/intSpLoiT/intframework/blob/eabaa799d0260aa52b735fa9769266d1ce4b64ef/modules/cve_list.txt","https://github.com/KTZgraph/sarenka/blob/f1fb931ab722d6c096d581ed6e3c5966d799fbaa/sarenka/feeds/cve_details/cve_all_details_153500_153600.json","https://github.com/security-commits/security-patches-dataset/blob/e93fcdcc8c9b91785f962a06d66b7ee623780245/data/cve-details/year/1999.csv"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":[],"repo_exp_urls":[],"has_poc":false,"has_exp":false,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/1999/AVE-1999-0509.toml"},{"ave_id":"AVE-1999-0453","file_name":"1999/AVE-1999-0453.toml","cve_id":"CVE-1999-0752","title":"Netscape Enterprise Server SSL 握手缓冲区溢出拒绝服务漏洞","description":"Netscape Enterprise Server 在处理 SSL 握手过程时存在缓冲区溢出漏洞，其根本原因是服务器对 SSL 握手阶段接收的数据缺乏充分的长度校验。未经身份认证的远程攻击者可通过向目标服务器的 SSL 端口发送特制的、超长的握手数据包，触发缓冲区溢出，导致服务进程崩溃，从而引发拒绝服务。攻击者仅需具备网络可达性即可发起攻击，无需任何凭据或用户交互。该漏洞影响 Netscape Enterprise Server 3.6 等版本，成功利用会造成 Web 服务不可用，CVSS 评分 5.0，危害等级中等。","severity":"MEDIUM","score":5.0,"aliases":["CVE-1999-0752"],"sources":["epss"],"published":"1999-07-06T04:00:00Z","updated":"2026-06-16T21:48:58Z","remediation":"建议立即升级 Netscape Enterprise Server 至 3.6.1 或更高安全版本以修复 SSL 握手缓冲区溢出漏洞，或迁移至受支持的 iPlanet Web Server。如暂时无法升级，可在防火墙及反向代理设备上配置规则拦截包含超长记录的畸形 SSL 握手报文作为临时缓解措施。","status":"completed","collected_at":"2026-07-18T00:00:00Z","references":["https://exchange.xforce.ibmcloud.com/vulnerabilities/CVE-1999-0752","https://www.exploit-db.com/exploits/19416","https://github.com/CVEProject/cvelistV5/blob/20b9340dcaffca733259fb153ac741206a5bbc5f/cves/1999/0xxx/CVE-1999-0752.json","https://github.com/LiuCan01/cve-list-pro/blob/78b55511cee3604c22d518e32822f0435d0cacc0/cve-list/CVE-1999/CVE-1999-0752","https://github.com/yarencheng/cve-devops-playground/blob/5cf8ba64f356efe9269b21eca2f657231acd746c/content/CVE-1999-0752.md","https://github.com/Patrowl/PatrowlHearsData/blob/e90735e3e31fc62018265dfbae313d166e653462/CVE/data/1999/CVE-1999-0752.json","https://github.com/github/advisory-database/blob/d9ad03f9df46533ce9229f9da6bbf66bd77a3f4f/advisories/unreviewed/2022/04/GHSA-jq89-jcvx-x6h9/GHSA-jq89-jcvx-x6h9.json","https://github.com/nomi-sec/NVD-Database/blob/23dc120c34402aaa65883c51c1d03b3cb02c20cb/1999/CVE-1999-0752.json","https://github.com/KTZgraph/sarenka/blob/f1fb931ab722d6c096d581ed6e3c5966d799fbaa/sarenka/feeds/cve_details/cve_all_details_153500_153600.json","https://github.com/security-commits/security-patches-dataset/blob/e93fcdcc8c9b91785f962a06d66b7ee623780245/data/cve-details/year/1999.csv","https://github.com/oasis-open/cti-stix-common-objects/blob/55ba7598cbd5a52577b6887871505d931d85cb61/objects/vulnerability/vulnerability--e6bc36b6-8003-41ad-8193-439e990880f9.json","https://github.com/michael1981/sfish_pt/blob/14f609d56e35e9810a1de14712293ab47cc03a46/%E4%BF%A1%E6%81%AF%E6%94%B6%E9%9B%86%2B%E6%89%AB%E6%8F%8F%2B%E7%88%86%E7%A0%B4/X-Scan-v3.3/plugins/netscape_crash.nasl"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":[],"repo_exp_urls":[],"has_poc":false,"has_exp":false,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/1999/AVE-1999-0453.toml"},{"ave_id":"AVE-1999-1306","file_name":"1999/AVE-1999-1306.toml","cve_id":"CVE-1999-0918","title":"Microsoft Windows IGMP 分片报文处理拒绝服务漏洞","description":"Microsoft Windows 95/98/NT 4.0 系统的 TCP/IP 协议栈在处理畸形的分片 IGMP 数据包时存在输入验证缺陷（CWE-20）。远程攻击者无需身份认证即可发送特制的分片 IGMP 报文，导致目标系统性能下降、蓝屏崩溃或网络服务完全中断。该漏洞主要影响 Windows 95/98 系列，Windows NT 4.0 因其他系统机制保护攻击难度较高。","severity":"HIGH","score":7.8,"aliases":["CVE-1999-0918"],"sources":["cve","avd","exploitdb"],"published":"1999-07-03T00:00:00Z","updated":"1999-09-03T00:00:00Z","remediation":"安装 Microsoft 安全公告 MS99-034 提供的官方补丁。Windows 95/98 用户可通过 Windows Update 获取更新，Windows NT 4.0 用户可从 Microsoft 下载中心获取补丁。同时建议在网络边界防火墙过滤 IGMP 协议报文以缓解风险。","status":"completed","collected_at":"2026-07-19T00:00:00Z","references":["https://nvd.nist.gov/vuln/detail/CVE-1999-0918","https://docs.microsoft.com/en-us/security-updates/securitybulletins/1999/ms99-034","http://support.microsoft.com/default.aspx?scid=kb%3B%5BLN%5D%3BQ238329","http://www.securityfocus.com/bid/514"],"poc_urls":["https://www.exploit-db.com/exploits/19131"],"exp_urls":[],"repo_poc_urls":[],"repo_exp_urls":[],"has_poc":false,"has_exp":false,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/1999/AVE-1999-1306.toml"},{"ave_id":"AVE-1999-1097","file_name":"1999/AVE-1999-1097.toml","cve_id":"CVE-1999-1394","title":"BSD 系列操作系统 UFS 安全级别绕过漏洞","description":"在 BSD 4.4 衍生操作系统（含 BSDI BSD/OS 4.0、FreeBSD 3.2、NetBSD 1.4、OpenBSD 2.5）中，安全等级 1 机制用于阻止 root 用户修改设置了不可变（immutable）和仅追加（append-only）标志的文件。然而，具有 root 权限的攻击者可通过卸载文件系统后使用 fsdb 等文件系统编辑器直接操作底层设备，绕过该保护机制清除文件标志位。该漏洞需攻击者已获得本地 root 权限，利用条件苛刻，但本质上绕过了安全等级的核心防护设计。","severity":"LOW","score":2.1,"aliases":["CVE-1999-1394"],"sources":["avd"],"published":"1999-07-02T04:00:00Z","updated":"2026-06-16T21:50:20Z","remediation":"将系统安全级别提升至 2（在 /etc/rc.conf 或 /etc/sysctl.conf 中设置 kern_securelevel=2），此时即使 root 也无法通过卸载文件系统绕过 immutable/append-only 保护标志。如有条件，应升级至各 BSD 发行版修复此漏洞的后续版本（如 OpenBSD 2.6+、FreeBSD 4.0+）。","status":"completed","collected_at":"2026-07-20T00:00:00Z","references":["http://marc.info/?l=bugtraq&m=93094058620450&w=2","http://www.securityfocus.com/bid/510","https://www.exploit-db.com/exploits/19411","https://github.com/CVEProject/cvelistV5/blob/63f7cdb3d3ebf7bfe8ef6a2325af30a024b23325/cves/1999/1xxx/CVE-1999-1394.json","https://github.com/LiuCan01/cve-list-pro/blob/78b55511cee3604c22d518e32822f0435d0cacc0/cve-list/CVE-1999/CVE-1999-1394","https://github.com/yarencheng/cve-devops-playground/blob/470a5f1c0d1bd36cd0a6327cda49cf96a1474588/content/CVE-1999-1394.md","https://github.com/Patrowl/PatrowlHearsData/blob/175fba1f481a7f7cf5bdb5344d3c0e47af1884ef/CVE/data/1999/CVE-1999-1394.json","https://github.com/github/advisory-database/blob/fa37ed0317ce1265b487f92916077b9ccbfe3349/advisories/unreviewed/2022/04/GHSA-f7wg-pwf9-wgf9/GHSA-f7wg-pwf9-wgf9.json","https://github.com/SpeeDr00t/speedr00t.github.com/blob/0380f0c2190556fabe90257cb6c0034a42f68951/securityfocus/0x1000/510/info.html","https://github.com/olbat/nvdcve/blob/39f1db26eec9899ab2f8110ab3b45424c6fe9ec2/nvdcve/CVE-1999-1394.json","https://github.com/KTZgraph/sarenka/blob/f1fb931ab722d6c096d581ed6e3c5966d799fbaa/sarenka/feeds/cve_details/cve_all_details_153500_153600.json","https://github.com/leego972/titanai/blob/afa5b2310463aae5781d3fd9408071bf38e79806/data/raw/corpus_D_cyber/nvd_cve_000688.txt","https://github.com/nomi-sec/CVE-Easy-List/blob/8eedf1cb11548f43d573399be49eeffcf4f32e25/1999.tsv"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":["https://raw.githubusercontent.com/adysec/AVE/main/pocs/1999/POC-AVE-1999-1097.toml"],"repo_exp_urls":["https://raw.githubusercontent.com/adysec/AVE/main/exploits/1999/EXP-AVE-1999-1097.toml"],"has_poc":true,"has_exp":true,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/1999/AVE-1999-1097.toml"},{"ave_id":"AVE-1999-0308","file_name":"1999/AVE-1999-0308.toml","cve_id":"CVE-1999-0696","title":"CDE rpc.cmsd 日历管理服务守护进程缓冲区溢出漏洞","description":"CDE 日历管理器服务守护进程（rpc.cmsd）存在缓冲区溢出漏洞，远程攻击者无需身份认证即可向目标系统发送特制的 RPC 请求触发该漏洞，导致拒绝服务或任意代码执行。该漏洞影响 Caldera OpenUnix 8.0、UnixWare 7.1.1、HP HP-UX 11.0、Solaris 7.0 及 SunOS 4.1.4 等多个 UNIX 操作系统版本，CVSS 评分 10.0，危害等级严重。","severity":"CRITICAL","score":10.0,"aliases":["CVE-1999-0696"],"sources":["epss"],"published":"1999-07-01T04:00:00Z","updated":"2026-06-16T21:48:52Z","remediation":"立即安装各厂商提供的安全补丁：HP-UX 11.0 安装 PHCO_20200 或更新版本补丁；Solaris 7.0 安装 106900-07 或更新版本；UnixWare/OpenUnix 安装 Caldera 官方补丁。如无法打补丁，在 inetd.conf 中注释 rpc.cmsd 服务行并重启 inetd 以禁用 CDE 日历管理器服务，或在防火墙层面阻止 TCP 端口 611 的入站访问。","status":"completed","collected_at":"2026-07-17T00:00:00Z","references":["http://sunsolve.sun.com/pub-cgi/retrieve.pl?doctype=coll&doc=secbull/188","http://www.ciac.org/ciac/bulletins/j-051.shtml","http://www1.itrc.hp.com/service/cki/docDisplay.do?docId=HPSBUX9908-102","https://www.exploit-db.com/exploits/19421","https://github.com/CVEProject/cvelistV5/blob/553b36786ea28855fe97ba80cc96d54a735075a3/cves/1999/0xxx/CVE-1999-0696.json","https://github.com/LiuCan01/cve-list-pro/blob/78b55511cee3604c22d518e32822f0435d0cacc0/cve-list/CVE-1999/CVE-1999-0696","https://github.com/yarencheng/cve-devops-playground/blob/e046e4965f64348bd29a0c62edd023b3c580939e/content/CVE-1999-0696.md","https://github.com/Patrowl/PatrowlHearsData/blob/0f6f0e28732bc614273e91613aef04def1dce90b/CVE/data/1999/CVE-1999-0696.json","https://github.com/eldondev/Snort/blob/34bdcf6a7a638b55c7c04f77ef1efa526ad08e33/doc/signatures/1907.txt","https://github.com/github/advisory-database/blob/2df7e2c20081f44b866b16619f1f9253b790f640/advisories/unreviewed/2022/04/GHSA-h3qp-3qwx-3x56/GHSA-h3qp-3qwx-3x56.json","https://github.com/NetBSD/pkgsrc-wip/blob/4edc9938788d3f7fc2435789a001f306b27788b7/sara/PLIST","https://github.com/rhuitl/uClinux/blob/0486e80a025dccbe4a2213715a2ab8a5063ea86b/user/snort/drop-rules/sid-msg.map","https://github.com/bailehang/snort_2.2.0/blob/34f8a3a85f15645aea53d6e0d46863c7c57e43ef/doc/signatures/1909.txt","https://github.com/xqcyberscore/nvt/blob/978f6a9acb495d7d669239530ffe6da5d631f4da/2011/gb_cde_rpc_cmsd_service_detect.nasl"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":[],"repo_exp_urls":[],"has_poc":false,"has_exp":false,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/1999/AVE-1999-0308.toml"},{"ave_id":"AVE-1999-0254","file_name":"1999/AVE-1999-0254.toml","cve_id":"CVE-1999-0690","title":"HP CDE 将当前目录加入 root 的 PATH 环境变量导致权限提升漏洞","description":"HP CDE（Common Desktop Environment）在设置 root 用户环境变量 PATH 时错误地将当前目录 \".\" 包含在内，导致本地攻击者可在任意目录中放置与系统命令同名的恶意程序，当 root 用户通过 su 或登录进入该目录并执行未指定路径的命令时，恶意程序将以 root 权限自动执行，实现本地提权。该漏洞影响 HP-UX 系统中运行 CDE 的版本，需要攻击者拥有本地 shell 访问权限，CVSS 评分 7.2，危害等级高。","severity":"HIGH","score":7.2,"aliases":["CVE-1999-0690"],"sources":["avd"],"published":"1999-07-01T04:00:00Z","updated":"2026-06-16T21:48:51Z","remediation":"编辑 root 用户的 .profile、.login 或 CDE 系统级配置文件 /etc/dt/config/Xsession.d/ 下的相关脚本，移除 PATH 中的当前目录（即删除 \".\" 或空路径项），确保 PATH 仅包含绝对路径的系统目录（如 /usr/bin:/usr/sbin）。同时建议修改 CDE 启动脚本中 PATH 的拼接方式，使用完整路径调用命令，消除当前目录隐式搜索带来的提权风险。","status":"completed","collected_at":"2026-07-16T00:00:00Z","references":["http://www.ciac.org/ciac/bulletins/j-053.shtml","http://www1.itrc.hp.com/service/cki/docDisplay.do?docId=HPSBUX9907-100","https://github.com/CVEProject/cvelistV5/blob/d92a0abc5d3abac6dcdfabfef6fd71c158e0fd8b/cves/1999/0xxx/CVE-1999-0690.json","https://github.com/LiuCan01/cve-list-pro/blob/78b55511cee3604c22d518e32822f0435d0cacc0/cve-list/CVE-1999/CVE-1999-0690","https://github.com/yarencheng/cve-devops-playground/blob/45be3b4afd9c4397ee32a5cbf6819a590220b0c1/content/CVE-1999-0690.md","https://github.com/Patrowl/PatrowlHearsData/blob/58eef6eedd760f280b47bfb4c94db9995b29c5a0/CVE/data/1999/CVE-1999-0690.json","https://github.com/github/advisory-database/blob/6eca843f42fd99fea8c9b630931afac7c9d4576c/advisories/unreviewed/2022/04/GHSA-rf75-mr45-vgcx/GHSA-rf75-mr45-vgcx.json","https://github.com/KTZgraph/sarenka/blob/f1fb931ab722d6c096d581ed6e3c5966d799fbaa/sarenka/feeds/cwe_details/cwe_details_300_400.json","https://github.com/nomi-sec/NVD-Database/blob/23dc120c34402aaa65883c51c1d03b3cb02c20cb/1999/CVE-1999-0690.json","https://github.com/Team-Atlanta/aixcc-asc-atlantis/blob/785c446f980e12155935db586aa30c3b54adcc86/crs/src/crs-patch/smith/smith/lib/cwe/raw/CWE-427.txt","https://github.com/CyberSecAI/CWE-Expert/blob/f634e911e6c24a1ad8b9619383e2ab3eb2d9ebd4/CWE_corpus/markdown/4_cwe_trimmed_top25.md.txt","https://github.com/ws-researcher/CAEA/blob/098ddb07c83845feda3d1b1d56ef634927954af4/KGA/dataSet/ICNS/entN_ids_1"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":[],"repo_exp_urls":[],"has_poc":false,"has_exp":false,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/1999/AVE-1999-0254.toml"},{"ave_id":"AVE-1999-0248","file_name":"1999/AVE-1999-0248.toml","cve_id":"CVE-1999-0688","title":"HP 软件分发器 缓冲区溢出漏洞","description":"HP-UX 系统的软件分发器（Software Distributor，简称 SD）在 10.x 与 11.x 版本中存在缓冲区溢出漏洞。该漏洞源于 SD 组件在处理特定输入时未对数据长度做充分边界校验，导致攻击者可控的过长数据写入固定大小的缓冲区，进而可覆盖相邻内存并可能实现任意代码执行。影响范围为运行 HPUX 10.x 和 11.x 且启用 SD 服务的系统。攻击条件为攻击者需能够向目标系统的 SD 服务发送特制请求，通常需要一定的本地或相邻网络访问权限。利用方式为构造恶意输入触发缓冲区溢出，造成服务异常或提升权限。","severity":"MEDIUM","score":4.6,"aliases":["CVE-1999-0688"],"sources":["avd"],"published":"1999-07-01T04:00:00Z","updated":"2026-06-16T21:48:51Z","remediation":"立即安装 HP-UX 11.11 或更高版本的 HP Software Distributor 补丁 HPD4365-11，或者应用 HPSBUX9907-101 安全更新。如需继续使用 HPUX 10.x，请应用 HP SD 10.20 补丁套件。立即更新系统，关闭不必要的 SD 服务以降低风险。","status":"completed","collected_at":"2026-07-16T00:00:00Z","references":["http://www.securityfocus.com/bid/545","http://www1.itrc.hp.com/service/cki/docDisplay.do?docId=HPSBUX9907-101","https://github.com/CVEProject/cvelistV5/blob/0cda26301f5b3e56ace35e3d98835812d878db41/cves/1999/0xxx/CVE-1999-0688.json","https://github.com/LiuCan01/cve-list-pro/blob/78b55511cee3604c22d518e32822f0435d0cacc0/cve-list/CVE-1999/CVE-1999-0688","https://github.com/yarencheng/cve-devops-playground/blob/45be3b4afd9c4397ee32a5cbf6819a590220b0c1/content/CVE-1999-0688.md","https://github.com/Patrowl/PatrowlHearsData/blob/638fc08494602a9faf37bf81043122f16d26625c/CVE/data/1999/CVE-1999-0688.json","https://github.com/github/advisory-database/blob/6eca843f42fd99fea8c9b630931afac7c9d4576c/advisories/unreviewed/2022/04/GHSA-873q-3c4x-555r/GHSA-873q-3c4x-555r.json","https://github.com/nomi-sec/NVD-Database/blob/23dc120c34402aaa65883c51c1d03b3cb02c20cb/1999/CVE-1999-0688.json","https://github.com/intSpLoiT/intframework/blob/eabaa799d0260aa52b735fa9769266d1ce4b64ef/modules/cve_list.txt","https://github.com/security-commits/security-patches-dataset/blob/e93fcdcc8c9b91785f962a06d66b7ee623780245/data/cve-details/year/1999.csv","https://github.com/VulnerabilityHistoryProject/mega-foss/blob/4829eeb7b0101570abbc87d2a697f2c0c2f4e5c3/src/cve/graphql/trial.json","https://github.com/Vasileios-Mavroeidis/semantic-stix-vulnerability/blob/30f07606133364b9623f401bc306c8c9cbcf9386/vulnerability/vulnerability--9b15c9ce-60ad-4d9f-bb76-76ab2ab118a8.owl"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":[],"repo_exp_urls":[],"has_poc":false,"has_exp":false,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/1999/AVE-1999-0248.toml"},{"ave_id":"AVE-1999-0296","file_name":"1999/AVE-1999-0296.toml","cve_id":"CVE-1999-0707","title":"HP Visualize Conference FTP 未授权文件传输漏洞","description":"HP Visualize Conference 的默认 FTP 配置存在授权缺陷，会议中任意参与者可在未经其他参会者授权的情况下向其发送文件。攻击者利用该默认配置，通过 FTP 协议向目标用户推送恶意文件，可能导致敏感信息泄露或进一步渗透。该漏洞影响 HP-UX 系统上的 HP Visualize Conference，无需身份认证即可远程触发，CVSS v2.0 评分 7.5，危害等级高。","severity":"HIGH","score":7.5,"aliases":["CVE-1999-0707"],"sources":["cve"],"published":"1999-07-01T00:00:00Z","updated":"2026-06-16T00:00:00Z","remediation":"针对 HP-UX 系统上的 HP Visualize Conference，参考 HP 安全公告 HPSBUX9906-099 进行修复。建议升级 HP-UX 至最新受支持版本，并在 FTP 服务配置中禁用匿名文件传输功能，限制会议用户仅通过认证方式访问 FTP 服务。同时在系统防火墙层面限制非必要 IP 对 FTP 端口（21/TCP）的访问作为临时缓解措施。","status":"completed","collected_at":"2026-07-18T00:00:00Z","references":["http://www.ciac.org/ciac/bulletins/j-050.shtml","http://www.securityfocus.com/bid/493","http://www1.itrc.hp.com/service/cki/docDisplay.do?docId=HPSBUX9906-099","https://nvd.nist.gov/vuln/detail/CVE-1999-0707"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":[],"repo_exp_urls":[],"has_poc":false,"has_exp":false,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/1999/AVE-1999-0296.toml"}]
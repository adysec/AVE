s/SQUID-2002_3.txt","http://www.squid-cache.org/Versions/v2/2.4/bugs/","https://github.com/CVEProject/cvelistV5/blob/34b929f9979d6d9d9584dfab31f29f50dcf08e3f/cves/2002/0xxx/CVE-2002-0715.json","https://github.com/LiuCan01/cve-list-pro/blob/78b55511cee3604c22d518e32822f0435d0cacc0/cve-list/CVE-2002/CVE-2002-0715","https://github.com/yarencheng/cve-devops-playground/blob/cbe73d6bdcced13ea57f08566d6bbf5345864f7e/content/CVE-2002-0715.md","https://github.com/Patrowl/PatrowlHearsData/blob/475f53ac063af305fc146a443cce993188109d56/CVE/data/2002/CVE-2002-0715.json","https://github.com/github/advisory-database/blob/e6b10ee602769bd7be4675bf10e3382c1f100e32/advisories/unreviewed/2022/05/GHSA-rh7c-c27g-cwxw/GHSA-rh7c-c27g-cwxw.json","https://github.com/rhuitl/uClinux/blob/0486e80a025dccbe4a2213715a2ab8a5063ea86b/user/nessus/nessus-plugins/scripts/redhat-RHSA-2002-130.nasl","https://github.com/intSpLoiT/intframework/blob/eabaa799d0260aa52b735fa9769266d1ce4b64ef/modules/cve_list.txt","https://github.com/KTZgraph/sarenka/blob/f1fb931ab722d6c096d581ed6e3c5966d799fbaa/sarenka/feeds/cve_details/cve_all_details_148800_148900.json","https://github.com/oasis-open/cti-stix-common-objects/blob/55ba7598cbd5a52577b6887871505d931d85cb61/objects/vulnerability/vulnerability--4c2ba406-c274-48e9-a875-7ddcd8f76b5b.json","https://github.com/nomi-sec/NVD-Database/blob/23dc120c34402aaa65883c51c1d03b3cb02c20cb/2002/CVE-2002-0715.json"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":[],"repo_exp_urls":[],"has_poc":false,"has_exp":false,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/2002/AVE-2002-0020.toml"},{"ave_id":"AVE-2002-0019","file_name":"2002/AVE-2002-0019.toml","cve_id":"CVE-2002-0714","title":"Squid FTP 代理安全绕过漏洞","description":"Squid 2.4.STABLE6 之前版本的 FTP 代理功能存在安全绕过漏洞。由于代理服务器未对控制连接与数据连接的 IP 地址进行比对验证，远程攻击者可通过构造特制的 FTP 数据连接绕过防火墙规则，或伪造 FTP 服务器响应实施中间人攻击。该漏洞影响广泛部署的 Squid 代理服务器，CVSS 评分 7.5，危害等级高。","severity":"HIGH","score":7.5,"aliases":["CVE-2002-0714"],"sources":["osv"],"published":"2002-07-26T04:00:00.000","updated":"2026-06-16T21:57:59.823","remediation":"升级 Squid 至 2.4.STABLE6 或更高版本，该版本已修复 FTP 代理未校验控制连接与数据连接 IP 地址一致性的问题。如无法升级，可在防火墙上限制 FTP 数据连接仅允许来自受信任的 FTP 服务器 IP 范围，或禁用 FTP 代理功能作为临时缓解措施。","status":"completed","collected_at":"2026-07-22T00:00:00Z","references":["http://distro.conectiva.com.br/atualizacoes/?id=a&anuncio=000506","http://marc.info/?l=bugtraq&m=102674543407606&w=2","http://rhn.redhat.com/errata/RHSA-2002-051.html","http://rhn.redhat.com/errata/RHSA-2002-130.html","http://www.iss.net/security_center/static/9479.php","http://www.linux-mandrake.com/en/security/2002/MDKSA-2002-044.php","http://www.osvdb.org/5924","http://www.securityfocus.com/bid/5158","http://www.squid-cache.org/Advisories/SQUID-2002_3.txt","http://www.squid-cache.org/Versions/v2/2.4/bugs/","https://github.com/CVEProject/cvelistV5/blob/34b929f9979d6d9d9584dfab31f29f50dcf08e3f/cves/2002/0xxx/CVE-2002-0714.json","https://github.com/LiuCan01/cve-list-pro/blob/78b55511cee3604c22d518e32822f0435d0cacc0/cve-list/CVE-2002/CVE-2002-0714","https://github.com/yarencheng/cve-devops-playground/blob/cbe73d6bdcced13ea57f08566d6bbf5345864f7e/content/CVE-2002-0714.md","https://github.com/Patrowl/PatrowlHearsData/blob/475f53ac063af305fc146a443cce993188109d56/CVE/data/2002/CVE-2002-0714.json","https://github.com/github/advisory-database/blob/e6b10ee602769bd7be4675bf10e3382c1f100e32/advisories/unreviewed/2022/05/GHSA-pqhg-h683-23rw/GHSA-pqhg-h683-23rw.json","https://github.com/rhuitl/uClinux/blob/0486e80a025dccbe4a2213715a2ab8a5063ea86b/user/nessus/nessus-plugins/scripts/redhat-RHSA-2002-130.nasl","https://github.com/intSpLoiT/intframework/blob/eabaa799d0260aa52b735fa9769266d1ce4b64ef/modules/cve_list.txt","https://github.com/KTZgraph/sarenka/blob/f1fb931ab722d6c096d581ed6e3c5966d799fbaa/sarenka/feeds/cve_details/cve_all_details_148800_148900.json","https://github.com/blackhook/nessus-plugins/blob/64177d96abbb07c58cf7e131046b067ebc61fcb5/M/mandrake_MDKSA-2002-044.nasl","https://github.com/oasis-open/cti-stix-common-objects/blob/55ba7598cbd5a52577b6887871505d931d85cb61/objects/vulnerability/vulnerability--5f03889b-39da-4478-905c-2404155221bd.json"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":[],"repo_exp_urls":[],"has_poc":false,"has_exp":false,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/2002/AVE-2002-0019.toml"},{"ave_id":"AVE-2002-0018","file_name":"2002/AVE-2002-0018.toml","cve_id":"CVE-2002-0713","title":"Squid 缓冲区溢出拒绝服务代码执行漏洞","description":"Squid 代理服务器 2.4.STABLE6 之前版本存在多个缓冲区溢出漏洞。远程攻击者可利用以下三种方式触发溢出：一是通过 MSNT 认证辅助程序（msnt_auth）处理 denyusers 或 allowusers 文件时，二是通过 gopher 客户端协议解析时，三是通过生成 HTML 输出的 FTP 服务端目录列表解析器。成功利用可导致服务崩溃（拒绝服务）或可能执行任意代码。CVSS 评分 7.5，危害等级高。建议升级至 Squid 2.4.STABLE6 及以上版本。","severity":"HIGH","score":7.5,"aliases":["CVE-2002-0713"],"sources":["osv"],"published":"2002-07-26T04:00:00.000","updated":"2026-06-16T21:57:59.680","remediation":"升级 Squid 至 2.4.STABLE6 或更高版本以修复缓冲区溢出漏洞。如无法立即升级，在 squid.conf 中禁用 gopher 协议（http_port 配置后添加 `gopher` 协议限制），并移除或注释掉 msnt_auth 认证助手的 denyusers/allowusers 文件配置，同时关闭 FTP 目录列表的 HTML 输出功能作为临时缓解措施。","status":"completed","collected_at":"2026-07-22T00:00:00Z","references":["http://marc.info/?l=bugtraq&m=102674543407606&w=2","http://rhn.redhat.com/errata/RHSA-2002-051.html","http://rhn.redhat.com/errata/RHSA-2002-130.html","http://www.iss.net/security_center/static/9480.php","http://www.iss.net/security_center/static/9481.php","http://www.iss.net/security_center/static/9482.php","http://www.linux-mandrake.com/en/security/2002/MDKSA-2002-044.php","http://www.securityfocus.com/bid/5155","http://www.securityfocus.com/bid/5156","http://www.securityfocus.com/bid/5157","http://www.squid-cache.org/Advisories/SQUID-2002_3.txt","http://www.squid-cache.org/Versions/v2/2.4/bugs/","https://github.com/CVEProject/cvelistV5/blob/34b929f9979d6d9d9584dfab31f29f50dcf08e3f/cves/2002/0xxx/CVE-2002-0713.json","https://github.com/LiuCan01/cve-list-pro/blob/78b55511cee3604c22d518e32822f0435d0cacc0/cve-list/CVE-2002/CVE-2002-0713"
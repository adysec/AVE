nomi-sec/CVE-Easy-List/blob/5116d66f715b098d7dc74f3fb3559215242e5dbf/2000.tsv","https://github.com/dong-xs/Vul-PAG/blob/7eb3b32094a5270cfd8495366e0e4a7df5a874ce/aspect_prediction/org_pred_diff.txt","https://github.com/Vasileios-Mavroeidis/semantic-stix-vulnerability/blob/30f07606133364b9623f401bc306c8c9cbcf9386/vulnerability/vulnerability--4a8779f7-9a97-4dfb-9538-73149fc65256.owl"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":[],"repo_exp_urls":[],"has_poc":false,"has_exp":false,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/2000/AVE-2000-0071.toml"},{"ave_id":"AVE-2000-0065","file_name":"2000/AVE-2000-0065.toml","cve_id":"CVE-2000-0079","title":"W3C CERN httpd 路径泄露漏洞","description":"W3C CERN httpd（原 CERN httpd）HTTP 服务器存在路径泄露漏洞，远程攻击者可通过向服务器发送特制的不存在的 URL 请求，从错误响应中获取服务器上命令的真实路径信息。该漏洞可导致敏感目录结构暴露，为后续攻击提供信息支撑，影响运行 W3C httpd 服务的系统，CVSS 评分 7.5，危害等级高。","severity":"HIGH","score":7.5,"aliases":["CVE-2000-0079"],"sources":["avd"],"published":"2000-01-18T05:00:00.000","updated":"2026-06-16T21:50:57.407","remediation":"立即停止使用已停止维护的 CERN httpd(W3C httpd)，迁移至 Apache HTTP Server 2.4.x 或 Nginx 等现代活跃维护的 Web 服务器。迁移后需正确配置错误页面响应，禁用 ServerTokens 及 ServerSignature 等服务器信息泄露选项，避免将内部路径暴露给客户端。","status":"completed","collected_at":"2026-07-21T00:00:00Z","references":["http://www.securityfocus.com/bid/936","https://github.com/CVEProject/cvelistV5/blob/ad6ba3d27513a57837704589c10c0be969a18efd/cves/2000/0xxx/CVE-2000-0079.json","https://github.com/LiuCan01/cve-list-pro/blob/78b55511cee3604c22d518e32822f0435d0cacc0/cve-list/CVE-2000/CVE-2000-0079","https://github.com/yarencheng/cve-devops-playground/blob/7f1c35ad28226319c149c937b6a2e7a1986924ce/content/CVE-2000-0079.md","https://github.com/Patrowl/PatrowlHearsData/blob/1d32b25dbea4bacedc1131a8702fa8adcc181eee/CVE/data/2000/CVE-2000-0079.json","https://github.com/rhuitl/uClinux/blob/0486e80a025dccbe4a2213715a2ab8a5063ea86b/user/nessus/nessus-plugins/scripts/cern_httpd_path.nasl","https://github.com/nomi-sec/NVD-Database/blob/23dc120c34402a
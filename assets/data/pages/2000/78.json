/blob/23c72f0e29729596bf60b6750cbec12b936da4bf/advisories/unreviewed/2022/04/GHSA-47fr-pv8j-v3gg/GHSA-47fr-pv8j-v3gg.json","https://github.com/mtesauro/owasp-wte/blob/e4c016caf67d59634f309f2a1feeed7dc9515abe/temp-projects/spikeproxy/contents/opt/owasp/spikeproxy/scan_database.db","https://github.com/nomi-sec/NVD-Database/blob/23dc120c34402aaa65883c51c1d03b3cb02c20cb/2000/CVE-2000-0011.json","https://github.com/KTZgraph/sarenka/blob/f1fb931ab722d6c096d581ed6e3c5966d799fbaa/sarenka/feeds/cve_details/cve_all_details_153900_154000.json","https://github.com/leego972/titanai/blob/afa5b2310463aae5781d3fd9408071bf38e79806/data/raw/corpus_D_cyber/nvd_cve_001068.txt","https://github.com/andreafioraldi/ToolsForCyberChallenge/blob/197d3dfd204cf1b9d1af1451455c8831c3ff9948/generated/files_1.list.dict"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":["https://raw.githubusercontent.com/adysec/AVE/main/pocs/2000/POC-AVE-2000-0022.toml"],"repo_exp_urls":[],"has_poc":true,"has_exp":false,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/2000/AVE-2000-0022.toml"},{"ave_id":"AVE-2000-0014","file_name":"2000/AVE-2000-0014.toml","cve_id":"CVE-2000-0015","title":"Ascend CascadeView/UX TFTP 符号链接本地权限提升漏洞","description":"Ascend CascadeView/UX 1.0 的 TFTP 服务器存在符号链接攻击漏洞。本地攻击者可创建指向系统敏感文件（如口令文件）的符号链接，诱使 TFTP 服务器读取或写入这些文件，从而获取本不应拥有的访问权限。该漏洞影响 Ascend CascadeView/UX 1.0 版本，利用条件为拥有本地账号，危害等级中危，CVSS 评分 4.6。","severity":"MEDIUM","score":4.6,"aliases":["CVE-2000-0015"],"sources":["avd"],"published":"1999-12-31T05:00:00Z","updated":"2026-06-16T21:50:49Z","remediation":"建议立即升级 Ascend CascadeView/UX 至非易受攻击版本，或禁用 TFTP 服务改用 SCP/SFTP 替代。在无法升级时，限制 TFTP 服务仅监听受信网络接口，并通过 chroot 隔离 TFTP 根目录，禁止符号链接跨目录访问。同时配置本地用户最小权限原则，避免低权限用户拥有对 TFTP 目录的写权限。","status":"completed","collected_at":"2026-07-21T00:00:00Z","references":["http://www.securityfocus.com/bid/910","https://www.exploit-db.com/exploits/19707","https://github.com/CVEProject/cvelistV5/blob/ed3e8dec058a54f5d840cd78ee86185dee6350a7/cves/2000/0xxx/CVE-2000-0015.jso
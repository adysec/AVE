://github.com/adampielak/nuclei-templates/blob/a2f3ff3fa5db5c7705ebd942909ec114df063700/nuclei-v3/C/CVE-2016-8735_3.yaml","https://github.com/canonical/ubuntu-security-notices/blob/bb6cd0f1a29580d840cdb570b8b0c57cc39aac6d/osv/cve/2016/UBUNTU-CVE-2016-8735.json","https://github.com/govbk/WIKI-POC-EXP/blob/7d1194429dab9f9dd8139408e79b70ddb41a468f/%E9%9B%B6%E7%BB%84%E6%BC%8F%E6%B4%9E%E7%9B%B8%E5%85%B3/127-Tomcat/007-CVE-2016-8735%20Tomcat%20%E5%8F%8D%E5%BA%8F%E5%88%97%E5%8C%96%E6%BC%8F%E6%B4%9E.md","https://github.com/ianxtianxt/CVE-2016-8735"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":[],"repo_exp_urls":[],"has_poc":false,"has_exp":false,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/2016/AVE-2016-0809.toml"},{"ave_id":"AVE-2016-0042","file_name":"2016/AVE-2016-0042.toml","cve_id":"CVE-2016-10134","title":"Zabbix latest.php SQL注入漏洞","description":"Zabbix 监控系统 2.2.x 版本（低于 2.2.14）及 3.0.x 版本（低于 3.0.4）的 latest.php 页面中存在 SQL 注入漏洞。该漏洞源于程序对 toggle_ids 数组参数缺乏有效的过滤和转义处理，未经身份认证的远程攻击者可通过向目标 Zabbix 服务器的 latest.php 页面发送特制的 HTTP 请求，在 toggle_ids 参数中构造恶意 SQL 语句，从而绕过认证机制执行任意 SQL 命令。成功利用该漏洞可导致攻击者窃取敏感数据（如管理员密码哈希）、篡改监控配置、甚至获取服务器操作系统控制权限。该漏洞无需任何权限即可远程触发，攻击复杂度低，CVSS 评分 9.8，危害等级为严重。","severity":"CRITICAL","score":9.8,"aliases":["CVE-2016-10134"],"sources":["nuclei"],"published":"2017-02-17T02:59:10Z","updated":"2026-06-17T00:39:07Z","remediation":"立即升级 Zabbix 至 2.2.14 及以上版本，或 3.0.4 及以上版本。如无法立即升级，可在 Web 服务器（Nginx/Apache）层面限制对 `latest.php` 的访问，仅允许受信 IP 段访问 Zabbix 前端页面，并启用 Web 应用防火墙（WAF）拦截 SQL 注入特征请求。","status":"completed","collected_at":"2026-07-27T00:00:00Z","references":["http://www.debian.org/security/2017/dsa-3802","http://www.openwall.com/lists/oss-security/2017/01/12/4","http://www.openwall.com/lists/oss-security/2017/01/13/4","http://www.securityfocus.com/bid/95423","https://bugs.debian.org/cgi-bin/bugreport.cgi?bug=850936","https://code610.blogspot.com/2017/10/zbx-11023-quick-autopsy.html","https://support.zabbix.com/browse/ZBX-11023","https://github.com/projectdiscovery/nuclei-templates/blob/main/http/cves/2016/CVE-2016-10134.yaml","https://github.com/trickest/cve/blob/e69d88e0152845fc4d4b49970ca6e503f56b2f93/2016/CVE-2016-10134.md","https://github.com/vulhub/vulhub/blob/aeaf65793f147f29bd50841ef77f4e9cad07ecc7/zabbix/CVE-2016-10134/README.md","https://github.com/projectdiscovery/nuclei-templates/blob/4ccef9ea7c907d917b1608d60d73b12823bdfdf5/http/cves/2016/CVE-2016-10134.yaml","https://github.com/ExpLangcn/NucleiTP/blob/2b7ecb9031a6eda4f272793045f29b339d8e0cce/CVES/critical/cve-2016-10134-2750.yaml","https://github.com/Threekiii/Awesome-POC/blob/0f9e22b660cb1ea12c1c3668f9128d93e08da412/%E4%B8%AD%E9%97%B4%E4%BB%B6%E6%BC%8F%E6%B4%9E/Zabbix%20latest.php%20SQL%E6%B3%A8%E5%85%A5%E6%BC%8F%E6%B4%9E%20CVE-2016-10134.md","https://github.com/amcai/myscan/blob/c0ed549669ec76cc9fea660554943244cbdd703b/myscan/pocs/perfolder/zabbix/poc_zabbix_cve-2016-10134_2016.py","https://github.com/cckuailong/reapoc/blob/699762e4c31d0183733f64313d8fc3be6470bd37/2016/CVE-2016-10134/poc/xray/CVE-2016-10134.yml","https://github.com/LiuCan01/cve-list-pro/blob/78b55511cee3604c22d518e32822f0435d0cacc0/cve-list/CVE-2016/CVE-2016-10134","https://github.com/TheBlindM/Tyan/blob/163f4868eb776afb646af7e6ecf96ba152b6c1d6/src/plugins/pocs/zabbix-cve-2016-10134-sqli.yml","https://github.com/adampielak/nuclei-templates/blob/a2f3ff3fa5db5c7705ebd942909ec114df063700/nuclei-v3/C/CVE-2016-10134_6.yaml"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":[],"repo_exp_urls":[],"has_poc":false,"has_exp":false,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/2016/AVE-2016-0042.toml"},{"ave_id":"AVE-2016-0100","file_name":"2016/AVE-2016-0100.toml","cve_id":"CVE-2016-10174","title":"NETGEAR WNR2000v5 路由器缓冲区溢出漏洞","description":"NETGEAR WNR2000v5 路由器在 /apply.cgi?/lang_check.html 接口的 hidden_lang_avi 参数存在栈缓冲区溢出漏洞。未经身份认证的远程攻击者可通过向受影响设备发送特制的 HTTP 请求触发该溢出，导致远程代码执行，完全控制目标路由器。该漏洞 CVSS 评分 9.8，危害等级严重，且已有公开的 Metasploit 利用模块，攻击门槛低。NETGEAR 官方未发布安全更新修复此漏洞，建议用户更换不受影响的设备型号或采取访问控制等缓解措施。","severity":"CRITICAL","score":9.8,"aliases":["CVE-2016-10174"],"sources":["kev"],"published":"2017-01-30T04:59:00Z","updated":"2026-06-17T00:39:12Z","remediation":"NETGEAR 已不再为 WNR2000v5 提供安全更新，建议立即更换为受支持的设备。如无法更换，请关闭路由器的远程管理功能（禁用 WAN 端 Web 访问），并将管理界面仅绑定到内网可信 IP；同时在防火墙规则中阻止外网对 TCP 80/443 端口的访问，以降低被远程利用的风险。","status":"completed","collected_at":"2026-07-27T00:00:00Z","references":["http://kb.netgear.com/000036549/Insecure-Remote-Access-and-Command-Execution-Security-Vulnerability","http://seclists.org/fulldisclosure/2016/Dec/72","http://www.securityfocus.com/bid/95867","https://raw.githubusercontent.com/pedrib/PoC/master/advisories/netgear-wnr2000.txt","https://www.exploit-db.com/exploits/40949/","https://www.exploit-db.com/exploits/41719/","https://www.cisa.gov/known-exploited-vulnerabilities-catalog?field_cve=CVE-2016-10174","https://www.exploit-db.com/exploits/41719","https://github.com/trickest/cve/blob/e69d88e0152845fc4d4b49970ca6e503f56b2f93/2016/CVE-2016-10174.md","https://github.com/CVEProject/cvelistV5/blob/bb04e7276eb5376f975ca811b9a340d0d55b901d/cves/2016/10xxx/CVE-2016-10174.json","https://github.com/LiuCan01/cve-list-pro/blob/78b55511cee3604c22d518e32822f0435d0cacc0/cve-list/CVE-2016/CVE-2016-10174","https://github.com/ARPSyndicate/suricata-vedas/blob/fe24794ad36564b5bbc7c69101525011387b8650/2016/CVE-2016-10174.rules","https://github.com/elastic/kibana/blob/83d1507553478043f1635b8450db9a0d059a40dd/x-pack/solutions/security/packages/data-table/mock/demo_data/timeline.ts","https://github.com/fankh/vulnerability-poc/blob/04aa22fbb624898c1d0928bc3b34fb05529275cb/2016/CVE-2016-10174/README.md","https://github.com/e-m-b-a/emba/blob/4d0f24b3edae0bdb5391177851bad3be54ecea0f/config/msf_cve-db.txt","https://github.com/pedrib/PoC/blob/3d8e58284be35d1893dbba8a7d33c27ed9e88352/advisories/netgear-wnr2000.txt","https://github.com/gottburgm/Exploits/blob/fd340a05cbec416e89bfae898e27bf5fcb429101/MSFExploits/NETGEAR/MSF/Wnr2000_rce_infos.txt","https://github.com/vulncheck-oss/0day.today.archive/blob/3664abdd71985a44aff3260896a8f36e2f4a9682/web-applications/27414.txt"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":[],"repo_exp_urls":[],"has_poc":false,"has_exp":false,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/2016/AVE-2016-0100.toml"},{"ave_id":"AVE-2016-0069","file_name":"2016/AVE-2016-0069.toml","cve_id":"CVE-2016-6601","title":"ZOHO WebNMS Framework 目录遍历漏洞","description":"ZOHO WebNMS Framework 5.2及5.2 SP1版本的文件下载功能存在目录遍历漏洞。远程攻击者无需身份认证即可通过向servlets/FetchFile接口的fileName参数传递../序列，绕过路径限制读取服务器上的任意文件，包括配置文件、密码文件等敏感信息。该漏洞源于程序未对用户输入的文件名进行充分的路径过滤和校验，攻击者利用难度低，无需特殊权限即可触发。CVSS评分7.5，危害等级高。","severity":"HIGH","score":7.5,"aliases":["CVE-2016-6601"],"sources":["nuclei"],"published":"2017-01-23T21:59:02Z","updated":"2026-06-17T00:51:26Z","remediation":"升级 ZOHO WebNMS Framework 至 5.2 SP2 或更高版本，官方已在后续版本中修复了 FetchFile servlet 的路径遍历问题。如无法立即升级，可在 Web 服务器或反向代理层面限制对 `/servlets/FetchFile` 路径的访问，仅允许可信 IP 范围访问 WebNMS 管理界面，并禁用 fileName 参数中的 `../` 序列。","status":"completed","collected_at":"2026-07-27T00:00:00Z","references":["http://packetstormsecurity.com/files/138244/WebNMS-Framework-5.2-SP1-Traversal-Weak-Obfuscation-User-Impersonation.html","http://seclists.org/fulldisclosure/2016/Aug/54","http://www.rapid7.com/db/modules/auxiliary/admin/http/webnms_cred_disclosure","http://www.rapid7.com/db/modules/auxiliary/admin/http/webnms_file_download","http://www.securityfocus.com/archive/1/539159/100/0/threaded","http://www.securityfocus.com/bid/92402","https://blogs.securiteam.com/index.php/archives/2712","https://forums.webnms.com/topic/recent-vulnerabilities-in-webnms-and-how-to-protect-the-server-against-them","https://github.com/pedrib/PoC/blob/master/advisories/webnms-5.2-sp1-pwn.txt","https://www.exploit-db.com/exploits/40229/","https://github.com/projectdiscovery/nuclei-templates/blob/main/http/cves/2016/CVE-2016-6601.yaml","https://github.com/trickest/cve/blob/be44b05b9428dc18bc0705cf60dd8d8640cd49b1/2016/CVE-2016-6601.md","https://github.com/projectdiscovery/nuclei-templates/blob/4924c84cac6ce9772babf48587bed8df9d0040d0/http/cves/2016/CVE-2016-6601.yaml","https://github.com/LiuCan01/cve-list-pro/blob/78b55511cee3604c22d518e32822f0435d0cacc0/cve-list/CVE-2016/CVE-2016-6601","https://github.com/e-m-b-a/emba/blob/9f33e551f5d4c0bb4df8de596869fddfb4c874cc/config/msf_cve-db.txt","https://github.com/rix4uni/nucleihub-templates/blob/579a0234551b9e0e322460a62dc77bd6109e4aff/nucleihub-templates/CVE-2016-6601_1.yaml","https://github.com/CVEProject/cvelist-dev/blob/5b8fbb570438e8094550205589cc6f1d122acc94/2016/6xxx/CVE-2016-6601.json","https://github.com/0xKayala/Custom-Nuclei-Templates/blob/1940dfd29577590f076c89dec5c30d809d68f210/8001-to-9000-templates/CVE-2016-6601.yaml","https://github.com/nomi-sec/NVD-Database/blob/23dc120c34402aaa65883c51c1d03b3cb02c20cb/2016/CVE-2016-6602.json","https://github.com/github/advisory-database/blob/d91e95989ea5d3a9186ceb621d53a71dff03cab4/advisories/unreviewed/2022/05/GHSA-xh3h-35f7-mgq7/GHSA-xh3h-35f7-mgq7.json","https://github.com/yarencheng/cve-devops-playground/blob/c54e59752dddfc9aa36c13774164384cfa0d1f04/content/CVE-2016-6601.md"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":[],"repo_exp_urls":[],"has_poc":false,"has_exp":false,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/2016/AVE-2016-0069.toml"},{"ave_id":"AVE-2016-0600","file_name":"2016/AVE-2016-0600.toml","cve_id":"CVE-2016-5198","title":"Google Chrome V8 引擎远程代码执行漏洞","description":"Google Chrome 的 V8 JavaScript 引擎存在优化假设错误漏洞，由于 V8 引擎在代码优化过程中对内存操作边界检查不足，导致越界写入（CWE-787）。远程攻击者可通过诱导用户访问特制的 HTML 页面触发该漏洞，实现任意内存读写操作，进而导致远程代码执行。该漏洞影响 Linux 版 Chrome 54.0.2840.90 之前版本、Android 版 54.0.2840.85 之前版本以及 Windows/Mac 版 54.0.2840.87 之前版本，CVSS 评分 8.8，危害等级高。用户需升级 Chrome 至修复版本以消除风险。","severity":"HIGH","score":8.8,"aliases":["CVE-2016-5198"],"sources":["kev"],"published":"2017-01-19T05:59:00Z","updated":"2026-06-17T00:48:57Z","remediation":"立即升级 Google Chrome 至 54.0.2840.90（Linux）/ 54.0.2840.85（Android）/ 54.0.2840.87（Windows/Mac）及以上版本，通过 Chrome 自动更新或官网下载安装。使用 Red Hat Enterprise Linux 6 的用户请安装 RHSA-2016-2672 提供的 chromium 更新。该漏洞已被 CISA 列入已知被利用漏洞目录，应优先修复。","status":"completed","collected_at":"2026-07-27T00:00:00Z","references":["http://rhn.redhat.com/errata/RHSA-2016-2672.html","http://www.securityfocus.com/bid/94079","http://www.securitytracker.com/id/1037224","https://chromereleases.googleblog.com/2016/11/stable-channel-update-for-desktop.html","https://crbug.com/659475","https://www.cisa.gov/known-exploited-vulnerabilities-catalog?field_cve=CVE-2016-5198","https://github.com/trickest/cve/blob/e69d88e0152845fc4d4b49970ca6e503f56b2f93/2016/CVE-2016-5198.md","https://github.com/tunz/js-vuln-db/blob/26d3f06008cbf95d05f066d2bf2a220deff491fc/v8/CVE-2016-5198.md","https://github.com/CVEProject/cvelistV5/blob/15ba52d0829fe2220e9f89276b2743c7eef0ab2a/cves/2016/5xxx/CVE-2016-5198.json","https://github.com/LiuCan01/cve-list-pro/blob/78b55511cee3604c22d518e32822f0435d0cacc0/cve-list/CVE-2016/CVE-2016-5198","https://github.com/cisagov/vulnrichment/blob/9553fde5ed5ff45a613d88bc99087dbba2111555/2016/5xxx/CVE-2016-5198.json","https://github.com/fankh/vulnerability-poc/blob/04aa22fbb624898c1d0928bc3b34fb05529275cb/2016/CVE-2016-5198/README.md","https://github.com/nottrobin/ubuntu-cve-tracker/blob/36e411296b5707284049ec2e0db8d2622feca498/retired/CVE-2016-5198","https://github.com/davidwowa/tech.cybersword.scm/blob/9f9c8b8f3096e9ea4ebdd18591194da9280c6375/tex/backup/202502232300/CVE-2016-5198.tex","https://github.com/nwjs/website/blob/4a57ffc90e29069e411332c8efa2ad48ba617688/src/blog/v0.18.5.md","https://github.com/xqcyberscore/nvt/blob/978f6a9acb495d7d669239530ffe6da5d631f4da/2016/gb_opensuse_2016_2733_1.nasl"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":["https://raw.githubusercontent.com/adysec/AVE/main/pocs/2016/POC-AVE-2016-0600.toml"],"repo_exp_urls":[],"has_poc":true,"has_exp":false,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/2016/AVE-2016-0600.toml"},{"ave_id":"AVE-2016-0072","file_name":"2016/AVE-2016-0072.toml","cve_id":"CVE-2016-7981","title":"SPIP 3.1.2 valider_xml.php 跨站脚本漏洞","description":"SPIP 3.1.2 及更早版本中的 valider_xml.php 文件存在跨站脚本（XSS）漏洞。远程攻击者可通过向 valider_xml 动作的 var_url 参数注入恶意 Web 脚本或 HTML 代码触发该漏洞，当管理员或其他用户访问被篡改的页面时，恶意脚本将在浏览器中执行，导致敏感信息泄露、会话劫持等危害。攻击无需身份认证，但需诱使用户点击恶意链接，属于反射型 XSS 漏洞。","severity":"MEDIUM","score":6.1,"aliases":["CVE-2016-7981"],"sources":["nuclei"],"published":"2017-01-18T17:59:00Z","updated":"2026-06-17T00:53:52Z","remediation":"升级 SPIP 至 3.1.3 或更高版本，官方已在 revisions 23200-23202 中修复 valider_xml.php 中 var_url 参数未正确过滤的问题。如无法立即升级，可在 Web 服务器层面添加 WAF 规则拦截包含恶意脚本的 var_url 参数请求作为临时缓解措施。","status":"completed","collected_at":"2026-07-27T00:00:00Z","references":["http://www.openwall.com/lists/oss-security/2016/10/05/17","http://www.openwall.com/lists/oss-security/2016/10/06/6","http://www.openwall.com/lists/oss-security/2016/10/12/7","http://www.securityfocus.com/bid/93451","https://core.spip.net/projects/spip/repository/revisions/23200","https://core.spip.net/projects/spip/repository/revisions/23201","https://core.spip.net/projects/spip/repository/revisions/23202","https://github.com/projectdiscovery/nuclei-templates/blob/main/http/cves/2016/CVE-2016-7981.yaml","https://github.com/trickest/cve/blob/be44b05b9428dc18bc0705cf60dd8d8640cd49b1/2016/CVE-2016-7981.md","https://github.com/projectdiscovery/nuclei-templates/blob/4924c84cac6ce9772babf48587bed8df9d0040d0/http/cves/2016/CVE-2016-7981.yaml","https://github.com/CVEProject/cvelistV5/blob/49bdd0da7f9ed7eb2c6a7d376de641a46364c00a/cves/2016/7xxx/CVE-2016-7981.json","https://github.com/ExpLangcn/NucleiTP/blob/2b7ecb9031a6eda4f272793045f29b339d8e0cce/CVES/medium/cve-2016-7981-2816.yaml","https://github.com/rix4uni/nucleihub-templates/blob/579a0234551b9e0e322460a62dc77bd6109e4aff/nucleihub-templates/CVE-2016-7981_2.yaml","https://github.com/0xKayala/Custom-Nuclei-Templates/blob/1940dfd29577590f076c89dec5c30d809d68f210/8001-to-9000-templates/cve-2016-7981-2815.yaml","https://github.com/ARPSyndicate/suricata-vedas/blob/fe24794ad36564b5bbc7c69101525011387b8650/2016/CVE-2016-7981.rules","https://github.com/eslerm/ubuntu-cve-tracker/blob/f17e5ebf7a87347cc68d8fae347d07409a857342/active/CVE-2016-7981","https://github.com/canonical/ubuntu-security-notices/blob/bb6cd0f1a29580d840cdb570b8b0c57cc39aac6d/osv/cve/2016/UBUNTU-CVE-2016-7981.json","https://github.com/khulnasoft-bot/OSVIC/blob/a4eeee61d1cb6e295191ee863ea67fbf018e3353/CVE/data/2016/CVE-2016-7981.json"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":[],"repo_exp_urls":[],"has_poc":false,"has_exp":false,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/2016/AVE-2016-0072.toml"}]
[{"ave_id":"AVE-2019-1200","file_name":"2019/AVE-2019-1200.toml","cve_id":"CVE-2019-3396","title":"Atlassian Confluence Widget Connector 服务端模板注入漏洞","description":"CVE-2019-3396是一个安全漏洞，影响相关产品的安全性。攻击者可能利用此漏洞执行任意代码或获取未授权访问。建议用户及时更新到最新版本以修复此问题。","severity":"CRITICAL","score":9.8,"aliases":["CVE-2019-3396"],"sources":["kev"],"published":"2019-03-25T19:29:01Z","updated":"2026-06-17T02:35:05Z","remediation":"立即升级 Confluence Server/Data Center 至 6.6.12、6.12.3、6.13.3 或 6.14.2 及以上版本。如无法升级，在 Confluence 管理后台禁用 Widget Connector 宏，或通过反向代理规则拦截包含 `_template` 参数的请求路径 `/rest/tinymce/1/macro/preview`。","status":"completed","collected_at":"2026-08-03T00:00:00Z","references":["http://packetstormsecurity.com/files/152568/Atlassian-Confluence-Widget-Connector-Macro-Velocity-Template-Injection.html","http://packetstormsecurity.com/files/161065/Atlassian-Confluence-6.12.1-Template-Injection.html","http://www.rapid7.com/db/modules/exploit/multi/http/confluence_widget_connector","https://jira.atlassian.com/browse/CONFSERVER-57974","https://www.exploit-db.com/exploits/46731/","https://www.cisa.gov/known-exploited-vulnerabilities-catalog?field_cve=CVE-2019-3396","https://www.exploit-db.com/exploits/49465","https://github.com/projectdiscovery/nuclei-templates/blob/main/http/cves/2019/CVE-2019-3396.yaml","https://github.com/trickest/cve/blob/7d40e7d94b41c478b4d1a654c7bc3bcf34fa7beb/2019/CVE-2019-3396.md","https://github.com/0xMarcio/cve/blob/986b45a0ac2dd215b3a5515fba0cebac769043dd/2019/CVE-2019-3396.md","https://github.com/nomi-sec/PoC-in-GitHub/blob/57432302d64f9bc08597d61c88fc5f900569476d/2019/CVE-2019-3396.json","https://github.com/wgpsec/AboutSecurity/blob/f3c8574e6fa1f9c1cd5aeaba5a209af796107b34/Vuln/middleware/confluence/CVE-2019-3396.md","https://github.com/Threekiii/Awesome-POC/blob/0f9e22b660cb1ea12c1c3668f9128d93e08da412/Web应用漏洞/Atlassian Confluence preview SSTI模版注入漏洞 CVE-2019-3396.md","https://github.com/cckuailong/reapoc/blob/699762e4c31d0183733f64313d8fc3be6470bd37/2019/CVE-2019-339
[{"ave_id":"AVE-2002-0543","file_name":"2002/AVE-2002-0543.toml","cve_id":"CVE-2002-1135","title":"phpWebSite 0.8.2 PHP文件包含漏洞","description":"phpWebSite 0.8.2 及更早版本中的 modsecurity.php 1.10 及更早版本存在 PHP 文件包含漏洞。远程攻击者可通过构造恶意 inc_prefix 参数，指向外部服务器上的恶意 PHP 代码，导致任意 PHP 代码执行。攻击者无需身份认证即可利用该漏洞，完全控制目标网站服务器，窃取敏感数据或植入后门。该漏洞 CVSS 评分 7.5，危害等级高，影响范围广泛。","severity":"HIGH","score":7.5,"aliases":["CVE-2002-1135"],"sources":["exploitdb"],"published":"2002-10-04T04:00:00Z","updated":"2026-06-16T21:58:47Z","remediation":"升级到 phpWebSite 0.8.3 或更高版本，该版本已修复 `modsecurity.php` 中 `inc_prefix` 参数未正确过滤远程路径的问题。如无法升级，在 `modsecurity.php` 和 `catalog/inludes/include_once.php` 中对 `inc_prefix` 参数做白名单校验，仅允许本地路径前缀（如 `./` 或 `include/`），禁止包含 `http://` 或 `ftp://` 开头的远程 URL。由于 phpWebSite 已停止维护，建议迁移至其他活跃维护的 CMS 系统（如 WordPress 或 Drupal）以持续获得安全更新。","status":"completed","collected_at":"2026-08-05T00:00:00Z","references":["http://marc.info/?l=bugtraq&m=103279980906880&w=2","http://phpwebsite.appstate.edu/article.php?sid=400","http://www.iss.net/security_center/static/10164.php","http://www.osvdb.org/3848","http://www.securityfocus.com/bid/5779","https://www.exploit-db.com/exploits/21825","https://github.com/CVEProject/cvelistV5/blob/7db8931ea0378982e66f435e269a4ed0e4efb7aa/cves/2002/1xxx/CVE-2002-1135.json","https://github.com/Patrowl/PatrowlHearsData/blob/f80eaead111eac7128eaf77e46b372cdbd675cc9/CVE/data/2002/CVE-2002-1135.json","https://github.com/LiuCan01/cve-list-pro/blob/78b55511cee3604c22d518e32822f0435d0cacc0/cve-list/CVE-2002/CVE-2002-1135","https://github.com/nomi-sec/NVD-Database/blob/23dc120c34402aaa65883c51c1d03b3cb02c20cb/2002/CVE-2002-1135.json","https://github.com/olbat/nvdcve/blob/2aff155da1d1b98876d6e9c312b912d434f32dca/nvdcve/CVE-2002-1135.json","https://github.com/opencve/opencve-kb/blob/8ed64b4e31209e933908eff50d33cf701402ff24/2002/CVE-2002-1135.json","https://github.com/fkie-cad/nvd-json-data-feeds/blob/2045bff4b424e5738e99702781803fdc8b55ff87/CVE-2002/CVE-2002-11xx/CVE-2002-1135.json","https://github.com/HORKimhab/poc-cve-collection/blob/e2cba2a029d0a53c95f0000f5eb42e0eb69717b8/2002/1xxx/CVE-2002-1135.md","https://github.com/CyberSecAI/cve_info/blob/03b7e36424574a3a9ba5fd13480a326b666a1046/2002/1xxx/CVE-2002-1135.json","https://github.com/yarencheng/cve-devops-playground/blob/b41e970743d15aec60299cbc12139ba5a0ac3bb6/content/CVE-2002-1135.md"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":[],"repo_exp_urls":[],"has_poc":false,"has_exp":false,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/2002/AVE-2002-0543.toml"},{"ave_id":"AVE-2002-0542","file_name":"2002/AVE-2002-0542.toml","cve_id":"CVE-2002-1129","title":"HP Tru64/OSF1 DXTerm 本地缓冲区溢出漏洞","description":"HP Tru64/OSF1 操作系统的 DXTerm 终端模拟器存在本地缓冲区溢出漏洞。当用户向 dxterm 程序的 -xrm 参数传递超长字符串时，可触发栈缓冲区溢出，导致攻击者能够以当前用户权限执行任意代码。该漏洞需要攻击者拥有本地系统访问权限，CVSS 评分 7.2，危害等级高。目前已有公开的利用代码，建议用户升级至最新版本或应用厂商提供的安全补丁。","severity":"HIGH","score":7.2,"aliases":["CVE-2002-1129"],"sources":["exploitdb"],"published":"2002-10-04T04:00:00Z","updated":"2026-06-16T21:58:46Z","remediation":"建议升级 HP Tru64/OSF1 操作系统至厂商发布的最新维护版本，或安装针对 DXTerm 缓冲区溢出漏洞的安全补丁（HP 安全公告相关补丁）。由于该产品已停止维护，建议迁移至受支持的操作系统平台，并在迁移前严格限制本地用户对 dxterm 程序的执行权限，仅授权可信用户使用。","status":"completed","collected_at":"2026-08-05T00:00:00Z","references":["http://archives.neohapsis.com/archives/vulnwatch/2002-q3/0122.html","http://marc.info/?l=bugtraq&m=103248659816294&w=2","http://www.iss.net/security_center/static/10148.php","http://www.securityfocus.com/bid/5746","https://www.exploit-db.com/exploits/21807"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":[],"repo_exp_urls":[],"has_poc":false,"has_exp":false,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/2002/AVE-2002-0542.toml"},{"ave_id":"AVE-2002-0538","file_name":"2002/AVE-2002-0538.toml","cve_id":"CVE-2002-1113","title":"Mantis 漏洞跟踪系统 JPGraph 远程文件包含漏洞","description":"Mantis Bug Tracker 0.15.x、0.16 及 0.17.x 版本中 summary_graph_functions.php 存在远程文件包含漏洞，远程攻击者可通过修改 g_jpgraph_path 参数指向包含恶意 PHP 代码的远程服务器，从而在目标服务器上执行任意 PHP 代码。该漏洞无需身份认证即可利用，CVSS 评分 7.5，影响所有受影响版本的 Mantis Bug Tracker 部署。","severity":"HIGH","score":7.5,"aliases":["CVE-2002-1113"],"sources":["exploitdb"],"published":"2002-10-04T04:00:00Z","updated":"2026-06-16T21:58:45Z","remediation":"建议立即升级到 Mantis Bug Tracker 0.17.4 或更高版本，该版本已修复 summary_graph_functions.php 中 g_jpgraph_path 参数未正确过滤导致的远程文件包含问题。Debian 用户可参考 DSA-153 安全公告通过 apt-get update && apt-get upgrade 更新。如无法立即升级，建议删除或重命名 summary_graph_functions.php 文件，或在 Web 服务器层面配置规则拦截包含 g_jpgraph_path 参数的请求作为临时缓解措施。","status":"completed","collected_at":"2026-08-05T00:00:00Z","references":["http://marc.info/?l=bugtraq&m=102927873301965&w=2","http://marc.info/?l=bugtraq&m=102978924821040&w=2","http://www.debian.org/security/2002/dsa-153","http://www.osvdb.org/4858","http://www.securityfocus.com/bid/5504","https://exchange.xforce.ibmcloud.com/vulnerabilities/9829","https://www.exploit-db.com/exploits/21727","https://github.com/CVEProject/cvelistV5/blob/3eae031b5df6a3c6a1cc304f5e054cd002eb1bd6/cves/2002/1xxx/CVE-2002-1113.json","https://github.com/LiuCan01/cve-list-pro/blob/78b55511cee3604c22d518e32822f0435d0cacc0/cve-list/CVE-2002/CVE-2002-1113","https://github.com/Patrowl/PatrowlHearsData/blob/5d8a0e95a20fbbbf3a45b439096d57770d841dec/CVE/data/2002/CVE-2002-1113.json","https://github.com/nomi-sec/NVD-Database/blob/23dc120c34402aaa65883c51c1d03b3cb02c20cb/2002/CVE-2002-1113.json","https://github.com/opencve/opencve-kb/blob/b7a3f185461ada4598db88be1e2c953e4d2cddec/2002/CVE-2002-1113.json","https://github.com/HORKimhab/poc-cve-collection/blob/e2cba2a029d0a53c95f0000f5eb42e0eb69717b8/2002/1xxx/CVE-2002-1113.md","https://github.com/olbat/nvdcve/blob/2aff155da1d1b98876d6e9c312b912d434f32dca/nvdcve/CVE-2002-1113.json","https://github.com/aquasecurity/vuln-list-debian/blob/2cfcf35c78e88db2a4354058a5c063daa41106c3/tracker/CVE/2002/CVE-2002-1113.json","https://github.com/CyberSecAI/cve_info/blob/03b7e36424574a3a9ba5fd13480a326b666a1046/2002/1xxx/CVE-2002-1113.json","https://github.com/fkie-cad/nvd-json-data-feeds/blob/2045bff4b424e5738e99702781803fdc8b55ff87/CVE-2002/CVE-2002-11xx/CVE-2002-1113.json"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":[],"repo_exp_urls":[],"has_poc":false,"has_exp":false,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/2002/AVE-2002-0538.toml"},{"ave_id":"AVE-2002-0537","file_name":"2002/AVE-2002-0537.toml","cve_id":"CVE-2002-1101","title":"Cisco VPN 3000 Series Concentrator 认证拒绝服务漏洞","description":"Cisco VPN 3000 系列集中器存在认证拒绝服务漏洞。该漏洞源于设备对用户名字段长度验证不充分，远程攻击者无需身份认证即可通过提交超长用户名字符串，触发设备认证模块异常，导致 VPN 集中器服务崩溃或无法响应合法请求。受影响版本包括 2.2.x、3.6(Rel) 及 3.5.5 之前的 3.x 版本。攻击者只需向目标设备的认证接口发送特制请求即可实施攻击，无需任何权限，攻击复杂度低，可造成目标设备拒绝服务，影响企业 VPN 服务的可用性。","severity":"MEDIUM","score":5.0,"aliases":["CVE-2002-1101"],"sources":["exploitdb"],"published":"2002-10-04T04:00:00Z","updated":"2026-06-16T21:58:43Z","remediation":"升级 Cisco VPN 3000 Concentrator 至 3.5.5 或更高版本，该版本已修复用户名长度未校验导致的缓冲区溢出。如无法升级，在设备 ACL 中限制对 VPN 服务的访问来源 IP，并在认证前端增加用户名长度限制（建议不超过 64 字符）作为临时缓解措施。","status":"completed","collected_at":"2026-08-05T00:00:00Z","references":["http://www.cisco.com/warp/public/707/vpn3k-multiple-vuln-pub.shtml","https://www.exploit-db.com/exploits/21770","https://github.com/trickest/cve/blob/0950a261126c1029f51ef04a190f1baacd16eb08/2002/CVE-2002-1101.md","https://github.com/CVEProject/cvelistV5/blob/3eae031b5df6a3c6a1cc304f5e054cd002eb1bd6/cves/2002/1xxx/CVE-2002-1101.json","https://github.com/LiuCan01/cve-list-pro/blob/78b55511cee3604c22d518e32822f0435d0cacc0/cve-list/CVE-2002/CVE-2002-1101","https://github.com/Patrowl/PatrowlHearsData/blob/5d8a0e95a20fbbbf3a45b439096d57770d841dec/CVE/data/2002/CVE-2002-1101.json","https://github.com/mabitoski/cve_submodules/blob/44ad7e2705b3aef1b2ffaf64bd47596c10a6c2e4/2002/CVE-2002-1101.md","https://github.com/brenonevs/prs-pentest/blob/001cf17eedeb4aad73618d3140ca1f5dc93e69b3/CVEs & POCs/2002/CVE-2002-1101.md","https://github.com/nomi-sec/NVD-Database/blob/23dc120c34402aaa65883c51c1d03b3cb02c20cb/2002/CVE-2002-1101.json","https://github.com/HORKimhab/poc-cve-collection/blob/e2cba2a029d0a53c95f0000f5eb42e0eb69717b8/2002/1xxx/CVE-2002-1101.md","https://github.com/opencve/opencve-kb/blob/b7a3f185461ada4598db88be1e2c953e4d2cddec/2002/CVE-2002-1101.json","https://github.com/olbat/nvdcve/blob/2aff155da1d1b98876d6e9c312b912d434f32dca/nvdcve/CVE-2002-1101.json"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":[],"repo_exp_urls":[],"has_poc":false,"has_exp":false,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/2002/AVE-2002-0537.toml"},{"ave_id":"AVE-2002-0536","file_name":"2002/AVE-2002-0536.toml","cve_id":"CVE-2002-1089","title":"Oracle Reports Server 信息泄露漏洞","description":"Oracle Reports Server 6.0.8 和 9.0.2 版本中的 rwcgi60 CGI 程序存在信息泄漏漏洞。该程序默认配置下会泄露服务器完整路径名等敏感信息，远程攻击者无需身份认证即可通过发送特制 HTTP 请求获取这些信息，进而利用泄露的路径信息辅助实施进一步的攻击。该漏洞 CVSS 评分 5.0，危害等级中危。","severity":"MEDIUM","score":5.0,"aliases":["CVE-2002-1089"],"sources":["exploitdb"],"published":"2002-10-04T04:00:00Z","updated":"2026-06-16T21:58:42Z","remediation":"Oracle Reports Server 6.0.8/9.0.2 已停止维护，建议升级到 Oracle Reports 12c (12.2.1.4) 或更高版本。如无法升级，在 Web 服务器层面限制对 rwcgi60 CGI 程序的访问，仅允许受信 IP 调用，并配置 Web 服务器隐藏路径信息（如 Apache 的 ServerTokens Prod 和 ServerSignature Off）。","status":"completed","collected_at":"2026-08-05T00:00:00Z","references":["http://archives.neohapsis.com/archives/bugtraq/2002-07/0203.html","http://www.iss.net/security_center/static/9628.php","http://www.securityfocus.com/bid/5262","https://www.exploit-db.com/exploits/21627","https://github.com/CVEProject/cvelistV5/blob/3eae031b5df6a3c6a1cc304f5e054cd002eb1bd6/cves/2002/1xxx/CVE-2002-1089.json","https://github.com/Patrowl/PatrowlHearsData/blob/5d8a0e95a20fbbbf3a45b439096d57770d841dec/CVE/data/2002/CVE-2002-1089.json","https://github.com/LiuCan01/cve-list-pro/blob/78b55511cee3604c22d518e32822f0435d0cacc0/cve-list/CVE-2002/CVE-2002-1089","https://github.com/nomi-sec/NVD-Database/blob/23dc120c34402aaa65883c51c1d03b3cb02c20cb/2002/CVE-2002-1089.json","https://github.com/olbat/nvdcve/blob/2aff155da1d1b98876d6e9c312b912d434f32dca/nvdcve/CVE-2002-1089.json","https://github.com/opencve/opencve-kb/blob/b7a3f185461ada4598db88be1e2c953e4d2cddec/2002/CVE-2002-1089.json","https://github.com/fkie-cad/nvd-json-data-feeds/blob/2045bff4b424e5738e99702781803fdc8b55ff87/CVE-2002/CVE-2002-10xx/CVE-2002-1089.json","https://github.com/HORKimhab/poc-cve-collection/blob/c45038e15e6e81771cce5512f28070ebf02ca969/2002/1xxx/CVE-2002-1089.md","https://github.com/CyberSecAI/cve_info/blob/03b7e36424574a3a9ba5fd13480a326b666a1046/2002/1xxx/CVE-2002-1089.json","https://github.com/CVEProject/cvelist-dev/blob/5b8fbb570438e8094550205589cc6f1d122acc94/2002/1xxx/CVE-2002-1089.json"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":["https://raw.githubusercontent.com/adysec/AVE/main/pocs/2002/POC-AVE-2002-0536.toml"],"repo_exp_urls":[],"has_poc":true,"has_exp":false,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/2002/AVE-2002-0536.toml"},{"ave_id":"AVE-2002-0535","file_name":"2002/AVE-2002-0535.toml","cve_id":"CVE-2002-1079","title":"Aprelium Abyss Web Server 目录遍历漏洞","description":"Abyss Web Server 1.0.3 存在目录遍历漏洞，远程攻击者无需身份认证即可通过向服务器发送包含 `..\\`（点-点-反斜杠）序列的 HTTP GET 请求，绕过路径限制读取服务器上的任意文件。该漏洞源于服务器对 URL 中编码的反斜杠字符处理不当，未能正确过滤目录跳转序列，导致攻击者可遍历至 Web 根目录之外，读取系统敏感文件如配置文件、密码文件等，造成信息泄露。CVSS 评分 5.0，危害等级中等。","severity":"MEDIUM","score":5.0,"aliases":["CVE-2002-1079"],"sources":["exploitdb"],"published":"2002-10-04T04:00:00Z","updated":"2026-06-16T21:58:41Z","remediation":"[id]\nave_id = \"AVE-2002-00001\"\naliases = [\"CVE-2002-1079\"]\n\n[basic]\ntitle = \"Abyss Web Server 1.0.3 编码反斜杠目录遍历漏洞\"\ndescription = \"Abyss Web Server 1.0.3 存在目录遍历漏洞。远程攻击者可通过向 HTTP GET 请求发送包含 URL 编码反斜杠（%5c）的 ..\\\\（点点反斜杠）序列，绕过 Web 根目录的路径限制，读取服务器上的任意文件。该漏洞源于服务器未能正确过滤反斜杠字符作为目录分隔符，攻击者无需身份验证即可通过网络远程利用，可能导致敏感信息泄露。\"\nseverity = \"MEDIUM\"\nscore = 5.0\nsources = [\"cve\", \"exploitdb\"]\npublished = \"2002-10-04\"\nupdated = \"2026-06-16\"\nremediation = \"升级到 Abyss Web Server 1.0.3.3 或更高版本。厂商 Aprelium 已发布补丁 patch1033，修复了服务器对编码反斜杠字符的路径处理逻辑，建议立即更新。\"\n\n[references]\nurls = [\"http://archives.neohapsis.com/archives/bugtraq/2002-08/0229.html\", \"http://www.aprelium.com/news/patch1033.html\", \"http://www.iss.net/security_center/static/9940.php\", \"http://www.iss.net/security_center/static/9941.php\", \"http://www.osvdb.org/3285\", \"http://www.securityfocus.com/bid/5547\", \"https://www.exploit-db.com/exploits/21735\"]\n\n[exploit]\npoc_urls = [\"https://www.exploit-db.com/exploits/21735\"]\nexp_urls = [\"https://www.exploit-db.com/exploits/21735\"]\n\n[meta]\nstatus = \"completed\"\ncollected_at = \"2026-08-05T00:00:00Z\"\n\n[info]\nid = \"POC-AVE-2002-00001\"\nname = \"CVE-2002-1079 PoC\"\nauthor = \"AVE\"\nseverity = \"medium\"\ntags = [\"cve-2002-1079\", \"directory-traversal\", \"abyss\"]\ndescription = \"检测 Abyss Web Server 1.0.3 编码反斜杠目录遍历漏洞，通过发送包含 %5c 编码反斜杠的路径遍历请求尝试读取 Windows 系统文件\"\nvuln_id = [\"CVE-2002-1079\", \"AVE-2002-00001\"]\n\n[poc]\nlogic = \"any\"\n\n[[poc.requests]]\nprotocol = \"http\"\nmethod = \"GET\"\npath = \"/%5c%2e%2e%5c%2e%2e%5c%2e%2e%5c%2e%2e%5cwinnt%5cwin.ini\"\nheaders = { \"User-Agent\" = \"AVE/1.0\" }\n\n[[poc.requests.matchers]]\ntype = \"word\"\nwords = [\"fonts\", \"extensions\"]\nexpect = true\n\n[[poc.requests]]\nprotocol = \"http\"\nmethod = \"GET\"\npath = \"/..\\\\..\\\\..\\\\..\\\\..\\\\winnt\\\\win.ini\"\nheaders = { \"User-Agent\" = \"AVE/1.0\" }\n\n[[poc.requests.matchers]]\ntype = \"word\"\nwords = [\"fonts\", \"extensions\"]\nexpect = true\n\n[info]\nid = \"EXP-AVE-2002-00001\"\nname = \"CVE-2002-1079 EXP\"\nauthor = \"AVE\"\nseverity = \"medium\"\ntags = [\"cve-2002-1079\", \"directory-traversal\", \"abyss\"]\ndescription = \"利用 Abyss Web Server 1.0.3 编码反斜杠目录遍历漏洞读取服务器任意文件\"\nvuln_id = [\"CVE-2002-1079\", \"AVE-2002-00001\"]\n\n[poc]\nlogic = \"any\"\n\n[[poc.requests]]\nprotocol = \"http\"\nmethod = \"GET\"\npath = \"/%5c%2e%2e%5c%2e%2e%5c%2e%2e%5c%2e%2e%5cwinnt%5cwin.ini\"\nheaders = { \"User-Agent\" = \"AVE/1.0\" }\n\n[[poc.requests.matchers]]\ntype = \"word\"\nwor
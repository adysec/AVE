[{"ave_id":"AVE-2001-0171","file_name":"2001/AVE-2001-0171.toml","cve_id":"CVE-2001-0419","title":"Oracle Application Server ndwfn4.so 缓冲区溢出漏洞","description":"Oracle Application Server 4.0.8.2 中 iPlanet Web Server (iWS) 4.1 的共享库 ndwfn4.so 存在缓冲区溢出漏洞。远程攻击者可通过向应用服务器发送特制的超长 HTTP 请求（如 /jsp/ 路径）触发该漏洞，导致任意命令执行。攻击无需身份认证，仅需网络访问即可利用，危害严重。受影响版本包括 Oracle Application Server 4.0.8.2 及配套的 iPlanet Web Server 4.1。","severity":"HIGH","score":7.5,"aliases":["CVE-2001-0419"],"sources":["exploitdb"],"published":"2001-07-02T04:00:00Z","updated":"2026-06-16T21:54:16Z","remediation":"升级 Oracle Application Server 至 4.0.8.2 以上补丁版本，或迁移至 Oracle AS 10g (9.0.4) 及以上版本。如无法升级，在 Web 服务器层面配置请求 URI 长度限制（如 LimitRequestLine 4096），并禁用不必要的 JSP 处理模块 ndwfn4.so。","status":"completed","collected_at":"2026-07-22T00:00:00Z","references":["http://marc.info/?l=bugtraq&m=98692227816141&w=2","http://www.securityfocus.com/bid/2569","https://www.exploit-db.com/exploits/20747","https://github.com/CVEProject/cvelistV5/blob/7d4778b18ea29de57c8a889212050a9d38e2d2cb/cves/2001/0xxx/CVE-2001-0419.json","https://github.com/LiuCan01/cve-list-pro/blob/78b55511cee3604c22d518e32822f0435d0cacc0/cve-list/CVE-2001/CVE-2001-0419","https://github.com/yarencheng/cve-devops-playground/blob/cbe73d6bdcced13ea57f08566d6bbf5345864f7e/content/CVE-2001-0419.md","https://github.com/Patrowl/PatrowlHearsData/blob/1b84eedba993546f37a880c6d2d084176a1f04a7/CVE/data/2001/CVE-2001-0419.json","https://github.com/github/advisory-database/blob/1684cfa32e43376c48beb06819bce86de6ba421b/advisories/unreviewed/2022/04/GHSA-jrrq-72m7-2wjr/GHSA-jrrq-72m7-2wjr.json","https://github.com/marcellodesales/aibbp-reverse-engineer/blob/960f610d597aae9fec1cc5f03c68679be00c222d/reverse_engineer/invicti/vulnerabilities/db/vulnerabilities/vdb/2001/0xxx/cve-2001-0419.yaml","https://github.com/blackhook/nessus-plugins/blob/64177d96abbb07c58cf7e131046b067ebc61fcb5/O/oas_overflow.nasl","https://github.com/intSpLoiT/intframework/blob/eabaa799d0260aa52b735fa9769266d1ce4b64ef/modules/cve_list.txt","https://github.com/KTZgraph/sarenka/blob/f1fb931ab722d6c096d581ed6e3c5966d799fbaa/sarenka/feeds/cve_details/cve_all_details_151100_151200.json","https://github.com/andreafioraldi/ToolsForCyberChallenge/blob/197d3dfd204cf1b9d1af1451455c8831c3ff9948/generated/files_4.list.dict"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":[],"repo_exp_urls":[],"has_poc":false,"has_exp":false,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/2001/AVE-2001-0171.toml"},{"ave_id":"AVE-2001-0170","file_name":"2001/AVE-2001-0170.toml","cve_id":"CVE-2001-0418","title":"NCM Content Management System content.pl SQL注入漏洞","description":"NCM Content Management System 中的 content.pl 脚本未对 id 参数进行有效过滤，存在 SQL 注入漏洞。远程攻击者无需身份认证即可向 id 参数插入特制 SQL 语句，实现对内容数据库的任意数据读取，导致敏感信息泄露。该漏洞攻击复杂度低，仅需构造恶意 HTTP 请求即可触发，ExploitDB 上已有公开利用代码。","severity":"MEDIUM","score":5.0,"aliases":["CVE-2001-0418"],"sources":["exploitdb"],"published":"2001-07-02T04:00:00Z","updated":"2026-06-16T21:54:16Z","remediation":"该产品已停止维护，无官方补丁。建议立即将 content.pl 脚本中 id 参数改为整数类型检查（如 `/^\\\\d+$/`），并对所有用户输入使用参数化查询或 prepared statement 替代字符串拼接。部署 Web 应用防火墙 (WAF) 拦截包含 SQL 特征的请求。考虑迁移至受支持的 CMS 平台。","status":"completed","collected_at":"2026-07-22T00:00:00Z","references":["http://archives.neohapsis.com/archives/bugtraq/2001-04/0223.html","http://www.securityfocus.com/bid/2584","https://www.exploit-db.com/exploits/20752","https://github.com/CVEProject/cvelistV5/blob/7d4778b18ea29de57c8a889212050a9d38e2d2cb/cves/2001/0xxx/CVE-2001-0418.json","https://github.com/LiuCan01/cve-list-pro/blob/78b55511cee3604c22d518e32822f0435d0cacc0/cve-list/CVE-2001/CVE-2001-0418","https://github.com/yarencheng/cve-devops-playground/blob/cbe73d6bdcced13ea57f08566d6bbf5345864f7e/content/CVE-2001-0418.md","https://github.com/Patrowl/PatrowlHearsData/blob/1b84eedba993546f37a880c6d2d084176a1f04a7/CVE/data/2001/CVE-2001-0418.json","https://github.com/github/advisory-database/blob/1684cfa32e43376c48beb06819bce86de6ba421b/advisories/unreviewed/2022/04/GHSA-vh
fee Email Gateway 或同类替代方案）。如无法升级，可在 SMTP 网关或防火墙上配置规则，过滤收件人地址中包含连续 `%20` 编码空格的异常邮件，并限制 SMTP 端口的访问来源 IP。","status":"completed","collected_at":"2026-08-03T00:00:00Z","references":["http://archives.neohapsis.com/archives/bugtraq/2000-11/0324.html","http://www.securityfocus.com/bid/1999","https://www.exploit-db.com/exploits/20432","https://github.com/CVEProject/cvelistV5/blob/27584df20575115093a915d82c76b5107dd9d51e/cves/2000/1xxx/CVE-2000-1129.json","https://github.com/Patrowl/PatrowlHearsData/blob/c31c0a9b9af147bd58078ebf7769418f19d3f2e1/CVE/data/2000/CVE-2000-1129.json","https://github.com/LiuCan01/cve-list-pro/blob/78b55511cee3604c22d518e32822f0435d0cacc0/cve-list/CVE-2000/CVE-2000-1129","https://github.com/nomi-sec/NVD-Database/blob/23dc120c34402aaa65883c51c1d03b3cb02c20cb/2000/CVE-2000-1129.json","https://github.com/olbat/nvdcve/blob/fe7f195231342e1e88104679c53c965e9a67ac35/nvdcve/CVE-2000-1129.json","https://github.com/fkie-cad/nvd-json-data-feeds/blob/b6c80ad7b47e52f64ae2ee2b20e56d7eaaaa57fe/CVE-2000/CVE-2000-11xx/CVE-2000-1129.json","https://github.com/opencve/opencve-kb/blob/230692da2420d9855e520154fdb81ed9f2cb832a/2000/CVE-2000-1129.json","https://github.com/HORKimhab/poc-cve-collection/blob/1d7706ed603ab73481cbc20e5bea092e02e7c9be/2000/1xxx/CVE-2000-1129.md","https://github.com/CVEProject/cvelist-dev/blob/5b8fbb570438e8094550205589cc6f1d122acc94/2000/1xxx/CVE-2000-1129.json","https://github.com/CyberSecAI/cve_info/blob/03b7e36424574a3a9ba5fd13480a326b666a1046/2000/1xxx/CVE-2000-1129.json"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":[],"repo_exp_urls":[],"has_poc":false,"has_exp":false,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/2000/AVE-2000-0819.toml"}]
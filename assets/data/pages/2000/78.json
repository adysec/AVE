ob/23dc120c34402aaa65883c51c1d03b3cb02c20cb/2000/CVE-2000-0041.json","https://github.com/KTZgraph/sarenka/blob/f1fb931ab722d6c096d581ed6e3c5966d799fbaa/sarenka/feeds/cwe_details/cwe_details_100_200.json","https://github.com/leego972/titanai/blob/afa5b2310463aae5781d3fd9408071bf38e79806/data/raw/corpus_D_cyber/nvd_cve_000971.txt","https://github.com/security-commits/security-patches-dataset/blob/e93fcdcc8c9b91785f962a06d66b7ee623780245/data/cve-details/year/1999.csv","https://github.com/oasis-open/cti-stix-common-objects/blob/55ba7598cbd5a52577b6887871505d931d85cb61/objects/vulnerability/vulnerability--f6072b43-42b8-498b-8bf1-55941fa1ac81.json"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":[],"repo_exp_urls":[],"has_poc":false,"has_exp":false,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/2000/AVE-2000-0037.toml"},{"ave_id":"AVE-2000-0035","file_name":"2000/AVE-2000-0035.toml","cve_id":"CVE-2000-0037","title":"Majordomo 本地权限提升漏洞","description":"Majordomo 是一款邮件列表管理软件，其 wrapper 组件存在本地权限提升漏洞。本地攻击者可通过向 wrapper 传递 `-C` 参数指定任意配置文件，从而以 Majordomo 运行权限执行恶意操作，获取非授权访问权限。该漏洞影响 Majordomo 1.94.4 及 1.94.5 版本，CVSS 评分 4.6，危害等级中危。攻击者需拥有本地系统访问权限方可利用。","severity":"MEDIUM","score":4.6,"aliases":["CVE-2000-0037"],"sources":["redhat"],"published":"1999-12-28T05:00:00Z","updated":"2026-06-16T21:50:52Z","remediation":"建议立即升级至 Majordomo 2.x 或更高版本（1.94.4/1.94.5 已不再维护），该漏洞在后续版本中已修复。使用 Red Hat Linux 的系统请安装 RHSA-2000-005 安全更新。如无法升级，可移除 wrapper 程序的 setuid 权限（`chmod u-s /usr/bin/wrapper`），并将 wrapper 文件权限设为仅 root 可执行（`chmod 700 /usr/bin/wrapper`），同时确保 Majordomo 配置目录仅对邮件管理员可写。","status":"completed","collected_at":"2026-07-22T00:00:00Z","references":["http://marc.info/?l=bugtraq&m=94780294009285&w=2","http://www.redhat.com/support/errata/RHSA-2000-005.html","http://www.securityfocus.com/bid/903","https://www.exploit-db.com/exploits/19700","https://github.com/CVEProject/cvelistV5/blob/bf570d3b8e47bf0003b46684217cf02c76e2c7f4/cves/2000/0xxx/CVE-2000-0037.json","https://github.com/LiuCan01/cve-list-pro/blob/78b55511cee3604c22d518e32822f0435d0cacc0/cve-list/CVE-2000/CVE-2000-0037","https://github.com/yarencheng/cve-devops-playground/blob/cbe73d6bdcced13ea57f08566d6bbf5345864f7e/content/CVE-2000-0037.md","https://github.com/Patrowl/PatrowlHearsData/blob/6af0515548db3ee9e7e86d58b079762631fa8897/CVE/data/2000/CVE-2000-0037.json","https://github.com/github/advisory-database/blob/1721417c5dc7c1cbf858e5ea5a5245ea62e70cce/advisories/unreviewed/2022/04/GHSA-58v6-mw8v-65hc/GHSA-58v6-mw8v-65hc.json","https://github.com/intSpLoiT/intframework/blob/eabaa799d0260aa52b735fa9769266d1ce4b64ef/modules/cve_list.txt","https://github.com/olbat/nvdcve/blob/5b92f5917a4a825187ccaac594f43456a77ea8f3/nvdcve/CVE-2000-0037.json","https://github.com/KTZgraph/sarenka/blob/f1fb931ab722d6c096d581ed6e3c5966d799fbaa/sarenka/feeds/cve_details/cve_all_details_154000_154100.json","https://github.com/andreafioraldi/ToolsForCyberChallenge/blob/197d3dfd204cf1b9d1af1451455c8831c3ff9948/generated/files_2.list.dict","https://github.com/security-commits/security-patches-dataset/blob/e93fcdcc8c9b91785f962a06d66b7ee623780245/data/cve-details/year/1999.csv"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":[],"repo_exp_urls":[],"has_poc":false,"has_exp":false,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/2000/AVE-2000-0035.toml"}]
VE/BELL-CVE-2025-0624.json"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":[],"repo_exp_urls":[],"has_poc":false,"has_exp":false,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/2025/AVE-2025-0402.toml"},{"ave_id":"AVE-2025-0447","file_name":"2025/AVE-2025-0447.toml","cve_id":"CVE-2025-1118","title":"GNU GRUB2 安全启动锁定绕过漏洞","description":"Grub2 引导加载程序在启用 Secure Boot 锁定模式时存在信任边界违反漏洞（CWE-501）。由于 dump 命令未在 lockdown 模式下被正确拦截，已获得高权限的攻击者可通过本地访问执行 dump 命令读取任意内存信息，从而提取内存中的加密签名、盐值及其他敏感数据。该漏洞影响 grub2 0 至 2.12 版本，CVSS 评分 4.4，危害等级中危。Red Hat 已发布安全更新 RHSA-2025:16154 修复此问题，建议用户升级至修复版本。","severity":"MEDIUM","score":4.4,"aliases":["CVE-2025-1118"],"sources":["msrc"],"published":"2025-02-19T18:15:24Z","updated":"2026-06-30T00:16:54Z","remediation":"建议将 grub2 升级至修复版本：RHEL 10 升级至 grub2-2.12-15.el10_0，Debian bullseye 升级至 2.06-3~deb11u7、bookworm 升级至 2.06-13+deb12u2、sid 升级至 2.14-3。如无法立即升级，可在 UEFI 固件设置中禁用 Secure Boot 后限制物理访问权限作为临时缓解。","status":"completed","collected_at":"2026-07-27T00:00:00Z","references":["https://access.redhat.com/errata/RHSA-2025:16154","https://access.redhat.com/security/cve/CVE-2025-1118","https://bugzilla.redhat.com/show_bug.cgi?id=2346137","https://git.savannah.gnu.org/cgit/grub.git/commit/?id=34824806ac6302f91e8cabaa41308eaced25725f","https://lists.gnu.org/archive/html/grub-devel/2025-02/msg00024.html","https://github.com/trickest/cve/blob/be44b05b9428dc18bc0705cf60dd8d8640cd49b1/2025/CVE-2025-1118.md","https://github.com/CVEProject/cvelistV5/blob/933422a5f82611777877a3549b9b8e3c7d70117d/cves/2025/1xxx/CVE-2025-1118.json","https://github.com/NixOS/nixpkgs/blob/8507ef13c07fc501e802cd01409a63c7372b095c/pkgs/by-name/gr/grub2/package.nix","https://github.com/neuvector/vul-source/blob/ada0c6c45d02a82e11f6f46403716f0946c37f98/ubuntu-cve-tracker/active/CVE-2025-1118","https://github.com/cisagov/vulnrichment/blob/e1d7afb428742628d991f2465e712a059beb8d79/2025/1xxx/CVE-2025-1118.json","https://github.com/openssl/openssl/blob/544e28ee06ac247e8fa02b46e306145d1c52cf17/NEWS.md","https://github.com/lgirdk/poky/blob/a7331c399252c8b365e51290c8eba3d2f6aa6fa1/meta/recipes-bsp/grub/files/CVE-2025-1118.patch","https://github.com/microsoft/azurelinux/blob/b1937ff37cca040858bab5da20d395f6f93139fd/specs/g/grub2/grub2.spec","https://github.com/sec-dojo-com/cve-poc/blob/1c2e0105dfc8043b137c91cc2d5ac23317d19c53/pocs/2025/CVE-2025-1118.md","https://github.com/bell-sw/osv-database/blob/913667a73bdbecec80569e2765753066c820c678/BELL-CVE/BELL-CVE-2025-1118.json","https://github.com/metadust/CVE-2025-11187","https://github.com/x-stp/cves-2025-11187_15467_69418"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":[],"repo_exp_urls":[],"has_poc":false,"has_exp":false,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/2025/AVE-2025-0447.toml"},{"ave_id":"AVE-2025-0592","file_name":"2025/AVE-2025-0592.toml","cve_id":"CVE-2025-1426","title":"Google Chrome GPU 堆缓冲区溢出漏洞","description":"Google Chrome Android 版本 133.0.6943.126 之前及基于 Chromium 的 Microsoft Edge 133.0.3065.82 之前版本中，GPU 组件存在堆缓冲区溢出漏洞（CWE-122）。远程攻击者可通过诱导用户访问精心构造的恶意 HTML 页面，触发 GPU 进程中的堆缓冲区溢出导致堆内存损坏，进而可能实现远程代码执行。攻击向量为网络（AV:N），攻击复杂度低（AC:L），无需权限（PR:N）但需要用户交互（UI:R），CVSS 3.1 评分 8.8（HIGH），机密性/完整性/可用性影响均为高。影响范围涵盖 Android 版 Chrome 及基于 Chromium 的 Edge 浏览器，Google 已在 133.0.6943.126 版本中修复该漏洞。","severity":"HIGH","score":8.8,"aliases":["CVE-2025-1426"],"sources":["msrc"],"published":"2025-02-19T17:15:15Z","updated":"2026-06-17T08:39:06Z","remediation":"建议立即将 Android 版 Google Chrome 升级至 133.0.6943.126 或更高版本（通过 Google Play 商店更新）；Windows/macOS/Linux 用户同步升级 Chrome 至 133.0.6943.126 及以上版本；Microsoft Edge 用户升级至 133.0.3065.82 或更高版本。若无法立即更新，可暂时在浏览器设置中禁用 GPU 硬件加速（设置 → 系统 → 关闭\"在可用时使用图形加速\"），并避免访问不可信网页，作为临时缓解措施。","status":"completed","collected_at":"2026-07-30T00:00:00Z","references":["https://chromereleases.googleblog.com/2025/02/stable-channel-update-for-desktop_18.html","https://issues.chromium.org/issues/383465163","https://github.com/r0binak/CVE-2025-14269","https://github.com/trickest/cve/blob/b349e2ac98435c78e6eec698cf95df82dacb0ca1/2025/CVE-2025-1426.md","https://github.com/CVEProject/cvelistV5/blob/09e3a6fe44c91a901bc5c246ef5d5222a6fe5bff/cves/2025/1xxx/CVE-2025-1426.json","https://github.com/cisagov/vulnrichment/blob/5586dd7f238e688df5e045b93ec7484d63fd140a/2025/1xxx/CVE-2025-1426.json","https://github.com/trickest/cve/blob/b349e2ac98435c78e6eec698cf95df82dacb0ca1/2025/CVE-2025-14261.md","https://github.com/Patrowl/PatrowlHearsData/blob/62ba6fb67d4752eaef931a307acc18168885921e/CVE/data/2025/CVE-2025-1426.json","https://github.com/Patrowl/PatrowlHearsData/blob/62ba6fb67d4752eaef931a307acc18168885921e/SSVC/data/2025/CVE-2025-1426.json","https://github.com/sec-dojo-com/cve-poc/blob/6d9e48809bb56eb829c7d184fbf6c6fd45cd04df/pocs/2025/CVE-2025-1426.md","https://github.com/anchore/nvd-data-overrides/blob/623e12f4150ecd716e9b256ef9b2048c8bc52c64/data/2025/CVE-2025-1426.json","https://github.com/canonical/ubuntu-security-notices/blob/6aa47d5c79b2a23b9237c2de360f7accd707806c/vex/cve/2025/CVE-2025-1426.json","https://github.com/nomi-sec/NVD-Database/blob/23dc120c34402aaa65883c51c1d03b3cb02c20cb/2025/CVE-2025-1426.json"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":[],"repo_exp_urls":[],"has_poc":false,"has_exp":false,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/2025/AVE-2025-0592.toml"},{"ave_id":"AVE-2025-0422","file_name":"2025/AVE-2025-0422.toml","cve_id":"CVE-2025-1006","title":"Google Chrome Network 释放后使用漏洞","description":"Google Chrome 的 Network 组件存在释放后重用（Use After Free）漏洞。远程攻击者可通过构造特制的 Web 应用诱导用户访问，成功利用该漏洞可触发堆内存破坏，导致信息泄露、任意代码执行或拒绝服务。该漏洞影响 Chrome 133.0.6943.126 之前版本，CVSS 评分 8.8，危害等级高。用户需交互（点击恶意链接或访问恶意页面）方可触发，Google 已在 2025 年 2 月发布安全更新修复。","severity":"HIGH","score":8.8,"aliases":["CVE-2025-1006"],"sources":["msrc"],"published":"2025-02-19T17:15:15Z","updated":"2026-06-17T08:38:12Z","remediation":"升级 Google Chrome 至 133.0.6943.126 或更高版本，可通过「设置→关于 Chrome」自动检查更新。使用 Microsoft Edge 的用户应升级至 133.0.3065.82 或更高版本。基于 Chromium 的第三方浏览器（如 Opera、Brave）请关注厂商对应安全更新。如无法立即更新，可禁用 WebRTC 或限制不可信网页加载作为临时缓解措施。","status":"completed","collected_at":"2026-07-27T00:00:00Z","references":["https://chromereleases.googleblog.com/2025/02/stable-channel-update-for-desktop_18.html","https://issues.chromium.org/issues/390590778","https://github.com/trickest/cve/blob/be44b05b9428dc18bc0705cf60dd8d8640cd49b1/2025/CVE-2025-1006.md","https://github.com/CVEProject/cvelistV5/blob/0db929612f090dc6aa0346061c42364c4634c480/cves/2025/1xxx/CVE-2025-1006.json","https://github.com/cisagov/vulnrichment/blob/12b56937c03071ca373f3f6a59d2f43e819052a3/2025/1xxx/CVE-2025-1006.json","https://github.com/neuvector/vul-source/blob/83b6758c208f8fd7e22b7c88e002c3658ef467b8/ubuntu-cve-tracker/retired/CVE-2025-1006","https://github.com/sec-dojo-com/cve-poc/blob/1c2e0105dfc8043b137c91cc2d5ac23317d19c53/pocs/2025/CVE-2025-1006.md","https://github.com/alpinelinux/aports/blob/a776c2f93aca32bd4efdcb44fddb0c44dc7e1c5a/community/qt6-qtwebengine/APKBUILD","https://github.com/github/advisory-database/blob/d91e95989ea5d3a9186ceb621d53a71dff03cab4/advisories/unreviewed/2025/02/GHSA-3267-gx25-884x/GHSA-3267-gx25-884x.json","https://github.com/imSkows/Cyber-Vulnerability-Analysis-Data/blob/db26c44c5f45c25514223a46675daec7eea03092/data/mitre/CVE-2025-1006","https://github.com/Patrowl/PatrowlHearsData/blob/bb772dcb04525a1a88049530e1b1081f8633cb88/CVE/data/2025/CVE-2025-1006.json","https://github.com/gelusus/wxvl/blob/adf269d0776d63ad63598085918a36e4953f7c9c/doc/2025-02/%E6%AF%8F%E5%91%A8%E7%BD%91%E7%BB%9C%E5%AE%89%E5%85%A8%E7%AE%80%E8%AE%AF%20(%202025%E5%B9%B4%20%E7%AC%AC8%E5%91%A8%20).md"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":[],"repo_exp_urls":[],"has_poc":false,"has_exp":false,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/2025/AVE-2025-0422.toml"},{"ave_id":"AVE-2025-0421","file_name":"2025/AVE-2025-0421.toml","cve_id":"CVE-2025-0999","title":"Google Chrome V8 堆缓冲区溢出漏洞","description":"Google Chrome 的 V8 JavaScript 引擎存在堆缓冲区溢出漏洞，远程攻击者可通过构造特制的 HTML 页面诱导用户访问，触发 V8 引擎在处理 JavaScript 对象时发生堆内存越界写入，导致
ithub.com/github/advisory-database/blob/29919db3f954d9ce9be0e7e3cf177436392d45d3/advisories/unreviewed/2022/04/GHSA-5554-grfx-fmf4/GHSA-5554-grfx-fmf4.json","https://github.com/xqcyberscore/nvt/blob/978f6a9acb495d7d669239530ffe6da5d631f4da/pre2008/eftp_bufferoverflow.nasl","https://github.com/nomi-sec/NVD-Database/blob/23dc120c34402aaa65883c51c1d03b3cb02c20cb/2001/CVE-2001-1112.json","https://github.com/KTZgraph/sarenka/blob/f1fb931ab722d6c096d581ed6e3c5966d799fbaa/sarenka/feeds/cve_details/cve_all_details_151600_151700.json","https://github.com/andreafioraldi/ToolsForCyberChallenge/blob/197d3dfd204cf1b9d1af1451455c8831c3ff9948/generated/files_5.list.dict","https://github.com/oasis-open/cti-stix-common-objects/blob/55ba7598cbd5a52577b6887871505d931d85cb61/objects/vulnerability/vulnerability--a2aa195f-0fa0-4b7d-9726-b56b7beff9d9.json"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":[],"repo_exp_urls":[],"has_poc":false,"has_exp":false,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/2001/AVE-2001-0463.toml"},{"ave_id":"AVE-2001-0462","file_name":"2001/AVE-2001-0462.toml","cve_id":"CVE-2001-1109","title":"EFTP Server 2.0.7.337 目录遍历漏洞","description":"EFTP Server 2.0.7.337 存在目录遍历漏洞，远程认证用户可通过在 LIST、QUOTE SIZE 和 QUOTE MDTM 命令参数中注入 `..`（点点）序列来遍历服务器目录结构，从而泄露服务器上的敏感文件与目录信息。攻击者只需拥有有效认证凭据即可利用该漏洞，无需其他特殊权限。该漏洞影响 EFTP Server 2.0.7.337 版本，CVSS 评分 7.5，危害等级高，可导致敏感信息泄露，为后续攻击提供铺垫。目前官方已发布更新版本修复此问题。","severity":"HIGH","score":7.5,"aliases":["CVE-2001-1109"],"sources":["exploitdb"],"published":"2001-09-12T04:00:00Z","updated":"2026-06-16T21:55:36Z","remediation":"EFTP 2.0.7.337 已停止维护且厂商官网已失效，建议立即停止使用该软件，迁移至仍受支持的 FTP 服务器（如 vsftpd、ProFTPD 或 FileZilla Server）。如无法立即迁移，可在 FTP 服务端配置中限制 LIST、QUOTE SIZE、QUOTE MDTM 命令的执行权限，同时在防火墙层面将 FTP 端口（默认 21）的访问源 IP 限制为可信白名单，并禁用匿名或弱认证账户。","status":"completed","collected_at":"2026-07-27T00:00:00Z","references":["http://www.eftp.org/releasehistory.html","http://www.securityfocus.com/archive/1/213647","http://www.securityfocus.com/bid/3331","http://www.securityfocus.com/bid/3333","https://exchange.xforce.ibmcloud.com/vulnerabilities/7113","https://exchange.xforce.ibmcloud.com/vulnerabilities/7114","https://www.exploit-db.com/exploits/21110","https://github.com/CVEProject/cvelistV5/blob/4a22bba3217932039300edbc77cd188c415d71c8/cves/2001/1xxx/CVE-2001-1109.json","https://github.com/LiuCan01/cve-list-pro/blob/78b55511cee3604c22d518e32822f0435d0cacc0/cve-list/CVE-2001/CVE-2001-1109","https://github.com/HORKimhab/poc-cve-collection/blob/c144cc7f0a439e059cbec31e55f668a8db4215cb/2001/1xxx/CVE-2001-1109.md","https://github.com/Patrowl/PatrowlHearsData/blob/7418aa4f1c4590a239ce7ccd2c9efba72e268cc5/CVE/data/2001/CVE-2001-1109.json","https://github.com/github/advisory-database/blob/29919db3f954d9ce9be0e7e3cf177436392d45d3/advisories/unreviewed/2022/04/GHSA-6pxh-jrxq-q8j6/GHSA-6pxh-jrxq-q8j6.json","https://github.com/yarencheng/cve-devops-playground/blob/c54e59752dddfc9aa36c13774164384cfa0d1f04/content/CVE-2001-1109.md","https://github.com/xqcyberscore/nvt/blob/978f6a9acb495d7d669239530ffe6da5d631f4da/pre2008/eftp_root_disclosure.nasl","https://github.com/KTZgraph/sarenka/blob/f1fb931ab722d6c096d581ed6e3c5966d799fbaa/sarenka/feeds/cve_details/cve_all_details_151500_151600.json","https://github.com/nomi-sec/NVD-Database/blob/23dc120c34402aaa65883c51c1d03b3cb02c20cb/2001/CVE-2001-1109.json","https://github.com/andreafioraldi/ToolsForCyberChallenge/blob/197d3dfd204cf1b9d1af1451455c8831c3ff9948/generated/files_3.list.dict"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":[],"repo_exp_urls":[],"has_poc":false,"has_exp":false,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/2001/AVE-2001-0462.toml"},{"ave_id":"AVE-2001-0357","file_name":"2001/AVE-2001-0357.toml","cve_id":"CVE-2001-1013","title":"Red Hat Apache 远程用户名枚举漏洞","description":"Red Hat Linux 7.0 中 Apache HTTP Server 在启用 UserDir 指令时存在用户名枚举漏洞。当远程攻击者请求 ~username 路径时，若用户名存在但无 public_html 目录与用户名不存在时，Apache 返回不同的错误状态码，攻击者可通过对比响应差异枚举服务器上的有效用户名。该漏洞无需身份认证即可远程利用，攻击条件低，可能导致进一步的社会工程攻击或暴力破解。建议禁用 UserDir 指令或限制访问。","severity":"MEDIUM","score":5.0,"aliases":["CVE-2001-1013"],"sources":["exploitdb"],"published":"2001-09-12T04:00:00Z","updated":"2026-06-16T21:55:24Z","remediation":"禁用 Apache UserDir 指令或在 httpd.conf 中设置 `UserDir disabled`，同时使用 `ErrorDocument 404` 和 `ErrorDocument 403` 返回相同错误页面，防止通过不同状态码枚举有效用户名。升级至 Apache 2.0 及以上版本或迁移至受支持的 Red Hat Linux 发行版。","status":"completed","collected_at":"2026-07-27T00:00:00Z","references":["http://archives.neohapsis.com/archives/vuln-dev/2000-q3/0083.html","http://archives.neohapsis.com/archives/vuln-dev/2000-q3/0087.html","http://archives.neohapsis.com/archives/vuln-dev/2000-q3/0094.html","http://www.securityfocus.com/archive/1/213667","http://www.securityfocus.com/bid/3335","https://exchange.xforce.ibmcloud.com/vulnerabilities/7129","https://www.exploit-db.com/exploits/21112","https://github.com/CVEProject/cvelistV5/blob/50b2026c1039c6a81b95d80535c772b9d8685178/cves/2001/1xxx/CVE-2001-1013.json","https://github.com/sullo/nikto/blob/999670cb6a939b6c93840ce666941756e4c5dcf5/program/plugins/nikto_apacheusers.plugin","https://github.com/LiuCan01/cve-list-pro/blob/78b55511cee3604c22d518e32822f0435d0cacc0/cve-list/CVE-2001/CVE-2001-1013","https://github.com/HORKimhab/poc-cve-collection/blob/291c09f8f1fb3b2fa866c7b93e7660471419cef8/2001/1xxx/CVE-2001-1013.md","https://github.com/e-m-b-a/emba/blob/4d0f24b3edae0bdb5391177851bad3be54ecea0f/config/msf_cve-db.txt","https://github.com/Patrowl/PatrowlHearsData/blob/648427aa2db027c1629d5ac1fafa487d8d68e08f/CVE/data/2001/CVE-2001-1013.json","https://github.com/CVEProject/cve-reference-ingest-data/blob/31d5b78ee7ad856a6aee490403faecefdc8a4878/references/CVE-2001-1013-2023-09-21-1730","https://github.com/gottburgm/Exploits/blob/fd340a05cbec416e89bfae898e27bf5fcb429101/MSFExploits/APACHE/MSF/UserdirEnum_infos.txt","https://github.com/chroblert/AssetManage/blob/1024c864fe3e0e1b5715ce742476dd2d1b2a67ae/Util/nmap-7.80/scripts/http-userdir-enum.nse","https://github.com/rhuitl/uClinux/blob/0486e80a025dccbe4a2213715a2ab8a5063ea86b/user/nessus/nessus-plugins/scripts/apache_username.nasl"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":["https://raw.githubusercontent.com/adysec/AVE/main/pocs/2001/POC-AVE-2001-0357.toml"],"repo_exp_urls":["https://raw.githubusercontent.com/adysec/AVE/main/exploits/2001/EXP-AVE-2001-0357.toml"],"has_poc":true,"has_exp":true,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/2001/AVE-2001-0357.toml"},{"ave_id":"AVE-2001-0426","file_name":"2001/AVE-2001-0426.toml","cve_id":"CVE-2001-0956","title":"SpeechD 任意命令执行漏洞","description":"SpeechD 0.54 及更早版本在与 Festival 或 rsynth 语音合成包配合使用时，存在 shell 元字符注入漏洞。本地攻击者可通过向 SpeechD 进程传递包含特殊 shell 元字符的恶意参数触发该漏洞，导致以 SpeechD 进程权限执行任意命令。该漏洞影响 SpeechD 0.54 及之前所有版本，CVSS 评分 7.2，危害等级高。攻击者需具备本地系统访问权限，利用复杂度低，成功利用后可完全控制受影响的 SpeechD 服务。","severity":"HIGH","score":7.2,"aliases":["CVE-2001-0956"],"sources":["exploitdb"],"published":"2001-09-11T04:00:00Z","updated":"2026-06-16T21:55:18Z","remediation":"升级 SpeechD 至 0.54 以上版本（若厂商已停止维护则建议彻底移除 speechd 软件包）。如无法升级，可采取以下缓解措施：1) 移除 /dev/speech 设备的 setuid 权限，避免以 root 身份运行；2) 严格限制对 /dev/speech 设备的访问权限，仅允许受信任用户访问；3) 在 speechd 配置中禁用 shell 元字符传递功能，对输入进行严格过滤。","status":"completed","collected_at":"2026-07-27T00:00:00Z","references":["http://archives.neohapsis.com/archives/bugtraq/2001-09/0089.html","http://www.securityfocus.com/bid/3326","http://www.speechio.org/speechd.html","https://exchange.xforce.ibmcloud.com/vulnerabilities/7121","https://www.exploit-db.com/exploits/21108","https://github.com/CVEProject/cvelistV5/blob/bb04e7276eb5376f975ca811b9a340d0d55b901d/cves/2001/0xxx/CVE-2001-0956.json","https://github.com/LiuCan01/cve-list-pro/blob/78b55511cee3604c22d518e32822f0435d0cacc0/cve-list/CVE-2001/CVE-2001-0956","https://github.com/HORKimhab/poc-cve-collection/blob/11a92cc3c0d31b9e78fe8f2a857dd04df3195701/2001/0xxx/CVE-2001-0956.md","https://github.com/Patrowl/PatrowlHearsData/blob/050b62cac636d83be07e6d4c77e70114e1ca7c93/CVE/data/2001/CVE-2001-0956.json","https://github.com/github/advisory-database/blob/fa1c2f93b0d15da115c038738e571c1a1553b4cc/advisories/unreviewed/2022/05/GHSA-jcxv-vj45-grr9/GHSA-jcxv-vj45-grr9.json","https://github.com/nottrobin/ubuntu-cve-tracker/blob/36e411296b5707284049ec2e0db8d2622feca498/retired/CVE-2007-4074","https://github.com/nomi-sec/NVD-Database/blob/23dc120c34402aaa65883c51c1d03b3cb02c20cb/2007/CVE-2007-4074.json","https://github.com/intSpLoiT/intframework/blob/eabaa799d0260aa52b735fa9769266d1ce4b64ef/modules/cve_list.txt","https://github.com/KTZgraph/sarenka/blob/f1fb931ab722d6c096d581ed6e3c5966d799fbaa/sarenka/feeds/cve_details/cve_all_details_151500_151600.json","https://github.com/olbat/nvdcve/blob/add906b6a8ba20fd533c6fdd7f023c73e6090f3a/nvdcve/CVE-2001-0956.json"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":["https://raw.githubusercontent.com/adysec/AVE/main/pocs/2001/POC-AVE-2001-0426.toml"],"repo_exp_urls":["https://raw.githubusercontent.com/adysec/AVE/main/exploits/2001/EXP-AVE-2001-0426.toml"],"has_poc":true,"has_exp":true,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/2001/AVE-2001-0426.toml"},{"ave_id":"AVE-2001-0535","file_name":"2001/AVE-2001-0535.toml","cve_id":"CVE-2001-1407","title":"Mozilla Bugzilla 安全绕过漏洞","description":"Bugzilla 2.14 之前版本存在安全绕过漏洞，普通用户可通过将自身提交的 Bug 标记为受限 Bug 的重复（duplicate）来绕过群组安全限制。当标记为重复时，系统会自动将当前用户添加到受限 Bug 的 CC 列表中，从而获得查看该受限 Bug 详情的权限。攻击者无需身份认证即可利用此漏洞获取本应受限的敏感信息，影响 Bugzilla 的访问控制机制。该漏洞 CVSS 评分 7.5，危害等级高，建议升级至 Bugzilla 2.14 或更高版本修复。","severity":"HIGH","score":7.5,"aliases":["CVE-2001-1407"],"sources":["redhat"],"published":"2001-09-10T04:00:00Z","updated":"2026-06-16T21:56:12Z","remediation":"升级 Bugzilla 至 2.14 或更高版本，该版本修复了通过标记重复 bug 绕过群组权限检查的安全漏洞。如无法立即升级，可临时禁用非管理员用户的\"标记为重复\"权限，或限制用户对 CC 列表的自动添加功能以降低风险。","status":"completed","collected_at":"2026-07-27T00:00:00Z","references":["http://bugzilla.mozilla.org/show_bug.cgi?id=96085","http://marc.info/?l=bugtraq&m=99912899900567","http://www.iss.net/security_center/static/10479.php","http://www.redhat.com/support/errata/RHSA-2001-107.html","https://github.com/CVEProject/cvelistV5/blob/0db929612f090dc6aa0346061c42364c4634c480/cves/2001/1xxx/CVE-2001-1407.json","https://github.com/LiuCan01/cve-list-pro/blob/78b55511cee3604c22d518e32822f0435d0cacc0/cve-list/CVE-2001/CVE-2001-1407","https://github.com/HORKimhab/poc-cve-collection/blob/5ea14f17ec38fb7850c23056beec64877fabc5b1/2001/1xxx/CVE-2001-1407.md","https://github.com/Patrowl/PatrowlHearsData/blob/bb772dcb04525a1a88049530e1b1081f8633cb88/CVE/data/2001/CVE-2001-1407.json","https://github.com/github/advisory-database/blob/d91e95989ea5d3a9186ceb621d53a71dff03cab4/advisories/unreviewed/2022/04/GHSA-h798-g8rp-xv9p/GHSA-h798-g8rp-xv9p.json","https://github.com/yarencheng/cve-devops-playground/blob/c54e59752dddfc9aa36c13774164384cfa0d1f04/content/CVE-2001-1407.md","https://github.com/KTZgraph/sarenka/blob/f1fb931ab722d6c096d581ed6e3c5966d799fbaa/sarenka/feeds/cve_details/cve_all_details_151600_151700.json","https://github.com/oasis-open/cti-stix-common-objects/blob/55ba7598cbd5a52577b6887871505d931d85cb61/objects/vulnerability/vulnerability--2c891d47-85a9-4ae0-bc3c-7dc5942922a3.json","https://github.com/olbat/nvdcve/blob/add906b6a8ba20fd533c6fdd7f023c73e6090f3a/nvdcve/CVE-2001-1407.json","https://github.com/nomi-sec/CVE-Easy-List/blob/dc712452b4b330ce9a69a7312562b32027c700f5/2001.tsv"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":[],"repo_exp_urls":[],"has_poc":false,"has_exp":false,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/2001/AVE-2001-0535.toml"},{"ave_id":"AVE-2001-0533","file_name":"2001/AVE-2001-0533.toml","cve_id":"CVE-2001-1406","title":"Mozilla Bugzilla process_bug.cgi 权限管理漏洞","description":"Bugzilla 2.14 之前版本的 process_bug.cgi 在处理 Bug 跨产品组移动时，未正确重置或设置目标组的 \"groupset\" 权限位，导致被移动的 Bug 仍沿用原产品组的访问限制。由于原组的权限约束可能比目标组更为宽松，已授权用户可借此访问本应受限的 Bug 信息，造成信息泄露。攻击者需拥有 Bugzilla 系统合法账户并触发跨组移动操作，攻击复杂度低，无需额外权限。该漏洞影响 Bugzilla 2.14 之前所有版本。","severity":"LOW","score":2.1,"aliases":["CVE-2001-1406"],"sources":["redhat"],"published":"2001-09-10T04:00:00Z","updated":"2026-06-16T21:56:12Z","remediation":"升级 Bugzilla 至 2.14 或更高版本。如无法升级，需手动修改 process_bug.cgi 中移动 bug 跨产品组时的逻辑，在移动操作完成后显式重置 groupset 位为目标产品组的权限掩码，确保旧组权限不被继承。具体补丁可参考 Bugzilla 2.14 安全公告中相关 bug 编号对应的补丁文件。","status":"completed","collected_at":"2026-07-27T00:00:00Z","references":["http://bugzilla.mozilla.org/show_bug.cgi?id=66235","http://marc.info/?l=bugtraq&m=99912899900567","http://www.iss.net/security_center/static/10478.php","http://www.redhat.com/support/errata/RHSA-2001-107.html","https://github.com/CVEProject/cvelistV5/blob/0db929612f090dc6aa0346061c42364c4634c480/cves/2001/1xxx/CVE-2001-1406.json","https://github.com/LiuCan01/cve-list-pro/blob/78b55511cee3604c22d518e32822f0435d0cacc0/cve-list/CVE-2001/CVE-2001-1406","https://github.com/Patrowl/PatrowlHearsData/blob/bb772dcb04525a1a88049530e1b1081f8633cb88/CVE/data/2001/CVE-2001-1406.json","https://github.com/nomi-sec/NVD-Database/blob/23dc120c34402aaa65883c51c1d03b3cb02c20cb/2001/CVE-2001-1406.json","https://github.com/olbat/nvdcve/blob/add906b6a8ba20fd533c6fdd7f023c73e6090f3a/nvdcve/CVE-2001-1406.json","https://github.com/opencve/opencve-kb/blob/11bfe231e2f40901202bf5512cf311c598332515/2001/CVE-2001-1406.json","https://github.com/HORKimhab/poc-cve-collection/blob/5ea14f17ec38fb7850c23056beec64877fabc5b1/2001/1xxx/CVE-2001-1406.md","https://github.com/fkie-cad/nvd-json-data-feeds/blob/a9331e178e67e816fb1e4205a54da7a62362cd2e/CVE-2001/CVE-2001-14xx/CVE-2001-1406.json","https://github.com/CyberSecAI/cve_info/blob/03b7e36424574a3a9ba5fd13480a326b666a1046/2001/1xxx/CVE-2001-1406.json","https://github.com/CVEProject/cvelist-dev/blob/5b8fbb570438e8094550205589cc6f1d122acc94/2001/1xxx/CVE-2001-1406.json"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":[],"repo_exp_urls":[],"has_poc":false,"has_exp":false,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/2001/AVE-2001-0533.toml"},{"ave_id":"AVE-2001-0532","file_name":"2001/AVE-2001-0532.toml","cve_id":"CVE-2001-1405","title":"Bugzilla sanitycheck.cgi 拒绝服务漏洞","description":"Bugzilla 2.14 之前版本未对 sanitycheck.cgi 脚本的访问进行权限限制，导致本地攻击者可通过大量发送请求至该脚本，消耗服务器 CPU 资源，造成拒绝服务。该漏洞影响 Bugzilla 2.14 之前所有版本，攻击者需拥有本地访问权限，利用门槛较低，危害等级低。","severity":"LOW","score":2.1,"aliases":["CVE-2001-1405"],"sources":["redhat"],"published":"2001-09-10T04:00:00Z","updated":"2026-06-16T21:56:12Z","remediation":"升级 Bugzilla 至 2.14 或更高版本，该版本限制了对 sanitycheck.cgi 的访问权限。如无法升级，可在 Web 服务器层（如 Apache/Nginx）对 sanitycheck.cgi 路径添加 IP 白名单或认证机制，防止未授权用户频繁请求导致 CPU 资源耗尽。","status":"completed","collected_at":"2026-07-27T00:00:00Z","references":["http://bugzilla.mozilla.org/show_bug.cgi?id=54556","http://marc.info/?l=bugtraq&m=99912899900567","http://www.redhat.com/support/errata/RHSA-2001-107.html","https://github.com/CVEProject/cvelistV5/blob/0db929612f090dc6aa0346061c42364c4634c480/cves/2001/1xxx/CVE-2001-1405.json","https://github.com/LiuCan01/cve-list-pro/blob/78b55511cee3604c22d518e32822f0435d0cacc0/cve-list/CVE-2001/CVE-2001-1405","https://github.com/HORKimhab/poc-cve-collection/blob/5ea14f17ec38fb7850c23056beec64877fabc5b1/2001/1xxx/CVE-2001-1405.md","https://github.com/Patrowl/PatrowlHearsData/blob/bb772dcb04525a1a88049530e1b1081f8633cb88/CVE/data/2001/CVE-2001-1405.json","https://github.com/github/advisory-database/blob/d91e95989ea5d3a9186ceb621d53a71dff03cab4/advisories/unreviewed/2022/04/GHSA-j2c7-fx5p-x2jv/GHSA-j2c7-fx5p-x2jv.json","https://github.com/yarencheng/cve-devops-playground/blob/c54e59752dddfc9aa36c13774164384cfa0d1f04/content/CVE-2001-1405.md","https://github.com/SpeeDr00t/speedr00t.github.com/blob/0380f0c2190556fabe90257cb6c0034a42f68951/securityfocus/0x89000/88707/info.html","https://github.com/nomi-sec/NVD-Database/blob/23dc120c34402aaa65883c51c1d03b3cb02c20cb/2001/CVE-2001-1405.json","https://github.com/oasis-open/cti-stix-common-objects/blob/55ba7598cbd5a52577b6887871505d931d85cb61/objects/vulnerability/vulnerability--3631ec1f-74e3-485a-af1f-05cb89d5c0a0.json","https://github.com/hungryfoolou/Vulnerability_Mining/blob/3df1d8ed0489ae1228f975ae1f58a690aae53886/craw/cveid_craw/cveid_craw/data/cveid_by_kind/cveid_dos.txt"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":["https://raw.githubusercontent.com/adysec/AVE/main/pocs/2001/POC-AVE-2001-0532.toml"],"repo_exp_urls":[],"has_poc":true,"has_exp":false,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/2001/AVE-2001-0532.toml"},{"ave_id":"AVE-2001-0530","file_name":"2001/AVE-2001-0530.toml","cve_id":"CVE-2001-1404","title":"Bugzilla 明文密码存储与邮件泄露致权限提升漏洞","description":"Bugzilla 2.14 之前版本存在敏感信息明文存储漏洞，系统将用户密码以明文形式存储在数据库中，并在发送密码重置请求时通过电子邮件明文传输密码信息。本地或能够访问邮件系统的攻击者可利用此漏洞窃取用户密码，进而获取系统未授权访问权限，实现权限提升。该漏洞影响所有 Bugzilla 2.14 之前版本，CVSS 评分 7.5，危害等级高。建议升级至 Bugzilla 2.14 或更高版本以修复此问题。","severity":"HIGH","score":7.5,"aliases":["CVE-2001-1404"],"sources":["redhat"],"published":"2001-09-10T04:00:00Z","updated":"2026-06-16T21:56:12Z","remediation":"立即升级 Bugzilla 至 2.14 或更高版本，该版本已将用户密码改为加密存储而非明文。对于 Red Hat 用户，请安装 RHSA-2001:107 提供的补丁包。如无法立即升级，可在应用层限制对 Bugzilla 数据库 profiles 表的直接访问，并提醒用户避免使用与其他系统相同的密码。","status":"completed","collected_at":"2026-07-27T00:00:00Z","references":["http://bugzilla.mozilla.org/show_bug.cgi?id=74032","http://marc.info/?l=bugtraq&m=99912899900567","http://www.redhat.com/support/errata/RHSA-2001-107.html","https://github.com/CVEProject/cvelistV5/blob/49bdd0da7f9ed7eb2c6a7d376de641a46364c00a/cves/2001/1xxx/CVE-2001-1404.json","https://github.com/LiuCan01/cve-list-pro/blob/78b55511cee3604c22d518e32822f0435d0cacc0/cve-list/CVE-2001/CVE-2001-1404","https://github.com/HORKimhab/poc-cve-collection/blob/5ea14f17ec38fb7850c23056beec64877fabc5b1/2001/1xxx/CVE-2001-1404.md","https://github.com/Patrowl/PatrowlHearsData/blob/bb772dcb04525a1a88049530e1b1081f8633cb88/CVE/data/2001/CVE-2001-1404.json","https://github.com/github/advisory-database/blob/d91e95989ea5d3a9186ceb621d53a71dff03cab4/advisories/unreviewed/2022/04/GHSA-g48m-vrgx-gpcw/GHSA-g48m-vrgx-gpcw.json","https://github.com/yarencheng/cve-devops-playground/blob/c54e59752dddfc9
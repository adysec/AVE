_urls":[],"repo_exp_urls":[],"has_poc":false,"has_exp":false,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/2012/AVE-2012-0031.toml"},{"ave_id":"AVE-2012-0003","file_name":"2012/AVE-2012-0003.toml","cve_id":"CVE-2012-0896","title":"WordPress Count Per Day 插件绝对路径遍历漏洞","description":"WordPress Count Per Day 插件（版本 3.1.1 之前）的 download.php 文件中存在绝对路径遍历漏洞（CWE-22）。远程攻击者无需身份认证即可通过向 f 参数传递包含 ../ 等路径遍历序列的特制请求，绕过目录限制读取服务器上的任意文件（如 /etc/passwd 等敏感文件），导致敏感信息泄露。该漏洞 CVSS 评分 5.0，危害等级中危，影响所有使用该插件的 WordPress 站点。","severity":"MEDIUM","score":5.0,"aliases":["CVE-2012-0896"],"sources":["nuclei"],"published":"2012-01-20T17:55:01Z","updated":"2026-06-16T23:38:27Z","remediation":"立即将 Count Per Day 插件升级至 3.1.1 及以上版本。由于该插件已于 2019 年因违规被关闭下架且不再维护，建议彻底停用并删除此插件，改用其他受支持的访客统计插件（如 Jetpack Stats 或 Site Kit by Google）。如无法立即删除，可在 .htaccess 中添加 `<Files \"download.php\"> Order Allow,Deny Deny from all </Files>` 阻断对该文件的直接访问，作为临时缓解措施。","status":"completed","collected_at":"2026-07-22T00:00:00Z","references":["http://osvdb.org/78270","http://packetstormsecurity.org/files/108631/countperday-downloadxss.txt","http://plugins.trac.wordpress.org/changeset/488883/count-per-day","http://secunia.com/advisories/47529","http://wordpress.org/extend/plugins/count-per-day/changelog/","http://www.exploit-db.com/exploits/18355","http://www.securityfocus.com/bid/51402","https://exchange.xforce.ibmcloud.com/vulnerabilities/72385","https://www.exploit-db.com/exploits/18355","https://github.com/projectdiscovery/nuclei-templates/blob/main/http/cves/2012/CVE-2012-0896.yaml","https://github.com/trickest/cve/blob/3ffa2a96db84a89f71e1c7ad889e5f4fcc755a48/2012/CVE-2012-0896.md","https://github.com/projectdiscovery/nuclei-templates/blob/0c7acbe01d12e3db33eedacb7a2c97c0d518fac0/http/cves/2012/CVE-2012-0896.yaml","https://github.com/sepehrdaddev/zap-scripts/blob/2b63b02ca79cc7f0023cdbab72c5c6c774354b07/active/CVE-2012-0896.js","https://github.com/ExpLangcn/NucleiTP/blob/2b7ecb9031a6eda4f272793045f29b339d8e0cce/CVES/high/cve-2012-0896-2132.yaml","https://github.com/linuxadi/40k-nuclei-templates/blob/542be6820c801c02a33aee60f1c05ca7b0b5005f/aditya/folder1/cve-2012-0896-2134.yaml","https://github.com/rix4uni/nucleihub-templates/blob/579a0234551b9e0e322460a62dc77bd6109e4aff/nucleihub-templates/CVE-2012-0896_1.yaml","https://github.com/Patrowl/PatrowlHearsData/blob/affa68d6539dbc90b6b6e0e1e746facb4aae08df/CVE/data/2012/CVE-2012-0896.json","https://github.com/itsmenaga/Nuclei-Templates-All/blob/7e93c24e44969db15f4072e1c6a322a026452d6b/Vulnerability-Templates/cve-2012-0896-2132.yaml","https://github.com/coreruleset/seaweed-reports/blob/3e2a1bd3dbca1b431f18ed0dabb71fa729d4d059/2022/Sep/04/traversalArtifact/traversalReport.csv","https://github.com/TenrootOrg/risx-mssp-python/blob/4f1caa79453160d0e6d423fd174e42ff9b1204fb/modules/Nuclei/dependencies/Windows/nuclei-templates/http/cves/2012/CVE-2012-0896.yaml"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":[],"repo_exp_urls":[],"has_poc":false,"has_exp":false,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/2012/AVE-2012-0003.toml"},{"ave_id":"AVE-2012-0004","file_name":"2012/AVE-2012-0004.toml","cve_id":"CVE-2012-0901","title":"WordPress YouSayToo auto-publishing 插件跨站脚本漏洞","description":"WordPress 的 YouSayToo auto-publishing 插件 1.0 版本中存在跨站脚本（XSS）漏洞，位于 yousaytoo.php 文件的 submit 参数。远程攻击者可通过向该参数注入恶意 Web 脚本或 HTML 代码，当管理员或其他用户访问受影响的页面时，恶意脚本将在浏览器中执行，导致敏感信息泄露或会话劫持。该漏洞影响 YouSayToo auto-publishing 1.0 版本，CVSS 评分 4.3，危害等级中危。建议升级插件或对用户输入进行严格过滤。","severity":"MEDIUM","score":4.3,"aliases":["CVE-2012-0901"],"sources":["cve","nuclei"],"published":"2012-01-20T00:00:00Z","updated":"2026-06-16T00:00:00Z","remediation":"YouSayToo auto-publishing 插件自 2012 年起已停止维护，厂商未发布安全补丁。建议立即停用并删除该插件，替换为其他活跃维护的 WordPress 自动发布插件。如无法替换，需在服务器端对 yousaytoo.php 的 submit 参数进行严格的输入过滤和输出编码。","status":"completed","collected_at":"2026-07-22T11:04:15Z","references":[],"poc_urls":[],"exp_urls":[],"repo_poc_urls":[],"repo_exp_urls":[],"has_poc":false,"has_exp":false,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/2012/AVE-2012-0004.toml"},{"ave_id":"AVE-2012-0055","file_name":"2012/AVE-2012-0055.toml","cve_id":"CVE-2012-0391","title":"Apache Struts2 远程命令执行漏洞","description":"Apache Struts2 的 ExceptionDelegator 组件在处理属性数据类型不匹配的异常时，会将用户传入的参数值作为 OGNL 表达式进行解析执行，导致远程命令执行漏洞。攻击者无需认证即可通过向受影响应用发送特制的 HTTP 请求参数触发该漏洞，从而在服务器上执行任意 Java 代码，完全控制目标系统。该漏洞影响 Apache Struts2 2.0.0 至 2.3.17 版本，CVSS 评分 9.8，危害等级严重。","severity":"CRITICAL","score":9.8,"aliases":["CVE-2012-0391"],"sources":["kev"],"published":"2012-01-08T15:55:01Z","updated":"2026-06-16T23:37:12Z","remediation":"升级 Apache Struts2 至 2.3.17 及以上版本（官方修复版本为 2.2.3.1），该漏洞在 2.3.17 中彻底修复。如无法升级，在 struts.xml 中禁用动态方法调用：<constant name=\"struts.enable.DynamicMethodInvocation\" value=\"false\" />，并严格校验用户输入，过滤 OGNL 表达式特殊字符。同时建议部署 WAF 规则拦截包含 OGNL 表达式的请求参数。","status":"completed","collected_at":"2026-07-22T00:00:00Z","references":["http://archives.neohapsis.com/archives/bugtraq/2012-01/0031.html","http://secunia.com/advisories/47393","http://struts.apache.org/2.x/docs/s2-008.html","http://struts.apache.org/2.x/docs/version-notes-2311.html","http://www.exploit-db.com/exploits/18329","https://issues.apache.org/jira/browse/WW-3668","https://www.sec-consult.com/files/20120104-0_Apache_Struts2_Multiple_Critical_Vulnerabilities.txt","https://www.cisa.gov/known-exploited-vulnerabilities-catalog?field_cve=CVE-2012-0391","https://www.exploit-db.com/exploits/18984","https://github.com/trickest/cve/blob/ed228d55b7972f63e700a35a54fbcd94064b9ade/2012/CVE-2012-0391.md","https://github.com/CVEProject/cvelistV5/blob/528991f6906b29893dd0e43e65862cd92fd607c8/cves/2012/0xxx/CVE-2012-0391.json","https://github.com/Ares-X/VulWiki/blob/40e0273754a36f49a6be6a77a7a4c210a07063ed/Web%E5%AE%89%E5%85%A8/Apache%20Struts/%EF%BC%88CVE-2012-0391%EF%BC%89s2-008.md","https://github.com/govbk/WIKI-POC-EXP/blob/7d1194429dab9f9dd8139408e79b70ddb41a468f/%E9%9B%B6%E7%BB%84%E6%BC%8F%E6%B4%9E%E7%9B%B8%E5%85%B3/160-Apache%20Struts/007-%EF%BC%88CVE-2012-0391%EF%BC%89s2-008.md","https://github.com/ARPSyndicate/suricata-vedas/blob/fe24794ad36564b5bbc7c69101525011387b8650/2012/CVE-2012-0391.rules","https://github.com/cisagov/vulnrichment/blob/4a810b0db2e9cab67156f722c309e925ee8f02a0/2012/0xxx/CVE-2012-0391.json","https://github.com/neuvector/vul-source/blob/9ba62febaf6254d72eb4667cd7923d92d2c3f9b6/ubuntu-cve-tracker/retired/CVE-2012-0391","https://github.com/Tabll/gemnasium-db/blob/de1cbf8802a4c6060caaa5924b50812f2a62fead/maven/org.apache.struts/struts2-parent/CVE-2012-0391.yml","https://github.com/e-m-b-a/emba/blob/4d0f24b3edae0bdb5391177851bad3be54ecea0f/config/msf_cve-db.txt","https://github.com/fankh/vulnerability-poc/blob/ffa50060b7ba6ae58d60d6d90533e77eaf10d466/2012/CVE-2012-0391/README_KO.md"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":[],"repo_exp_urls":[],"has_poc":false,"has_exp":false,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/2012/AVE-2012-0055.toml"},{"ave_id":"AVE-2012-0002","file_name":"2012/AVE-2012-0002.toml","cve_id":"CVE-2012-0394","title":"Apache Struts DebuggingInterceptor 代码注入漏洞","description":"Apache Struts 2 的 DebuggingInterceptor 组件在开发者模式（devMode）开启时存在代码注入漏洞（S2-008）。远程攻击者可利用调试模式下的参数拦截机制向目标应用发送特制恶意请求，在 struts 处理调试参数过程中注入 OGNL 表达式，从而在服务器端执行任意系统命令。该漏洞影响 Apache Struts 2.3.1.1 之前的版本，攻击无需身份认证，危害严重。厂商建议禁用开发者模式或升级至 2.3.1.1 及以上版本。","severity":"MEDIUM","score":6.8,"aliases":["CVE-2012-0394"],"sources":["nuclei"],"published":"2012-01-08T15:55:01Z","updated":"2026-06-16T23:37:12Z","remediation":"升级 Apache Struts 至 2.3.1.1 或更高版本以修复 DebuggingInterceptor 的代码注入漏洞。生产环境务必关闭开发者模式（devMode=false），禁止在正式环境中启用调试拦截器。如无法立即升级，可在 struts.xml 中移除 DebuggingInterceptor 的配置引用作为临时缓解措施。","status":"completed","collected_at":"2026-07-22T00:00:00Z","references":["http://archives.neohapsis.com/archives/bugtraq/2012-01/0031.html","http://struts.apache.org/2.x/docs/s2-008.html","http://struts.apache.org/2.x/docs/version-notes-2311.html","http://www.exploit-db.com/exploits/18329","http://www.exploit-db.com/exploits/31434","http://www.osvdb.org/78276","https://www.sec-consult.com/files/20120104-0_Apache_Struts2_Multiple_Critical_Vulnerabilities.txt","https://www.exploit-db.com/exploits/18329","https://github.com/projectdiscovery/nuclei-templates/blob/main/http/cves/2012/CVE-2012-0394.yaml","https://github.com/trickest/cve/blob/3ffa2a96db84a89f71e1c7ad889e5f4fcc755a48/2012/CVE-2012-0394.md","https://github.com/projectdiscovery/nuclei-templates/blob/0c7acbe01d12e3db33eedacb7a2c97c0d518fac0/http/cves/2012/CVE-2012-0394.yaml","https://github.com/CVEProject/cvelistV5/blob/4e452a37e644e8194f1171b7eec1f7dc625b6526/cves/2012/0xxx/CVE-2012-0394.json","https://github.com/ARPSyndicate/suricata-vedas/blob/fe24794ad36564b5bbc7c69101525011387b8650/2012/CVE-2012-0394.rules","https://github.com/knownsec/pocsuite3/blob/9bed2883b86a8996f8805fc44da4a1911f52a11e/pocsuite3/pocs/Apache_Struts2/README.md","https://github.com/eslerm/ubuntu-cve-tracker/blob/f17e5ebf7a87347cc68d8fae347d07409a857342/retired/CVE-2012-0394","https://github.com/nomi-sec/NVD-Database/blob/23dc120c34402aaa65883c51c1d03b3cb02c20cb/2012/CVE-2012-0394.json","https://github.com/apache/struts-examples/blob/370ba5e9bf2b5c51a2a994ebb0f38e9ad26824bd/src/etc/project-suppression.xml","https://github.com/ExpLangcn/NucleiTP/blob/2b7ecb9031a6eda4f272793045f29b339d8e0cce/CVES/medium/CVE-2012-0394.yaml","https://github.com/berez23/canvas/blob/cb306a9d8b1d8a743049a29164e6d324f8dabbfa/exploits/web/strutsCodeInjection/strutsCodeInjection.py"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":[],"repo_exp_urls":[],"has_poc":false,"has_exp":false,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/2012/AVE-2012-0002.toml"},{"ave_id":"AVE-2012-0001","file_name":"2012/AVE-2012-0001.toml","cve_id":"CVE-2012-0392","title":"Apache Struts2 CookieInterceptor 远程代码执行漏洞","description":"Apache Struts2 的 CookieInterceptor 组件在处理 HTTP Cookie 头时未对参数名称进行白名单校验，远程攻击者可通过向目标服务器发送特制的 Cookie 数据触发 Java 静态方法调用，从而实现任意代码执行。该漏洞影响 Apache Struts2 2.3.1.1 之前版本，CVSS 评分 6.8，危害等级中等。","severity":"MEDIUM","score":6.8,"aliases":["CVE-2012-0392"],"sources":["cve","nvd","nuclei"],"published":"2012-01-08T00:00:00Z","updated":"2026-06-16T00:00:00Z","remediation":"升级至 Apache Struts 2.3.1.1 及以上版本，该版本修复了 CookieInterceptor 未对参数名进行白名单过滤的问题。同时建议升级至 Struts 2.3.18 以获取针对 S2-008 所有漏洞的完整修复。若无法升级，在 struts.xml 中为 CookieInterceptor 和 ParameterInterceptor 配置更严格的 acceptedParamNames 白名单过滤规则：[a-zA-Z0-9\\.][()_']+，并关闭 DebuggingInterceptor（devMode=false）以防止 OGNL 表达式注入。","status":"completed","collected_at":"2026-07-22T00:00:00Z","references":["http://struts.apache.org/2.x/docs/s2-008.html","http://struts.apache.org/2.x/docs/version-notes-2311.html","http://secunia.com/advisories/47393","http://www.exploit-db.com/exploits/18329","http://archives.neohapsis.com/archives/bugtraq/2012-01/0031.html","https://lists.immunityinc.com/pipermail/dailydave/2012-January/000011.html","https://cwiki.apache.org/confluence/display/WW/S2-008"],"poc_urls":["http://www.exploit-db.com/exploits/18329"],"exp_urls":[],"repo_poc_urls":[],"repo_exp_urls":[],"has_poc":false,"has_exp":false,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/2012/AVE-2012-0001.toml"}]
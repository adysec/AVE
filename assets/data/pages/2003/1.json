6/2003/0xxx/CVE-2003-0253.json"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":[],"repo_exp_urls":[],"has_poc":false,"has_exp":false,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/2003/AVE-2003-0073.toml"},{"ave_id":"AVE-2003-0072","file_name":"2003/AVE-2003-0072.toml","cve_id":"CVE-2003-0252","title":"Linux nfs-utils mountd 越界写入远程代码执行漏洞","description":"Linux NFS utils 套件（nfs-utils）中 mountd 组件的 xlog 函数存在差一错误（Off-by-one）漏洞，版本低于 1.0.4 均受影响。远程攻击者可通过向 mountd 发送不含换行符的特定 RPC 请求触发该漏洞，导致拒绝服务，在特定条件下可能实现远程代码执行。该漏洞影响面广，CVSS 评分 9.8，危害等级严重。","severity":"CRITICAL","score":9.8,"aliases":["CVE-2003-0252"],"sources":["redhat"],"published":"2003-08-18T04:00:00Z","updated":"2026-06-16T22:01:50Z","remediation":"The user wants me to generate a remediation field for CVE-2003-0252. This is an off-by-one error in the xlog function of mountd in nfs-utils before 1.0.4. The fix is to upgrade to nfs-utils 1.0.4 or later. Let me provide a specific, actionable remediation in Chinese with at least 20 characters.<value>立即将 nfs-utils 升级至 1.0.4 或更高版本。如无法升级，在 /etc/hosts.deny 中添加 \"mountd: ALL\" 并在 /etc/hosts.allow 中仅放行可信 IP，同时在防火墙层面限制对 RPC 端口 (111/TCP/UDP) 和 mountd 端口的访问。","status":"completed","collected_at":"2026-08-03T00:00:00Z","references":["http://archives.neohapsis.com/archives/vulnwatch/2003-q3/0023.html","http://archives.neohapsis.com/archives/vulnwatch/2003-q3/0024.html","http://isec.pl/vulnerabilities/isec-0010-linux-nfs-utils.txt","http://marc.info/?l=bugtraq&m=105820223707191&w=2","http://marc.info/?l=bugtraq&m=105830921519513&w=2","http://marc.info/?l=bugtraq&m=105839032403325&w=2","http://secunia.com/advisories/9259","http://securitytracker.com/id?1007187","http://sunsolve.sun.com/search/document.do?assetkey=1-77-1001262.1-1","http://www.debian.org/security/2003/dsa-349","http://www.kb.cert.org/vuls/id/258564","http://www.mandriva.com/security/advisories?name=MDKSA-2003:076","http://www.novell.com/linux/security/advisories/2003_031_nfs_utils.html","http://www.redhat.com/support/errata/RHSA-2003-206.html","http://www.redhat.com/support/errata/RHSA-2003-207.html","http://www.securityfocus.com/bid/8179","http://www.turbolinux.com/security/TLSA-2003-44.txt","https://exchange.xforce.ibmcloud.com/vulnerabilities/12600","https://oval.cisecurity.org/repository/search/definition/oval%3Aorg.mitre.oval%3Adef%3A443","https://github.com/CVEProject/cvelistV5/blob/27584df20575115093a915d82c76b5107dd9d51e/cves/2003/0xxx/CVE-2003-0252.json","https://github.com/LiuCan01/cve-list-pro/blob/78b55511cee3604c22d518e32822f0435d0cacc0/cve-list/CVE-2003/CVE-2003-0252","https://github.com/Patrowl/PatrowlHearsData/blob/c31c0a9b9af147bd58078ebf7769418f19d3f2e1/CVE/data/2003/CVE-2003-0252.json","https://github.com/opencve/opencve-kb/blob/83e06f4dc8d4c981660063007f8931d97353357a/2003/CVE-2003-0252.json","https://github.com/nomi-sec/NVD-Database/blob/23dc120c34402aaa65883c51c1d03b3cb02c20cb/2003/CVE-2003-0252.json","https://github.com/HORKimhab/poc-cve-collection/blob/1d7706ed603ab73481cbc20e5bea092e02e7c9be/2003/0xxx/CVE-2003-0252.md","https://github.com/olbat/nvdcve/blob/fe7f195231342e1e88104679c53c965e9a67ac35/nvdcve/CVE-2003-0252.json","https://github.com/aquasecurity/vuln-list-debian/blob/98c311c3ba3abe1f72f8d5cfae5eb671ae60d00f/tracker/CVE/2003/CVE-2003-0252.json","https://github.com/CyberSecAI/cve_info/blob/03b7e36424574a3a9ba5fd13480a326b666a1046/2003/0xxx/CVE-2003-0252.json","https://github.com/fkie-cad/nvd-json-data-feeds/blob/b6c80ad7b47e52f64ae2ee2b20e56d7eaaaa57fe/CVE-2003/CVE-2003-02xx/CVE-2003-0252.json"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":[],"repo_exp_urls":[],"has_poc":false,"has_exp":false,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/2003/AVE-2003-0072.toml"},{"ave_id":"AVE-2003-0060","file_name":"2003/AVE-2003-0060.toml","cve_id":"CVE-2003-0192","title":"Apache HTTP Server SSL/TLS 弱密码漏洞","description":"Apache 2.0.47 之前版本及 Apache 1.3 的 mod_ssl 模块存在弱密码套件降级漏洞。当服务器配置了 per-directory 重新协商机制，并使用 SSLCipherSuite 指令将加密套件从弱密码升级为强密码时，由于重新协商过程中密码套件状态处理不当，Apache 仍可能继续使用原有的弱密码套件进行通信。远程攻击者可通过中间人攻击或劫持已建立的 TLS 连接，利用该漏洞迫使服务器使用较弱的加密算法，从而降低通信安全性，可能导致敏感信息泄露或会话劫持。该漏洞无需身份认证即可远程触发，影响运行 Apache 2.0.47 之前版本及使用 mod_ssl 的 Apache 1.3 版本的系统。","severity":"MEDIUM","score":6.4,"aliases":["CVE-2003-0192"],"sources":["redhat"],"published":"2003-08-18T04:00:00Z","updated":"2026-06-16T22:01:43Z","remediation":"升级至 Apache 2.0.47 或更高版本（Apache 1.3 用户升级 mod_ssl 至修复版本）。如无法立即升级，在 httpd.conf 中设置 SSLInsecureRenegotiation off 并显式配置 SSLCipherSuite HIGH:!aNULL:!eNULL:!EXP:!LOW:!MEDIUM 以禁用弱密码套件，同时移除所有依赖 per-directory renegotiation 的配置指令。","status":"completed","collected_at":"2026-08-03T00:00:00Z","references":["http://marc.info/?l=bugtraq&m=105776593602600&w=2","http://www.mandriva.com/security/advisories?name=MDKSA-2003:075","http://www.redhat.com/support/errata/RHSA-2003-240.html","http://www.redhat.com/support/errata/RHSA-2003-243.html","http://www.redhat.com/support/errata/RHSA-2003-244.html","https://lists.apache.org/thread.html/54a42d4b01968df1117cea77fc53d6beb931c0e05936ad02af93e9ac%40%3Ccvs.httpd.apache.org%3E","https://lists.apache.org/thread.html/5df9bfb86a3b054bb985a45ff9250b0332c9ecc181eec232489e7f79%40%3Ccvs.httpd.apache.org%3E","https://lists.apache.org/thread.html/r0276683d8e1e07153fc8642618830ac0ade85b9ae0dc7b07f63bb8fc%40%3Ccvs.httpd.apache.org%3E","https://lists.apache.org/thread.html/r2cb985de917e7da0848c440535f65a247754db8b2154a10089e4247b%40%3Ccvs.httpd.apache.org%3E","https://lists.apache.org/thread.html/r5001ecf3d6b2bdd0b732e527654248abb264f08390045d30709a92f6%40%3Ccvs.httpd.apache.org%3E","https://lists.apache.org/thread.html/r7035b7c9091c4b665a3b7205364775410646f12125d48e74e395f2ce%40%3Ccvs.httpd.apache.org%3E","https://lists.apache.org/thread.html/r8828e649175df56f1f9e3919938ac7826128525426e2748f0ab62feb%40%3Ccvs.httpd.apache.org%3E","https://lists.apache.org/thread.html/r9e8622254184645bc963a1d47c5d47f6d5a36d6f080d8d2c43b2b142%40%3Ccvs.httpd.apache.org%3E","https://lists.apache.org/thread.html/r9f93cf6dde308d42a9c80
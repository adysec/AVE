],"repo_poc_urls":[],"repo_exp_urls":[],"has_poc":false,"has_exp":false,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/2010/AVE-2010-0506.toml"},{"ave_id":"AVE-2010-0121","file_name":"2010/AVE-2010-0121.toml","cve_id":"CVE-2010-0125","title":"RealNetworks RealPlayer AAC 谱数据解析远程代码执行漏洞","description":"RealNetworks RealPlayer 11.0 至 11.1、RealPlayer SP 1.0 至 1.1.4、RealPlayer Enterprise 2.1.2 以及 Mac RealPlayer 11.0 至 12.0.0.1444 等版本在解析 AAC 文件中的频谱数据（spectral data）时存在安全缺陷，未对输入数据进行充分验证和处理。未经身份认证的远程攻击者可通过诱使用户打开或播放特制 AAC 音频文件来触发该漏洞，在受影响系统上执行任意代码或造成拒绝服务。该漏洞影响范围涵盖 Windows 和 Mac 平台的多个 RealPlayer 版本，CVSS 评分高达 10.0，危害等级为严重。RealNetworks 已在 RealPlayer 12.0.1.609 及更高版本中修复此问题。","severity":"CRITICAL","score":10.0,"aliases":["CVE-2010-0125"],"sources":["tenable"],"published":"2010-12-14T16:00:02.820","updated":"2026-06-16T23:15:31.560","remediation":"立即将 RealPlayer 升级至 12.0.1.609 或更高版本，升级前先结束 RealPlayer 进程并通过官网下载安装程序覆盖安装。如暂无法升级，可卸载 RealPlayer 或在浏览器中禁用 RealPlayer ActiveX 控件，同时避免打开来源不明的 AAC 音频文件，并在邮件网关和防火墙中拦截可疑多媒体附件作为临时缓解。","status":"completed","collected_at":"2026-07-25T00:00:00Z","references":["http://service.real.com/realplayer/security/12102010_player/en/","http://www.securitytracker.com/id?1024861","https://github.com/CVEProject/cvelistV5/blob/7018a2a234cd62e492f0cf2df63817c94e1709c3/cves/2010/0xxx/CVE-2010-0125.json","https://github.com/LiuCan01/cve-list-pro/blob/78b55511cee3604c22d518e32822f0435d0cacc0/cve-list/CVE-2010/CVE-2010-0125","https://github.com/yarencheng/cve-devops-playground/blob/7c450063cd3f12f7aa97a070bb18c68d6bc6767e/content/CVE-2010-0125.md","https://github.com/Patrowl/PatrowlHearsData/blob/475589cb6dfc4c0769e0b0658bf8d09e7540c3b5/CVE/data/2010/CVE-2010-0125.json","https://github.com/github/advisory-database/blob/30b2e88d407156e5425e05ff25f0ec9537280e2f/advisories/unreviewed/2022/05/GHSA-cqp5-r2pj-gw95/GHSA-cqp5-r2pj-gw95.json","https://github.com/xqcyberscore/nvt/blob/978f6a9acb495d7d669239530ffe6da5d631f4da/2010/gb_realplayer_mult_vuln_win_01_dec10.nasl","https://github.com/intSpLoiT/intframework/blob/eabaa799d0260aa52b735fa9769266d1ce4b64ef/modules/cve_list.txt","https://github.com/oasis-open/cti-stix-common-objects/blob/55ba7598cbd5a52577b6887871505d931d85cb61/objects/vulnerability/vulnerability--d96bb71a-de8a-4196-a806-2c713b80548c.json","https://github.com/blackhook/nessus-plugins/blob/64177d96abbb07c58cf7e131046b067ebc61fcb5/R/realplayer_12_0_1_609.nasl","https://github.com/nomi-sec/NVD-Database/blob/23dc120c34402aaa65883c51c1d03b3cb02c20cb/2010/CVE-2010-0125.json"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":[],"repo_exp_urls":[],"has_poc":false,"has_exp":false,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/2010/AVE-2010-0121.toml"},{"ave_id":"AVE-2010-0120","file_name":"2010/AVE-2010-0120.toml","cve_id":"CVE-2010-0121","title":"RealNetworks RealPlayer Cook编解码器初始化内存损坏漏洞","description":"RealPlayer及RealPlayer SP的Cook音频编解码器在初始化过程中存在未指定的错误缺陷，导致堆内存破坏。未经身份认证的远程攻击者可利用该漏洞，通过发送特制的媒体文件或网络传输数据触发Cook编解码器的初始化错误，从而可能实现远程代码执行。该漏洞影响RealPlayer 11.0至11.1、RealPlayer SP 1.0至1.1.5、Mac版RealPlayer 11.0至12.0.0.1444以及Linux版RealPlayer 11.0.2.1744等多个版本。CVSS评分为10.0，攻击复杂度低且无需身份认证即可触发，危害等级严重。RealNetworks后续发布了安全更新修复此问题。","severity":"CRITICAL","score":10.0,"aliases":["CVE-2010-0121"],"sources":["tenable"],"published":"2010-12-14T16:00:02.773","updated":"2026-06-16T23:15:31.133","remediation":"升级到 RealPlayer 12.0.1.609 或更高版本以修复 Cook codec 初始化缺陷。如无法立即升级，可禁用 RealPlayer 的 Cook 编解码器模块或在网络层面阻断来自不可信来源的媒体文件传输作为临时缓解措施。","status":"completed","collected_at":"2026-07-25T00:00:00Z","references":["http://service.real.com/realplayer/security/12102010_player/en/","http://www.securitytracker.com/id?1024861","https://github.com/CVEProject/cvelistV5/blob/e0d4b639863e3178ba8dc8b525356f8aab24b9da/cves/2010/0xxx/CVE-2010-0121.json","https://github.com/LiuCan01/cve-list-pro/blob/78b55511cee3604c22d518e32822f0435d0cacc0/cve-list/CVE-2010/CVE-2010-0121","https://github.com/yarencheng/cve-devops-playground/blob/7c450063cd3f12f7aa97a070bb18c68d6bc6767e/content/CVE-2010-0121.md","https://github.com/Patrowl/PatrowlHearsData/blob/7f7e3d84312983fcf49d3199fbaaf2fad83c05d2/CVE/data/2010/CVE-2010-0121.json","https://github.com/github/advisory-database/blob/30b2e88d407156e5425e05ff25f0ec9537280e2f/advisories/unreviewed/2022/05/GHSA-xcff-45fg-j54m/GHSA-xcff-45fg-j54m.json","https://github.com/xqcyberscore/nvt/blob/978f6a9acb495d7d669239530ffe6da5d631f4da/2010/gb_realplayer_mult_vuln_win_dec10.nasl","https://github.com/intSpLoiT/intframework/blob/eabaa799d0260aa52b735fa9769266d1ce4b64ef/modules/cve_list.txt","https://github.com/KTZgraph/sarenka/blob/f1fb931ab722d6c096d581ed6e3c5966d799fbaa/sarenka/feeds/cve_details/cve_all_details_114100_114200.json","https://github.com/oasis-open/cti-stix-common-objects/blob/55ba7598cbd5a52577b6887871505d931d85cb61/objects/vulnerability/vulnerability--2fe22c50-ff72-4b9f-a323-cf1ebc834a8b.json","https://github.com/opencve/opencve-kb/blob/2d886415eb211c94f75c60061c511bd893bafd48/2010/CVE-2010-0121.json"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":["https://raw.githubusercontent.com/adysec/AVE/main/pocs/2010/POC-AVE-2010-0120.toml"],"repo_exp_urls":[],"has_poc":true,"has_exp":false,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/2010/AVE-2010-0120.toml"}]
fbaa/sarenka/feeds/cve_details/cve_all_details_152300_152400.json","https://github.com/andreafioraldi/ToolsForCyberChallenge/blob/197d3dfd204cf1b9d1af1451455c8831c3ff9948/generated/files_0.list.dict","https://github.com/nomi-sec/CVE-Easy-List/blob/eebf829d86861484c6ea731ef53f87c686c4f91c/2000.tsv"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":[],"repo_exp_urls":[],"has_poc":false,"has_exp":false,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/2000/AVE-2000-0246.toml"},{"ave_id":"AVE-2000-0244","file_name":"2000/AVE-2000-0244.toml","cve_id":"CVE-2000-0275","title":"CRYPTOCard CRYPTOAdmin for PalmOS 弱加密漏洞","description":"CRYPTOCard CRYPTOAdmin for PalmOS 使用弱加密算法存储用户的 PIN 码，攻击者在获取 Palm 设备的 .PDB 数据文件后，可通过暴力破解或逆向分析手段还原 PIN 码，进而生成有效的 PT-1 双因素认证令牌。该漏洞影响 CRYPTOCard CRYPTOAdmin 4.1 版本，利用前提是攻击者能够访问物理设备上的 .PDB 文件，属于本地信息泄露漏洞，CVSS 评分 2.1，危害等级低。","severity":"LOW","score":2.1,"aliases":["CVE-2000-0275"],"sources":["avd"],"published":"2000-04-10T04:00:00Z","updated":"2026-06-16T21:51:22Z","remediation":"该漏洞源于 CRYPTOCard CryptoAdmin 4.1 for PalmOS 使用弱加密算法存储用户 PIN，攻击者可读取 .PDB 文件后破解 PIN 生成有效 PT-1 令牌。由于该产品已停止维护，建议立即停止使用 CRYPTOCard CryptoAdmin 4.1，迁移至支持强加密（如 AES-256）的双因素认证解决方案；同时确保 PalmOS 设备上的 .PDB 文件通过文件系统权限限制访问，并对存储敏感数据的文件实施全盘加密。","status":"completed","collected_at":"2026-07-22T00:00:00Z","references":["http://archives.neohapsis.com/archives/bugtraq/2000-04/0033.html","http://www.l0pht.com/advisories/cc-pinextract.txt","http://www.securityfocus.com/bid/1097","https://www.exploit-db.com/exploits/19839","https://github.com/trickest/cve/blob/ed228d55b7972f63e700a35a54fbcd94064b9ade/2000/CVE-2000-0275.md","https://github.com/CVEProject/cvelistV5/blob/fbc52696b7594c66d398b40fcc0dc269121d7362/cves/2000/0xxx/CVE-2000-0275.json","https://github.com/LiuCan01/cve-list-pro/blob/78b55511cee3604c22d518e32822f0435d0cacc0/cve-list/CVE-2000/CVE-2000-0275","https://github.com/nomi-sec/NVD-Database/blob/23dc120c34402aaa65883c51c1d03b3cb02c20cb/2000/CVE-2000-0275.json","https://github.com/mabito
211.month/838.html","http://secunia.com/advisories/8015","http://secunia.com/advisories/8016","http://secunia.com/advisories/8031","http://secunia.com/advisories/8053","http://sourceforge.net/project/shownotes.php?release_id=124484","http://www.debian.org/security/2003/dsa-249","http://www.debian.org/security/2003/dsa-250","http://www.debian.org/security/2003/dsa-251","http://www.openpkg.com/security/advisories/OpenPKG-SA-2003.009.html","http://www.osvdb.org/6981","http://www.redhat.com/support/errata/RHSA-2003-044.html","http://www.redhat.com/support/errata/RHSA-2003-045.html","http://www.securityfocus.com/bid/6793","https://exchange.xforce.ibmcloud.com/vulnerabilities/10842","https://github.com/CVEProject/cvelistV5/blob/97700d7e657426c8e1ee6cf44a0a2b88c60738c3/cves/2002/1xxx/CVE-2002-1335.json","https://github.com/LiuCan01/cve-list-pro/blob/78b55511cee3604c22d518e32822f0435d0cacc0/cve-list/CVE-2002/CVE-2002-1335","https://github.com/yarencheng/cve-devops-playground/blob/cbe73d6bdcced13ea57f08566d6bbf5345864f7e/content/CVE-2002-1335.md","https://github.com/Patrowl/PatrowlHearsData/blob/800f04b3cfadd1b9ab0343f5b9acd785dbc1e953/CVE/data/2002/CVE-2002-1335.json","https://github.com/github/advisory-database/blob/d8c03b84658bbca948e09e4af723cb11141fb41e/advisories/unreviewed/2022/04/GHSA-g49v-5ppg-cxcg/GHSA-g49v-5ppg-cxcg.json","https://github.com/rhuitl/uClinux/blob/0486e80a025dccbe4a2213715a2ab8a5063ea86b/user/nessus/nessus-plugins/scripts/redhat-RHSA-2003-045.nasl","https://github.com/jdkoftinoff/mb-linux-msli/blob/8adb103e34af9ff1d8d122e9ee2a1808836f0a14/uClinux-dist/user/nessus/nessus-plugins/scripts/debian_DSA-250.nasl","https://github.com/blackhook/nessus-plugins/blob/64177d96abbb07c58cf7e131046b067ebc61fcb5/D/debian_DSA-249.nasl","https://github.com/KTZgraph/sarenka/blob/f1fb931ab722d6c096d581ed6e3c5966d799fbaa/sarenka/feeds/cve_details/cve_all_details_149500_149600.json","https://github.com/debiancn/debian.org/blob/6abc98daa6356b20e410013a6920b3764af682d4/english/security/2003/dsa-250.data"],"poc_urls":[],"exp_urls":[],"repo_poc_urls":[],"repo_exp_urls":[],"has_poc":false,"has_exp":false,"raw_url":"https://github.com/adysec/AVE/blob/main/vulns/2002/AVE-2002-0066.toml"},{"ave_id":"AVE-2002-0065","file_name":"2002/AVE-2002-0065.toml","cve_id":"CVE-2002-1323","title":"Perl Safe.pm 安全沙箱逃逸漏洞","description":"Perl 5.8.0 及更早版本中使用的 Safe.pm 模块 2.0.7 及更早版本存在安全隔离逃逸漏洞。Safe.pm 提供的安全编译机制（Safe::reval 和 Safe::rdo）在连续调用之间未能正确重置 @_ 变量，本地攻击者可利用重定义的 @_ 变量绕过安全隔离限制，在受限制的编译环境中执行不安全代码，导致权限提升或敏感信息泄露。攻击者需具有本地系统访问权限，攻击复杂度低，无需身份认证即可利用。","severity":"MEDIUM","score":4.6,"aliases":["CVE-2002-1323"],"sources":["osv"],"published":"2002-12-11T05:00:00.000","updated":"2026-06-16T21:59:06.980","remediation":"升级 Perl 至 5.8.0-14 及以上版本，或单独升级 Safe.pm 模块至 2.0.8 及以上版本。Debian 系统用户应安装 DSA-208 提供的 perl 5.6.1-8.2 更新包。无法立即升级时，避免在不可信输入上调用 Safe::reval 和 Safe::rdo 函数。","status":"completed","collected_at":"2026-07-22T00:00:00Z","references":["http://archives.neohapsis.com/archives/vulnwatch/2002-q4/0061.html","http://bugs6.perl.org/rt2/Ticket/Display.html?id=17744","http://marc.info/?l=bugtraq&m=104005919814869&w=2","http://marc.info/?l=bugtraq&m=104033126305252&w=2","http://marc.info/?l=bugtraq&m=104040175522502&w=2","http://use.perl.org/articles/02/10/06/1118222.shtml?tid=5","http://www.debian.org/security/2002/dsa-208","http://www.iss.net/security_center/static/10574.php","http://www.osvdb.org/2183","http://www.osvdb.org/3814","http://www.redhat.com/support/errata/RHSA-2003-256.html","http://www.redhat.com/support/errata/RHSA-2003-257.html","http://www.securityfocus.com/bid/6111","https://oval.cisecurity.org/repository/search/definition/oval%3Aorg.mitre.oval%3Adef%3A1160","https://github.com/CVEProject/cvelistV5/blob/97700d7e657426c8e1ee6cf44a0a2b88c60738c3/cves/2002/1xxx/CVE-2002-1323.json","https://github.com/LiuCan01/cve-list-pro/blob/78b55511cee3604c22d518e32822f0435d0cacc0/cve-list/CVE-2002/CVE-2002-1323","https://github.com/CPAN-Security/cpan-advisory-database/blo
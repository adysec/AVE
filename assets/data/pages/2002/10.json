[{"ave_id":"AVE-2002-0568","file_name":"2002/AVE-2002-0568.toml","cve_id":"CVE-2002-1317","title":"XFree86 X11R6 3.3.x - Font Server Remote Buffer Overrun 漏洞","description":"XFree86 X11R6 3.3.x 的 XFS 字体服务器（fs.auto）中的 Dispatch() 例程存在缓冲区溢出漏洞。远程攻击者无需身份认证即可通过发送特制的 XFS 查询请求触发该漏洞，导致目标系统上的字体服务进程崩溃（拒绝服务），或进一步利用该漏洞执行任意代码。该漏洞影响 Solaris 2.5.1 至 9 等多个版本，CVSS 评分 7.5，危害等级高。目前已存在公开的利用代码，攻击者可通过 ExploitDB 获取 PoC 实施攻击。","severity":"HIGH","score":7.5,"aliases":["CVE-2002-1317"],"sources":["exploitdb"],"published":"2002-12-11T05:00:00Z","updated":"2026-06-16T21:59:06Z","remediation":"升级到不受影响的 XFree86 版本或安装 Sun 官方安全补丁（参考 Sun 公告 48879）。对于 Solaris 系统，建议安装 SunSolve 提供的补丁程序。如无法立即升级，可在防火墙层面限制对 XFS 字体服务端口（默认 7100/tcp）的访问，作为临时缓解措施。","status":"completed","collected_at":"2026-08-05T00:00:00Z","references":["http://bvlive01.iss.net/issEn/delivery/xforce/alertdetail.jsp?oid=21541","http://marc.info/?l=bugtraq&m=103825150527843&w=2","http://sunsolve.sun.com/pub-cgi/retrieve.pl?doc=fsalert/48879","http://www.cert.org/advisories/CA-2002-34.html","http://www.ciac.org/ciac/bulletins/n-024.shtml","http://www.iss.net/security_center/static/10375.php","http://www.kb.cert.org/vuls/id/312313","http://www.securityfocus.com/advisories/4988","http://www.securityfocus.com/bid/6241","https://oval.cisecurity.org/repository/search/definition/oval%3Aorg.mitre.oval%3Adef%3A149","https://oval.cisecurity.org/repository/search/definition/oval%3Aorg.mitre.oval%3Adef%3A152","https://oval.cisecurity.org/repository/search/definition/oval%3Aorg.mitre.oval%3Adef%3A2816","https://www.exploit-db.com/exploits/22036","https://github.com/trickest/cve/blob/15eaa178baaf955987a866a2c9d91dc02a2fb4aa/2002/CVE-2002-1317.md","https://github.com/CVEDB/Poc-Git/blob/0275aeb329b0747c9a1d46160c921eae06095557/2002/CVE-2002-1317.md","https://github.com/CVEProject/cvelistV5/blob/0b2099d0f1ceb94625ab1ba6dca5a48307538ab8/cves/2002/1xxx/CVE-2002-1317.json","https://github.com/LiuCan01/cve-list-pro/blob/78b55511cee3604c22d518e32822f0435d0cacc0/cve-